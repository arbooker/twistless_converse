compact_certificate def rep (g : SL(2,ZMod 25)) : SL(2,ℤ) := repRow (g.1 1 0) (g.1 1 1)
compact_certificate theorem row_primitive (g : SL(2,ZMod 25)) :
    ∃ a b : ZMod 25, a*g.1 1 1-b*g.1 1 0=1 := by
  refine ⟨g.1 0 0,g.1 0 1,?_⟩
  exact (det_fin_two g.1).symm.trans g.det_coe

