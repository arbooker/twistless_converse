compact_certificate def kernel (i : Fin 10) : SL(2,ℤ) :=
  match i.val with
  | 0 => ⟨!![1,1;0,1],by decide⟩
  | 1 => ⟨!![1,0;25,1],by decide⟩
  | 2 => ⟨!![2,-1;-25,13],by decide⟩
  | 3 => ⟨!![3,1;-25,-8],by decide⟩
  | 4 => ⟨!![4,1;-25,-6],by decide⟩
  | 5 => ⟨!![1,0;-25,1],by decide⟩
  | 6 => ⟨!![1,-1;0,1],by decide⟩
  | 7 => ⟨!![13,1;25,2],by decide⟩
  | 8 => ⟨!![-8,1;-25,3],by decide⟩
  | _ => ⟨!![-6,1;-25,4],by decide⟩

compact_certificate def letter : Fin 21 → SL(2,ℤ)
  | 0 => kernel 0
  | 1 => kernel 1
  | 2 => kernel 2
  | 3 => kernel 3
  | 4 => kernel 4
  | 5 => kernel 5
  | 6 => kernel 6
  | 7 => kernel 7
  | 8 => kernel 8
  | 9 => kernel 9
  | 10 => (kernel 0)⁻¹
  | 11 => (kernel 1)⁻¹
  | 12 => (kernel 2)⁻¹
  | 13 => (kernel 3)⁻¹
  | 14 => (kernel 4)⁻¹
  | 15 => (kernel 5)⁻¹
  | 16 => (kernel 6)⁻¹
  | 17 => (kernel 7)⁻¹
  | 18 => (kernel 8)⁻¹
  | 19 => (kernel 9)⁻¹
  | _ => -1

compact_certificate def word (w : List (Fin 21)) : SL(2,ℤ) := (w.map letter).prod

compact_certificate theorem word_mem (K : Subgroup SL(2,ℤ)) (hK : ∀ i : Fin 10, kernel i∈K)
    (hZ : (-1:SL(2,ℤ))∈K) (w : List (Fin 21)) : word w∈K := by
  have hl (i : Fin 21) : letter i∈K := by
    fin_cases i
    · exact hK 0
    · exact hK 1
    · exact hK 2
    · exact hK 3
    · exact hK 4
    · exact hK 5
    · exact hK 6
    · exact hK 7
    · exact hK 8
    · exact hK 9
    · exact K.inv_mem (hK 0)
    · exact K.inv_mem (hK 1)
    · exact K.inv_mem (hK 2)
    · exact K.inv_mem (hK 3)
    · exact K.inv_mem (hK 4)
    · exact K.inv_mem (hK 5)
    · exact K.inv_mem (hK 6)
    · exact K.inv_mem (hK 7)
    · exact K.inv_mem (hK 8)
    · exact K.inv_mem (hK 9)
    · exact hZ
  exact K.list_prod_mem (fun x hx => by
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
    exact hl i)
compact_certificate def inv25 : List ℕ := [0,1,13,17,19,0,21,18,22,14,0,16,23,2,9,0,11,3,7,4,0,6,8,12,24]
compact_certificate def rowClass (c d : ZMod 25) : ℕ :=
  if c.val%5=0 then 25+((c.val*inv25.getD d.val 0)%25)/5
  else (d.val*inv25.getD c.val 0)%25

compact_certificate def repRow (c d : ZMod 25) : SL(2,ℤ) :=
  match rowClass c d with
  | 0 => ⟨!![0,-1;1,0],by decide⟩
  | 1 => ⟨!![0,-1;1,1],by decide⟩
  | 24 => ⟨!![0,-1;1,-1],by decide⟩
  | 2 => ⟨!![0,-1;1,2],by decide⟩
  | 23 => ⟨!![0,-1;1,-2],by decide⟩
  | 12 => ⟨!![-1,0;2,-1],by decide⟩
  | 3 => ⟨!![0,-1;1,3],by decide⟩
  | 13 => ⟨!![-1,0;-2,-1],by decide⟩
  | 22 => ⟨!![0,-1;1,-3],by decide⟩
  | 11 => ⟨!![-1,1;2,-3],by decide⟩
  | 8 => ⟨!![-1,0;3,-1],by decide⟩
  | 4 => ⟨!![0,-1;1,4],by decide⟩
  | 14 => ⟨!![-1,-1;-2,-3],by decide⟩
  | 17 => ⟨!![-1,0;-3,-1],by decide⟩
  | 21 => ⟨!![0,-1;1,-4],by decide⟩
  | 9 => ⟨!![1,1;-3,-2],by decide⟩
  | 10 => ⟨!![-1,2;2,-5],by decide⟩
  | 7 => ⟨!![-1,1;3,-4],by decide⟩
  | 6 => ⟨!![-1,0;4,-1],by decide⟩
  | 5 => ⟨!![0,-1;1,5],by decide⟩
  | 16 => ⟨!![-1,1;-3,2],by decide⟩
  | 15 => ⟨!![-1,-2;-2,-5],by decide⟩
  | 18 => ⟨!![-1,-1;-3,-4],by decide⟩
  | 19 => ⟨!![-1,0;-4,-1],by decide⟩
  | 20 => ⟨!![0,-1;1,-5],by decide⟩
  | 28 => ⟨!![2,1;-5,-2],by decide⟩
  | 29 => ⟨!![-1,0;5,-1],by decide⟩
  | 27 => ⟨!![-2,1;-5,2],by decide⟩
  | 26 => ⟨!![-1,0;-5,-1],by decide⟩
  | _ => 1

