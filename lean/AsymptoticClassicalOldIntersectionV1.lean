module

public import AsymptoticClassicalOldDimensionV1

set_option autoImplicit false
@[expose] public noncomputable section

namespace AsymptoticClassicalCusp

open UpperHalfPlane
open scoped ModularForm

/-- The complete group of weight-k slash symmetries of a function. -/
def slashStabilizer (k : ℤ) (f : ℍ → ℂ) : Subgroup (GL (Fin 2) ℝ) where
  carrier := {g | f ∣[k] g = f}
  one_mem' := SlashAction.slash_one k f
  mul_mem' := by
    intro a b ha hb
    change f ∣[k] (a * b) = f
    rw [SlashAction.slash_mul, ha, hb]
  inv_mem' := by
    intro a ha
    change f ∣[k] a⁻¹ = f
    change f ∣[k] a = f at ha
    have he := congrArg (fun u : ℍ → ℂ => u ∣[k] a⁻¹) ha
    simpa only [← SlashAction.slash_mul, mul_inv_cancel, SlashAction.slash_one] using he.symm

/-- Cusp forms descend along arithmetic overgroups exactly when their
 underlying functions have the additional slash symmetries. -/
theorem mem_restrict_range_iff
    {G H : Subgroup (GL (Fin 2) ℝ)} [G.HasDetOne] [H.HasDetOne]
    [G.IsArithmetic] [H.IsArithmetic] (k : ℤ) (h : G ≤ H) (f : CuspForm G k) :
    f ∈ LinearMap.range (restrict k h) ↔ H ≤ slashStabilizer k f := by
  constructor
  · rintro ⟨g, rfl⟩ a ha
    exact g.slash_action_eq' a ha
  · intro hf
    let g : CuspForm H k := {
      toFun := f
      slash_action_eq' := hf
      holo' := f.holo'
      zero_at_cusps' := fun hc => f.zero_at_cusps' (by
        rw [Subgroup.IsArithmetic.isCusp_iff_isCusp_SL2Z] at hc ⊢
        exact hc) }
    exact ⟨g, CuspForm.ext fun _ => rfl⟩

/-- An old-image intersection is exactly simultaneous invariance under
 the subgroup generated by both lower-level groups. -/
theorem mem_restrict_intersection_iff
    {G H L : Subgroup (GL (Fin 2) ℝ)}
    [G.HasDetOne] [H.HasDetOne] [L.HasDetOne]
    [G.IsArithmetic] [H.IsArithmetic] [L.IsArithmetic]
    (k : ℤ) (hH : G ≤ H) (hL : G ≤ L) (f : CuspForm G k) :
    f ∈ LinearMap.range (restrict k hH) ⊓ LinearMap.range (restrict k hL) ↔
      H ⊔ L ≤ slashStabilizer k f := by
  rw [Submodule.mem_inf, mem_restrict_range_iff, mem_restrict_range_iff, sup_le_iff]

/-- Whenever the generated group is arithmetic, the intersection of old
 images is precisely restriction from that group. -/
theorem restrict_intersection_eq_range
    {G H L J : Subgroup (GL (Fin 2) ℝ)}
    [G.HasDetOne] [H.HasDetOne] [L.HasDetOne] [J.HasDetOne]
    [G.IsArithmetic] [H.IsArithmetic] [L.IsArithmetic] [J.IsArithmetic]
    (k : ℤ) (hH : G ≤ H) (hL : G ≤ L) (hJ : G ≤ J) (hgen : H ⊔ L = J) :
    LinearMap.range (restrict k hH) ⊓ LinearMap.range (restrict k hL) =
      LinearMap.range (restrict k hJ) := by
  ext f
  rw [mem_restrict_intersection_iff, mem_restrict_range_iff, hgen]

/-- The intersection dimension reduces to identifying the generated
 arithmetic group; no choice of Fourier basis is involved. -/
theorem restrict_intersection_finrank
    {G H L J : Subgroup (GL (Fin 2) ℝ)}
    [G.HasDetOne] [H.HasDetOne] [L.HasDetOne] [J.HasDetOne]
    [G.IsArithmetic] [H.IsArithmetic] [L.IsArithmetic] [J.IsArithmetic]
    (k : ℤ) (hH : G ≤ H) (hL : G ≤ L) (hJ : G ≤ J) (hgen : H ⊔ L = J) :
    Module.finrank ℂ ↥(LinearMap.range (restrict k hH) ⊓ LinearMap.range (restrict k hL)) =
      Module.finrank ℂ (CuspForm J k) := by
  rw [restrict_intersection_eq_range k hH hL hJ hgen]
  exact LinearMap.finrank_range_of_inj (restrict_injective k hJ)

/-- Applied to the actual prime-old spaces, membership in their overlap
 is a concrete generated-group invariance condition. -/
theorem mem_primeOldIntersection_iff (N : ℕ) (hN : 0 < N) (k : ℤ)
    (p : {p : ℕ // p.Prime ∧ p ∣ N}) (f : CuspForm (level N) k) :
    f ∈ primeOldIntersection N hN k p ↔
      level (N / p.val) ⊔ frickeOldLevel N (N / p.val) hN ≤ slashStabilizer k f := by
  let : NeZero N := ⟨hN.ne'⟩
  let : NeZero (N / p.val) := ⟨(Nat.div_pos (Nat.le_of_dvd hN p.property.2)
    p.property.1.pos).ne'⟩
  exact mem_restrict_intersection_iff k _ _ f

