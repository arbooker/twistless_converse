def word (w : List (Fin 53)) : SL(2,ℤ) := (w.map letter).prod

theorem word_mem (K : Subgroup SL(2,ℤ)) (hK : ∀ i : Fin 26, generator i∈K)
    (hZ : (-1:SL(2,ℤ))∈K) (w : List (Fin 53)) : word w∈K := by
  have hl (i : Fin 53) : letter i∈K := by
    fin_cases i
    · exact hK 0
    · exact hK 1
    · exact hK 2
    · exact hK 3
    · exact hK 4
    · exact hK 5
    · exact hK 6
    · exact hK 7
    · exact hK 8
    · exact hK 9
    · exact hK 10
    · exact hK 11
    · exact hK 12
    · exact hK 13
    · exact hK 14
    · exact hK 15
    · exact hK 16
    · exact hK 17
    · exact hK 18
    · exact hK 19
    · exact hK 20
    · exact hK 21
    · exact hK 22
    · exact hK 23
    · exact hK 24
    · exact hK 25
    · exact K.inv_mem (hK 0)
    · exact K.inv_mem (hK 1)
    · exact K.inv_mem (hK 2)
    · exact K.inv_mem (hK 3)
    · exact K.inv_mem (hK 4)
    · exact K.inv_mem (hK 5)
    · exact K.inv_mem (hK 6)
    · exact K.inv_mem (hK 7)
    · exact K.inv_mem (hK 8)
    · exact K.inv_mem (hK 9)
    · exact K.inv_mem (hK 10)
    · exact K.inv_mem (hK 11)
    · exact K.inv_mem (hK 12)
    · exact K.inv_mem (hK 13)
    · exact K.inv_mem (hK 14)
    · exact K.inv_mem (hK 15)
    · exact K.inv_mem (hK 16)
    · exact K.inv_mem (hK 17)
    · exact K.inv_mem (hK 18)
    · exact K.inv_mem (hK 19)
    · exact K.inv_mem (hK 20)
    · exact K.inv_mem (hK 21)
    · exact K.inv_mem (hK 22)
    · exact K.inv_mem (hK 23)
    · exact K.inv_mem (hK 24)
    · exact K.inv_mem (hK 25)
    · exact hZ
  exact K.list_prod_mem (fun x hx => by
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
    exact hl i)

