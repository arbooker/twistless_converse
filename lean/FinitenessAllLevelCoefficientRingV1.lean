module

public import FinitenessAllLevelGenericParameterV1
public import Mathlib.RingTheory.Localization.FractionRing

set_option autoImplicit false
@[expose] public noncomputable section

namespace FinitenessAllLevelCoefficientRing

open Complex Set MvPolynomial

variable {ι : Type*} (U : Set ℂ) (g : ι → ℂ → ℂ)

/-- The rational algebra generated by the actual holomorphic coefficients,
as functions on the chart domain. Relations are identities on the domain. -/
def ring : Subalgebra ℚ (U → ℂ) :=
  (MvPolynomial.aeval (R := ℚ) (fun i (z : U) => g i z)).range

def evaluation (w : U) : ring U g →+* ℂ :=
  (Pi.evalRingHom (fun _ : U => ℂ) w).comp (ring U g).val.toRingHom

theorem polynomial_apply (p : MvPolynomial ι ℚ) (z : U) :
    (MvPolynomial.aeval (fun i (w : U) => g i w) p) z =
      MvPolynomial.aeval (fun i => g i z) p := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp only [map_add, Pi.add_apply, hp, hq]
  | mul_X p i hp => simp only [map_mul, aeval_X, Pi.mul_apply, hp]

/-- An actual analytic representative of a coefficient-ring element. -/
def representative (a : ring U g) (z : ℂ) : ℂ :=
  MvPolynomial.aeval (fun i => g i z) a.property.choose

theorem representative_agrees (a : ring U g) (z : U) :
    representative U g a z = a.val z := by
  rw [representative, ← polynomial_apply]
  exact congrFun a.property.choose_spec z

theorem representative_analytic (hg : ∀ i, AnalyticOnNhd ℂ (g i) U) (a : ring U g) :
    AnalyticOnNhd ℂ (representative U g a) U :=
  fun z hz => AnalyticAt.aeval_mvPolynomial (fun i => hg i z hz) _

/-- At a generic parameter evaluation embeds the entire coefficient ring,
not just the originally listed coefficient values. -/
theorem evaluation_injective {w : U}
    (hw : ∀ p : MvPolynomial ι ℚ, MvPolynomial.aeval (fun i => g i w) p = 0 →
      ∀ z ∈ U, MvPolynomial.aeval (fun i => g i z) p = 0) :
    Function.Injective (evaluation U g w) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro a ha
  apply Subtype.ext
  funext z
  obtain ⟨p, hp⟩ := a.property
  have he (z : U) : MvPolynomial.aeval (fun i => g i z) p = a.val z :=
    (polynomial_apply U g p z).symm.trans (congrFun hp z)
  have hw' : MvPolynomial.aeval (fun i => g i w) p = 0 := (he w).trans ha
  exact (he z).symm.trans (hw p hw' z z.property)

/-- Every open subdomain contains a point where the actual coefficient ring
embeds into ℂ. In particular, scalar extension/descent applies to its fraction
field without assuming a generic fiber finiteness theorem. -/
theorem exists_injective_evaluation [Countable ι] (hU : IsPreconnected U)
    (hg : ∀ i, AnalyticOnNhd ℂ (g i) U) {V : Set ℂ}
    (hV : IsOpen V) (hVU : V ⊆ U) (hne : V.Nonempty) :
    ∃ w : U, w.val ∈ V ∧ Function.Injective (evaluation U g w) := by
  obtain ⟨w, hw, he⟩ := FinitenessAllLevelGenericParameter.generic_polynomial_relations
    hU g hg hV hVU hne
  exact ⟨⟨w, hVU hw⟩, hw, evaluation_injective U g he⟩

