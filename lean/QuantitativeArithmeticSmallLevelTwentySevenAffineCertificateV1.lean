def targetRow (a : ℂ) (v : Fin 67 → ℂ) : ℂ :=
  (1:ℂ)*a^1*v 47 + (-1:ℂ)*a^1*v 55 + (-1:ℂ)*a^0*v 50 + (1:ℂ)*a^0*v 57 + (-1:ℂ)*a^0*v 58 + (1:ℂ)*a^0*v 59 + (1:ℂ)*a^0*v 54 + (-1:ℂ)*a^0*v 64 + (1:ℂ)*a^0*v 65 + (-1:ℂ)*a^0*v 66

/-- Replay of all45 right-ideal terms, with the Hecke parameter left free. -/
theorem certificate_identity (a : ℂ) (v : Fin 67 → ℂ) :
    targetRow a v=∑ i : Fin 45, termWeight a i*sourceRow a v i := by
  norm_num [targetRow,termWeight,sourceRow,Fin.sum_univ_succ]
  ring

/-- No division by an eigenvalue occurs in the affine Hecke consequence. -/
theorem target_zero (a : ℂ) (v : Fin 67 → ℂ)
    (h : ∀ i : Fin 45, sourceRow a v i=0) : targetRow a v=0 := by
  rw [certificate_identity]
  simp only [h,mul_zero,Finset.sum_const_zero]
#print axioms certificate_identity
#print axioms target_zero
