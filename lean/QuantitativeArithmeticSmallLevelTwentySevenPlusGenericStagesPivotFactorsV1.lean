def pivotFactored (x y z w a : ℂ) : ℕ → ℂ
  | 0 => (-1/1:ℂ)
  | 1 => (-1/1:ℂ)*x^2
  | 2 => (-1/1:ℂ)*z^2
  | 3 => (1/1:ℂ)
  | 4 => (1/1:ℂ)*x^2
  | 5 => (1/1:ℂ)*z^2
  | 6 => (-1/1:ℂ)*x^2*z^2*y^3
  | 7 => (-1/1:ℂ)*w^2*x^2
  | 8 => (1/1:ℂ)*w^2*x^2
  | 9 => (-1/1:ℂ)*w^2
  | 10 => (-1/1:ℂ)*w^2*x^2*y^3
  | 11 => (-1/1:ℂ)*w^2*y^3
  | 12 => (-1/1:ℂ)*w^2*x^2*z^2
  | 13 => (-1/1:ℂ)*y^1
  | 14 => (-1/1:ℂ)*z^2*y^3
  | 15 => (-1/1:ℂ)*x^2*y^3
  | 16 => (-1/1:ℂ)*y^3
  | 17 => (-1/1:ℂ)*(a*x+x^2-1)^1
  | 18 => (-1/1:ℂ)*y^1*x^2
  | 19 => (1/1:ℂ)*y^1*x^2
  | 20 => (-1/1:ℂ)*x^2*z^2
  | 21 => (-1/1:ℂ)*x^2*y^2
  | 22 => (1/1:ℂ)*w^2
  | 23 => (-1/1:ℂ)*y^1*w^2*x^2
  | 24 => (-1/1:ℂ)*w^2*z^2
  | 25 => (1/1:ℂ)*w^2*x^2*z^2
  | 26 => (-1/1:ℂ)*y^1*w^2*x^2*z^2
  | 27 => (-1/1:ℂ)*y^1*w^2*z^2
  | 28 => (-1/1:ℂ)*y^1*z^2
  | 29 => (-1/1:ℂ)*y^1*w^2
  | 30 => (1/1:ℂ)*y^1
  | 31 => (-1/1:ℂ)*y^1*x^2*z^2
  | 32 => (-1/1:ℂ)*(x-1)^1*(x+1)^1*z^2
  | 33 => (1/1:ℂ)*x^2*z^2
  | 34 => (-1/1:ℂ)*y^2*z^2
  | 35 => (1/1:ℂ)*z^2*y^3
  | 36 => (-1/1:ℂ)*x^1*z^2
  | 37 => (-1/1:ℂ)*w^2*y^2
  | 38 => (-1/1:ℂ)*x^1
  | 39 => (1/1:ℂ)*x^1
  | 40 => (-1/1:ℂ)*y^2
  | 41 => (-1/1:ℂ)*x^1*y^2
  | 42 => (1/1:ℂ)*y^3
  | 43 => (1/1:ℂ)*a^1*w^2
  | 44 => (1/1:ℂ)*a^1*x^1
  | 45 => (1/1:ℂ)*a^1*x^3
  | 46 => (1/1:ℂ)*a^1*x^2
  | 47 => (1/1:ℂ)*x^3
  | _ => 0
theorem pivot_factorization (x y z w a b c : ℂ) (i : Fin 48) :
    eval x y z w a b c (fun _ => 1) (pivotPolynomial i.val)=pivotFactored x y z w a i.val := by
  fin_cases i <;> norm_num [pivotPolynomial,pivotFactored,eval,monomial] <;> ring
  all_goals simp
theorem pivot_nonzero (x y z w a : ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0) (ha : a≠0)
    (hm : x-1≠0) (hp : x+1≠0) (hq : a*x+x^2-1≠0) (i : Fin 48) :
    pivotFactored x y z w a i.val≠0 := by
  have hm' : 1-x≠0 := sub_ne_zero.mpr (Ne.symm (sub_ne_zero.mp hm))
  have hq' : 1-(a*x+x^2)≠0 := sub_ne_zero.mpr (Ne.symm (sub_ne_zero.mp hq))
  fin_cases i <;> norm_num [pivotFactored,mul_ne_zero,hx,hy,hz,hw,ha,hm,hp,hq,hm',hq']
#print axioms pivot_factorization
#print axioms pivot_nonzero
end QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages
