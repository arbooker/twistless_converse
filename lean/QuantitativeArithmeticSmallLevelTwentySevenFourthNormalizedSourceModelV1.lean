def denominatorRate (x y z w : ℂ) (j : ℕ) : ℂ :=
  let e := denominatorExponents j
  x^e.1*y^e.2.1*z^e.2.2.1*w^e.2.2.2

def layerVector (profile : ℕ → ℚ) (x y z w : ℂ) (d : ℕ) (v : ℕ → ℂ) (j : ℕ) : ℂ :=
  (denominatorRate (x/2^d) (y/3^d) (z/5^d) (w/7^d) j)⁻¹^2*
    (if d=0 then (denominatorRate 2 3 5 7 j)^2*(profile j:ℂ)*v 2428
      else v (607*(4-d)+j))

def matrixHigher (r : QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.Spec) (x y z w : ℂ) (n : ℕ) (v : ℕ → ℂ) : ℂ :=
  (x^r.e₂*y^r.e₃*z^r.e₅*w^r.e₇)*
    ((QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.entry r.word 1 0:ℂ)*(QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.denominator point r:ℂ))^n/(n.factorial:ℂ)*v r.right

def ramanujanHigher (r : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Spec) (ε : ℚ) (x y z w : ℂ) (n : ℕ) (v : ℕ → ℂ) : ℂ :=
  (ε:ℂ)*(x^r.e₂*y^r.e₃*z^r.e₅*w^r.e₇)*
    ((Nat.lcm 27 (r.q^2):ℂ)*(r.t:ℂ)/(r.Q:ℂ))^n/(n.factorial:ℂ)*QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.sampleEval r.q r.right v

def formalHigher (r : Source) (ε : ℚ) (x y z w : ℂ) (n : ℕ) (v : ℕ → ℂ) : ℂ :=
  match r with
  | .old (.matrix i) => matrixHigher (QuantitativeArithmeticSmallLevelTwentySevenShiftSource.Matrix.selected i) x y z w n v
  | .old (.ramanujan i) => ramanujanHigher (QuantitativeArithmeticSmallLevelTwentySevenShiftSource.Ramanujan.selected i) ε x y z w n v
  | .old _ => 0
  | .matrix t _ _ _ => matrixHigher t x y z w n v
  | .ramanujan t _ _ _ => ramanujanHigher t ε x y z w n v
  | .hecke _ _ => 0
  | .entire _ _ => 0

/-- The complete finite normalized source row. The top profile is only a
formal substitution here; its analytic justification uses the residue profile. -/
def normalizedRow (r : Source) (ε : ℚ) (profile : ℕ → ℚ)
    (d : ℕ) (x y z w : ℂ) (v : ℕ → ℂ) : ℂ :=
  formalRow r ε (x/2^d) (y/3^d) (z/5^d) (w/7^d) (-3/2) (-3) (-25/7)
      (layerVector profile x y z w d v)-
    ∑ n∈Finset.range d, formalHigher r ε (x/2^d) (y/3^d) (z/5^d) (w/7^d) (n+1)
      (layerVector profile x y z w (d-(n+1)) v)
