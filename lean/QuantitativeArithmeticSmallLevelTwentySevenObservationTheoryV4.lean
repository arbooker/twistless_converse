/-! ## QuantitativeArithmeticSmallLevelTwentySevenObservationMatrixV1 -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 6000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenObservation
open QuantitativeArithmeticRationalRows Matrix

theorem factor_indices : ∀ i : Fin 553,
    (factor i).all (fun t => decide (t.2<321))=true := by decide +kernel

def observationMatrix : Matrix (Fin 553) (Fin 607) ℂ :=
  fun i j => coefficient (observation i) j.val
def basisMatrix : Matrix (Fin 321) (Fin 607) ℂ :=
  fun i j => coefficient (basis i.val) j.val
def factorMatrix : Matrix (Fin 553) (Fin 321) ℂ :=
  fun i j => coefficient (factor i) j.val

/-- The exact finite-dimensional source-observation factorization, now in
matrix form for the analytic continuation theorem. -/
theorem observation_action (v : Fin 607 → ℂ) :
    observationMatrix *ᵥ v=factorMatrix *ᵥ (basisMatrix *ᵥ v) := by
  funext i
  have hh := observation_factorization (extend v) i
  rw [eval_extend_eq_sum] at hh
  have hb : ∀ t∈factor i, t.2<321 := by
    intro t ht
    have h := (List.all_eq_true.mp (factor_indices i)) t ht
    exact of_decide_eq_true h
  rw [eval_bounded_eq_sum _ _ hb] at hh
  simp_rw [eval_extend_eq_sum] at hh
  exact hh

theorem observation_matrix : observationMatrix=factorMatrix*basisMatrix := by
  apply Matrix.ext
  intro i j
  have hh := observation_action (Pi.single j 1)
  rw [Matrix.mulVec_mulVec] at hh
  have hi := congrFun hh i
  simpa only [Matrix.mulVec_single_one,Matrix.col_apply] using hi
#print axioms factor_indices
#print axioms observation_action
#print axioms observation_matrix
end QuantitativeArithmeticSmallLevelTwentySevenObservation
