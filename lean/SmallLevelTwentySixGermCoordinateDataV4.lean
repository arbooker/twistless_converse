/-! Finite level-26 coordinate and source-index data. These exact definitions
are shared by the analytic source construction and the algebraic certificates;
importing the tables does not import the analytic converse arguments. -/
namespace SmallLevelTwentySixGermSources
inductive GridSource where
  | word : Fin 235→GridSource
  | taylor : Fin 53→GridSource
  | entire : Fin 11→GridSource
  | hecke : Fin 96→GridSource
  | infinity : Fin 2→GridSource
  deriving DecidableEq, Fintype

def gridIndex (t : ℤ) : Fin 780 :=
  ⟨(t%780).toNat,by have h:=Int.emod_lt_of_pos t (by decide : (0:ℤ)<780); omega⟩

def gridTaylorSpecs : Fin 53→ℕ×ℤ :=
  ![(3,10),(3,-10),(3,13),(3,-13),(3,20),(3,-20),(3,25),(3,-25),(3,26),(3,-26),(3,40),(3,-40),(3,50),(3,-50),(4,5),(4,-5),(4,13),(4,-13),(4,15),(4,-15),(4,25),(4,-25),(4,39),(4,-39),(4,45),(4,-45),(4,65),(4,75),(6,2),(6,-2),(6,10),(6,-10),(6,13),(6,-13),(6,20),(6,-20),(6,25),(6,-25),(6,26),(6,-26),(10,6),(10,-6),(12,1),(12,-1),(12,5),(12,-5),(12,13),(12,-13),(13,10),(13,20),(13,30),(52,5),(52,-45)]
def gridTaylorQ (i : Fin 53) : ℕ := (gridTaylorSpecs i).1
def gridTaylorT (i : Fin 53) : ℤ := (gridTaylorSpecs i).2
end SmallLevelTwentySixGermSources

