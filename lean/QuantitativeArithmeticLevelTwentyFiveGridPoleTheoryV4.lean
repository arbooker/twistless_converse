compact_certificate theorem edgeS_checked (g : SL(2,ZMod 25)) :
    rep g*S*(rep (g*reduction 25 S))⁻¹=word (edgeSRow (g.1 1 0) (g.1 1 1)) := by
  have hs : rep (g*reduction 25 S)=repRow (g.1 1 1) (-(g.1 1 0)) := by
    have hS : reduction 25 S=(⟨!![0,-1;1,0],by decide⟩ : SL(2,ZMod 25)) := by decide
    simp [rep, hS, Matrix.mul_apply, Fin.sum_univ_two]
  rw [hs]
  exact edgeSRow_checked _ _ (row_primitive g)

compact_certificate theorem edgeT_checked (g : SL(2,ZMod 25)) :
    rep g*T*(rep (g*reduction 25 T))⁻¹=word (edgeTRow (g.1 1 0) (g.1 1 1)) := by
  have ht : rep (g*reduction 25 T)=repRow (g.1 1 0) (g.1 1 0+g.1 1 1) := by
    have hT : reduction 25 T=(⟨!![1,1;0,1],by decide⟩ : SL(2,ZMod 25)) := by decide
    simp [rep, hT, Matrix.mul_apply, Fin.sum_univ_two]
  rw [ht]
  exact edgeTRow_checked _ _ (row_primitive g)

compact_certificate theorem rep_one : rep 1=1 := by decide

compact_certificate theorem rep_upper (g : SL(2,ZMod 25)) (hg : g.1 1 0=0) : rep g=1 := by
  have h : ∀ d : ZMod 25, repRow 0 d=1 := by decide
  simpa only [rep, hg] using h (g.1 1 1)

compact_certificate theorem gamma0_mem (K : Subgroup SL(2,ℤ)) (hK : ∀ i : Fin 10, kernel i∈K)
    (hZ : (-1:SL(2,ℤ))∈K) (γ : SL(2,ℤ))
    (hγ : γ∈CongruenceSubgroup.Gamma0 25) : γ∈K := by
  apply transversal_mem (reduction 25) rep K
  · intro g
    rw [edgeS_checked]
    exact word_mem K hK hZ _
  · intro g
    rw [edgeT_checked]
    exact word_mem K hK hZ _
  · exact rep_one
  · apply rep_upper
    exact CongruenceSubgroup.Gamma0_mem.mp hγ
#print axioms gamma0_mem

end QuantitativeArithmeticSmallLevelTwentyFiveGroup
