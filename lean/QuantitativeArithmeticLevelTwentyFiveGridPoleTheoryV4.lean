/-! ## TwentyFiveSecondRootCover -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.SecondRoot
open QuantitativeArithmeticComplexHornerBounds Polynomial Finset

compact_certificate theorem distance_le_norm (i j : Fin 8) (hij : i≠j) :
    (separation i j:ℝ)≤‖ratComplex (center i)-ratComplex (center j)‖ := by
  have h : (separation i j:ℝ)≤ max |((center i).1:ℝ)-((center j).1:ℝ)|
      |((center i).2:ℝ)-((center j).2:ℝ)| := by
    exact_mod_cast (show separation i j≤ max |(center i).1-(center j).1| |(center i).2-(center j).2| by simp [separation,hij])
  apply h.trans
  apply max_le
  · simpa using Complex.abs_re_le_norm (ratComplex (center i)-ratComplex (center j))
  · simpa using Complex.abs_im_le_norm (ratComplex (center i)-ratComplex (center j))

compact_certificate theorem center_injective : Function.Injective (fun i : Fin 8 => ratComplex (center i)) := by
  intro i j hij
  change ratComplex (center i)=ratComplex (center j) at hij
  by_contra hne
  have h := distance_le_norm i j hne
  rw [hij,sub_self,norm_zero] at h
  have hp : 0<(separation i j:ℝ) := by exact_mod_cast sep_positive i j
  exact (not_le_of_gt hp) h

compact_certificate theorem radius_positive : 0<(radius:ℝ) := by
  exact_mod_cast (show (0:ℚ)<radius by decide +kernel)

compact_certificate theorem p_bound_erase_product (i : Fin 8) : (bound i:ℝ)=
    (1/10:ℝ)*(radius:ℝ)*∏ j ∈ (Finset.univ : Finset (Fin 8)).erase i,(separation i j:ℝ) := by
  have h : (bound i:ℝ)=(1/10:ℝ)*(radius:ℝ)*∏ j : Fin 8,(separation i j:ℝ) := by
    have hq := congrArg (fun q : ℚ => (q:ℝ)) (show bound i=(1/10:ℚ)*radius*∏ j : Fin 8,separation i j by rfl)
    simpa only [Rat.cast_mul,Rat.cast_div,Rat.cast_one,Rat.cast_ofNat,Rat.cast_prod] using hq
  have hp : (∏ j ∈ (Finset.univ : Finset (Fin 8)).erase i,(separation i j:ℝ))=
      ∏ j : Fin 8,(separation i j:ℝ) := by
    simpa only [sep_diagonal,Rat.cast_one,mul_one] using
      Finset.prod_erase_mul Finset.univ (fun j : Fin 8 => (separation i j:ℝ)) (Finset.mem_univ i)
  rw [hp]
  exact h

/- Every root of the concrete degree-8 polynomial lies in a certified disk.
The proof uses only exact rational certificates and barycentric interpolation. -/
compact_certificate theorem p8_root_in_disk (z : ℂ) (hz : p8.eval z=0) :
    ∃ i : Fin 8,‖z-ratComplex (center i)‖<(radius:ℝ) := by
  have hsmall : ∑ i : Fin 8,
      ‖Lagrange.nodalWeight Finset.univ (fun j => ratComplex (center j)) i*
        p8.eval (ratComplex (center i))‖/(radius:ℝ)<1 := by
    apply lt_of_le_of_lt _ (show (∑ _i : Fin 8,(1/10:ℝ))<1 by norm_num)
    apply Finset.sum_le_sum
    intro i _hi
    apply (div_le_iff₀ radius_positive).mpr
    apply QuantitativeArithmeticPolynomialRootCover.nodal_eval_bound_of_separations
      Finset.univ (fun j => ratComplex (center j)) p8 i
      (fun j => (separation i j:ℝ)) (1/10:ℝ) (radius:ℝ)
    · intro j _hj
      exact_mod_cast sep_positive i j
    · intro j hj
      exact distance_le_norm i j (Finset.mem_erase.mp hj).1.symm
    · rw [← p_bound_erase_product]
      exact value_bound i
  obtain ⟨i,_hi,h⟩ := QuantitativeArithmeticPolynomialRootCover.monic_root_cover
    Finset.univ (fun j => ratComplex (center j)) (fun _ => (radius:ℝ)) p8
    center_injective.injOn p8_monic_degree.1 (by rw [Polynomial.degree_eq_natDegree p8_monic_degree.1.ne_zero,p8_monic_degree.2]; norm_num)
    (fun _ _ => radius_positive) hsmall z hz
  exact ⟨i,h⟩

#print axioms center_injective
#print axioms p8_root_in_disk
end QuantitativeArithmeticSmallLevelTwentyFive.SecondRoot
end
