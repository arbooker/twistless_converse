/-! ## TwentyFiveHeckePoleData -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFivePairs
open Matrix UpperHalfPlane SmallLevelNormalized SmallLevelOriginal Complex FinitenessOriginalFourier
open QuantitativeArithmeticSlashLaplace
open scoped MatrixGroups ModularForm Manifold

compact_certificate def knownE25 : SL(2,ℤ) := ⟨!![2,-1;-25,13],by decide⟩

compact_certificate theorem knownE25_original {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f) :
    fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] knownE25=fourierFunction (2*m) f := by
  let K := SmallLevelGenerators.slashStabilizer ((2*m:ℕ):ℤ) (fourierFunction (2*m) f)
  rw [show knownE25=(SmallLevelGenerators.oddMatrix 25 13 (by decide))⁻¹ by decide +kernel]
  exact K.inv_mem (SmallLevelGenerators.original_odd (by decide) (by decide : 2*13=25+1) (by decide) hf)

compact_certificate theorem positive3_of_additive_poles {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (h4 : fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4=fourierFunction (2*m) f)
    (B : ℝ) (G H : ℂ → ℂ)
    (hG : ∀ s,MeromorphicAt G s) (hH : ∀ s,MeromorphicAt H s)
    (hGa : ∀ s,s≠((2*m:ℕ):ℂ) → AnalyticAt ℂ G s)
    (hHa : ∀ s,s≠((2*m:ℕ):ℂ) → AnalyticAt ℂ H s)
    (hGo : (-1:WithTop ℤ)≤ meromorphicOrderAt G ((2*m:ℕ):ℂ))
    (hHo : (-1:WithTop ℤ)≤ meromorphicOrderAt H ((2*m:ℕ):ℂ))
    (hGF : ∀ s,B<s.re → G s=SmallLevelAdditive.transform (fullCoefficients f (2*m)) (-3/25) s)
    (hHF : ∀ s,B<s.re → H s=SmallLevelAdditive.transform (fullCoefficients f (2*m)) (-2/25) s) :
    fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive3=fourierFunction (2*m) f := by
  obtain ⟨τ,hτ,hgrowth⟩ := hf.growth
  have ha := polynomial_bound hf.zero hgrowth (2*m)
  have ha0 := fullCoefficients_zero hf.zero (2*m)
  have hgeo3 : (SpecialLinearGroup.mapGL ℝ positive3) 1 0≠0 ∧
      (-1/3:ℝ)+(SpecialLinearGroup.mapGL ℝ positive3) 1 1/(SpecialLinearGroup.mapGL ℝ positive3) 1 0≠0 ∧
      (SpecialLinearGroup.mapGL ℝ positive3) 0 0/(SpecialLinearGroup.mapGL ℝ positive3) 1 0=(-3/25:ℝ) := by
    norm_num [positive3,SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe]
  have hgeoE : (SpecialLinearGroup.mapGL ℝ knownE25) 1 0≠0 ∧
      (-1/3:ℝ)+(SpecialLinearGroup.mapGL ℝ knownE25) 1 1/(SpecialLinearGroup.mapGL ℝ knownE25) 1 0≠0 ∧
      (SpecialLinearGroup.mapGL ℝ knownE25) 0 0/(SpecialLinearGroup.mapGL ℝ knownE25) 1 0=(-2/25:ℝ) := by
    norm_num [knownE25,SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe]
  obtain ⟨d3⟩ := nonempty_data_of_slash (2*m) ha ha0 (SpecialLinearGroup.mapGL ℝ positive3)
    (by simp) hgeo3.1 (-1/3) hgeo3.2.1 B G hG hGa hGo (by simpa only [hgeo3.2.2] using hGF)
  obtain ⟨dE⟩ := nonempty_data_of_slash (2*m) ha ha0 (SpecialLinearGroup.mapGL ℝ knownE25)
    (by simp) hgeoE.1 (-1/3) hgeoE.2.1 B H hH hHa hHo (by simpa only [hgeoE.2.2] using hHF)
  have dd := d3.sub dE
  change Data (fun t =>
    (fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive3) (logPoint (-1/3) t)-
    (fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] knownE25) (logPoint (-1/3) t)) at dd
  rw [knownE25_original hf] at dd
  obtain ⟨C,hC⟩ := positive3_defect_constant_of_data hf h4 dd
  exact positive3_of_constant_defect hm hf C hC
#print axioms positive3_of_additive_poles
end QuantitativeArithmeticSmallLevelTwentyFivePairs
end
