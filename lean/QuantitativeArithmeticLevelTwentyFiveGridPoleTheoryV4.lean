/- Reuse the checked 150-grid and relative-1050-grid kernels; no new
1050-coordinate elimination is needed for the negative pole argument. -/
compact_certificate theorem kernel_from_five (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hs : ∀ j<4518,eval x y z w a b c v (source j)=0)
    (h294 : v 294=0) (h420 : v 420=0) (h756 : v 756=0)
    (h840 : v 840=0) (h882 : v 882=0) : ∀ j<1050,v j=0 := by
  have hold : ∀ j<150,v (7*j)=0 := by
    apply CuspMinusLaurent.leading_kernel x y z w a b c (fun j => v (7*j)) hx hy hz hw
    · intro i hi
      have hp : CuspMinusLaurent.auxIndex i<4450 := cusp_source_prefix ⟨i,hi⟩
      have hh := hs (CuspMinusLaurent.auxIndex i) (by omega)
      rw [source,ite_eq_left hp,CuspMinusLaurent.all_aux_source i hi,eval_liftPoly] at hh
      exact hh
    · intro i
      fin_cases i
      · exact h294
      · exact h420
      · exact h756
      · exact h840
      · exact h882
  apply AuxMinusLaurent.augmented_kernel x y z w a b c v hx hy hz hw
  · intro i hi
    by_cases hp : i<4450
    · have hh := hs i (by omega)
      simpa only [source,ite_eq_left hp] using hh
    · have hj : i-4450<150 := by omega
      have he : i-4450+4450=i := by omega
      have hh := old_source ⟨i-4450,hj⟩
      dsimp only at hh
      rw [he] at hh
      rw [hh]
      simpa [eval,monomial] using hold (i-4450) hj
  · intro i
    have hh := hs (i.val+4450) (by omega)
    have hp : ¬ i.val+4450<4450 := by omega
    simp only [source,ite_eq_right hp,Nat.add_sub_cancel,eval,monomial,List.map_cons,List.map_nil,
      List.sum_cons,List.sum_nil,Rat.cast_one,zpow_zero,pow_zero,mul_one,one_mul,add_zero] at hh
    rw [gauge_coordinate i] at hh
    exact hh
#print axioms kernel_from_five
end QuantitativeArithmeticSmallLevelTwentyFive.FullMinusLeading
end
