  have hh : periodicVector v 672=0 ∧ periodicVector v 756=0 := by
    simpa only [DetectedByTwo,not_or,not_not] using h
  have hall := leading_kernel_two x y z w a b c (periodicVector v)
    hx hy hz hw hs hc hh.1 hh.2
  apply hv
  funext j
  simpa only [periodicVector_fin,Pi.zero_apply] using hall j.val j.isLt

compact_certificate theorem pole_detected_by_two_away_weight
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hpole : ∃ j,meromorphicOrderAt (fun z => G z j) s<0)
    (hshift : ∀ n : ℕ,0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hs : s≠((2*m:ℕ):ℂ)) : DetectedByTwo v := by
  have hrows := original_pole_rows_allowed hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hshift hweight
  have hc := CuspPlusLaurent.pole_all_denominator_five_zero_allowed hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hpole hshift hweight hs
  have hp (p : ℕ) (hp0 : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp0))
  exact detected_by_two (primeParameter 2 m s) (primeParameter 3 m s)
    (primeParameter 5 m s) (primeParameter 7 m s)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7) v
    (hp 2 (by decide)) (hp 3 (by decide)) (hp 5 (by decide)) (hp 7 (by decide))
    hrows hc.2.2.1 hv.1

compact_certificate theorem regularized_weight_pole_detected_by_two
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (v : Fin 1050 → ℂ)
    (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) ((2*m:ℕ):ℂ) v)
    (hpole : ∃ j, meromorphicOrderAt (fun z => (z-((2*m:ℕ):ℂ))*G z j) ((2*m:ℕ):ℂ)<0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (((2*m:ℕ):ℂ)+n)) : DetectedByTwo v := by
  have hrows := original_pole_rows_strict hm hf ε hε hlaw hχ BG G hG hGF
    ((2*m:ℕ):ℂ) v (hv.of_analytic_factor _ (analyticAt_id.sub analyticAt_const)) hshift
  have hc := CuspPlusLaurent.regularized_weight_all_denominator_five_zero hm hf ε hε hlaw hχ
    BG G hG hGF v hv hpole hshift
  have hp (p : ℕ) (hp0 : p≠0) : primeParameter p m ((2*m:ℕ):ℂ)≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp0))
  exact detected_by_two (primeParameter 2 m ((2*m:ℕ):ℂ)) (primeParameter 3 m ((2*m:ℕ):ℂ))
    (primeParameter 5 m ((2*m:ℕ):ℂ)) (primeParameter 7 m ((2*m:ℕ):ℂ))
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7) v
    (hp 2 (by decide)) (hp 3 (by decide)) (hp 5 (by decide)) (hp 7 (by decide))
    hrows hc.2.2.1 hv.1

#print axioms pole_detected_by_two_away_weight
#print axioms regularized_weight_pole_detected_by_two
end QuantitativeArithmeticSmallLevelTwentyFive.FullPlusLeading
