/-! ## TwentyFiveModularCriterion -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive
open Matrix UpperHalfPlane ModularGroup SmallLevelGenerators SmallLevelOriginal SmallLevelNormalized
open QuantitativeArithmeticSmallLevelTwentyFiveGroup
open scoped MatrixGroups ModularForm

compact_certificate theorem generator_fricke_conjugate (i : Fin 5) :
    SpecialLinearGroup.mapGL ℝ (kernel ⟨i.val+5,by omega⟩)*fricke 25 (by decide)=
      fricke 25 (by decide)*SpecialLinearGroup.mapGL ℝ (kernel ⟨i.val,by omega⟩) := by
  fin_cases i <;> apply Units.ext <;> ext a b <;> fin_cases a <;> fin_cases b <;>
    norm_num [kernel,fricke,matrix,GeneralLinearGroup.mkOfDetNeZero,
      SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe,
      Matrix.mul_apply,Fin.sum_univ_two]

/- The final group-theoretic step needs only the two missing transformations;
the Fricke conjugates and all of Gamma0(25) then follow from exact certificates. -/
compact_certificate theorem transformations_of_two (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (hA : fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] kernel 3=fourierFunction (2*m) f)
    (hB : fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] kernel 4=fourierFunction (2*m) f)
    (γ : SL(2,ℤ)) (hγ : γ∈CongruenceSubgroup.Gamma0 25) :
    fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] γ=fourierFunction (2*m) f := by
  let F := fourierFunction (2*m) f
  let k : ℤ := ((2*m:ℕ):ℤ)
  let K := slashStabilizer k F
  obtain ⟨χ,hχ,hseed⟩ := QuantitativeArithmeticSmallLevelTwentyFiveKnownWords.original_seeds hf
  have hfirst (i : Fin 5) : kernel ⟨i.val,by omega⟩∈K := by
    fin_cases i
    · change F ∣[k] T=F
      exact original_T (2*m) f
    · change F ∣[k] lower 25=F
      exact original_lower (by decide : 0<25) hf
    · change kernel (2:Fin 10)∈K
      rw [show kernel (2:Fin 10)=(oddMatrix 25 13 (by decide))⁻¹ by decide +kernel]
      exact K.inv_mem (original_odd (by decide) (by decide : 2*13=25+1) (by decide) hf)
    · exact hA
    · exact hB
  have hW : F ∣[k] fricke 25 (by decide)=χ • F := by
    simpa only [QuantitativeArithmeticSmallLevelTwentyFiveKnownWords.seed,
      QuantitativeArithmeticSmallLevelTwentyFiveKnownWords.seedSign,ite_true] using hseed 3
  have hlast (i : Fin 5) : kernel ⟨i.val+5,by omega⟩∈K := by
    have hfirstGL : F ∣[k] SpecialLinearGroup.mapGL ℝ (kernel ⟨i.val,by omega⟩)=F := hfirst i
    have hh : (F ∣[k] SpecialLinearGroup.mapGL ℝ (kernel ⟨i.val+5,by omega⟩)) ∣[k]
        fricke 25 (by decide)=F ∣[k] fricke 25 (by decide) := by
      rw [← SlashAction.slash_mul,generator_fricke_conjugate,SlashAction.slash_mul,hW,
        det_one_smul _ (by simp [SpecialLinearGroup.det_mapGL]),hfirstGL]
    have hi := congrArg (fun G : ℍ → ℂ => G ∣[k] (fricke 25 (by decide))⁻¹) hh
    change F ∣[k] kernel ⟨i.val+5,by omega⟩=F
    rw [ModularForm.SL_slash]
    simpa only [← SlashAction.slash_mul,mul_assoc,mul_inv_cancel,mul_one,SlashAction.slash_one,
      SpecialLinearGroup.mapGL,MonoidHom.comp_apply,algebraMap_int_eq] using hi
  have hK (i : Fin 10) : kernel i∈K := by
    fin_cases i
    · exact hfirst 0
    · exact hfirst 1
    · exact hfirst 2
    · exact hfirst 3
    · exact hfirst 4
    · exact hlast 0
    · exact hlast 1
    · exact hlast 2
    · exact hlast 3
    · exact hlast 4
  exact gamma0_mem K hK (SmallLevelThirtySix.slash_neg_one_even _ m) γ hγ

compact_certificate theorem modular_of_two (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (hA : fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] kernel 3=fourierFunction (2*m) f)
    (hB : fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] kernel 4=fourierFunction (2*m) f) :
    IsModular 25 (2*m) f :=
  modular_of_transformations (by decide) hf (transformations_of_two m hf hA hB)

#print axioms transformations_of_two
#print axioms modular_of_two
end QuantitativeArithmeticSmallLevelTwentyFive
end
