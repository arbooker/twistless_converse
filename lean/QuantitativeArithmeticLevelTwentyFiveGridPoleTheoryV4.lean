/-! ## TwentyFiveHyperbolic -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFivePairs
open Matrix UpperHalfPlane SmallLevelNormalized SmallLevelOriginal
open scoped MatrixGroups ModularForm

-- The general inverse-pair lemma is imported from SmallLevelSignedPairsV1.

compact_certificate def hyperbolic : SL(2,ℚ) := ⟨!![1,1/2;-25/3,-19/6],by norm_num [det_fin_two]⟩
compact_certificate def hyperbolicReal : GL (Fin 2) ℝ := SpecialLinearGroup.mapGL ℝ hyperbolic

compact_certificate theorem hyperbolic_factor :
    (translation (1/2))⁻¹*(SpecialLinearGroup.mapGL ℝ negative4)⁻¹*
      translation (1/3)*SpecialLinearGroup.mapGL ℝ positive4=hyperbolicReal⁻¹ := by
  have hr : (translation (1/2))⁻¹=translation (-1/2) := by
    apply inv_eq_of_mul_eq_one_right
    rw [translation_mul]
    apply Units.ext
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [translation,matrix,GeneralLinearGroup.mkOfDetNeZero]
  have hc : negative4⁻¹=(⟨!![-6,1;-25,4],by decide⟩ : SL(2,ℤ)) := by decide
  rw [hr,← map_inv,hc]
  apply (eq_inv_iff_mul_eq_one).mpr
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [hyperbolicReal,hyperbolic,positive4,translation,matrix,
      GeneralLinearGroup.mkOfDetNeZero,SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe,
      Matrix.mul_apply,Matrix.vecMul,dotProduct,Fin.sum_univ_two]

/- The actual level-25 defect at the parabolic denominator-four matrix is
invariant under a hyperbolic matrix with fixed cusp -1/5. -/
compact_certificate theorem original_hyperbolic (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f) :
    ((fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4)-fourierFunction (2*m) f)
      ∣[((2*m:ℕ):ℤ)] hyperbolicReal=
    (fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4)-fourierFunction (2*m) f := by
  have h6 := original_reduced6 hf
  rw [show positive6=(-1:SL(2,ℤ))*positive4⁻¹ by decide +kernel,
    show negative6=(-1:SL(2,ℤ))*negative4⁻¹ by decide +kernel,
    SlashAction.slash_mul,SlashAction.slash_mul,
    SmallLevelThirtySix.slash_neg_one_even] at h6
  have h := inverse_pairs (fourierFunction (2*m) f) ((2*m:ℕ):ℤ)
    (SpecialLinearGroup.mapGL ℝ positive4) (SpecialLinearGroup.mapGL ℝ negative4)
    (translation (1/2)) (translation (1/3))
    (by simpa only [ModularForm.SL_slash,SpecialLinearGroup.mapGL,MonoidHom.comp_apply,algebraMap_int_eq,show (2/4:ℝ)=1/2 by norm_num] using original_reduced4 hf)
    (by simpa only [ModularForm.SL_slash,SpecialLinearGroup.mapGL,MonoidHom.comp_apply,algebraMap_int_eq,map_inv,show (2/6:ℝ)=1/3 by norm_num] using h6)
  rw [hyperbolic_factor] at h
  have hh := congrArg (fun g : ℍ → ℂ => g ∣[((2*m:ℕ):ℤ)] hyperbolicReal) h
  simpa only [← SlashAction.slash_mul,inv_mul_cancel,SlashAction.slash_one,ModularForm.SL_slash,SpecialLinearGroup.mapGL,MonoidHom.comp_apply,algebraMap_int_eq] using hh.symm

#print axioms inverse_pairs
#print axioms original_hyperbolic
end QuantitativeArithmeticSmallLevelTwentyFivePairs
end
end

/-! ## TwentyFiveHyperbolicDilation -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFivePairs
open Matrix UpperHalfPlane SmallLevelNormalized SmallLevelOriginal
open scoped MatrixGroups ModularForm

/- Rational determinant-one coordinates at the two fixed cusps. -/
compact_certificate def cuspCoordinates : SL(2,ℚ) := ⟨!![-2,-3/10;10,1],by norm_num [det_fin_two]⟩
compact_certificate def cuspCoordinatesReal : GL (Fin 2) ℝ := SpecialLinearGroup.mapGL ℝ cuspCoordinates
compact_certificate def cuspDiagonal : SL(2,ℚ) := ⟨!![-3/2,0;0,-2/3],by norm_num [det_fin_two]⟩
compact_certificate def cuspDiagonalReal : GL (Fin 2) ℝ := SpecialLinearGroup.mapGL ℝ cuspDiagonal

compact_certificate theorem cusp_diagonalization : hyperbolicReal*cuspCoordinatesReal=
    cuspCoordinatesReal*cuspDiagonalReal := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [hyperbolicReal,hyperbolic,cuspCoordinatesReal,cuspCoordinates,
      cuspDiagonalReal,cuspDiagonal,SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe,
      Matrix.mul_apply,Matrix.vecMul,dotProduct,Fin.sum_univ_two]

compact_certificate theorem original_diagonal_defect (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f) :
    (((fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4)-fourierFunction (2*m) f)
      ∣[((2*m:ℕ):ℤ)] cuspCoordinatesReal) ∣[((2*m:ℕ):ℤ)] cuspDiagonalReal=
    ((fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4)-fourierFunction (2*m) f)
      ∣[((2*m:ℕ):ℤ)] cuspCoordinatesReal := by
  rw [← SlashAction.slash_mul,← cusp_diagonalization,SlashAction.slash_mul,original_hyperbolic m hf]

compact_certificate theorem cusp_diagonal_point (z : ℍ) :
    ((cuspDiagonalReal • z : ℍ):ℂ)=(9/4:ℂ)*(z:ℂ) := by
  rw [coe_smul_of_det_pos (by simp [cuspDiagonalReal])]
  norm_num [num,denom,cuspDiagonalReal,cuspDiagonal,SpecialLinearGroup.toGL,
    SpecialLinearGroup.map_apply_coe]
  ring

/- The induced recurrence has multiplier (2/3)^(2m), independently of
all finite Hecke eigenvalues. -/
compact_certificate theorem diagonal_recurrence (g : ℍ → ℂ) (m : ℕ)
    (hg : g ∣[((2*m:ℕ):ℤ)] cuspDiagonalReal=g) (z : ℍ) :
    g (cuspDiagonalReal • z)=(2/3:ℂ)^(2*m)*g z := by
  have h := congrFun hg z
  rw [det_one_slash _ (by simp [cuspDiagonalReal])] at h
  have hd : denom cuspDiagonalReal z=(-2/3:ℂ) := by
    norm_num [denom,cuspDiagonalReal,cuspDiagonal,SpecialLinearGroup.toGL,
      SpecialLinearGroup.map_apply_coe]
  rw [hd,_root_.zpow_neg,zpow_natCast] at h
  have hp : (-2/3:ℂ)^(2*m)=(2/3:ℂ)^(2*m) := by
    rw [pow_mul,pow_mul]
    congr 1
    ring
  rw [hp] at h
  have hn : (2/3:ℂ)^(2*m)≠0 := pow_ne_zero _ (by norm_num)
  have hh := congrArg (fun v : ℂ => v*((2/3:ℂ)^(2*m))) h
  calc
    g (cuspDiagonalReal • z)=g z*((2/3:ℂ)^(2*m)) := by
      simpa only [mul_assoc,inv_mul_cancel₀ hn,mul_one] using hh
    _ = (2/3:ℂ)^(2*m)*g z := mul_comm _ _

#print axioms original_diagonal_defect
#print axioms diagonal_recurrence
end QuantitativeArithmeticSmallLevelTwentyFivePairs
end
end

/-! ## TwentyFiveHyperbolicLaplace -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFivePairs
open Complex Matrix UpperHalfPlane SmallLevelOriginal
open QuantitativeArithmeticSlashLaplace
open scoped Manifold ModularForm MatrixGroups

compact_certificate theorem cusp_diagonal_logPoint (t : ℝ) :
    cuspDiagonalReal • logPoint 0 t=logPoint 0 (t+Real.log (9/4)) := by
  apply UpperHalfPlane.ext
  rw [cusp_diagonal_point,logPoint_coe,logPoint_coe,Real.exp_add,
    Real.exp_log (by norm_num : (0:ℝ)<9/4)]
  push_cast
  ring

/- Once the additive-pole argument supplies the continued transform of the
actual hyperbolic defect, its denominator-four transformation follows. -/
compact_certificate theorem positive4_of_laplace_data {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (data : Data (fun t =>
      ((((fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4)-fourierFunction (2*m) f)
        ∣[((2*m:ℕ):ℤ)] cuspCoordinatesReal) (logPoint 0 t)))) :
    fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4=fourierFunction (2*m) f := by
  let F := fourierFunction (2*m) f
  let v := (F ∣[((2*m:ℕ):ℤ)] positive4)-F
  let g := v ∣[((2*m:ℕ):ℤ)] cuspCoordinatesReal
  have hF : MDiff F := fourierFunction_holomorphic hf
  have hv : MDiff v := by
    exact (hF.slash ((2*m:ℕ):ℤ) positive4).sub hF
  have hg : MDiff g := hv.slash ((2*m:ℕ):ℤ) cuspCoordinatesReal
  have heig (t : ℝ) : g (logPoint 0 (t+Real.log (9/4)))=(2/3:ℂ)^(2*m)*g (logPoint 0 t) := by
    rw [← cusp_diagonal_logPoint]
    exact diagonal_recurrence g m (original_diagonal_defect m hf) _
  have hnorm : ‖(2/3:ℂ)^(2*m)‖<1 := by
    rw [norm_pow]
    have hbase : ‖(2/3:ℂ)‖=(2/3:ℝ) := by norm_num [norm_div]
    rw [hbase]
    exact pow_lt_one₀ (by norm_num) (by norm_num) (by omega)
  have hneq : (2/3:ℂ)^(2*m)≠1 := by
    intro he
    rw [he,norm_one] at hnorm
    exact (lt_irrefl 1) hnorm
  have hz : ∀ t : ℝ,g (logPoint 0 t)=0 :=
    data.zero_eigenfunction (hg.continuous.comp (logPoint_continuous 0)) (Real.log (9/4))
      (Real.log_pos (by norm_num)) ((2/3:ℂ)^(2*m))
      (pow_ne_zero _ (by norm_num)) hneq heig
  have hg0 : g=0 := zero_of_logarithmic_ray hg hz
  have hv0 : v=0 := (SlashAction.slash_eq_zero_iff _ _ _).mp hg0
  exact sub_eq_zero.mp hv0
#print axioms positive4_of_laplace_data
end QuantitativeArithmeticSmallLevelTwentyFivePairs
