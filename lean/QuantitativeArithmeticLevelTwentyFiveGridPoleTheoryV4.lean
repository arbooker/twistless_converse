/-! ## TwentyFiveGridSymbolic -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.GridSystem
open Complex
open QuantitativeArithmeticSmallLevelTwentyFive.SelectedWords
open QuantitativeArithmeticSmallLevelTwentyFive.GridRamanujan

compact_certificate def symbolicHecke (X Y a b : ℂ) (p t : ℕ) (v : Fin 150 → ℂ) : ℂ :=
  (∑ j∈Finset.range p, v (gridIndex ((t+j*(150/p):ℕ):ℤ)))-
    (if p=2 then a/X else b/Y)*v (gridIndex ((p*t:ℕ):ℤ))+
    (if p=2 then X⁻¹ else Y⁻¹)^2*v (gridIndex ((p^2*t:ℕ):ℤ))

compact_certificate def symbolicRows (χ X Y Z a b : ℂ) (v : Fin 150 → ℂ) : Fin 150 → ℂ :=
  assemble (fun i => v (gridIndex (groupSource i))-symbolicGroup X Y Z i*v (gridIndex (groupPartner i)))
    (fun i => plusRows v i-symbolicTaylor χ X Y Z i*minusRows v i) (entireRows v)
    (fun i => v (gridIndex (infinitySource i)))
    (fun i => if (heckeSpecs i).1=5 then fiveRow (heckeSpecs i).2 v else symbolicHecke X Y a b (heckeSpecs i).1 (heckeSpecs i).2 v)

compact_certificate theorem primeParameter_inverse (p m : ℕ) (s : ℂ) :
    (p:ℂ)^((m:ℂ)-s)=(primeParameter p m s)⁻¹ := by
  unfold primeParameter
  rw [show (m:ℂ)-s= -(s-(m:ℂ)) by ring,Complex.cpow_neg]

compact_certificate theorem heckeRow_symbolic (p t m : ℕ) (f : ℕ→ℂ) (s : ℂ) (v : Fin 150 → ℂ)
    (hp : p=2 ∨ p=3) :
    heckeRow p t m f s v=symbolicHecke (primeParameter 2 m s) (primeParameter 3 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) p t v := by
  rcases hp with rfl|rfl <;>
    simp only [heckeRow,symbolicHecke,primeParameter_inverse,show ¬(3:ℕ)=2 by decide,
      ite_true,ite_false,div_eq_mul_inv] <;> norm_num only [Nat.cast_ofNat]

compact_certificate theorem actual_leading_rows (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (v : Fin 150 → ℂ) :
    leadingRows m f ε s v=symbolicRows (phaseRoot m ε)
      (primeParameter 2 m s) (primeParameter 3 m s) (primeParameter 5 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) v := by
  funext i
  cases hi : rowKind i with
  | group j => simp only [leadingRows,symbolicRows,assemble,hi,groupCoefficient_laurent]
  | taylor j => simp only [leadingRows,symbolicRows,assemble,hi,taylorCoefficient_laurent]
  | entire j => simp only [leadingRows,symbolicRows,assemble,hi]
  | center j => simp only [leadingRows,symbolicRows,assemble,hi]
  | hecke j =>
    simp only [leadingRows,symbolicRows,assemble,hi,selectedHeckeRows]
    split_ifs with hbad
    · rfl
    · apply heckeRow_symbolic
      rcases heckeSpecs_valid j with h|h|h
      · exact Or.inl h
      · exact Or.inr h
      · exact (hbad h).elim

#print axioms actual_leading_rows
end QuantitativeArithmeticSmallLevelTwentyFive.GridSystem
end
end

/-! ## TwentyFiveNegativeGridSystem -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unnecessarySeqFocus false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.NegativeGridSystem
open Complex Matrix
open GridSystem (phaseRoot primeParameter)
open QuantitativeArithmeticSmallLevelTwentyFive.SelectedWords

compact_certificate def repair (v : Fin 150→ℂ) (a b : ℂ) (i : Fin 150) : ℂ :=
  if i=60 then a else if i=73 then b else v i

compact_certificate def leadingRows (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (v : Fin 150→ℂ) : Fin 150→ℂ :=
  repair (GridSystem.leadingRows m f ε s v)
    (heckeRow 2 20 m f s v) (heckeRow 3 10 m f s v)
compact_certificate def shiftRows (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ) (s : ℂ)
    (v : Fin 150→ℂ) : Fin 150→ℂ := repair (GridSystem.shiftRows m f ε n s v) 0 0

compact_certificate def leadingLinear (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) : (Fin 150→ℂ) →ₗ[ℂ] (Fin 150→ℂ) where
  toFun := leadingRows m f ε s
  map_add' := by
    intro v w
    funext i
    by_cases h60 : i=60
    · simp [leadingRows,repair,h60,heckeRow,Finset.sum_add_distrib] <;> ring
    by_cases h73 : i=73
    · simp [leadingRows,repair,h60,h73,heckeRow,Finset.sum_add_distrib] <;> ring
    · simp only [leadingRows,repair,h60,h73,ite_false,Pi.add_apply]
      exact congrFun ((GridSystem.leadingLinear m f ε s).map_add v w) i
  map_smul' := by
    intro a v
    funext i
    by_cases h60 : i=60
    · simp [leadingRows,repair,h60,heckeRow,smul_eq_mul,← Finset.mul_sum] <;> ring
    by_cases h73 : i=73
    · simp [leadingRows,repair,h60,h73,heckeRow,smul_eq_mul,← Finset.mul_sum] <;> ring
    · simp only [leadingRows,repair,h60,h73,ite_false,Pi.smul_apply,RingHom.id_apply]
      exact congrFun ((GridSystem.leadingLinear m f ε s).map_smul a v) i

compact_certificate def shiftLinear (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ) (s : ℂ) :
    (Fin 150→ℂ) →ₗ[ℂ] (Fin 150→ℂ) where
  toFun := shiftRows m f ε n s
  map_add' := by
    intro v w
    funext i
    by_cases h60 : i=60
    · simp [shiftRows,repair,h60]
    by_cases h73 : i=73
    · simp [shiftRows,repair,h60,h73]
    · simp only [shiftRows,repair,h60,h73,ite_false,Pi.add_apply]
      exact congrFun ((GridSystem.shiftLinear m f ε n s).map_add v w) i
  map_smul' := by
    intro a v
    funext i
    by_cases h60 : i=60
    · simp [shiftRows,repair,h60]
    by_cases h73 : i=73
    · simp [shiftRows,repair,h60,h73]
    · simp only [shiftRows,repair,h60,h73,ite_false,Pi.smul_apply,RingHom.id_apply]
      exact congrFun ((GridSystem.shiftLinear m f ε n s).map_smul a v) i

compact_certificate def leadingMatrix (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) : Matrix (Fin 150) (Fin 150) ℂ :=
  (leadingLinear m f ε s).toMatrix'
compact_certificate def shiftMatrix (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ) (s : ℂ) : Matrix (Fin 150) (Fin 150) ℂ :=
  (shiftLinear m f ε n s).toMatrix'
compact_certificate theorem leadingMatrix_mulVec (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (v : Fin 150→ℂ) :
    leadingMatrix m f ε s *ᵥ v=leadingRows m f ε s v := LinearMap.toMatrix'_mulVec _ _
compact_certificate theorem shiftMatrix_mulVec (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ) (s : ℂ) (v : Fin 150→ℂ) :
    shiftMatrix m f ε n s *ᵥ v=shiftRows m f ε n s v := LinearMap.toMatrix'_mulVec _ _
compact_certificate theorem leadingMatrix_apply (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (i j : Fin 150) :
    leadingMatrix m f ε s i j=leadingRows m f ε s (Pi.single j 1) i := LinearMap.toMatrix'_apply _ _ _
compact_certificate theorem shiftMatrix_apply (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ) (s : ℂ) (i j : Fin 150) :
    shiftMatrix m f ε n s i j=shiftRows m f ε n s (Pi.single j 1) i := LinearMap.toMatrix'_apply _ _ _

compact_certificate theorem heckeRow_analytic {p : ℕ} (hp : 0<p) (t m : ℕ) (f : ℕ→ℂ)
    (v : Fin 150→ℂ) (s : ℂ) : AnalyticAt ℂ (fun z => heckeRow p t m f z v) s := by
  have h := SmallLevelTaylor.hecke_parameter_analytic hp m s
  unfold heckeRow
  exact (analyticAt_const.sub ((analyticAt_const.mul h).mul analyticAt_const)).add
    ((h.pow 2).mul analyticAt_const)

compact_certificate theorem leadingMatrix_analytic (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (i j : Fin 150) :
    AnalyticAt ℂ (fun z => leadingMatrix m f ε z i j) s := by
  simp only [leadingMatrix_apply,leadingRows,repair]
  split_ifs
  · exact heckeRow_analytic (by decide) 20 m f _ s
  · exact heckeRow_analytic (by decide) 10 m f _ s
  · simpa only [GridSystem.leadingMatrix_apply] using GridSystem.leadingMatrix_analytic m f ε s i j

compact_certificate theorem shiftMatrix_analytic (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ) (s : ℂ) (i j : Fin 150) :
    AnalyticAt ℂ (fun z => shiftMatrix m f ε n z i j) s := by
  simp only [shiftMatrix_apply,shiftRows,repair]
  split_ifs
  · exact analyticAt_const
  · exact analyticAt_const
  · simpa only [GridSystem.shiftMatrix_apply] using GridSystem.shiftMatrix_analytic m f ε n s i j

/- Replacing two rows by exact good-prime Hecke identities preserves the
all-order analytic reconstruction system. This theorem holds for either phase. -/
compact_certificate theorem original_matrix_system {m : ℕ} (hm : 0< m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε) :
    ∃ B : ℝ, ∃ error : ℕ→ℂ→Fin 150→ℂ,
      (∀ i s, B<s.re → AnalyticAt ℂ (fun z => gridVector (2*m) f z i) s) ∧
      (∀ (M : ℕ) i s, B-((M:ℝ)+1)<s.re → AnalyticAt ℂ (fun z => error M z i) s) ∧
      ∀ M s, B<s.re → leadingMatrix m f ε s *ᵥ gridVector (2*m) f s=
        error M s+∑ n∈Finset.range M,
          shiftMatrix m f ε n s *ᵥ gridVector (2*m) f (s+((n:ℂ)+1)) := by
  obtain ⟨B0,E,hF,hE,hrows⟩ := GridSystem.original_matrix_system hm hf ε hlaw
  obtain ⟨B2,h2⟩ := original_grid_hecke hf (by decide : Nat.Prime 2) (by decide) (by decide)
  obtain ⟨B3,h3⟩ := original_grid_hecke hf (by decide : Nat.Prime 3) (by decide) (by decide)
  let B := max B0 (max B2 B3)
  have h0 : B0≤B := le_max_left _ _
  have hb2 : B2≤B := (le_max_left B2 B3).trans (le_max_right _ _)
  have hb3 : B3≤B := (le_max_right B2 B3).trans (le_max_right _ _)
  let err : ℕ→ℂ→Fin 150→ℂ := fun M s => repair (E M s) 0 0
  refine ⟨B,err,?_,?_,?_⟩
  · intro i s hs
    exact hF i s (lt_of_le_of_lt h0 hs)
  · intro M i s hs
    dsimp only [err,repair]
    split_ifs
    · exact analyticAt_const
    · exact analyticAt_const
    · exact hE M i s (by linarith)
  · intro M s hs
    rw [leadingMatrix_mulVec]
    simp_rw [shiftMatrix_mulVec]
    funext i
    by_cases h60 : i=60
    · simpa [leadingRows,shiftRows,err,repair,h60] using h2 20 s (lt_of_le_of_lt hb2 hs)
    by_cases h73 : i=73
    · simpa [leadingRows,shiftRows,err,repair,h60,h73] using h3 10 s (lt_of_le_of_lt hb3 hs)
    · have hh := hrows M s (lt_of_le_of_lt h0 hs)
      rw [GridSystem.leadingMatrix_mulVec] at hh
      simp_rw [GridSystem.shiftMatrix_mulVec] at hh
      simpa only [leadingRows,shiftRows,err,repair,h60,h73,ite_false,Pi.add_apply,
        Finset.sum_apply] using congrFun hh i

compact_certificate def symbolicRows (X Y Z a b : ℂ) (v : Fin 150→ℂ) : Fin 150→ℂ :=
  repair (GridSystem.symbolicRows (-1) X Y Z a b v)
    (GridSystem.symbolicHecke X Y a b 2 20 v) (GridSystem.symbolicHecke X Y a b 3 10 v)
compact_certificate theorem actual_leading_rows (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ)
    (hphase : phaseRoot m ε= -1) (v : Fin 150→ℂ) :
    leadingRows m f ε s v=symbolicRows (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) v := by
  simp only [leadingRows,symbolicRows,GridSystem.actual_leading_rows,hphase,
    GridSystem.heckeRow_symbolic 2 20 m f s v (Or.inl rfl),
    GridSystem.heckeRow_symbolic 3 10 m f s v (Or.inr rfl)]

#print axioms original_matrix_system
#print axioms actual_leading_rows
end QuantitativeArithmeticSmallLevelTwentyFive.NegativeGridSystem
end
