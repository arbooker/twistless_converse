/- The full positive leading system, with the fixed quotient gauge, is
injectively detected by five coordinates for arbitrary Hecke parameters. -/
compact_certificate theorem leading_kernel (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hs : ∀ j<4518, eval x y z w a b c v (source j)=0)
    (hf : ∀ j : Fin 5, v (coordinate (j.val+1045))=0) :
    ∀ j<1050, v j=0 := by
  have hn := leading_elimination x y z w a b c v hx hy hz hw hs
  have hnormal : ∀ i<1050, eval x y z w a b c v (normal i)=0 := by
    intro i hi
    by_cases h : i<1045
    · exact hn i h
    · have he : i-1045+1045=i := by omega
      have hh := free_rows ⟨i-1045,by omega⟩
      dsimp only at hh
      rw [he] at hh
      rw [hh]
      simpa [eval,monomial,he] using hf ⟨i-1045,by omega⟩
  have ht : ∀ i : Fin 1050, v (coordinate i.val)+eval x y z w a b c v (triTail i.val)=0 := by
    intro i
    have hh := hnormal i.val i.isLt
    rw [← all_triangular_checked i.val i.isLt,eval_mergeFuel] at hh
    simpa [eval,monomial] using hh
  have hzall := triangular_kernel x y z w a b c v 1050
    (fun i => coordinate i.val) (fun i => triTail i.val) ht (by
      intro i t ht
      obtain ⟨hbound,higher⟩ := all_triangular_prior i.val i.isLt t ht
      refine ⟨⟨position t.2.1,all_position_bound t.2.1 hbound⟩,higher,?_⟩
      exact (all_coordinate_position t.2.1 hbound).symm)
  intro j hj
  have hh := hzall ⟨position j,all_position_bound j hj⟩
  simpa only [all_coordinate_position j hj] using hh
#print axioms leading_kernel

end QuantitativeArithmeticSmallLevelTwentyFive.FullPlusLeading
end
