compact_certificate theorem modular_of_grid_poles {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (B : ℝ) (G : ℂ → Fin 150 → ℂ)
    (hG : ∀ j s,MeromorphicNFAt (fun z => G z j) s)
    (hGF : ∀ s,B<s.re → G s=gridVector (2*m) f s)
    (hGo : ∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hGa : ∀ s : ℂ,s≠((2*m:ℕ):ℂ) → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) s) :
    IsModular 25 (2*m) f := by
  have hregular (j : Fin 150) (s : ℂ) (hs : s≠((2*m:ℕ):ℂ)) :
      AnalyticAt ℂ (fun z => G z j) s :=
    (hG j s).meromorphicOrderAt_nonneg_iff_analyticAt.mp (hGa s hs j)
  have hgrid (j : ℤ) (s : ℂ) (hs : B<s.re) :
      G s (gridIndex j)=transform (fullCoefficients f (2*m)) ((j:ℝ)/150) s := by
    rw [hGF s hs,gridVector_index]
    rfl
  have h4 := positive4_of_additive_poles hm hf B (fun s => G s (gridIndex (-30)))
    (fun s => (hG _ s).meromorphicAt) (hregular _) (hGo _)
    (by intro s hs; simpa only [Int.cast_neg,Int.cast_ofNat,show (-30:ℝ)/150= -1/5 by norm_num] using hgrid (-30) s hs)
  have h3 := positive3_of_additive_poles hm hf h4 B
    (fun s => G s (gridIndex (-18))) (fun s => G s (gridIndex (-12)))
    (fun s => (hG _ s).meromorphicAt) (fun s => (hG _ s).meromorphicAt)
    (hregular _) (hregular _) (hGo _) (hGo _)
    (by intro s hs; simpa only [Int.cast_neg,Int.cast_ofNat,show (-18:ℝ)/150= -3/25 by norm_num] using hgrid (-18) s hs)
    (by intro s hs; simpa only [Int.cast_neg,Int.cast_ofNat,show (-12:ℝ)/150= -2/25 by norm_num] using hgrid (-12) s hs)
  exact modular_of_two m hf h3 h4
#print axioms modular_of_grid_poles
end QuantitativeArithmeticSmallLevelTwentyFive
