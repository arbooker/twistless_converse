compact_certificate theorem norm_quotient_enclosure (X Y : ℂ) (xl xh pl ph yl yh : ℝ)
    (hxl : 0≤xl) (hpl : 0<pl) (hph : 0≤ph) (hyl : 0≤yl) (hyh : 0≤yh)
    (hx : xl≤‖X‖^2 ∧ ‖X‖^2≤xh) (hp : pl≤‖X+1‖^2 ∧ ‖X+1‖^2≤ph)
    (hl : yl*ph≤xl^2) (hu : xh^2≤yh*pl) (he : Y*(X+1)=X^2) :
    yl≤‖Y‖^2 ∧ ‖Y‖^2≤yh := by
  have hn := congrArg (fun z : ℂ => ‖z‖^2) he
  simp only [norm_mul,norm_pow,mul_pow] at hn
  have hlx := pow_le_pow_left₀ hxl hx.1 2
  have hux := pow_le_pow_left₀ (sq_nonneg ‖X‖) hx.2 2
  have hlp := mul_le_mul_of_nonneg_left hp.2 hyl
  have hup := mul_le_mul_of_nonneg_left hp.1 hyh
  have hp0 : 0<‖X+1‖^2 := lt_of_lt_of_le hpl hp.1
  constructor
  · apply (mul_le_mul_iff_of_pos_right hp0).mp
    calc
      yl*‖X+1‖^2≤yl*ph := hlp
      _ ≤ xl^2 := hl
      _ ≤ (‖X‖^2)^2 := hlx
      _ = ‖Y‖^2*‖X+1‖^2 := hn.symm
  · apply (mul_le_mul_iff_of_pos_right hp0).mp
    calc
      ‖Y‖^2*‖X+1‖^2=(‖X‖^2)^2 := hn
      _ ≤ xh^2 := hux
      _ ≤ yh*pl := hu
      _ ≤ yh*‖X+1‖^2 := hup

compact_certificate theorem disk_not_physical (h : ℂ) (i : Fin 8)
    (hd : ‖(4:ℂ)^h-ratComplex (center i)‖≤(radius:ℝ))
    (he : (9:ℂ)^h*((4:ℂ)^h+1)=((4:ℂ)^h)^2) : False := by
  obtain ⟨hxl,hpl,hph,hyl,hyh,hxlo,hxhi,hplo,hphi,hlo,hhi,hex⟩ := geometry_certificates i
  have hx := squared_norm_enclosure_of_rational_error ((4:ℂ)^h) (center i) radius
    (xl i) (xh i) (by decide +kernel) hd hxlo hxhi
  have hds : ‖((4:ℂ)^h+1)-ratComplex (shiftedCenter i)‖≤(radius:ℝ) := by
    convert hd using 1
    congr 1
    simp [ratComplex,shiftedCenter]
    ring
  have hp := squared_norm_enclosure_of_rational_error ((4:ℂ)^h+1) (shiftedCenter i) radius
    (pl i) (ph i) (by decide +kernel) hds hplo hphi
  have hy := norm_quotient_enclosure ((4:ℂ)^h) ((9:ℂ)^h) (xl i) (xh i) (pl i) (ph i) (yl i) (yh i)
    (by exact_mod_cast hxl) (by exact_mod_cast hpl) (by exact_mod_cast hph)
    (by exact_mod_cast hyl) (by exact_mod_cast hyh) hx hp
    (by exact_mod_cast hlo) (by exact_mod_cast hhi) he
  exact QuantitativeArithmeticFourNinePhysicalPowers.excluded_interval h _ _ _ _ hxl hyl hex hx hy

compact_certificate theorem p8_not_physical (h : ℂ)
    (he : (9:ℂ)^h*((4:ℂ)^h+1)=((4:ℂ)^h)^2) (hp : p8.eval ((4:ℂ)^h)=0) : False := by
  obtain ⟨i,hi⟩ := p8_root_in_disk _ hp
  exact disk_not_physical h i hi.le he
#print axioms p8_not_physical
