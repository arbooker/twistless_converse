compact_certificate def cusp4CoordinatesReal : GL (Fin 2) ℝ :=
  SpecialLinearGroup.mapGL ℝ positive4*cuspCoordinatesReal

compact_certificate theorem cusp_coordinates_data :
    (GeneralLinearGroup.det cuspCoordinatesReal:ℝ)=1 ∧
    cuspCoordinatesReal 1 0≠0 ∧
    (0:ℝ)+cuspCoordinatesReal 1 1/cuspCoordinatesReal 1 0≠0 ∧
    cuspCoordinatesReal 0 0/cuspCoordinatesReal 1 0=(-1/5:ℝ) := by
  norm_num [cuspCoordinatesReal,cuspCoordinates,SpecialLinearGroup.toGL,
    SpecialLinearGroup.map_apply_coe]

compact_certificate theorem cusp4_coordinates_data :
    (GeneralLinearGroup.det cusp4CoordinatesReal:ℝ)=1 ∧
    cusp4CoordinatesReal 1 0≠0 ∧
    (0:ℝ)+cusp4CoordinatesReal 1 1/cusp4CoordinatesReal 1 0≠0 ∧
    cusp4CoordinatesReal 0 0/cusp4CoordinatesReal 1 0=(-1/5:ℝ) := by
  norm_num [cusp4CoordinatesReal,cuspCoordinatesReal,cuspCoordinates,positive4,
    SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe,
    Matrix.mul_apply,Matrix.vecMul,dotProduct,Fin.sum_univ_two]

/- The pole restriction at -1/5 supplies the transform of the actual
hyperbolic defect, with its convergent integral identity. -/
compact_certificate theorem positive4_of_additive_poles {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (B : ℝ) (G : ℂ → ℂ) (hG : ∀ s,MeromorphicAt G s)
    (hGa : ∀ s,s≠((2*m:ℕ):ℂ) → AnalyticAt ℂ G s)
    (hGo : (-1:WithTop ℤ)≤ meromorphicOrderAt G ((2*m:ℕ):ℂ))
    (hGF : ∀ s,B<s.re → G s=SmallLevelAdditive.transform (fullCoefficients f (2*m)) (-1/5) s) :
    fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4=fourierFunction (2*m) f := by
  obtain ⟨τ,hτ,hgrowth⟩ := hf.growth
  have ha := polynomial_bound hf.zero hgrowth (2*m)
  have ha0 := fullCoefficients_zero hf.zero (2*m)
  obtain ⟨det0,c0,x0,alpha0⟩ := cusp_coordinates_data
  obtain ⟨det4,c4,x4,alpha4⟩ := cusp4_coordinates_data
  obtain ⟨d0⟩ := nonempty_data_of_slash (2*m) ha ha0 cuspCoordinatesReal det0 c0 0 x0 B G hG hGa hGo
    (by simpa only [alpha0] using hGF)
  obtain ⟨d4⟩ := nonempty_data_of_slash (2*m) ha ha0 cusp4CoordinatesReal det4 c4 0 x4 B G hG hGa hGo
    (by simpa only [alpha4] using hGF)
  apply positive4_of_laplace_data hm hf
  have dd := d4.sub d0
  change Data (fun t => (fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] cusp4CoordinatesReal) (logPoint 0 t)-
    (fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] cuspCoordinatesReal) (logPoint 0 t)) at dd
  simpa only [cusp4CoordinatesReal,SlashAction.slash_mul,SmallLevelEleven.sub_slash,
    Pi.sub_apply,ModularForm.SL_slash,SpecialLinearGroup.mapGL,
    MonoidHom.comp_apply,algebraMap_int_eq] using dd
#print axioms positive4_of_additive_poles
end QuantitativeArithmeticSmallLevelTwentyFivePairs
end
