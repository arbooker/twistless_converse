    apply substitution_zero x y z 1 a 1 1 v hx hy hz (by norm_num)
    rw [← substituteCompute_eq]
    exact basis_pivots i
  have hd := pivots_free_zero x y z a (fun j => v j-eval x y z 1 a 1 1 v (basis j))
    (fun i => by rw [eval_sub,pivot_rows_of_sources x y z a v hx hy hz hsource i,hb i,sub_self])
