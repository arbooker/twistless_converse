namespace QuantitativeNewGap

/-- The actual overgroup generated by the two repeated old degeneracies. -/
def repeatedJoin (L : ℕ) : Subgroup AsymptoticRationalGroup.Group :=
  gamma (2*L) ⊔ degeneracyGroup (2*L) 2 (by norm_num)

def repeatedBase (L : ℕ) : Subgroup (repeatedJoin L) :=
  (gamma (2*(2*L))).subgroupOf (repeatedJoin L)

def repeatedOld₀ (L : ℕ) : Subgroup (repeatedJoin L) :=
  (gamma (2*L)).subgroupOf (repeatedJoin L)

def repeatedOld₁ (L : ℕ) : Subgroup (repeatedJoin L) :=
  (degeneracyGroup (2*L) 2 (by norm_num)).subgroupOf (repeatedJoin L)

theorem repeatedBase_le_old₀ (L : ℕ) : repeatedBase L ≤ repeatedOld₀ L := by
  intro g hg
  exact gamma_le_of_dvd (Nat.dvd_mul_left (2*L) 2) hg

theorem repeatedBase_le_old₁ (L : ℕ) (hL : 0<L) : repeatedBase L ≤ repeatedOld₁ L := by
  intro g hg
  exact gamma_le_degeneracyGroup (2*L) 2 (by omega) (by norm_num) hg

/-- Both parity cases of the literal repeated old join are finite. Their
indices are exactly six and four, respectively. -/
theorem repeatedBase_index (L : ℕ) (hL : 0<L) :
    (repeatedBase L).index=if 2∣L then 4 else 6 := by
  change (gamma (2*(2*L))).relIndex (repeatedJoin L)=_
  by_cases h : 2∣L
  · rw [ite_eq_left h]
    let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    simpa only [repeatedJoin,show (2:ℕ)^2=4 from rfl] using higher_join_index L 2 hL h
  · rw [ite_eq_right h]
    exact square_two_join_index L hL h

theorem repeatedBaseFiniteIndex (L : ℕ) (hL : 0<L) : (repeatedBase L).FiniteIndex := by
  constructor
  rw [repeatedBase_index L hL]
  split <;> norm_num

/-- Genuine finite averaging coercivity for the actual repeated-prime
root quotient, including the admissible levels of 2-adic exponents 2 and 3.
The root quotient and its old projections are literal congruence cosets.
Transport to every infinite ambient coset block is a separate step. -/
theorem repeated_old_block_gap (L : ℕ) (hL : 0<L) :
    let : (repeatedBase L).FiniteIndex := repeatedBaseFiniteIndex L hL
    ∃ γ : ℝ, 0<γ ∧ ∀ v : ℓ²(Classes (repeatedBase L),ℂ),
      γ*‖v-(newSpace (repeatedBase_le_old₀ L) (repeatedBase_le_old₁ L hL)).starProjection v‖^2 ≤
        ‖(space (repeatedBase_le_old₀ L)).starProjection v‖^2+
        ‖(space (repeatedBase_le_old₁ L hL)).starProjection v‖^2 := by
  let : (repeatedBase L).FiniteIndex := repeatedBaseFiniteIndex L hL
  exact finite_coset_old_average_gap (repeatedBase_le_old₀ L) (repeatedBase_le_old₁ L hL)

#print axioms repeatedBase_index
