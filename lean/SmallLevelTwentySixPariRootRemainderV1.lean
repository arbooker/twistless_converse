theorem remainder_identity (x y z w a b θ : ℂ) :
    SmallLevelTwentySixPariIdentity011.p1 x y z w a b θ=
      SmallLevelTwentySixPariIdentity041.p2 x y z w a b θ+
        quotient x y*SmallLevelTwentySixPariIdentity041.p5 x y z w a b θ := by
  simp only [SmallLevelTwentySixPariIdentity011.p1,SmallLevelTwentySixPariIdentity041.p2,SmallLevelTwentySixPariIdentity041.coefficients2,SmallLevelTwentySixPariIdentity041.p5,SmallLevelTwentySixPariIdentity041.coefficients5,SmallLevelPolynomialCoefficientCertificate.evaluate,quotient,SmallLevelTwentySixPariIdentity041.c2_0,SmallLevelTwentySixPariIdentity041.c2_1,SmallLevelTwentySixPariIdentity041.c2_2,SmallLevelTwentySixPariIdentity041.c2_3,SmallLevelTwentySixPariIdentity041.c2_4,SmallLevelTwentySixPariIdentity041.c2_5,SmallLevelTwentySixPariIdentity041.c2_6,SmallLevelTwentySixPariIdentity041.c2_7,SmallLevelTwentySixPariIdentity041.c2_8,SmallLevelTwentySixPariIdentity041.c2_9,SmallLevelTwentySixPariIdentity041.c2_10,SmallLevelTwentySixPariIdentity041.c5_0]
  ring

theorem remainder_zero (x y z w a b θ : ℂ)
    (h11 : SmallLevelTwentySixPariIdentity011.p1 x y z w a b θ=0)
    (hmod : SmallLevelTwentySixPariIdentity041.p5 x y z w a b θ=0) :
    SmallLevelTwentySixPariIdentity041.p2 x y z w a b θ=0 := by
  have h:=remainder_identity x y z w a b θ
  rw [h11,hmod,mul_zero,add_zero] at h
  exact h.symm

/-- The generic algebraic endpoint. The original source equations still have
 to supply the reduced row87 polynomial and final eliminant hypotheses. -/
theorem no_signed_generic (m : ℕ) (s u z w a b θ : ℂ)
    (hu : u=1 ∨ u= -1) (hx2 : u*parameter 2 m s≠2)
    (hc : lowCurve (u*parameter 2 m s) ((parameter 3 m s)^2) z w a b θ=0)
    (h11 : SmallLevelTwentySixPariIdentity011.p1
      (u*parameter 2 m s) ((parameter 3 m s)^2) z w a b θ=0)
    (he : SmallLevelTwentySixPariIdentity022.p4
      (u*parameter 2 m s) ((parameter 3 m s)^2) z w a b θ=0) : False := by
  have hp:=SmallLevelTwentySixPariGenericBranches.degree21_of_eliminant m s u z w a b θ hu hx2 hc he
  have hmod : SmallLevelTwentySixPariIdentity041.p5
      (u*parameter 2 m s) ((parameter 3 m s)^2) z w a b θ=0 := by
    rw [SmallLevelTwentySixPariRootBinding.modulus_binding,hp,mul_zero]
  have h2:=remainder_zero _ _ _ _ _ _ _ h11 hmod
  have h0 : SmallLevelTwentySixPariIdentity041.p0
      (u*parameter 2 m s) ((parameter 3 m s)^2) z w a b θ=0 := by
    rw [SmallLevelTwentySixPariRootBinding.low_curve_binding]
    exact hc
  have hroot:=SmallLevelTwentySixPariRootBinding.root_relation _ _ _ _ _ _ _ h0 h2 hmod
  exact SmallLevelTwentySixRoot.no_signed_parameter_locus m s u hu hp hroot.2

#print axioms remainder_identity
#print axioms remainder_zero
#print axioms no_signed_generic
end SmallLevelTwentySixPariRootRemainder
