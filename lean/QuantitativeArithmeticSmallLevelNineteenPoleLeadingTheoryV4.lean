theorem denominator_gap_dichotomy (m n : ℕ) (f : ℕ→ℂ) (s : ℂ)
    (hs : (m:ℝ)≤s.re) (hd : denominator (2*m) f s=0) :
    poleParameter f= -poleCoordinate m (s+(n:ℂ))-1/poleCoordinate m (s+(n:ℂ)) ∨
    (poleCoordinate m (s+(n:ℂ)))^2+poleParameter f*poleCoordinate m (s+(n:ℂ))+1≠0 := by
  by_cases hn : n=0
  · left
    rw [hn,Nat.cast_zero,add_zero]
    have h := denominator_zero_quadratic m f s hd
    have hx := poleCoordinate_ne_zero m s
    apply mul_right_cancel₀ hx
    linear_combination (norm := (field_simp [hx]; ring1)) h
  · exact Or.inr (denominator_positive_gap_factor m n f s (Nat.pos_of_ne_zero hn) hs hd)

/-- Leading rows suffice to normalize the upper pole vector on every
actual gap, including the real weight point where first Taylor factors vanish. -/
theorem leading_coordinates_gap0 (x y z a b : ℂ)
    (hx : x≠0) (hy : y≠0) (ha : a≠0) (hx4 : x^4≠1)
    (hgap : a= -x-1/x ∨ x^2+a*x+1≠0)
    (v : Fin 114→ℂ) (hr : residualRows0 x y z a b v=0) :
    v 72= -v 42 ∧ x*a*(y^2+1)*v 18+(x^4+(a^2-2)*x^2+1)*v 42=0 := by
  have hv : v 72= -v 42 := by
    have hsum : v 42+v 72=0 := by
      rcases hgap with hg|hg
      · have hxp : x^2+1≠0 := by
          intro h
          have he : x^2= -1 := eq_neg_of_add_eq_zero_left h
          apply hx4
          calc
            x^4=(x^2)^2 := by ring
            _=1 := by rw [he]; norm_num
        obtain ⟨h1,h2⟩ := gap_zero_short_rows0 x y z a b hx hy hxp hg v hr
        have h : (x^4-1)*(v 42+v 72)=0 := by linear_combination h1-h2
        exact (mul_eq_zero.mp h).resolve_left (sub_ne_zero.mpr hx4)
      · exact (mul_eq_zero.mp (short_hecke_row0 x y z a b hx v hr)).resolve_left hg
    linear_combination hsum
  exact ⟨hv,short_fricke_row0 x y z a b hx hy ha v hr hv⟩

/-- The coordinate normalization is now derived from the actual734 leading
rows at a translate of an actual denominator zero. -/
theorem actual_gap_coordinates0 (m n : ℕ) (f : ℕ→ℂ) (s z b : ℂ)
    (hs : (m:ℝ)≤s.re) (hd : denominator (2*m) f s=0)
    (ha : f 2≠0) (hz : z≠0) (hx4 : (poleCoordinate m (s+(n:ℂ)))^4≠1)
    (v : Fin 114→ℂ)
    (hv : symbolicRows (-1) (-1) (poleCoordinate m (s+(n:ℂ)))
      ((3:ℂ)^(s+(n:ℂ)-(m:ℂ))) z (poleParameter f) b v=0) :
    v 72= -v 42 ∧
      poleCoordinate m (s+(n:ℂ))*poleParameter f*(((3:ℂ)^(s+(n:ℂ)-(m:ℂ)))^2+1)*v 18+
        ((poleCoordinate m (s+(n:ℂ)))^4+((poleParameter f)^2-2)*(poleCoordinate m (s+(n:ℂ)))^2+1)*v 42=0 := by
  have hx := poleCoordinate_ne_zero m (s+n)
  have hy : (3:ℂ)^(s+(n:ℂ)-(m:ℂ))≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have ha' : poleParameter f≠0 := mul_ne_zero
    (Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))) ha
  obtain ⟨hr,_hinj⟩ := actual_symbolic_kernel_reduce0 _ _ z (poleParameter f) b hx hy hz ha' v hv
  exact leading_coordinates_gap0 _ _ z (poleParameter f) b hx hy ha' hx4
    (denominator_gap_dichotomy m n f s hs hd) v hr

