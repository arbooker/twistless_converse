    (x^4+b*y)*(v 42+v 72)=0 ∧ (b*y+1)*(v 42+v 72)=0 := by
  constructor
  · have h := congrFun hr (10:Fin 27)
    change (((x^(4:ℕ) + y*b)/(y^(2:ℕ)))*v 42 + ((x^(4:ℕ) + y*b)/(y^(2:ℕ)))*v 72)=0 at h
    linear_combination (norm := (field_simp [hy]; ring1)) y^2*h
  · have h := gap_zero_sum_identity2 x y z a b hx hy hxp hgap v
    rw [hr] at h
    change (0:ℂ)+0= -((b*y+1)/y^2)*(v 42+v 72) at h
    linear_combination (norm := (field_simp [hy]; ring1)) y^2*h

