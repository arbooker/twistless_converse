  linear_combination (norm := (field_simp [hx]; ring1)) -(x^2)*h

theorem short_fricke_row2 (x y z a b : ℂ) (hx : x≠0) (hy : y≠0) (ha : a≠0)
    (v : Fin 114→ℂ) (hr : residualRows2 x y z a b v=0) (h72 : v 72= -v 42) :
    x*a*(y^2+1)*v 18+(x^4+(a^2-2)*x^2+1)*v 42=0 := by
  have h := congrFun hr (0:Fin 27)
  change (((y^(2:ℕ) + (1:ℂ))/(x^(2:ℕ)*y^(2:ℕ)))*v 18 + (((-1:ℂ)*x^(3:ℕ)*a + (-1:ℂ)*x^(2:ℕ) + (1:ℂ))/(x^(3:ℕ)*y^(2:ℕ)*a))*v 42 + (((-1:ℂ)*x^(2:ℕ) + (-1:ℂ)*x*a + (-1:ℂ)*a^(2:ℕ) + (1:ℂ))/(x*y^(2:ℕ)*a))*v 72)=0 at h
  rw [h72] at h
  linear_combination (norm := (field_simp [hx,hy,ha]; ring1)) (x^3*y^2*a)*h

