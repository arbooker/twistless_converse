/-- For a positive gap, the leading Hecke quadratic cannot vanish at the
upper pole: its putative root would contradict the right-half-plane bound. -/
theorem positive_gap_factor_ne_zero (L : ℝ) (hL : 1<L) (X A : ℂ)
    (hgap : A= -X/(L:ℂ)-(L:ℂ)) (hnorm : L^2≤‖X‖) : X+A+1≠0 := by
  intro he
  have hL0 : (L:ℂ)≠0 := by exact_mod_cast (by linarith : L≠0)
  have hL1 : (L:ℂ)-1≠0 := by exact_mod_cast (by linarith : L-1≠0)
  have hprod : ((L:ℂ)-1)*(X-(L:ℂ))=0 := by
    linear_combination (norm := (field_simp [hL0]; ring1)) (L:ℂ)*he-(L:ℂ)*hgap
  have hX : X=(L:ℂ) := sub_eq_zero.mp ((mul_eq_zero.mp hprod).resolve_left hL1)
  rw [hX,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (by linarith : 0<L)] at hnorm
  nlinarith

theorem denominator_positive_gap_factor (m n : ℕ) (f : ℕ→ℂ) (s : ℂ)
    (hn : 0<n) (hs : (m:ℝ)≤s.re) (hd : denominator (2*m) f s=0) :
    (poleCoordinate m (s+(n:ℂ)))^2+
      poleParameter f*poleCoordinate m (s+(n:ℂ))+1≠0 := by
  have hnorm : ((2:ℝ)^n)^2≤‖(poleCoordinate m (s+(n:ℂ)))^2‖ := by
    rw [norm_pow]
    have h := poleCoordinate_norm_lower m n s hs
    nlinarith [norm_nonneg (poleCoordinate m (s+(n:ℂ))),pow_pos (by norm_num : (0:ℝ)<2) n]
  have hL : (1:ℝ)<(2:ℝ)^n := by
    have h := pow_le_pow_right₀ (by norm_num : (1:ℝ)≤2) (by omega : 1≤n)
    norm_num at h
    linarith
  apply positive_gap_factor_ne_zero ((2:ℝ)^n) hL _ _ _ hnorm
  simpa only [Complex.ofReal_pow,Complex.ofReal_ofNat] using denominator_zero_gap m n f s hd

theorem short_hecke_row0 (x y z a b : ℂ) (hx : x≠0)
    (v : Fin 114→ℂ) (hr : residualRows0 x y z a b v=0) :
    (x^2+a*x+1)*(v 42+v 72)=0 := by
  have h := congrFun hr (1:Fin 27)
  change ((((-1:ℂ)*x^(2:ℕ) + (-1:ℂ)*x*a + (-1:ℂ))/(x^(2:ℕ)))*v 42 + (((-1:ℂ)*x^(2:ℕ) + (-1:ℂ)*x*a + (-1:ℂ))/(x^(2:ℕ)))*v 72)=0 at h
  linear_combination (norm := (field_simp [hx]; ring1)) -(x^2)*h

theorem short_fricke_row0 (x y z a b : ℂ) (hx : x≠0) (hy : y≠0) (ha : a≠0)
    (v : Fin 114→ℂ) (hr : residualRows0 x y z a b v=0) (h72 : v 72= -v 42) :
    x*a*(y^2+1)*v 18+(x^4+(a^2-2)*x^2+1)*v 42=0 := by
  have h := congrFun hr (0:Fin 27)
  change (((y^(2:ℕ) + (1:ℂ))/(x^(2:ℕ)*y^(2:ℕ)))*v 18 + (((-1:ℂ)*x^(3:ℕ)*a + (-1:ℂ)*x^(2:ℕ) + (1:ℂ))/(x^(3:ℕ)*y^(2:ℕ)*a))*v 42 + (((-1:ℂ)*x^(2:ℕ) + (-1:ℂ)*x*a + (-1:ℂ)*a^(2:ℕ) + (1:ℂ))/(x*y^(2:ℕ)*a))*v 72)=0 at h
  rw [h72] at h
  linear_combination (norm := (field_simp [hx,hy,ha]; ring1)) (x^3*y^2*a)*h

#print axioms short_hecke_row0
#print axioms short_fricke_row0
theorem short_hecke_row2 (x y z a b : ℂ) (hx : x≠0)
