set_option maxHeartbeats 60000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate

theorem generic_y_certificate (x y z : ℂ)
    (h0 : genericInput0 x y z=0)
    (h1 : genericInput1 x y z=0)
    (h2 : genericInput2 x y z=0)
    : (z-1)*(x+1)^(2:ℕ)*(x^(2:ℕ)-x+y+3)*(y-genericQ16 x)=0 := by
  rw [← generic_y_sum2, ← generic_y_sum1]
  rw [← generic_y_product0, ← generic_y_product1, ← generic_y_product2, h0, h1, h2]
  ring

#print axioms generic_y_certificate
end QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate
