/-! ## TwentyFiveOriginalModularity -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive
open Complex

compact_certificate theorem original_modular {m : ℕ} (hm : 0 < m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f) :
    SmallLevelOriginal.IsModular 25 (2*m) f := by
  obtain ⟨ε,hε,hlaw⟩ := QuantitativeArithmeticCoherentTaylor.original_coherent_law (by decide : 0<25) hf
  have hχ : ε*Complex.I^(2*m)=1 ∨ ε*Complex.I^(2*m)= -1 := by
    have hi : Complex.I^(2*m)=(-1:ℂ)^m := by rw [pow_mul,I_sq]
    rcases neg_one_pow_eq_or ℂ m with h|h <;> rcases hε with he|he <;> simp [hi,h,he]
  rcases hχ with hχ|hχ
  · obtain ⟨B,G,hG,hGF,hGo,hGa⟩ := OriginalCertificates.original_positive_all_continued_poles hm hf ε hε hlaw hχ
    exact modular_of_grid_poles hm hf B G hG hGF hGo hGa
  · obtain ⟨B,G,hG,hGF,hGo,hGa⟩ := MinusOriginalCertificates.original_negative_all_continued_poles hm hf ε hε hlaw hχ
    exact modular_of_grid_poles hm hf B G hG hGF hGo hGa
#print axioms original_modular
end QuantitativeArithmeticSmallLevelTwentyFive
end
