set_option autoImplicit false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.SecondChart

compact_certificate def fone (B Y X : ℂ) : ℂ := B*X^2-Y*X-Y+2*X
compact_certificate def cone (Y X : ℂ) : ℂ := 3*X^2+2*X*Y+9*X+8*Y
compact_certificate def hone (B Y X : ℂ) : ℂ := 12*B*X-3*X^2-2*X*Y+3*X-8*Y+60

compact_certificate theorem minus_one_p3 (B Y X : ℂ) :
    p3 B (-1) Y X= -(2/15)*cone Y X*fone B Y X := by
  unfold p3 cone fone
  ring

compact_certificate theorem minus_one_p4 (B Y X : ℂ) :
    p4 B (-1) Y X=(2/15)*fone B Y X*hone B Y X := by
  unfold p4 hone fone
  ring

compact_certificate theorem minus_one_fzero (B Y X : ℂ) (hY : Y≠0) (hX : X≠0)
    (h2 : p2 B (-1) Y X=0) (h3 : p3 B (-1) Y X=0)
    (h4 : p4 B (-1) Y X=0) (h5 : p5 B (-1) Y X=0) :
    fone B Y X=0 := by
  by_contra hF
  rw [minus_one_p3] at h3
  rw [minus_one_p4] at h4
  have hC : cone Y X=0 := (mul_eq_zero.mp
    ((mul_eq_zero.mp h3).resolve_right hF)).resolve_left (by norm_num)
  have hH : hone B Y X=0 := (mul_eq_zero.mp h4).resolve_left
    (mul_ne_zero (by norm_num) hF)
  unfold cone at hC
  unfold hone at hH
  have hr : B*X+X+5=0 := by linear_combination (hC+hH)/12
  have hx3 : X+3≠0 := by
    intro he
    have hx : X= -3 := by linear_combination he
    rw [hx] at hC
    apply hY
    linear_combination hC/2
  have he2 : 5*X*(X+3)*(X^2+3*X-1)=0 := by
    unfold p2 at h2
    linear_combination -2*(X+4)*h2 + 2*X*(X+4)*(X-Y-1)*hr +
      (X^2+3*X+1)*hC
  have he5 : 5*X*(X+3)*(X^2+2*X+4)=0 := by
    unfold p5 at h5
    linear_combination 2*(X+4)*h5 - 2*(X+4)*(B*X^2-X^2-2*X-Y)*hr -
      (-X^2+2*X+4)*hC
  have hn : 5*X*(X+3)≠0 := mul_ne_zero (mul_ne_zero (by norm_num) hX) hx3
  have ht2 := (mul_eq_zero.mp he2).resolve_left hn
  have ht5 := (mul_eq_zero.mp he5).resolve_left hn
  have hx5 : X=5 := by linear_combination ht2-ht5
  norm_num [hx5] at ht5

compact_certificate theorem minus_one_values (B Y X : ℂ) (hY : Y≠0) (hX : X≠0)
    (h2 : p2 B (-1) Y X=0) (h3 : p3 B (-1) Y X=0)
    (h4 : p4 B (-1) Y X=0) (h5 : p5 B (-1) Y X=0) :
    B*X=X-2 ∧ Y*(X+1)=X^2 := by
  have hF := minus_one_fzero B Y X hY hX h2 h3 h4 h5
  unfold fone at hF
  have he : X*Y*(B*X-X+2)=0 := by
    unfold p2 at h2
    linear_combination (X-1)*hF-h2
  have he0 := (mul_eq_zero.mp he).resolve_left (mul_ne_zero hX hY)
  constructor
  · linear_combination he0
  · linear_combination X*he0-hF

#print axioms minus_one_values
end QuantitativeArithmeticSmallLevelTwentyFive.SecondChart
end
end

/-! ## TwentyFiveSecondChartMinusTwo -/
section
set_option autoImplicit false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.SecondChart

compact_certificate def ysol (X : ℂ) : ℂ := 2*X-X/(X-1)

compact_certificate theorem minus_two_p1 (X : ℂ) (hX : X≠0) (hXm : X-1≠0) :
    (X-1)*p1 (bsol (-2) (ysol X) X) (-2) (ysol X) X=
      6*X^2*ysol X*(2*X^2-3) := by
  unfold p1 bsol ysol
  field_simp
  ring

compact_certificate theorem minus_two_values (B Y X : ℂ) (hY : Y≠0) (hX : X≠0)
    (h0 : p0 B (-2) Y X=0) (h1 : p1 B (-2) Y X=0)
    (h5 : p5 B (-2) Y X=0) : Y= -3 ∧ 2*X^2=3 := by
  rw [p0_factor B (-2) Y X hX] at h0
  have hB : B=bsol (-2) Y X := sub_eq_zero.mp
    ((mul_eq_zero.mp h0).resolve_left (mul_ne_zero (by norm_num) (pow_ne_zero 2 hX)))
  rw [hB,p5_sub (-2) Y X hX] at h5
  have hg : g (-2) Y X=0 := (mul_eq_zero.mp h5).resolve_left
    (mul_ne_zero (by norm_num) hY)
  have hXm : X-1≠0 := by
    intro hh
    have hx1 : X=1 := sub_eq_zero.mp hh
    norm_num [g,hx1] at hg
  have hys : Y=ysol X := by
    unfold ysol
    field_simp
    unfold g at hg
    linear_combination hg
  have hi := minus_two_p1 X hX hXm
  rw [← hys,← hB,h1,mul_zero] at hi
  have hs : 2*X^2-3=0 := (mul_eq_zero.mp hi.symm).resolve_left
    (mul_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero 2 hX)) hY)
  have hy : (X-1)*(Y+3)=0 := by
    unfold g at hg
    linear_combination hg+hs
  exact ⟨by have hh := (mul_eq_zero.mp hy).resolve_left hXm; linear_combination hh,
    sub_eq_zero.mp hs⟩

compact_certificate theorem minus_two_no_physical (h : ℂ) (B : ℂ)
    (h0 : p0 B (-2) ((9:ℂ)^h) ((4:ℂ)^h)=0)
    (h1 : p1 B (-2) ((9:ℂ)^h) ((4:ℂ)^h)=0)
    (h5 : p5 B (-2) ((9:ℂ)^h) ((4:ℂ)^h)=0) : False := by
  have hn (p : ℕ) (hp : p≠0) : (p:ℂ)^h≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  obtain ⟨hy,hx⟩ := minus_two_values B ((9:ℂ)^h) ((4:ℂ)^h)
    (hn 9 (by decide)) (hn 4 (by decide)) h0 h1 h5
  have hxn := congrArg norm hx
  norm_num [norm_mul,norm_pow] at hxn
  have hyn : ‖(9:ℂ)^h‖^2=9 := by rw [hy]; norm_num
  apply QuantitativeArithmeticFourNinePhysicalPowers.excluded_interval h (3/2) (3/2) 9 9
    (by norm_num) (by norm_num)
    (by norm_num [QuantitativeArithmeticFourNinePhysicalPowers.IntervalExcluded])
  · constructor <;> norm_num <;> linarith
  · constructor <;> norm_num <;> linarith
#print axioms minus_two_values
#print axioms minus_two_no_physical
end QuantitativeArithmeticSmallLevelTwentyFive.SecondChart
end
end

/-! ## TwentyFiveOriginalSecondChartValues -/
section
