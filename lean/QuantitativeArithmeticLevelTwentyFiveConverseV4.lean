    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) s v)
    (hshift : ∀ n : ℕ,0 < n → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) (s+n)) (hf2 : f 2≠0) (h420 : v ⟨420,by decide⟩=0) (h840 : v ⟨840,by decide⟩=0) : False := by
  have h756 : v ⟨756,by decide⟩=0 := by
    by_contra hn
    exact regularized_no_negative_first_chart hm hf ε hε hlaw hχ BG G hG hGF s v hv hshift hf2 h420 hn
  have h882 : v ⟨882,by decide⟩=0 := by
    by_contra hn
    exact regularized_no_negative_second_chart hm hf ε hε hlaw hχ BG G hG hGF s v hv hshift hf2 h420 h756 hn
  have hrows := regularized_original_rows hm hf ε hε hlaw hχ BG G hG hGF s v hv hshift
  have hp (p : ℕ) (hpn : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hpn))
  have ha : (Real.sqrt 2:ℂ)*f 2≠0 := mul_ne_zero (by
    exact_mod_cast (ne_of_gt (Real.sqrt_pos.2 (by norm_num : (0:ℝ)<2)))) hf2
  have h420' : periodicVector v 420=0 := by simpa [periodicVector] using h420
  have h756' : periodicVector v 756=0 := by simpa [periodicVector] using h756
  have h840' : periodicVector v 840=0 := by simpa [periodicVector] using h840
  have h882' : periodicVector v 882=0 := by simpa [periodicVector] using h882
  have h294 := NegativeCoordinate.coordinate294_zero _ _ _ _ _ _ _ (periodicVector v)
    (hp 2 (by decide)) (hp 3 (by decide)) (hp 5 (by decide)) (hp 7 (by decide)) ha h420' h756' h882' hrows
  have hall := FullMinusLeading.kernel_from_five _ _ _ _ _ _ _ (periodicVector v)
    (hp 2 (by decide)) (hp 3 (by decide)) (hp 5 (by decide)) (hp 7 (by decide)) hrows h294 h420' h756' h840' h882'
  apply hv.1
  funext j
  simpa only [periodicVector_fin,Pi.zero_apply] using hall j.val j.isLt
#print axioms regularized_no_negative_nonzero_two_at_zero_cusp
end QuantitativeArithmeticSmallLevelTwentyFive.MinusOriginalCertificates
