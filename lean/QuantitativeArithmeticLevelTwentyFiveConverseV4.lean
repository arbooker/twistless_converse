      intro hz
      exact NegativeDZeroSmall.no_d_zero u B A _ _ hA hY hX hA1 hz h0 h1 h2 h3 h4
    exact NegativeGenericSmall.no_generic_physical h A u B hA hA1 hA2 hD h0 h1 h2 h3 h4
