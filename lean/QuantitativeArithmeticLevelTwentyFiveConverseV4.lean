compact_certificate theorem combined_H_zero (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (h630 : v 630=0) (h672 : v 672=0) (h756 : v 756≠0)
    (ha : a*x= -1) (hb : b*y*x^2=x^2-2)
    (hs : ∀ j<4518,eval x y z w a b c v (FullPlusLeading.source j)=0)
    (hj : eval x y z w a b c (fun j => eval x y z w a b c v (actualJet j)) combinedLeft=0) :
    H (x^2) (y^2)=0 := by
  have ha' : a= -1/x := by
    field_simp
    linear_combination ha
  have hb' : b=(x^2-2)/(x^2*y) := by
    field_simp
    linear_combination hb
  have hh := combined_upper_eval x y z w a b c v hx hy hz hw hs
  rw [hj] at hh
  rw [ha',hb',coefficient0_special x y w hx hy hw,coefficient1_special x y w hx hy hw,
    coefficient2_special x y w hx hy hw,residual0_special x y z w c v hx hy hz hw h630 h672,
    residual1_special x y z w c v hx hy hz hw h630 h672,
    residual2_special x y z w c v hx hy hz hw h630 h672] at hh
  have hr : (specialCoefficient0 x y w*specialResidual0 x y w-
      specialCoefficient1 x y w*specialResidual1 x y w-
      specialCoefficient2 x y w*specialResidual2 x y w)*v 756=0 := by
    linear_combination -hh
  have hc := special_combination x y w hx hy hw
  have hH : (-8575:ℂ)*H (x^2) (y^2)*v 756=0 := by
    linear_combination (288*x^3*y^2)*hr-v 756*hc
  exact (mul_eq_zero.mp ((mul_eq_zero.mp hH).resolve_right h756)).resolve_left (by norm_num)

compact_certificate theorem no_physical_original_second_chart (h a b c : ℂ) (v : ℕ → ℂ)
    (ha : a≠0) (h630 : v 630=0) (h672 : v 672=0) (h756 : v 756≠0)
    (hs : ∀ j<4518,eval ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h)
      a b c v (FullPlusLeading.source j)=0)
    (h147 : eval ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h)
      a b c v OriginalFirstJet.result147=0)
    (h201 : eval ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h)
      a b c v OriginalFirstJet.result201=0)
    (hj : eval ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h)
      a b c (fun j => eval ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h)
        a b c v (actualJet j)) combinedLeft=0) : False := by
  obtain ⟨hA,hB,hY⟩ := SecondChart.original_second_chart_values h a b c v ha h630 h672 h756 hs h147 h201
  have hn (p : ℕ) (hp : p≠0) : (p:ℂ)^h≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hx2 : ((2:ℂ)^h)^2=(4:ℂ)^h := by
    have hh := (Complex.mul_cpow_ofReal_nonneg (a:=2) (b:=2) (by norm_num) (by norm_num) h).symm
    norm_num at hh
    simpa only [pow_two] using hh
  have hy2 : ((3:ℂ)^h)^2=(9:ℂ)^h := by
    have hh := (Complex.mul_cpow_ofReal_nonneg (a:=3) (b:=3) (by norm_num) (by norm_num) h).symm
    norm_num at hh
    simpa only [pow_two] using hh
  have hH := combined_H_zero ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h) a b c v
    (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide))
    h630 h672 h756 hA (by simpa only [hx2] using hB) hs hj
  rw [hx2,hy2] at hH
  have hp : (4:ℂ)^h+1≠0 := by
    intro hp
    rw [hp,mul_zero] at hY
    exact pow_ne_zero 2 (hn 4 (by decide)) hY.symm
  have hy' : (9:ℂ)^h=((4:ℂ)^h)^2/((4:ℂ)^h+1) := (eq_div_iff hp).mpr hY
  have he := H_substitution ((4:ℂ)^h) hp
  rw [← hy',hH,mul_zero] at he
  have hprod : ((4:ℂ)^h+4)*SecondRoot.p8.eval ((4:ℂ)^h)=0 := by
    apply (mul_eq_zero.mp (show (-30:ℂ)*((4:ℂ)^h)^4*
      (((4:ℂ)^h+4)*SecondRoot.p8.eval ((4:ℂ)^h))=0 by linear_combination -he)).resolve_left
    exact mul_ne_zero (by norm_num) (pow_ne_zero 4 (hn 4 (by decide)))
  exact SecondRoot.no_physical_product h hY hprod

#print axioms no_physical_original_second_chart
end QuantitativeArithmeticSmallLevelTwentyFive.FactoredJet
