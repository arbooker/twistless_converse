compact_certificate def factor0 (x y b : ℂ) : ℂ := ((-1) + (y^2) + (2 * (x^2)))

compact_certificate def factor1 (x y b : ℂ) : ℂ := ((y^2) + ((-1) * (x^2)) + ((-1) * (y^4)) + (2 * (x^4)) + ((x^2) * (y^4)) + ((-2) * (x^2) * (y^2)) + (2 * (x^4) * (y^2)) + (b * y * (x^8)) + ((-1) * b * y * (x^4)) + ((-1) * b * y * (x^6)))

compact_certificate def factor2 (x y b : ℂ) : ℂ := (2 + (x^2))

compact_certificate def factor3 (x y b : ℂ) : ℂ := ((x^2) + (y^2) + ((x^2) * (y^2)))

compact_certificate def factor4 (x y b : ℂ) : ℂ := (1 + (y^2))

compact_certificate theorem factor1_eq (x y b : ℂ) : factor1 x y b=ContinuationPositive.factor0 x y 0 b := by
