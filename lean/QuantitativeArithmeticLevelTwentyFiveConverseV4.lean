    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) s v)
    (hshift : ∀ n : ℕ,0<n → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) (s+n)) (hf2 : f 2=0) (h420 : v ⟨420,by decide⟩=0) (h840 : v ⟨840,by decide⟩=0) : False := by
  have hrows := regularized_original_rows hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hshift
  have h3454 := regularized_jet_zero hm hf ε hε hlaw hχ BG G hG hGF
    NegativeZeroTwoFive.left3454 NegativeZeroTwoFive.left3454_support
    (NegativeZeroTwoFive.lower3454_physical m f hf2) s v hv hshift
  have hr3454 : physicalEval m f s (periodicVector v) NegativeZeroTwoFive.result3454=0 :=
    (NegativeZeroTwoFive.result3454_physical m f hf2 s v hrows).trans h3454
  have h3137 := regularized_jet_zero hm hf ε hε hlaw hχ BG G hG hGF
    NegativeZeroTwoFive.left3137 NegativeZeroTwoFive.left3137_support
    (NegativeZeroTwoFive.lower3137_physical m f hf2) s v hv hshift
  have hr3137 : physicalEval m f s (periodicVector v) NegativeZeroTwoFive.result3137=0 :=
    (NegativeZeroTwoFive.result3137_physical m f hf2 s v hrows).trans h3137
  exact hv.1 (NegativeZeroTwoFive.physical_force_zero m f hf2 s v hrows h420 h840 hr3454 hr3137)

#print axioms allowed_no_negative_zero_two_at_zero_cusp
#print axioms regularized_no_negative_zero_two_at_zero_cusp
