compact_certificate theorem original_canonical_halfplane {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z)) :
    ∃ B : ℝ, ∀ j z, B<z.re → AnalyticAt ℂ (fun w => G w j) z := by
  obtain ⟨BF,hF⟩ := SmallLevelAdditive.original_common_halfplane hf
  refine ⟨max BF BG,?_⟩
  intro j z hz
  have hzF : BF<z.re := lt_of_le_of_lt (le_max_left _ _) hz
  have hzG : BG<z.re := lt_of_le_of_lt (le_max_right _ _) hz
  have hA := physicalGauge_analytic AuxMinusLaurent.basis AuxMinusLaurent.freeCoordinate m f z
    (gridVector 1050 (2*m) f) (fun i => (hF ((i.val:ℝ)/1050) z hzF).1) j
  apply hA.congr
  filter_upwards [(isOpen_lt continuous_const Complex.continuous_re).mem_nhds hzG] with w hw
  exact (congrFun (hGF w hw) j).symm

