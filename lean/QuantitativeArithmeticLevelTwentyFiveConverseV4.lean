compact_certificate theorem strict_no_negative_nonzero_two_above_weight
    {m : ℕ} (hm : 0 < m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG < z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ,0 < n → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hf2 : f 2≠0) (hs : (2*m:ℝ)<s.re) : False := by
  have hunit : s-((2*m:ℕ):ℂ)≠0 := by
    intro he
    have he' := congrArg Complex.re (sub_eq_zero.mp he)
    norm_num at he'
    linarith
  have hvr := OriginalCertificates.leading_vector_mul_unit G s v hv (fun z => z-((2*m:ℕ):ℂ))
    (analyticAt_id.sub analyticAt_const) hunit
  have hpole := hv.exists_pole (fun j => hG j s)
  have hc := CuspMinusLaurent.pole_denominator_five_zero hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hpole hshift (sub_ne_zero.mp hunit)
  have h420 : v ⟨420,by decide⟩=0 := by simpa [periodicVector] using hc.2.1
  have h840 : v ⟨840,by decide⟩=0 := by simpa [periodicVector] using hc.2.2.2
  exact regularized_no_negative_nonzero_two_at_zero_cusp hm hf ε hε hlaw hχ BG G hG hGF
    s v hvr hshift hf2 h420 h840
#print axioms strict_no_negative_nonzero_two_above_weight
end QuantitativeArithmeticSmallLevelTwentyFive.MinusOriginalCertificates
end
