  have h2 := parameter_analytic (by decide : 2≠0) m s
  have h3 := parameter_analytic (by decide : 3≠0) m s
  fin_cases i
  · change AnalyticAt ℂ (fun t => factor0 (parameter 2 m t) (parameter 3 m t) b) s
    unfold factor0
    fun_prop
  · change AnalyticAt ℂ (fun t => factor1 (parameter 2 m t) (parameter 3 m t) b) s
    unfold factor1
    fun_prop
  · change AnalyticAt ℂ (fun t => factor2 (parameter 2 m t) (parameter 3 m t) b) s
    unfold factor2
    fun_prop
  · change AnalyticAt ℂ (fun t => factor3 (parameter 2 m t) (parameter 3 m t) b) s
    unfold factor3
    fun_prop
  · change AnalyticAt ℂ (fun t => factor4 (parameter 2 m t) (parameter 3 m t) b) s
    unfold factor4
    fun_prop

compact_certificate theorem factors_nontrivial (m : ℕ) (b : ℂ) (i : Fin 5) :
    ∃ s, factors m b i s≠0 := by
  fin_cases i
  · refine ⟨(m:ℂ),?_⟩
    norm_num [factors,parameter,factor0]
  · obtain ⟨n,hn⟩ := factor1_power_witness b
    refine ⟨((m+n:ℕ):ℂ),?_⟩
    change factor1 (parameter 2 m ((m+n:ℕ):ℂ)) (parameter 3 m ((m+n:ℕ):ℂ)) b≠0
    simpa only [parameter_nat,Nat.cast_ofNat] using hn
  · refine ⟨(m:ℂ),?_⟩
    norm_num [factors,parameter,factor2]
  · refine ⟨(m:ℂ),?_⟩
    norm_num [factors,parameter,factor3]
  · refine ⟨(m:ℂ),?_⟩
    norm_num [factors,parameter,factor4]

compact_certificate theorem common_factor_witness (m : ℕ) (b : ℂ) :
    ∃ s, ∀ i : Fin 5, factors m b i s≠0 := by
  exact QuantitativeArithmeticFiniteAnalyticWitness.common_nonzero
    (factors m b) (factors_analytic m b) (factors_nontrivial m b)
#print axioms common_factor_witness
end QuantitativeArithmeticSmallLevelTwentyFive.ContinuationPositiveZeroTwo
