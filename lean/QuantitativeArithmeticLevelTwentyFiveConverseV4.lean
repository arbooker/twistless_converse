compact_certificate theorem original_six (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0) (ha : a≠0)
    (h630 : v 630=0) (h672 : v 672=0) (h756 : v 756≠0)
    (hs : ∀ j<4518,eval x y z w a b c v (FullPlusLeading.source j)=0)
    (h147 : eval x y z w a b c v result147=0)
    (h201 : eval x y z w a b c v result201=0) :
    p0 (b*y) (a*x) (y^2) (x^2)=0 ∧
    p1 (b*y) (a*x) (y^2) (x^2)=0 ∧
    p2 (b*y) (a*x) (y^2) (x^2)=0 ∧
    p3 (b*y) (a*x) (y^2) (x^2)=0 ∧
    p4 (b*y) (a*x) (y^2) (x^2)=0 ∧
    p5 (b*y) (a*x) (y^2) (x^2)=0 := by
  have hr0 := q1_zero x y z w a b c v hx hy hz hw hs
  have hi0 := normalized0 x y z w a b c v hx hy hw h630 h672
  rw [hr0,mul_zero] at hi0
  have hp0 := (mul_eq_zero.mp hi0.symm).resolve_left
    (mul_ne_zero (neg_ne_zero.mpr (pow_ne_zero 2 hz)) h756)
  have hr1 := q6compact42_zero x y z w a b c v hx hy hz hw hs
  rw [residual6_certificate_match] at hr1
  have hi1 := normalized1 x y z w a b c v hx hy hw h630 h672
  rw [hr1,mul_zero] at hi1
  have hp1 := (mul_eq_zero.mp hi1.symm).resolve_left
    (mul_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero 2 hz)) h756)
  have hr2 := q16compact60_zero x y z w a b c v hx hy hz hw hs
  rw [residual16_certificate_match] at hr2
  have hi2 := normalized2 x y z w a b c v hx hy hw h630 h672
  rw [hr2,mul_zero] at hi2
  have hp2 := (mul_eq_zero.mp hi2.symm).resolve_left
    (mul_ne_zero (ha) h756)
  have hi3 := normalized3 x y z w a b c v hx hy hw h630 h672
  rw [h147,mul_zero] at hi3
  have hp3 := (mul_eq_zero.mp hi3.symm).resolve_left
    (mul_ne_zero (by norm_num) h756)
  have hi4 := normalized4 x y z w a b c v hx hy hw h630 h672
  rw [h201,mul_zero] at hi4
  have hp4 := (mul_eq_zero.mp hi4.symm).resolve_left
    (mul_ne_zero (by norm_num) h756)
  have hr5 := q9compact58_zero x y z w a b c v hx hy hz hw hs
  rw [residual9_certificate_match] at hr5
  have hi5 := normalized5 x y z w a b c v hx hy hw h630 h672
  rw [hr5,mul_zero,hp0,mul_zero,sub_zero] at hi5
  have hh := (mul_eq_zero.mp hi5.symm).resolve_left (mul_ne_zero (by norm_num) h756)
  have hp5 := (mul_eq_zero.mp hh).resolve_left (pow_ne_zero 2 hw)
  exact ⟨hp0,hp1,hp2,hp3,hp4,hp5⟩

compact_certificate theorem original_second_chart_values (h a b c : ℂ) (v : ℕ → ℂ)
    (ha : a≠0) (h630 : v 630=0) (h672 : v 672=0) (h756 : v 756≠0)
    (hs : ∀ j<4518,eval ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h)
      a b c v (FullPlusLeading.source j)=0)
    (h147 : eval ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h)
      a b c v result147=0)
    (h201 : eval ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h)
      a b c v result201=0) :
    a*(2:ℂ)^h= -1 ∧ (b*(3:ℂ)^h)*(4:ℂ)^h=(4:ℂ)^h-2 ∧
      (9:ℂ)^h*((4:ℂ)^h+1)=((4:ℂ)^h)^2 := by
  have hn (p : ℕ) (hp : p≠0) : (p:ℂ)^h≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hx2 : ((2:ℂ)^h)^2=(4:ℂ)^h := by
    have hh := (Complex.mul_cpow_ofReal_nonneg (a:=2) (b:=2) (by norm_num) (by norm_num) h).symm
    norm_num at hh
    simpa only [pow_two] using hh
  have hy2 : ((3:ℂ)^h)^2=(9:ℂ)^h := by
    have hh := (Complex.mul_cpow_ofReal_nonneg (a:=3) (b:=3) (by norm_num) (by norm_num) h).symm
    norm_num at hh
    simpa only [pow_two] using hh
  obtain ⟨h0,h1,h2,h3,h4,h5⟩ := original_six ((2:ℂ)^h) ((3:ℂ)^h) ((5:ℂ)^h) ((7:ℂ)^h)
    a b c v (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide))
    ha h630 h672 h756 hs h147 h201
  rw [hx2,hy2] at h0 h1 h2 h3 h4 h5
  rcases two_branches _ _ _ _ (mul_ne_zero ha (hn 2 (by decide)))
    (hn 9 (by decide)) (hn 4 (by decide)) h0 h3 h4 h5 with hm | hm
  · norm_num at hm
    rw [hm] at h2 h3 h4 h5
    exact ⟨hm,minus_one_values _ _ _ (hn 9 (by decide)) (hn 4 (by decide)) h2 h3 h4 h5⟩
  · norm_num at hm
    rw [hm] at h0 h1 h5
    exact (minus_two_no_physical h _ h0 h1 h5).elim
#print axioms original_second_chart_values
end QuantitativeArithmeticSmallLevelTwentyFive.SecondChart
