/-! ## TwentyFiveOriginalPositiveAllContinuedPoles -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.OriginalCertificates
open Complex
/- Simultaneous continuation and pole bounds for the original 150 additive twists,
for the positive Fricke phase. -/
compact_certificate theorem original_positive_all_continued_poles
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) :
    ∃ (B : ℝ) (F : ℂ → Fin 150 → ℂ),
      (∀ j s, MeromorphicNFAt (fun z => F z j) s) ∧
      (∀ s, B<s.re → F s=SelectedWords.gridVector (2*m) f s) ∧
      (∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => F z j) ((2*m:ℕ):ℂ)) ∧
      ∀ s : ℂ,s≠((2*m:ℕ):ℂ) → ∀ j,0≤ meromorphicOrderAt (fun z => F z j) s := by
  obtain ⟨B0,G0,hG0,hG0F⟩ := GridSystem.original_grid_continuation_positive_all
    hm hf ε hlaw (by simpa [GridSystem.phaseRoot] using hχ)
  obtain ⟨B,G,hG,hGF,hGold⟩ := AuxPlusLaurent.original_auxiliary_continuation
    hm hf ε hε hlaw hχ B0 G0 (fun j z => (hG0 j z).meromorphicAt) hG0F
  obtain ⟨hw,ha⟩ := global_positive_all_pole_orders hm hf ε hε hlaw hχ B G hG hGF
  refine ⟨B,(fun z j => G z ⟨7*j.val,by omega⟩),?_,?_,?_,?_⟩
  · intro j s
    exact hG _ s
  · intro s hs
    funext j
    exact hGold s hs j
  · intro j
    exact hw _
  · intro s hs j
    exact ha s hs _
#print axioms original_positive_all_continued_poles
end QuantitativeArithmeticSmallLevelTwentyFive.OriginalCertificates
end
end

