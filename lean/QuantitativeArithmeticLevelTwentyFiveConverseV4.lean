namespace QuantitativeArithmeticSmallLevelTwentyFive.NegativeGenericSmall
open NegativeNonzeroTwoRows
compact_certificate theorem no_generic_physical (h A u B : ℂ) (hA : A≠0) (hA1 : A+1≠0) (hA2 : A+2≠0)
    (hD : D A ((9:ℂ)^h) ((4:ℂ)^h)≠0)
    (h0 : firstInput0 u B A ((9:ℂ)^h) ((4:ℂ)^h)=0)
    (h1 : firstInput1 u B A ((9:ℂ)^h) ((4:ℂ)^h)=0)
    (h2 : firstInput2 u B A ((9:ℂ)^h) ((4:ℂ)^h)=0)
    (h3 : firstInput3 u B A ((9:ℂ)^h) ((4:ℂ)^h)=0)
    (h4 : firstInput4 u B A ((9:ℂ)^h) ((4:ℂ)^h)=0)
    : False := by
  let X : ℂ := (4:ℂ)^h
  let Y : ℂ := (9:ℂ)^h
  have hX : X≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hY : Y≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  obtain ⟨hu,hb⟩ := cramer u B A Y X hA hY hX hA1 hD h0 h1
  have hQ0 : Q0 A Y X=0 := by
    have he := source0 A Y X hX hD
    rw [← hu, ← hb, h2, zero_mul] at he
    exact (mul_eq_zero.mp he.symm).resolve_left (mul_ne_zero (mul_ne_zero (by norm_num) hX) hY)
  have hQ1 : Q1 A Y X=0 := by
    have he := source1 A Y X hX hD
    rw [← hu, ← hb, h3, zero_mul] at he
    exact (mul_eq_zero.mp he.symm).resolve_left (mul_ne_zero (mul_ne_zero hA (pow_ne_zero _ hX)) hY)
  have hQ2 : Q2 A Y X=0 := by
    have he := source2 A Y X hX hD
    rw [← hu, ← hb, h4, zero_mul] at he
    exact (mul_eq_zero.mp he.symm).resolve_left (mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num) hA) hX) hY)
  have hU := u_nonzero A Y X hA hA2 hD hQ0
  have hp0 := positive0 A Y X hX hD hU
  rw [hQ0,mul_zero] at hp0
  have hz0 := (mul_eq_zero.mp hp0).resolve_right (mul_ne_zero hD hU)
  have hp1 := positive1 A Y X hX hD hU
  rw [hQ2,mul_zero] at hp1
  have hz1 := (mul_eq_zero.mp hp1).resolve_right (hU)
  have hp2 := positive2 A Y X hX hD hU
  rw [hQ2,mul_zero] at hp2
  have hz2 := (mul_eq_zero.mp hp2).resolve_right (hU)
  have hp3 := positive3 A Y X hX hD hU
  rw [hQ0,mul_zero] at hp3
  have hz3 := (mul_eq_zero.mp hp3).resolve_right (by norm_num)
  have hp4 := positive4 A Y X hX hD hU
  rw [hQ1,mul_zero] at hp4
  have hz4 := (mul_eq_zero.mp hp4).resolve_right (mul_ne_zero (mul_ne_zero hX hD) hU)
  have hp5 := positive5 A Y X hX hD hU
  rw [hQ0,mul_zero] at hp5
  have hz5 := (mul_eq_zero.mp hp5).resolve_right (mul_ne_zero hD hU)
  exact PositiveChart.MinimalSix.no_physical_six h A (-D A Y X/U A Y X) (V A Y X/(X*D A Y X)) hA hz0 hz1 hz2 hz3 hz4 hz5
#print axioms no_generic_physical
end QuantitativeArithmeticSmallLevelTwentyFive.NegativeGenericSmall
