compact_certificate def p0 (B A Y X : ℂ) : ℂ := (1)*A^3*X+(-1)*A^2*Y*X+(1)*B*A*X^2+(1)*A^2*Y+(-1)*A*Y*X+(1)*B*X^2+(1)*A*Y+(-1)*A*X
compact_certificate def p1 (B A Y X : ℂ) : ℂ := (1)*A^2*Y*X^4+(-1/2)*A^4*X^2+(-1)*B*A^2*Y*X^2+(-1/2)*A^3*Y*X^2+(1)*A^2*Y^2*X^2+(-1/2)*B*A^2*X^3+(-1)*A^2*Y*X^3+(1)*A*Y^2*X^3+(-1/2)*A^3*Y*X+(-3/2)*A^2*Y*X^2+(-1)*A*Y^2*X^2+(-1/2)*B*A*X^3+(-1)*B*Y*X^3+(1)*A*Y*X^3+(1)*A^3*X+(-1/2)*A^2*Y*X+(-2)*A*Y^2*X+(1)*B*A*X^2+(3/2)*A^2*X^2+(1)*B*Y*X^2+(1)*A*Y*X^2+(1)*B*X^3+(1)*A^2*Y+(1)*A*Y^2+(-1)*A^2*X+(-1)*A*X^2
compact_certificate def p2 (B A Y X : ℂ) : ℂ := (1)*B*A^4*X+(-1)*B*A^3*Y*X+(-1)*A^4*Y*X+(1)*A^3*Y^2*X+(1)*B^2*A^2*X^2+(-1)*B*A^3*X^2+(1)*A^3*Y*X^2+(-1)*A^2*Y^2*X^2+(-1)*B^2*A*X^3+(1)*B*A*Y*X^3+(1)*B*A^3*Y+(-1)*A^3*Y^2+(-1)*B*A^3*X+(-1)*A^4*X+(-1)*B*A^2*Y*X+(2)*A^3*Y*X+(1)*A^2*Y^2*X+(-1)*B*A^2*X^2+(1)*B*A*Y*X^2+(-1)*A^2*Y*X^2+(-1)*A*Y^2*X^2+(-1)*B^2*X^3+(1)*B*Y*X^3+(-1)*A^3*Y+(-1)*B*A^2*X+(1)*A^3*X+(1)*A^2*Y*X+(-1)*B^2*X^2+(1)*B*A*X^2+(1)*A^2*X^2+(-2)*A*Y*X^2+(1)*B*X^3+(-1)*B*A*Y+(1)*A*Y^2+(1)*B*A*X+(-1)*A*X^2
compact_certificate def p3 (B A Y X : ℂ) : ℂ := (1)*A^4*X^3+(-1/5)*A^3*Y*X^3+(1)*B*A^2*X^4+(4)*A^4*X^2+(7/15)*A^3*Y*X^2+(-4/5)*A^2*Y^2*X^2+(4)*B*A^2*X^3+(2/5)*A^3*X^3+(4/15)*B*A*Y*X^3+(1/5)*A^2*Y*X^3+(7/5)*B*A*X^4+(76/15)*A^3*Y*X+(-44/15)*A^2*Y^2*X+(34/5)*A^3*X^2+(16/15)*B*A*Y*X^2+(-37/15)*A^2*Y*X^2+(-16/15)*A*Y^2*X^2+(54/5)*B*A*X^3+(-7/5)*A^2*X^3+(16/15)*A^2*Y^2+(146/15)*A^2*Y*X+(-64/15)*A*Y^2*X+(-26/5)*A^2*X^2+(-4)*A*Y*X^2+(28/5)*B*X^3+(28/5)*A*Y*X+(-28/5)*A*X^2
compact_certificate def p4 (B A Y X : ℂ) : ℂ := (1)*A^4*X^3+(-1/5)*A^3*Y*X^3+(1)*B*A^2*X^4+(19/15)*A^3*Y*X^2+(-4/5)*A^2*Y^2*X^2+(2/5)*A^3*X^3+(4/15)*B*A*Y*X^3+(1/5)*A^2*Y*X^3+(7/5)*B*A*X^4+(16/15)*A^3*Y*X+(-44/15)*A^2*Y^2*X+(8/5)*B*A^2*X^2+(26/5)*A^3*X^2+(-56/15)*B*A*Y*X^2+(-49/15)*A^2*Y*X^2+(-16/15)*A*Y^2*X^2+(8/5)*B^2*X^3+(26/5)*B*A*X^3+(-7/5)*A^2*X^3+(16/15)*A^2*Y^2+(-152/5)*A^3*X+(8/5)*B*A*Y*X+(758/15)*A^2*Y*X+(-64/15)*A*Y^2*X+(-32)*B*A*X^2+(2/5)*A^2*X^2+(-32/5)*B*Y*X^2+(-4)*A*Y*X^2+(28/5)*B*X^3+(-152/5)*A^2*Y+(8)*A^2*X+(60)*A*Y*X+(-112/5)*B*X^2+(-28/5)*A*X^2+(-112/5)*A*Y+(112/5)*A*X
compact_certificate def p5 (B A Y X : ℂ) : ℂ := (1)*A^3*Y*X^2+(1)*B*A^2*X^2+(1)*B^2*X^3+(-1)*A^3*X+(1)*B*A*Y*X+(1)*A^2*Y*X+(-2)*B*A*X^2+(-1)*A^2*Y+(1)*A^2*X
compact_certificate def bsol (A Y X : ℂ) : ℂ := -A*((A-1)*X+Y*(1-X))/X^2
compact_certificate def g (A Y X : ℂ) : ℂ := A*X^2-A*X+Y*X-Y+X
compact_certificate def d1 (A Y X : ℂ) : ℂ := A*X^2+4*A*X-(2/3)*Y*X-(8/3)*Y+X
compact_certificate def d2 (A Y X : ℂ) : ℂ := A*X^3+4*A*X-(2/3)*Y*X^2-(20/3)*Y*X+4*Y+X^2+16*X

compact_certificate theorem p0_factor (B A Y X : ℂ) (hX : X≠0) :
    p0 B A Y X=(A+1)*X^2*(B-bsol A Y X) := by
  unfold p0 bsol
  field_simp
  ring

compact_certificate theorem p5_sub (A Y X : ℂ) (hX : X≠0) :
    p5 (bsol A Y X) A Y X=A^2*Y*g A Y X := by
  unfold p5 bsol g
  field_simp
  ring

compact_certificate theorem p3_sub (A Y X : ℂ) (hX : X≠0) :
    p3 (bsol A Y X) A Y X=((4/5)*A*Y*X*(A+2))*d1 A Y X := by
  unfold p3 bsol d1
  field_simp
  ring

compact_certificate theorem p4_sub (A Y X : ℂ) (hX : X≠0) :
    p4 (bsol A Y X) A Y X=((4/5)*A*Y*(A+2))*d2 A Y X := by
  unfold p4 bsol d2
  field_simp
  ring

compact_certificate theorem d_difference (A Y X : ℂ) : d2 A Y X-X*d1 A Y X= -4*g A Y X+20*X := by
  unfold d1 d2 g
  ring

compact_certificate theorem two_branches (B A Y X : ℂ) (hA : A≠0) (hY : Y≠0) (hX : X≠0)
    (h0 : p0 B A Y X=0) (h3 : p3 B A Y X=0)
    (h4 : p4 B A Y X=0) (h5 : p5 B A Y X=0) : A= -1 ∨ A= -2 := by
  by_cases h1 : A= -1
  · exact Or.inl h1
  right
  have hn1 : A+1≠0 := by intro hh; apply h1; linear_combination hh
  rw [p0_factor B A Y X hX] at h0
  have hB : B=bsol A Y X := sub_eq_zero.mp
    ((mul_eq_zero.mp h0).resolve_left (mul_ne_zero hn1 (pow_ne_zero 2 hX)))
  rw [hB,p5_sub A Y X hX] at h5
  have hg : g A Y X=0 := (mul_eq_zero.mp h5).resolve_left
    (mul_ne_zero (pow_ne_zero 2 hA) hY)
  by_contra h2
  have hn2 : A+2≠0 := by intro hh; apply h2; linear_combination hh
  rw [hB,p3_sub A Y X hX] at h3
  rw [hB,p4_sub A Y X hX] at h4
  have hd1 : d1 A Y X=0 := (mul_eq_zero.mp h3).resolve_left
    (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num) hA) hY) hX) hn2)
  have hd2 : d2 A Y X=0 := (mul_eq_zero.mp h4).resolve_left
    (mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num) hA) hY) hn2)
  have hh := d_difference A Y X
  rw [hd1,hd2,hg] at hh
  apply hX
  linear_combination -hh/20
#print axioms two_branches
end QuantitativeArithmeticSmallLevelTwentyFive.SecondChart
end
