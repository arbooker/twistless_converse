compact_certificate theorem allowed_no_second_chart
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ,0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j,
      0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hs : s≠((2*m:ℕ):ℂ)) (hf2 : f 2≠0) (h630 : v ⟨630,by decide⟩=0)
    (h672 : v ⟨672,by decide⟩=0) (h756 : v ⟨756,by decide⟩≠0) : False := by
  have hrows := FullPlusLeading.original_pole_rows_allowed hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hshift hweight
  have h147 := allowed_jet_zero hm hf ε hε hlaw hχ BG G hG hGF
    OriginalFirstJet.left147 OriginalFirstJet.left147_support
    (OriginalFirstJet.lower147_physical m f) s v hv hshift hweight hs
  have h201 := allowed_jet_zero hm hf ε hε hlaw hχ BG G hG hGF
    OriginalFirstJet.left201 OriginalFirstJet.left201_support
    (OriginalFirstJet.lower201_physical m f) s v hv hshift hweight hs
  have h392 := allowed_jet_zero hm hf ε hε hlaw hχ BG G hG hGF
    FactoredJet.combinedLeft FactoredJet.combined_support
    (FactoredJet.combined_lower_physical m f) s v hv hshift hweight hs
  have hr147 : physicalEval m f s (periodicVector v) OriginalFirstJet.result147=0 :=
    (OriginalFirstJet.result147_physical m f s v hrows).trans h147
  have hr201 : physicalEval m f s (periodicVector v) OriginalFirstJet.result201=0 :=
    (OriginalFirstJet.result201_physical m f s v hrows).trans h201
  have ha : (Real.sqrt 2:ℂ)*f 2≠0 := mul_ne_zero (by
    exact_mod_cast (ne_of_gt (Real.sqrt_pos.2 (by norm_num : (0:ℝ)<2)))) hf2
  have hc : periodicVector v 630=0 := by simpa [periodicVector] using h630
  have hz : periodicVector v 672=0 := by simpa [periodicVector] using h672
  have hn : periodicVector v 756≠0 := by simpa [periodicVector] using h756
  exact FactoredJet.no_physical_original_second_chart (s-(m:ℂ))
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
    (periodicVector v) ha hc hz hn hrows hr147 hr201 h392

compact_certificate theorem regularized_no_second_chart
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) s v)
    (hshift : ∀ n : ℕ,0<n → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) (s+n)) (hf2 : f 2≠0) (h630 : v ⟨630,by decide⟩=0)
    (h672 : v ⟨672,by decide⟩=0) (h756 : v ⟨756,by decide⟩≠0) : False := by
  have hrows := regularized_original_rows hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hshift
  have h147 := regularized_jet_zero hm hf ε hε hlaw hχ BG G hG hGF
