      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z)) (hf2 : f 2=0) :
    (∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ)) ∧
      ∀ s : ℂ,s≠((2*m:ℕ):ℂ) → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) s := by
  obtain ⟨B,hhalf⟩ := original_canonical_halfplane hf BG G hGF
  apply QuantitativeArithmeticUniversalPoleClosure.pole_orders G ((2*m:ℕ):ℂ) hG B hhalf
  · intro s v hv hshift hs
