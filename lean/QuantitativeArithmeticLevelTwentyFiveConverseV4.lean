compact_certificate theorem original_canonical_halfplane {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z)) :
    ∃ B : ℝ, ∀ j z, B<z.re → AnalyticAt ℂ (fun w => G w j) z := by
  obtain ⟨BF,hF⟩ := SmallLevelAdditive.original_common_halfplane hf
  refine ⟨max BF BG,?_⟩
  intro j z hz
  have hzF : BF<z.re := lt_of_le_of_lt (le_max_left _ _) hz
  have hzG : BG<z.re := lt_of_le_of_lt (le_max_right _ _) hz
  have hA := physicalGauge_analytic AuxPlusLaurent.basis AuxPlusLaurent.freeCoordinate m f z
    (gridVector 1050 (2*m) f) (fun i => (hF ((i.val:ℝ)/1050) z hzF).1) j
  apply hA.congr
  filter_upwards [(isOpen_lt continuous_const Complex.continuous_re).mem_nhds hzG] with w hw
  exact (congrFun (hGF w hw) j).symm

/- For the positive Fricke phase and nonzero second coefficient, the canonical
auxiliary quotient has no poles except possible simple poles at the weight. -/
compact_certificate theorem global_positive_nonzero_two_pole_orders
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (hf2 : f 2≠0) :
    (∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ)) ∧
      ∀ s : ℂ,s≠((2*m:ℕ):ℂ) → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) s := by
  obtain ⟨B,hhalf⟩ := original_canonical_halfplane hf BG G hGF
  have habove : ∀ s : ℂ,(2*m:ℝ)<s.re → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) s := by
    intro s hs j
    by_contra! hj
    obtain ⟨n,hpole,hshift⟩ := SmallLevelPoleGrid.rightmost_pole
      (fun j z => G z j) ⟨j,hj⟩ B hhalf
    obtain ⟨v,hv⟩ := exists_leading_vector G (s+n) (fun j => (hG j _).meromorphicAt) hpole
    apply strict_no_positive_nonzero_two_above_weight hm hf ε hε hlaw hχ BG G hG hGF
      (s+n) v hv hshift hf2
    simp only [Complex.add_re,Complex.natCast_re]
    have hn : (0:ℝ)≤n := Nat.cast_nonneg n
    linarith
  have hwshift : ∀ n : ℕ,0<n → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) (((2*m:ℕ):ℂ)+n) := by
    intro n hn
    apply habove
    have hn' : (0:ℝ)<n := by exact_mod_cast hn
    norm_num
    linarith
  have hweight : ∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ) := by
    by_contra! hp
    have hrpole : ∃ j,meromorphicOrderAt (fun z => (z-((2*m:ℕ):ℂ))*G z j) ((2*m:ℕ):ℂ)<0 := by
      obtain ⟨j,hj⟩ := hp
      refine ⟨j,?_⟩
      have hloc : MeromorphicAt (fun z : ℂ => z-((2*m:ℕ):ℂ)) ((2*m:ℕ):ℂ) :=
        (analyticAt_id.sub analyticAt_const).meromorphicAt
      change meromorphicOrderAt ((fun z : ℂ => z-((2*m:ℕ):ℂ))*(fun z => G z j)) ((2*m:ℕ):ℂ)<0
      rw [meromorphicOrderAt_mul hloc (hG j _).meromorphicAt,meromorphicOrderAt_id_sub_const]
      lift meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ) to ℤ using hj.ne_top with q hq
      have hq' : q< -1 := by
        change (q:WithTop ℤ)<((-1:ℤ):WithTop ℤ) at hj
        exact WithTop.coe_lt_coe.mp hj
      exact_mod_cast (show 1+q<0 by omega)
    obtain ⟨v,hv⟩ := exists_leading_vector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) ((2*m:ℕ):ℂ)
      (fun j => (analyticAt_id.sub analyticAt_const).meromorphicAt.mul (hG j _).meromorphicAt) hrpole
    exact regularized_weight_no_positive_nonzero_two hm hf ε hε hlaw hχ BG G hG hGF v hv hwshift hf2 hrpole
  refine ⟨hweight,?_⟩
  intro s hs j
  by_contra! hj
  obtain ⟨n,hsn,hpole,hshift⟩ := SmallLevelPoleGrid.rightmost_pole_away
    (fun j z => G z j) ((2*m:ℕ):ℂ) hs ⟨j,hj⟩ B hhalf
  obtain ⟨v,hv⟩ := exists_leading_vector G (s+n) (fun j => (hG j _).meromorphicAt) hpole
  exact allowed_no_positive_nonzero_two hm hf ε hε hlaw hχ BG G hG hGF
    (s+n) v hv hshift hweight hsn hf2 hpole
#print axioms global_positive_nonzero_two_pole_orders
