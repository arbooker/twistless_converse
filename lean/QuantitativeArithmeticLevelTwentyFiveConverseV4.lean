      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ,0 < n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j,
      0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hs : s≠((2*m:ℕ):ℂ)) (hf2 : f 2≠0)
    (hpole : ∃ j,meromorphicOrderAt (fun z => G z j) s<0) : False := by
  have hc := CuspMinusLaurent.pole_denominator_five_zero_allowed hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hpole hshift hweight hs
  have h420 : v ⟨420,by decide⟩=0 := by simpa [periodicVector] using hc.2.1
  have h840 : v ⟨840,by decide⟩=0 := by simpa [periodicVector] using hc.2.2.2
  exact allowed_no_negative_nonzero_two_at_zero_cusp hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hshift hweight hs hf2 h420 h840

compact_certificate theorem regularized_weight_no_negative_nonzero_two
    {m : ℕ} (hm : 0 < m) {f : ℕ → ℂ}
