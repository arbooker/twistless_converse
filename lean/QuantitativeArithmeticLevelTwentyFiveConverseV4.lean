    (by simpa only [mul_assoc] using he)
  have hs : c s*(∑ j,A s j*v j)=0 := by
    rw [Finset.mul_sum]
    convert hh using 1
    apply Finset.sum_congr rfl
    intro j _
    ring
  exact (mul_eq_zero.mp hs).resolve_left hcs

