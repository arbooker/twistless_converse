/-! ## TwentyFivePositiveAllGridContinuation -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.GridSystem
open Complex Matrix
open QuantitativeArithmeticSmallLevelTwentyFive.SelectedWords

compact_certificate theorem actual_rank_positive_zero_two (m : ℕ) (f : ℕ→ℂ) (ε : ℂ)
    (hphase : phaseRoot m ε=1) (ha : f 2=0) :
    ∃ s : ℂ, (leadingMatrix m f ε s).det≠0 := by
  obtain ⟨s,hs⟩ := ContinuationPositiveZeroTwo.source_rows_witness m
    ((Real.sqrt 3:ℂ)*f 3)
  refine ⟨s,?_⟩
  apply isUnit_iff_ne_zero.mp
  apply (Matrix.isUnit_iff_isUnit_det _).mp
  apply Matrix.mulVec_injective_iff_isUnit.mp
  intro v w hvw
  have hz : leadingMatrix m f ε s *ᵥ (v-w)=0 := by
    rw [Matrix.mulVec_sub,hvw,sub_self]
  rw [leadingMatrix_mulVec,actual_leading_rows,hphase,ha,mul_zero] at hz
  rw [symbolic_rows_positive (primeParameter 2 m s) (primeParameter 3 m s)
    (primeParameter 5 m s) 0 ((Real.sqrt 3:ℂ)*f 3)
    (ContinuationPositive.parameter_ne_zero (by decide : (2:ℕ)≠0) m s)
    (ContinuationPositive.parameter_ne_zero (by decide : (3:ℕ)≠0) m s)
    (ContinuationPositive.parameter_ne_zero (by decide : (5:ℕ)≠0) m s) (v-w)] at hz
  exact sub_eq_zero.mp (hs (v-w) (fun i => congrFun hz i))

/- Positive-phase continuation for every value of the good Hecke parameters. -/
compact_certificate theorem original_grid_continuation_positive_all {m : ℕ} (hm : 0< m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hphase : phaseRoot m ε=1) :
    ∃ (B : ℝ) (G : ℂ→Fin 150→ℂ),
      (∀ i s, MeromorphicNFAt (fun z => G z i) s) ∧
      ∀ s, B<s.re → G s=gridVector (2*m) f s := by
  by_cases ha : f 2=0
  · obtain ⟨s,hs⟩ := actual_rank_positive_zero_two m f ε hphase ha
    obtain ⟨B,H,hF,hH,hrows⟩ := original_matrix_system hm hf ε hlaw
    obtain ⟨G,hG,hGF⟩ := SmallLevelContinuation.closed_system_continuation
      B (gridVector (2*m) f) (leadingMatrix m f ε) (shiftMatrix m f ε) H hF
      (leadingMatrix_analytic m f ε) ⟨s,hs⟩ (shiftMatrix_analytic m f ε) hH (by
        intro n z hz i
        simpa only [Matrix.mulVec,dotProduct,Pi.add_apply,Finset.sum_apply] using
          congrFun (hrows n z hz) i)
    exact ⟨B,G,hG,hGF⟩
  · exact original_grid_continuation_positive hm hf ε hlaw hphase ha

#print axioms actual_rank_positive_zero_two
#print axioms original_grid_continuation_positive_all
end QuantitativeArithmeticSmallLevelTwentyFive.GridSystem
end
