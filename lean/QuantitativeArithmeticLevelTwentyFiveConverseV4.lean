/-! ## TwentyFiveOriginalNegativeNonzeroTwoGlobalPoles -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.MinusOriginalCertificates
open Complex Filter Set
open scoped Topology
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
compact_certificate theorem global_negative_nonzero_two_pole_orders
    {m : ℕ} (hm : 0 < m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG < z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z)) (hf2 : f 2≠0) :
    (∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ)) ∧
      ∀ s : ℂ,s≠((2*m:ℕ):ℂ) → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) s := by
  obtain ⟨B,hhalf⟩ := original_canonical_halfplane hf BG G hGF
  apply QuantitativeArithmeticUniversalPoleClosure.pole_orders G ((2*m:ℕ):ℂ) hG B hhalf
  · intro s v hv hshift hs
    apply strict_no_negative_nonzero_two_above_weight hm hf ε hε hlaw hχ BG G hG hGF
      s v hv hshift hf2
    simpa using hs
  · intro v hv hshift hpole
    exact regularized_weight_no_negative_nonzero_two hm hf ε hε hlaw hχ BG G hG hGF
      v hv hshift hf2 hpole
  · intro s v hv hshift hweight hs hpole
    exact allowed_no_negative_nonzero_two hm hf ε hε hlaw hχ BG G hG hGF
      s v hv hshift hweight hs hf2 hpole
#print axioms global_negative_nonzero_two_pole_orders
end QuantitativeArithmeticSmallLevelTwentyFive.MinusOriginalCertificates
end
