open QuantitativeArithmeticUniversalPoleVector

compact_certificate theorem regularized_original_rows
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=(-1)) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ)
    (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) s v)
    (hshift : ∀ n : ℕ,0<n → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) (s+n)) :
    ∀ j<4518,physicalEval m f s (periodicVector v) (FullMinusLeading.source j)=0 := by
  have hv0 := hv.of_analytic_factor (fun z => z-((2*m:ℕ):ℂ))
    (analyticAt_id.sub analyticAt_const)
  obtain ⟨B,H,hH,hrow⟩ := FullMinusFirst.original_germs hm hf ε hε hlaw hχ BG G hG hGF
  have hh : FullMinusFirst.leadingMatrix m f ε s *ᵥv=0 := by
    funext i
    exact hv0.taylor hG hshift B
      (fun z => FullMinusFirst.leadingMatrix m f ε z i)
      (fun n z => FullMinusFirst.shiftMatrix m f ε n z i) (fun n z => H n z i)
      (fun j => augmentedMatrix_analytic FullMinusFirst.sourceRow AuxMinusLaurent.freeCoordinate
        m f ε s i j)
      (fun n j => augmentedShiftMatrix_analytic FullMinusFirst.sourceRow m f ε n s i j)
      (fun n z hz => hH n i z hz) (fun n hn => hrow n i s hn)
  intro j hj
  rw [source_evaluation hf ε s hχ v ⟨j,hj⟩,hh]
  rfl
#print axioms regularized_original_rows
end QuantitativeArithmeticSmallLevelTwentyFive.MinusOriginalCertificates
end
