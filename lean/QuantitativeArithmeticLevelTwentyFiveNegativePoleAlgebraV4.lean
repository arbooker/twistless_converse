  have hB : B=(X-2)/X := (eq_div_iff hX).mpr hb
  have hY : Y=X^2/(X+1) := (eq_div_iff hP).mpr hy
  have he := last_identity X hX hP
  rw [← hB,← hY,hp,mul_zero] at he
  have hz : finalP X=0 := (mul_eq_zero.mp he.symm).resolve_left
    (mul_ne_zero (by norm_num) (pow_ne_zero 4 hX))
  exact NegativeExceptional.minus_one_not_physical h hy hz
