module

public import AsymptoticRationalSLLabelsV1

set_option autoImplicit false
set_option maxHeartbeats 1000000
@[expose] public section

namespace AsymptoticLocalCongruence

open Matrix AsymptoticCongruenceLabels AsymptoticCongruenceStrip
open scoped MatrixGroups

/-- A projective group in which only the primes of S may violate
integrality or the prescribed level condition. -/
noncomputable def projectiveOutside (N : ℕ) (S : Set ℕ) :
    Subgroup AsymptoticRationalGroup.Group := (outside N S).map rationalSLLabel

theorem projectiveOutside_mono (N : ℕ) {S T : Set ℕ} (h : S⊆T) :
    projectiveOutside N S ≤ projectiveOutside N T := Subgroup.map_mono (outside_mono N h)

/-- The local conditions at every prime recover the literal congruence
group, including its projective identification of scalar signs. -/
theorem projectiveOutside_empty (N : ℕ) (hN : 0<N) : projectiveOutside N ∅=gamma N := by
  apply le_antisymm
  · rintro g ⟨A,hA,rfl⟩
    obtain ⟨B,hB,he⟩ := integral_lift N hN A hA
    rw [← he,rationalSLLabel_integral]
    exact ⟨B,hB,rfl⟩
  · rintro g ⟨B,hB,rfl⟩
    exact ⟨SpecialLinearGroup.map (Int.castRingHom ℚ) B,
      integral_mem_outside N hN ∅ B hB,rationalSLLabel_integral B⟩

theorem gamma_le_projectiveOutside (N : ℕ) (hN : 0<N) (S : Set ℕ) :
    gamma N ≤ projectiveOutside N S := by
  rw [← projectiveOutside_empty N hN]
  exact projectiveOutside_mono N (Set.empty_subset S)

/-- The scalar kernel lies in both local groups, so their projective
images have exactly the expected intersection. -/
theorem projectiveOutside_inf (N : ℕ) (S T : Set ℕ) :
    projectiveOutside N S⊓projectiveOutside N T=projectiveOutside N (S∩T) := by
  apply le_antisymm
  · rintro g ⟨⟨A,hA,heA⟩,⟨B,hB,heB⟩⟩
    have hk : A*B⁻¹∈rationalSLLabel.ker := by
      change rationalSLLabel (A*B⁻¹)=1
      rw [map_mul,map_inv,heA,heB,mul_inv_cancel]
    have hAT : A∈outside N T := by
      have hh := (outside N T).mul_mem (rationalSLLabel_ker_le N T hk) hB
      simpa only [inv_mul_cancel_right] using hh
    exact ⟨A,by rw [← outside_inf]; exact ⟨hA,hAT⟩,heA⟩
  · rw [projectiveOutside,← outside_inf]
    exact Subgroup.map_inf_le _ _ _

/-- Different permitted prime sets intersect in the original congruence
group. This is the separation identity for the local old operators. -/
theorem projectiveOutside_disjoint (N : ℕ) (hN : 0<N) {S T : Set ℕ}
    (hST : Disjoint S T) : projectiveOutside N S⊓projectiveOutside N T=gamma N := by
  rw [projectiveOutside_inf,Set.disjoint_iff_inter_eq_empty.mp hST,
    projectiveOutside_empty N hN]

theorem projectiveOutside_sup_le_union (N : ℕ) (S T : Set ℕ) :
    projectiveOutside N S⊔projectiveOutside N T ≤ projectiveOutside N (S∪T) :=
  sup_le (projectiveOutside_mono N Set.subset_union_left)
    (projectiveOutside_mono N Set.subset_union_right)

/-- Separation remains valid for the group generated by any family
whose permitted primes all avoid p. -/
theorem single_prime_meet_generated_le (N p : ℕ) (hN : 0<N) {ι : Type*}
    (T : ι → Set ℕ) (hp : ∀ i,p∉T i) :
    projectiveOutside N {p}⊓(⨆ i,projectiveOutside N (T i)) ≤ gamma N := by
  have hle : (⨆ i,projectiveOutside N (T i)) ≤ projectiveOutside N (⋃ i,T i) :=
    iSup_le (fun i => projectiveOutside_mono N (Set.subset_iUnion T i))
  have hd : Disjoint ({p}:Set ℕ) (⋃ i,T i) := by
    rw [Set.disjoint_singleton_left]
    simpa only [Set.mem_iUnion,not_exists] using hp
  exact (inf_le_inf_left _ hle).trans (le_of_eq (projectiveOutside_disjoint N hN hd))

#print axioms projectiveOutside_mono
#print axioms projectiveOutside_empty
#print axioms gamma_le_projectiveOutside
#print axioms projectiveOutside_inf
#print axioms projectiveOutside_disjoint
#print axioms projectiveOutside_sup_le_union
#print axioms single_prime_meet_generated_le

end AsymptoticLocalCongruence
