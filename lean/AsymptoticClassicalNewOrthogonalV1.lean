module

public import AsymptoticClassicalTraceAdjointV1
public import AsymptoticClassicalFrickeOrthogonalV1
public import Mathlib.Analysis.InnerProductSpace.Projection.FiniteDimensional

set_option autoImplicit false
@[expose] public noncomputable section

namespace AsymptoticClassicalCusp

open UpperHalfPlane AsymptoticClassicalPetersson
open scoped InnerProduct

variable (N : ℕ) (hN : 0 < N) (k : ℤ)

/-- The two old directions at a prime divisor: ordinary lower-level
 inclusion and its global Fricke conjugate. -/
def primeOldSpace (p : {p : ℕ // p.Prime ∧ p ∣ N}) : Submodule ℂ (CuspForm (level N) k) :=
  LinearMap.range (restrict k (level_antitone (Nat.div_dvd_of_dvd p.property.2))) ⊔
    LinearMap.range (restrict k (level_le_frickeOldLevel hN (Nat.div_dvd_of_dvd p.property.2)))

/-- The classical oldspace generated by the two degeneracy directions
 at all prime divisors of the level. -/
def oldSpace : Submodule ℂ (CuspForm (level N) k) :=
  ⨆ p : {p : ℕ // p.Prime ∧ p ∣ N}, primeOldSpace N hN k p

variable [NeZero N]

theorem primeTraceKernel_eq_orthogonal (p : {p : ℕ // p.Prime ∧ p ∣ N}) :
    primeTraceKernel N hN k p = (primeOldSpace N hN k p)ᗮ := by
  let : NeZero (N / p.val) := ⟨(Nat.div_pos (Nat.le_of_dvd hN p.property.2)
    p.property.1.pos).ne'⟩
  change LinearMap.ker (arithmeticTrace (level N) (level (N / p.val)) k) ⊓
    LinearMap.ker (arithmeticTrace (level N) (frickeOldLevel N (N / p.val) hN) k) = _
  rw [trace_kernel_eq_orthogonal N (N / p.val) k (Nat.div_dvd_of_dvd p.property.2),
    fricke_trace_kernel_eq_orthogonal N (N / p.val) hN k (Nat.div_dvd_of_dvd p.property.2),
    Submodule.inf_orthogonal]
  rfl

/-- The concrete space defined by the two trace equations is precisely
 the Petersson orthogonal complement of the full classical oldspace. -/
theorem newSpace_eq_orthogonal : newSpace N hN k = (oldSpace N hN k)ᗮ := by
  unfold newSpace oldSpace
  simp_rw [primeTraceKernel_eq_orthogonal]
  exact Submodule.iInf_orthogonal _

/-- The resulting exact old/new dimension decomposition at every
 positive level and every integral weight. -/
theorem old_new_finrank :
    Module.finrank ℂ (oldSpace N hN k) + Module.finrank ℂ (newSpace N hN k) =
      Module.finrank ℂ (CuspForm (level N) k) := by
  rw [newSpace_eq_orthogonal]
  exact Submodule.finrank_add_finrank_orthogonal _

#print axioms primeTraceKernel_eq_orthogonal
#print axioms newSpace_eq_orthogonal
#print axioms old_new_finrank

end AsymptoticClassicalCusp
