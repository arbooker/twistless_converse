compact_certificate theorem mixed_split (L R : Poly)
    (hL : ∀ t ∈ L,t.2.1<4518) (hR : ∀ t ∈ R,t.2.1<4518)
    (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hs : ∀ j<4518,eval x y z w a b c v (FullPlusLeading.source j)=0) :
    eval x y z w a b c (fun j => eval x y z w a b c v (mixedInput j))
      (L ++ reindex (fun j => j+4518) (shift (-1) (0,0,0,0,0,0,0) R))=
    eval x y z w a b c (fun j => eval x y z w a b c v (jetInput j)) L := by
  rw [eval_append,eval_reindex,eval_shift x y z w a b c _ hx hy hz hw]
  have hl : eval x y z w a b c (fun j => eval x y z w a b c v (mixedInput j)) L=
      eval x y z w a b c (fun j => eval x y z w a b c v (jetInput j)) L := by
    apply eval_congr_support
    intro t ht
    simp only [mixedInput,ite_eq_left (hL t ht)]
  have hr : eval x y z w a b c
      (fun j => eval x y z w a b c v (mixedInput (j+4518))) R=0 := by
    apply eval_zero_of_support
    intro t ht
    simp only [mixedInput,show ¬ t.2.1+4518<4518 by omega,ite_false,Nat.add_sub_cancel]
    exact hs _ (hR t ht)
