theorem part_replay18 (n : ℕ) (hn : n<16) : substitute inputs (certificatePart18 n)=[] := by
  have checked : ∀ i : Fin 16, substitute inputs (certificatePart18 i.val)=[] := by decide +kernel
  exact checked ⟨n, hn⟩

theorem part_support18 : ∀ n : Fin 16, (certificatePart18 n.val).all (fun t => decide (if 288+n.val<550 then t.2.1=288+n.val ∨ (550≤t.2.1 ∧ t.2.1≤550+(288+n.val)) else (550≤t.2.1 ∧ t.2.1<1100) ∨ t.2.1=550+(288+n.val)))=true := by decide +kernel

def pivotIndexPart18 : Fin 16 → Fin 43 := ![2,32,0,14,0,0,0,14,0,2,0,10,10,11,11,22]
theorem part_pivot18 : ∀ i : Fin 16, coordinatePolynomial (certificatePart18 i.val) (550+(288+i.val))=pivotPolynomial (pivotIndexPart18 i).val := by decide +kernel

