/-- As in the existing rational certificate checker, construct reflexivity
and submit its advertised type to the ordinary kernel. No unchecked proof
or external arithmetic is accepted. -/
elab "mixed158_kernel_rfl" : tactic => do
  closeMainGoalUsing `mixed158_kernel_rfl fun type _ => do
    let type ← instantiateMVars type
    unless type.isAppOfArity ``Eq 3 && !type.hasFVar && !type.hasMVar do
      throwError "Expected a closed equality"
    let rhs := type.getAppArgs[2]!
    resetCache
    let name ← withOptions (Elab.async.set · false) <|
      mkAuxLemma [] type (← mkEqRefl rhs)
    resetCache
    return mkConst name
end

