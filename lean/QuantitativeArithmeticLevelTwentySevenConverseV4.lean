theorem residual_germ (C : Certificate ε profile m) (hm : 1 < m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (hε : (ε:ℂ)=1 ∨ (ε:ℂ)= -1) (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m f (ε:ℂ))
    (G : ℂ → Fin 321 → ℂ) (anchor : ℂ → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (ha : ∀ z, MeromorphicAt anchor z)
    (Bg : ℝ) (hg : ∀ z, Bg < z.re → originalObservations m f z=G z)
    (ha2 : (Real.sqrt 2:ℂ)*f 2= -3/2) (ha5 : (Real.sqrt 5:ℂ)*f 5= -3)
    (ha7 : (Real.sqrt 7:ℂ)*f 7= -25/7)
    (hshift : ∀ n : ℕ, 0 < n → ∀ j,
      0 ≤ meromorphicOrderAt (fun z => G z j) (((m:ℂ)+1)+n)) :
    HasAnalyticGerm (C.residual G anchor) ((m:ℂ)+1) := by
  obtain ⟨b,E,hE⟩ := selected_original_family m (by omega) hf (ε:ℂ) hε hlaw
  let B : ℝ := max b (max Bg ((2*m:ℕ):ℝ))
  have hb : b ≤ B := le_max_left _ _
  have hBg : Bg ≤ B := le_trans (le_max_left _ _) (le_max_right _ _)
  have hk : ((2*m:ℕ):ℝ) ≤ B := le_trans (le_max_right _ _) (le_max_right _ _)
  refine finite_shifted_elimination_germ (originalObservations m f) G
    (fun i => row (selected i) m f (ε:ℂ))
    (fun i => coefficient (selected i) m (ε:ℂ)) E (fun i z => C.prefixWeight z i) depth 4
    (fun i => (depth_bounds i).2) (C.residual G anchor) B ?_ ?_ ?_
    hG (C.residual_meromorphic G anchor (fun j z => (hG j z).meromorphicAt) ha)
    (fun i n j z => coefficient_analytic (selected i) m (ε:ℂ) n z j) ?_
    C.prefixWeight_meromorphic ((m:ℂ)+1) (C.prefixWeight_analytic_at_resonance hm) hshift
  · intro i M z hz
    simpa only [originalObservations,originalCoordinates,Nat.cast_add,Nat.cast_one] using
      (hE i M).2 z (lt_of_le_of_lt hb hz)
  · intro z hz
    exact hg z (lt_of_le_of_lt hBg hz)
  · intro z hz
    have hscale : ∀ j ≤ 4, scale (z-((2*m:ℕ):ℂ)) j≠0 := by
      intro j hj
      apply layer_scale_nonzero_on_initial_halfplane
      have hj' : (j:ℝ) ≤ 4 := by exact_mod_cast hj
      norm_num only [Nat.cast_ofNat] at hz
      linarith
    have hzg : originalObservations m f z=G z := hg z (by norm_num only [Nat.cast_ofNat] at hz; linarith)
    have he : C.residual G anchor z=C.residual (originalObservations m f) anchor z := by
      simp only [residual,correction,topCorrection,hzg]
    rw [he,C.initial_identity hf anchor z hscale ha2 ha5 ha7]
    simp_rw [sourcePrefix_eq_shiftedPrefix]
  · intro i M z hz
    apply (hE i M).1 z
    change b-((M:ℝ)+1) < z.re
    linarith

/-- The finite fourth-order certificate removes the resonant anchor pole.
Only the original Taylor family and its observed continuation are used. -/
theorem anchor_germ (C : Certificate ε profile m) (hm : 1 < m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (hε : (ε:ℂ)=1 ∨ (ε:ℂ)= -1) (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m f (ε:ℂ))
    (G : ℂ → Fin 321 → ℂ) (anchor : ℂ → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (ha : ∀ z, MeromorphicAt anchor z)
    (Bg : ℝ) (hg : ∀ z, Bg < z.re → originalObservations m f z=G z)
    (ha2 : (Real.sqrt 2:ℂ)*f 2= -3/2) (ha5 : (Real.sqrt 5:ℂ)*f 5= -3)
    (ha7 : (Real.sqrt 7:ℂ)*f 7= -25/7)
    (hshift : ∀ n : ℕ, 0 < n → ∀ j,
      0 ≤ meromorphicOrderAt (fun z => G z j) (((m:ℂ)+1)+n))
    (hprofile : ∀ j, HasAnalyticGerm (fun z => G z j-
      basisValues (fun t => (profile t:ℂ)) j*anchor z) ((m:ℂ)+1))
    (ho : (-1:WithTop ℤ)≤meromorphicOrderAt anchor ((m:ℂ)+1)) :
    HasAnalyticGerm anchor ((m:ℂ)+1) := by
  have hR := C.residual_germ hm hf hε hlaw G anchor hG ha Bg hg ha2 ha5 ha7 hshift
  have hQ := C.correction_germ hm G anchor hprofile (ha _) ho
  have hprod : HasAnalyticGerm (fun z => C.scalar z*anchor z) ((m:ℂ)+1) := by
    apply (hR.add hQ).congr
    exact Eventually.of_forall (fun z => sub_add_cancel _ _)
  have hn : ∀ᶠ z in 𝓝[≠] ((m:ℂ)+1), C.scalar z≠0 :=
    ((C.scalar_analytic _).continuousAt.eventually (eventually_ne_nhds C.scalar_nonzero)).filter_mono
      nhdsWithin_le_nhds
  apply (hprod.mul_analytic ((C.scalar_analytic _).inv C.scalar_nonzero)).congr
  filter_upwards [hn] with z hz
  simp only [Pi.inv_apply,← mul_assoc,inv_mul_cancel₀ hz,one_mul]

#print axioms residual_germ
#print axioms anchor_germ
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily.Certificate
