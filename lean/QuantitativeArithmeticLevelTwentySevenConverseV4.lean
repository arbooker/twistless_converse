theorem scalar_zero_at_anchor_pole (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z)
    (x : ℂ) (hx : ∀ n : ℕ, 0<n → ∀ i, 0≤meromorphicOrderAt (fun z => G z i) (x+n))
    (hp : meromorphicOrderAt (fun z => G z 6) x<0) (hk : x≠((2*m:ℕ):ℂ)) :
    scalarValue m f x=0 := by
  have h := QuantitativeArithmeticAnalyticGerm.multiplier_zero_at_pole
    ((analyticAt_const.mul (analyticAt_id.sub analyticAt_const)).mul (scalarValue_analytic m f x))
    (original_scalar_germ m hm hf BG G hG hagree x hx) hp
  exact (mul_eq_zero.mp h).resolve_left
    (mul_ne_zero (neg_ne_zero.mpr Complex.I_ne_zero) (sub_ne_zero.mpr hk))

theorem residual_of_scalar_zero (m : ℕ) (f : ℕ → ℂ) (s : ℂ)
    (hA : (Real.sqrt 2:ℂ)*f 2=(primeRate 2 m s)⁻¹-primeRate 2 m s)
    (hB : (Real.sqrt 5:ℂ)*f 5=forcedB (primeRate 2 m s) (primeRate 5 m s))
    (hK : cubic ((primeRate 2 m s)^2)≠0) (hzero : scalarValue m f s=0) :
    ((primeRate 2 m s)^2+2)*residualS ((primeRate 2 m s)^2) ((primeRate 5 m s)^2)=0 := by
  have h := QuantitativeArithmeticSmallLevelTwentySevenSecondSAnchorPlus.scalar_on_divisors
    (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    ((Real.sqrt 7:ℂ)*f 7) (primeRate_nonzero 2 m s) (primeRate_nonzero 5 m s) hK
  change eval _ _ _ _ _ _ _ (fun _ => 1) _=0 at hzero
  rw [hA,hB] at hzero
  rw [hzero,mul_zero] at h
  have hn : ((-(81/7:ℂ))*primeRate 3 m s)≠0 :=
    mul_ne_zero (by norm_num) (primeRate_nonzero 3 m s)
  apply (mul_eq_zero.mp (show ((-(81/7:ℂ))*primeRate 3 m s)*
    (((primeRate 2 m s)^2+2)*residualS ((primeRate 2 m s)^2) ((primeRate 5 m s)^2))=0 from by
      simpa only [mul_assoc] using h.symm)).resolve_left hn
