/-! ## TwentySevenFrickeSymmetry -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2500000
set_option linter.unusedSimpArgs false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenObstruction
open Matrix UpperHalfPlane SmallLevelNormalized QuantitativeArithmeticQuadraticMatrices
open QuantitativeArithmeticSmallLevelTwentySeven QuantitativeArithmeticSmallLevelTwentySevenAffine
open scoped MatrixGroups ModularForm

theorem U_word : U=(baseGL 1)⁻¹*baseGL 3 := by
  have h : baseGL 1*U=baseGL 3 :=
    lift_mul (baseMatrix 1) (mat 10) (baseMatrix 3) (baseGL_valid 1) (valid 10) (baseGL_valid 3) (by decide)
  exact (eq_inv_mul_iff_mul_eq).mpr h

theorem B_first_word : gl 2=baseGL 3*baseGL 3*baseGL 1 := by
  rw [base_lower_square]
  exact (lift_mul (baseMatrix 4) (baseMatrix 1) (mat 2) (baseGL_valid 4) (baseGL_valid 1) (valid 2) (by decide)).symm

theorem B_second_word : gl 8=baseGL 3*baseGL 1*baseGL 3 := by
  rw [base_SR]
  exact (lift_mul (baseMatrix 5) (baseMatrix 3) (mat 8) (baseGL_valid 5) (baseGL_valid 3) (valid 8) (by decide)).symm

theorem original_B_trace (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    B m (scaledFunction (2*m) f)= -((scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] baseGL 1)+
      ((scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] baseGL 1) ∣[((2*m:ℕ):ℤ)] baseGL 3)+
      (((scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] baseGL 1) ∣[((2*m:ℕ):ℤ)] baseGL 3) ∣[((2*m:ℕ):ℤ)] baseGL 3)) := by
  let F := scaledFunction (2*m) f
  have hc := original_commutator m hf 0
  change (F ∣[((2*m:ℕ):ℤ)] baseGL 5)-(F ∣[((2*m:ℕ):ℤ)] baseGL 6)=0 at hc
  have he := sub_eq_zero.mp hc
  rw [← base_SR,← base_RS,SlashAction.slash_mul,SlashAction.slash_mul] at he
  have ht := original_lower_trace m hf 0
  change (F ∣[((2*m:ℕ):ℤ)] baseGL 0)+(F ∣[((2*m:ℕ):ℤ)] baseGL 3)+(F ∣[((2*m:ℕ):ℤ)] baseGL 4)=0 at ht
  rw [base_identity,SlashAction.slash_one,← base_lower_square,SlashAction.slash_mul] at ht
  have hr := congrArg (fun G : ℍ → ℂ => G ∣[((2*m:ℕ):ℤ)] baseGL 1) ht
  simp only [SlashAction.add_slash,SlashAction.zero_slash] at hr
  rw [he] at hr
  rw [B,B_first_word,B_second_word]
  simp only [SlashAction.slash_mul]
  rw [he]
  funext z
  have hh := congrFun hr z
  simp only [Pi.add_apply,Pi.zero_apply] at hh
  simp only [Pi.sub_apply,Pi.neg_apply,Pi.add_apply]
  dsimp only [F] at hh
  linear_combination hh

theorem upper_fricke_product : baseGL 1*fricke 3 (by decide)*baseGL 3=fricke 3 (by decide) := by
  have hs : (Real.sqrt 3)^2=3 := Real.sq_sqrt (by norm_num)
  have hn : Real.sqrt 3≠0 := (Real.sqrt_pos.mpr (by norm_num)).ne'
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [baseGL,baseMatrix,liftMatrix,fricke,matrix,GeneralLinearGroup.mkOfDetNeZero,
      Matrix.det_fin_two,Matrix.mul_apply,Fin.sum_univ_two]
  field_simp [hn]
  norm_num [hs]

theorem upper_fricke : baseGL 1*fricke 3 (by decide)=fricke 3 (by decide)*(baseGL 3)⁻¹ := by
  have h := congrArg (fun G : GL (Fin 2) ℝ => G*(baseGL 3)⁻¹) upper_fricke_product
  simpa only [mul_assoc,mul_inv_cancel,mul_one] using h

theorem original_upper_inverse (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    (scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] (baseGL 1)⁻¹)+scaledFunction (2*m) f+
      (scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] baseGL 1)=0 := by
  have h := congrArg (fun G : ℍ → ℂ => G ∣[((2*m:ℕ):ℤ)] (baseGL 1)⁻¹) (original_upper_cubic hf.toEulerData m)
  simpa only [SlashAction.add_slash,SlashAction.zero_slash,← SlashAction.slash_mul,mul_inv_cancel,
    mul_assoc,mul_one,SlashAction.slash_one] using h

theorem original_AWSS (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (χ : ℂ)
    (hW : scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] fricke 3 (by decide)=χ • scaledFunction (2*m) f) :
    ((defect m (scaledFunction (2*m) f) ∣[((2*m:ℕ):ℤ)] fricke 3 (by decide))
      ∣[((2*m:ℕ):ℤ)] baseGL 3) ∣[((2*m:ℕ):ℤ)] baseGL 3=χ • B m (scaledFunction (2*m) f) := by
  let F := scaledFunction (2*m) f
  let R := baseGL 1
  let S := baseGL 3
  let W := fricke 3 (by decide)
  have hsw : S*W=W*R⁻¹ := lower_fricke
  have hrw : R*W=W*S⁻¹ := upper_fricke
  have h1 : S*R*W*S*S=W*R⁻¹*S := by
    calc
      S*R*W*S*S = S*(R*W)*S*S := by group
      _ = S*(W*S⁻¹)*S*S := by rw [hrw]
      _ = S*W*S := by group
      _ = W*R⁻¹*S := by rw [hsw]
  have h2 : S*(R*R)*W*S*S=W*R⁻¹ := by
    calc
      S*(R*R)*W*S*S = S*R*(R*W)*S*S := by group
      _ = S*R*(W*S⁻¹)*S*S := by rw [hrw]
      _ = S*(R*W)*S := by group
      _ = S*(W*S⁻¹)*S := by rw [hrw]
      _ = S*W := by group
      _ = W*R⁻¹ := hsw
  have h0 : S*W*S*S=W*R⁻¹*S*S := by rw [hsw]
  have hi := original_upper_inverse m hf
  have hiS := congrArg (fun G : ℍ → ℂ => G ∣[((2*m:ℕ):ℤ)] S) hi
  have hiSS := congrArg (fun G : ℍ → ℂ => (G ∣[((2*m:ℕ):ℤ)] S) ∣[((2*m:ℕ):ℤ)] S) hi
  have ht := original_lower_trace m hf 0
  change (F ∣[((2*m:ℕ):ℤ)] baseGL 0)+(F ∣[((2*m:ℕ):ℤ)] S)+(F ∣[((2*m:ℕ):ℤ)] baseGL 4)=0 at ht
  rw [base_identity,SlashAction.slash_one,← base_lower_square,SlashAction.slash_mul] at ht
  rw [original_defect_trace m hf,original_B_trace m hf,← base_upper_square]
  simp only [SlashAction.add_slash,← SlashAction.slash_mul]
  change (F ∣[((2*m:ℕ):ℤ)] (S*W*S*S))+(F ∣[((2*m:ℕ):ℤ)] (S*R*W*S*S))+
    (F ∣[((2*m:ℕ):ℤ)] (S*(R*R)*W*S*S))=χ • (-((F ∣[((2*m:ℕ):ℤ)] R)+
      (F ∣[((2*m:ℕ):ℤ)] (R*S))+(F ∣[((2*m:ℕ):ℤ)] (R*S*S))))
  rw [h0,h1,h2]
  simp only [SlashAction.slash_mul]
  dsimp only [F,R,S,W]
  simp only [hW,det_one_smul _ (baseGL_det 3),
    det_one_smul _ (det_one_inv _ (baseGL_det 1))]
  funext z
  have hi0 := congrFun hi z
  have hi1 := congrFun hiS z
  have hi2 := congrFun hiSS z
  have ht0 := congrFun ht z
  simp only [SlashAction.add_slash,SlashAction.zero_slash,Pi.add_apply,Pi.zero_apply] at hi0 hi1 hi2 ht0
  simp only [Pi.add_apply,Pi.smul_apply,Pi.neg_apply,smul_eq_mul]
  dsimp only [F,R,S] at hi0 hi1 hi2 ht0 ⊢
  linear_combination χ*(hi0+hi1+hi2-ht0)
#print axioms original_AWSS
end QuantitativeArithmeticSmallLevelTwentySevenObstruction
end
end

/-! ## TwentySevenInitialRapid -/
section
