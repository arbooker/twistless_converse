/-! ## TwentySevenPoleALiftOriginalRegular -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleSource
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)

/-- Pole removal for any normal-form continuation of the fixed observations.
In particular this applies to the continuation already used by the first
pole system, so its conclusions can be combined with that system's rule. -/
theorem lift_regular_for_continuation (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i x, MeromorphicNFAt (fun z => G z i) x)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z)
    (x : ℂ) (hx : liftRegularPoint m f x)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => G z j) (x+n)) (i : Fin 321) :
    AnalyticAt ℂ (fun z => G z i) x := by
  obtain ⟨η,B0,E,hη,he,hr⟩ := original_family m hm hf
  obtain ⟨C⟩ := original_lift_chart m f η hη
  let B := max B0 BG
  have hB0 : B0≤B := le_max_left _ _
  have hBG : BG≤B := le_max_right _ _
  let K := selectedCoefficient C.selection m η
  let error : ℕ → ℂ → Fin 550 → ℂ := fun n z j => E (C.selection j) n z
  have hrow (n : ℕ) (z : ℂ) (hz : B<z.re) (hpz : ∀ j, C.P j z≠0) :
      G z=C.L z *ᵥ error n z+∑ j∈Finset.range n, (C.L z*K j z) *ᵥ G (z+((j:ℂ)+1)) := by
    have h := family_selection C.selection m f η B0 E hr n z (lt_of_le_of_lt hB0 hz)
    rw [← C.source_action z] at h
    have hl := congrArg (fun v => C.L z *ᵥ v) h
    simp only [Matrix.mulVec_add,Matrix.mulVec_sum,Matrix.mulVec_mulVec] at hl
    rw [C.reconstruction z hpz] at hl
    rw [hagree z (lt_of_le_of_lt hBG hz),hl]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    have hs : BG<(z+((j:ℂ)+1)).re := by
      simp only [Complex.add_re,Complex.natCast_re,Complex.one_re]
      linarith [Nat.cast_nonneg (α:=ℝ) j]
    rw [hagree _ hs]
    simp only [K,Matrix.mulVec_mulVec,Matrix.mul_assoc]
  apply QuantitativeArithmeticLocalPoleReconstruction.regular_at B G C.L K error
    C.P x hG C.left_meromorphic
    (C.left_analytic x (C.pivots_nonzero x hx))
    (fun n z j t => sourceCoefficient_analytic (C.selection j) m η n z t)
    _ C.pivot_analytic (C.pivots_nonzero x hx) hrow hshift i
  intro n j z hz
  apply he (C.selection j) n z
  linarith

/-- Both the initial and the lifted divisor tests apply to the same original
pole system. This is a strict extension of the checked nonexceptional rule. -/
theorem original_refined_pole_system (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f,
      ∀ x : ℂ, (QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.regularPoint m f x ∨ liftRegularPoint m f x) →
      (∀ n : ℕ, 0<n → ∀ j : Fin 321,
        0≤meromorphicOrderAt (fun z => S.G z j) (x+n)) →
      ∀ i : Fin 321, AnalyticAt ℂ (fun z => S.G z i) x := by
  obtain ⟨S⟩ := QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.original_pole_system m hm hf
  refine ⟨S,?_⟩
  intro x hx hshift i
  rcases hx with hx|hx
  · exact S.regular_at x hx hshift i
  · exact lift_regular_for_continuation m hm hf S.B S.G S.meromorphic S.agreement x hx hshift i
#print axioms lift_regular_for_continuation
#print axioms original_refined_pole_system
end QuantitativeArithmeticSmallLevelTwentySevenPoleSource
end
end

/-! ## TwentySevenPoleDivisor -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
open Complex Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)

/-- The apparent divisor of the four continuation charts. -/
def pivotDivisor (m : ℕ) (f : ℕ → ℂ) (s : ℂ) : ℂ :=
  let x := QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate 2 m s
  (x-1)*(x+1)*(if f 2=0 then x^2+1 else (Real.sqrt 2:ℂ)*f 2*x+x^2-1)

theorem regularPoint_iff (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    regularPoint m f s ↔ pivotDivisor m f s≠0 := by
  by_cases h : f 2=0 <;>
    simp only [regularPoint,pivotDivisor,h,ite_true,ite_false,mul_ne_zero_iff,and_assoc]

theorem PoleSystem.pole_divisor {m : ℕ} {f : ℕ → ℂ} (S : PoleSystem m f)
    (x : ℂ) (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z j) (x+n))
    (i : Fin 321) (hpole : meromorphicOrderAt (fun z => S.G z i) x<0) :
    pivotDivisor m f x=0 := by
  by_contra h
  have ha := S.regular_at x ((regularPoint_iff m f x).mpr h) hshift i
  exact not_lt_of_ge ha.meromorphicOrderAt_nonneg hpole

/-- Original-hypothesis local pole constraint, for all Fricke signs and f₂.
Resolving the zero locus of this divisor remains a separate algebraic task. -/
theorem original_pole_divisor (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ (B : ℝ) (G : ℂ → Fin 321 → ℂ),
      (∀ i x, MeromorphicNFAt (fun z => G z i) x) ∧
      (∀ z, B<z.re → G z=basisMatrix *ᵥ originalVector m f z) ∧
      ∀ x : ℂ, (∀ n : ℕ, 0<n → ∀ j : Fin 321,
        0≤meromorphicOrderAt (fun z => G z j) (x+n)) →
        ∀ i : Fin 321, meromorphicOrderAt (fun z => G z i) x<0 → pivotDivisor m f x=0 := by
  obtain ⟨S⟩ := original_pole_system m hm hf
  exact ⟨S.B,S.G,S.meromorphic,S.agreement,fun x hx i hi => S.pole_divisor x hx i hi⟩
#print axioms regularPoint_iff
#print axioms PoleSystem.pole_divisor
#print axioms original_pole_divisor
end QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
end
end

/-! ## TwentySevenPoleAResidual -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages

def residualPolynomial (x z w b c : ℂ) : ℂ :=
  (x^4-x^2-1)*(b*z+z^2)+c*w-w^2+7*x^2-4*x^4

/-- Reduction of the second pivot divisor along the first quadratic divisor.
This is a polynomial identity, so no substitution into an analytic germ is
being made. -/
theorem exceptionalPolynomial_reduction (x z w a b c : ℂ) :
    exceptionalPolynomial x z w a b c=residualPolynomial x z w b c+
      (a*x+x^2-1)*(-(2*x^2+4)*(a*x)+x^4+6*x^2-1+b*z+z^2) := by
  unfold exceptionalPolynomial residualPolynomial
  ring

theorem exceptionalPolynomial_on_divisor (x z w a b c : ℂ)
    (h : a*x+x^2-1=0) :
    exceptionalPolynomial x z w a b c=residualPolynomial x z w b c := by
  rw [exceptionalPolynomial_reduction,h,zero_mul,add_zero]
#print axioms exceptionalPolynomial_reduction
#print axioms exceptionalPolynomial_on_divisor
end QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages
end
end

/-! ## TwentySevenPoleAConstraint -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleSource
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate)
open QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages (exceptionalPolynomial residualPolynomial exceptionalPolynomial_on_divisor)

def firstQuadratic (m : ℕ) (f : ℕ → ℂ) (s : ℂ) : ℂ :=
  (Real.sqrt 2:ℂ)*f 2*primeRate 2 m s+(primeRate 2 m s)^2-1

def residualDivisor (m : ℕ) (f : ℕ → ℂ) (s : ℂ) : ℂ :=
  residualPolynomial (primeRate 2 m s) (primeRate 5 m s) (primeRate 7 m s)
    ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)

/-- Away from f₂=0 and x=±1, a highest pole must satisfy two simultaneous
polynomial equations. Both constraints hold for the same original
continuation, for either Fricke sign. -/
theorem original_joint_pole_constraint (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f,
      ∀ s : ℂ, f 2≠0 → primeRate 2 m s-1≠0 → primeRate 2 m s+1≠0 →
      (∀ n : ℕ, 0<n → ∀ j : Fin 321,
        0≤meromorphicOrderAt (fun z => S.G z j) (s+n)) →
      ∀ i : Fin 321, meromorphicOrderAt (fun z => S.G z i) s<0 →
        firstQuadratic m f s=0 ∧ residualDivisor m f s=0 := by
  obtain ⟨S,hS⟩ := original_refined_pole_system m hm hf
  refine ⟨S,?_⟩
  intro s hf2 hminus hplus hshift i hpole
  have hd := S.pole_divisor s hshift i hpole
  have hq : firstQuadratic m f s=0 := by
    simpa only [QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.pivotDivisor,firstQuadratic,
      ite_eq_right hf2,mul_eq_zero,hminus,hplus,false_or] using hd
  have ha : (Real.sqrt 2:ℂ)*f 2≠0 := by
    apply mul_ne_zero _ hf2
    exact_mod_cast (Real.sqrt_pos.mpr (by norm_num : (0:ℝ)<2)).ne'
  have he : exceptionalPolynomial (primeRate 2 m s) (primeRate 5 m s) (primeRate 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)=0 := by
    by_contra hn
    have hreg : liftRegularPoint m f s := ⟨ha,hminus,hplus,hn⟩
    exact not_lt_of_ge (hS s (Or.inr hreg) hshift i).meromorphicOrderAt_nonneg hpole
  refine ⟨hq,?_⟩
  change residualPolynomial _ _ _ _ _=0
  rw [← exceptionalPolynomial_on_divisor _ _ _ ((Real.sqrt 2:ℂ)*f 2) _ _ hq]
  exact he
#print axioms original_joint_pole_constraint
end QuantitativeArithmeticSmallLevelTwentySevenPoleSource
end
end

/-! ## TwentySevenAnchorQuadraticPlusPhysical -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticPlus
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (physicalEval)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_analytic primeRate_nonzero)
