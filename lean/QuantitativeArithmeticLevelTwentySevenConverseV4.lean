/-! ## TwentySevenGlobalPoleRule -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenOriginalLocalPoleRule

/-- The complete pole rule for the actual321-dimensional continued observation
system: the sole possible pole is simple and at the internal weight coordinate.
The source Taylor coefficients cancel it in every lower reconstruction step. -/
theorem pole_orders (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f) :
    (∀ i,(-1:WithTop ℤ)≤meromorphicOrderAt (fun z => S.G z i) ((2*m:ℕ):ℂ)) ∧
    ∀ s : ℂ,s≠((2*m:ℕ):ℂ) → ∀ i,0≤meromorphicOrderAt (fun z => S.G z i) s := by
  have hk := weight_order m hm hf S
  refine ⟨hk,?_⟩
  intro s hs i
  by_contra! hi
  obtain ⟨B,hB⟩ := S.analytic_halfplane hf
  obtain ⟨n,hsn,hpole,hshift⟩ := SmallLevelPoleGrid.rightmost_pole_away
    (fun j z => S.G z j) ((2*m:ℕ):ℂ) hs ⟨i,hi⟩ B hB
  obtain ⟨d,hgrid,hweight⟩ := pole_grid m hm hf S (s+n) hpole
  obtain ⟨hf2,hq⟩ := weight_divisor m hm hf S hweight
  have hD := quadratic_off_weight m f hq (s+n) d hgrid hsn
  obtain ⟨η,hη,hlaw⟩ := QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.original_taylor_law
    QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m hf
  obtain ⟨j,hj⟩ := hpole
  rcases hη with rfl | rfl
  · exact (not_lt_of_ge (QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericPlus.original_regular_allowed
      m hm hf hlaw S (s+n) hf2 hD hk hshift j).meromorphicOrderAt_nonneg) hj
  · exact (not_lt_of_ge (QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericMinus.original_regular_allowed
      m hm hf hlaw S (s+n) hf2 hD hk hshift j).meromorphicOrderAt_nonneg) hj

theorem analytic_away (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (s : ℂ) (hs : s≠((2*m:ℕ):ℂ)) (i : Fin 321) :
    AnalyticAt ℂ (fun z => S.G z i) s :=
  (S.meromorphic i s).meromorphicOrderAt_nonneg_iff_analyticAt.mp ((pole_orders m hm hf S).2 s hs i)

#print axioms pole_orders
#print axioms analytic_away
end QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule
end
end

/-! ## TwentySevenBoundaryBoundedRows -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenBoundarySource
open QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point)
open QuantitativeArithmeticSmallLevelTwentySevenBoundaryExtraSource

theorem bounded_poleSource (r : QuantitativeArithmeticSmallLevelTwentySevenPoleSource.Kind)
    (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (η : ℂ)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.BoundedTaylorLaw point m f η) :
    BoundedRow (poleSource r) m f η := by
  cases r with
  | old t => exact boundedRow_old t m hm hf η hlaw
  | ramanujan i => exact boundedRow_ramanujan m f η hlaw _ _ _ _
  | hecke i =>
    obtain ⟨B,hB⟩ := QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource.hecke_original m hm hf
    exact boundedRow_of_zero _ m f η B (hB i) (fun _ _ _ => rfl)
  | entire =>
    obtain ⟨hE,B,hB⟩ := SmallLevelTaylor.original_ramanujan_entire (by decide : 0<27) (by omega : 0<2*m) hf (by decide : 0<15)
    apply boundedRow_of_entire _ m f η B (SmallLevelTaylor.ramanujanEntire 27 (2*m) f 15)
      (fun z => (hE z).differentiableAt)
      (SmallLevelTaylor.original_ramanujan_bounded_strips (by decide : 0<27) (by omega : 0<2*m) hf (by decide : 0<15))
      _ (fun _ _ _ => rfl)
    intro z hz
    change QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.physicalEval
      QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource.extraPoly2 m f z=_
    unfold QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.physicalEval
    rw [QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource.extraRow2]
    have hs := QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.sample_original point (by decide : 0<270) (by decide : 0<15) (by decide : 15∣270) 0 QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource.extraSample2 (by simpa only [zero_add,Nat.cast_ofNat,Int.cast_ofNat] using QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource.extraPoint2) m f z
    rw [show QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.sampleEval 15 QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource.extraSample2 (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) z)=SmallLevelTaylor.ramanujanAdditive (2*m) f 15 0 z by simpa using hs]
    exact (hB z hz).symm

theorem bounded_apSource (r : QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource.Kind)
    (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (η : ℂ)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.BoundedTaylorLaw point m f η) :
    BoundedRow (apSource r) m f η := by
  cases r with
  | inl t => exact bounded_poleSource t m hm hf η hlaw
  | inr i =>
    have hh : ∃ B : ℝ,∀ z : ℂ,B<z.re →
        QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.physicalEval
          (QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource.extraPoly i) m f z=0 := by
      fin_cases i
      · exact QuantitativeArithmeticSmallLevelTwentySevenPoleAPExtraSource.extraOriginal0 hm hf
      · exact QuantitativeArithmeticSmallLevelTwentySevenPoleAPExtraSource.extraOriginal1 hm hf
    obtain ⟨B,hB⟩ := hh
    exact boundedRow_of_zero _ m f η B hB (fun _ _ _ => rfl)

theorem bounded_toSource (r : Kind) (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (η : ℂ)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.BoundedTaylorLaw point m f η) :
    BoundedRow (toSource r) m f η := by
  cases r with
  | inl t => exact bounded_apSource t m hm hf η hlaw
  | inr i => exact boundedRow_ramanujan m f η hlaw _ _ _ _
#print axioms bounded_toSource
end QuantitativeArithmeticSmallLevelTwentySevenBoundarySource
end
