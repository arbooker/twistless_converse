theorem pivot_inverse_cleared (x y z w : ℂ → ℂ) (a : ℂ)
    (hx : Bounded x) (hxi : Bounded (fun s => (x s)⁻¹)) (hyi : Bounded (fun s => (y s)⁻¹))
    (hzi : Bounded (fun s => (z s)⁻¹)) (hwi : Bounded (fun s => (w s)⁻¹))
    (i : Fin 42) :
    Cleared (fun s => (x s)^4-1)
      (fun s => (pivotFactored (x s) (y s) (z s) (w s) a i.val)⁻¹) := by
  let D : ℂ → ℂ := fun s => (x s)^4-1
  have hxi' : Cleared D (fun s => (x s)⁻¹) := hxi.cleared
  have hyi' : Cleared D (fun s => (y s)⁻¹) := hyi.cleared
  have hzi' : Cleared D (fun s => (z s)⁻¹) := hzi.cleared
  have hwi' : Cleared D (fun s => (w s)⁻¹) := hwi.cleared
  obtain ⟨hmi,hpi,hsi⟩ := quartic_inverse_factors hx
  change Cleared D _
  fin_cases i <;> simp only [pivotFactored,mul_inv_rev,← inv_pow]
  all_goals repeat' first
    | exact hxi'
    | exact hyi'
    | exact hzi'
    | exact hwi'
    | exact hmi
    | exact hpi
    | exact hsi
    | apply Cleared.mul
    | apply Cleared.pow
    | exact Cleared.const D _

theorem stageLead_inverse_cleared (x y z w : ℂ → ℂ) (a b c : ℂ)
    (hx : Bounded x) (hxi : Bounded (fun s => (x s)⁻¹)) (hyi : Bounded (fun s => (y s)⁻¹))
    (hzi : Bounded (fun s => (z s)⁻¹)) (hwi : Bounded (fun s => (w s)⁻¹))
    (n : ℕ) (hn : n<871) :
    Cleared (fun s => (x s)^4-1)
      (fun s => (stageLead (x s) (y s) (z s) (w s) a b c n)⁻¹) := by
  obtain ⟨i,hi⟩ := all_leading_factor_rep n hn
  have he : (fun s => (stageLead (x s) (y s) (z s) (w s) a b c n)⁻¹)=
      (fun s => (pivotFactored (x s) (y s) (z s) (w s) a i.val)⁻¹) := by
    funext s
    unfold stageLead
    rw [coefficient_project,hi,pivot_factorization]
  rw [he]
  exact pivot_inverse_cleared x y z w a hx hxi hyi hzi hwi i
#print axioms pivot_inverse_cleared
#print axioms stageLead_inverse_cleared
end QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages
