/-! ## TwentySevenFirstShiftOriginalGerm -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenFirstShiftSource
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)
open QuantitativeArithmeticSmallLevelTwentySevenFirstShiftBinding (typedSelection)
open QuantitativeArithmeticAnalyticGerm (HasAnalyticGerm)

def weights (m : ℕ) (f : ℕ → ℂ) (η s : ℂ) (i : Fin 97) : ℂ :=
  if η=1 then QuantitativeArithmeticSmallLevelTwentySevenFirstShiftPlus.weights m f s i
  else QuantitativeArithmeticSmallLevelTwentySevenFirstShiftMinus.weights m f s i

theorem weights_analytic (m : ℕ) (f : ℕ → ℂ) (η s : ℂ) (i : Fin 97) :
    AnalyticAt ℂ (fun z => weights m f η z i) s := by
  by_cases h : η=1
  · simpa only [weights,ite_eq_left h] using
      QuantitativeArithmeticSmallLevelTwentySevenFirstShiftPlus.weights_analytic m f s i
  · simpa only [weights,ite_eq_right h] using
      QuantitativeArithmeticSmallLevelTwentySevenFirstShiftMinus.weights_analytic m f s i

theorem weighted_lower_zero (m : ℕ) (f : ℕ → ℂ) (η : ℂ) (hη : η=1 ∨ η= -1) (s : ℂ) :
    (∑ i : Fin 97, weights m f η s i*sourceRow (typedSelection i) m f η (s-1))=0 := by
  rcases hη with rfl|rfl
  · simpa only [weights,ite_true] using
      QuantitativeArithmeticSmallLevelTwentySevenFirstShiftPlus.weighted_lower_source_zero m f s
  · have hn : (-1:ℂ)≠1 := by norm_num
    simpa only [weights,ite_eq_right hn] using
      QuantitativeArithmeticSmallLevelTwentySevenFirstShiftMinus.weighted_lower_source_zero m f s

def firstRow (m : ℕ) (f : ℕ → ℂ) (η : ℂ) (G : ℂ → Fin 321 → ℂ) (s : ℂ) : ℂ :=
  ∑ j, (∑ i : Fin 97, weights m f η s i*sourceCoefficient (typedSelection i) m η 0 (s-1) j)*G s j

/-- The actual first Taylor cancellation has an analytic germ at a highest
pole of any continued observation system. No auxiliary-twist continuation
or specialization of a Hecke eigenvalue is assumed. -/
theorem first_shift_germ_for_continuation (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z) :
    ∃ η : ℂ, (η=1 ∨ η= -1) ∧ ∀ x : ℂ,
      (∀ n : ℕ, 0<n → ∀ i, 0≤meromorphicOrderAt (fun z => G z i) (x+n)) →
      HasAnalyticGerm (firstRow m f η G) x := by
  obtain ⟨η,B0,E,hη,he,hr⟩ := original_family m hm hf
  refine ⟨η,hη,?_⟩
  intro x hx
  have hW (z : ℂ) (i : Fin 97) : AnalyticAt ℂ (fun w => weights m f η (w+1) i) z :=
    (weights_analytic m f η (z+1) i).comp (f:=fun w : ℂ => w+1)
      (analyticAt_id.add analyticAt_const)
  have hz (z : ℂ) : (∑ i : Fin 97, weights m f η (z+1) i*sourceRow (typedSelection i) m f η z)=0 := by
    simpa only [add_sub_cancel_right] using weighted_lower_zero m f η hη (z+1)
  have hs (n : ℕ) (hn : 2≤n) (i : Fin 321) :
      0≤meromorphicOrderAt (fun z => G z i) ((x-1)+n) := by
    have hp : 0<n-1 := by omega
    have hh : (x-1)+(n:ℂ)=x+((n-1:ℕ):ℂ) := by
      rw [Nat.cast_sub (by omega : 1≤n),Nat.cast_one]
      ring
    rw [hh]
    exact hx (n-1) hp i
  have h := weighted_first_shift m f η B0 E he hr typedSelection
    (fun z i => weights m f η (z+1) i) hW hz BG G hG hagree (x-1) hs
  have h' := h.shift (x:=x) (d:=(-1:ℂ))
  unfold firstRow
  simpa only [sub_eq_add_neg,neg_add_cancel_right] using h'

