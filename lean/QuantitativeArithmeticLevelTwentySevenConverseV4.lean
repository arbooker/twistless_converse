    rw [hn]
    dsimp [r]
    linear_combination (1/6:ℝ)*hre-(u.re/6)*hq
  have hlo : 5/3<‖u‖^2 := by
    have h := mul_le_mul_of_nonneg_right hu.le (sq_nonneg ‖u‖)
    nlinarith
  have hhi : ‖u‖^2<7/4 := by
    have h := mul_le_mul_of_nonneg_right hl.le (sq_nonneg ‖u‖)
    nlinarith
  have hn0 := norm_nonneg u
  have hnlo : 1<‖u‖ := by nlinarith
  have hnhi : ‖u‖<2 := by nlinarith
  have hxl : -1/3<u.re := by dsimp [r] at hu; linarith
  have hxu : u.re< -3/10 := by dsimp [r] at hl; linarith
  have hxs : u.re^2<1/9 := by
    have h := mul_pos (show 0<u.re+1/3 by linarith) (show 0<1/3-u.re by linarith)
    nlinarith
  have hNre : (cubicNumerator u).re=
      (16565/27:ℝ)*(2*u.re^2-‖u‖^2)-(137495/108:ℝ)*u.re-27775/18 := by
    rw [hn]
    norm_num [cubicNumerator,pow_two,Complex.mul_re,Complex.mul_im]
    ring
  have hNneg : (cubicNumerator u).re< -1000 := by rw [hNre]; nlinarith
  have hNnorm : 1000<‖cubicNumerator u‖ := by
    have h := Complex.abs_re_le_norm (cubicNumerator u)
    have hh := neg_le_abs (cubicNumerator u).re
    linarith
  have hden : ‖24*u-88‖<136 := by
    calc
      ‖24*u-88‖≤‖24*u‖+‖(88:ℂ)‖ := norm_sub_le _ _
      _=24*‖u‖+88 := by rw [norm_mul]; norm_num
      _<136 := by linarith
  have hlin := congrArg norm (cubic_residual_linear u t hF hR)
  rw [norm_mul] at hlin
  refine ⟨hnlo,hnhi,?_⟩
  by_contra h
  have hp := mul_le_mul_of_nonneg_left (le_of_not_gt h) (norm_nonneg (24*u-88))
  nlinarith

