/-! ## TwentySevenRegularizedGrowth -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGrowth
open Complex QuantitativeArithmeticVerticalBounded
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)

theorem regularized_initial (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f) :
    ∃ (H : Fin 321 → ℂ → ℂ) (B : ℝ),
      (∀ i,Differentiable ℂ (H i)) ∧
      (∀ i s,s≠((2*m:ℕ):ℂ) → H i s=(s-((2*m:ℕ):ℂ))*S.G s i) ∧
      ∀ i,PolynomialSubstrips B (H i) := by
  have he (i : Fin 321) : ∃ H : ℂ → ℂ,Differentiable ℂ H ∧
      ∀ s : ℂ,s≠((2*m:ℕ):ℂ) → H s=(s-((2*m:ℕ):ℂ))*S.G s i := by
    apply QuantitativeArithmeticSimplePole.entire_regularization
      (fun s => S.G s i) ((2*m:ℕ):ℂ) (S.meromorphic i _).meromorphicAt
      ((QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule.pole_orders m hm hf S).1 i)
    exact fun s hs => QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule.analytic_away m hm hf S s hs i
  choose H hH he using he
  obtain ⟨B,hB⟩ := S.initial_bounded hf
  refine ⟨H,max B (2*m),hH,he,?_⟩
  intro i l u hl hu
  have hg := boundedSubstrips_polynomial (hB i) l u
    ((le_max_left _ _).trans_lt hl) ((le_max_left _ _).trans_lt hu)
  have hp := (PolynomialGrowth.id.sub (PolynomialGrowth.const ((2*m:ℕ):ℂ))).onSet
    {s : ℂ | l≤s.re ∧ s.re≤u}
  apply (hp.mul hg).congr
  intro s hs
  exact (he i s (by
    intro h
    have hh := congrArg Complex.re h
    simp only [Complex.natCast_re] at hh
    have hk := (le_max_right B (2*(m:ℝ))).trans_lt hl
    norm_num only [Nat.cast_mul,Nat.cast_ofNat] at hh
    linarith [hs.1])).symm
#print axioms regularized_initial
end QuantitativeArithmeticSmallLevelTwentySevenGrowth
end
