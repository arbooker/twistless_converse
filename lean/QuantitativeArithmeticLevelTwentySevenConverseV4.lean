      (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
      ((Real.sqrt 5:ℂ)*f 5) i.val≠0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z j) (s+n)) (i : Fin 321) :
