/-! ## TwentySevenFourState -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenOrbit
open Matrix UpperHalfPlane ModularGroup SmallLevelGenerators
open QuantitativeArithmeticSmallLevelTwentySeven QuantitativeArithmeticSmallLevelTwentySevenAffine
open QuantitativeArithmeticSmallLevelTwentySevenObstruction
open scoped MatrixGroups ModularForm

abbrev Coeff := ℤ × ℤ × ℤ × ℤ

def combo (m : ℕ) (F : ℍ → ℂ) (v : Coeff) : ℍ → ℂ :=
  (v.1:ℂ) • F+(v.2.1:ℂ) • (F ∣[((2*m:ℕ):ℤ)] T)+
  (v.2.2.1:ℂ) • (F ∣[((2*m:ℕ):ℤ)] lower 3)+
  (v.2.2.2:ℂ) • ((F ∣[((2*m:ℕ):ℤ)] T) ∣[((2*m:ℕ):ℤ)] lower 3)

def stepR (v : Coeff) : Coeff := (-v.2.1,v.1-v.2.1,-v.2.2.2,v.2.2.1-v.2.2.2)
def stepS (v : Coeff) : Coeff := (-v.2.2.1,-v.2.2.2,v.1-v.2.2.1,v.2.1-v.2.2.2)

theorem original_state_relations (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    let F := scaledFunction (2*m) f
    ((F ∣[((2*m:ℕ):ℤ)] T) ∣[((2*m:ℕ):ℤ)] T)= -F-(F ∣[((2*m:ℕ):ℤ)] T) ∧
    ((F ∣[((2*m:ℕ):ℤ)] lower 3) ∣[((2*m:ℕ):ℤ)] lower 3)= -F-(F ∣[((2*m:ℕ):ℤ)] lower 3) ∧
    ((F ∣[((2*m:ℕ):ℤ)] lower 3) ∣[((2*m:ℕ):ℤ)] T)=((F ∣[((2*m:ℕ):ℤ)] T) ∣[((2*m:ℕ):ℤ)] lower 3) ∧
    (((F ∣[((2*m:ℕ):ℤ)] T) ∣[((2*m:ℕ):ℤ)] lower 3) ∣[((2*m:ℕ):ℤ)] T)=
      -(F ∣[((2*m:ℕ):ℤ)] lower 3)-((F ∣[((2*m:ℕ):ℤ)] T) ∣[((2*m:ℕ):ℤ)] lower 3) ∧
    (((F ∣[((2*m:ℕ):ℤ)] T) ∣[((2*m:ℕ):ℤ)] lower 3) ∣[((2*m:ℕ):ℤ)] lower 3)=
      -(F ∣[((2*m:ℕ):ℤ)] T)-((F ∣[((2*m:ℕ):ℤ)] T) ∣[((2*m:ℕ):ℤ)] lower 3) := by
  let F := scaledFunction (2*m) f
  have hu := original_upper_cubic hf.toEulerData m
  have hl := original_lower_trace m hf 0
  change (F ∣[((2*m:ℕ):ℤ)] baseGL 0)+(F ∣[((2*m:ℕ):ℤ)] baseGL 3)+(F ∣[((2*m:ℕ):ℤ)] baseGL 4)=0 at hl
  rw [base_identity,SlashAction.slash_one,← base_lower_square,SlashAction.slash_mul] at hl
  have hc := original_commutator m hf 0
  change (F ∣[((2*m:ℕ):ℤ)] baseGL 5)-(F ∣[((2*m:ℕ):ℤ)] baseGL 6)=0 at hc
  rw [← base_SR,← base_RS,SlashAction.slash_mul,SlashAction.slash_mul] at hc
  have ha := original_defect_zero m hm hf
  have hat := original_defect_trace m hf
  rw [ha,← base_upper_square,SlashAction.slash_mul] at hat
  have hb := obstruction_pair m ((Real.sqrt 2:ℂ)*f 2) F (fun i => original_base_system m hf (i.castLE (by decide)))
  change B m F+(defect m (scaledFunction (2*m) f) ∣[((2*m:ℕ):ℤ)] U)=0 at hb
  rw [ha,SlashAction.zero_slash,add_zero,original_B_trace m hf,neg_eq_zero] at hb
  have hlower : lowerThree=lower 3 := by decide
  simp only [base_upper_integral,base_lower_integral,hlower] at hu hl hc hat hb
  have hc' := sub_eq_zero.mp hc
  rw [hc'] at hat
  refine ⟨?_,?_,hc',?_,?_⟩
  all_goals funext z
  · have h := congrFun hu z
    simp only [Pi.add_apply,Pi.zero_apply] at h
    simp only [Pi.neg_apply,Pi.sub_apply]
    linear_combination h
  · have h := congrFun hl z
    simp only [Pi.add_apply,Pi.zero_apply] at h
    simp only [Pi.neg_apply,Pi.sub_apply]
    dsimp only [F] at h
    linear_combination h
  · have h := congrFun hat z
    simp only [Pi.add_apply,Pi.zero_apply] at h
    simp only [Pi.neg_apply,Pi.sub_apply]
    linear_combination -h
  · have h := congrFun hb z
    simp only [Pi.add_apply,Pi.zero_apply] at h
    simp only [Pi.neg_apply,Pi.sub_apply]
    linear_combination h

theorem original_combo_R (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (v : Coeff) :
    combo m (scaledFunction (2*m) f) v ∣[((2*m:ℕ):ℤ)] T=
      combo m (scaledFunction (2*m) f) (stepR v) := by
  obtain ⟨hR,_,hc,hA,_⟩ := original_state_relations m hm hf
  simp only [combo,SlashAction.add_slash,ModularForm.SL_smul_slash,hR,hc,hA,stepR]
  funext z
  simp only [Pi.add_apply,Pi.sub_apply,Pi.neg_apply,Pi.smul_apply,smul_eq_mul,Int.cast_neg,Int.cast_sub]
  ring

theorem original_combo_S (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (v : Coeff) :
    combo m (scaledFunction (2*m) f) v ∣[((2*m:ℕ):ℤ)] lower 3=
      combo m (scaledFunction (2*m) f) (stepS v) := by
  obtain ⟨_,hS,_,_,hB⟩ := original_state_relations m hm hf
  simp only [combo,SlashAction.add_slash,ModularForm.SL_smul_slash,hS,hB,stepS]
  funext z
  simp only [Pi.add_apply,Pi.sub_apply,Pi.neg_apply,Pi.smul_apply,smul_eq_mul,Int.cast_neg,Int.cast_sub]
  ring
#print axioms original_state_relations
#print axioms original_combo_R
#print axioms original_combo_S
end QuantitativeArithmeticSmallLevelTwentySevenOrbit
