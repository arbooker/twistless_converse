  have hr : realFinalCubic u.re=0 := by
    have h := congrArg Complex.re hF
    rw [he] at h
    simpa [finalCubic,realFinalCubic,pow_succ,Complex.mul_re,Complex.mul_im] using h
  obtain ⟨hl,hu⟩ := real_final_root_bounds u.re hr
  obtain ⟨hd,hN,hN4⟩ := real_numerator_bounds u.re hl hu
  have hlin : ((24*u.re-88:ℝ):ℂ)*t=(realCubicNumerator u.re:ℂ) := by
    have h := cubic_residual_linear u t hF hR
    rw [he] at h
    simpa [cubicNumerator,realCubicNumerator] using h
  have him : (24*u.re-88)*t.im=0 := by simpa using congrArg Complex.im hlin
  have hre : (24*u.re-88)*t.re=realCubicNumerator u.re := by
    simpa using congrArg Complex.re hlin
  have htim : t.im=0 := (mul_eq_zero.mp him).resolve_left hd.ne
  have htneg : t.re<0 := by
    by_contra h
    have hp := mul_nonpos_of_nonpos_of_nonneg hd.le (le_of_not_gt h)
    nlinarith
  have htlow : -4<t.re := by
    by_contra h
    have hp := mul_nonneg_of_nonpos_of_nonpos hd.le (show t.re+4≤0 by linarith)
    nlinarith
  have hnU : ‖u‖=u.re := by
