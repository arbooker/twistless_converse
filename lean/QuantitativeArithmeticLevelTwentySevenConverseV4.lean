      exact QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusStages.all_leading_nonzero _ _ _ _ 0 _ _ hF j.val hj
    · simpa only [QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusOriginalChart.pivot,ite_eq_right hj] using hd
  have hη : ((1:ℚ):ℂ)=1 ∨ ((1:ℚ):ℂ)= -1 := by norm_num
  have hlaw' : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m f ((1:ℚ):ℂ) := by
    simpa using hlaw
  exact QuantitativeArithmeticSmallLevelTwentySevenObservedJetChart.regular_at hm hf S (1:ℚ) hη hlaw'
