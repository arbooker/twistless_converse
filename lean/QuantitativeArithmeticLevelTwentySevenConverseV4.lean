@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGrowth
open Complex QuantitativeArithmeticVerticalBounded QuantitativeArithmeticGaussianStrip
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)

/-- Rapid bounds for the actual continued observations after removal of
the one allowed simple pole. All growth assumptions are discharged from
the original coefficient bounds and the finite reconstruction system. -/
theorem original_rapid_strips (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f) :
    ∃ H : Fin 321 → ℂ → ℂ,(∀ i,Differentiable ℂ (H i)) ∧
      (∀ i s,s≠((2*m:ℕ):ℂ) → H i s=(s-((2*m:ℕ):ℂ))*S.G s i) ∧
      (∀ i σ,RapidLine (H i) σ) ∧ ∀ i a b,a<b → RapidStrip (H i) a b := by
  obtain ⟨H,hH,he,hpoly⟩ := original_all_polynomial_strips m hm hf S
  obtain ⟨B,hB⟩ := S.initial_rapid hf
  have hr (i : Fin 321) : ∀ σ : ℝ,RapidLine (H i) σ := by
    apply rapid_all_lines (hH i) (hpoly i) (max B ((2*m:ℕ):ℝ))
    intro σ hσ
    have hg := hB σ ((le_max_left _ _).trans_lt hσ) i
    have hp := RapidLine.polynomial_mul (PolynomialGrowth.id.sub (PolynomialGrowth.const ((2*m:ℕ):ℂ))) hg
    apply hp.congr
    intro s hs
    have hk : s≠((2*m:ℕ):ℂ) := by
      intro hh
      have hh' := congrArg Complex.re hh
      simp only [Complex.natCast_re,hs] at hh'
      have ht := (le_max_right B ((2*m:ℕ):ℝ)).trans_lt hσ
      linarith
    exact (he i s hk).symm
  exact ⟨H,hH,he,hr,fun i a b hab => rapid_strip (hH i) hab (hpoly i a b) (hr i a) (hr i b)⟩
#print axioms original_rapid_strips
end QuantitativeArithmeticSmallLevelTwentySevenGrowth
end
