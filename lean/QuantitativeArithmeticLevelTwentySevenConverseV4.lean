  have hR := QuantitativeArithmeticSmallLevelTwentySevenSecondRScalar.residual_of_scalar_zero m f s hA hB hK hzeroR
  have hS := residual_of_scalar_zero m f s hA hB hK hzero
  rcases alternatives_of_residuals _ _ hR hS hK with h|h|h|h
  · exact False.elim (exclude_neg_two m s hR h)
  · exact False.elim (exclude_six m s hR h)
  · exact resonance_at_four m s hR h
  · exact False.elim (final_cubic_nonzero_at_residual m s hR h)
#print axioms original_resonance_constraint
}
