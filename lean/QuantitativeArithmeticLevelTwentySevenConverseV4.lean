/-! ## TwentySevenBoundaryGenericPlusStagesCleared -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericPlusStages
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticVerticalBounded QuantitativeArithmeticTriangularMeromorphicReconstruction Matrix
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_bounded primeRate_inv_bounded quadratic_bounded)

theorem staged_left_cleared (x y z w : ℂ → ℂ) (a b c : ℂ)
    (hx : Bounded x) (hy : Bounded y) (hz : Bounded z) (hw : Bounded w)
    (hxi : Bounded (fun s => (x s)⁻¹)) (hyi : Bounded (fun s => (y s)⁻¹))
    (hzi : Bounded (fun s => (z s)⁻¹)) (hwi : Bounded (fun s => (w s)⁻¹))
    (i : Fin 321) (j : Fin 549) :
    Cleared (fun s => a*x s+(x s)^2-1)
      (fun s => stagedLeftMatrix (x s) (y s) (z s) (w s) a b c i j) := by
  let D : ℂ → ℂ := fun s => a*x s+(x s)^2-1
  have hD : Bounded D := (((Bounded.const a).mul hx).add (hx.pow 2)).sub (Bounded.const 1)
  have hcoef (p : Poly) (k : ℕ) : Cleared D
      (fun s => coefficient (x s) (y s) (z s) (w s) a b c p k) :=
    (coefficient_bounded x y z w a b c hx hy hz hw hxi hyi hzi hwi p k).cleared
  have hlead (n : ℕ) (hn : n<870) : Cleared D
      (fun s => (stageLead (x s) (y s) (z s) (w s) a b c n)⁻¹) :=
    stageLead_inverse_cleared x y z w a b c hxi hyi hzi hwi n hn
  have hlower (n k : ℕ) : Cleared D
      (fun s => stageLower (x s) (y s) (z s) (w s) a b c n k) :=
    hcoef (certificate n) (549+k)
  have hrhs (n : ℕ) (k : Fin 549) : Cleared D
      (fun s => stageRhsMatrix (x s) (y s) (z s) (w s) a b c n k) := by
    by_cases hn : n=k.val
    · simpa only [stageRhsMatrix,ite_eq_left hn,stageSource,Pi.neg_def] using (hcoef (certificate n) n).neg
    · simpa only [stageRhsMatrix,ite_eq_right hn] using Cleared.const D 0
  change Cleared D (fun s => ∑ k : Fin 549,
    outputFactor (x s) (y s) (z s) (w s) a b c i k*
      reconstructionMatrix (stageRhsMatrix (x s) (y s) (z s) (w s) a b c)
        (stageLead (x s) (y s) (z s) (w s) a b c)
        (stageLower (x s) (y s) (z s) (w s) a b c) k j)
  apply Cleared.sum hD
  intro k _
  apply Cleared.mul
  · exact (hcoef (certificate (549+i.val)) (549+k.val)).neg.div (hlead (549+i.val) (by omega))
  · exact reconstruction_cleared D hD _ _ _ hrhs (fun n hn => hlead n (by omega)) hlower k j

theorem physical_left_cleared (κ : ℝ) (a b c : ℂ) (i : Fin 321) (j : Fin 549) :
    Cleared (fun s => a*primeRate 2 κ s+(primeRate 2 κ s)^2-1)
      (fun s => physicalLeft κ a b c s i j) :=
  staged_left_cleared _ _ _ _ a b c
    (primeRate_bounded 2 κ) (primeRate_bounded 3 κ)
    (primeRate_bounded 5 κ) (primeRate_bounded 7 κ)
    (primeRate_inv_bounded 2 κ) (primeRate_inv_bounded 3 κ)
    (primeRate_inv_bounded 5 κ) (primeRate_inv_bounded 7 κ) i j

theorem physical_left_uniform_clearing (κ : ℝ) (a b c : ℂ) :
    ∃ (n : ℕ) (A : (Fin 321 × Fin 549) → ℂ → ℂ), (∀ i,Bounded (A i)) ∧
      ∀ i s,a*primeRate 2 κ s+(primeRate 2 κ s)^2-1≠0 →
        physicalLeft κ a b c s i.1 i.2=
          A i s/(a*primeRate 2 κ s+(primeRate 2 κ s)^2-1)^n :=
  Cleared.uniform (quadratic_bounded κ a) _ (fun i => physical_left_cleared κ a b c i.1 i.2)
#print axioms physical_left_cleared
#print axioms physical_left_uniform_clearing
end QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericPlusStages
end
end

