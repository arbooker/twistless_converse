theorem input_binding (i : Fin 550) : QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftMinusStages.inputs i.val=sourcePolynomial (-1:ℚ) (selection i) := selectionNode0_35_binding i.val (Nat.zero_le _) i.isLt
theorem input_support (i : Fin 550) : ∀ t∈QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftMinusStages.inputs i.val, t.2.1<607 := by
  intro t ht
  exact of_decide_eq_true ((List.all_eq_true.mp (selectionNode0_35_support i.val (Nat.zero_le _) i.isLt)) t ht)
#print axioms input_binding
#print axioms input_support
end QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftMinusSourceBinding
