/-! ## TwentySevenFourthPhysicalRow -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticTaylorLayerNormalization
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_sub_nat)

theorem normalizedRow_physical (r : Source) (hr : Supported r) (ε : ℚ) (profile : ℕ → ℚ)
    (m d : ℕ) (f : ℕ → ℂ) (anchor : ℂ → ℂ) (s : ℂ)
    (hd0 : 0 < d) (hd4 : d ≤ 4) (hscale : scale (s-((2*m:ℕ):ℂ)) d≠0)
    (ha2 : (Real.sqrt 2:ℂ)*f 2= -3/2) (ha5 : (Real.sqrt 5:ℂ)*f 5= -3)
    (ha7 : (Real.sqrt 7:ℂ)*f 7= -25/7) :
    normalizedRow r ε profile d (primeRate 2 m s) (primeRate 3 m s)
      (primeRate 5 m s) (primeRate 7 m s)
      (physicalCoordinates (originalCoordinates m f) m anchor s)=
      unprofiledRow r ε m f d s+
        topCorrection r ε profile m d (originalObservations m f) anchor s := by
  classical
  let V := physicalCoordinates (originalCoordinates m f) m anchor s
  let L := formalRow r ε (primeRate 2 m (s-(d:ℂ))) (primeRate 3 m (s-(d:ℂ)))
    (primeRate 5 m (s-(d:ℂ))) (primeRate 7 m (s-(d:ℂ))) (-3/2) (-3) (-25/7)
    (originalLayer m f d s)
  let A : ℕ → ℂ := fun n => formalHigher r ε
    (primeRate 2 m (s-(d:ℂ))) (primeRate 3 m (s-(d:ℂ)))
    (primeRate 5 m (s-(d:ℂ))) (primeRate 7 m (s-(d:ℂ))) (n+1)
    (originalLayer m f (d-(n+1)) s)
  let B : ℕ → ℂ := fun n => formalHigher r ε
    (primeRate 2 m (s-(d:ℂ))) (primeRate 3 m (s-(d:ℂ)))
    (primeRate 5 m (s-(d:ℂ))) (primeRate 7 m (s-(d:ℂ))) (n+1)
    (layerVector profile (primeRate 2 m s) (primeRate 3 m s)
      (primeRate 5 m s) (primeRate 7 m s) (d-(n+1)) V)
  have h2 : primeRate 2 m (s-(d:ℂ))=primeRate 2 m s/2^d := by simpa using primeRate_sub_nat 2 m (by norm_num) s d
  have h3 : primeRate 3 m (s-(d:ℂ))=primeRate 3 m s/3^d := by simpa using primeRate_sub_nat 3 m (by norm_num) s d
  have h5 : primeRate 5 m (s-(d:ℂ))=primeRate 5 m s/5^d := by simpa using primeRate_sub_nat 5 m (by norm_num) s d
  have h7 : primeRate 7 m (s-(d:ℂ))=primeRate 7 m s/7^d := by simpa using primeRate_sub_nat 7 m (by norm_num) s d
  have hnorm : normalizedRow r ε profile d (primeRate 2 m s) (primeRate 3 m s)
      (primeRate 5 m s) (primeRate 7 m s) V=L-∑ n∈Finset.range d, B n := by
    unfold normalizedRow
    rw [← h2,← h3,← h5,← h7]
    rw [formalRow_congr r hr ε _ _ _ _ _ _ _ _ (originalLayer m f d s) (fun j hj =>
      layerVector_physical_lower profile (originalCoordinates m f) m anchor s d j hd0 hd4 hj)]
  have hu : unprofiledRow r ε m f d s=L-∑ n∈Finset.range d, A n := by
    simp only [unprofiledRow,ha2,ha5,ha7]
    rfl
  rw [hnorm,hu]
  have he : d-1+1=d := by omega
  have htA : A (d-1)=∑ j : Fin 321, topCoefficient r ε m d s j*originalObservations m f s j := by
    dsimp only [A]
    rw [he,Nat.sub_self]
    have hv0 : originalLayer m f 0 s=(fun j => originalCoordinates m f j s) := by
      funext j
      exact layerValue_zero (originalCoordinates m f j) (2*m) s
    rw [hv0]
    rw [formalHigher_top_observed r ε m d s _ hd0 hscale]
    simp only [topCoefficient,originalObservations,div_mul_eq_mul_div,Finset.sum_div]
  have htB : B (d-1)=topScalar r ε profile m d s*anchor s := by
    dsimp only [B]
    rw [he,Nat.sub_self,formalHigher_top]
    simp only [V,physicalCoordinates_top]
  have hb : (∑ n∈Finset.range (d-1), B n)=∑ n∈Finset.range (d-1), A n := by
    apply Finset.sum_congr rfl
    intro n hn
    have hn' : n < d-1 := Finset.mem_range.mp hn
    exact formalHigher_congr r hr ε _ _ _ _ _ _ _ (fun j hj =>
      layerVector_physical_lower profile (originalCoordinates m f) m anchor s (d-(n+1)) j
        (by omega) (by omega) hj)
  have hsA := Finset.sum_range_succ A (d-1)
  have hsB := Finset.sum_range_succ B (d-1)
  rw [he,htA] at hsA
  rw [he,htB] at hsB
  unfold topCorrection
  linear_combination hsA-hsB-hb

/-- The checked normalized finite source is the original Taylor prefix
plus an explicitly observed top correction. -/
theorem normalizedRow_eq_original_prefix (r : Source) (hr : Supported r) (ε : ℚ) (profile : ℕ → ℚ)
    (m d : ℕ) {f : ℕ → ℂ} (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (anchor : ℂ → ℂ) (s : ℂ) (hd0 : 0 < d) (hd4 : d ≤ 4)
    (hscale : ∀ j ≤ d, scale (s-((2*m:ℕ):ℂ)) j≠0)
    (ha2 : (Real.sqrt 2:ℂ)*f 2= -3/2) (ha5 : (Real.sqrt 5:ℂ)*f 5= -3)
    (ha7 : (Real.sqrt 7:ℂ)*f 7= -25/7) :
