/-! ## TwentySevenGeneralPolynomialStrips -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGeneralGrowth
open Complex QuantitativeArithmeticVerticalBounded
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)

theorem GrowthSystem.polynomial_strips {d : ℕ} {D : ℂ → ℂ} {m : ℕ} {f : ℕ → ℂ}
    {S : PoleSystem m f} (R : GrowthSystem d D m f S)
    (ρ : ℂ) (hρ : ρ≠0) (κ a : ℂ)
    (hD : ∀ s,D s=a*exp (ρ*(s-κ))+exp (ρ*(s-κ))^2-1)
    (H : Fin 321 → ℂ → ℂ) (hH : ∀ i,Differentiable ℂ (H i))
    (he : ∀ i s,s≠((2*m:ℕ):ℂ) → H i s=(s-((2*m:ℕ):ℂ))*S.G s i)
    (B : ℝ) (hB : ∀ i,PolynomialSubstrips B (H i)) :
    ∀ i,StripPolynomial (H i) := by
  apply stripPolynomial_of_half_step H B hB
  intro b hb i
  apply quadratic_substrip_step ρ hρ κ a R.power R.power_pos (H i) (hH i) b
  intro l u hl hu
  simpa only [hD] using R.cleared_tail H he b hb l u hl hu i
#print axioms GrowthSystem.polynomial_strips
end QuantitativeArithmeticSmallLevelTwentySevenGeneralGrowth
end
end

