/-! ## TwentySevenMinusZeroNonzero -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages
theorem zero_parameter_reconstruction (x y z w a b c : ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hm : x-1≠0) (hp : x+1≠0) (hsq : x^2+1≠0) :
    stagedLeftMatrix x y z w a b c*sourceMatrix x y z w a b c=
      QuantitativeArithmeticSmallLevelTwentySevenObservation.basisMatrix := by
  apply staged_basis_reconstruction x y z w a b c hx hy hz hw
  intro n hn
  exact all_leading_nonzero x y z w a b c hx hy hz hw hm hp hsq n hn

theorem large_x_reconstruction (x y z w a b c : ℂ)
    (hy : y≠0) (hz : z≠0) (hw : w≠0) (hlarge : 2<‖x‖) :
    stagedLeftMatrix x y z w a b c*sourceMatrix x y z w a b c=
      QuantitativeArithmeticSmallLevelTwentySevenObservation.basisMatrix := by
  obtain ⟨hx,hm,hp,_⟩ := QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.large_x_avoids_pivots
    x 0 (by simpa only [norm_zero,zero_add] using hlarge)
  have hsq : x^2+1≠0 := by
    intro h
    have he : x^2= -1 := by linear_combination h
    have hn := congrArg norm he
    simp only [norm_pow,norm_neg,norm_one] at hn
    nlinarith [norm_nonneg x]
  exact zero_parameter_reconstruction x y z w a b c hx hy hz hw hm hp hsq
#print axioms zero_parameter_reconstruction
#print axioms large_x_reconstruction
end QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages
