    (x : ℂ) (hx : liftRegularPoint m f x)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => G z j) (x+n)) :
    (∀ i, AnalyticAt ℂ (fun z => (C.L z *ᵥ (fun j => anchorFlag (C.selection j))) i) x) ∧
      ∀ i, HasAnalyticGerm (fun z => G z i-
        (C.L z *ᵥ (fun j => anchorFlag (C.selection j))) i*G z 6) x := by
  obtain ⟨B0,E,_,he,hr⟩ := family_at_sign m hm hf η hη hlaw
  let B := max B0 BG
  have hB0 : B0≤B := le_max_left _ _
  have hBG : BG≤B := le_max_right _ _
  let K := selectedCoefficient C.selection m η
  let error : ℕ → ℂ → Fin 550 → ℂ := fun n z j => E (C.selection j) n z
  let J : ℂ → Fin 321 → ℂ := fun z => C.L z *ᵥ (fun j => anchorFlag (C.selection j))
  have hJ (z : ℂ) (i : Fin 321) : MeromorphicAt (fun w => J w i) z := by
