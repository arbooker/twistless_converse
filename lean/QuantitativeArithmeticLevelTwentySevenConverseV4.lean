/-! ## TwentySevenSecondSShiftPlusPhysical -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 3000000
set_option synthInstance.maxSize 2048
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSecondSShiftPlus
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentySevenSecondSSource
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (physicalEval lowerRates_physical)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_analytic primeRate_nonzero)
theorem certificate_support : ∀ t∈certificate, t.2.1<79 := by decide +kernel
def weights (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (i : Fin 79) : ℂ :=
  coefficient (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) certificate i.val

theorem weights_analytic (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (i : Fin 79) :
    AnalyticAt ℂ (fun z => weights m f z i) s :=
  coefficient_analytic (primeRate 2 m) (primeRate 3 m) (primeRate 5 m) (primeRate 7 m)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) s
    (primeRate_analytic 2 m s) (primeRate_analytic 3 m s) (primeRate_analytic 5 m s) (primeRate_analytic 7 m s)
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)
    certificate i.val

theorem weighted_lower_source_zero (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    (∑ i : Fin 79, weights m f s i*sourceRow (typedSelection i) m f 1 (s-1))=0 := by
  let v : ℕ → ℂ := fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) (s-1)
  have h := left_zero (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) v
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)
  rw [eval_bounded_eq_sum _ _ _ _ _ _ _ _ _ certificate_support] at h
  have he (i : Fin 79) :
      eval (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) v (leftInputs i.val)=
        sourceRow (typedSelection i) m f 1 (s-1) := by
    rw [left_source_binding,eval_normalizeBalancedFuel]
    change eval _ _ _ _ _ _ _ (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) (s-1)) (lowerRates _)=_
    rw [lowerRates_physical]
    simpa only [Rat.cast_one,Rat.cast_neg] using sourcePolynomial_physical (1:ℚ) (typedSelection i) m f (s-1)
  simp_rw [he] at h
  exact h
#print axioms weights_analytic
#print axioms weighted_lower_source_zero
end QuantitativeArithmeticSmallLevelTwentySevenSecondSShiftPlus
end
