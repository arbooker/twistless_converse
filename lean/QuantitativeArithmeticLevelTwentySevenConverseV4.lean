/-! ## TwentySevenPoleAPLiftOriginalRegular -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)

/-- Pole removal for any normal-form continuation of the fixed observations.
In particular this applies to the continuation already used by the first
pole system, so its conclusions can be combined with that system's rule. -/
theorem lift_regular_for_continuation (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i x, MeromorphicNFAt (fun z => G z i) x)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z)
    (x : ℂ) (hx : liftRegularPoint m f x)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => G z j) (x+n)) (i : Fin 321) :
    AnalyticAt ℂ (fun z => G z i) x := by
  obtain ⟨η,B0,E,hη,he,hr⟩ := original_family m hm hf
  obtain ⟨C⟩ := original_lift_chart m f η hη
  let B := max B0 BG
  have hB0 : B0≤B := le_max_left _ _
  have hBG : BG≤B := le_max_right _ _
  let K := selectedCoefficient C.selection m η
  let error : ℕ → ℂ → Fin 550 → ℂ := fun n z j => E (C.selection j) n z
  have hrow (n : ℕ) (z : ℂ) (hz : B<z.re) (hpz : ∀ j, C.P j z≠0) :
      G z=C.L z *ᵥ error n z+∑ j∈Finset.range n, (C.L z*K j z) *ᵥ G (z+((j:ℂ)+1)) := by
    have h := family_selection C.selection m f η B0 E hr n z (lt_of_le_of_lt hB0 hz)
    rw [← C.source_action z] at h
    have hl := congrArg (fun v => C.L z *ᵥ v) h
    simp only [Matrix.mulVec_add,Matrix.mulVec_sum,Matrix.mulVec_mulVec] at hl
    rw [C.reconstruction z hpz] at hl
    rw [hagree z (lt_of_le_of_lt hBG hz),hl]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    have hs : BG<(z+((j:ℂ)+1)).re := by
      simp only [Complex.add_re,Complex.natCast_re,Complex.one_re]
      linarith [Nat.cast_nonneg (α:=ℝ) j]
    rw [hagree _ hs]
    simp only [K,Matrix.mulVec_mulVec,Matrix.mul_assoc]
  apply QuantitativeArithmeticLocalPoleReconstruction.regular_at B G C.L K error
    C.P x hG C.left_meromorphic
    (C.left_analytic x (C.pivots_nonzero x hx))
    (fun n z j t => sourceCoefficient_analytic (C.selection j) m η n z t)
    _ C.pivot_analytic (C.pivots_nonzero x hx) hrow hshift i
  intro n j z hz
  apply he (C.selection j) n z
  linarith

/-- Both the initial and the lifted divisor tests apply to the same original
pole system. This is a strict extension of the checked nonexceptional rule. -/
theorem original_refined_pole_system (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f,
      ∀ x : ℂ, (QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.regularPoint m f x ∨ liftRegularPoint m f x) →
      (∀ n : ℕ, 0<n → ∀ j : Fin 321,
        0≤meromorphicOrderAt (fun z => S.G z j) (x+n)) →
      ∀ i : Fin 321, AnalyticAt ℂ (fun z => S.G z i) x := by
  obtain ⟨S⟩ := QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.original_pole_system m hm hf
  refine ⟨S,?_⟩
  intro x hx hshift i
  rcases hx with hx|hx
  · exact S.regular_at x hx hshift i
  · exact lift_regular_for_continuation m hm hf S.B S.G S.meromorphic S.agreement x hx hshift i
#print axioms lift_regular_for_continuation
#print axioms original_refined_pole_system
end QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource
end
end

/-! ## TwentySevenPoleAPResidual -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages

def secondResidualPolynomial (x z b : ℂ) : ℂ :=
  b*z*(x^6-4*x^4+6*x^2-1)+z^2*(x^6-4*x^4+6*x^2-4)-4*x^6+7*x^4-3*x^2+1

theorem secondPivotPolynomial_reduction (x z a b : ℂ) :
    secondPivotPolynomial x z a b=secondResidualPolynomial x z b+
      (a*x+x^2-1)*(-2*(a*x)^2+(x^2-2*x^4)*(a*x)+x^6+4*x^4-3*x^2+3+
        (2*x^2-1)*(b*z+z^2)) := by
  unfold secondPivotPolynomial secondResidualPolynomial
  ring

theorem secondPivotPolynomial_on_divisor (x z a b : ℂ) (h : a*x+x^2-1=0) :
    secondPivotPolynomial x z a b=secondResidualPolynomial x z b := by
  rw [secondPivotPolynomial_reduction,h,zero_mul,add_zero]
#print axioms secondPivotPolynomial_reduction
#print axioms secondPivotPolynomial_on_divisor
end QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages
end
end

/-! ## TwentySevenPoleAPConstraint -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate)
open QuantitativeArithmeticSmallLevelTwentySevenPoleSource (firstQuadratic residualDivisor)
open QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages (secondPivotPolynomial exceptionalPolynomial secondResidualPolynomial secondPivotPolynomial_on_divisor)

def secondResidualDivisor (m : ℕ) (f : ℕ → ℂ) (s : ℂ) : ℂ :=
  secondResidualPolynomial (primeRate 2 m s) (primeRate 5 m s) ((Real.sqrt 5:ℂ)*f 5)

/-- The second lifted chart forces a third simultaneous equation at a highest
pole, for both Fricke signs and for the same continued observation vector. -/
theorem original_triple_pole_constraint (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f,
      ∀ s : ℂ, f 2≠0 → primeRate 2 m s-1≠0 → primeRate 2 m s+1≠0 →
      (∀ n : ℕ, 0<n → ∀ j : Fin 321,
        0≤meromorphicOrderAt (fun z => S.G z j) (s+n)) →
      ∀ i : Fin 321, meromorphicOrderAt (fun z => S.G z i) s<0 →
        firstQuadratic m f s=0 ∧ residualDivisor m f s=0 ∧ secondResidualDivisor m f s=0 := by
  obtain ⟨S,hS⟩ := QuantitativeArithmeticSmallLevelTwentySevenPoleSource.original_joint_pole_constraint m hm hf
  refine ⟨S,?_⟩
  intro s hf2 hminus hplus hshift i hpole
  obtain ⟨hD,hP⟩ := hS s hf2 hminus hplus hshift i hpole
  have ha : (Real.sqrt 2:ℂ)*f 2≠0 := by
    apply mul_ne_zero _ hf2
    exact_mod_cast (Real.sqrt_pos.mpr (by norm_num : (0:ℝ)<2)).ne'
  have he : exceptionalPolynomial (primeRate 2 m s) (primeRate 5 m s) (primeRate 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)=0 := by
    by_contra hn
    have hreg : liftRegularPoint m f s := ⟨ha,hminus,hplus,hn⟩
    have h := lift_regular_for_continuation m hm hf S.B S.G S.meromorphic S.agreement s hreg hshift i
    exact not_lt_of_ge h.meromorphicOrderAt_nonneg hpole
  refine ⟨hD,hP,?_⟩
  change secondResidualPolynomial _ _ _=0
  rw [← secondPivotPolynomial_on_divisor _ _ ((Real.sqrt 2:ℂ)*f 2) _ hD]
  exact he
#print axioms original_triple_pole_constraint
end QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource
end
end

/-! ## TwentySevenPoleKBounds -/
section
set_option autoImplicit false
set_option maxRecDepth 8192
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds

def cubic (u : ℂ) : ℂ := u^3-4*u^2+6*u-1
def realCubic (u : ℝ) : ℝ := u^3-4*u^2+6*u-1
def forcedSquare (u : ℂ) : ℂ := -3*u^2+7*u-1

theorem realCubic_strictMono : StrictMono realCubic := by
  intro x y hxy
  have hq : 0<y^2+y*x+x^2-4*(y+x)+6 := by
    nlinarith [sq_nonneg (x-y),sq_nonneg (3*(x+y)-8)]
  have hp := mul_pos (sub_pos.mpr hxy) hq
  unfold realCubic
  nlinarith

theorem real_root_bounds (r : ℝ) (hr : realCubic r=0) :
    3/16<r ∧ r<1/5 := by
  have hl : realCubic (3/16)<0 := by norm_num [realCubic]
  have hu : 0<realCubic (1/5) := by norm_num [realCubic]
  constructor
  · by_contra h
    have hm := realCubic_strictMono.monotone (le_of_not_gt h)
    linarith
  · by_contra h
    have hm := realCubic_strictMono.monotone (le_of_not_gt h)
    linarith

/-- Elementary bounds at the real root, without numerical root isolation. -/
theorem real_root_norms (u : ℂ) (h : cubic u=0) (hi : u.im=0) :
    ‖u‖<1 ∧ ‖u‖^4<‖forcedSquare u‖^2 := by
  have he : u=(u.re:ℂ) := by apply Complex.ext <;> simp [hi]
  have hr : realCubic u.re=0 := by
    have hh := congrArg Complex.re h
    rw [he] at hh
    simpa [cubic,realCubic,pow_succ,Complex.mul_re,Complex.mul_im] using hh
  obtain ⟨hl,hu⟩ := real_root_bounds u.re hr
  have hnorm : ‖u‖=u.re := by
    calc
      ‖u‖=‖(u.re:ℂ)‖ := congrArg norm he
      _=u.re := by rw [Complex.norm_real,Real.norm_eq_abs,abs_of_pos (by linarith)]
  have ht : -3*u.re^2+7*u.re-1≤‖forcedSquare u‖ := by
    have hc : forcedSquare u=((-3*u.re^2+7*u.re-1:ℝ):ℂ) := by
      rw [he]
      simp [forcedSquare]
    rw [hc,Complex.norm_real,Real.norm_eq_abs]
    exact le_abs_self _
  rw [hnorm]
  constructor
  · linarith
  · have hs : u.re^2<1/25 := by nlinarith
    have htpos : 1/8<‖forcedSquare u‖ := by nlinarith
    nlinarith [sq_nonneg (u.re^2-‖forcedSquare u‖)]

theorem nonreal_root_norms (u : ℂ) (h : cubic u=0) (hi : u.im≠0) :
    1<‖u‖ ∧ ‖u‖^5<‖forcedSquare u‖^2 := by
  have hre := congrArg Complex.re h
  have him := congrArg Complex.im h
  simp [cubic,pow_succ,Complex.mul_re,Complex.mul_im] at hre him
  have hq : 3*u.re^2-u.im^2-8*u.re+6=0 := by
    apply (mul_eq_zero.mp (show u.im*(3*u.re^2-u.im^2-8*u.re+6)=0 by
      linear_combination him)).resolve_left hi
  let r : ℝ := 4-2*u.re
  have hr : realCubic r=0 := by
    dsimp [realCubic,r]
    linear_combination hre+(-3*u.re+4)*hq
  obtain ⟨hl,hu⟩ := real_root_bounds r hr
  have hnorm : ‖u‖^2=u.re^2+u.im^2 := by
    simpa only [Complex.normSq_apply,pow_two] using Complex.sq_norm u
  have hprod : r*‖u‖^2=1 := by
    rw [hnorm]
    dsimp [r] at hr ⊢
    unfold realCubic at hr
    linear_combination hr-(4-2*u.re)*hq
  have ht : ‖forcedSquare u‖^2=16*r^2-60*r+84 := by
    rw [Complex.sq_norm,Complex.normSq_apply]
    norm_num [forcedSquare,pow_two,Complex.mul_re,Complex.mul_im]
    dsimp [r] at hr ⊢
    unfold realCubic at hr
    linear_combination (-18*u.re+21)*hr-(9*u.im^2+45*u.re^2-114*u.re+97)*hq
  have hn0 := norm_nonneg u
  have hlo : 1<‖u‖ := by nlinarith [sq_nonneg ‖u‖]
  have hbound : ‖u‖<7/3 := by nlinarith [sq_nonneg ‖u‖]
  have htbound : 72<‖forcedSquare u‖^2 := by nlinarith [sq_nonneg r]
  have hp : ‖u‖^5<(7/3:ℝ)^5 := by gcongr
  norm_num at hp
  exact ⟨hlo,by linarith⟩
#print axioms real_root_bounds
#print axioms real_root_norms
#print axioms nonreal_root_norms
end QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds
end
end

/-! ## TwentySevenPoleKRates -/
section
set_option autoImplicit false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds

theorem log_rate_bounds : 4*Real.log 4≤2*Real.log 25 ∧ 2*Real.log 25≤5*Real.log 4 := by
  constructor
  · have h := Real.log_le_log (by norm_num : (0:ℝ)<4^4) (by norm_num : (4:ℝ)^4≤25^2)
    simpa only [Real.log_pow,Nat.cast_ofNat] using h
  · have h := Real.log_le_log (by norm_num : (0:ℝ)<25^2) (by norm_num : (25:ℝ)^2≤4^5)
    simpa only [Real.log_pow,Nat.cast_ofNat] using h

/-- The modulus constraints imposed by the two prime exponential rates are
incompatible with the algebraic exceptional case K=0. -/
theorem cubic_nonzero_of_rates (u t : ℂ) (r : ℝ)
    (hu : ‖u‖=Real.exp (Real.log 4*r))
    (ht : ‖t‖=Real.exp (Real.log 25*r))
    (he : t=forcedSquare u) : cubic u≠0 := by
  intro hzero
  have hl : 0<Real.log 4 := Real.log_pos (by norm_num)
  obtain ⟨hloglo,hloghi⟩ := log_rate_bounds
  by_cases hr : r≤0
  · have hu1 : ‖u‖≤1 := by rw [hu]; exact Real.exp_le_one_iff.mpr (mul_nonpos_of_nonneg_of_nonpos hl.le hr)
    have hp : ‖t‖^2≤‖u‖^4 := by
      rw [hu,ht,← Real.exp_nat_mul,← Real.exp_nat_mul]
      apply Real.exp_le_exp.mpr
      have hh := mul_le_mul_of_nonpos_right hloglo hr
      norm_num only [Nat.cast_ofNat]
      nlinarith
    by_cases hi : u.im=0
    · have hh := (real_root_norms u hzero hi).2
      rw [← he] at hh
      exact not_lt_of_ge hp hh
    · exact not_lt_of_ge hu1 (nonreal_root_norms u hzero hi).1
  · have hr0 : 0≤r := le_of_lt (lt_of_not_ge hr)
    have hu1 : 1≤‖u‖ := by rw [hu]; exact Real.one_le_exp_iff.mpr (mul_nonneg hl.le hr0)
    have hp : ‖t‖^2≤‖u‖^5 := by
      rw [hu,ht,← Real.exp_nat_mul,← Real.exp_nat_mul]
      apply Real.exp_le_exp.mpr
      have hh := mul_le_mul_of_nonneg_right hloghi hr0
      norm_num only [Nat.cast_ofNat]
      nlinarith
    by_cases hi : u.im=0
    · exact not_lt_of_ge hu1 (real_root_norms u hzero hi).1
    · have hh := (nonreal_root_norms u hzero hi).2
      rw [← he] at hh
      exact not_lt_of_ge hp hh
#print axioms log_rate_bounds
#print axioms cubic_nonzero_of_rates
end QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds
end
end

/-! ## TwentySevenPoleKPhysical -/
section
set_option autoImplicit false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_norm)
open QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages (secondResidualPolynomial)

theorem residual_cubic_identity (x z b : ℂ) :
    secondResidualPolynomial x z b =
      cubic (x^2)*(b*z+z^2-4)-3*(z^2-forcedSquare (x^2)) := by
  unfold secondResidualPolynomial cubic forcedSquare
  ring

theorem forcedSquare_of_residual (x z b : ℂ)
    (hQ : secondResidualPolynomial x z b=0) (hK : cubic (x^2)=0) :
    z^2=forcedSquare (x^2) := by
  rw [residual_cubic_identity,hK,zero_mul,zero_sub] at hQ
  linear_combination (-1/3:ℂ)*hQ

theorem square_rate_norm (p κ : ℝ) (s : ℂ) :
    ‖(primeRate p κ s)^2‖=Real.exp (Real.log (p^2)*(s.re-κ)) := by
  rw [norm_pow,primeRate_norm,← Real.exp_nat_mul,Real.log_pow]
  congr 1
  norm_num only [Nat.cast_ofNat]
  ring

/-- The second residual equation cannot meet the cubic denominator at the
actual prime rates. This uses their common Mellin variable, not a bound on
any Hecke eigenvalue. -/
theorem cubic_nonzero_at_residual (κ : ℝ) (s b : ℂ)
    (hQ : secondResidualPolynomial (primeRate 2 κ s) (primeRate 5 κ s) b=0) :
    cubic ((primeRate 2 κ s)^2)≠0 := by
  intro hK
  have hu : ‖(primeRate 2 κ s)^2‖=Real.exp (Real.log 4*(s.re-κ)) := by
    simpa only [show (2:ℝ)^2=4 by norm_num] using square_rate_norm 2 κ s
  have ht : ‖(primeRate 5 κ s)^2‖=Real.exp (Real.log 25*(s.re-κ)) := by
    simpa only [show (5:ℝ)^2=25 by norm_num] using square_rate_norm 5 κ s
  exact cubic_nonzero_of_rates _ _ (s.re-κ) hu ht
    (forcedSquare_of_residual _ _ _ hQ hK) hK

#print axioms cubic_nonzero_at_residual
end QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds
end
end

/-! ## TwentySevenPoleParameters -/
section
set_option autoImplicit false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_nonzero)
open QuantitativeArithmeticSmallLevelTwentySevenPoleSource (firstQuadratic residualDivisor)
open QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages (residualPolynomial)
open QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages (secondResidualPolynomial)
open QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds (cubic cubic_nonzero_at_residual)

def forcedB (x z : ℂ) : ℂ :=
  -((cubic (x^2)-3)*z^2-4*x^6+7*x^4-3*x^2+1)/(cubic (x^2)*z)

def forcedC (x z w b : ℂ) : ℂ :=
  (w^2-7*x^2+4*x^4-(x^4-x^2-1)*(b*z+z^2))/w

theorem parameters_of_divisors (x z w a b c : ℂ)
    (hx : x≠0) (hz : z≠0) (hw : w≠0) (hK : cubic (x^2)≠0)
    (hD : a*x+x^2-1=0) (hP : residualPolynomial x z w b c=0)
    (hQ : secondResidualPolynomial x z b=0) :
    a=x⁻¹-x ∧ b=forcedB x z ∧ c=forcedC x z w b := by
  constructor
  · field_simp
    linear_combination hD
  constructor
  · apply (eq_div_iff (mul_ne_zero hK hz)).mpr
    unfold secondResidualPolynomial at hQ
    unfold cubic
    linear_combination hQ
  · apply (eq_div_iff hw).mpr
    unfold residualPolynomial at hP
    linear_combination hP

/-- Every remaining nonboundary highest pole has the explicit parameter
values used by the anchored reconstruction chart. -/
theorem original_pole_parameters (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f,
      ∀ s : ℂ, f 2≠0 → primeRate 2 m s-1≠0 → primeRate 2 m s+1≠0 →
      (∀ n : ℕ, 0<n → ∀ j : Fin 321,
        0≤meromorphicOrderAt (fun z => S.G z j) (s+n)) →
      ∀ i : Fin 321, meromorphicOrderAt (fun z => S.G z i) s<0 →
      let x := primeRate 2 m s
      let z := primeRate 5 m s
      let w := primeRate 7 m s
      cubic (x^2)≠0 ∧ (Real.sqrt 2:ℂ)*f 2=x⁻¹-x ∧
        (Real.sqrt 5:ℂ)*f 5=forcedB x z ∧
        (Real.sqrt 7:ℂ)*f 7=forcedC x z w ((Real.sqrt 5:ℂ)*f 5) := by
  obtain ⟨S,hS⟩ := original_triple_pole_constraint m hm hf
  refine ⟨S,?_⟩
  intro s hf2 hminus hplus hshift i hpole
  obtain ⟨hD,hP,hQ⟩ := hS s hf2 hminus hplus hshift i hpole
  have hK := cubic_nonzero_at_residual (m:ℝ) s ((Real.sqrt 5:ℂ)*f 5) hQ
  exact ⟨hK, parameters_of_divisors _ _ _ _ _ _
    (primeRate_nonzero 2 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)
    hK hD hP hQ⟩

#print axioms parameters_of_divisors
#print axioms original_pole_parameters
end QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource
end
