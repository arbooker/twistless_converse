/-! ## TwentySevenSecondSWeightedGerm -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSecondSSource
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)
open QuantitativeArithmeticAnalyticGerm (HasAnalyticGerm)

/-- Cancellation on the initial half-plane gives an analytic first-shift
germ using only the continued observations, not individual auxiliary twists. -/
theorem weighted_first_shift {d : ℕ} (m : ℕ) (f : ℕ → ℂ) (η : ℂ)
    (B0 : ℝ) (E : Kind → ℕ → ℂ → ℂ)
    (he : ∀ r (n : ℕ) z, B0-((n:ℝ)+1)<z.re → AnalyticAt ℂ (E r n) z)
    (hr : ∀ r n z, B0<z.re → sourceRow r m f η z=E r n z+
      ∑ a∈Finset.range n, sourceShift r m η a z
        (fun j => SmallLevelAdditive.original (2*m) f
          (QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point j:ℝ) (z+((a:ℂ)+1))))
    (sel : Fin d → Kind) (W : ℂ → Fin d → ℂ)
    (hW : ∀ z i, AnalyticAt ℂ (fun w => W w i) z)
    (hzero : ∀ z, (∑ i, W z i*sourceRow (sel i) m f η z)=0)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z)
    (x : ℂ) (hshift : ∀ n : ℕ, 2≤n → ∀ i,
      0≤meromorphicOrderAt (fun z => G z i) (x+n)) :
    HasAnalyticGerm (fun z => ∑ j,
      (∑ i, W z i*sourceCoefficient (sel i) m η 0 z j)*G (z+1) j) x := by
  classical
  let B := max B0 BG
  have h0 : B0≤B := le_max_left _ _
  have hg : BG≤B := le_max_right _ _
  let H : ℕ → ℂ → ℂ := fun n z => ∑ i, W z i*E (sel i) n z
  let C : ℕ → ℂ → Fin 321 → ℂ := fun n z j =>
    ∑ i, W z i*sourceCoefficient (sel i) m η n z j
  have hC (n : ℕ) (j : Fin 321) (z : ℂ) : AnalyticAt ℂ (fun w => C n w j) z := by
    apply Finset.analyticAt_fun_sum
    intro i _
    exact (hW z i).mul (sourceCoefficient_analytic (sel i) m η n z j)
  have hH (n : ℕ) (z : ℂ) (hz : B-((n:ℝ)+1)<z.re) : AnalyticAt ℂ (H n) z := by
    apply Finset.analyticAt_fun_sum
    intro i _
    exact (hW z i).mul (he (sel i) n z (by linarith))
  have hrow (n : ℕ) (z : ℂ) (hz : B<z.re) :
      0=H n z+∑ a∈Finset.range n, ∑ j, C a z j*G (z+((a:ℂ)+1)) j := by
    have hh := family_selection sel m f η B0 E hr n z (lt_of_le_of_lt h0 hz)
    have hs (a : ℕ) : basisMatrix *ᵥ originalVector m f (z+((a:ℂ)+1))=G (z+((a:ℂ)+1)) := by
      apply (hagree _ _).symm
      simp only [Complex.add_re,Complex.natCast_re,Complex.one_re]
      linarith [Nat.cast_nonneg (α:=ℝ) a]
    simp_rw [hs] at hh
    have hw := congrArg (fun v : Fin d → ℂ => ∑ i, W z i*v i) hh
    simp only [selectedRows,Pi.add_apply,Finset.sum_apply,mul_add,Finset.sum_add_distrib] at hw
    rw [hzero z] at hw
    have ht : (∑ i, W z i*(∑ a∈Finset.range n,
        (selectedCoefficient sel m η a z *ᵥ G (z+((a:ℂ)+1))) i))=
        ∑ a∈Finset.range n, ∑ j, (∑ i, W z i*sourceCoefficient (sel i) m η a z j)*G (z+((a:ℂ)+1)) j := by
      simp only [selectedCoefficient,Matrix.mulVec,dotProduct,Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro a _
      rw [Finset.sum_comm]
      simp only [Finset.sum_mul,mul_assoc]
    rw [ht] at hw
    exact hw
  exact QuantitativeArithmeticCancelledTaylorRows.first_shift G B C H hG hC hH hrow x hshift

#print axioms weighted_first_shift
end QuantitativeArithmeticSmallLevelTwentySevenSecondSSource
end
end

/-! ## TwentySevenSecondSShiftPlusGerm -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSecondSShiftPlus
open Matrix Filter
