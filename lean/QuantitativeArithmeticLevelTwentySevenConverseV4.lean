def observedValue (p : Poly) (m : ℕ) (f : ℕ → ℂ) (G : ℂ → Fin 321 → ℂ) (s : ℂ) : ℂ :=
  ∑ j : Fin 321, coefficient (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) p j.val*G s j

theorem observedValue_basis (p : Poly) (hp : ∀ t∈p, t.2.1<321)
    (m : ℕ) (f : ℕ → ℂ) (v : ℕ → ℂ) (s : ℂ) :
    observedValue p m f (fun _ => basisValues v) s=
      jetEval (substitute (fun j => liftRationalRow (basis j)) p) m
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) s v := by
  unfold jetEval
  rw [eval_substitute _ _ _ _ _ _ _ _
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)]
  simp_rw [eval_lift]
  rw [eval_bounded_eq_sum _ _ _ _ _ _ _ _ _ hp]
  rfl

theorem observedValue_meromorphic (p : Poly) (m : ℕ) (f : ℕ → ℂ)
    (G : ℂ → Fin 321 → ℂ) (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z) (s : ℂ) :
    MeromorphicAt (observedValue p m f G) s := by
  apply MeromorphicAt.fun_sum
  intro j _
  apply MeromorphicAt.mul _ (hG j s).meromorphicAt
  exact (coefficient_analytic (primeRate 2 m) (primeRate 3 m) (primeRate 5 m) (primeRate 7 m)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) s
    (primeRate_analytic 2 m s) (primeRate_analytic 3 m s) (primeRate_analytic 5 m s) (primeRate_analytic 7 m s)
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s) p j.val).meromorphicAt

theorem firstRow_basis (m : ℕ) (f : ℕ → ℂ) (η s : ℂ) (v : ℕ → ℂ) :
    firstRow m f η (fun _ => basisValues v) s=
      ∑ i : Fin 97, weights m f η s i*sourceShift (typedSelection i) m η 0 (s-1) v := by
  unfold firstRow
  simp only [Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  rw [← sourceShift_action]
  simp only [Finset.mul_sum,mul_assoc]

theorem firstRow_meromorphic (m : ℕ) (f : ℕ → ℂ) (η : ℂ)
    (G : ℂ → Fin 321 → ℂ) (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z) (s : ℂ) :
    MeromorphicAt (firstRow m f η G) s := by
  apply MeromorphicAt.fun_sum
  intro j _
  apply MeromorphicAt.mul _ (hG j s).meromorphicAt
  apply AnalyticAt.meromorphicAt
  apply Finset.analyticAt_fun_sum
  intro i _
  exact (weights_analytic m f η s i).mul
    ((sourceCoefficient_analytic (typedSelection i) m η 0 (s-1) j).comp
      (f:=fun z : ℂ => z-1) (analyticAt_id.sub analyticAt_const))

#print axioms observedValue_basis
#print axioms firstRow_basis
#print axioms firstRow_meromorphic
#print axioms observedValue_meromorphic
end QuantitativeArithmeticSmallLevelTwentySevenFirstShiftSource
