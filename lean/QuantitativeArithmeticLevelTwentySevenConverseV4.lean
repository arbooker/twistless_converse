    (hR : residual u t=0) (hi : u.im≠0) : 1<‖u‖ ∧ ‖u‖<2 ∧ 6<‖t‖ := by
  have hre := congrArg Complex.re hF
  have him := congrArg Complex.im hF
  simp [finalCubic,pow_succ,Complex.mul_re,Complex.mul_im] at hre him
  have hq : 18*u.re^2-6*u.im^2-28*u.re-1=0 := by
    apply (mul_eq_zero.mp (show u.im*(18*u.re^2-6*u.im^2-28*u.re-1)=0 by
      linear_combination him)).resolve_left hi
