/-- The original continued observation system has a constant anchor profile
modulo analytic germs at a regular highest-pole point where the quadratic
has only simple roots. No individual unobserved twist is continued. -/
theorem original_constant_anchor_profile (m : ℕ) (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (S : PoleSystem m f) (x : ℂ) (hx : liftRegularPoint m f x)
    (hsq : (primeRate 2 m x)^2≠ -1)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z j) (x+n)) :
    (-1:WithTop ℤ)≤meromorphicOrderAt (fun z => S.G z 6) x ∧
    ∃ c : Fin 321→ℂ, ∀ i,
      HasAnalyticGerm (fun z => S.G z i-c i*S.G z 6) x := by
  have hquad := quadratic_germ_for_continuation m hm hf S.B S.G
    S.meromorphic S.agreement x hshift
  have hb := QuantitativeArithmeticQuadraticGermOrder.pole_order_ge_neg_one
    (primeRate_analytic 2 m x) (primeRate_two_deriv_ne_zero m x)
    ((Real.sqrt 2:ℂ)*f 2) hsq (S.meromorphic 6 x).meromorphicAt hquad
  obtain ⟨J,hJ,hrel⟩ := lift_anchor_for_continuation m hm hf S.B S.G
    S.meromorphic S.agreement x hx hshift
  exact ⟨hb,J x,fun i => freeze_simple_pole_anchor (hrel i) (hJ i)
    (S.meromorphic 6 x).meromorphicAt hb⟩

#print axioms original_constant_anchor_profile
end QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
