/-! ## TwentySevenQuadraticPoleBound -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages
open QuantitativeArithmeticSmallLevelTwentySevenPoleSource (firstQuadratic)

theorem primeRate_two_deriv_ne_zero (m : ℕ) (s : ℂ) :
    deriv (primeRate 2 m) s ≠ 0 := by
  have hh : HasDerivAt (primeRate 2 m)
      (primeRate 2 m s*(Real.log 2:ℂ)) s := by
    unfold primeRate
    simpa only [primeRate,mul_one,id_eq,Complex.ofReal_natCast] using
      (((hasDerivAt_id s).sub_const (m:ℂ)).const_mul (Real.log 2:ℂ)).cexp
  rw [hh.deriv]
  apply mul_ne_zero (primeRate_nonzero 2 m s)
  exact_mod_cast (Real.log_pos (by norm_num : (1:ℝ)<2)).ne'

/-- Directly from the original equations, the 1/9 anchor has at most a
double pole when all positive integral translates of the observed system
are regular. This includes the exceptional parameter boundaries. -/
theorem original_anchor_pole_bound (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f,
      ∀ x : ℂ, (∀ n : ℕ, 0<n → ∀ i,
        0≤meromorphicOrderAt (fun z => S.G z i) (x+n)) →
      (-2 : WithTop ℤ)≤meromorphicOrderAt (fun z => S.G z 6) x := by
  obtain ⟨S,hS⟩ := original_quadratic_germ m hm hf
  refine ⟨S,fun x hx => ?_⟩
  exact QuantitativeArithmeticQuadraticGermOrder.pole_order_ge_neg_two
    (primeRate_analytic 2 m x) (primeRate_two_deriv_ne_zero m x)
    ((Real.sqrt 2:ℂ)*f 2) (S.meromorphic 6 x).meromorphicAt (hS x hx)

#print axioms primeRate_two_deriv_ne_zero
#print axioms original_anchor_pole_bound
end QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
