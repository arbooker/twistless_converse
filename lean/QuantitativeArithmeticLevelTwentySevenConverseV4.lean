theorem PoleSystem.initial_rapid {m : ℕ} {f : ℕ → ℂ} (S : PoleSystem m f)
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ B : ℝ,∀ σ : ℝ,B<σ → ∀ i : Fin 321,RapidLine (fun s => S.G s i) σ := by
  obtain ⟨τ,_,hg⟩ := hf.growth
  obtain ⟨B,hB⟩ := SmallLevelAdditive.transform_rapid_halfplane
    (FinitenessOriginalFourier.polynomial_bound hf.zero hg (2*m))
  refine ⟨max B S.B,?_⟩
  intro σ hσ i
  have hobs (j : Fin 607) : RapidLine
      (fun s => basisMatrix i j*SmallLevelAdditive.original (2*m) f (point j:ℝ) s) σ :=
    RapidLine.polynomial_mul (PolynomialGrowth.const _) (hB (point j) σ ((le_max_left _ _).trans_lt hσ))
  have hsum := RapidLine.sum Finset.univ _ σ (fun j _ => hobs j)
  apply hsum.congr
  intro s hs
  have hb : S.B<s.re := by rw [hs]; exact (le_max_right _ _).trans_lt hσ
  rw [S.agreement s hb]
  rfl
#print axioms PoleSystem.initial_rapid
