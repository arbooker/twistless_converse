/-! ## TwentySevenPoleAPLiftPlusSourceAction -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusSourceBinding
open Matrix QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (physicalEval)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point originalVector)

theorem source_action (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages.physicalSource m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5)
      ((Real.sqrt 7:ℂ)*f 7) s *ᵥ originalVector m f s=selectedRows selection m f (1) s := by
  funext i
  have hv : (QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages.physicalSource m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5)
      ((Real.sqrt 7:ℂ)*f 7) s *ᵥ originalVector m f s) i=
      physicalEval (QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages.inputs i.val) m f s := by
    simpa only [QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages.physicalSource,QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages.sourceMatrix,physicalEval,originalVector,
      QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate,Matrix.mulVec,dotProduct] using
      (eval_bounded_eq_sum (QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate 2 m s) (QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate 3 m s)
        (QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate 5 m s) (QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
