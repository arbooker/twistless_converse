    (hy : y≠0) (hz : z≠0) (hw : w≠0) (hf : secondDivisor x z b≠0)
    (i : Fin 7) : QuantitativeArithmeticSmallLevelTwentySevenZeroJetSecondMinusStages.factorValue x y z w b i.val≠0 :=
  second_factors x y z w b hx hy hz hw hf i
