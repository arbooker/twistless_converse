      sourcePrefix r m f ε d s/scale (s-((2*m:ℕ):ℂ)) d+
        topCorrection r ε profile m d (originalObservations m f) anchor s := by
  rw [normalizedRow_physical r hr ε profile m d f anchor s hd0 hd4 (hscale d le_rfl) ha2 ha5 ha7,
    unprofiledRow_eq_prefix r ε m d hf s hscale]

