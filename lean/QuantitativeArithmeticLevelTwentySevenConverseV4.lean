/-! ## TwentySevenGenericLocalPoleRule -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGenericLocalPoleRule
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_norm)

theorem rate_norm_gt_one (m : ℕ) (s : ℂ) (hs : (m:ℝ) < s.re) :
    1 < ‖primeRate 2 m s‖ := by
  rw [primeRate_norm,Real.one_lt_exp_iff]
  exact mul_pos (Real.log_pos (by norm_num : (1:ℝ)<2)) (sub_pos.mpr hs)

theorem boundary_quadratic (a u : ℂ) (ha : a ≠ 0) (hu : u=1 ∨ u= -1) :
    a*u+u^2-1 ≠ 0 := by
  rcases hu with rfl | rfl
  · simpa using ha
  · simpa using ha

/-- All unit-rate boundary points are regular when f2 is nonzero. -/
theorem unit_rate_regular (m : ℕ) (hm : 0 < m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (hf2 : f 2 ≠ 0) (x : ℂ) (hn : ‖primeRate 2 m x‖=1)
    (hshift : ∀ n : ℕ, 0 < n → ∀ j : Fin 321,
      0 ≤ meromorphicOrderAt (fun z => S.G z j) (x+n)) :
    ∀ i, 0 ≤ meromorphicOrderAt (fun z => S.G z i) x := by
  by_cases hb : primeRate 2 m x=1 ∨ primeRate 2 m x= -1
  · have hq := boundary_quadratic ((Real.sqrt 2:ℂ)*f 2) _
      (mul_ne_zero (Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (by norm_num))) hf2) hb
    obtain ⟨η,hη,hlaw⟩ := QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.original_taylor_law QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m hf
    rcases hη with rfl | rfl
    · intro i
      exact (QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericPlus.original_regular m hm hf hlaw S x hf2 hq hshift i).meromorphicOrderAt_nonneg
    · intro i
      exact (QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericMinus.original_regular m hm hf hlaw S x hf2 hq hshift i).meromorphicOrderAt_nonneg
  · have hminus : primeRate 2 m x-1 ≠ 0 := by
      intro h; exact hb (Or.inl (sub_eq_zero.mp h))
    have hplus : primeRate 2 m x+1 ≠ 0 := by
      intro h; exact hb (Or.inr (eq_neg_of_add_eq_zero_left h))
    by_contra h
    push Not at h
    obtain he | he := QuantitativeArithmeticSmallLevelTwentySevenSecondSScalar.highest_pole_location m hm hf S x hf2 hminus hplus hshift h
    · subst x
      have hh := rate_norm_gt_one m (((2*m:ℕ):ℂ)) (by norm_num; exact_mod_cast (by omega : m < 2*m))
      rw [hn] at hh
      exact (lt_irrefl _) hh
    · subst x
      have hh := rate_norm_gt_one m ((m:ℂ)+1) (by simp)
      rw [hn] at hh
      exact (lt_irrefl _) hh

/-- Complete highest-pole rule for f2 nonzero, in every positive even weight. -/
theorem highest_pole_rule (m : ℕ) (hm : 0 < m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (hf2 : f 2 ≠ 0) (x : ℂ)
    (hshift : ∀ n : ℕ, 0 < n → ∀ j : Fin 321,
      0 ≤ meromorphicOrderAt (fun z => S.G z j) (x+n)) :
    (∀ i, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (fun z => S.G z i) x) ∧
    (x ≠ ((2*m:ℕ):ℂ) → ∀ i, 0 ≤ meromorphicOrderAt (fun z => S.G z i) x) := by
  by_cases hn : ‖primeRate 2 m x‖=1
  · have hr := unit_rate_regular m hm hf S hf2 x hn hshift
    exact ⟨fun i => le_trans (show (-1 : WithTop ℤ) ≤ 0 from
      WithTop.coe_le_coe.mpr (by norm_num : (-1:ℤ) ≤ 0)) (hr i),fun _ => hr⟩
  · exact QuantitativeArithmeticSmallLevelTwentySevenLocalPoleRule.highest_pole_rule m hm hf S x hn hshift

#print axioms highest_pole_rule
end QuantitativeArithmeticSmallLevelTwentySevenGenericLocalPoleRule
end
end

/-! ## TwentySevenZeroJetRates -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenZeroLocalPoleRule
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_norm)
theorem boundary_rates (m : ℕ) (hm : 0<m) (s : ℂ)
    (hx : (primeRate 2 m s)^2=1 ∨ (primeRate 2 m s)^2= -1) :
    s≠((2*m:ℕ):ℂ) ∧ ‖primeRate 5 m s‖=1 := by
  have hn : ‖primeRate 2 m s‖=1 := by
    rcases hx with hx|hx
    · have he := congrArg norm hx
      simp only [norm_pow,norm_one] at he
      nlinarith [norm_nonneg (primeRate 2 m s)]
    · have he := congrArg norm hx
      simp only [norm_pow,norm_neg,norm_one] at he
      nlinarith [norm_nonneg (primeRate 2 m s)]
  rw [primeRate_norm] at hn
  have hp := (Real.exp_eq_one_iff _).mp hn
  have hr : s.re=(m:ℝ) := by nlinarith [Real.log_pos (by norm_num : (1:ℝ)<2)]
  constructor
  · intro he
    rw [he] at hr
    have hm' : (0:ℝ)<m := by exact_mod_cast hm
    norm_num at hr
    linarith
  · rw [primeRate_norm,hr,sub_self,mul_zero,Real.exp_zero]

#print axioms boundary_rates
end QuantitativeArithmeticSmallLevelTwentySevenZeroLocalPoleRule
end
end

/-! ## TwentySevenZeroJetCommonPlusReconstruction -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusStages
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticRationalRows (extend)
open QuantitativeArithmeticTriangularMeromorphicReconstruction Matrix

section Parameters
variable (x y z w a b c : ℂ)
local notation "C" => coefficient x y z w a b c
local notation "E" => eval x y z w a b c

def stageLead (n : ℕ) : ℂ := C (certificate n) (649+n)
def stageLower (n j : ℕ) : ℂ := C (certificate n) (649+j)
def stageSource (n : ℕ) : ℂ := -C (certificate n) n

def stageRhsMatrix (n : ℕ) (j : Fin 649) : ℂ :=
  if n=j.val then stageSource x y z w a b c n else 0

def sourceMatrix : Matrix (Fin 649) (Fin 1214) ℂ := fun i j => C (inputs i.val) j.val
def outputMatrix : Matrix (Fin 321) (Fin 1214) ℂ := fun i j => C (inputs (1298+i.val)) j.val

def outputFactor : Matrix (Fin 321) (Fin 649) ℂ :=
  fun i j => -C (certificate (649+i.val)) (649+j.val)/stageLead x y z w a b c (649+i.val)

def stagedLeftMatrix : Matrix (Fin 321) (Fin 649) ℂ :=
  outputFactor x y z w a b c *
    reconstructionMatrix (stageRhsMatrix x y z w a b c)
      (stageLead x y z w a b c) (stageLower x y z w a b c)

theorem stage_relation (v : ℕ → ℂ) (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (n : ℕ) (hn : n<649) :
    stageLead x y z w a b c n*E v (inputs (649+n))=
      stageSource x y z w a b c n*E v (inputs n)-
        ∑ j : Fin n, stageLower x y z w a b c n j.val*E v (inputs (649+j.val)) := by
  have hs : ∀ t∈certificate n, t.2.1=n ∨ (649≤t.2.1 ∧ t.2.1<649+(n+1)) := by
    intro t ht
    have hh := of_decide_eq_true ((List.all_eq_true.mp (all_support n (by omega))) t ht)
    simp only [ite_eq_left hn] at hh
    omega
  have he := substitution_zero x y z w a b c v hx hy hz hw inputs (certificate n) (all_replays n (by omega))
  rw [eval_spike_block x y z w a b c _ _ n 649 (n+1) (Or.inl hn) hs,
    Fin.sum_univ_castSucc] at he
  simp only [Fin.val_castSucc,Fin.val_last] at he
  dsimp only [stageLead,stageSource,stageLower]
  linear_combination he

theorem output_relation (v : ℕ → ℂ) (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (i : Fin 321) :
    stageLead x y z w a b c (649+i.val)*E v (inputs (1298+i.val))=
      -∑ j : Fin 649, C (certificate (649+i.val)) (649+j.val)*E v (inputs (649+j.val)) := by
  have hs : ∀ t∈certificate (649+i.val),
      t.2.1=1298+i.val ∨ (649≤t.2.1 ∧ t.2.1<649+649) := by
    intro t ht
    have hh := of_decide_eq_true ((List.all_eq_true.mp (all_support (649+i.val) (by omega))) t ht)
    simp only [show ¬649+i.val<649 by omega,ite_false] at hh
    omega
  have he := substitution_zero x y z w a b c v hx hy hz hw inputs (certificate (649+i.val))
    (all_replays (649+i.val) (by omega))
  rw [eval_spike_block x y z w a b c _ _ (1298+i.val) 649 649 (Or.inr (by omega)) hs] at he
  dsimp only [stageLead]
  have heq : 649+(649+i.val)=1298+i.val := by omega
  rw [heq]
  linear_combination he

theorem stages_recover (v : ℕ → ℂ) (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hp : ∀ n, n<649 → stageLead x y z w a b c n≠0) (i : Fin 649) :
    (reconstructionMatrix (stageRhsMatrix x y z w a b c)
      (stageLead x y z w a b c) (stageLower x y z w a b c) *ᵥ
        (fun j : Fin 649 => E v (inputs j.val))) i=E v (inputs (649+i.val)) := by
  rw [reconstruction_action]
  apply solve_correct _ _ (fun n => E v (inputs (649+n))) _ 649 hp _ i.val i.isLt
  intro n hn
  have he := stage_relation x y z w a b c v hx hy hz hw n hn
  have hr : (∑ j : Fin 649, stageRhsMatrix x y z w a b c n j*E v (inputs j.val))=
      stageSource x y z w a b c n*E v (inputs n) := by
    rw [show (fun j : Fin 649 => stageRhsMatrix x y z w a b c n j*E v (inputs j.val))=
      (fun j : Fin 649 => (if n=j.val then stageSource x y z w a b c n else 0)*E v (inputs j.val)) from rfl]
    rw [single_sum]
    simp [extend,hn]
  rw [hr]
  exact he

theorem outputs_recover (v : ℕ → ℂ) (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hp : ∀ n, n<970 → stageLead x y z w a b c n≠0) (i : Fin 321) :
    (stagedLeftMatrix x y z w a b c *ᵥ (fun j : Fin 649 => E v (inputs j.val))) i=
      E v (inputs (1298+i.val)) := by
  rw [stagedLeftMatrix,← Matrix.mulVec_mulVec]
  have hs : reconstructionMatrix (stageRhsMatrix x y z w a b c)
      (stageLead x y z w a b c) (stageLower x y z w a b c) *ᵥ
        (fun j : Fin 649 => E v (inputs j.val)) =
          (fun j : Fin 649 => E v (inputs (649+j.val))) := by
    funext j
    exact stages_recover x y z w a b c v hx hy hz hw (fun n hn => hp n (by omega)) j
  rw [hs]
  change (∑ j : Fin 649, outputFactor x y z w a b c i j*E v (inputs (649+j.val))) = _
  have he := output_relation x y z w a b c v hx hy hz hw i
  have hp' := hp (649+i.val) (by omega)
  dsimp only [outputFactor]
  simp_rw [div_mul_eq_mul_div,neg_mul]
  rw [← Finset.sum_div,Finset.sum_neg_distrib]
  have hneg : -(∑ j : Fin 649, C (certificate (649+i.val)) (649+j.val)*E v (inputs (649+j.val)))=
      stageLead x y z w a b c (649+i.val)*E v (inputs (1298+i.val)) := he.symm
  rw [hneg,mul_div_cancel_left₀ _ hp']

/-- The explicit 321 by 649 left reconstruction matrix recovers all
constant observation rows from the selected source rows. -/
theorem staged_matrix_identity (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hp : ∀ n, n<970 → stageLead x y z w a b c n≠0) :
    stagedLeftMatrix x y z w a b c * sourceMatrix x y z w a b c=outputMatrix x y z w a b c := by
  have action (v : Fin 1214 → ℂ) :
      stagedLeftMatrix x y z w a b c *ᵥ (sourceMatrix x y z w a b c *ᵥ v)=
        outputMatrix x y z w a b c *ᵥ v := by
    funext i
    have he := outputs_recover x y z w a b c (extend v) hx hy hz hw hp i
    simp_rw [eval_extend_eq_sum] at he
    exact he
  apply Matrix.ext
  intro i j
  have he := congrFun (action (Pi.single j 1)) i
  rw [Matrix.mulVec_mulVec] at he
  simpa only [Matrix.mulVec_single_one,Matrix.col_apply] using he
end Parameters
#print axioms stage_relation
#print axioms stages_recover
#print axioms staged_matrix_identity
end QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusStages
end
