/-! ## TwentySevenResidueData -/
section
set_option autoImplicit false
set_option maxRecDepth 200000
set_option maxHeartbeats 12000000
@[expose] public section
namespace QuantitativeArithmeticSmallLevelTwentySevenOrbit
open Matrix ModularGroup SmallLevelGenerators
open scoped MatrixGroups
abbrev Residue := SL(2,ZMod 9)
def pair (i : ℕ) : ℤ × ℤ :=
  match i%3 with
  | 0 => (1,0)
  | 1 => (0,1)
  | _ => (-1,-1)
def rawCoeff (a b c : ZMod 9) : Coeff :=
  let x := pair (a.val*b.val)
  let y := pair (a.val*(c.val/3))
  (x.1*y.1,x.2*y.1,x.1*y.2,x.2*y.2)
def residueCoeff (A : Residue) : Coeff := rawCoeff (A.1 0 0) (A.1 0 1) (A.1 1 0)
def good (A : Residue) : Prop := (A.1 1 0).val%3=0
instance (A : Residue) : Decidable (good A) := inferInstanceAs (Decidable ((A.1 1 0).val%3=0))
theorem residue_one : residueCoeff 1=(1,0,0,0) := by decide
end QuantitativeArithmeticSmallLevelTwentySevenOrbit
end
