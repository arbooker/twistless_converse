/-! ## TwentySevenBoundedSourceFamily -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point)
open QuantitativeArithmeticSmallLevelTwentySevenShiftSource (basisValues)
open QuantitativeArithmeticMellinStrip

def BoundedRow (r : Source) (m : ℕ) (f : ℕ → ℂ) (η : ℂ) : Prop :=
  ∃ (B : ℝ) (E : ℕ → ℂ → ℂ), ∀ M : ℕ,
    AnalyticOnNhd ℂ (E M) {s : ℂ | B-((M:ℝ)+1)<s.re} ∧
    BoundedSubstrips (B-((M:ℝ)+1)) (E M) ∧
    ∀ s : ℂ, B<s.re → row r m f η s=E M s+∑ n∈Finset.range M,
      shift r m η n s (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) (s+((n+1:ℕ):ℂ)))

theorem boundedRow_matrix (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (η : ℂ)
    (r : QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.Spec)
    (hr : QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.Valid point r)
    (obs : Fin 553) (ho : ∀ v : ℕ → ℂ,
      QuantitativeArithmeticRationalRows.eval v (QuantitativeArithmeticSmallLevelTwentySevenObservation.observation obs)=v r.right) :
    BoundedRow (.matrix r hr obs ho) m f η :=
  QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.original_bounded_row point r hr m hf

theorem boundedRow_ramanujan (m : ℕ) (f : ℕ → ℂ) (η : ℂ)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.BoundedTaylorLaw point m f η)
    (r : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Spec)
    (hr : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Valid point r)
    (obs : Fin 553) (ho : ∀ v : ℕ → ℂ,
      QuantitativeArithmeticRationalRows.eval v (QuantitativeArithmeticSmallLevelTwentySevenObservation.observation obs)=
        QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.sampleEval r.q r.right v) :
    BoundedRow (.ramanujan r hr obs ho) m f η := hlaw r hr

theorem boundedRow_of_entire (r : Source) (m : ℕ) (f : ℕ → ℂ) (η : ℂ)
    (B : ℝ) (E : ℂ → ℂ) (hE : Differentiable ℂ E)
    (hbound : ∀ b : ℝ, BoundedSubstrips b E)
    (hrow : ∀ s : ℂ,B<s.re → row r m f η s=E s)
    (hshift : ∀ n s v, shift r m η n s v=0) : BoundedRow r m f η := by
  refine ⟨B,fun _ => E,fun M => ⟨fun s _ => hE.analyticAt s,hbound _,?_⟩⟩
  intro s hs
  simp only [hshift,Finset.sum_const_zero,add_zero]
  exact hrow s hs

theorem boundedRow_of_zero (r : Source) (m : ℕ) (f : ℕ → ℂ) (η : ℂ)
    (B : ℝ) (hrow : ∀ s : ℂ,B<s.re → row r m f η s=0)
    (hshift : ∀ n s v, shift r m η n s v=0) : BoundedRow r m f η := by
  apply boundedRow_of_entire r m f η B (fun _ => 0) (differentiable_const _) _ hrow hshift
  intro b l u _ _
  exact ⟨0,le_rfl,fun _ _ _ => by simp⟩

theorem boundedRow_old (r : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.Kind)
    (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (η : ℂ)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.BoundedTaylorLaw point m f η) :
    BoundedRow (.old r) m f η := by
  cases r with
  | hecke j hj =>
    obtain ⟨B,hB⟩ := QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.original_hecke_sources hm hf
    exact boundedRow_of_zero _ m f η B (fun s hs => hB s hs j hj) (fun _ _ _ => rfl)
  | matrix j =>
    exact QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.original_bounded_row point _
      (QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.selected_valid
        (QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.matrixIndex j)) m hf
  | ramanujan j =>
    exact hlaw _ (QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.selected_valid
      (QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.ramanujanIndex j))
  | entire j =>
    have hj : QuantitativeArithmeticSmallLevelTwentySevenEntireSource.HasBoundedEntireRow point
        (QuantitativeArithmeticSmallLevelTwentySevenEntireSource.source j) m f := by
      fin_cases j
      · exact QuantitativeArithmeticSmallLevelTwentySevenEntireSource.original_bounded0 m hm hf
      · exact QuantitativeArithmeticSmallLevelTwentySevenEntireSource.original_bounded3 m hm hf
      · exact QuantitativeArithmeticSmallLevelTwentySevenEntireSource.original_bounded14 m hm hf
      · exact QuantitativeArithmeticSmallLevelTwentySevenEntireSource.original_bounded93 m hm hf
      · exact QuantitativeArithmeticSmallLevelTwentySevenEntireSource.original_bounded116 m hm hf
      · exact QuantitativeArithmeticSmallLevelTwentySevenEntireSource.original_bounded129 m hm hf
      · exact QuantitativeArithmeticSmallLevelTwentySevenEntireSource.original_bounded209 m hm hf
      · exact QuantitativeArithmeticSmallLevelTwentySevenEntireSource.original_bounded213 m hm hf
    obtain ⟨B,E,ha,hb,he⟩ := hj
    exact boundedRow_of_entire _ m f η B E ha hb he (fun _ _ _ => rfl)

/-- Finite collections of original bounded rows have one common initial half-plane. -/
theorem bounded_family {ι : Type*} [Fintype ι] [Nonempty ι]
    (source : ι → Source) (m : ℕ) (f : ℕ → ℂ) (η : ℂ)
    (hs : ∀ i, BoundedRow (source i) m f η) :
    ∃ (B : ℝ) (E : ι → ℕ → ℂ → ℂ), ∀ i : ι, ∀ M : ℕ,
      AnalyticOnNhd ℂ (E i M) {s : ℂ | B-((M:ℝ)+1)<s.re} ∧
      BoundedSubstrips (B-((M:ℝ)+1)) (E i M) ∧
      ∀ s : ℂ, B<s.re → row (source i) m f η s=E i M s+∑ n∈Finset.range M,
        ∑ j : Fin 321, coefficient (source i) m η n s j*
          basisValues (fun t => SmallLevelAdditive.original (2*m) f (point t:ℝ) (s+((n+1:ℕ):ℂ))) j := by
  classical
  choose b E hE using hs
  let B : ℝ := Finset.univ.sup' Finset.univ_nonempty b
  have hbB (i : ι) : b i≤B := Finset.le_sup' b (Finset.mem_univ i)
  refine ⟨B,E,?_⟩
  intro i M
  refine ⟨?_,(hE i M).2.1.mono (sub_le_sub_right (hbB i) _),?_⟩
  · intro s hs
    apply (hE i M).1 s
    change B-((M:ℝ)+1)<s.re at hs
    change b i-((M:ℝ)+1)<s.re
    linarith [hbB i]
  · intro s hs
    simp_rw [shift_action]
    exact (hE i M).2.2 s (lt_of_le_of_lt (hbB i) hs)
#print axioms boundedRow_old
#print axioms bounded_family
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
end
