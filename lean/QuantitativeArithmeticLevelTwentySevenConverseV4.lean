def matrixJet (r : QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.Spec) : Poly :=
  lowerRates [(-(QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.entry r.word 1 0:ℚ)*
    QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.denominator point r,
    r.right,(r.e₂,r.e₃,r.e₅,r.e₇,0,0,0))]

def ramanujanJet (ε : ℚ) (r : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Spec)
    (obs : Fin 553) : Poly :=
  lowerRates (shift (-ε*(Nat.lcm 27 (r.q^2):ℚ)*((r.t:ℚ)/(r.Q:ℚ)))
    (r.e₂,r.e₃,r.e₅,r.e₇,0,0,0) (liftRationalRow (observation obs)))

def jetEval (p : Poly) (m : ℕ) (a b c s : ℂ) (v : ℕ → ℂ) : ℂ :=
  eval (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s) a b c v p

theorem matrixJet_physical (r : QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.Spec)
    (m : ℕ) (a b c s : ℂ) (v : ℕ → ℂ) :
    QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.shift point r m 0 (s-1) v=
      -Complex.I*(s-((2*m:ℕ):ℂ))*jetEval (matrixJet r) m a b c s v := by
  rw [matrix_first]
  unfold jetEval matrixJet
  rw [eval_lowerRates]
  simp only [eval_cons,eval_nil,monomial,pow_zero,mul_one,add_zero,Rat.cast_mul,Rat.cast_neg,Rat.cast_intCast]

theorem ramanujanJet_physical (ε : ℚ)
    (r : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Spec)
    (hr : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Valid point r)
    (obs : Fin 553) (m : ℕ) (a b c s : ℂ) (v : ℕ → ℂ)
    (ho : QuantitativeArithmeticRationalRows.eval v (observation obs)=
      QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.sampleEval r.q r.right v) :
    QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.shift r m (ε:ℂ) 0 (s-1) v=
      -Complex.I*(s-((2*m:ℕ):ℂ))*jetEval (ramanujanJet ε r obs) m a b c s v := by
  rw [ramanujan_first point r hr]
  unfold jetEval ramanujanJet
  rw [eval_lowerRates,eval_shift _ _ _ _ _ _ _ _
    (div_ne_zero (primeRate_nonzero 2 m s) (by norm_num))
    (div_ne_zero (primeRate_nonzero 3 m s) (by norm_num))
    (div_ne_zero (primeRate_nonzero 5 m s) (by norm_num))
    (div_ne_zero (primeRate_nonzero 7 m s) (by norm_num)),eval_lift,ho]
  simp only [monomial,pow_zero,mul_one,Rat.cast_mul,Rat.cast_neg,Rat.cast_div,Rat.cast_natCast,Rat.cast_intCast]

#print axioms matrixJet_physical
#print axioms ramanujanJet_physical
end QuantitativeArithmeticSmallLevelTwentySevenFirstTaylor
