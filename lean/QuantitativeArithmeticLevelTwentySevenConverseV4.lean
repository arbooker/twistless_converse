/-! ## TwentySevenObservationsMeromorphic -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 4000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
open Matrix Complex
open QuantitativeArithmeticSmallLevelTwentySevenObservation
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point originalVector)

/-- All321 fixed observations continue meromorphically from the original
Euler and entire-Fricke hypotheses, with no exception for the sign or f₂=0.
This is a continuation theorem, not yet the level27 modularity conclusion. -/
theorem original_observations_meromorphic (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ (B : ℝ) (G : ℂ → Fin 321 → ℂ),
      (∀ i : Fin 321, ∀ x : ℂ, MeromorphicNFAt (fun z => G z i) x) ∧
      ∀ z : ℂ, B<z.re → G z=basisMatrix *ᵥ originalVector m f z := by
  obtain ⟨η,B,error,hη,he,hr⟩ := family_system m hm hf
  have applyChart (selection : Fin 550 → Kind)
      (A : ℂ → Matrix (Fin 550) (Fin 607) ℂ)
      (L : ℂ → Matrix (Fin 321) (Fin 550) ℂ)
      (hL : ∀ x : ℂ, ∀ i : Fin 321, ∀ j : Fin 550, MeromorphicAt (fun z => L z i j) x)
      (BR : ℝ) (hR : ∀ z : ℂ, BR<z.re → L z*A z=basisMatrix)
      (hA : ∀ z : ℂ, A z *ᵥ originalVector m f z=selectedRows selection m f η z) :
      ∃ (B' : ℝ) (G : ℂ → Fin 321 → ℂ),
        (∀ i : Fin 321, ∀ x : ℂ, MeromorphicNFAt (fun z => G z i) x) ∧
        ∀ z : ℂ, B'<z.re → G z=basisMatrix *ᵥ originalVector m f z := by
    exact selected_system_continuation selection m hf η A L hL BR hR hA B
      (fun M s i => error (selection i) M s)
      (fun M i s hs => he (selection i) M s hs)
      (family_selection selection m f η B error hr)
  let a : ℂ := (Real.sqrt 2:ℂ)*f 2
  let b : ℂ := (Real.sqrt 5:ℂ)*f 5
  let c : ℂ := (Real.sqrt 7:ℂ)*f 7
  by_cases hf2 : f 2=0
  · rcases hη with hη|hη
    · subst η
      obtain ⟨BR,hR⟩ := QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physical_reconstruction m a b c
      exact applyChart QuantitativeArithmeticSmallLevelTwentySevenPlusZeroSourceBinding.selection (QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physicalSource m a b c)
        (QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physicalLeft m a b c)
        (fun x i j => QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physical_left_meromorphic _ _ _ _ x i j) BR hR
        (fun z => QuantitativeArithmeticSmallLevelTwentySevenPlusZeroSourceBinding.source_action m f hf2 z)
    · subst η
      obtain ⟨BR,hR⟩ := QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physical_reconstruction m a b c
      exact applyChart QuantitativeArithmeticSmallLevelTwentySevenMinusZeroSourceBinding.selection (QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physicalSource m a b c)
        (QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physicalLeft m a b c)
        (fun x i j => QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physical_left_meromorphic _ _ _ _ x i j) BR hR
        (fun z => QuantitativeArithmeticSmallLevelTwentySevenMinusZeroSourceBinding.source_action m f hf2 z)
  · have ha : a≠0 := mul_ne_zero
      (Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (by norm_num))) hf2
    rcases hη with hη|hη
    · subst η
      obtain ⟨BR,hR⟩ := QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.physical_reconstruction m a b c ha
      exact applyChart kind (QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.physicalSource m a b c)
        (QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.physicalLeft m a b c)
        (fun x i j => QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.physical_left_meromorphic _ _ _ _ x i j) BR hR
        (fun z => (originalRows_one m f z).symm)
    · subst η
      obtain ⟨BR,hR⟩ := QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physical_reconstruction m a b c ha
      exact applyChart QuantitativeArithmeticSmallLevelTwentySevenMinusGenericSourceBinding.selection (QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physicalSource m a b c)
        (QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physicalLeft m a b c)
        (fun x i j => QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physical_left_meromorphic _ _ _ _ x i j) BR hR
        (fun z => QuantitativeArithmeticSmallLevelTwentySevenMinusGenericSourceBinding.source_action m f z)
#print axioms original_observations_meromorphic
end QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
end
end

/-! ## TwentySevenPlusGenericAnalytic -/
section
