/-! ## TwentySevenPoleALiftPlusPhysical -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_analytic primeRate_nonzero)

def exceptionalPolynomial (x z w a b c : ℂ) : ℂ :=
  -2*a^2*x^4-4*a^2*x^2+a*b*x*z-a*x^5+4*a*x^3+a*x*z^2+3*a*x+
    b*x^4*z-2*b*z+c*w-w^2+x^6+x^4*z^2+x^4-2*z^2+1

def physicalLeft (κ : ℝ) (a b c : ℂ) (s : ℂ) : Matrix (Fin 321) (Fin 550) ℂ :=
  stagedLeftMatrix (primeRate 2 κ s) (primeRate 3 κ s) (primeRate 5 κ s) (primeRate 7 κ s) a b c

def physicalSource (κ : ℝ) (a b c : ℂ) (s : ℂ) : Matrix (Fin 550) (Fin 607) ℂ :=
  sourceMatrix (primeRate 2 κ s) (primeRate 3 κ s) (primeRate 5 κ s) (primeRate 7 κ s) a b c

def physicalPivot (κ : ℝ) (a b c : ℂ) (i : Fin 871) (s : ℂ) : ℂ :=
  stageLead (primeRate 2 κ s) (primeRate 3 κ s) (primeRate 5 κ s) (primeRate 7 κ s) a b c i.val

theorem physical_left_meromorphic (κ : ℝ) (a b c : ℂ) (s : ℂ) (i : Fin 321) (j : Fin 550) :
    MeromorphicAt (fun t => physicalLeft κ a b c t i j) s :=
  staged_left_meromorphic _ _ _ _ _ _ _ s
    (primeRate_analytic 2 κ s).meromorphicAt (primeRate_analytic 3 κ s).meromorphicAt
    (primeRate_analytic 5 κ s).meromorphicAt (primeRate_analytic 7 κ s).meromorphicAt
    (MeromorphicAt.const a s) (MeromorphicAt.const b s) (MeromorphicAt.const c s) i j

theorem physical_pivot_analytic (κ : ℝ) (a b c : ℂ) (i : Fin 871) (s : ℂ) :
    AnalyticAt ℂ (physicalPivot κ a b c i) s :=
  coefficient_analytic (primeRate 2 κ) (primeRate 3 κ) (primeRate 5 κ) (primeRate 7 κ)
    a b c s (primeRate_analytic 2 κ s) (primeRate_analytic 3 κ s)
    (primeRate_analytic 5 κ s) (primeRate_analytic 7 κ s)
    (primeRate_nonzero 2 κ s) (primeRate_nonzero 3 κ s)
    (primeRate_nonzero 5 κ s) (primeRate_nonzero 7 κ s) (certificate i.val) (550+i.val)

theorem physical_reconstruction (κ : ℝ) (a b c s : ℂ)
    (hp : ∀ i : Fin 871, physicalPivot κ a b c i s≠0) :
    physicalLeft κ a b c s*physicalSource κ a b c s=
      QuantitativeArithmeticSmallLevelTwentySevenObservation.basisMatrix := by
  apply staged_basis_reconstruction _ _ _ _ a b c
    (primeRate_nonzero 2 κ s) (primeRate_nonzero 3 κ s)
    (primeRate_nonzero 5 κ s) (primeRate_nonzero 7 κ s)
  intro n hn
  exact hp ⟨n,hn⟩

theorem physical_left_analytic (κ : ℝ) (a b c s : ℂ)
    (hp : ∀ i : Fin 871, physicalPivot κ a b c i s≠0) (i : Fin 321) (j : Fin 550) :
    AnalyticAt ℂ (fun t => physicalLeft κ a b c t i j) s := by
  apply staged_left_analytic (primeRate 2 κ) (primeRate 3 κ) (primeRate 5 κ) (primeRate 7 κ) a b c s
    (primeRate_analytic 2 κ s) (primeRate_analytic 3 κ s)
    (primeRate_analytic 5 κ s) (primeRate_analytic 7 κ s)
    (primeRate_nonzero 2 κ s) (primeRate_nonzero 3 κ s)
    (primeRate_nonzero 5 κ s) (primeRate_nonzero 7 κ s) _ i j
  intro n hn
  exact hp ⟨n,hn⟩

theorem physical_pivots_nonzero (κ : ℝ) (a b c s : ℂ)
    (ha : a≠0) (hm : primeRate 2 κ s-1≠0) (hp : primeRate 2 κ s+1≠0)
    (hq : exceptionalPolynomial (primeRate 2 κ s) (primeRate 5 κ s) (primeRate 7 κ s) a b c≠0)
    (i : Fin 871) : physicalPivot κ a b c i s≠0 :=
  all_leading_nonzero _ _ _ _ a b c
    (primeRate_nonzero 2 κ s) (primeRate_nonzero 3 κ s)
    (primeRate_nonzero 5 κ s) (primeRate_nonzero 7 κ s) ha hm hp hq i.val i.isLt
#print axioms physical_reconstruction
#print axioms physical_left_analytic
#print axioms physical_pivots_nonzero
