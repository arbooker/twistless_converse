theorem source_action (m : ℕ) (f : ℕ → ℂ) (hf2 : f 2=0) (s : ℂ) :
    QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physicalSource m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5)
