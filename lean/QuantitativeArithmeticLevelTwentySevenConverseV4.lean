  exact QuantitativeArithmeticFiniteRangeCertificates.block_join (fun n => (QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages.inputs n).all (fun t => decide (t.2.1<607))=true) selectionNode17_26_support selectionNode26_35_support n hl hh
