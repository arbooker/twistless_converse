section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
open Filter
open scoped Topology

theorem PoleSystem.germ_eq {m : ℕ} {f : ℕ→ℂ} (S T : PoleSystem m f)
    (x : ℂ) (i : Fin 321) :
    (fun z => S.G z i)=ᶠ[𝓝[≠] x] (fun z => T.G z i) := by
  apply SmallLevelContinuation.halfplane_germ_identity (x.re-1) (max S.B T.B)
  · intro z _
    exact (S.meromorphic i z).meromorphicAt
  · intro z _
    exact (T.meromorphic i z).meromorphicAt
  · intro z hz
    exact congrFun ((S.agreement z (lt_of_le_of_lt (le_max_left _ _) hz)).trans
      (T.agreement z (lt_of_le_of_lt (le_max_right _ _) hz)).symm) i
  · linarith

theorem PoleSystem.order_eq {m : ℕ} {f : ℕ→ℂ} (S T : PoleSystem m f)
    (x : ℂ) (i : Fin 321) :
    meromorphicOrderAt (fun z => S.G z i) x=meromorphicOrderAt (fun z => T.G z i) x :=
  meromorphicOrderAt_congr (S.germ_eq T x i)

#print axioms PoleSystem.germ_eq
#print axioms PoleSystem.order_eq
end QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
end
end

/-! ## TwentySevenObservationPoleBound -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
open Filter Matrix
open QuantitativeArithmeticAnalyticGerm (HasAnalyticGerm)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages
open QuantitativeArithmeticSmallLevelTwentySevenPoleSource (firstQuadratic)

/-- The same quadratic annihilates all observed polar germs on the anchored
chart. This uses the actual analytic reconstruction coefficients, with
the eigenvalues fixed, rather than a pointwise specialized kernel. -/
theorem observed_quadratic_germs (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f)
    (x : ℂ) (hx : liftRegularPoint m f x)
    (hshift : ∀ n : ℕ, 0<n → ∀ i,
      0≤meromorphicOrderAt (fun z => S.G z i) (x+n)) :
    ∀ i, HasAnalyticGerm (fun z => firstQuadratic m f z*S.G z i) x := by
  have hA := quadratic_germ_for_continuation m hm hf S.B S.G
    S.meromorphic S.agreement x hshift
  obtain ⟨J,hJ,hR⟩ := lift_anchor_for_continuation m hm hf S.B S.G
    S.meromorphic S.agreement x hx hshift
  have hD : AnalyticAt ℂ (firstQuadratic m f) x :=
    ((analyticAt_const.mul (primeRate_analytic 2 m x)).add
      ((primeRate_analytic 2 m x).pow 2)).sub analyticAt_const
  intro i
  apply (((hR i).mul_analytic hD).add (hA.mul_analytic (hJ i))).congr
  filter_upwards [] with z
  ring

theorem original_observation_pole_bound (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f,
      ∀ x : ℂ, liftRegularPoint m f x →
      (∀ n : ℕ, 0<n → ∀ i,
        0≤meromorphicOrderAt (fun z => S.G z i) (x+n)) →
      ∀ i, (-2 : WithTop ℤ)≤meromorphicOrderAt (fun z => S.G z i) x := by
  obtain ⟨S⟩ := QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.original_pole_system m hm hf
  refine ⟨S,fun x hx hs i => ?_⟩
  exact QuantitativeArithmeticQuadraticGermOrder.pole_order_ge_neg_two
    (primeRate_analytic 2 m x) (primeRate_two_deriv_ne_zero m x)
    ((Real.sqrt 2:ℂ)*f 2) (S.meromorphic i x).meromorphicAt
    (observed_quadratic_germs m hm hf S x hx hs i)

#print axioms observed_quadratic_germs
#print axioms original_observation_pole_bound
end QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
end
end

