/-- At f2=0 every highest observable pole is excluded, including the
unit-rate boundary and the weight point. -/
theorem highest_regular (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (hf2 : f 2=0) (s : ℂ)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z j) (s+n)) :
    ∀ i, 0≤meromorphicOrderAt (fun z => S.G z i) s := by
  by_cases hx : (primeRate 2 m s)^2=1 ∨ (primeRate 2 m s)^2= -1
  · obtain ⟨hs,hz⟩ := boundary_rates m hm s hx
    obtain ⟨η,hη,hlaw⟩ := QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.original_taylor_law QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m hf
    have hc := divisor_cover (primeRate 2 m s) (primeRate 5 m s) ((Real.sqrt 5:ℂ)*f 5) hx hz
    rcases hη with rfl|rfl
    · rcases hc with hc|hc
      · intro i
        exact (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlus.original_regular m hm hf hf2 hlaw S s hs
          (common_factors _ _ _ _ _ hx (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s) hc) hshift i).meromorphicOrderAt_nonneg
      · intro i
        exact (QuantitativeArithmeticSmallLevelTwentySevenZeroJetSecondPlus.original_regular m hm hf hf2 hlaw S s hs
          (second_factors _ _ _ _ _ hx (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s) hc) hshift i).meromorphicOrderAt_nonneg
    · rcases hc with hc|hc
      · intro i
        exact (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonMinus.original_regular m hm hf hf2 hlaw S s hs
          (common_minus_factors _ _ _ _ _ hx (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s) hc) hshift i).meromorphicOrderAt_nonneg
      · intro i
        exact (QuantitativeArithmeticSmallLevelTwentySevenZeroJetSecondMinus.original_regular m hm hf hf2 hlaw S s hs
          (second_minus_factors _ _ _ _ _ hx (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s) hc) hshift i).meromorphicOrderAt_nonneg
  · have hminus : primeRate 2 m s-1≠0 := by
      intro h
      apply hx
      exact Or.inl (by rw [sub_eq_zero.mp h]; norm_num)
    have hplus : primeRate 2 m s+1≠0 := by
      intro h
      apply hx
      exact Or.inl (by rw [eq_neg_of_add_eq_zero_left h]; norm_num)
    have hsq : (primeRate 2 m s)^2+1≠0 := by
      intro h
      exact hx (Or.inr (eq_neg_of_add_eq_zero_left h))
    have hr : regularPoint m f s := by
      simpa only [regularPoint,ite_eq_left hf2] using And.intro hminus (And.intro hplus hsq)
    intro i
    exact (S.regular_at s hr hshift i).meromorphicOrderAt_nonneg
#print axioms highest_regular
end QuantitativeArithmeticSmallLevelTwentySevenZeroLocalPoleRule
end
