/-! ## TwentySevenSecondSShiftPlusJetPhysical -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 3000000
set_option synthInstance.maxSize 2048
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSecondSShiftPlus
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentySevenSecondSSource
open QuantitativeArithmeticSmallLevelTwentySevenFirstTaylor (jetEval)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_nonzero)

theorem rightCertificate_split : rightCertificate=certificate++[(-1,79,(0,0,0,0,0,0,0))] := by decide +kernel

theorem weighted_jet_value (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (v : ℕ → ℂ) :
    (∑ i : Fin 79, weights m f s i*
      jetEval (jetPolynomial 1 (typedSelection i)) m
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) s v)=
    jetEval (rightInputs 79) m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) s v := by
  have h := right_zero (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) v
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)
  rw [rightCertificate_split,eval_append] at h
  simp only [eval_cons,eval_nil,monomial,pow_zero,zpow_zero,mul_one,Rat.cast_neg,Rat.cast_one,neg_mul,one_mul,add_zero] at h
  rw [eval_bounded_eq_sum _ _ _ _ _ _ _ _ _ certificate_support] at h
  simp_rw [right_source_binding,eval_normalizeBalancedFuel] at h
  change (∑ i : Fin 79, weights m f s i*jetEval (jetPolynomial 1 (typedSelection i)) m _ _ _ s v)-jetEval (rightInputs 79) m _ _ _ s v=0 at h
  exact sub_eq_zero.mp h

theorem weighted_first_shift_value (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (v : ℕ → ℂ) :
    (∑ i : Fin 79, weights m f s i*sourceShift (typedSelection i) m 1 0 (s-1) v)=
      -Complex.I*(s-((2*m:ℕ):ℂ))*jetEval (rightInputs 79) m
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) s v := by
  have he (i : Fin 79) := jetPolynomial_physical (1:ℚ) (typedSelection i) m
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) s v
  simp only [Rat.cast_one] at he
  simp_rw [he]
  rw [← weighted_jet_value m f s v,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  ring
#print axioms weighted_jet_value
#print axioms weighted_first_shift_value
end QuantitativeArithmeticSmallLevelTwentySevenSecondSShiftPlus
end
end

