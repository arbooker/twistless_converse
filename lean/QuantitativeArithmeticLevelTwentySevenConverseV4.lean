/-! ## TwentySevenGeneralGrowthSystem -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGeneralGrowth
open Matrix QuantitativeArithmeticMellinStrip QuantitativeArithmeticVerticalBounded
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticSmallLevelTwentySevenObservedSourceChart (Chart)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate quadratic_bounded)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point)

/-- A bounded original reconstruction system with a single quadratic
clearing divisor. The growth of the continued observations is NOT an input. -/
structure GrowthSystem (d : ℕ) (D : ℂ → ℂ) (m : ℕ) (f : ℕ → ℂ) (S : PoleSystem m f) where
  η : ℂ
  η_sign : η=1 ∨ η= -1
  selection : Fin d → Source
  L : ℂ → Matrix (Fin 321) (Fin d) ℂ
  B : ℝ
  E : Fin d → ℕ → ℂ → ℂ
  error_analytic : ∀ i (n : ℕ),AnalyticOnNhd ℂ (E i n) {s : ℂ | B-((n:ℝ)+1)<s.re}
  error_bounded : ∀ i (n : ℕ),BoundedSubstrips (B-((n:ℝ)+1)) (E i n)
  power : ℕ
  power_pos : 0<power
  numerator : (Fin 321 × Fin d) → ℂ → ℂ
  numerator_bounded : ∀ i,Bounded (numerator i)
  cleared : ∀ i s,D s≠0 → L s i.1 i.2=numerator i s/(D s)^power
  rows : ∀ (n : ℕ) (s : ℂ),B-((n:ℝ)+1)<s.re → s.im≠0 → D s≠0 →
    S.G s=L s *ᵥ (fun i => E i n s)+∑ a∈Finset.range n,
      (L s * Matrix.of (fun i j => coefficient (selection i) m η a s j)) *ᵥ S.G (s+((a:ℂ)+1))

theorem of_chart (d r : ℕ) [NeZero d] (D : ℂ → ℂ) (hD : Bounded D) (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (η : ℂ) (hη : η=1 ∨ η= -1) (C : Chart d r m f η)
    (hb : ∀ i,BoundedRow (C.selection i) m f η)
    (hp : ∀ s,D s≠0 → ∀ t,C.pivot t s≠0)
    (hc : ∀ i j,Cleared (D) (fun s => C.L s i j)) :
    Nonempty (GrowthSystem d D m f S) := by
  obtain ⟨B,E,hE,hrow⟩ := QuantitativeArithmeticSmallLevelTwentySevenObservedSourceChart.bounded_reconstruction S η C hb
  obtain ⟨n,A,hn,hA,he⟩ := Cleared.uniform_positive hD
    (fun i : Fin 321 × Fin d => fun s => C.L s i.1 i.2) (fun i => hc i.1 i.2)
  refine ⟨{
    η := η
    η_sign := hη
    selection := C.selection
    L := C.L
    B := B
    E := E
    error_analytic := fun i n => (hE i n).1
    error_bounded := fun i n => (hE i n).2
    power := n
    power_pos := hn
    numerator := A
    numerator_bounded := hA
    cleared := he
    rows := ?_ }⟩
  intro n s hs hi hd
  apply hrow n s hs (hp s hd)
  intro q _ j
  apply (QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule.pole_orders m hm hf S).2 _ _ j
  intro h
  apply hi
  have hh := congrArg Complex.im h
  simpa only [Complex.add_im,Complex.natCast_im,add_zero] using hh

end QuantitativeArithmeticSmallLevelTwentySevenGeneralGrowth
end
end

/-! ## TwentySevenGeneralClearedRows -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGeneralGrowth
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily

theorem GrowthSystem.cleared_rows {d : ℕ} {D : ℂ → ℂ} {m : ℕ} {f : ℕ → ℂ} {S : PoleSystem m f}
    (R : GrowthSystem d D m f S) (n : ℕ) (s : ℂ)
    (hs : R.B-((n:ℝ)+1)<s.re) (hi : s.im≠0) (hd : D s≠0)
    (i : Fin 321) :
    D s^R.power*S.G s i=
      ∑ j : Fin d,R.numerator (i,j) s*R.E j n s+
      ∑ a∈Finset.range n,∑ j : Fin d,∑ t : Fin 321,
        R.numerator (i,j) s*coefficient (R.selection j) m R.η a s t*S.G (s+((a:ℂ)+1)) t := by
  have hc (j : Fin d) : D s^R.power*R.L s i j=R.numerator (i,j) s := by
    rw [R.cleared (i,j) s hd]
    field_simp
  have hr := congrFun (R.rows n s hs hi hd) i
  rw [hr]
  simp only [Pi.add_apply,Finset.sum_apply,Matrix.mulVec,Matrix.mul_apply,Matrix.of_apply,
    dotProduct,mul_add,Finset.mul_sum,Finset.sum_mul]
  simp only [← mul_assoc,hc]
  congr 1
  apply Finset.sum_congr rfl
  intro a _
  rw [Finset.sum_comm]

#print axioms GrowthSystem.cleared_rows
end QuantitativeArithmeticSmallLevelTwentySevenGeneralGrowth
end
end

/-! ## TwentySevenGeneralGrowthTail -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGeneralGrowth
open Complex Set Matrix QuantitativeArithmeticVerticalBounded
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily

theorem GrowthSystem.cleared_tail {d : ℕ} {D : ℂ → ℂ} {m : ℕ} {f : ℕ → ℂ} {S : PoleSystem m f}
    (R : GrowthSystem d D m f S) (H : Fin 321 → ℂ → ℂ)
    (he : ∀ i s,s≠((2*m:ℕ):ℂ) → H i s=(s-((2*m:ℕ):ℂ))*S.G s i)
    (b : ℝ) (hH : ∀ i,PolynomialSubstrips b (H i))
    (l u : ℝ) (hl : b-1<l) (hu : b-1<u) (i : Fin 321) :
    PolynomialOn ({s : ℂ | l≤s.re ∧ s.re≤u ∧ 1≤|s.im|} ∩
      {s : ℂ | D s≠0})
      (fun s => D s^R.power*H i s) := by
  let T : Set ℂ := {s : ℂ | l≤s.re ∧ s.re≤u ∧ 1≤|s.im|} ∩
    {s : ℂ | D s≠0}
  have hT : T⊆{s : ℂ | l≤s.re ∧ s.re≤u} := fun s hs => ⟨hs.1.1,hs.1.2.1⟩
  obtain ⟨n,hn⟩ := exists_nat_gt (R.B-min l u)
  have hn_l : R.B-((n:ℝ)+1)<l := by have hh := min_le_left l u; linarith
  have hn_u : R.B-((n:ℝ)+1)<u := by have hh := min_le_right l u; linarith
  have hnum (j : Fin d) : PolynomialOn T (R.numerator (i,j)) :=
    ((R.numerator_bounded (i,j)).stripPolynomial l u).mono hT
  have herr (j : Fin d) : PolynomialOn T (R.E j n) :=
    (boundedSubstrips_polynomial (R.error_bounded j n) l u hn_l hn_u).mono hT
  have hg (a : ℕ) (t : Fin 321) : PolynomialOn T (fun s => S.G (s+((a:ℂ)+1)) t) := by
    have hr : ∀ s : ℂ,s≠(((2*m:ℕ):ℝ):ℂ) → H t s=(s-(((2*m:ℕ):ℝ):ℂ))*S.G s t := by
      simpa only [Complex.ofReal_natCast] using he t
    have hh := regularized_shift_polynomial (((2*m:ℕ):ℝ)) hr (hH t) ((a:ℝ)+1)
      (by linarith [Nat.cast_nonneg (α:=ℝ) a] : b<l+((a:ℝ)+1))
      (by linarith [Nat.cast_nonneg (α:=ℝ) a] : b<u+((a:ℝ)+1))
    simpa only [Complex.ofReal_add,Complex.ofReal_natCast,Complex.ofReal_one] using
      hh.mono (fun s hs => hs.1 : T⊆{s : ℂ | l≤s.re ∧ s.re≤u ∧ 1≤|s.im|})
  have hcoef (a : ℕ) (j : Fin d) (t : Fin 321) :
      PolynomialOn T (fun s => coefficient (R.selection j) m R.η a s t) :=
    (coefficient_stripPolynomial (R.selection j) m R.η a t l u).mono hT
  have hfirst := PolynomialOn.sum Finset.univ
    (fun j : Fin d => fun s => R.numerator (i,j) s*R.E j n s)
    (fun j _ => (hnum j).mul (herr j))
  have hrest := PolynomialOn.sum (Finset.range n)
    (fun a => fun s => ∑ j : Fin d,∑ t : Fin 321,
      R.numerator (i,j) s*coefficient (R.selection j) m R.η a s t*S.G (s+((a:ℂ)+1)) t)
    (fun a _ => PolynomialOn.sum Finset.univ _ (fun j _ =>
      PolynomialOn.sum Finset.univ _ (fun t _ => ((hnum j).mul (hcoef a j t)).mul (hg a t))))
  have hweight := (PolynomialGrowth.id.sub (PolynomialGrowth.const ((2*m:ℕ):ℂ))).onSet T
  apply (hweight.mul (hfirst.add hrest)).congr
  intro s hs
  have hi : s.im≠0 := by
    intro hh
    have hh' := hs.1.2.2
    rw [hh,abs_zero] at hh'
    norm_num at hh'
  have hk : s≠((2*m:ℕ):ℂ) := by
    intro hh
    apply hi
    rw [hh,Complex.natCast_im]
  dsimp only
  rw [← R.cleared_rows n s (hn_l.trans_le hs.1.1) hi hs.2 i,he i s hk]
  ring
#print axioms GrowthSystem.cleared_tail
end QuantitativeArithmeticSmallLevelTwentySevenGeneralGrowth
end
end

/-! ## TwentySevenInitialStripBound -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
open Matrix QuantitativeArithmeticMellinStrip
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point originalVector)

theorem PoleSystem.initial_bounded {m : ℕ} {f : ℕ → ℂ} (S : PoleSystem m f)
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ B : ℝ,∀ i : Fin 321,BoundedSubstrips B (fun s => S.G s i) := by
  obtain ⟨B,hB⟩ := SmallLevelAdditive.original_bounded_halfplane hf
  refine ⟨max B S.B,?_⟩
  intro i l u hl hu
  have hj (j : Fin 607) := hB (point j) l u
    ((le_max_left _ _).trans_lt hl) ((le_max_left _ _).trans_lt hu)
  choose C hC hc using hj
  refine ⟨∑ j : Fin 607,‖basisMatrix i j‖*C j,Finset.sum_nonneg (fun j _ => mul_nonneg (norm_nonneg _) (hC j)),?_⟩
  intro s hsl hsu
  dsimp only
  rw [S.agreement s (((le_max_right _ _).trans_lt hl).trans_le hsl)]
  change ‖∑ j : Fin 607,basisMatrix i j*SmallLevelAdditive.original (2*m) f (point j:ℝ) s‖≤_
  apply (norm_sum_le _ _).trans
  apply Finset.sum_le_sum
  intro j _
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left (hc j s hsl hsu) (norm_nonneg _)
#print axioms PoleSystem.initial_bounded
end QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
