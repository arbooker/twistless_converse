section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentySevenObservation (observation)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_nonzero)
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (physicalEval eval_lift)

def ramanujanPoly : Fin 4 → Poly := ![extraPoly0,extraPoly1,extraPoly10,extraPoly11]

theorem ramanujan_poly_row (x y z w a b c : ℂ) (v : ℕ → ℂ) (i : Fin 4) :
    eval x y z w a b c v (ramanujanPoly i)=
      QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.formalLeading (ramanujanSpec i) x y z w 1 v := by
  fin_cases i
  · exact extraRow0 x y z w a b c v
  · exact extraRow1 x y z w a b c v
  · exact extraRow10 x y z w a b c v
  · exact extraRow11 x y z w a b c v

theorem ramanujan_plus_physical (i : Fin 4) (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    physicalEval (ramanujanPoly i) m f s=
      QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.leading (ramanujanSpec i) m 1 s
        (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) s) := by
  unfold physicalEval
  rw [ramanujan_poly_row]
  exact (QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.physical_leading point (ramanujanSpec i) (ramanujan_valid i) m 1 s _).symm

def ramanujanSignedPoly (ε : ℚ) (i : Fin 4) : Poly :=
  if ε=1 then ramanujanPoly i else
    mergeFuel 20000 (ramanujanPoly i)
      (shift (1-ε) ((ramanujanSpec i).e₂,(ramanujanSpec i).e₃,(ramanujanSpec i).e₅,(ramanujanSpec i).e₇,0,0,0)
        (liftRationalRow (observation (ramanujanObservation i))))

theorem ramanujan_signed_physical (ε : ℚ) (i : Fin 4) (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    physicalEval (ramanujanSignedPoly ε i) m f s=
      QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.leading (ramanujanSpec i) m (ε:ℂ) s
        (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) s) := by
  by_cases he : ε=1
  · subst ε
    simpa only [ramanujanSignedPoly,ite_true,Rat.cast_one] using ramanujan_plus_physical i m f s
  · unfold physicalEval
    rw [ramanujanSignedPoly,ite_eq_right he]
    rw [eval_mergeFuel,eval_shift _ _ _ _ _ _ _ _
      (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s)
      (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s),eval_lift]
    rw [ramanujan_poly_row,ramanujan_observed]
    rw [QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.physical_leading point (ramanujanSpec i) (ramanujan_valid i) m ε s]
    simp only [QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.formalLeading,monomial,pow_zero,mul_one,Rat.cast_sub,Rat.cast_one]
    ring
end QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource

namespace QuantitativeArithmeticSmallLevelTwentySevenPoleSource
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (physicalEval)
open QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource (heckePoly ramanujanSignedPoly extraPoly2)

def sourcePolynomial (ε : ℚ) (r : Kind) : Poly :=
  match r with
  | .old t => QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.signedPoly ε t
  | .hecke i => heckePoly i
  | .ramanujan i => ramanujanSignedPoly ε i
  | .entire => extraPoly2

theorem sourcePolynomial_physical (ε : ℚ) (r : Kind) (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    physicalEval (sourcePolynomial ε r) m f s=sourceRow r m f (ε:ℂ) s := by
  cases r with
  | old t => exact QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.physical_signed ε t m f s
  | hecke i => rfl
  | entire => rfl
  | ramanujan i => exact QuantitativeArithmeticSmallLevelTwentySevenPoleExtraSource.ramanujan_signed_physical ε i m f s
#print axioms sourcePolynomial_physical
end QuantitativeArithmeticSmallLevelTwentySevenPoleSource
