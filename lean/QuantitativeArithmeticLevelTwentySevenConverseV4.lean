theorem PoleSystem.analytic_halfplane {m : ℕ} {f : ℕ → ℂ} (S : PoleSystem m f)
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ B : ℝ, ∀ i : Fin 321, ∀ s : ℂ, B<s.re → AnalyticAt ℂ (fun z => S.G z i) s := by
  obtain ⟨B,hB⟩ := QuantitativeArithmeticSmallLevelTwentySevenShiftSource.original_basis_analytic m hf
  refine ⟨max B S.B,?_⟩
  intro i s hs
  have hS : S.B<s.re := lt_of_le_of_lt (le_max_right _ _) hs
  have he : (fun z => S.G z i)=ᶠ[𝓝 s] (fun z => (basisMatrix *ᵥ originalVector m f z) i) := by
    filter_upwards [(isOpen_lt continuous_const Complex.continuous_re).mem_nhds hS] with z hz
    exact congrFun (S.agreement z hz) i
  exact (analyticAt_congr he).mpr (hB i s (lt_of_le_of_lt (le_max_left _ _) hs))
#print axioms PoleSystem.analytic_halfplane
end QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
