      ((Real.sqrt 7:ℂ)*f 7) s *ᵥ originalVector m f s) i=
      physicalEval (QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.inputs i.val) m f s := by
    simpa only [QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physicalSource,QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.sourceMatrix,physicalEval,originalVector,
      QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.primeRate,QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate,Matrix.mulVec,dotProduct] using
      (eval_bounded_eq_sum (QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.primeRate 2 m s) (QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.primeRate 3 m s)
        (QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.primeRate 5 m s) (QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.primeRate 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
        (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) s)
        (QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.inputs i.val) (input_support i)).symm
  rw [hv,input_binding]
