/-! ## TwentySevenBoundedReconstruction -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenObservedSourceChart
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point originalVector)
open QuantitativeArithmeticSmallLevelTwentySevenShiftSource (basisValues_original)
open QuantitativeArithmeticMellinStrip

/-- The original bounded remainders and the short reconstruction matrix give
pointwise continued identities, suitable for vertical growth estimates. -/
theorem bounded_reconstruction {d r m : ℕ} [NeZero d] {f : ℕ → ℂ}
    (S : PoleSystem m f) (η : ℂ) (C : Chart d r m f η)
    (hbounded : ∀ i,BoundedRow (C.selection i) m f η) :
    ∃ (B : ℝ) (E : Fin d → ℕ → ℂ → ℂ),
      (∀ i n,AnalyticOnNhd ℂ (E i n) {z : ℂ | B-((n:ℝ)+1)<z.re} ∧
        BoundedSubstrips (B-((n:ℝ)+1)) (E i n)) ∧
      ∀ (n : ℕ) (x : ℂ),B-((n:ℝ)+1)<x.re → (∀ t,C.pivot t x≠0) →
        (∀ q : ℕ,0<q → ∀ j : Fin 321,0≤meromorphicOrderAt (fun z => S.G z j) (x+q)) →
        S.G x=C.L x *ᵥ (fun i => E i n x)+∑ a∈Finset.range n,
          (C.L x * Matrix.of (fun i j => coefficient (C.selection i) m η a x j)) *ᵥ S.G (x+((a:ℂ)+1)) := by
  obtain ⟨B0,E,hE⟩ := bounded_family C.selection m f η hbounded
  let B := max B0 S.B
  have hB0 : B0 ≤ B := le_max_left _ _
  have hBG : S.B ≤ B := le_max_right _ _
  let K : ℕ → ℂ → Matrix (Fin d) (Fin 321) ℂ :=
    fun n z i j => coefficient (C.selection i) m η n z j
  let error : ℕ → ℂ → Fin d → ℂ := fun n z i => E i n z
  have hrow (n : ℕ) (z : ℂ) (hz : B < z.re) (hpz : ∀ t, C.pivot t z ≠ 0) :
      S.G z=C.L z *ᵥ error n z+
        ∑ j∈Finset.range n, (C.L z*K j z) *ᵥ S.G (z+((j:ℂ)+1)) := by
    have h : C.A z *ᵥ originalVector m f z=error n z+
        ∑ j∈Finset.range n, K j z *ᵥ (basisMatrix *ᵥ originalVector m f (z+((j:ℂ)+1))) := by
      rw [C.source_action]
      funext t
      simpa only [K,error,Pi.add_apply,Finset.sum_apply,Matrix.mulVec,dotProduct,
        basisValues_original,Nat.cast_add,Nat.cast_one] using (hE t n).2.2 z (lt_of_le_of_lt hB0 hz)
    have hl := congrArg (fun v => C.L z *ᵥ v) h
    simp only [Matrix.mulVec_add,Matrix.mulVec_sum,Matrix.mulVec_mulVec] at hl
    rw [C.reconstruction z hpz] at hl
    rw [S.agreement z (lt_of_le_of_lt hBG hz),hl]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    have hs : S.B < (z+((j:ℂ)+1)).re := by
      simp only [Complex.add_re,Complex.natCast_re,Complex.one_re]
      linarith [Nat.cast_nonneg (α:=ℝ) j]
    rw [S.agreement _ hs]
    simp only [Matrix.mulVec_mulVec,Matrix.mul_assoc]
  refine ⟨B,E,?_,?_⟩
  · intro i n
    refine ⟨?_,(hE i n).2.1.mono (sub_le_sub_right hB0 _)⟩
    intro z hz
    apply (hE i n).1 z
    change B0-((n:ℝ)+1)<z.re
    change B-((n:ℝ)+1)<z.re at hz
    linarith
  · intro n x hx hp hshift
    funext i
    have hv := QuantitativeArithmeticLocalPoleReconstruction.value_at B S.G C.L K error
      C.pivot n x hx S.meromorphic C.left_meromorphic (C.left_analytic x hp)
      (fun n z t j => coefficient_analytic (C.selection t) m η n z j)
      (by
        intro n t z hz
        apply (hE t n).1 z
        change B0-((n:ℝ)+1)<z.re
        linarith)
      C.pivot_analytic hp hrow hshift i
    simpa only [K,error,Pi.add_apply,Finset.sum_apply,Matrix.mulVec,dotProduct,Matrix.mul_apply,Matrix.of_apply] using hv
#print axioms bounded_reconstruction
end QuantitativeArithmeticSmallLevelTwentySevenObservedSourceChart
end
end

/-! ## TwentySevenFourthTopProfileGerm -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticAnalyticGerm
open QuantitativeArithmeticTaylorLayerNormalization
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_resonance_layer)
open QuantitativeArithmeticSmallLevelTwentySevenShiftSource (basisValues)

def topCoefficient (r : Source) (ε : ℚ) (m d : ℕ) (s : ℂ) (j : Fin 321) : ℂ :=
  coefficient r m (ε:ℂ) (d-1) (s-(d:ℂ)) j/scale (s-((2*m:ℕ):ℂ)) d

theorem topCoefficient_analytic (r : Source) (ε : ℚ) (m d : ℕ) (s : ℂ) (j : Fin 321)
    (hs : scale (s-((2*m:ℕ):ℂ)) d≠0) :
    AnalyticAt ℂ (fun z => topCoefficient r ε m d z j) s :=
  ((coefficient_analytic r m (ε:ℂ) (d-1) (s-(d:ℂ)) j).comp
    (f:=fun z : ℂ => z-(d:ℂ)) (analyticAt_id.sub analyticAt_const)).div
      (layer_scale_analytic (2*m) d s) hs

theorem topCoefficient_meromorphic (r : Source) (ε : ℚ) (m d : ℕ) (s : ℂ) (j : Fin 321) :
    MeromorphicAt (fun z => topCoefficient r ε m d z j) s :=
  (((coefficient_analytic r m (ε:ℂ) (d-1) (s-(d:ℂ)) j).comp
    (f:=fun z : ℂ => z-(d:ℂ)) (analyticAt_id.sub analyticAt_const)).meromorphicAt).div
      (layer_scale_analytic (2*m) d s).meromorphicAt

theorem physical_topVector_resonance (profile : ℕ → ℚ) (m : ℕ) :
    topVector profile (primeRate 2 m ((m:ℂ)+1)) (primeRate 3 m ((m:ℂ)+1))
      (primeRate 5 m ((m:ℂ)+1)) (primeRate 7 m ((m:ℂ)+1))=(fun j => (profile j:ℂ)) := by
  have h (p : ℝ) (hp : 0 < p) : primeRate p m ((m:ℂ)+1)=(p:ℂ) := by
    simpa using primeRate_resonance_layer p hp m 0
  rw [h 2 (by norm_num),h 3 (by norm_num),h 5 (by norm_num),h 7 (by norm_num)]
  exact topVector_resonance profile

theorem topScalar_residue_match (r : Source) (ε : ℚ) (profile : ℕ → ℚ)
    (m d : ℕ) (hm : 1 < m) (hd : 0 < d) :
    topScalar r ε profile m d ((m:ℂ)+1)=
      ∑ j : Fin 321, topCoefficient r ε m d ((m:ℂ)+1) j*
        basisValues (fun t => (profile t:ℂ)) j := by
  unfold topScalar
  rw [physical_topVector_resonance,formalHigher_top_observed r ε m d _ _ hd
    (original_resonance_scale_nonzero m hm d)]
  simp only [topCoefficient,div_mul_eq_mul_div,Finset.sum_div]

def topCorrection (r : Source) (ε : ℚ) (profile : ℕ → ℚ) (m d : ℕ)
    (G : ℂ → Fin 321 → ℂ) (anchor : ℂ → ℂ) (s : ℂ) : ℂ :=
  (∑ j : Fin 321, topCoefficient r ε m d s j*G s j)-topScalar r ε profile m d s*anchor s

/-- Only the polar profile of the observed combinations enters. The formal
top substitution need agree with that profile at resonance, not away from it. -/
theorem topCorrection_germ (r : Source) (ε : ℚ) (profile : ℕ → ℚ)
    (m d : ℕ) (hm : 1 < m) (hd : 0 < d)
    (G : ℂ → Fin 321 → ℂ) (anchor : ℂ → ℂ)
    (hprofile : ∀ j, HasAnalyticGerm (fun z => G z j-
      basisValues (fun t => (profile t:ℂ)) j*anchor z) ((m:ℂ)+1))
    (ha : MeromorphicAt anchor ((m:ℂ)+1))
    (ho : (-1:WithTop ℤ)≤meromorphicOrderAt anchor ((m:ℂ)+1)) :
    HasAnalyticGerm (topCorrection r ε profile m d G anchor) ((m:ℂ)+1) :=
  profile_row_germ G (topCoefficient r ε m d) (basisValues (fun t => (profile t:ℂ)))
    anchor (topScalar r ε profile m d) ((m:ℂ)+1) hprofile
    (fun j => topCoefficient_analytic r ε m d _ j (original_resonance_scale_nonzero m hm d))
    (topScalar_analytic r ε profile m d _) ha ho (topScalar_residue_match r ε profile m d hm hd)

#print axioms topScalar_residue_match
#print axioms topCorrection_germ
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
end
