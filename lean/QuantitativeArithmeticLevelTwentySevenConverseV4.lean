/-! ## TwentySevenSelectedContinuation -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
open Matrix Complex
open QuantitativeArithmeticSmallLevelTwentySevenObservation
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point originalVector)

/-- Any exact meromorphic left reconstruction for a selected source family
continues the fixed observation vector. -/
theorem selected_system_continuation (selection : Fin 550 → Kind) (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (η : ℂ)
    (A : ℂ → Matrix (Fin 550) (Fin 607) ℂ)
    (L : ℂ → Matrix (Fin 321) (Fin 550) ℂ)
    (hL : ∀ x : ℂ, ∀ i : Fin 321, ∀ j : Fin 550, MeromorphicAt (fun z => L z i j) x)
    (BR : ℝ) (hR : ∀ z : ℂ, BR<z.re → L z*A z=basisMatrix)
    (hA : ∀ z : ℂ, A z *ᵥ originalVector m f z=selectedRows selection m f η z)
    (B₀ : ℝ) (error : ℕ → ℂ → Fin 550 → ℂ)
    (he : ∀ M : ℕ, ∀ i : Fin 550, ∀ s : ℂ, B₀-((M:ℝ)+1)<s.re →
      AnalyticAt ℂ (fun z => error M z i) s)
    (hr : ∀ M : ℕ, ∀ s : ℂ, B₀<s.re → selectedRows selection m f η s=error M s+
      ∑ n∈Finset.range M, selectedCoefficient selection m η n s *ᵥ
        (basisMatrix *ᵥ originalVector m f (s+((n:ℂ)+1)))) :
    ∃ (B : ℝ) (G : ℂ → Fin 321 → ℂ),
      (∀ i : Fin 321, ∀ x : ℂ, MeromorphicNFAt (fun z => G z i) x) ∧
      ∀ z : ℂ, B<z.re → G z=basisMatrix *ᵥ originalVector m f z := by
  obtain ⟨BF,hF⟩ := SmallLevelAdditive.original_common_halfplane hf
  let B := max B₀ (max BR BF)
  have hB₀ : B₀≤B := le_max_left _ _
  have hBR : BR≤B := le_trans (le_max_left _ _) (le_max_right _ _)
  have hBF : BF≤B := le_trans (le_max_right _ _) (le_max_right _ _)
  obtain ⟨G,hG,hagree⟩ := QuantitativeArithmeticMeromorphicObservableContinuation.meromorphic_observations_staged
    B (fun z => originalVector m f z) basisMatrix
    A L
    (fun _ => 1) (fun n z => selectedCoefficient selection m η n z*basisMatrix) (selectedCoefficient selection m η) error
    (fun i z hz => (hF (point i.val) z (lt_of_le_of_lt hBF hz)).1)
    hL
    (fun _ _ _ => analyticAt_const)
    (by refine ⟨0,?_⟩; simp)
    (fun n x i j => (kindCoefficient_analytic (selection i) m η n x j).meromorphicAt)
    (by
      intro n i z hz
      apply (he n i z ?_).meromorphicAt
      linarith)
    (by
      intro z hz
      simpa only [Matrix.one_mul] using hR z (lt_of_le_of_lt hBR hz))
    (fun _ _ _ => rfl)
    (by
      intro n z hz
      have h := hr n z (lt_of_le_of_lt hB₀ hz)
      rw [← hA z] at h
      simpa only [Matrix.mulVec_mulVec] using h)
  exact ⟨B,G,hG,hagree⟩
#print axioms selected_system_continuation
end QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
end
end

