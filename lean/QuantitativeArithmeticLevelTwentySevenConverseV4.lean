/-! ## TwentySevenFourthMinusCertificate -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily.Minus
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_analytic primeRate_nonzero primeRate_resonance_layer)
open QuantitativeArithmeticIntegerSevenLaurentRows

def weight (m : ℕ) (s : ℂ) (i : Fin 340) : ℂ :=
  QuantitativeArithmeticSmallLevelTwentySevenFourthMinusTranspose.weightValue (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s) i.val*
    normalizer (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s) i.val

def scalar (m : ℕ) (s : ℂ) : ℂ :=
  QuantitativeArithmeticSmallLevelTwentySevenFourthMinusTranspose.scalarCoefficient (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)

theorem weight_analytic (m : ℕ) (i : Fin 340) (s : ℂ) :
    AnalyticAt ℂ (fun z => weight m z i) s := by
  apply AnalyticAt.mul _ (physical_normalizer_analytic i.val m s)
  exact eval_analytic _ _ _ _ 0 0 0 s (fun _ _ => 1) (QuantitativeArithmeticSmallLevelTwentySevenFourthMinusTranspose.weights i.val)
    (primeRate_analytic 2 m s) (primeRate_analytic 3 m s)
    (primeRate_analytic 5 m s) (primeRate_analytic 7 m s)
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s)
    (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)
    (fun _ => analyticAt_const)

theorem scalar_analytic (m : ℕ) (s : ℂ) : AnalyticAt ℂ (scalar m) s := by
  unfold scalar QuantitativeArithmeticSmallLevelTwentySevenFourthMinusTranspose.scalarCoefficient
  apply AnalyticAt.mul analyticAt_const
  exact eval_analytic _ _ _ _ 0 0 0 s (fun _ _ => 1) QuantitativeArithmeticSmallLevelTwentySevenFourthMinusFlatInteger.input340
    (primeRate_analytic 2 m s) (primeRate_analytic 3 m s)
    (primeRate_analytic 5 m s) (primeRate_analytic 7 m s)
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s)
    (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)
    (fun _ => analyticAt_const)

theorem scalar_nonzero (m : ℕ) : scalar m ((m:ℂ)+1)≠0 := by
  have h (p : ℝ) (hp : 0 < p) : primeRate p m ((m:ℂ)+1)=(p:ℂ) := by
    simpa using primeRate_resonance_layer p hp m 0
  unfold scalar
  rw [h 2 (by norm_num),h 3 (by norm_num),h 5 (by norm_num),h 7 (by norm_num)]
  exact QuantitativeArithmeticSmallLevelTwentySevenFourthMinusTranspose.scalar_at_resonance_nonzero

theorem reconstruction (m : ℕ) (s : ℂ) (v : ℕ → ℂ) :
    (∑ i : Fin 340, weight m s i*normalizedRow (selected i) (-1) QuantitativeArithmeticSmallLevelTwentySevenFourthAnchorProfileMinus.profile (depth i)
      (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s) v)=scalar m s*v 2428 := by
  have h := QuantitativeArithmeticSmallLevelTwentySevenFourthMinusTranspose.reconstruct_top_coordinate (primeRate 2 m s) (primeRate 3 m s)
    (primeRate 5 m s) (primeRate 7 m s) v (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s)
    (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)
  rw [list_range_sum] at h
  calc
    _=(∑ i : Fin 340, QuantitativeArithmeticSmallLevelTwentySevenFourthMinusTranspose.weightValue (primeRate 2 m s) (primeRate 3 m s)
        (primeRate 5 m s) (primeRate 7 m s) i.val*
        eval (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
          0 0 0 v (QuantitativeArithmeticSmallLevelTwentySevenFourthMinusFlatInteger.inputs i.val)) := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [input_binding i _ _ _ _ v (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s)
        (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)]
      unfold weight
      ring
    _=_ := h

def certificate (m : ℕ) : Certificate (-1) QuantitativeArithmeticSmallLevelTwentySevenFourthAnchorProfileMinus.profile m :=
  ⟨weight m,scalar m,weight_analytic m,scalar_analytic m,scalar_nonzero m,reconstruction m⟩

#print axioms certificate
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily.Minus
end
end

