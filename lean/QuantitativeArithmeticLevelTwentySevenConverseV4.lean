/-! ## TwentySevenLowerCusp -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2500000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySeven
open Complex UpperHalfPlane SmallLevelNormalized QuantitativeArithmeticQuadraticMatrices
open QuantitativeArithmeticSmallLevelTwentySevenAffine QuantitativeArithmeticAffineOrbitRigidity
open QuantitativeArithmeticCuspRemainder QuantitativeArithmeticLogSector
open scoped MatrixGroups ModularForm

theorem lower_denom (z : ℍ) : denom (baseGL 3) z=3*(z:ℂ)+1 := by
  norm_num [denom,baseGL,baseMatrix,liftMatrix,matrix,Matrix.GeneralLinearGroup.mkOfDetNeZero,Matrix.det_fin_two]

theorem lower_point (z : ℍ) : ((baseGL 3 • z : ℍ):ℂ)=(z:ℂ)/(3*(z:ℂ)+1) := by
  rw [coe_smul_of_det_pos (by rw [baseGL_det]; norm_num)]
  norm_num [num,denom,baseGL,baseMatrix,liftMatrix,matrix,Matrix.GeneralLinearGroup.mkOfDetNeZero,Matrix.det_fin_two]

theorem lower_cusp_formula (k : ℕ) (f : ℕ → ℂ) (r : ℂ) (z : ℍ) :
    (scaledFunction k f ∣[(k:ℤ)] baseGL 3) z-(-9*Complex.I)^k*r=
      ((3*(z:ℂ)+1)^k)⁻¹ *
        remainder (FinitenessOriginalFourier.fullCoefficients f k) (1/9) k r (-(27*(z:ℂ)+9)⁻¹) := by
  have hn : 3*(z:ℂ)+1≠0 := by
    intro h
    have hh := congrArg Complex.im h
    norm_num [Complex.mul_im] at hh
    linarith [z.im_pos]
  have hn' : 27*(z:ℂ)+9≠0 := by
    have he : 27*(z:ℂ)+9=9*(3*(z:ℂ)+1) := by ring
    rw [he]; exact mul_ne_zero (by norm_num) hn
  have hpoint : ((z:ℂ)/(3*(z:ℂ)+1))/3=(1/9:ℂ)+(-(27*(z:ℂ)+9)⁻¹) := by
    rw [show 27*(z:ℂ)+9=9*(3*(z:ℂ)+1) by ring,mul_inv_rev]
    have hh := mul_inv_cancel₀ hn
    linear_combination (1/9:ℂ)*hh
  have hp : (3*(z:ℂ)+1)⁻¹*(-Complex.I*(-(27*(z:ℂ)+9)⁻¹))⁻¹= -9*Complex.I := by
    simp only [neg_mul_neg,mul_inv_rev,inv_inv,Complex.inv_I]
    have hh := inv_mul_cancel₀ hn
    linear_combination (-9*Complex.I)*hh
  have hpolar : ((3*(z:ℂ)+1)^k)⁻¹*((-Complex.I*(-(27*(z:ℂ)+9)⁻¹))^k)⁻¹=(-9*Complex.I)^k := by
    rw [← inv_pow,← inv_pow,← mul_pow,hp]
  rw [det_one_slash _ (baseGL_det 3),lower_denom,_root_.zpow_neg,zpow_natCast]
  simp only [scaledFunction,scaledFourier,lower_point]
  rw [hpoint]
  dsimp only [remainder]
  push_cast
  rw [mul_sub,← mul_assoc,hpolar]
  ring

theorem original_lower_cusp_decay (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ c : ℂ,SectorDecay (fun z => (scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] baseGL 3) z-c) := by
  obtain ⟨r,hr⟩ := QuantitativeArithmeticSmallLevelTwentySevenGrowth.original_cusp_sector m hm hf
  obtain ⟨τ,_,hg⟩ := hf.growth
  have hA := FinitenessOriginalFourier.polynomial_bound hf.zero hg (2*m)
  have hA0 := FinitenessOriginalFourier.fullCoefficients_zero hf.zero (2*m)
  have hflat := extend_flat_sector _ (log_remainder_growth hA hA0 (1/9) (2*m) r) hr
  have hi := inverse_affine_decay _ hflat 27 9 (by norm_num)
  have hb := hi.bounded_mul (inverse_affine_multiplier 3 1 (by norm_num) (2*m))
  refine ⟨(-9*Complex.I)^(2*m)*r,?_⟩
  convert hb using 1
  funext z
  simpa using lower_cusp_formula (2*m) f r z
#print axioms lower_cusp_formula
#print axioms original_lower_cusp_decay
end QuantitativeArithmeticSmallLevelTwentySeven
end
