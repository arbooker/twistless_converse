theorem lift_anchor_for_chosen_chart (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (η : ℂ) (hη : η=1 ∨ η= -1)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw
      QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m f η)
    (C : LiftChart m f η)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
