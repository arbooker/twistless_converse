    have hp : 0<n-1 := by omega
    have hh : (x-1)+(n:ℂ)=x+((n-1:ℕ):ℂ) := by
      rw [Nat.cast_sub (by omega : 1≤n),Nat.cast_one]
      ring
    rw [hh]
    exact hx (n-1) hp i
  have h := weighted_first_shift m f 1 B0 E he hr typedSelection
    (fun z i => weights m f (z+1) i) hW hz BG G hG hagree (x-1) hs
  have h' := h.shift (x:=x) (d:=(-1:ℂ))
  unfold firstRow
  simpa only [sub_eq_add_neg,neg_add_cancel_right] using h'

theorem target_germ_at_sign (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
