      ((Real.sqrt 7:ℂ)*f 7) s *ᵥ originalVector m f s) i=
      physicalEval (QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.inputs i.val) m f s := by
    simpa only [QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.physicalSource,QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.sourceMatrix,physicalEval,originalVector,
      QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate,Matrix.mulVec,dotProduct] using
