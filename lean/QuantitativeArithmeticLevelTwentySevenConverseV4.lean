open scoped MatrixGroups ModularForm

theorem val_mod_three (a : ℤ) (ha : (3:ℤ)∣a) : (a:ZMod 9).val%3=0 := by
  have hv := ZMod.val_intCast (n:=9) a
  have he := Int.emod_eq_zero_of_dvd ha
  omega

theorem reduction_good (A : SL(2,ℤ)) (hA : A∈CongruenceSubgroup.Gamma0 3) : good (reduction 9 A) := by
  have h := (ZMod.intCast_zmod_eq_zero_iff_dvd (A 1 0) 3).mp (CongruenceSubgroup.Gamma0_mem.mp hA)
  exact val_mod_three (A 1 0) h

theorem reduction_kernel (A : SL(2,ℤ)) (hc : (9:ℤ)∣A 1 0) (hb : (3:ℤ)∣A 0 1) :
    residueCoeff (reduction 9 A)=(1,0,0,0) := by
  apply residue_kernel
  · exact (ZMod.intCast_zmod_eq_zero_iff_dvd (A 1 0) 9).mpr hc
  · exact val_mod_three (A 0 1) hb

theorem original_congruence (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (γ : SL(2,ℤ)) (hγ : γ∈CongruenceSubgroup.Gamma0 3)
    (hc : (9:ℤ)∣γ 1 0) (hb : (3:ℤ)∣γ 0 1) :
    scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] γ=scaledFunction (2*m) f := by
  let w := fun A : SL(2,ℤ) => combo m (scaledFunction (2*m) f) (residueCoeff (reduction 9 A))
  have ht (A : SL(2,ℤ)) (hA : A∈CongruenceSubgroup.Gamma0 3) :
      w A ∣[((2*m:ℕ):ℤ)] T=w (A*T) := by
    dsimp only [w]
    rw [original_combo_R m hm hf,map_mul,residue_R _ (reduction_good A hA)]
  have hu (A : SL(2,ℤ)) (hA : A∈CongruenceSubgroup.Gamma0 3) :
      w A ∣[((2*m:ℕ):ℤ)] lower 3=w (A*lower 3) := by
    dsimp only [w]
    rw [original_combo_S m hm hf,map_mul,residue_S _ (reduction_good A hA)]
  have hz (A : SL(2,ℤ)) (hA : A∈CongruenceSubgroup.Gamma0 3) :
      w A ∣[((2*m:ℕ):ℤ)] (-1:SL(2,ℤ))=w (A*(-1)) := by
    rw [SmallLevelThirtySix.slash_neg_one_even]
    dsimp only [w]
    rw [map_mul,residue_Z _ (reduction_good A hA)]
  have hh := QuantitativeArithmeticGammaThreeOrbit.finite_orbit_lift ((2*m:ℕ):ℤ) w ht hu hz γ hγ 1
    ((CongruenceSubgroup.Gamma0 3).one_mem)
  simpa only [w,map_one,one_mul,residue_one,reduction_kernel γ hc hb,combo,
    Int.cast_one,Int.cast_zero,one_smul,zero_smul,add_zero] using hh
#print axioms original_congruence
end QuantitativeArithmeticSmallLevelTwentySevenOrbit
end
end

/-! ## TwentySevenModular -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenOrbit
open UpperHalfPlane Matrix
open QuantitativeArithmeticSmallLevelTwentySeven
open scoped ModularForm MatrixGroups

def rescaledMatrix (γ : SL(2,ℤ)) (c : ℤ) (hc : γ 1 0=27*c) : SL(2,ℤ) :=
  ⟨!![γ 0 0,3*γ 0 1;9*c,γ 1 1],by
    have hh := γ.property
    rw [det_fin_two] at hh ⊢
    simp only [Matrix.of_apply,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.cons_val_fin_one] at *
    rw [hc] at hh
    nlinarith⟩

def scaleThree (z : ℍ) : ℍ := ⟨3*(z:ℂ),by simpa using mul_pos (by norm_num : (0:ℝ)<3) z.im_pos⟩

theorem rescaled_denom (γ : SL(2,ℤ)) (c : ℤ) (hc : γ 1 0=27*c) (z : ℍ) :
    denom (rescaledMatrix γ c hc) (scaleThree z)=denom γ z := by
  simp only [denom,SpecialLinearGroup.toGL]
  change ((9*c:ℤ):ℂ)*(3*(z:ℂ))+(γ 1 1:ℂ)=(γ 1 0:ℂ)*(z:ℂ)+(γ 1 1:ℂ)
  rw [hc]
  push_cast
  ring

theorem rescaled_point (γ : SL(2,ℤ)) (c : ℤ) (hc : γ 1 0=27*c) (z : ℍ) :
    (((rescaledMatrix γ c hc) • scaleThree z : ℍ):ℂ)/3=((γ • z : ℍ):ℂ) := by
  rw [coe_specialLinearGroup_apply,coe_specialLinearGroup_apply]
  change (((γ 0 0:ℂ)*(3*(z:ℂ))+((3*γ 0 1:ℤ):ℂ))/
    (((9*c:ℤ):ℂ)*(3*(z:ℂ))+(γ 1 1:ℂ)))/3=
      ((γ 0 0:ℂ)*(z:ℂ)+(γ 0 1:ℂ))/((γ 1 0:ℂ)*(z:ℂ)+(γ 1 1:ℂ))
  rw [hc]
  push_cast
  rw [show (9:ℂ)*c*(3*(z:ℂ))+(γ 1 1:ℂ)=27*c*(z:ℂ)+(γ 1 1:ℂ) by ring]
  ring

theorem scaled_slash (k : ℕ) (f : ℕ → ℂ) (γ : SL(2,ℤ)) (c : ℤ)
    (hc : γ 1 0=27*c) (z : ℍ) :
    (scaledFunction k f ∣[(k:ℤ)] rescaledMatrix γ c hc) (scaleThree z)=
      (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] γ) z := by
  rw [ModularForm.SL_slash_apply,ModularForm.SL_slash_apply,rescaled_denom]
  simp only [scaledFunction,scaledFourier,SmallLevelOriginal.fourierFunction,rescaled_point]

theorem original_gamma_zero (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (γ : SL(2,ℤ)) (hγ : γ∈CongruenceSubgroup.Gamma0 27) :
    SmallLevelOriginal.fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] γ=
      SmallLevelOriginal.fourierFunction (2*m) f := by
  have hc : (27:ℤ)∣γ 1 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ 27).mp (CongruenceSubgroup.Gamma0_mem.mp hγ)
  obtain ⟨c,hc⟩ := hc
  have h3 : rescaledMatrix γ c hc∈CongruenceSubgroup.Gamma0 3 := by
    apply CongruenceSubgroup.Gamma0_mem.mpr
    change ((9*c:ℤ):ZMod 3)=0
    push_cast
    rw [show (9:ZMod 3)=0 by decide,zero_mul]
  have h9 : (9:ℤ)∣rescaledMatrix γ c hc 1 0 := ⟨c,rfl⟩
  have hb : (3:ℤ)∣rescaledMatrix γ c hc 0 1 := ⟨γ 0 1,rfl⟩
  have hh := original_congruence m hm hf (rescaledMatrix γ c hc) h3 h9 hb
  funext z
  have he := congrFun hh (scaleThree z)
  rw [scaled_slash] at he
  simpa only [scaledFunction,scaledFourier,scaleThree,coe_mk,SmallLevelOriginal.fourierFunction,
    mul_div_cancel_left₀ _ (by norm_num : (3:ℂ)≠0)] using he

theorem level_twenty_seven {k : ℕ} (hk : 0<k) (heven : Even k) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 k f) : SmallLevelOriginal.IsModular 27 k f := by
  obtain ⟨m,hm⟩ := heven
  have hkm : k=2*m := by omega
  rw [hkm] at hf ⊢
  exact SmallLevelOriginal.modular_of_transformations (by decide) hf (original_gamma_zero m (by omega) hf)
#print axioms original_gamma_zero
#print axioms level_twenty_seven
end QuantitativeArithmeticSmallLevelTwentySevenOrbit
end
end

/-! ## TwentySevenCirc -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenOrbit
open FinitenessOriginalInput QuantitativeArithmeticSmallLevelCirc

/-- The literal level27 conclusion of Theorem1.3: full trace-new membership
and vanishing at zero and infinity, also in weight two. -/
theorem level_twenty_seven_circ {k : ℕ} (hk : 0<k) (heven : Even k) {f : ℕ → ℂ}
    (hf : IsSolution 27 k f) : IsCirc 27 (by decide) k f :=
  original_modular_isCirc_even (by decide) hk heven hf (level_twenty_seven hk heven hf)

/-- The count uses the general normalized Hecke eigenbasis theorem. -/
theorem level_twenty_seven_count {k : ℕ} (hk : 0<k) (heven : Even k) :
    Finite (S 27 k) ∧ Nat.card (S 27 k)=Module.finrank ℂ (space 27 (by decide) k) :=
  original_count_eq (by decide) hk heven (fun _ hf => level_twenty_seven hk heven hf)
#print axioms level_twenty_seven_circ
#print axioms level_twenty_seven_count
end QuantitativeArithmeticSmallLevelTwentySevenOrbit
end
