/-! ## TwentySevenOriginalLocalPoleRule -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenOriginalLocalPoleRule
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)

theorem highest_pole_rule (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (s : ℂ) (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z j) (s+n)) :
    (∀ i,(-1:WithTop ℤ)≤meromorphicOrderAt (fun z => S.G z i) s) ∧
    (s≠((2*m:ℕ):ℂ) → ∀ i,0≤meromorphicOrderAt (fun z => S.G z i) s) := by
  by_cases hf2 : f 2=0
  · have h := QuantitativeArithmeticSmallLevelTwentySevenZeroLocalPoleRule.highest_regular m hm hf S hf2 s hshift
    refine ⟨fun i => le_trans ?_ (h i),fun _ => h⟩
    exact WithTop.coe_le_coe.mpr (by norm_num : (-1:ℤ)≤0)
  · exact QuantitativeArithmeticSmallLevelTwentySevenGenericLocalPoleRule.highest_pole_rule m hm hf S hf2 s hshift

theorem zero_entire (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (hf2 : f 2=0) (s : ℂ) (i : Fin 321) : AnalyticAt ℂ (fun z => S.G z i) s := by
  apply (S.meromorphic i s).meromorphicOrderAt_nonneg_iff_analyticAt.mp
  by_contra! hi
  obtain ⟨B,hB⟩ := S.analytic_halfplane hf
  obtain ⟨n,hpole,hshift⟩ := SmallLevelPoleGrid.rightmost_pole (fun j z => S.G z j) ⟨i,hi⟩ B hB
  obtain ⟨j,hj⟩ := hpole
  exact (not_lt_of_ge (QuantitativeArithmeticSmallLevelTwentySevenZeroLocalPoleRule.highest_regular m hm hf S hf2 (s+n) hshift j)) hj

theorem above_weight (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (s : ℂ) (hs : (2*m:ℝ)<s.re) : ∀ i,0≤meromorphicOrderAt (fun z => S.G z i) s := by
  intro i
  by_contra! hi
  obtain ⟨B,hB⟩ := S.analytic_halfplane hf
  obtain ⟨n,hpole,hshift⟩ := SmallLevelPoleGrid.rightmost_pole (fun j z => S.G z j) ⟨i,hi⟩ B hB
  have hx : s+n≠((2*m:ℕ):ℂ) := by
    intro he
    have hr := congrArg Complex.re he
    norm_num at hr
    have hn : (0:ℝ)≤n := Nat.cast_nonneg n
    linarith
  obtain ⟨j,hj⟩ := hpole
  exact (not_lt_of_ge ((highest_pole_rule m hm hf S (s+n) hshift).2 hx j)) hj

theorem weight_order (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f) :
    ∀ i,(-1:WithTop ℤ)≤meromorphicOrderAt (fun z => S.G z i) ((2*m:ℕ):ℂ) := by
  apply (highest_pole_rule m hm hf S ((2*m:ℕ):ℂ) _).1
  intro n hn
  apply above_weight m hm hf S
  have hn' : (0:ℝ)<n := by exact_mod_cast hn
  norm_num
  linarith
#print axioms highest_pole_rule
#print axioms zero_entire
#print axioms above_weight
#print axioms weight_order
end QuantitativeArithmeticSmallLevelTwentySevenOriginalLocalPoleRule
end
