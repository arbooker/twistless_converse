theorem ramanujan_first (point : ℕ → ℚ)
    (r : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Spec)
    (hr : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Valid point r)
    (m : ℕ) (η s : ℂ) (v : ℕ → ℂ) :
    QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.shift r m η 0 (s-1) v=
      -Complex.I*(s-((2*m:ℕ):ℂ)) *
        (-η*(Nat.lcm 27 (r.q^2):ℂ)*((r.t:ℂ)/(r.Q:ℂ))*
          ((primeRate 2 m s/2)^r.e₂*(primeRate 3 m s/3)^r.e₃*
            (primeRate 5 m s/5)^r.e₅*(primeRate 7 m s/7)^r.e₇)*
          QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.sampleEval r.q r.right v) := by
  have hz := QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.taylor_zero_physical
    (Nat.lcm 27 (r.q^2)) m ((r.t:ℚ)/r.Q) r.e₂ r.e₃ r.e₅ r.e₇ hr.2.2.2.2.2.1 η (s-1)
  simp only [Rat.cast_div,Rat.cast_intCast,Rat.cast_natCast] at hz
  unfold QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.shift
  rw [zero_add,taylor_one,hz]
  rw [primeRate_sub_one 2 m (by norm_num),primeRate_sub_one 3 m (by norm_num),
    primeRate_sub_one 5 m (by norm_num),primeRate_sub_one 7 m (by norm_num)]
  simp only [Complex.ofReal_div,Complex.ofReal_natCast,Complex.ofReal_intCast,Complex.ofReal_ofNat]
  ring

