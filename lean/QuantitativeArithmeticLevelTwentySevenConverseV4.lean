/-! ## TwentySevenPoleALiftChart -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleSource
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate)

def liftRegularPoint (m : ℕ) (f : ℕ → ℂ) (s : ℂ) : Prop :=
  ((Real.sqrt 2:ℂ)*f 2)≠0 ∧ primeRate 2 m s-1≠0 ∧ primeRate 2 m s+1≠0 ∧
    QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.exceptionalPolynomial (primeRate 2 m s)
      (primeRate 5 m s) (primeRate 7 m s) ((Real.sqrt 2:ℂ)*f 2)
      ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)≠0

structure LiftChart (m : ℕ) (f : ℕ → ℂ) (η : ℂ) where
  selection : Fin 550 → Kind
  A : ℂ → Matrix (Fin 550) (Fin 607) ℂ
  L : ℂ → Matrix (Fin 321) (Fin 550) ℂ
  P : Fin 871 → ℂ → ℂ
  left_meromorphic : ∀ x i j, MeromorphicAt (fun z => L z i j) x
  left_analytic : ∀ x, (∀ t, P t x≠0) → ∀ i j, AnalyticAt ℂ (fun z => L z i j) x
  pivot_analytic : ∀ i x, AnalyticAt ℂ (P i) x
  pivots_nonzero : ∀ x, liftRegularPoint m f x → ∀ i, P i x≠0
  reconstruction : ∀ x, (∀ i, P i x≠0) → L x*A x=basisMatrix
  source_action : ∀ s, A s *ᵥ originalVector m f s=selectedRows selection m f η s

/-- The lifted source system is valid for either original Fricke sign. -/
theorem original_lift_chart (m : ℕ) (f : ℕ → ℂ) (η : ℂ) (hη : η=1 ∨ η= -1) :
    Nonempty (LiftChart m f η) := by
  rcases hη with rfl|rfl
  · refine ⟨{
      selection := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusSourceBinding.selection
      A := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.physicalSource m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      L := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.physicalLeft m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      P := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.physicalPivot m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      left_meromorphic := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.physical_left_meromorphic m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      left_analytic := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.physical_left_analytic m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      pivot_analytic := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.physical_pivot_analytic m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      pivots_nonzero := ?_
      reconstruction := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.physical_reconstruction m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      source_action := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusSourceBinding.source_action m f
    }⟩
    intro x hx i
    rcases hx with ⟨ha,hm,hp,hq⟩
    exact QuantitativeArithmeticSmallLevelTwentySevenPoleALiftPlusStages.physical_pivots_nonzero m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) x ha hm hp hq i
  · refine ⟨{
      selection := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusSourceBinding.selection
      A := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusStages.physicalSource m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      L := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusStages.physicalLeft m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      P := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusStages.physicalPivot m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      left_meromorphic := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusStages.physical_left_meromorphic m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      left_analytic := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusStages.physical_left_analytic m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      pivot_analytic := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusStages.physical_pivot_analytic m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      pivots_nonzero := ?_
      reconstruction := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusStages.physical_reconstruction m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
      source_action := QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusSourceBinding.source_action m f
    }⟩
    intro x hx i
    rcases hx with ⟨ha,hm,hp,hq⟩
    exact QuantitativeArithmeticSmallLevelTwentySevenPoleALiftMinusStages.physical_pivots_nonzero m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) x ha hm hp hq i
#print axioms original_lift_chart
end QuantitativeArithmeticSmallLevelTwentySevenPoleSource
