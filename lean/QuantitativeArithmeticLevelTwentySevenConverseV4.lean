    rfl
  have hnT : ‖t‖= -t.re := by
    have ht : t=(t.re:ℂ) := by apply Complex.ext <;> simp [htim]
    rw [ht,Complex.norm_real,Real.norm_eq_abs,abs_of_neg htneg]
    rfl
  rw [hnU,hnT]
  constructor <;> linarith

