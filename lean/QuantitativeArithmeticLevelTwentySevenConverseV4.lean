theorem GrowthSystem.cleared_rows {m : ℕ} {f : ℕ → ℂ} {S : PoleSystem m f}
    (R : GrowthSystem m f S) (n : ℕ) (s : ℂ)
    (hs : R.B-((n:ℝ)+1)<s.re) (hi : s.im≠0) (hd : divisor m f s≠0)
    (i : Fin 321) :
    divisor m f s^R.power*S.G s i=
      ∑ j : Fin 549,R.numerator (i,j) s*R.E j n s+
      ∑ a∈Finset.range n,∑ j : Fin 549,∑ t : Fin 321,
        R.numerator (i,j) s*coefficient (R.selection j) m R.η a s t*S.G (s+((a:ℂ)+1)) t := by
  have hc (j : Fin 549) : divisor m f s^R.power*R.L s i j=R.numerator (i,j) s := by
    rw [R.cleared (i,j) s hd]
    field_simp
  have hr := congrFun (R.rows n s hs hi hd) i
  rw [hr]
  simp only [Pi.add_apply,Finset.sum_apply,Matrix.mulVec,Matrix.mul_apply,Matrix.of_apply,
    dotProduct,mul_add,Finset.mul_sum,Finset.sum_mul]
  simp only [← mul_assoc,hc]
  congr 1
  apply Finset.sum_congr rfl
  intro a _
  rw [Finset.sum_comm]

#print axioms GrowthSystem.cleared_rows
end QuantitativeArithmeticSmallLevelTwentySevenGrowth
end
