      QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.primeRate,QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate,Matrix.mulVec,dotProduct] using
      (eval_bounded_eq_sum (QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.primeRate 2 m s) (QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.primeRate 3 m s)
        (QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.primeRate 5 m s) (QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.primeRate 7 m s)
