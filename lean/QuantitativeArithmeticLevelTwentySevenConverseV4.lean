/-! ## TwentySevenObservedJetChart -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenObservedJetChart
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenShiftSource (basisValues_original)
open QuantitativeArithmeticInitialTaylorGerm
open QuantitativeArithmeticAnalyticGerm

/-- A finite, original-half-plane cancellation certificate. Its row weights
may be meromorphic; no individual additive coordinate is continued. -/
structure Chart (d r m : ℕ) (f : ℕ → ℂ) (ε : ℚ) where
  selection : Fin d → Source
  depth : Fin d → ℕ
  depth_bound : ∀ i, depth i≤1
  W : ℂ → Matrix (Fin 321) (Fin d) ℂ
  pivot : Fin r → ℂ → ℂ
  weight_meromorphic : ∀ x i j, MeromorphicAt (fun z => W z i j) x
  weight_analytic : ∀ x, (∀ t, pivot t x≠0) → ∀ i j, AnalyticAt ℂ (fun z => W z i j) x
  pivot_analytic : ∀ t x, AnalyticAt ℂ (pivot t) x
  cancellation : ∀ z, (∀ t, pivot t z≠0) → ∀ i : Fin 321,
    originalObservations m f z i=∑ j : Fin d, W z i j*sourcePrefix (selection j) m f ε (depth j) z

theorem regular_at {d r m : ℕ} [NeZero d] (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (ε : ℚ) (hε : (ε:ℂ)=1 ∨ (ε:ℂ)= -1)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw
      QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m f (ε:ℂ))
    (C : Chart d r m f ε) (x : ℂ) (hx : ∀ t, C.pivot t x≠0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z j) (x+n)) (i : Fin 321) :
    AnalyticAt ℂ (fun z => S.G z i) x := by
  obtain ⟨B0,E,hE⟩ := original_family C.selection m hm hf (ε:ℂ) hε hlaw
  let B := max B0 S.B
  have hB0 : B0≤B := le_max_left _ _
  have hBG : S.B≤B := le_max_right _ _
  have hc (z : ℂ) (hz : S.B<z.re) : originalObservations m f z=S.G z := by
    rw [S.agreement z hz]
    exact basisValues_original m f z
  apply (S.meromorphic i x).meromorphicOrderAt_nonneg_iff_analyticAt.mp
  apply HasAnalyticGerm.order_nonneg
  apply finite_shifted_elimination_off_pivots C.pivot C.pivot_analytic
    (originalObservations m f) S.G
    (fun j => row (C.selection j) m f (ε:ℂ))
    (fun j => coefficient (C.selection j) m (ε:ℂ)) E
    (fun j z => C.W z i j) C.depth 1 C.depth_bound (fun z => S.G z i) B
  · intro j M z hz
    simpa only [originalObservations,originalCoordinates,Nat.cast_add,Nat.cast_one] using
      (hE j M).2 z (lt_of_le_of_lt hB0 hz)
  · intro z hz
    exact hc z (lt_of_le_of_lt hBG hz)
  · intro z hz hp
    rw [← hc z (by linarith [hBG])]
    simpa only [sourcePrefix_eq_shiftedPrefix] using C.cancellation z hp i
  · exact S.meromorphic
  · intro z
    exact (S.meromorphic i z).meromorphicAt
  · intro j n t z
    exact coefficient_analytic (C.selection j) m (ε:ℂ) n z t
  · intro j M z hz
    apply (hE j M).1 z
    change B0-((M:ℝ)+1)<z.re
    linarith
  · intro j z
    exact C.weight_meromorphic z i j
  · exact hx
  · intro j
    exact C.weight_analytic x hx i j
  · exact hshift
#print axioms regular_at
end QuantitativeArithmeticSmallLevelTwentySevenObservedJetChart
end
end

/-! ## TwentySevenZeroJetCommonPlusOriginalChart -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusOriginalChart
open Matrix
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusStages
open QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_analytic primeRate_nonzero)
open QuantitativeArithmeticTaylorLayerNormalization

def left (m : ℕ) (f : ℕ → ℂ) (s : ℂ) : Matrix (Fin 321) (Fin 649) ℂ :=
  stagedLeftMatrix (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    0 ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
def divisor (m : ℕ) (d : ℕ) (s : ℂ) : ℂ := scale (s-((2*m:ℕ):ℂ)) d
def pivot (m : ℕ) (f : ℕ → ℂ) (i : Fin 971) (s : ℂ) : ℂ :=
  if i.val<970 then stageLead
    (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
      0 ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) i.val
  else divisor m 1 s
def weight (m : ℕ) (f : ℕ → ℂ) (s : ℂ) : Matrix (Fin 321) (Fin 649) ℂ :=
  fun i j => left m f s i j/divisor m (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.entry j).2 s

theorem divisor_analytic (m d : ℕ) (s : ℂ) : AnalyticAt ℂ (divisor m d) s :=
  (scale_analytic d _).comp (f:=fun z : ℂ => z-((2*m:ℕ):ℂ))
    (analyticAt_id.sub analyticAt_const)
theorem scale_nonzero (m : ℕ) (f : ℕ → ℂ) (s : ℂ)
    (hp : ∀ i, pivot m f i s≠0) (d : ℕ) (hd : d≤1) : divisor m d s≠0 := by
  interval_cases d
  · simp [divisor]
  · simpa only [pivot,Fin.val_last,lt_self_iff_false,ite_false] using hp (Fin.last 970)
theorem pivots_leading (m : ℕ) (f : ℕ → ℂ) (s : ℂ)
    (hp : ∀ i, pivot m f i s≠0) (n : ℕ) (hn : n<970) :
    stageLead (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
      0 ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) n≠0 := by
  simpa only [pivot,ite_eq_left hn] using hp ⟨n,by omega⟩
theorem pivot_analytic (m : ℕ) (f : ℕ → ℂ) (i : Fin 971) (s : ℂ) :
    AnalyticAt ℂ (pivot m f i) s := by
  change AnalyticAt ℂ (fun z => pivot m f i z) s
  by_cases hi : i.val<970
  · simp only [pivot,ite_eq_left hi]
    exact coefficient_analytic (primeRate 2 m) (primeRate 3 m) (primeRate 5 m) (primeRate 7 m)
      0 ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) s
      (primeRate_analytic 2 m s) (primeRate_analytic 3 m s)
      (primeRate_analytic 5 m s) (primeRate_analytic 7 m s)
      (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s)
      (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s) (certificate i.val) (649+i.val)
  · simpa only [pivot,ite_eq_right hi] using divisor_analytic m 1 s
theorem left_meromorphic (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (i : Fin 321) (j : Fin 649) :
    MeromorphicAt (fun z => left m f z i j) s :=
  staged_left_meromorphic _ _ _ _ _ _ _ s
    (primeRate_analytic 2 m s).meromorphicAt (primeRate_analytic 3 m s).meromorphicAt
    (primeRate_analytic 5 m s).meromorphicAt (primeRate_analytic 7 m s).meromorphicAt
    (MeromorphicAt.const 0 s) (MeromorphicAt.const _ s) (MeromorphicAt.const _ s) i j
theorem left_analytic (m : ℕ) (f : ℕ → ℂ) (s : ℂ)
    (hp : ∀ t, pivot m f t s≠0) (i : Fin 321) (j : Fin 649) :
    AnalyticAt ℂ (fun z => left m f z i j) s :=
  staged_left_analytic _ _ _ _ _ _ _ s
    (primeRate_analytic 2 m s) (primeRate_analytic 3 m s)
    (primeRate_analytic 5 m s) (primeRate_analytic 7 m s)
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s)
    (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s) (pivots_leading m f s hp) i j
theorem weight_meromorphic (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (i : Fin 321) (j : Fin 649) :
    MeromorphicAt (fun z => weight m f z i j) s :=
  (left_meromorphic m f s i j).div (divisor_analytic m _ s).meromorphicAt
theorem weight_analytic (m : ℕ) (f : ℕ → ℂ) (s : ℂ)
    (hp : ∀ t, pivot m f t s≠0) (i : Fin 321) (j : Fin 649) :
    AnalyticAt ℂ (fun z => weight m f z i j) s :=
  (left_analytic m f s hp i j).div (divisor_analytic m _ s)
    (scale_nonzero m f s hp _ (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.depth_bound j))

theorem cancellation (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (hf2 : f 2=0)
    (s : ℂ) (hp : ∀ t, pivot m f t s≠0) (i : Fin 321) :
    originalObservations m f s i=∑ j : Fin 649, weight m f s i j*
      sourcePrefix (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.entry j).1 m f (1) (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.entry j).2 s := by
  have hin (j : Fin 649) :
      eval (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
        0 ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCode.packed m f s) (inputs j.val)=
        sourcePrefix (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.entry j).1 m f (1) (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.entry j).2 s /
          divisor m (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.entry j).2 s := by
    rw [QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.input_binding]
    apply QuantitativeArithmeticSmallLevelTwentySevenZeroJetCode.jetPolynomial_original _ _ (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.leading_support j) m hf hf2 _ (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.depth_bound j) s
    intro a ha
    exact scale_nonzero m f s hp a (le_trans ha (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.depth_bound j))
  have h := outputs_recover (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    0 ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCode.packed m f s)
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s)
    (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s) (pivots_leading m f s hp) i
  rw [original_output] at h
  simp only [Matrix.mulVec,dotProduct] at h
  simp_rw [hin] at h
  simpa only [weight,left,div_mul_eq_mul_div,mul_div_assoc] using h.symm

def chart (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (hf2 : f 2=0) :
    QuantitativeArithmeticSmallLevelTwentySevenObservedJetChart.Chart 649 971 m f (1) where
  selection := fun j => (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.entry j).1
  depth := fun j => (QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.entry j).2
  depth_bound := QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusSourceBinding.depth_bound
  W := weight m f
  pivot := pivot m f
  weight_meromorphic := weight_meromorphic m f
  weight_analytic := weight_analytic m f
  pivot_analytic := pivot_analytic m f
  cancellation := cancellation m hf hf2
#print axioms cancellation
#print axioms chart
end QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusOriginalChart
end
