theorem scalar_same : QuantitativeArithmeticSmallLevelTwentySevenSecondSAnchorPlus.scalar=
    QuantitativeArithmeticSmallLevelTwentySevenSecondSAnchorMinus.scalar := by rfl

theorem scalarValue_analytic (m : ℕ) (f : ℕ → ℂ) (x : ℂ) : AnalyticAt ℂ (scalarValue m f) x := by
  have he : scalarValue m f=fun z => QuantitativeArithmeticSmallLevelTwentySevenSecondSAnchorPlus.weights m f z 11 := by
