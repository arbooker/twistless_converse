/-! ## TwentySevenPoleAnchorFamily -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point originalVector)
open QuantitativeArithmeticSmallLevelTwentySevenShiftSource (basisValues basisValues_original)
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (physicalEval)

abbrev Kind := Option QuantitativeArithmeticSmallLevelTwentySevenPoleSource.Kind

def anchorFlag : Kind → ℂ
  | none => 1
  | some _ => 0

def sourceRow (r : Kind) (m : ℕ) (f : ℕ → ℂ) (η s : ℂ) : ℂ :=
  match r with
  | some t => QuantitativeArithmeticSmallLevelTwentySevenPoleSource.sourceRow t m f η s
  | none => originalVector m f s 6

def sourceShift (r : Kind) (m : ℕ) (η : ℂ) (n : ℕ) (s : ℂ) (v : ℕ → ℂ) : ℂ :=
  match r with
  | some t => QuantitativeArithmeticSmallLevelTwentySevenPoleSource.sourceShift t m η n s v
  | none => 0

def sourceCoefficient (r : Kind) (m : ℕ) (η : ℂ) (n : ℕ) (s : ℂ) (j : Fin 321) : ℂ :=
  match r with
  | some t => QuantitativeArithmeticSmallLevelTwentySevenPoleSource.sourceCoefficient t m η n s j
  | none => 0

def sourcePolynomial (ε : ℚ) (r : Kind) : QuantitativeArithmeticSevenLaurentRows.Poly :=
  match r with
  | some t => QuantitativeArithmeticSmallLevelTwentySevenPoleSource.sourcePolynomial ε t
  | none => [((1:ℚ),6,(0,0,0,0,0,0,0))]

theorem sourcePolynomial_physical (ε : ℚ) (r : Kind) (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    physicalEval (sourcePolynomial ε r) m f s=sourceRow r m f ε s := by
  cases r with
  | some t => exact QuantitativeArithmeticSmallLevelTwentySevenPoleSource.sourcePolynomial_physical ε t m f s
  | none => simp [sourcePolynomial,sourceRow,physicalEval,originalVector,
      QuantitativeArithmeticSevenLaurentRows.eval,QuantitativeArithmeticSevenLaurentRows.monomial]

theorem sourceCoefficient_analytic (r : Kind) (m : ℕ) (η : ℂ) (n : ℕ) (s : ℂ) (j : Fin 321) :
    AnalyticAt ℂ (fun z => sourceCoefficient r m η n z j) s := by
  cases r with
  | some t => exact QuantitativeArithmeticSmallLevelTwentySevenPoleSource.sourceCoefficient_analytic t m η n s j
  | none => exact analyticAt_const

theorem sourceShift_action (r : Kind) (m : ℕ) (η : ℂ) (n : ℕ) (s : ℂ) (v : ℕ → ℂ) :
    (∑ j : Fin 321, sourceCoefficient r m η n s j*basisValues v j)=sourceShift r m η n s v := by
  cases r with
  | some t => exact QuantitativeArithmeticSmallLevelTwentySevenPoleSource.sourceShift_action t m η n s v
  | none => simp [sourceCoefficient,sourceShift]

theorem basis_anchor (v : Fin 607 → ℂ) : (basisMatrix *ᵥ v) 6=v 6 := by
  change (∑ j : Fin 607, QuantitativeArithmeticRationalRows.coefficient
    (QuantitativeArithmeticSmallLevelTwentySevenObservation.basis 6) j.val*v j)=v 6
  rw [← QuantitativeArithmeticRationalRows.eval_extend_eq_sum]
  have hb : QuantitativeArithmeticSmallLevelTwentySevenObservation.basis 6=[((1:ℚ),6)] := by decide +kernel
  rw [hb]
  simp [QuantitativeArithmeticRationalRows.eval,QuantitativeArithmeticRationalRows.extend]

/-- Adjoining the anchor keeps its value explicitly on the right; no
analyticity of that twist is presumed. -/
theorem original_family (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ (η : ℂ) (B : ℝ) (error : Kind → ℕ → ℂ → ℂ),
      (η=1 ∨ η= -1) ∧
      (∀ r : Kind, ∀ M : ℕ, ∀ s : ℂ, B-((M:ℝ)+1)<s.re →
        AnalyticAt ℂ (error r M) s) ∧
      ∀ r : Kind, ∀ M : ℕ, ∀ s : ℂ, B<s.re → sourceRow r m f η s=error r M s+
        (∑ n∈Finset.range M, sourceShift r m η n s
          (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) (s+((n:ℂ)+1))))+
        anchorFlag r*originalVector m f s 6 := by
  obtain ⟨η,B,E,hη,ha,hr⟩ := QuantitativeArithmeticSmallLevelTwentySevenPoleSource.original_family m hm hf
  let err : Kind → ℕ → ℂ → ℂ := fun r M s => match r with
    | some t => E t M s
    | none => 0
  refine ⟨η,B,err,hη,?_,?_⟩
  · intro r M s hs
    cases r with
    | some t => exact ha t M s hs
    | none => exact analyticAt_const
  · intro r M s hs
    cases r with
    | some t => simpa only [sourceRow,sourceShift,anchorFlag,err,zero_mul,add_zero] using hr t M s hs
    | none => simp [sourceRow,sourceShift,anchorFlag,err]

def selectedRows {d : ℕ} (selection : Fin d → Kind) (m : ℕ) (f : ℕ → ℂ) (η s : ℂ) : Fin d → ℂ :=
  fun i => sourceRow (selection i) m f η s

def selectedCoefficient {d : ℕ} (selection : Fin d → Kind) (m : ℕ) (η : ℂ) (n : ℕ) (s : ℂ) : Matrix (Fin d) (Fin 321) ℂ :=
  fun i => sourceCoefficient (selection i) m η n s

theorem selected_shift_action {d : ℕ} (selection : Fin d → Kind) (m : ℕ) (η : ℂ) (n : ℕ) (s : ℂ) (v : ℕ → ℂ) (i : Fin d) :
    (selectedCoefficient selection m η n s *ᵥ basisValues v) i=sourceShift (selection i) m η n s v :=
  sourceShift_action (selection i) m η n s v

theorem family_selection {d : ℕ} (selection : Fin d → Kind) (m : ℕ) (f : ℕ → ℂ)
    (η : ℂ) (B : ℝ) (error : Kind → ℕ → ℂ → ℂ)
    (hr : ∀ r : Kind, ∀ M : ℕ, ∀ s : ℂ, B<s.re → sourceRow r m f η s=error r M s+
      (∑ n∈Finset.range M, sourceShift r m η n s
        (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) (s+((n:ℂ)+1))))+
      anchorFlag r*originalVector m f s 6) :
    ∀ M : ℕ, ∀ s : ℂ, B<s.re → selectedRows selection m f η s=(fun i => error (selection i) M s)+
      (∑ n∈Finset.range M, selectedCoefficient selection m η n s *ᵥ
        (basisMatrix *ᵥ originalVector m f (s+((n:ℂ)+1))))+
      (fun i => anchorFlag (selection i)*(basisMatrix *ᵥ originalVector m f s) 6) := by
  intro M s hs
  funext i
  simp only [Pi.add_apply,Finset.sum_apply,basis_anchor]
  simp_rw [← basisValues_original,selected_shift_action]
  exact hr (selection i) M s hs
#print axioms original_family
#print axioms family_selection
#print axioms basis_anchor
#print axioms sourcePolynomial_physical
end QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
end
end

