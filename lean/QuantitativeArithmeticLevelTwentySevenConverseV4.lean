  have hcoef (p : Poly) (k : ℕ) := coefficient_analytic x y z w a b c s hx hy hz hw hx0 hy0 hz0 hw0 p k
  have hlead (n : ℕ) : AnalyticAt ℂ (fun t => stageLead (x t) (y t) (z t) (w t) a b c n) s :=
    hcoef (certificate n) (550+n)
  have hlower (n k : ℕ) : AnalyticAt ℂ (fun t => stageLower (x t) (y t) (z t) (w t) a b c n k) s :=
    hcoef (certificate n) (550+k)
  have hrhs (n : ℕ) (k : Fin 550) :
      AnalyticAt ℂ (fun t => stageRhsMatrix (x t) (y t) (z t) (w t) a b c n k) s := by
    by_cases hn : n=k.val
    · simpa only [stageRhsMatrix,ite_eq_left hn,stageSource,Pi.neg_def] using (hcoef (certificate n) n).neg
    · simpa only [stageRhsMatrix,ite_eq_right hn] using (analyticAt_const : AnalyticAt ℂ (fun _ : ℂ => (0:ℂ)) s)
  change AnalyticAt ℂ (fun t => ∑ k : Fin 550,
    outputFactor (x t) (y t) (z t) (w t) a b c i k*
      reconstructionMatrix (stageRhsMatrix (x t) (y t) (z t) (w t) a b c)
        (stageLead (x t) (y t) (z t) (w t) a b c)
        (stageLower (x t) (y t) (z t) (w t) a b c) k j) s
  apply Finset.analyticAt_fun_sum
  intro k _
  apply AnalyticAt.mul
  · exact (hcoef (certificate (550+i.val)) (550+k.val)).neg.div
      (hlead (550+i.val)) (hp (550+i.val) (by omega))
  · exact reconstruction_analytic _ _ _ s hrhs hlead hlower (fun n hn => hp n (by omega)) k j

theorem physical_left_analytic (κ : ℝ) (a b c s : ℂ)
    (hm : primeRate 2 κ s-1≠0) (hp : primeRate 2 κ s+1≠0)
    (hsq : (primeRate 2 κ s)^2+1≠0) (i : Fin 321) (j : Fin 550) :
    AnalyticAt ℂ (fun t => physicalLeft κ a b c t i j) s := by
  apply staged_left_analytic (primeRate 2 κ) (primeRate 3 κ) (primeRate 5 κ) (primeRate 7 κ) a b c s
    (primeRate_analytic 2 κ s) (primeRate_analytic 3 κ s)
    (primeRate_analytic 5 κ s) (primeRate_analytic 7 κ s)
    (primeRate_nonzero 2 κ s) (primeRate_nonzero 3 κ s)
    (primeRate_nonzero 5 κ s) (primeRate_nonzero 7 κ s) _ i j
  intro n hn
  exact all_leading_nonzero _ _ _ _ a b c
    (primeRate_nonzero 2 κ s) (primeRate_nonzero 3 κ s)
    (primeRate_nonzero 5 κ s) (primeRate_nonzero 7 κ s) hm hp hsq n hn
#print axioms staged_left_analytic
#print axioms physical_left_analytic
end QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages
end
end

/-! ## TwentySevenPoleChart -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 4000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
open Matrix Complex
open QuantitativeArithmeticSmallLevelTwentySevenObservation
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)

def regularPoint (m : ℕ) (f : ℕ → ℂ) (s : ℂ) : Prop :=
  let x := QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate 2 m s
  x-1≠0 ∧ x+1≠0 ∧
    (if f 2=0 then x^2+1≠0 else (Real.sqrt 2:ℂ)*f 2*x+x^2-1≠0)

/-- A concrete original-source reconstruction chart, with its exact regular locus. -/
structure PoleChart (m : ℕ) (f : ℕ → ℂ) (η : ℂ) where
  selection : Fin 550 → Kind
  A : ℂ → Matrix (Fin 550) (Fin 607) ℂ
  L : ℂ → Matrix (Fin 321) (Fin 550) ℂ
  bound : ℝ
  left_meromorphic : ∀ x i j, MeromorphicAt (fun z => L z i j) x
  left_analytic : ∀ x, regularPoint m f x → ∀ i j, AnalyticAt ℂ (fun z => L z i j) x
  reconstruction : ∀ z, bound<z.re → L z*A z=basisMatrix
  source_action : ∀ z, A z *ᵥ originalVector m f z=selectedRows selection m f η z

/-- The four checked charts cover every Fricke sign and every second eigenvalue. -/
theorem original_pole_chart (m : ℕ) (f : ℕ → ℂ) (η : ℂ) (hη : η=1 ∨ η= -1) :
    Nonempty (PoleChart m f η) := by
  let a : ℂ := (Real.sqrt 2:ℂ)*f 2
  let b : ℂ := (Real.sqrt 5:ℂ)*f 5
  let c : ℂ := (Real.sqrt 7:ℂ)*f 7
  by_cases hf2 : f 2=0
  · rcases hη with hη|hη
    · subst η
      obtain ⟨BR,hR⟩ := QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physical_reconstruction m a b c
      refine ⟨{
        selection := QuantitativeArithmeticSmallLevelTwentySevenPlusZeroSourceBinding.selection
        A := QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physicalSource m a b c
        L := QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physicalLeft m a b c
        bound := BR
        left_meromorphic := fun x i j => QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physical_left_meromorphic _ _ _ _ x i j
        left_analytic := ?_
        reconstruction := hR
        source_action := fun z => QuantitativeArithmeticSmallLevelTwentySevenPlusZeroSourceBinding.source_action m f hf2 z
      }⟩
      intro x hx i j
      have hr := hx
      simp only [regularPoint,ite_eq_left hf2] at hr
      exact QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physical_left_analytic m a b c x hr.1 hr.2.1 hr.2.2 i j
    · subst η
      obtain ⟨BR,hR⟩ := QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physical_reconstruction m a b c
      refine ⟨{
        selection := QuantitativeArithmeticSmallLevelTwentySevenMinusZeroSourceBinding.selection
        A := QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physicalSource m a b c
        L := QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physicalLeft m a b c
        bound := BR
        left_meromorphic := fun x i j => QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physical_left_meromorphic _ _ _ _ x i j
        left_analytic := ?_
        reconstruction := hR
        source_action := fun z => QuantitativeArithmeticSmallLevelTwentySevenMinusZeroSourceBinding.source_action m f hf2 z
      }⟩
      intro x hx i j
      have hr := hx
      simp only [regularPoint,ite_eq_left hf2] at hr
      exact QuantitativeArithmeticSmallLevelTwentySevenMinusZeroStages.physical_left_analytic m a b c x hr.1 hr.2.1 hr.2.2 i j
  · have ha : a≠0 := mul_ne_zero
      (Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (by norm_num))) hf2
    rcases hη with hη|hη
    · subst η
      obtain ⟨BR,hR⟩ := QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.physical_reconstruction m a b c ha
      refine ⟨{
        selection := kind
        A := QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.physicalSource m a b c
        L := QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.physicalLeft m a b c
        bound := BR
        left_meromorphic := fun x i j => QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.physical_left_meromorphic _ _ _ _ x i j
        left_analytic := ?_
        reconstruction := hR
        source_action := fun z => (originalRows_one m f z).symm
      }⟩
      intro x hx i j
      have hr := hx
      simp only [regularPoint,ite_eq_right hf2] at hr
      exact QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.physical_left_analytic m a b c x ha hr.1 hr.2.1 hr.2.2 i j
    · subst η
      obtain ⟨BR,hR⟩ := QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physical_reconstruction m a b c ha
      refine ⟨{
        selection := QuantitativeArithmeticSmallLevelTwentySevenMinusGenericSourceBinding.selection
        A := QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physicalSource m a b c
        L := QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physicalLeft m a b c
        bound := BR
        left_meromorphic := fun x i j => QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physical_left_meromorphic _ _ _ _ x i j
        left_analytic := ?_
        reconstruction := hR
        source_action := fun z => QuantitativeArithmeticSmallLevelTwentySevenMinusGenericSourceBinding.source_action m f z
      }⟩
      intro x hx i j
      have hr := hx
      simp only [regularPoint,ite_eq_right hf2] at hr
      exact QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physical_left_analytic m a b c x ha hr.1 hr.2.1 hr.2.2 i j
#print axioms original_pole_chart
end QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
end
end

/-! ## TwentySevenPoleSystem -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 4000000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
open Matrix Complex Filter
open scoped Topology
open QuantitativeArithmeticSmallLevelTwentySevenObservation
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)

/-- The continued observable vector and a genuine reconstructed Taylor system.
The underlying607 additive coordinates are not asserted to continue. -/
structure PoleSystem (m : ℕ) (f : ℕ → ℂ) where
  B : ℝ
  G : ℂ → Fin 321 → ℂ
  L : ℂ → Matrix (Fin 321) (Fin 550) ℂ
  K : ℕ → ℂ → Matrix (Fin 550) (Fin 321) ℂ
  E : ℕ → ℂ → Fin 550 → ℂ
  meromorphic : ∀ i x, MeromorphicNFAt (fun z => G z i) x
  agreement : ∀ z, B<z.re → G z=basisMatrix *ᵥ originalVector m f z
  left_meromorphic : ∀ x i j, MeromorphicAt (fun z => L z i j) x
  left_analytic : ∀ x, regularPoint m f x → ∀ i j, AnalyticAt ℂ (fun z => L z i j) x
  shift_analytic : ∀ n x i j, AnalyticAt ℂ (fun z => K n z i j) x
  error : ∀ (n : ℕ) i z, B-((n:ℝ)+1)<z.re → AnalyticAt ℂ (fun w => E n w i) z
  rows : ∀ n z, B<z.re → G z=L z *ᵥ E n z+
    ∑ j∈Finset.range n, (L z*K j z) *ᵥ G (z+((j:ℂ)+1))

/-- All fields, including the continued row identities, are obtained from
original Euler/Fricke hypotheses; no local pole assertion is assumed. -/
theorem original_pole_system (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) : Nonempty (PoleSystem m f) := by
  obtain ⟨η,B₀,E,hη,he,hr⟩ := family_system m hm hf
  obtain ⟨C⟩ := original_pole_chart m f η hη
  obtain ⟨BG,G,hG,hagree⟩ := original_observations_meromorphic m hm hf
  let B := max B₀ (max C.bound BG)
  have hB₀ : B₀≤B := le_max_left _ _
  have hBR : C.bound≤B := le_trans (le_max_left _ _) (le_max_right _ _)
  have hBG : BG≤B := le_trans (le_max_right _ _) (le_max_right _ _)
  refine ⟨{
    B := B
    G := G
    L := C.L
    K := selectedCoefficient C.selection m η
    E := fun n z i => E (C.selection i) n z
    meromorphic := hG
    agreement := fun z hz => hagree z (lt_of_le_of_lt hBG hz)
    left_meromorphic := C.left_meromorphic
    left_analytic := C.left_analytic
    shift_analytic := fun n x i j => kindCoefficient_analytic (C.selection i) m η n x j
    error := ?_
    rows := ?_
  }⟩
  · intro n i z hz
    apply he (C.selection i) n z
    linarith
  · intro n z hz
    have h := family_selection C.selection m f η B₀ E hr n z (lt_of_le_of_lt hB₀ hz)
    rw [← C.source_action z] at h
    have hl := congrArg (fun v => C.L z *ᵥ v) h
    simp only [Matrix.mulVec_add,Matrix.mulVec_sum,Matrix.mulVec_mulVec] at hl
    rw [C.reconstruction z (lt_of_le_of_lt hBR hz)] at hl
    rw [hagree z (lt_of_le_of_lt hBG hz),hl]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    have hs : BG<(z+((j:ℂ)+1)).re := by
      simp only [Complex.add_re,Complex.natCast_re,Complex.one_re]
      linarith [Nat.cast_nonneg (α:=ℝ) j]
    rw [hagree _ hs]
    simp only [Matrix.mulVec_mulVec,Matrix.mul_assoc]

theorem PoleSystem.continued_rows {m : ℕ} {f : ℕ → ℂ} (S : PoleSystem m f)
    (n : ℕ) (i : Fin 321) (x : ℂ) (hx : S.B-((n:ℝ)+1)<x.re) :
    (fun z => S.G z i)=ᶠ[𝓝[≠] x]
      (fun z => (S.L z *ᵥ S.E n z) i+∑ a∈Finset.range n,
        ∑ j : Fin 321, (S.L z*S.K a z) i j*S.G (z+((a:ℂ)+1)) j) := by
  have hC (a : ℕ) (x : ℂ) (i j : Fin 321) :
      MeromorphicAt (fun z => (S.L z*S.K a z) i j) x := by
    change MeromorphicAt (fun z => ∑ t : Fin 550, S.L z i t*S.K a z t j) x
    apply MeromorphicAt.fun_sum
    intro t _
    exact (S.left_meromorphic x i t).mul (S.shift_analytic a x t j).meromorphicAt
  have hH (a : ℕ) (i : Fin 321) (x : ℂ) (hx : S.B-((a:ℝ)+1)<x.re) :
      MeromorphicAt (fun z => (S.L z *ᵥ S.E a z) i) x := by
    change MeromorphicAt (fun z => ∑ t : Fin 550, S.L z i t*S.E a z t) x
    apply MeromorphicAt.fun_sum
    intro t _
    exact (S.left_meromorphic x i t).mul (S.error a t x hx).meromorphicAt
  have h := QuantitativeArithmeticMeromorphicRows.continued_rows S.B S.G S.G
    (fun _ => 1) (fun a z => S.L z*S.K a z) (fun a z => S.L z *ᵥ S.E a z)
    (fun i x => (S.meromorphic i x).meromorphicAt) (fun _ _ => rfl)
    (fun x _ _ => MeromorphicAt.const _ x) hC hH
    (by intro a z hz; simpa only [Matrix.one_mulVec] using S.rows a z hz) n i x hx
  have hi (z : ℂ) : (∑ j : Fin 321, (1:Matrix (Fin 321) (Fin 321) ℂ) i j*S.G z j)=S.G z i := by
    change ((1:Matrix (Fin 321) (Fin 321) ℂ) *ᵥ S.G z) i=S.G z i
    rw [Matrix.one_mulVec]
  simpa only [hi] using h

/-- If every positive translate is regular, a pole must lie on an explicit
pivot divisor. This is the nonexceptional part of the local pole rule. -/
theorem PoleSystem.regular_at {m : ℕ} {f : ℕ → ℂ} (S : PoleSystem m f)
    (x : ℂ) (hx : regularPoint m f x)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z j) (x+n)) (i : Fin 321) :
    AnalyticAt ℂ (fun z => S.G z i) x := by
  obtain ⟨n,hn⟩ := exists_nat_gt (S.B-x.re)
  have hb : S.B-((n:ℝ)+1)<x.re := by linarith
  have hE : AnalyticAt ℂ (fun z => (S.L z *ᵥ S.E n z) i) x := by
    change AnalyticAt ℂ (fun z => ∑ t : Fin 550, S.L z i t*S.E n z t) x
    apply Finset.analyticAt_fun_sum
    intro t _
    exact (S.left_analytic x hx i t).mul (S.error n t x hb)
  have hT : AnalyticAt ℂ (fun z => ∑ a∈Finset.range n,
      ∑ j : Fin 321, (S.L z*S.K a z) i j*S.G (z+((a:ℂ)+1)) j) x := by
    apply Finset.analyticAt_fun_sum
    intro a _
    apply Finset.analyticAt_fun_sum
    intro j _
    have hC : AnalyticAt ℂ (fun z => (S.L z*S.K a z) i j) x := by
      change AnalyticAt ℂ (fun z => ∑ t : Fin 550, S.L z i t*S.K a z t j) x
      apply Finset.analyticAt_fun_sum
      intro t _
      exact (S.left_analytic x hx i t).mul (S.shift_analytic a x t j)
    have hG : AnalyticAt ℂ (fun z => S.G z j) (x+((a:ℂ)+1)) := by
      apply (S.meromorphic j _).meromorphicOrderAt_nonneg_iff_analyticAt.mp
      simpa only [Nat.cast_add,Nat.cast_one] using hshift (a+1) (by omega) j
    exact hC.mul (hG.comp (f:=fun z : ℂ => z+((a:ℂ)+1)) (analyticAt_id.add analyticAt_const))
  have hg : QuantitativeArithmeticAnalyticGerm.HasAnalyticGerm (fun z => S.G z i) x :=
    ⟨_,hE.add hT,S.continued_rows n i x hb⟩
  exact hg.analyticAt (S.meromorphic i x)
#print axioms original_pole_system
#print axioms PoleSystem.continued_rows
#print axioms PoleSystem.regular_at
end QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
end
end

/-! ## TwentySevenObservedSourceChart -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenObservedSourceChart
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point originalVector)
open QuantitativeArithmeticSmallLevelTwentySevenShiftSource (basisValues_original)

structure Chart (d r m : ℕ) (f : ℕ → ℂ) (η : ℂ) where
  selection : Fin d → Source
  A : ℂ → Matrix (Fin d) (Fin 607) ℂ
  L : ℂ → Matrix (Fin 321) (Fin d) ℂ
  pivot : Fin r → ℂ → ℂ
  left_meromorphic : ∀ x i j, MeromorphicAt (fun z => L z i j) x
  left_analytic : ∀ x, (∀ t, pivot t x ≠ 0) → ∀ i j, AnalyticAt ℂ (fun z => L z i j) x
  pivot_analytic : ∀ t x, AnalyticAt ℂ (pivot t) x
  reconstruction : ∀ x, (∀ t, pivot t x ≠ 0) → L x*A x=basisMatrix
  source_action : ∀ x, A x *ᵥ originalVector m f x=fun i => row (selection i) m f η x

/-- An original-source chart regular at x excludes a highest observable pole
there. It never continues the607 individual additive coordinates. -/
theorem regular_at {d r m : ℕ} [NeZero d] (hm : 0 < m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (η : ℂ) (hη : η=1 ∨ η= -1)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw point m f η)
    (C : Chart d r m f η) (x : ℂ) (hx : ∀ t, C.pivot t x ≠ 0)
    (hshift : ∀ n : ℕ, 0 < n → ∀ j : Fin 321,
      0 ≤ meromorphicOrderAt (fun z => S.G z j) (x+n)) (i : Fin 321) :
    AnalyticAt ℂ (fun z => S.G z i) x := by
  obtain ⟨B0,E,hE⟩ := original_family C.selection m hm hf η hη hlaw
  let B := max B0 S.B
  have hB0 : B0 ≤ B := le_max_left _ _
  have hBG : S.B ≤ B := le_max_right _ _
  let K : ℕ → ℂ → Matrix (Fin d) (Fin 321) ℂ :=
    fun n z i j => coefficient (C.selection i) m η n z j
  let error : ℕ → ℂ → Fin d → ℂ := fun n z i => E i n z
  have hrow (n : ℕ) (z : ℂ) (hz : B < z.re) (hpz : ∀ t, C.pivot t z ≠ 0) :
      S.G z=C.L z *ᵥ error n z+
        ∑ j∈Finset.range n, (C.L z*K j z) *ᵥ S.G (z+((j:ℂ)+1)) := by
    have h : C.A z *ᵥ originalVector m f z=error n z+
        ∑ j∈Finset.range n, K j z *ᵥ (basisMatrix *ᵥ originalVector m f (z+((j:ℂ)+1))) := by
      rw [C.source_action]
      funext t
      simpa only [K,error,Pi.add_apply,Finset.sum_apply,Matrix.mulVec,dotProduct,
        basisValues_original,Nat.cast_add,Nat.cast_one] using (hE t n).2 z (lt_of_le_of_lt hB0 hz)
    have hl := congrArg (fun v => C.L z *ᵥ v) h
    simp only [Matrix.mulVec_add,Matrix.mulVec_sum,Matrix.mulVec_mulVec] at hl
    rw [C.reconstruction z hpz] at hl
    rw [S.agreement z (lt_of_le_of_lt hBG hz),hl]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    have hs : S.B < (z+((j:ℂ)+1)).re := by
      simp only [Complex.add_re,Complex.natCast_re,Complex.one_re]
      linarith [Nat.cast_nonneg (α:=ℝ) j]
    rw [S.agreement _ hs]
    simp only [Matrix.mulVec_mulVec,Matrix.mul_assoc]
  apply QuantitativeArithmeticLocalPoleReconstruction.regular_at B S.G C.L K error
    C.pivot x S.meromorphic C.left_meromorphic (C.left_analytic x hx)
    (fun n z t j => coefficient_analytic (C.selection t) m η n z j)
    _ C.pivot_analytic hx hrow hshift i
  intro n t z hz
  apply (hE t n).1 z
  change B0-((n:ℝ)+1)<z.re
  linarith

#print axioms regular_at
end QuantitativeArithmeticSmallLevelTwentySevenObservedSourceChart
end
end

/-! ## TwentySevenOriginalBoundedTaylor -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySeven
open FinitenessOriginalInput FinitenessOriginalFourier FinitenessFourierConstruction
open FinitenessNormalizedTwistProduct FinitenessRamanujanFourier
open SmallLevelAdditive SmallLevelTaylor Complex Set MeasureTheory
/-- The sign is chosen once for every modulus. Highly ramified level27 has
no modulus-dependent root factor. -/
theorem original_twisted_bounded_taylor (m : ℕ) {f : ℕ → ℂ} (hf : IsSolution 27 (2*m) f) :
    ∃ η : ℂ, (η=1 ∨ η= -1) ∧ ∀ q : ℕ, 0<q → ∀ r : ℝ, r≠0 →
      ∃ B : ℝ, ∀ M : ℕ,
        AnalyticOnNhd ℂ (mellin (frickeError (2*m) (fullCoefficients (twisted f q) (2*m))
          (Nat.lcm 27 (q^2)) r η M)) {s : ℂ | B-(M:ℝ)<s.re} ∧
        QuantitativeArithmeticMellinStrip.BoundedSubstrips (B-(M:ℝ))
          (mellin (frickeError (2*m) (fullCoefficients (twisted f q) (2*m))
            (Nat.lcm 27 (q^2)) r η M)) ∧
        ∀ s : ℂ, B<s.re →
          transform (fullCoefficients (twisted f q) (2*m)) r s-
            η*(((Nat.lcm 27 (q^2):ℝ)*r^2:ℝ):ℂ)^(s-(((2*m:ℕ):ℂ)/2))*
              normalizedTaylorSum (2*m) (fullCoefficients (twisted f q) (2*m))
                (Nat.lcm 27 (q^2)) r M s=
            mellin (frickeError (2*m) (fullCoefficients (twisted f q) (2*m))
              (Nat.lcm 27 (q^2)) r η M) s := by
  obtain ⟨ε,hε,hlaw⟩ := original_ramanujan_bounded_taylor_rows (by decide : 0<27) (even_two_mul m) hf
  refine ⟨ε*I^(2*m),physical_sign m hε,?_⟩
  intro q hq r hr
  simpa only [ramanujan_root,one_mul] using hlaw q hq r hr

/-- Every Ramanujan Taylor row is an actual finite sum of additive-twist
transforms. No continuation of the individual twists is assumed. -/
theorem original_ramanujan_bounded_rows (m : ℕ) {f : ℕ → ℂ} (hf : IsSolution 27 (2*m) f) :
    ∃ η : ℂ, (η=1 ∨ η= -1) ∧ ∀ q : ℕ, 0<q → ∀ r : ℝ, r≠0 →
      ∃ B : ℝ, ∀ M : ℕ,
        AnalyticOnNhd ℂ (mellin (frickeError (2*m) (fullCoefficients (twisted f q) (2*m))
          (Nat.lcm 27 (q^2)) r η M)) {s : ℂ | B-(M:ℝ)<s.re} ∧
        QuantitativeArithmeticMellinStrip.BoundedSubstrips (B-(M:ℝ))
          (mellin (frickeError (2*m) (fullCoefficients (twisted f q) (2*m))
            (Nat.lcm 27 (q^2)) r η M)) ∧
        ∀ s : ℂ, B<s.re →
          ramanujanAdditive (2*m) f q r s-
            η*(((Nat.lcm 27 (q^2):ℝ)*r^2:ℝ):ℂ)^(s-(((2*m:ℕ):ℂ)/2))*
              ramanujanTaylorSum (2*m) f q (Nat.lcm 27 (q^2)) r M s=
            mellin (frickeError (2*m) (fullCoefficients (twisted f q) (2*m))
              (Nat.lcm 27 (q^2)) r η M) s := by
  obtain ⟨η,hη,ht⟩ := original_twisted_bounded_taylor m hf
  refine ⟨η,hη,?_⟩
  intro q hq r hr
  obtain ⟨B,hB⟩ := ht q hq r hr
  obtain ⟨C,hC⟩ := ramanujan_additive_sum hf q
  refine ⟨max B C,?_⟩
  intro M
  refine ⟨?_, (hB M).2.1.mono (sub_le_sub_right (le_max_left _ _) _), ?_⟩
  · intro s hs
    apply (hB M).1 s
    change max B C-(M:ℝ)<s.re at hs
    change B-(M:ℝ)<s.re
    linarith [le_max_left B C]
  · intro s hs
    have hsB : B<s.re := lt_of_le_of_lt (le_max_left _ _) hs
    have hsC : C<s.re := lt_of_le_of_lt (le_max_right _ _) hs
    have hm := (hB M).2.2 s hsB
    rw [hC r s hsC] at hm
    have he : normalizedTaylorSum (2*m) (fullCoefficients (twisted f q) (2*m))
        (Nat.lcm 27 (q^2)) r M s=ramanujanTaylorSum (2*m) f q (Nat.lcm 27 (q^2)) r M s := by
      unfold normalizedTaylorSum ramanujanTaylorSum ramanujanAdditive
      apply Finset.sum_congr rfl
      intro n _
      rw [hC _ (s+(n:ℂ)) (by
        simp only [Complex.add_re,Complex.natCast_re]
        exact lt_of_lt_of_le hsC (le_add_of_nonneg_right (Nat.cast_nonneg n)))]
    rw [he] at hm
    exact hm
#print axioms original_twisted_bounded_taylor
#print axioms original_ramanujan_bounded_rows
end QuantitativeArithmeticSmallLevelTwentySeven
end
end

/-! ## TwentySevenRamanujanBoundedSplit -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySeven
open FinitenessOriginalInput FinitenessOriginalFourier FinitenessFourierConstruction
open FinitenessRamanujanFourier SmallLevelAdditive SmallLevelTaylor Complex Set MeasureTheory

/-- The actual leading and positive-shift source rows, with one sign for all
moduli. This does not assert closure of any finite observation space. -/
theorem original_ramanujan_bounded_split (m : ℕ) {f : ℕ → ℂ} (hf : IsSolution 27 (2*m) f) :
    ∃ η : ℂ, (η=1 ∨ η= -1) ∧ ∀ q : ℕ, 0<q → ∀ r : ℝ, r≠0 →
      ∃ B : ℝ, ∀ M : ℕ,
        AnalyticOnNhd ℂ (mellin (frickeError (2*m) (fullCoefficients (twisted f q) (2*m))
          (Nat.lcm 27 (q^2)) r η (M+1))) {s : ℂ | B-((M:ℝ)+1)<s.re} ∧
        QuantitativeArithmeticMellinStrip.BoundedSubstrips (B-((M:ℝ)+1))
          (mellin (frickeError (2*m) (fullCoefficients (twisted f q) (2*m))
            (Nat.lcm 27 (q^2)) r η (M+1))) ∧
        ∀ s : ℂ, B<s.re →
          ramanujanAdditive (2*m) f q r s-
            taylorRowScalar (2*m) (Nat.lcm 27 (q^2)) r η 0 s*
              ramanujanAdditive (2*m) f q (-1/((Nat.lcm 27 (q^2):ℝ)*r)) s=
            mellin (frickeError (2*m) (fullCoefficients (twisted f q) (2*m))
              (Nat.lcm 27 (q^2)) r η (M+1)) s+
            ∑ n∈Finset.range M,
              taylorRowScalar (2*m) (Nat.lcm 27 (q^2)) r η (n+1) s*
                ramanujanAdditive (2*m) f q (-1/((Nat.lcm 27 (q^2):ℝ)*r)) (s+((n+1:ℕ):ℂ)) := by
  obtain ⟨η,hη,ht⟩ := original_ramanujan_bounded_rows m hf
  refine ⟨η,hη,?_⟩
  intro q hq r hr
  obtain ⟨B,hB⟩ := ht q hq r hr
  refine ⟨B,?_⟩
  intro M
  refine ⟨?_,?_,?_⟩
  · simpa only [Nat.cast_add,Nat.cast_one] using (hB (M+1)).1
  · simpa only [Nat.cast_add,Nat.cast_one] using (hB (M+1)).2.1
  · intro s hs
    have h := (hB (M+1)).2.2 s hs
    rw [ramanujanTaylorSum_split] at h
    linear_combination h
#print axioms original_ramanujan_bounded_split
end QuantitativeArithmeticSmallLevelTwentySeven
end
