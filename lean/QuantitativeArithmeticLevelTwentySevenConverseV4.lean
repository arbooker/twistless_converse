theorem defect_first_word : defectGL 0=baseGL 1*baseGL 3*baseGL 1 := by
  rw [base_RS]
  exact (lift_mul (baseMatrix 6) (baseMatrix 1) (defectMatrix 0)
    (baseGL_valid 6) (baseGL_valid 1) (defectGL_valid 0) (by decide)).symm

theorem defect_second_word : defectGL 1=baseGL 2*baseGL 3 :=
  (lift_mul (baseMatrix 2) (baseMatrix 3) (defectMatrix 1)
    (baseGL_valid 2) (baseGL_valid 3) (defectGL_valid 1) (by decide)).symm

theorem original_defect_trace {f : ℕ → ℂ} (m : ℕ)
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    defect m (scaledFunction (2*m) f)=
      (scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] baseGL 3)+
      ((scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] baseGL 3) ∣[((2*m:ℕ):ℤ)] baseGL 1)+
      ((scaledFunction (2*m) f ∣[((2*m:ℕ):ℤ)] baseGL 3) ∣[((2*m:ℕ):ℤ)] baseGL 2) := by
  let F := scaledFunction (2*m) f
  have hc := original_commutator m hf 0
  change (F ∣[((2*m:ℕ):ℤ)] baseGL 5)-(F ∣[((2*m:ℕ):ℤ)] baseGL 6)=0 at hc
  have he := sub_eq_zero.mp hc
  rw [← base_SR,← base_RS,SlashAction.slash_mul,SlashAction.slash_mul] at he
  have ht := original_upper_cubic hf.toEulerData m
  have hs := congrArg (fun G : ℍ → ℂ => G ∣[((2*m:ℕ):ℤ)] baseGL 3) ht
  rw [SlashAction.add_slash,SlashAction.add_slash,SlashAction.zero_slash,← he] at hs
  have hr := congrArg (fun G : ℍ → ℂ => G ∣[((2*m:ℕ):ℤ)] baseGL 1) he
  rw [defect,defect_first_word,defect_second_word,← base_upper_square]
  simp only [SlashAction.slash_mul]
  funext z
  have hs' := congrFun hs z
  have hr' := congrFun hr z
  simp only [Pi.add_apply,Pi.zero_apply] at hs'
  simp only [Pi.sub_apply,Pi.add_apply]
  dsimp only [F] at he hr' hs'
  linear_combination -hr' - hs'
#print axioms original_defect_trace
end QuantitativeArithmeticSmallLevelTwentySeven
end
