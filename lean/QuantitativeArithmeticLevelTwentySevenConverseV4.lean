theorem source_action (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physicalSource m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5)
      ((Real.sqrt 7:ℂ)*f 7) s *ᵥ originalVector m f s=selectedRows selection m f (-1) s := by
  funext i
  have hv : (QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physicalSource m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5)
      ((Real.sqrt 7:ℂ)*f 7) s *ᵥ originalVector m f s) i=
      physicalEval (QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.inputs i.val) m f s := by
    simpa only [QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.physicalSource,QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.sourceMatrix,physicalEval,originalVector,
      QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.primeRate,QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate,Matrix.mulVec,dotProduct] using
      (eval_bounded_eq_sum (QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.primeRate 2 m s) (QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.primeRate 3 m s)
        (QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.primeRate 5 m s) (QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.primeRate 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7)
        (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) s)
        (QuantitativeArithmeticSmallLevelTwentySevenMinusGenericStages.inputs i.val) (input_support i)).symm
  rw [hv,input_binding]
  simpa only [Rat.cast_neg,Rat.cast_one,selectedRows] using
