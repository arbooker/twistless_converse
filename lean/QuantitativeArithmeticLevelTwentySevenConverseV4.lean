theorem original_regular (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (hf2 : f 2=0)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m f (1:ℂ))
    (S : PoleSystem m f) (s : ℂ) (hs : s≠((2*m:ℕ):ℂ))
    (hF : ∀ i : Fin 8, QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusStages.factorValue
      (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
      ((Real.sqrt 5:ℂ)*f 5) i.val≠0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z j) (s+n)) (i : Fin 321) :
    AnalyticAt ℂ (fun z => S.G z i) s := by
  have hd : QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusOriginalChart.divisor m 1 s≠0 := by
