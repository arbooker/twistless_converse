/-! ## TwentySevenFourthCertificateAnalytic -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily.Certificate
open QuantitativeArithmeticTaylorLayerNormalization
open QuantitativeArithmeticAnalyticGerm
open QuantitativeArithmeticSmallLevelTwentySevenShiftSource (basisValues)
variable {ε : ℚ} {profile : ℕ → ℚ} {m : ℕ}

def correction (C : Certificate ε profile m) (G : ℂ → Fin 321 → ℂ)
    (anchor : ℂ → ℂ) (s : ℂ) : ℂ :=
  ∑ i : Fin 340, C.weight s i*topCorrection (selected i) ε profile m (depth i) G anchor s

def residual (C : Certificate ε profile m) (G : ℂ → Fin 321 → ℂ)
    (anchor : ℂ → ℂ) (s : ℂ) : ℂ := C.scalar s*anchor s-C.correction G anchor s

def prefixWeight (C : Certificate ε profile m) (s : ℂ) (i : Fin 340) : ℂ :=
  C.weight s i/scale (s-((2*m:ℕ):ℂ)) (depth i)

theorem prefixWeight_meromorphic (C : Certificate ε profile m) (i : Fin 340) (s : ℂ) :
    MeromorphicAt (fun z => C.prefixWeight z i) s :=
  (C.weight_analytic i s).meromorphicAt.div (layer_scale_analytic (2*m) (depth i) s).meromorphicAt

theorem prefixWeight_analytic_at_resonance (C : Certificate ε profile m) (hm : 1 < m) (i : Fin 340) :
    AnalyticAt ℂ (fun z => C.prefixWeight z i) ((m:ℂ)+1) :=
  (C.weight_analytic i _).div (layer_scale_analytic (2*m) (depth i) _)
    (original_resonance_scale_nonzero m hm (depth i))

theorem residual_meromorphic (C : Certificate ε profile m) (G : ℂ → Fin 321 → ℂ)
    (anchor : ℂ → ℂ) (hG : ∀ j s, MeromorphicAt (fun z => G z j) s)
    (ha : ∀ s, MeromorphicAt anchor s) (s : ℂ) : MeromorphicAt (C.residual G anchor) s := by
  apply ((C.scalar_analytic s).meromorphicAt.mul (ha s)).sub
  apply MeromorphicAt.fun_sum
  intro i hi
  apply (C.weight_analytic i s).meromorphicAt.mul
  apply MeromorphicAt.sub
  · apply MeromorphicAt.fun_sum
    intro j hj
    exact (topCoefficient_meromorphic (selected i) ε m (depth i) s j).mul (hG j s)
  · exact (topScalar_analytic (selected i) ε profile m (depth i) s).meromorphicAt.mul (ha s)

theorem correction_germ (C : Certificate ε profile m) (hm : 1 < m)
    (G : ℂ → Fin 321 → ℂ) (anchor : ℂ → ℂ)
    (hprofile : ∀ j, HasAnalyticGerm (fun z => G z j-
      basisValues (fun t => (profile t:ℂ)) j*anchor z) ((m:ℂ)+1))
    (ha : MeromorphicAt anchor ((m:ℂ)+1))
    (ho : (-1:WithTop ℤ)≤meromorphicOrderAt anchor ((m:ℂ)+1)) :
    HasAnalyticGerm (C.correction G anchor) ((m:ℂ)+1) := by
  apply HasAnalyticGerm.sum
  intro i
  exact (topCorrection_germ (selected i) ε profile m (depth i) hm (depth_bounds i).1
    G anchor hprofile ha ho).mul_analytic (C.weight_analytic i _)

theorem initial_identity (C : Certificate ε profile m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (anchor : ℂ → ℂ) (s : ℂ)
    (hscale : ∀ j ≤ 4, scale (s-((2*m:ℕ):ℂ)) j≠0)
    (ha2 : (Real.sqrt 2:ℂ)*f 2= -3/2) (ha5 : (Real.sqrt 5:ℂ)*f 5= -3)
    (ha7 : (Real.sqrt 7:ℂ)*f 7= -25/7) :
    C.residual (originalObservations m f) anchor s=
      ∑ i : Fin 340, C.prefixWeight s i*sourcePrefix (selected i) m f ε (depth i) s := by
  classical
  have h := C.identity s (physicalCoordinates (originalCoordinates m f) m anchor s)
  rw [physicalCoordinates_top] at h
  have hi (i : Fin 340) := normalizedRow_eq_original_prefix (selected i) (selected_supported i)
    ε profile m (depth i) hf anchor s (depth_bounds i).1 (depth_bounds i).2
    (fun j hj => hscale j (le_trans hj (depth_bounds i).2)) ha2 ha5 ha7
  simp_rw [hi] at h
  simp only [mul_add,Finset.sum_add_distrib,← mul_div_assoc] at h
  simp only [residual,correction,prefixWeight,div_mul_eq_mul_div]
  linear_combination -h

#print axioms correction_germ
#print axioms initial_identity
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily.Certificate
