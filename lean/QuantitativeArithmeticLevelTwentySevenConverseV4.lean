    rw [he]
    exact mul_ne_zero Complex.I_ne_zero (sub_ne_zero.mpr hs)
  have hp (j : Fin 971) : QuantitativeArithmeticSmallLevelTwentySevenZeroJetCommonPlusOriginalChart.pivot m f j s≠0 := by
    by_cases hj : j.val<970
