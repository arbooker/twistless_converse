/-! ## TwentySevenCuspMellin -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenShiftSource (basisValues basisValues_original)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point)

theorem ninth_observation (m : ℕ) (f : ℕ → ℂ) (S : PoleSystem m f)
    (s : ℂ) (hs : S.B<s.re) : S.G s 6=SmallLevelAdditive.original (2*m) f (1/9) s := by
  rw [S.agreement s hs,← basisValues_original]
  have hb : QuantitativeArithmeticSmallLevelTwentySevenObservation.basis 6=[((1:ℚ),6)] := by decide +kernel
  have hp : point 6=(1/9:ℚ) := by norm_num [point,QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.pointPart0]
  change QuantitativeArithmeticRationalRows.eval
    (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) s)
    (QuantitativeArithmeticSmallLevelTwentySevenObservation.basis 6)=_
  rw [hb]
  norm_num [QuantitativeArithmeticRationalRows.eval,hp]


/-- The actual additive Mellin transform at1/9 continues as an entire
function plus a single simple weight pole. Growth estimates remain separate. -/
theorem ninth_entire_part (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ (B : ℝ) (F : ℂ → ℂ) (r : ℂ),Differentiable ℂ F ∧
      ∀ s : ℂ,B<s.re → SmallLevelAdditive.original (2*m) f (1/9) s=
        F s+r/(s-((2*m:ℕ):ℂ)) := by
  obtain ⟨S⟩ := QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.original_pole_system m hm hf
  obtain ⟨F,r,hF,he⟩ := QuantitativeArithmeticSimplePole.entire_part (fun z => S.G z 6)
    ((2*m:ℕ):ℂ) (S.meromorphic 6 _).meromorphicAt ((pole_orders m hm hf S).1 6)
    (fun z hz => analytic_away m hm hf S z hz 6)
  refine ⟨max S.B (2*(m:ℝ)),F,r,hF,?_⟩
  intro s hs
  rw [← ninth_observation m f S s ((le_max_left _ _).trans_lt hs)]
  apply he s
  intro h
  subst s
  norm_num at hs
#print axioms ninth_observation
#print axioms ninth_entire_part
end QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule
end
end

