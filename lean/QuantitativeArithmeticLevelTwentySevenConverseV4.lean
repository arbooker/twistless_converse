/-! ## TwentySevenPoleGrid -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenOriginalLocalPoleRule
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate)
open QuantitativeArithmeticSmallLevelTwentySevenPoleSource (firstQuadratic)

/-- Every pole lies below a genuine weight pole on its integer translation grid. -/
theorem pole_grid (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (s : ℂ) (hp : ∃ i,meromorphicOrderAt (fun z => S.G z i) s<0) :
    ∃ n : ℕ, s+n=((2*m:ℕ):ℂ) ∧
      ∃ i,meromorphicOrderAt (fun z => S.G z i) ((2*m:ℕ):ℂ)<0 := by
  obtain ⟨B,hB⟩ := S.analytic_halfplane hf
  obtain ⟨n,hpole,hshift⟩ := SmallLevelPoleGrid.rightmost_pole (fun j z => S.G z j) hp B hB
  have he : s+n=((2*m:ℕ):ℂ) := by
    by_contra h
    obtain ⟨j,hj⟩ := hpole
    exact (not_lt_of_ge ((highest_pole_rule m hm hf S (s+n) hshift).2 h j)) hj
  exact ⟨n,he,by rwa [← he]⟩

theorem weight_divisor (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (hp : ∃ i,meromorphicOrderAt (fun z => S.G z i) ((2*m:ℕ):ℂ)<0) :
    f 2≠0 ∧ firstQuadratic m f ((2*m:ℕ):ℂ)=0 := by
  have hf2 : f 2≠0 := by
    intro h
    obtain ⟨i,hi⟩ := hp
    exact (not_lt_of_ge (zero_entire m hm hf S h _ i).meromorphicOrderAt_nonneg) hi
  refine ⟨hf2,?_⟩
  have hn : ‖primeRate 2 m ((2*m:ℕ):ℂ)‖≠1 := by
    apply ne_of_gt
    apply QuantitativeArithmeticSmallLevelTwentySevenGenericLocalPoleRule.rate_norm_gt_one
    norm_num
    exact_mod_cast (by omega : m<2*m)
  obtain ⟨hminus,hplus,_⟩ := QuantitativeArithmeticSmallLevelTwentySevenLocalPoleRule.off_unit_divisors _ hn
  obtain ⟨i,hi⟩ := hp
  have hD := S.pole_divisor ((2*m:ℕ):ℂ) (fun n hn => by
    apply above_weight m hm hf S
    have hn' : (0:ℝ)<n := by exact_mod_cast hn
    norm_num
    linarith) i hi
  simpa only [QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.pivotDivisor,
    firstQuadratic,ite_eq_right hf2,mul_eq_zero,hminus,hplus,false_or] using hD

theorem primeRate_real (m : ℝ) (t : ℝ) :
    primeRate 2 m (t:ℂ)=(Real.exp (Real.log 2*(t-m)):ℂ) := by
  simp only [primeRate,Complex.ofReal_exp,Complex.ofReal_mul,Complex.ofReal_sub]

/-- A quadratic with constant coefficient -1 has at most one positive real root,
even when its linear coefficient is initially complex. -/
theorem quadratic_positive_unique (a : ℂ) (u v : ℝ) (hu : 0<u) (hv : 0<v)
    (hU : a*(u:ℂ)+(u:ℂ)^2-1=0) (hV : a*(v:ℂ)+(v:ℂ)^2-1=0) : u=v := by
  have he : ((u:ℂ)-(v:ℂ))*((u:ℂ)*(v:ℂ)+1)=0 := by
    linear_combination (v:ℂ)*hU-(u:ℂ)*hV
  have hn : (u:ℂ)*(v:ℂ)+1≠0 := by
    have hpos : 0<u*v+1 := by positivity
    exact_mod_cast (ne_of_gt hpos)
  exact Complex.ofReal_injective (sub_eq_zero.mp ((mul_eq_zero.mp he).resolve_right hn))

/-- Once the weight is a quadratic root, no different real point can be one. -/
theorem quadratic_off_weight (m : ℕ) (f : ℕ → ℂ)
    (hq : firstQuadratic m f ((2*m:ℕ):ℂ)=0) (s : ℂ) (n : ℕ)
    (hgrid : s+n=((2*m:ℕ):ℂ)) (hs : s≠((2*m:ℕ):ℂ)) :
    firstQuadratic m f s≠0 := by
  intro hz
  have he : s=((2*(m:ℝ)-(n:ℝ)):ℂ) := by
    push_cast at hgrid ⊢
    linear_combination hgrid
  have hkr : primeRate 2 m ((2*m:ℕ):ℂ)=(Real.exp (Real.log 2*(2*(m:ℝ)-m)):ℂ) := by
    convert primeRate_real (m:ℝ) (2*(m:ℝ)) using 1
    push_cast
    rfl
  have hsr : primeRate 2 m s=(Real.exp (Real.log 2*(2*(m:ℝ)-n-m)):ℂ) := by
    rw [he]
    convert primeRate_real (m:ℝ) (2*(m:ℝ)-n) using 1
    push_cast
    rfl
  unfold firstQuadratic at hq hz
  rw [hkr] at hq
  rw [hsr] at hz
  have hexp := quadratic_positive_unique ((Real.sqrt 2:ℂ)*f 2) _ _
    (Real.exp_pos _) (Real.exp_pos _) hz hq
  have ht := Real.exp_injective hexp
  have hlog : Real.log 2≠0 := ne_of_gt (Real.log_pos (by norm_num))
  have hn : (n:ℝ)=0 := by
    have hc := (mul_left_cancel₀ hlog ht)
    linarith
  have hn0 : n=0 := by exact_mod_cast hn
  apply hs
  simpa only [hn0,Nat.cast_zero,add_zero] using hgrid
#print axioms pole_grid
#print axioms weight_divisor
#print axioms quadratic_off_weight
end QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule
end
