/-! ## TwentySevenDefectConstant -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySeven
open UpperHalfPlane FinitenessOriginalInput
open QuantitativeArithmeticSmallLevelTwentySevenAffine QuantitativeArithmeticAffineOrbitRigidity
open scoped MatrixGroups ModularForm

def dilationFactors : Fin 4 → ℝ := ![2,4,4,4]
def dilationShifts : Fin 4 → ℝ := ![1,2,3,4]
def dilationCoefficients (m : ℕ) (a : ℂ) : Fin 4 → ℂ :=
  ![(2:ℂ)^m*a,(2:ℂ)^(2*m),-(2:ℂ)^(2*m),(2:ℂ)^(2*m)]

theorem factors_ge_two : ∀ i, 2≤dilationFactors i := by
  intro i; fin_cases i <;> norm_num [dilationFactors]
theorem shifts_nonneg : ∀ i, 0≤dilationShifts i := by
  intro i; fin_cases i <;> norm_num [dilationShifts]
theorem shifts_upper : ∀ i, dilationShifts i≤2*(dilationFactors i-1) := by
  intro i; fin_cases i <;> norm_num [dilationShifts,dilationFactors]

theorem original_dilation_sum {f : ℕ → ℂ} (m : ℕ) (hf : IsSolution 27 (2*m) f) (z : ℍ) :
    defect m (scaledFunction (2*m) f) z=
      ∑ i, dilationCoefficients m ((Real.sqrt 2:ℂ)*f 2) i*
        defect m (scaledFunction (2*m) f)
          (dilate (dilationFactors i) (dilationShifts i) (by linarith [factors_ge_two i]) z) := by
  have hh := original_dilation m hf z
  simp only [Fin.sum_univ_succ,dilationCoefficients,dilationFactors,dilationShifts,
    Matrix.cons_val_zero,Matrix.cons_val_succ,Fin.sum_univ_zero,add_zero]
  linear_combination hh

/-- Remaining analytic input is explicitly isolated: sectorial rapid
approach to a constant, to be derived from the additive-twist equations. -/
theorem original_defect_constant_of_sector_decay {f : ℕ → ℂ} (m : ℕ)
    (hf : IsSolution 27 (2*m) f) (a : ℂ)
    (hdecay : SectorDecay (fun z => defect m (scaledFunction (2*m) f) z-a)) :
    defect m (scaledFunction (2*m) f)=fun _ => a := by
  exact dilation_recursion_constant _ dilationFactors dilationShifts
    (dilationCoefficients m ((Real.sqrt 2:ℂ)*f 2)) a
    factors_ge_two shifts_nonneg shifts_upper (original_dilation_sum m hf)
    (sector_orbit_bound _ hdecay)
#print axioms original_dilation_sum
#print axioms original_defect_constant_of_sector_decay
end QuantitativeArithmeticSmallLevelTwentySeven
end
