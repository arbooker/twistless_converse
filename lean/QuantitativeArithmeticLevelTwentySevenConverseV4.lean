/-! ## TwentySevenPoleAnchorOriginal -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)
open QuantitativeArithmeticAnalyticGerm (HasAnalyticGerm)

/-- The actual anchored source family controls every continued observation
modulo an analytic germ, for either original Fricke sign. -/
theorem lift_anchor_for_continuation (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i x, MeromorphicNFAt (fun z => G z i) x)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z)
    (x : ℂ) (hx : liftRegularPoint m f x)
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => G z j) (x+n)) :
    ∃ J : ℂ → Fin 321 → ℂ, (∀ i, AnalyticAt ℂ (fun z => J z i) x) ∧
      ∀ i, HasAnalyticGerm (fun z => G z i-J z i*G z 6) x := by
  obtain ⟨η,B0,E,hη,he,hr⟩ := original_family m hm hf
  obtain ⟨C⟩ := original_lift_chart m f η hη
  let B := max B0 BG
  have hB0 : B0≤B := le_max_left _ _
  have hBG : BG≤B := le_max_right _ _
  let K := selectedCoefficient C.selection m η
  let error : ℕ → ℂ → Fin 550 → ℂ := fun n z j => E (C.selection j) n z
  let J : ℂ → Fin 321 → ℂ := fun z => C.L z *ᵥ (fun j => anchorFlag (C.selection j))
  have hJ (z : ℂ) (i : Fin 321) : MeromorphicAt (fun w => J w i) z := by
    change MeromorphicAt (fun w => ∑ j : Fin 550, C.L w i j*anchorFlag (C.selection j)) z
    apply MeromorphicAt.fun_sum
    intro j _
    exact (C.left_meromorphic z i j).mul (MeromorphicAt.const _ z)
  have hJx (i : Fin 321) : AnalyticAt ℂ (fun z => J z i) x := by
    change AnalyticAt ℂ (fun z => ∑ j : Fin 550, C.L z i j*anchorFlag (C.selection j)) x
    apply Finset.analyticAt_fun_sum
    intro j _
    exact (C.left_analytic x (C.pivots_nonzero x hx) i j).mul analyticAt_const
  have hrow (n : ℕ) (z : ℂ) (hz : B<z.re) (hpz : ∀ j, C.P j z≠0) :
      G z=C.L z *ᵥ error n z+(∑ j∈Finset.range n, (C.L z*K j z) *ᵥ G (z+((j:ℂ)+1)))+
        (fun i => J z i*G z 6) := by
    have h := family_selection C.selection m f η B0 E hr n z (lt_of_le_of_lt hB0 hz)
    rw [← C.source_action z] at h
    have hl := congrArg (fun v => C.L z *ᵥ v) h
    simp only [Matrix.mulVec_add,Matrix.mulVec_sum,Matrix.mulVec_mulVec] at hl
    rw [C.reconstruction z hpz] at hl
    apply (hagree z (lt_of_le_of_lt hBG hz)).trans
    apply hl.trans
    congr 1
    · congr 1
      apply Finset.sum_congr rfl
      intro j _
      have hs : BG<(z+((j:ℂ)+1)).re := by
        simp only [Complex.add_re,Complex.natCast_re,Complex.one_re]
        linarith [Nat.cast_nonneg (α:=ℝ) j]
      rw [hagree _ hs]
      simp only [K,Matrix.mulVec_mulVec,Matrix.mul_assoc]
    · rw [hagree z (lt_of_le_of_lt hBG hz)]
      funext i
      simp only [J,Matrix.mulVec,dotProduct,Finset.sum_mul,mul_assoc]
  refine ⟨J,hJx,?_⟩
  intro i
  apply QuantitativeArithmeticAnchoredPoleReconstruction.difference_has_analytic_germ B G C.L K error
    C.P J (fun z => G z 6) x hG C.left_meromorphic
    (C.left_analytic x (C.pivots_nonzero x hx))
    (fun n z j t => sourceCoefficient_analytic (C.selection j) m η n z t)
    _ C.pivot_analytic (C.pivots_nonzero x hx) hJ (fun z => (hG 6 z).meromorphicAt) hrow hshift i
  intro n j z hz
  apply he (C.selection j) n z
  linarith

/-- At any remaining nonboundary highest pole, the anchor itself has a pole
and its nonzero leading coefficient controls the whole observation vector. -/
theorem original_anchored_pole_system (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f,
      ∀ x : ℂ, f 2≠0 →
      QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate 2 m x-1≠0 →
      QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages.primeRate 2 m x+1≠0 →
      (∀ n : ℕ, 0<n → ∀ j : Fin 321,
        0≤meromorphicOrderAt (fun z => S.G z j) (x+n)) →
      (∃ i : Fin 321, meromorphicOrderAt (fun z => S.G z i) x<0) →
      meromorphicOrderAt (fun z => S.G z 6) x<0 ∧
      ∃ (J : ℂ → Fin 321 → ℂ) (v : Fin 321 → ℂ),
        (∀ j, AnalyticAt ℂ (fun z => J z j) x) ∧
        (∀ j, HasAnalyticGerm (fun z => S.G z j-J z j*S.G z 6) x) ∧
        QuantitativeArithmeticUniversalPoleVector.IsLeadingVector S.G x v ∧
        v 6≠0 ∧ ∀ j, v j=J x j*v 6 := by
  obtain ⟨S⟩ := QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.original_pole_system m hm hf
  refine ⟨S,?_⟩
  intro x hf2 hmns hpls hshift hpole
  have ha : (Real.sqrt 2:ℂ)*f 2≠0 := by
    apply mul_ne_zero _ hf2
    exact_mod_cast (Real.sqrt_pos.mpr (by norm_num : (0:ℝ)<2)).ne'
  obtain ⟨J,hJ,hrow⟩ := lift_anchor_for_continuation m hm hf S.B S.G S.meromorphic
    S.agreement x ⟨ha,hmns,hpls⟩ hshift
  have hanchor : meromorphicOrderAt (fun z => S.G z 6) x<0 := by
    by_contra hn
    have hga := (S.meromorphic 6 x).meromorphicOrderAt_nonneg_iff_analyticAt.mp (le_of_not_gt hn)
    obtain ⟨i,hi⟩ := hpole
    have hh := (hrow i).add (HasAnalyticGerm.of_analytic ((hJ i).mul hga))
    have hh' : HasAnalyticGerm (fun z => S.G z i) x := by
      simpa only [Pi.mul_apply,sub_add_cancel] using hh
    exact not_lt_of_ge hh'.order_nonneg hi
  obtain ⟨v,hv⟩ := QuantitativeArithmeticUniversalPoleVector.exists_leading_vector S.G x
    (fun j => (S.meromorphic j x).meromorphicAt) hpole
  obtain ⟨hva,hprofile⟩ := QuantitativeArithmeticAnchoredPoleVector.profile S.G x v hv 6 J hJ hrow
  exact ⟨hanchor,J,v,hJ,hrow,hv,hva,hprofile⟩

#print axioms original_anchored_pole_system
#print axioms lift_anchor_for_continuation
end QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
end
end

/-! ## TwentySevenPoleAnchorFamilyFixedSign -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point originalVector)
open QuantitativeArithmeticSmallLevelTwentySevenShiftSource (basisValues basisValues_original)
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (physicalEval)

theorem family_at_sign (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (η : ℂ) (hη : η=1 ∨ η= -1)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw point m f η) :
    ∃ (B : ℝ) (error : Kind → ℕ → ℂ → ℂ),
      (η=1 ∨ η= -1) ∧
      (∀ r : Kind, ∀ M : ℕ, ∀ s : ℂ, B-((M:ℝ)+1)<s.re →
        AnalyticAt ℂ (error r M) s) ∧
      ∀ r : Kind, ∀ M : ℕ, ∀ s : ℂ, B<s.re → sourceRow r m f η s=error r M s+
        (∑ n∈Finset.range M, sourceShift r m η n s
          (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) (s+((n:ℂ)+1))))+
        anchorFlag r*originalVector m f s 6 := by
  obtain ⟨B,E,_,ha,hr⟩ := QuantitativeArithmeticSmallLevelTwentySevenPoleSource.family_at_sign m hm hf η hη hlaw
  let err : Kind → ℕ → ℂ → ℂ := fun r M s => match r with
    | some t => E t M s
    | none => 0
  refine ⟨B,err,hη,?_,?_⟩
  · intro r M s hs
    cases r with
    | some t => exact ha t M s hs
    | none => exact analyticAt_const
  · intro r M s hs
    cases r with
    | some t => simpa only [sourceRow,sourceShift,anchorFlag,err,zero_mul,add_zero] using hr t M s hs
    | none => simp [sourceRow,sourceShift,anchorFlag,err]

#print axioms family_at_sign
end QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
end
end

