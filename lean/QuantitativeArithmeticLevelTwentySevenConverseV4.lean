/-! ## TwentySevenResidues -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 200000
set_option maxHeartbeats 2000000
@[expose] public section
namespace QuantitativeArithmeticSmallLevelTwentySevenOrbit
open Matrix ModularGroup SmallLevelGenerators
open scoped MatrixGroups

theorem raw_cases (a b c d : ZMod 9) (hdet : a*d-b*c=1) (hc : c.val%3=0) :
    rawCoeff a (a+b) c=stepR (rawCoeff a b c) ∧
    rawCoeff (a+3*b) b (c+3*d)=stepS (rawCoeff a b c) ∧
    rawCoeff (-a) (-b) (-c)=rawCoeff a b c := by
  fin_cases a
  · exact raw_case_0 b c d hdet hc
  · exact raw_case_1 b c d hdet hc
  · exact raw_case_2 b c d hdet hc
  · exact raw_case_3 b c d hdet hc
  · exact raw_case_4 b c d hdet hc
  · exact raw_case_5 b c d hdet hc
  · exact raw_case_6 b c d hdet hc
  · exact raw_case_7 b c d hdet hc
  · exact raw_case_8 b c d hdet hc

theorem residue_R (A : Residue) (hA : good A) :
    residueCoeff (A*reduction 9 T)=stepR (residueCoeff A) := by
  have h := (raw_cases (A.1 0 0) (A.1 0 1) (A.1 1 0) (A.1 1 1)
    (by simpa only [Matrix.det_fin_two] using A.property) hA).1
  simpa [residueCoeff,reduction,T,Matrix.mul_apply,Fin.sum_univ_two] using h

theorem residue_S (A : Residue) (hA : good A) :
    residueCoeff (A*reduction 9 (lower 3))=stepS (residueCoeff A) := by
  have h := (raw_cases (A.1 0 0) (A.1 0 1) (A.1 1 0) (A.1 1 1)
    (by simpa only [Matrix.det_fin_two] using A.property) hA).2.1
  simpa [residueCoeff,reduction,lower,Matrix.mul_apply,Fin.sum_univ_two,mul_comm] using h

theorem residue_Z (A : Residue) (hA : good A) :
    residueCoeff (A*reduction 9 (-1))=residueCoeff A := by
  have h := (raw_cases (A.1 0 0) (A.1 0 1) (A.1 1 0) (A.1 1 1)
    (by simpa only [Matrix.det_fin_two] using A.property) hA).2.2
  simpa [residueCoeff,reduction] using h

theorem raw_kernel : ∀ a b : ZMod 9,b.val%3=0 → rawCoeff a b 0=(1,0,0,0) := by decide

theorem residue_kernel (A : Residue) (hc : A.1 1 0=0) (hb : (A.1 0 1).val%3=0) :
    residueCoeff A=(1,0,0,0) := by
  unfold residueCoeff
  rw [hc]
  exact raw_kernel _ _ hb
#print axioms residue_R
#print axioms residue_S
#print axioms residue_Z
#print axioms residue_kernel
end QuantitativeArithmeticSmallLevelTwentySevenOrbit
