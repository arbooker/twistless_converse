theorem divisor_bounded (m : ℕ) : Bounded (divisor m) :=
  ((primeRate_bounded 2 m).pow 4).sub (Bounded.const 1)

theorem divisor_factors (m : ℕ) (s : ℂ) (hs : divisor m s≠0) :
    primeRate 2 m s-1≠0 ∧ primeRate 2 m s+1≠0 ∧ (primeRate 2 m s)^2+1≠0 := by
  have he : divisor m s=(primeRate 2 m s-1)*(primeRate 2 m s+1)*((primeRate 2 m s)^2+1) := by
    unfold divisor
    ring
  rw [he,mul_ne_zero_iff,mul_ne_zero_iff] at hs
  exact ⟨hs.1.1,hs.1.2,hs.2⟩

theorem original_growth_system (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (hf2 : f 2=0)
