/-! ## TwentySevenPoleAPLiftPlusAnalytic -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticTriangularMeromorphicReconstruction Matrix

/-- Away from the explicit finite pivot divisors the actual reconstruction
coefficients are analytic, rather than merely meromorphic. -/
theorem staged_left_analytic (x y z w : ℂ → ℂ) (a b c s : ℂ)
    (hx : AnalyticAt ℂ x s) (hy : AnalyticAt ℂ y s)
    (hz : AnalyticAt ℂ z s) (hw : AnalyticAt ℂ w s)
    (hx0 : x s≠0) (hy0 : y s≠0) (hz0 : z s≠0) (hw0 : w s≠0)
    (hp : ∀ n, n<871 → stageLead (x s) (y s) (z s) (w s) a b c n≠0)
    (i : Fin 321) (j : Fin 550) :
    AnalyticAt ℂ (fun t => stagedLeftMatrix (x t) (y t) (z t) (w t) a b c i j) s := by
  have hcoef (p : Poly) (k : ℕ) := coefficient_analytic x y z w a b c s hx hy hz hw hx0 hy0 hz0 hw0 p k
  have hlead (n : ℕ) : AnalyticAt ℂ (fun t => stageLead (x t) (y t) (z t) (w t) a b c n) s :=
    hcoef (certificate n) (550+n)
  have hlower (n k : ℕ) : AnalyticAt ℂ (fun t => stageLower (x t) (y t) (z t) (w t) a b c n k) s :=
    hcoef (certificate n) (550+k)
  have hrhs (n : ℕ) (k : Fin 550) :
      AnalyticAt ℂ (fun t => stageRhsMatrix (x t) (y t) (z t) (w t) a b c n k) s := by
    by_cases hn : n=k.val
    · simpa only [stageRhsMatrix,ite_eq_left hn,stageSource,Pi.neg_def] using (hcoef (certificate n) n).neg
    · simpa only [stageRhsMatrix,ite_eq_right hn] using (analyticAt_const : AnalyticAt ℂ (fun _ : ℂ => (0:ℂ)) s)
  change AnalyticAt ℂ (fun t => ∑ k : Fin 550,
    outputFactor (x t) (y t) (z t) (w t) a b c i k*
      reconstructionMatrix (stageRhsMatrix (x t) (y t) (z t) (w t) a b c)
        (stageLead (x t) (y t) (z t) (w t) a b c)
        (stageLower (x t) (y t) (z t) (w t) a b c) k j) s
  apply Finset.analyticAt_fun_sum
  intro k _
  apply AnalyticAt.mul
  · exact (hcoef (certificate (550+i.val)) (550+k.val)).neg.div
      (hlead (550+i.val)) (hp (550+i.val) (by omega))
  · exact reconstruction_analytic _ _ _ s hrhs hlead hlower (fun n hn => hp n (by omega)) k j

#print axioms staged_left_analytic
end QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages
end
end

/-! ## TwentySevenPoleAPLiftPlusMeromorphic -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticTriangularMeromorphicReconstruction Matrix

/-- All entries of the actual staged reconstruction matrix are meromorphic.
The finite recursion is used directly; no large rational inverse is expanded. -/
theorem staged_left_meromorphic (x y z w a b c : ℂ → ℂ) (s : ℂ)
    (hx : MeromorphicAt x s) (hy : MeromorphicAt y s) (hz : MeromorphicAt z s)
    (hw : MeromorphicAt w s) (ha : MeromorphicAt a s) (hb : MeromorphicAt b s)
    (hc : MeromorphicAt c s) (i : Fin 321) (j : Fin 550) :
    MeromorphicAt (fun t => stagedLeftMatrix (x t) (y t) (z t) (w t) (a t) (b t) (c t) i j) s := by
  have hcoef (p : Poly) (k : ℕ) := coefficient_meromorphic x y z w a b c s hx hy hz hw ha hb hc p k
  have hlead (n : ℕ) : MeromorphicAt (fun t => stageLead (x t) (y t) (z t) (w t) (a t) (b t) (c t) n) s :=
    hcoef (certificate n) (550+n)
  have hlower (n k : ℕ) : MeromorphicAt (fun t => stageLower (x t) (y t) (z t) (w t) (a t) (b t) (c t) n k) s :=
    hcoef (certificate n) (550+k)
  have hrhs (n : ℕ) (k : Fin 550) :
      MeromorphicAt (fun t => stageRhsMatrix (x t) (y t) (z t) (w t) (a t) (b t) (c t) n k) s := by
    by_cases hn : n=k.val
    · simpa only [stageRhsMatrix,ite_eq_left hn,stageSource] using (hcoef (certificate n) n).fun_neg
    · simpa only [stageRhsMatrix,ite_eq_right hn] using (MeromorphicAt.const (0:ℂ) s)
  change MeromorphicAt (fun t => ∑ k : Fin 550,
    outputFactor (x t) (y t) (z t) (w t) (a t) (b t) (c t) i k*
      reconstructionMatrix (stageRhsMatrix (x t) (y t) (z t) (w t) (a t) (b t) (c t))
        (stageLead (x t) (y t) (z t) (w t) (a t) (b t) (c t))
        (stageLower (x t) (y t) (z t) (w t) (a t) (b t) (c t)) k j) s
  apply MeromorphicAt.fun_sum
  intro k _
  apply MeromorphicAt.mul
  · exact (hcoef (certificate (550+i.val)) (550+k.val)).neg.div (hlead (550+i.val))
  · exact reconstruction_meromorphic _ _ _ s hrhs hlead hlower k j
#print axioms staged_left_meromorphic
end QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages
end
