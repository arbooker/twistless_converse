/-! ## TwentySevenVerticalCusp -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGrowth
open Complex QuantitativeArithmeticGaussianStrip FinitenessFourierConstruction

/-- The original Fourier function has its expected simple polar term at1/9,
with an error smaller than every positive power along the vertical ray. -/
theorem original_vertical_cusp (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ r : ℂ,∀ n : ℕ,∃ C : ℝ,0≤C ∧ ∀ y : ℝ,0<y →
      ‖fourier (FinitenessOriginalFourier.fullCoefficients f (2*m))
        ((1/9:ℂ)+(y:ℂ)*I)-(y:ℂ)^(-((2*m:ℕ):ℂ))*r‖≤C*y^(n:ℝ) := by
  obtain ⟨B,H,hH,hr,he⟩ := ninth_rapid_mellin m hm hf
  obtain ⟨τ,_,hg⟩ := hf.growth
  let a := FinitenessOriginalFourier.fullCoefficients f (2*m)
  have ha := FinitenessOriginalFourier.polynomial_bound hf.zero hg (2*m)
  have ha0 := FinitenessOriginalFourier.fullCoefficients_zero hf.zero (2*m)
  obtain ⟨B',hB'⟩ := SmallLevelTaylor.additive_convergence_halfplane ha ha0
  let k : ℝ := ((2*m:ℕ):ℝ)
  let b : ℝ := max (max B B') k+1
  have hbB : B<b := by dsimp [b]; linarith [le_max_left B B',le_max_left (max B B') k]
  have hbB' : B'<b := by dsimp [b]; linarith [le_max_right B B',le_max_left (max B B') k]
  have hbk : k<b := by dsimp [b]; linarith [le_max_right (max B B') k]
  have hk : 0<k := by dsimp [k]; positivity
  let Q : ℂ → ℂ := fun s => H s/(s-(k:ℂ))
  let F : ℝ → ℂ := fun y => fourier a ((1/9:ℂ)+(y:ℂ)*I)
  have hF : MellinConvergent F b := by
    simpa only [F,Complex.ofReal_div,Complex.ofReal_one,Complex.ofReal_ofNat] using
      (hB' (1/9) (b:ℂ) (by simpa using hbB')).1
  have hline (t : ℝ) : mellin F ((b:ℂ)+(t:ℂ)*I)=Q ((b:ℂ)+(t:ℂ)*I) := by
    have hh := (hB' (1/9) ((b:ℂ)+(t:ℂ)*I) (by simpa using hbB')).2
    have hh' := he ((b:ℂ)+(t:ℂ)*I) (by simpa using hbB)
    simpa only [F,Q,k,a,SmallLevelAdditive.original,Complex.ofReal_natCast,
      Complex.ofReal_div,Complex.ofReal_one,Complex.ofReal_ofNat] using hh.trans hh'
  have hQ : VerticalIntegrable Q b := quotient_vertical_integrable hH.continuous
    ((hr k b hbk).line hbk.le le_rfl) k (ne_of_gt hbk)
  have hinv (y : ℝ) (hy : 0<y) : mellinInv b Q y=F y := by
    apply QuantitativeArithmeticMellinInversionFromLine.inverse_of_line F Q b hF hQ hline hy
    exact (FinitenessFourierConstruction.holomorphic ha (by simpa using hy)).continuousAt.comp (by fun_prop)
  refine ⟨H (k:ℂ),?_⟩
  intro n
  obtain ⟨C,hC,hbound⟩ := QuantitativeArithmeticInverseMellinBound.line_bound Q (-(n:ℝ))
  refine ⟨C,hC,?_⟩
  intro y hy
  have hn : -(n:ℝ)<k := by linarith [Nat.cast_nonneg (α:=ℝ) n]
  have hshift := rapid_quotient_mellin_shift H hH k (-(n:ℝ)) b hn hbk
    (hr (-(n:ℝ)) b (hn.trans hbk)) y hy
  change mellinInv b Q y=mellinInv (-(n:ℝ)) Q y+(y:ℂ)^(-(k:ℂ))*H (k:ℂ) at hshift
  rw [hinv y hy] at hshift
  have herr : F y-(y:ℂ)^(-(k:ℂ))*H (k:ℂ)=mellinInv (-(n:ℝ)) Q y := by
    linear_combination hshift
  change ‖F y-(y:ℂ)^(-((2*m:ℕ):ℂ))*H (k:ℂ)‖≤_
  have hcast : (k:ℂ)=((2*m:ℕ):ℂ) := by simp only [k,Complex.ofReal_natCast]
  rw [← hcast,herr]
  simpa only [neg_neg] using hbound y hy
#print axioms original_vertical_cusp
end QuantitativeArithmeticSmallLevelTwentySevenGrowth
end
end

/-! ## TwentySevenCuspSector -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGrowth
open Complex QuantitativeArithmeticCuspRemainder QuantitativeArithmeticLogSector

theorem original_cusp_sector (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ r : ℂ,∀ δ : ℝ,0<δ → δ<Real.pi/2 → ∀ n : ℕ,
      ∃ C : ℝ,0≤C ∧ ∀ w : ℂ,w≠0 → ‖w‖≤1 → δ≤arg w → arg w≤Real.pi-δ →
        ‖remainder (FinitenessOriginalFourier.fullCoefficients f (2*m)) (1/9) (2*m) r w‖≤C*‖w‖^n := by
  obtain ⟨r,hr⟩ := original_vertical_cusp m hm hf
  obtain ⟨τ,_,hg⟩ := hf.growth
  let A := FinitenessOriginalFourier.fullCoefficients f (2*m)
  have hA := FinitenessOriginalFourier.polynomial_bound hf.zero hg (2*m)
  have hA0 := FinitenessOriginalFourier.fullCoefficients_zero hf.zero (2*m)
  have hv := vertical_log_decay A (1/9) (2*m) r (by
    simpa only [A,Complex.ofReal_div,Complex.ofReal_one,Complex.ofReal_ofNat] using hr)
  refine ⟨r,?_⟩
  apply flat_sector (remainder A (1/9) (2*m) r)
  intro δ hδ hδπ n
  apply compact_angle_decay (fun z => remainder A (1/9) (2*m) r (logRay z))
    (log_remainder_strip_holomorphic hA (1/9) (2*m) r)
    (log_remainder_growth hA hA0 (1/9) (2*m) r) hv δ hδ hδπ n
#print axioms original_cusp_sector
end QuantitativeArithmeticSmallLevelTwentySevenGrowth
