      (∀ n : ℕ, 0<n → ∀ i, 0≤meromorphicOrderAt (fun z => S.G z i) (x+n)) →
      HasAnalyticGerm (firstRow m f η S.G) x := by
  obtain ⟨S⟩ := QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.original_pole_system m hm hf
  obtain ⟨η,hη,h⟩ := first_shift_germ_for_continuation m hm hf S.B S.G S.meromorphic S.agreement
