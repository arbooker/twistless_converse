/-! ## TwentySevenGrowthSystem -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenGrowth
open Matrix QuantitativeArithmeticMellinStrip QuantitativeArithmeticVerticalBounded
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticSmallLevelTwentySevenObservedSourceChart (Chart)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate quadratic_bounded)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point)

def divisor (m : ℕ) (f : ℕ → ℂ) (s : ℂ) : ℂ :=
  (Real.sqrt 2:ℂ)*f 2*primeRate 2 m s+(primeRate 2 m s)^2-1

/-- A bounded original reconstruction system with a single quadratic
clearing divisor. The growth of the continued observations is NOT an input. -/
structure GrowthSystem (m : ℕ) (f : ℕ → ℂ) (S : PoleSystem m f) where
  η : ℂ
  η_sign : η=1 ∨ η= -1
  selection : Fin 549 → Source
  L : ℂ → Matrix (Fin 321) (Fin 549) ℂ
  B : ℝ
  E : Fin 549 → ℕ → ℂ → ℂ
  error_analytic : ∀ i (n : ℕ),AnalyticOnNhd ℂ (E i n) {s : ℂ | B-((n:ℝ)+1)<s.re}
  error_bounded : ∀ i (n : ℕ),BoundedSubstrips (B-((n:ℝ)+1)) (E i n)
  power : ℕ
  power_pos : 0<power
  numerator : (Fin 321 × Fin 549) → ℂ → ℂ
  numerator_bounded : ∀ i,Bounded (numerator i)
  cleared : ∀ i s,divisor m f s≠0 → L s i.1 i.2=numerator i s/(divisor m f s)^power
  rows : ∀ (n : ℕ) (s : ℂ),B-((n:ℝ)+1)<s.re → s.im≠0 → divisor m f s≠0 →
    S.G s=L s *ᵥ (fun i => E i n s)+∑ a∈Finset.range n,
      (L s * Matrix.of (fun i j => coefficient (selection i) m η a s j)) *ᵥ S.G (s+((a:ℂ)+1))

theorem of_chart (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (η : ℂ) (hη : η=1 ∨ η= -1) (C : Chart 549 870 m f η)
    (hb : ∀ i,BoundedRow (C.selection i) m f η)
    (hp : ∀ s,divisor m f s≠0 → ∀ t,C.pivot t s≠0)
    (hc : ∀ i j,Cleared (divisor m f) (fun s => C.L s i j)) :
    Nonempty (GrowthSystem m f S) := by
  obtain ⟨B,E,hE,hrow⟩ := QuantitativeArithmeticSmallLevelTwentySevenObservedSourceChart.bounded_reconstruction S η C hb
  obtain ⟨n,A,hn,hA,he⟩ := Cleared.uniform_positive (quadratic_bounded m ((Real.sqrt 2:ℂ)*f 2))
    (fun i : Fin 321 × Fin 549 => fun s => C.L s i.1 i.2) (fun i => hc i.1 i.2)
  refine ⟨{
    η := η
    η_sign := hη
    selection := C.selection
    L := C.L
    B := B
    E := E
    error_analytic := fun i n => (hE i n).1
    error_bounded := fun i n => (hE i n).2
    power := n
    power_pos := hn
    numerator := A
    numerator_bounded := hA
    cleared := he
    rows := ?_ }⟩
  intro n s hs hi hd
  apply hrow n s hs (hp s hd)
  intro q _ j
  apply (QuantitativeArithmeticSmallLevelTwentySevenGlobalPoleRule.pole_orders m hm hf S).2 _ _ j
  intro h
  apply hi
  have hh := congrArg Complex.im h
  simpa only [Complex.add_im,Complex.natCast_im,add_zero] using hh

theorem original_growth_system (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (hf2 : f 2≠0)
    (S : PoleSystem m f) : Nonempty (GrowthSystem m f S) := by
  obtain ⟨η,hη,hlaw⟩ := QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.original_bounded_taylor_law point m hf
  have ha : (Real.sqrt 2:ℂ)*f 2≠0 :=
    mul_ne_zero (Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (by norm_num))) hf2
  rcases hη with rfl | rfl
  · apply of_chart m hm hf S 1 (by simp)
      (QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericPlus.chart m f)
    · intro i
      exact QuantitativeArithmeticSmallLevelTwentySevenBoundarySource.bounded_toSource _ m hm hf 1 hlaw
    · intro s hs t
      exact QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericPlusStages.physical_pivots_nonzero m _ _ _ s ha hs t
    · intro i j
      exact QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericPlusStages.physical_left_cleared m _ _ _ i j
  · apply of_chart m hm hf S (-1) (by simp)
      (QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericMinus.chart m f)
    · intro i
      exact QuantitativeArithmeticSmallLevelTwentySevenBoundarySource.bounded_toSource _ m hm hf (-1) hlaw
    · intro s hs t
      exact QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericMinusStages.physical_pivots_nonzero m _ _ _ s ha hs t
    · intro i j
      exact QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericMinusStages.physical_left_cleared m _ _ _ i j
#print axioms original_growth_system
end QuantitativeArithmeticSmallLevelTwentySevenGrowth
end
