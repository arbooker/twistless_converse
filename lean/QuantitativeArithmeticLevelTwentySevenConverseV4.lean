    · intro i j
      exact QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physical_left_cleared m _ _ _ i j
  · apply of_chart 550 3 (divisor m) (divisor_bounded m) m hm hf S (-1) (by simp)
      (QuantitativeArithmeticSmallLevelTwentySevenMinusZeroGrowth.chart m f hf2)
    · intro i
      exact boundedRow_old _ m hm hf (-1) hlaw
    · intro s hs t
      obtain ⟨h1,h2,h3⟩ := divisor_factors m s hs
      fin_cases t
      · exact h1
      · exact h2
      · exact h3
    · intro i j
