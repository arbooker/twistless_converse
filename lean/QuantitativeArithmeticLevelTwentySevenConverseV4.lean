    (fun n z j t => sourceCoefficient_analytic (C.selection j) m η n z t)
    _ C.pivot_analytic (C.pivots_nonzero x hx) hJ (fun z => (hG 6 z).meromorphicAt) hrow hshift i
  intro n j z hz
