theorem off_unit_divisors (u : ℂ) (hu : ‖u‖ ≠ 1) :
    u-1 ≠ 0 ∧ u+1 ≠ 0 ∧ u^2+1 ≠ 0 := by
  refine ⟨?_,?_,?_⟩
  · intro h
    have he : u=1 := sub_eq_zero.mp h
    exact hu (by rw [he,norm_one])
  · intro h
    have he : u= -1 := eq_neg_of_add_eq_zero_left h
    exact hu (by rw [he,norm_neg,norm_one])
  · intro h
    have he : u^2= -1 := eq_neg_of_add_eq_zero_left h
    have hn := congrArg norm he
    simp only [norm_pow,norm_neg,norm_one] at hn
    apply hu
    nlinarith [norm_nonneg u]

/-- Away from the unit-rate boundary, every highest pole is the permitted
weight pole and has order at most one, including weight two. -/
theorem highest_pole_rule (m : ℕ) (hm : 0 < m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (x : ℂ) (hn : ‖primeRate 2 m x‖ ≠ 1)
    (hshift : ∀ n : ℕ, 0 < n → ∀ j : Fin 321,
      0 ≤ meromorphicOrderAt (fun z => S.G z j) (x+n)) :
    (∀ i, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (fun z => S.G z i) x) ∧
    (x ≠ ((2*m:ℕ):ℂ) → ∀ i, 0 ≤ meromorphicOrderAt (fun z => S.G z i) x) := by
  obtain ⟨hminus,hplus,hsq⟩ := off_unit_divisors _ hn
  by_cases hf2 : f 2=0
  · have hr : regularPoint m f x := by
