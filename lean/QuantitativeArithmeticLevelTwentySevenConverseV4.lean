/-! ## TwentySevenCoefficientStripGrowth -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
open QuantitativeArithmeticVerticalBounded
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (point)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate_bounded primeRate_inv_bounded)

theorem matrixCoefficient_stripPolynomial
    (r : QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.Spec) (m n : ℕ) :
    StripPolynomial (matrixCoefficient r m n) := by
  have h2 := (primeRate_bounded 2 m).zpow (primeRate_inv_bounded 2 m) r.e₂
  have h3 := (primeRate_bounded 3 m).zpow (primeRate_inv_bounded 3 m) r.e₃
  have h5 := (primeRate_bounded 5 m).zpow (primeRate_inv_bounded 5 m) r.e₅
  have h7 := (primeRate_bounded 7 m).zpow (primeRate_inv_bounded 7 m) r.e₇
  exact ((((h2.mul h3).mul h5).mul h7).mul (Bounded.const _)).stripPolynomial.mul
    (binomial_polynomial_growth (2*m) (n+1)).stripPolynomial

theorem ramanujanCoefficient_stripPolynomial
    (r : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Spec)
    (hr : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Valid point r)
    (m : ℕ) (η : ℂ) (n : ℕ) : StripPolynomial (ramanujanCoefficient r m η n) := by
  apply taylorRowScalar_stripPolynomial
  · exact_mod_cast Nat.lcm_pos (by decide : 0<27) (pow_pos hr.2.1 2)
  · exact div_ne_zero (by exact_mod_cast hr.2.2.2.1) (by exact_mod_cast hr.1.ne')

theorem kindCoefficient_stripPolynomial
    (r : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.Kind)
    (m : ℕ) (η : ℂ) (n : ℕ) (j : Fin 321) :
    StripPolynomial (fun s => QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.kindCoefficient r m η n s j) := by
  cases r with
  | hecke i hi => exact (Bounded.const 0).stripPolynomial
  | entire i => exact (Bounded.const 0).stripPolynomial
  | matrix i => exact (matrixCoefficient_stripPolynomial _ m n).mul (Bounded.const _).stripPolynomial
  | ramanujan i =>
    have hr : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.Valid point
        (QuantitativeArithmeticSmallLevelTwentySevenShiftSource.Ramanujan.selected i) :=
      QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.selected_valid _
    exact (ramanujanCoefficient_stripPolynomial _ hr m η n).mul (Bounded.const _).stripPolynomial

theorem coefficient_stripPolynomial (r : Source) (m : ℕ) (η : ℂ) (n : ℕ) (j : Fin 321) :
    StripPolynomial (fun s => coefficient r m η n s j) := by
  cases r with
  | old t => exact kindCoefficient_stripPolynomial t m η n j
  | matrix t ht obs ho => exact (matrixCoefficient_stripPolynomial t m n).mul (Bounded.const _).stripPolynomial
  | ramanujan t ht obs ho => exact (ramanujanCoefficient_stripPolynomial t ht m η n).mul (Bounded.const _).stripPolynomial
  | hecke t ht => exact (Bounded.const 0).stripPolynomial
  | entire p hp => exact (Bounded.const 0).stripPolynomial
#print axioms coefficient_stripPolynomial
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
end
