/-! ## TwentySevenZeroJetDivisorCover -/
section
set_option autoImplicit false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenZeroJet

def commonDivisor (x z b : ℂ) : ℂ :=
  b*x^6*z-2*b*x^4*z+3*b*x^2*z+x^8+x^6*z^2-x^6-
    2*x^4*z^2+3*x^2*z^2+3*x^2-3*z^2-2
def secondDivisor (x z b : ℂ) : ℂ :=
  1520*b*x^6*z-1520*b*x^4*z-24640*b*x^2*z+640*b*z+
    925*x^8+1744*x^6*z^2-4200*x^6-1744*x^4*z^2-21400*x^4-
    31808*x^2*z^2+32000*x^2+7808*z^2+188800

theorem divisor_cover (x z b : ℂ) (hx : x^2=1 ∨ x^2= -1) (hz : ‖z‖=1) :
    commonDivisor x z b≠0 ∨ secondDivisor x z b≠0 := by
  by_contra h
  push Not at h
  obtain ⟨hc,hs⟩ := h
  unfold commonDivisor at hc
  unfold secondDivisor at hs
  rcases hx with hx|hx
  · have h4 : x^4=1 := by
      calc
        x^4=(x^2)^2 := by ring
        _=1 := by rw [hx]; norm_num
    have h6 : x^6=1 := by
      calc
        x^6=(x^2)^3 := by ring
        _=1 := by rw [hx]; norm_num
    have h8 : x^8=1 := by
      calc
        x^8=(x^2)^4 := by ring
        _=1 := by rw [hx]; norm_num
    simp only [hx,h4,h6,h8] at hc hs
    have he : z^2=(185/32:ℂ) := by linear_combination -(hs+12000*hc)/36000
    have hn := congrArg norm he
    norm_num [norm_pow,hz] at hn
  · have h4 : x^4=1 := by
      calc
        x^4=(x^2)^2 := by ring
        _=1 := by rw [hx]; norm_num
    have h6 : x^6= -1 := by
      calc
        x^6=(x^2)^3 := by ring
        _= -1 := by rw [hx]; norm_num
    have h8 : x^8=1 := by
      calc
        x^8=(x^2)^4 := by ring
        _=1 := by rw [hx]; norm_num
    simp only [hx,h4,h6,h8] at hc hs
    have he : z^2=(-129405/2768:ℂ) := by linear_combination (hs+(11120/3:ℂ)*hc)/2768
    have hn := congrArg norm he
    norm_num [norm_pow,hz] at hn

theorem small_factors (x : ℂ) (hx : x^2=1 ∨ x^2= -1) :
    x≠0 ∧ x+2≠0 ∧ x-2≠0 ∧ x^6-8*x^4+32*x^2+64≠0 := by
  have h0 : x≠0 := by rintro rfl; norm_num at hx
  have hp : x+2≠0 := by
    intro h
    have he : x= -2 := by linear_combination h
    rw [he] at hx
    norm_num at hx
  have hm : x-2≠0 := by
    intro h
    have he : x=2 := by linear_combination h
    rw [he] at hx
    norm_num at hx
  refine ⟨h0,hp,hm,?_⟩
  rcases hx with hx|hx
  · have h4 : x^4=1 := by
      calc
        x^4=(x^2)^2 := by ring
        _=1 := by rw [hx]; norm_num
    have h6 : x^6=1 := by
      calc
        x^6=(x^2)^3 := by ring
        _=1 := by rw [hx]; norm_num
    norm_num [hx,h4,h6]
  · have h4 : x^4=1 := by
      calc
        x^4=(x^2)^2 := by ring
        _=1 := by rw [hx]; norm_num
    have h6 : x^6= -1 := by
      calc
        x^6=(x^2)^3 := by ring
        _= -1 := by rw [hx]; norm_num
    norm_num [hx,h4,h6]
#print axioms divisor_cover
#print axioms small_factors
end QuantitativeArithmeticSmallLevelTwentySevenZeroJet
end
