/-! ## TwentySevenQuadraticAnchorGerm -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_analytic primeRate_nonzero)
open QuantitativeArithmeticSmallLevelTwentySevenPoleSource (firstQuadratic)
open QuantitativeArithmeticAnalyticGerm (HasAnalyticGerm)
open Filter
open scoped Topology

/-- The checked short source relation annihilates the polar germ after
multiplication by the first quadratic. It also applies at the boundary
values of the parameters; no division by f₂ or x²−1 is made. -/
theorem quadratic_germ_for_continuation (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z)
    (x : ℂ) (hshift : ∀ n : ℕ, 0<n → ∀ i,
      0≤meromorphicOrderAt (fun z => G z i) (x+n)) :
    HasAnalyticGerm (fun z => firstQuadratic m f z*G z 6) x := by
  obtain ⟨η,B0,E,hη,he,hr⟩ := original_family m hm hf
  have hprod : HasAnalyticGerm (fun z => (primeRate 3 m z*firstQuadratic m f z)*G z 6) x := by
    rcases hη with rfl|rfl
    · have hh := weighted_anchor_germ m f 1 B0 E he hr
        QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticPlus.kinds
        (QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticPlus.weights m f)
        (QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticPlus.weights_analytic m f)
        (QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticPlus.weighted_source_zero m f)
        BG G hG hagree x hshift
      simpa only [QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticPlus.weighted_anchor_coefficient] using hh
    · have hh := weighted_anchor_germ m f (-1) B0 E he hr
        QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticMinus.kinds
        (QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticMinus.weights m f)
        (QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticMinus.weights_analytic m f)
        (QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticMinus.weighted_source_zero m f)
        BG G hG hagree x hshift
      simpa only [QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticMinus.weighted_anchor_coefficient] using hh
  have hi : AnalyticAt ℂ (fun z => (primeRate 3 m z)⁻¹) x :=
    (primeRate_analytic 3 m x).inv (primeRate_nonzero 3 m x)
  apply (hprod.mul_analytic hi).congr
  filter_upwards [] with z
  simp only [← mul_assoc,inv_mul_cancel₀ (primeRate_nonzero 3 m z),one_mul]

theorem original_quadratic_germ (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ S : QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.PoleSystem m f,
      ∀ x : ℂ, (∀ n : ℕ, 0<n → ∀ i,
        0≤meromorphicOrderAt (fun z => S.G z i) (x+n)) →
      HasAnalyticGerm (fun z => firstQuadratic m f z*S.G z 6) x := by
  obtain ⟨S⟩ := QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.original_pole_system m hm hf
  exact ⟨S,fun x hx => quadratic_germ_for_continuation m hm hf S.B S.G S.meromorphic S.agreement x hx⟩
#print axioms quadratic_germ_for_continuation
#print axioms original_quadratic_germ
end QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
