open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate)

theorem GrowthSystem.polynomial_strips {m : ℕ} {f : ℕ → ℂ} {S : PoleSystem m f}
    (R : GrowthSystem m f S) (H : Fin 321 → ℂ → ℂ)
    (hH : ∀ i,Differentiable ℂ (H i))
    (he : ∀ i s,s≠((2*m:ℕ):ℂ) → H i s=(s-((2*m:ℕ):ℂ))*S.G s i)
    (B : ℝ) (hB : ∀ i,PolynomialSubstrips B (H i)) :
    ∀ i,StripPolynomial (H i) := by
  apply stripPolynomial_of_half_step H B hB
  intro b hb i
  apply quadratic_substrip_step (Real.log 2:ℂ)
    (Complex.ofReal_ne_zero.mpr (ne_of_gt (Real.log_pos (by norm_num))))
    (m:ℂ) ((Real.sqrt 2:ℂ)*f 2) R.power R.power_pos (H i) (hH i) b
  intro l u hl hu
  simpa only [divisor,primeRate,Complex.ofReal_natCast] using R.cleared_tail H he b hb l u hl hu i

/-- Original level27 hypotheses imply polynomial growth on every strip for
all entire regularized observations, when the coefficient at2 is nonzero. -/
theorem original_polynomial_strips (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (hf2 : f 2≠0)
    (S : PoleSystem m f) :
    ∃ H : Fin 321 → ℂ → ℂ,(∀ i,Differentiable ℂ (H i)) ∧
      (∀ i s,s≠((2*m:ℕ):ℂ) → H i s=(s-((2*m:ℕ):ℂ))*S.G s i) ∧
      ∀ i,StripPolynomial (H i) := by
  obtain ⟨R⟩ := original_growth_system m hm hf hf2 S
  obtain ⟨H,B,hH,he,hB⟩ := regularized_initial m hm hf S
  exact ⟨H,hH,he,R.polynomial_strips H hH he B hB⟩
#print axioms original_polynomial_strips
end QuantitativeArithmeticSmallLevelTwentySevenGrowth
end
