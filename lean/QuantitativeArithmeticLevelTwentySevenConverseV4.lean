/-! ## TwentySevenBoundaryGenericMinusStagesPivotCleared -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericMinusStages
open QuantitativeArithmeticVerticalBounded QuantitativeArithmeticSevenLaurentRows

theorem pivot_inverse_cleared (x y z w : ℂ → ℂ) (a : ℂ)
    (hxi : Bounded (fun s => (x s)⁻¹)) (hyi : Bounded (fun s => (y s)⁻¹))
    (hzi : Bounded (fun s => (z s)⁻¹)) (hwi : Bounded (fun s => (w s)⁻¹))
    (i : Fin 49) :
    Cleared (fun s => a*x s+(x s)^2-1)
      (fun s => (pivotFactored (x s) (y s) (z s) (w s) a i.val)⁻¹) := by
  let D : ℂ → ℂ := fun s => a*x s+(x s)^2-1
  have hxi' : Cleared D (fun s => (x s)⁻¹) := hxi.cleared
  have hyi' : Cleared D (fun s => (y s)⁻¹) := hyi.cleared
  have hzi' : Cleared D (fun s => (z s)⁻¹) := hzi.cleared
  have hwi' : Cleared D (fun s => (w s)⁻¹) := hwi.cleared
  have hdi : Cleared D (fun s => (a*x s+(x s)^2-1)⁻¹) := Cleared.inv_self D
  change Cleared D _
  fin_cases i <;> simp only [pivotFactored,mul_inv_rev,← inv_pow]
  all_goals repeat' first
    | exact hxi'
    | exact hyi'
    | exact hzi'
    | exact hwi'
    | exact hdi
    | apply Cleared.mul
    | apply Cleared.pow
    | exact Cleared.const D _

theorem stageLead_inverse_cleared (x y z w : ℂ → ℂ) (a b c : ℂ)
    (hxi : Bounded (fun s => (x s)⁻¹)) (hyi : Bounded (fun s => (y s)⁻¹))
    (hzi : Bounded (fun s => (z s)⁻¹)) (hwi : Bounded (fun s => (w s)⁻¹))
    (n : ℕ) (hn : n<870) :
    Cleared (fun s => a*x s+(x s)^2-1)
      (fun s => (stageLead (x s) (y s) (z s) (w s) a b c n)⁻¹) := by
  obtain ⟨i,hi⟩ := all_leading_factor_rep n hn
  have he : (fun s => (stageLead (x s) (y s) (z s) (w s) a b c n)⁻¹)=
      (fun s => (pivotFactored (x s) (y s) (z s) (w s) a i.val)⁻¹) := by
    funext s
    unfold stageLead
    rw [coefficient_project,hi,pivot_factorization]
  rw [he]
  exact pivot_inverse_cleared x y z w a hxi hyi hzi hwi i
#print axioms pivot_inverse_cleared
#print axioms stageLead_inverse_cleared
end QuantitativeArithmeticSmallLevelTwentySevenBoundaryGenericMinusStages
end
