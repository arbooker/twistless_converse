theorem left_part_eq : leftPart70=certificate := by decide +kernel
theorem left_zero (x y z w a b c : ℂ) (v : ℕ → ℂ) (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0) : eval x y z w a b c (fun j => eval x y z w a b c v (leftInputs j)) certificate=0 := by
