/-! ## TwentySevenDefectZero -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2500000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenObstruction
open Matrix UpperHalfPlane SmallLevelNormalized QuantitativeArithmeticQuadraticMatrices
open QuantitativeArithmeticSmallLevelTwentySeven QuantitativeArithmeticSmallLevelTwentySevenAffine
open scoped MatrixGroups ModularForm

def J : GL (Fin 2) ℝ := fricke 3 (by decide)*baseGL 3*baseGL 1

theorem J_det : (GeneralLinearGroup.det J:ℝ)=1 := by
  simp only [J,map_mul,Units.val_mul,fricke_det,baseGL_det,mul_one]

theorem J_denom (z : ℍ) : denom J z=(Real.sqrt 3:ℂ)*((z:ℂ)+1) := by
  norm_num [J,denom,fricke,baseGL,baseMatrix,liftMatrix,matrix,GeneralLinearGroup.mkOfDetNeZero,
    Matrix.mul_apply,Fin.sum_univ_two,Matrix.det_fin_two]
  ring

theorem original_fricke_symmetry (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ χ : ℂ,‖χ‖=1 ∧ (defect m (scaledFunction (2*m) f) ∣[((2*m:ℕ):ℤ)] J)=
      -χ • defect m (scaledFunction (2*m) f) := by
  obtain ⟨χ,hχ,hW⟩ := scaled_fricke_eigen hf
  have hp := obstruction_pair m ((Real.sqrt 2:ℂ)*f 2) (scaledFunction (2*m) f)
    (fun i => original_base_system m hf (i.castLE (by decide)))
  have hb : B m (scaledFunction (2*m) f)= -(defect m (scaledFunction (2*m) f) ∣[((2*m:ℕ):ℤ)] U) :=
    eq_neg_of_add_eq_zero_left hp
  have hh := original_AWSS m hf χ hW
  rw [hb] at hh
  have he := congrArg (fun G : ℍ → ℂ => G ∣[((2*m:ℕ):ℤ)] U⁻¹) hh
  have hd : (GeneralLinearGroup.det U⁻¹:ℝ)=1 := det_one_inv _ (liftMatrix_det (mat 10) (valid 10))
  rw [det_one_smul _ hd,SlashAction.neg_slash] at he
  simp only [← SlashAction.slash_mul,mul_inv_cancel,SlashAction.slash_one] at he
  have hm : fricke 3 (by decide)*baseGL 3*baseGL 3*U⁻¹=J := by
    rw [U_word,J]
    group
  rw [hm] at he
  refine ⟨χ,hχ,he.trans ?_⟩
  funext z
  simp only [Pi.smul_apply,Pi.neg_apply,smul_eq_mul]
  ring

theorem constant_fricke_zero (m : ℕ) (hm : 0<m) (c χ : ℂ) (hχ : ‖χ‖=1)
    (h : ((fun _ : ℍ => c) ∣[((2*m:ℕ):ℤ)] J)= -χ • (fun _ : ℍ => c)) : c=0 := by
  have hs : 0<Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  let z : ℍ := ⟨-1+(Real.sqrt 3:ℂ)*Complex.I,by simp⟩
  have hd : denom J z=3*Complex.I := by
    rw [J_denom]
    change (Real.sqrt 3:ℂ)*((-1+(Real.sqrt 3:ℂ)*Complex.I)+1)=3*Complex.I
    have hsq : (Real.sqrt 3:ℂ)^2=3 := by exact_mod_cast Real.sq_sqrt (by norm_num : (0:ℝ)≤3)
    linear_combination Complex.I*hsq
  have hh := congrFun h z
  rw [det_one_slash _ J_det,hd,_root_.zpow_neg,zpow_natCast] at hh
  have hn := congrArg norm hh
  simp only [Pi.smul_apply,smul_eq_mul,norm_mul,norm_inv,norm_pow,norm_neg,hχ,Complex.norm_I,mul_one,one_mul] at hn
  norm_num only [Complex.norm_ofNat] at hn
  by_contra hc
  have hc' : ‖c‖≠0 := norm_ne_zero_iff.mpr hc
  have he : ((3:ℝ)^(2*m))⁻¹=1 := mul_left_cancel₀ hc' (by simpa using hn)
  have he' : (3:ℝ)^(2*m)=1 := by simpa using congrArg Inv.inv he
  have hgt : (1:ℝ)<3^(2*m) := one_lt_pow₀ (by norm_num) (by omega)
  linarith

theorem original_defect_zero (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    defect m (scaledFunction (2*m) f)=0 := by
  obtain ⟨c,hc⟩ := original_defect_constant m hm hf
  obtain ⟨χ,hχ,hh⟩ := original_fricke_symmetry m hf
  rw [hc] at hh
  have hz := constant_fricke_zero m hm c χ hχ hh
  rw [hc,hz]
  rfl
#print axioms original_fricke_symmetry
#print axioms constant_fricke_zero
#print axioms original_defect_zero
end QuantitativeArithmeticSmallLevelTwentySevenObstruction
end
