theorem last_weight (x y z w : ℂ) :
    weightValue x y z w 340=(-4319616220920:ℂ) := by
  change eval x y z w 0 0 0 (fun _ => 1) weight340=_
  norm_num [eval,monomial,weight340]

theorem last_input_support : ∀ t∈QuantitativeArithmeticSmallLevelTwentySevenFourthMinusFlatInteger.input340,t.2.1=2428 := by decide +kernel

def scalarCoefficient (x y z w : ℂ) : ℂ :=
  (4319616220920:ℂ)*eval x y z w 0 0 0 (fun _ => 1) QuantitativeArithmeticSmallLevelTwentySevenFourthMinusFlatInteger.input340

/-- Exact reconstruction of the single top coordinate by the340 physical
source rows. The lower coordinates are arbitrary; no continuation of them
is needed for this algebraic identity. -/
theorem reconstruct_top_coordinate (x y z w : ℂ) (v : ℕ→ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0) :
    ((List.range 340).map fun i => weightValue x y z w i*
      eval x y z w 0 0 0 v (QuantitativeArithmeticSmallLevelTwentySevenFourthMinusFlatInteger.inputs i)).sum=
      scalarCoefficient x y z w*v 2428 := by
  have h := combination_zero x y z w v hx hy hz hw
  rw [List.range_succ,List.map_append,List.sum_append,List.map_singleton,List.sum_singleton] at h
  change ((List.range 340).map fun i => weightValue x y z w i*
      eval x y z w 0 0 0 v (QuantitativeArithmeticSmallLevelTwentySevenFourthMinusFlatInteger.inputs i)).sum+
      weightValue x y z w 340*eval x y z w 0 0 0 v QuantitativeArithmeticSmallLevelTwentySevenFourthMinusFlatInteger.input340=0 at h
  rw [last_weight,eval_single_coordinate x y z w 0 0 0 v QuantitativeArithmeticSmallLevelTwentySevenFourthMinusFlatInteger.input340 2428 last_input_support] at h
  unfold scalarCoefficient
  linear_combination h

theorem scalar_at_resonance_nonzero : scalarCoefficient 2 3 5 7≠0 :=
  mul_ne_zero (by norm_num) QuantitativeArithmeticSmallLevelTwentySevenFourthMinusFlatInteger.scalar_nonzero

