/-! ## TwentySevenRamanujanSourceBounded -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource
open SmallLevelAdditive SmallLevelTaylor Complex Set MeasureTheory
open FinitenessOriginalFourier FinitenessFourierConstruction FinitenessRamanujanFourier
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages
/-- Every finite coordinate specification satisfying the explicit rational
checks gives a genuine Taylor row, with the same sign for all rows. -/
theorem original_bounded_rows (point : ℕ → ℚ) (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ η : ℂ, (η=1 ∨ η= -1) ∧ ∀ r : Spec, Valid point r →
      ∃ (B : ℝ) (error : ℕ → ℂ → ℂ), ∀ M : ℕ,
        AnalyticOnNhd ℂ (error M) {s : ℂ | B-((M:ℝ)+1)<s.re} ∧
        QuantitativeArithmeticMellinStrip.BoundedSubstrips (B-((M:ℝ)+1)) (error M) ∧
        ∀ s : ℂ, B<s.re →
          leading r m η s (fun j => original (2*m) f (point j:ℝ) s)=
            error M s+∑ n∈Finset.range M,
              shift r m η n s (fun j => original (2*m) f (point j:ℝ) (s+((n+1:ℕ):ℂ))) := by
  obtain ⟨η,hη,hlaw⟩ := QuantitativeArithmeticSmallLevelTwentySeven.original_ramanujan_bounded_split m hf
  refine ⟨η,hη,?_⟩
  intro r hr
  rcases hr with ⟨hQ,hq,hqQ,ht,hu,_,hleft,hright⟩
  have hr0 : (r.t:ℝ)/(r.Q:ℝ)≠0 := div_ne_zero (by exact_mod_cast ht) (by exact_mod_cast hQ.ne')
  have hu' : -1/((Nat.lcm 27 (r.q^2):ℝ)*((r.t:ℝ)/r.Q))=(r.u:ℝ)/r.Q := by
    exact_mod_cast hu
  obtain ⟨B,hB⟩ := hlaw r.q hq ((r.t:ℝ)/r.Q) hr0
  refine ⟨B,fun M => mellin (frickeError (2*m) (fullCoefficients (twisted f r.q) (2*m))
    (Nat.lcm 27 (r.q^2)) ((r.t:ℝ)/r.Q) η (M+1)),?_⟩
  intro M
  refine ⟨(hB M).1,(hB M).2.1,?_⟩
  intro s hs
  have h := (hB M).2.2 s hs
  rw [hu'] at h
  simpa only [leading,shift,
    sample_original point hQ hq hqQ r.t r.left hleft,
    sample_original point hQ hq hqQ r.u r.right hright] using h
#print axioms original_bounded_rows
end QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource
end
end

/-! ## TwentySevenRamanujanBoundedLaw -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource

def BoundedTaylorLaw (point : ℕ → ℚ) (m : ℕ) (f : ℕ → ℂ) (η : ℂ) : Prop :=
  ∀ r : Spec, Valid point r → ∃ (B : ℝ) (error : ℕ → ℂ → ℂ), ∀ M : ℕ,
    AnalyticOnNhd ℂ (error M) {s : ℂ | B-((M:ℝ)+1)<s.re} ∧
    QuantitativeArithmeticMellinStrip.BoundedSubstrips (B-((M:ℝ)+1)) (error M) ∧
    ∀ s : ℂ, B<s.re → leading r m η s
      (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) s)=error M s+
      ∑ n∈Finset.range M, shift r m η n s
        (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) (s+((n+1:ℕ):ℂ)))

theorem BoundedTaylorLaw.toTaylorLaw {point : ℕ → ℚ} {m : ℕ} {f : ℕ → ℂ} {η : ℂ}
    (h : BoundedTaylorLaw point m f η) : TaylorLaw point m f η := by
  intro r hr
  obtain ⟨B,E,hE⟩ := h r hr
  exact ⟨B,E,fun M => ⟨(hE M).1,(hE M).2.2⟩⟩

theorem original_bounded_taylor_law (point : ℕ → ℚ) (m : ℕ) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ η : ℂ, (η=1 ∨ η= -1) ∧ BoundedTaylorLaw point m f η :=
  original_bounded_rows point m hf
#print axioms original_bounded_taylor_law
end QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource
end
end

/-! ## TwentySevenKnownWordBoundedTaylor -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenKnownWords
open Matrix UpperHalfPlane SmallLevelNormalized Complex Set
open FinitenessOriginalFourier FinitenessFourierConstruction SmallLevelAdditive
open QuantitativeArithmeticTwoSequenceTaylor
open scoped MatrixGroups ModularForm
/-- All-order Taylor--Fricke equations for every known level27 word,
with an analytic remainder derived from the original coefficient growth. -/
theorem original_word_bounded_taylor {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (w : Word) (hC : coordC w≠0) (j : ℝ) (hj : coordC w*j+coordD w≠0) :
    ∃ (bound : ℝ) (error : ℕ → ℂ → ℂ), ∀ M : ℕ,
      AnalyticOnNhd ℂ (error M) {s : ℂ | bound-(M:ℝ)<s.re} ∧
      QuantitativeArithmeticMellinStrip.BoundedSubstrips (bound-(M:ℝ)) (error M) ∧
      ∀ s : ℂ, bound<s.re →
        transform (fullCoefficients f (2*m)) j s-
          (((coordC w*j+coordD w)^2:ℝ):ℂ)^(s-(m:ℂ))*
            (∑ n∈Finset.range M, (Complex.I*((coordC w*(coordC w*j+coordD w):ℝ):ℂ))^n*
              Ring.choose (s+(n:ℂ)-((2*m:ℕ):ℂ)) n*
              transform (fullCoefficients f (2*m))
                ((coordA w*j+coordB w)/(coordC w*j+coordD w)) (s+(n:ℂ)))=
          error M s := by
  obtain ⟨τ,_,hg⟩ := hf.growth
  have hF := original_word_fourier hf w
  have hh := matrix_even_bounded_rows (polynomial_bound hf.zero hg (2*m))
    (fullCoefficients_zero hf.zero (2*m)) m
    (coordA w) (coordB w) (coordC w) (coordD w) j hC
    (by rw [coordinate_det]; norm_num) hj 1 (by
      simpa only [coordinate_det,Complex.ofReal_one,one_pow,mul_one] using hF)
  simpa only [coordinate_det,div_one,one_mul] using hh
#print axioms original_word_bounded_taylor
end QuantitativeArithmeticSmallLevelTwentySevenKnownWords
end
