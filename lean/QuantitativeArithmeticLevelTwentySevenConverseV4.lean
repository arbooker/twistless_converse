/-! ## TwentySevenRSResultant -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSecondSScalar
open QuantitativeArithmeticSmallLevelTwentySevenFirstJetScalar (residual)
open QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds (cubic)

def finalCubic (u : ℂ) : ℂ := 6*u^3-14*u^2-u-30

theorem resultant_identity (u t : ℂ) :
    (24*u-88)*residualS u t-(-264*u^3+456*u^2+2176*u+1344)*residual u t=
      448*(u-6)*(u-4)*cubic u*finalCubic u := by
  unfold residualS QuantitativeArithmeticSmallLevelTwentySevenFirstJetScalar.residual cubic finalCubic
  ring

/-- Retains the extra factor arising in the second Taylor certificate. -/
theorem alternatives_of_residuals (u t : ℂ) (hR : residual u t=0)
    (hS : (u+2)*residualS u t=0) (hK : cubic u≠0) :
    u= -2 ∨ u=6 ∨ u=4 ∨ finalCubic u=0 := by
  rcases mul_eq_zero.mp hS with h|h
  · left
    linear_combination h
  · right
    have hr := resultant_identity u t
    rw [hR,h,mul_zero,mul_zero,sub_zero] at hr
    have hp : (u-6)*(u-4)*finalCubic u=0 := by
