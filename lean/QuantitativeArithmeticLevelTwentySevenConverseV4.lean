theorem observation_rows (i : Fin 321) :
    inputs (1342+i.val)=move 607 (liftRationalRow (QuantitativeArithmeticSmallLevelTwentySevenObservation.basis i.val)) := by
  fin_cases i <;> rfl

theorem output_eval (x y z w a b c : ℂ) (v : ℕ → ℂ) (i : Fin 321) :
    eval x y z w a b c v (inputs (1342+i.val))=basisValues (fun j => v (607+j)) i := by
