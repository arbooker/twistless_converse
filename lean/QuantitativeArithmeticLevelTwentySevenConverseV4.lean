    have hp : (u-6)*(u-4)*finalCubic u=0 := by
      have hh : (448*cubic u)*((u-6)*(u-4)*finalCubic u)=0 := by
        linear_combination hr.symm
      exact (mul_eq_zero.mp hh).resolve_left (mul_ne_zero (by norm_num) hK)
    rcases mul_eq_zero.mp hp with hh|hh
    · rcases mul_eq_zero.mp hh with hh|hh
      · exact Or.inl (sub_eq_zero.mp hh)
      · exact Or.inr (Or.inl (sub_eq_zero.mp hh))
    · exact Or.inr (Or.inr hh)

