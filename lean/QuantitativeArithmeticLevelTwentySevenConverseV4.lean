  have hzero := scalar_zero_at_anchor_pole m hm hf S.B S.G S.meromorphic S.agreement s hshift hanchor hk
  have hzeroR := QuantitativeArithmeticSmallLevelTwentySevenSecondRScalar.scalar_zero_at_anchor_pole m hm hf S.B S.G S.meromorphic S.agreement s hshift hanchor hk
