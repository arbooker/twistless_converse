/-! ## TwentySevenRateBounded -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages
open QuantitativeArithmeticVerticalBounded

certificate_batch {
theorem primeRate_bounded (p κ : ℝ) : Bounded (primeRate p κ) :=
  exponential (Real.log p) κ

theorem primeRate_inv_bounded (p κ : ℝ) : Bounded (fun s => (primeRate p κ s)⁻¹) :=
  exponential_inv (Real.log p) κ

theorem quadratic_bounded (κ : ℝ) (a : ℂ) :
    Bounded (fun s => a*primeRate 2 κ s+(primeRate 2 κ s)^2-1) :=
  (((Bounded.const a).mul (primeRate_bounded 2 κ)).add
    ((primeRate_bounded 2 κ).pow 2)).sub (Bounded.const 1)
