def weights (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (i : Fin 16) : ℂ :=
  coefficient (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) certificate i.val

theorem weights_analytic (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (i : Fin 16) :
    AnalyticAt ℂ (fun z => weights m f z i) s :=
  coefficient_analytic (primeRate 2 m) (primeRate 3 m) (primeRate 5 m) (primeRate 7 m)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) s
    (primeRate_analytic 2 m s) (primeRate_analytic 3 m s) (primeRate_analytic 5 m s) (primeRate_analytic 7 m s)
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)
    certificate i.val

theorem weighted_source_zero (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    (∑ i : Fin 16, weights m f s i*sourceRow (kinds i) m f (-1) s)=0 := by
  let v : ℕ → ℂ := fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) s
  have h := substitution_zero (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) v
    (primeRate_nonzero 2 m s) (primeRate_nonzero 3 m s) (primeRate_nonzero 5 m s) (primeRate_nonzero 7 m s)
    sortedInputs certificate replay
  rw [eval_bounded_eq_sum _ _ _ _ _ _ _ _ _ support] at h
  have he (i : Fin 16) :
      eval (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5) ((Real.sqrt 7:ℂ)*f 7) v (sortedInputs i.val)=
        sourceRow (kinds i) m f (-1) s := by
    change physicalEval (sortedInputs i.val) m f s=_
    rw [source_binding]
    simpa only [Rat.cast_one,Rat.cast_neg] using sourcePolynomial_physical ((-1):ℚ) (kinds i) m f s
  simp_rw [he] at h
  exact h

theorem weighted_anchor_coefficient (m : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    (∑ i : Fin 16, weights m f s i*anchorFlag (kinds i))=
      primeRate 3 m s*firstQuadratic m f s := by
  rw [Finset.sum_eq_single (1:Fin 16)]
  · rw [anchor_kind]
    simp only [anchorFlag,mul_one]
    exact anchor_coefficient _ _ _ _ _ _ _
  · intro i _ hi
    rw [no_other_anchor i hi,mul_zero]
  · intro h
    exact False.elim (h (Finset.mem_univ _))
#print axioms weights_analytic
#print axioms weighted_source_zero
#print axioms weighted_anchor_coefficient
end QuantitativeArithmeticSmallLevelTwentySevenAnchorQuadraticMinus
