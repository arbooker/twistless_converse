def firstRow (m : ℕ) (f : ℕ → ℂ) (G : ℂ → Fin 321 → ℂ) (s : ℂ) : ℂ :=
  ∑ j, (∑ i : Fin 79, weights m f s i*sourceCoefficient (typedSelection i) m 1 0 (s-1) j)*G s j

theorem firstRow_basis (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (v : ℕ → ℂ) :
    firstRow m f (fun _ => basisValues v) s=
      ∑ i : Fin 79, weights m f s i*sourceShift (typedSelection i) m 1 0 (s-1) v := by
  unfold firstRow
  simp only [Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  rw [← sourceShift_action]
  simp only [Finset.mul_sum,mul_assoc]

theorem firstRow_meromorphic (m : ℕ) (f : ℕ → ℂ) 
    (G : ℂ → Fin 321 → ℂ) (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z) (s : ℂ) :
    MeromorphicAt (firstRow m f G) s := by
  apply MeromorphicAt.fun_sum
  intro j _
  apply MeromorphicAt.mul _ (hG j s).meromorphicAt
  apply AnalyticAt.meromorphicAt
  apply Finset.analyticAt_fun_sum
  intro i _
  exact (weights_analytic m f s i).mul
    ((sourceCoefficient_analytic (typedSelection i) m 1 0 (s-1) j).comp
      (f:=fun z : ℂ => z-1) (analyticAt_id.sub analyticAt_const))

theorem firstRow_target_basis (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (v : ℕ → ℂ) :
    firstRow m f (fun _ => basisValues v) s=
      -Complex.I*(s-((2*m:ℕ):ℂ))*observedValue observedTarget m f (fun _ => basisValues v) s := by
  rw [firstRow_basis,observedValue_basis _ observed_target_support,observed_target_jet]
  exact weighted_first_shift_value m f s v

theorem firstRow_target_germ (m : ℕ) (f : ℕ → ℂ)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z) (x : ℂ) :
    firstRow m f G=ᶠ[𝓝[≠] x]
      (fun z => -Complex.I*(z-((2*m:ℕ):ℂ))*observedValue observedTarget m f G z) := by
  apply QuantitativeArithmeticAnalyticDivisorContinuation.halfplane_identity
    (fun _ : Unit => fun _ : ℂ => (1:ℂ))
    (by intro _ _; exact analyticAt_const) x (by intro _; norm_num)
    (x.re-1) BG (fun z _ => firstRow_meromorphic m f G hG z) _ _ (by linarith)
  · intro z _
    exact (analyticAt_const.mul (analyticAt_id.sub analyticAt_const)).meromorphicAt.mul
      (observedValue_meromorphic observedTarget m f G hG z)
