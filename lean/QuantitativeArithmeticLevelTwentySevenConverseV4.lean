    change B-((n:ℝ)+1)<z.re at hz
    change b i-((n:ℝ)+1)<z.re
    linarith [hB i]
  · intro z hz
    exact (hb i n).2 z (lt_of_le_of_lt (hB i) hz)
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (physicalEval)
def heckePoly : Fin 2 → QuantitativeArithmeticSevenLaurentRows.Poly := ![extraPoly1,extraPoly5]
theorem hecke_original (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) :
    ∃ B : ℝ, ∀ i : Fin 2, ∀ s : ℂ, B<s.re → physicalEval (heckePoly i) m f s=0 := by
  have hi (i : Fin 2) : ∃ B : ℝ, ∀ s : ℂ, B<s.re → physicalEval (heckePoly i) m f s=0 := by
    fin_cases i
    · exact extraOriginal1 hm hf
    · exact extraOriginal5 hm hf
  choose b hb using hi
  let B : ℝ := Finset.univ.sup' Finset.univ_nonempty b
  refine ⟨B,?_⟩
  intro i s hs
  exact hb i s (lt_of_le_of_lt (Finset.le_sup' b (Finset.mem_univ i)) hs)
#print axioms matrix_shift_factor
#print axioms matrixCoefficient_analytic
#print axioms matrix_original
#print axioms hecke_original
end QuantitativeArithmeticSmallLevelTwentySevenFirstShiftExtraSource
