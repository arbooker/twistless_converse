/-! ## TwentySevenSourceAllowedPole -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
/-- The positive Taylor coefficient vanishes whenever its shifted argument
is the weight. This is proved for every original source, before elimination. -/
theorem coefficient_zero_at_weight (r : Source) (m : ℕ) (η : ℂ) (n : ℕ)
    (s : ℂ) (hs : s+((n:ℂ)+1)=((2*m:ℕ):ℂ)) (j : Fin 321) :
    coefficient r m η n s j=0 := by
  have he : s+((n+1:ℕ):ℂ)-((2*m:ℕ):ℂ)=0 := by
    simpa only [Nat.cast_add,Nat.cast_one] using sub_eq_zero.mpr hs
  cases r with
  | old t =>
    cases t with
    | hecke t ht => rfl
    | entire t => rfl
    | matrix t =>
      simp only [coefficient,QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.kindCoefficient,
        QuantitativeArithmeticSmallLevelTwentySevenShiftSource.Matrix.coefficient,
        he,Ring.choose_zero_succ,mul_zero,zero_mul]
    | ramanujan t =>
      simp only [coefficient,QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.kindCoefficient,
        QuantitativeArithmeticSmallLevelTwentySevenShiftSource.Ramanujan.coefficient,
        SmallLevelTaylor.taylorRowScalar,he,Ring.choose_zero_succ,mul_zero,zero_mul]
  | matrix t ht obs ho =>
    simp only [coefficient,matrixCoefficient,he,Ring.choose_zero_succ,mul_zero,zero_mul]
  | ramanujan t ht obs ho =>
    simp only [coefficient,ramanujanCoefficient,SmallLevelTaylor.taylorRowScalar,
      he,Ring.choose_zero_succ,mul_zero,zero_mul]
  | hecke t ht => rfl
  | entire t ht => rfl
#print axioms coefficient_zero_at_weight
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
