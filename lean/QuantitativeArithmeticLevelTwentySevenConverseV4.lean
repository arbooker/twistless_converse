theorem selectionNode17_35_binding (n : ℕ) (hl : 272≤n) (hh : n<550) : QuantitativeArithmeticSmallLevelTwentySevenPoleAPLiftPlusStages.inputs n=sourcePolynomial (1:ℚ) (selectionNode17_35 n) := by
