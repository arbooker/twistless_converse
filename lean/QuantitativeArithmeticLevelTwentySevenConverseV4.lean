/-! ## TwentySevenSecondRScalarPhysical -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSecondRScalar
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenFirstJetScalar (residual)
open QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_nonzero)
open QuantitativeArithmeticSmallLevelTwentySevenObservation (basisMatrix)
open QuantitativeArithmeticSmallLevelTwentySevenHeckeSource (originalVector)
open QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource (forcedB)
open QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds (cubic)
open QuantitativeArithmeticAnalyticGerm (HasAnalyticGerm)

abbrev scalarValue := QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorPlus.anchorScalar

theorem scalar_same : QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorPlus.scalar=
    QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorMinus.scalar := by rfl

theorem scalarValue_analytic (m : ℕ) (f : ℕ → ℂ) (x : ℂ) : AnalyticAt ℂ (scalarValue m f) x := by
  have he : scalarValue m f=fun z => QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorPlus.weights m f z 10 := by
    funext z
    exact (QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorPlus.scalar_coefficient _ _ _ _ _ _ _).symm
  rw [he]
  exact QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorPlus.weights_analytic m f x 10

theorem signed_scalar_same (η : ℂ) (m : ℕ) (f : ℕ → ℂ) (z : ℂ) :
    QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorSource.anchorScalar η m f z=scalarValue m f z := by
  unfold QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorSource.anchorScalar
  split
  · rfl
  · simp only [QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorMinus.anchorScalar,
      QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorPlus.anchorScalar,scalarValue,scalar_same]

theorem original_scalar_germ (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z)
    (x : ℂ) (hx : ∀ n : ℕ, 0<n → ∀ i, 0≤meromorphicOrderAt (fun z => G z i) (x+n)) :
    HasAnalyticGerm (fun z => -Complex.I*(z-((2*m:ℕ):ℂ))*scalarValue m f z*G z 6) x := by
  obtain ⟨η,_,h⟩ := QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorSource.original_anchor_first_jet_germ
    m hm hf BG G hG hagree
  simpa only [signed_scalar_same] using h x hx

theorem scalar_zero_at_anchor_pole (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 321 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun w => G w i) z)
    (hagree : ∀ z, BG<z.re → G z=basisMatrix *ᵥ originalVector m f z)
    (x : ℂ) (hx : ∀ n : ℕ, 0<n → ∀ i, 0≤meromorphicOrderAt (fun z => G z i) (x+n))
    (hp : meromorphicOrderAt (fun z => G z 6) x<0) (hk : x≠((2*m:ℕ):ℂ)) :
    scalarValue m f x=0 := by
  have h := QuantitativeArithmeticAnalyticGerm.multiplier_zero_at_pole
    ((analyticAt_const.mul (analyticAt_id.sub analyticAt_const)).mul (scalarValue_analytic m f x))
    (original_scalar_germ m hm hf BG G hG hagree x hx) hp
  exact (mul_eq_zero.mp h).resolve_left
    (mul_ne_zero (neg_ne_zero.mpr Complex.I_ne_zero) (sub_ne_zero.mpr hk))

theorem residual_of_scalar_zero (m : ℕ) (f : ℕ → ℂ) (s : ℂ)
    (hA : (Real.sqrt 2:ℂ)*f 2=(primeRate 2 m s)⁻¹-primeRate 2 m s)
    (hB : (Real.sqrt 5:ℂ)*f 5=forcedB (primeRate 2 m s) (primeRate 5 m s))
    (hK : cubic ((primeRate 2 m s)^2)≠0) (hzero : scalarValue m f s=0) :
    residual ((primeRate 2 m s)^2) ((primeRate 5 m s)^2)=0 := by
  have h := QuantitativeArithmeticSmallLevelTwentySevenSecondRAnchorPlus.scalar_on_divisors
    (primeRate 2 m s) (primeRate 3 m s) (primeRate 5 m s) (primeRate 7 m s)
    ((Real.sqrt 7:ℂ)*f 7) (primeRate_nonzero 2 m s) (primeRate_nonzero 5 m s) hK
  change eval _ _ _ _ _ _ _ (fun _ => 1) _=0 at hzero
  rw [hA,hB] at hzero
  rw [hzero,mul_zero] at h
  have hn : ((729/280:ℂ)*(primeRate 2 m s)^2*primeRate 3 m s)≠0 :=
    mul_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero _ (primeRate_nonzero 2 m s))) (primeRate_nonzero 3 m s)
  apply (mul_eq_zero.mp (show ((729/280:ℂ)*(primeRate 2 m s)^2*primeRate 3 m s)*
    (residual ((primeRate 2 m s)^2) ((primeRate 5 m s)^2))=0 from by
      simpa only [mul_assoc] using h.symm)).resolve_left hn
#print axioms original_scalar_germ
#print axioms scalar_zero_at_anchor_pole
#print axioms residual_of_scalar_zero
end QuantitativeArithmeticSmallLevelTwentySevenSecondRScalar
end
