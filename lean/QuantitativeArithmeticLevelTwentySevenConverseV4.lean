/-! ## TwentySevenHighestPoleResonance -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenSecondSScalar
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate)
open QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource (forcedB forcedC)

theorem primeRate_resonance (p : ℕ) (hp : 0<p) (m : ℕ) :
    primeRate p m ((m:ℂ)+1)=(p:ℂ) := by
  rw [primeRate_cpow p hp]
  simp only [Complex.ofReal_natCast,add_sub_cancel_left,Complex.cpow_one]

theorem resonance_parameters (m : ℕ) (a b c : ℂ)
    (ha : a=(primeRate 2 m ((m:ℂ)+1))⁻¹-primeRate 2 m ((m:ℂ)+1))
    (hb : b=forcedB (primeRate 2 m ((m:ℂ)+1)) (primeRate 5 m ((m:ℂ)+1)))
    (hc : c=forcedC (primeRate 2 m ((m:ℂ)+1)) (primeRate 5 m ((m:ℂ)+1))
      (primeRate 7 m ((m:ℂ)+1)) b) :
    a= -(3/2:ℂ) ∧ b= -3 ∧ c= -(25/7:ℂ) := by
  have h2 : primeRate 2 m ((m:ℂ)+1)=2 := by
    simpa only [Nat.cast_ofNat] using primeRate_resonance 2 (by decide) m
  have h5 : primeRate 5 m ((m:ℂ)+1)=5 := by
    simpa only [Nat.cast_ofNat] using primeRate_resonance 5 (by decide) m
  have h7 : primeRate 7 m ((m:ℂ)+1)=7 := by
    simpa only [Nat.cast_ofNat] using primeRate_resonance 7 (by decide) m
  rw [h2] at ha
  rw [h2,h5] at hb
  norm_num [forcedB,QuantitativeArithmeticSmallLevelTwentySevenPoleKBounds.cubic] at hb
  rw [h2,h5,h7,hb] at hc
  norm_num [forcedC] at hc
  norm_num at ha
  exact ⟨ha,hb,hc⟩

/-- The generic pole locations apply to any original continued observation
system, so independently constructed pole lemmas can be used together. -/
theorem highest_pole_location (m : ℕ) (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (s : ℂ) (hf2 : f 2≠0) (hminus : primeRate 2 m s-1≠0)
    (hplus : primeRate 2 m s+1≠0)
    (hshift : ∀ n : ℕ,0<n → ∀ i : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z i) (s+n))
    (hpole : ∃ i : Fin 321,meromorphicOrderAt (fun z => S.G z i) s<0) :
    s=((2*m:ℕ):ℂ) ∨ s=(m:ℂ)+1 := by
  obtain ⟨T,hT⟩ := original_resonance_constraint m hm hf
  apply hT s hf2 hminus hplus
  · intro n hn i
    rw [← S.order_eq T (s+n) i]
    exact hshift n hn i
  · obtain ⟨i,hi⟩ := hpole
    exact ⟨i,by rwa [← S.order_eq T s i]⟩

theorem highest_resonance_parameters (m : ℕ) (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f) (S : PoleSystem m f)
    (hf2 : f 2≠0)
    (hshift : ∀ n : ℕ,0<n → ∀ i : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z i) ((m:ℂ)+1+n))
    (hpole : ∃ i : Fin 321,meromorphicOrderAt (fun z => S.G z i) ((m:ℂ)+1)<0) :
    (Real.sqrt 2:ℂ)*f 2= -(3/2:ℂ) ∧
    (Real.sqrt 5:ℂ)*f 5= -3 ∧ (Real.sqrt 7:ℂ)*f 7= -(25/7:ℂ) := by
  obtain ⟨T,hT⟩ := QuantitativeArithmeticSmallLevelTwentySevenPoleAPSource.original_pole_parameters m hm hf
  obtain ⟨i,hi⟩ := hpole
  have h2 : primeRate 2 m ((m:ℂ)+1)=2 := by
    simpa only [Nat.cast_ofNat] using primeRate_resonance 2 (by decide) m
  obtain ⟨_,ha,hb,hc⟩ := hT ((m:ℂ)+1) hf2 (by rw [h2]; norm_num)
    (by rw [h2]; norm_num) (by
      intro n hn j
      rw [← S.order_eq T _ j]
      exact hshift n hn j) i (by rwa [← S.order_eq T _ i])
  exact resonance_parameters m _ _ _ ha hb hc

#print axioms highest_pole_location
#print axioms highest_resonance_parameters
end QuantitativeArithmeticSmallLevelTwentySevenSecondSScalar
end
end

/-! ## TwentySevenFourthAnchorProfilePlusOriginalGerms -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 4000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentySevenFourthAnchorProfilePlus
open Matrix
open QuantitativeArithmeticSmallLevelTwentySevenPoleAnchorSource
open QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch (PoleSystem)
open QuantitativeArithmeticSmallLevelTwentySevenPlusGenericStages (primeRate primeRate_analytic)
open QuantitativeArithmeticSmallLevelTwentySevenSecondSScalar (primeRate_resonance)
open QuantitativeArithmeticAnalyticGerm

theorem concrete_left_profile (m : ℕ) (f : ℕ→ℂ)
    (ha : (Real.sqrt 2:ℂ)*f 2= -(3/2:ℂ))
    (hb : (Real.sqrt 5:ℂ)*f 5= -3)
    (hc : (Real.sqrt 7:ℂ)*f 7= -(25/7:ℂ)) :
    (concretePlusChart m f).L ((m:ℂ)+1) *ᵥ
      (fun i => anchorFlag ((concretePlusChart m f).selection i))=observationProfile := by
  change QuantitativeArithmeticSmallLevelTwentySevenPoleAPQAnchorLiftPlusStages.physicalLeft m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5)
    ((Real.sqrt 7:ℂ)*f 7) ((m:ℂ)+1) *ᵥ _=observationProfile
  have h2 : primeRate 2 m ((m:ℂ)+1)=2 := by
    simpa only [Nat.cast_ofNat] using primeRate_resonance 2 (by decide) m
  have h3 : primeRate 3 m ((m:ℂ)+1)=3 := by
    simpa only [Nat.cast_ofNat] using primeRate_resonance 3 (by decide) m
  have h5 : primeRate 5 m ((m:ℂ)+1)=5 := by
    simpa only [Nat.cast_ofNat] using primeRate_resonance 5 (by decide) m
  have h7 : primeRate 7 m ((m:ℂ)+1)=7 := by
    simpa only [Nat.cast_ofNat] using primeRate_resonance 7 (by decide) m
  rw [ha,hb,hc,QuantitativeArithmeticSmallLevelTwentySevenPoleAPQAnchorLiftPlusStages.physicalLeft,h2,h3,h5,h7]
  simpa only [concretePlusChart,Nat.cast_ofNat,neg_div] using left_anchor_profile

/-- The explicit rational profile used by the fourth-order certificate is
the polar profile of the ORIGINAL321 continued observations. -/
theorem original_profile_germs (m : ℕ) (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw
      QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.point m f 1)
    (S : PoleSystem m f)
    (ha : (Real.sqrt 2:ℂ)*f 2= -(3/2:ℂ))
    (hb : (Real.sqrt 5:ℂ)*f 5= -3)
    (hc : (Real.sqrt 7:ℂ)*f 7= -(25/7:ℂ))
    (hshift : ∀ n : ℕ, 0<n → ∀ j : Fin 321,
      0≤meromorphicOrderAt (fun z => S.G z j) (((m:ℂ)+1)+n)) :
    ∀ i, HasAnalyticGerm (fun z => S.G z i-observationProfile i*S.G z 6) ((m:ℂ)+1) := by
  have h2 : primeRate 2 m ((m:ℂ)+1)=2 := by
    simpa only [Nat.cast_ofNat] using primeRate_resonance 2 (by decide) m
  have hx : liftRegularPoint m f ((m:ℂ)+1) := by
    refine ⟨?_,?_,?_⟩
    · rw [ha]; norm_num
    · rw [h2]; norm_num
    · rw [h2]; norm_num
  have hsq : (primeRate 2 m ((m:ℂ)+1))^2≠ -1 := by rw [h2]; norm_num
  have hquad := quadratic_germ_for_continuation m hm hf S.B S.G
    S.meromorphic S.agreement ((m:ℂ)+1) hshift
  have horder := QuantitativeArithmeticQuadraticGermOrder.pole_order_ge_neg_one
    (primeRate_analytic 2 m ((m:ℂ)+1)) (primeRate_two_deriv_ne_zero m ((m:ℂ)+1))
    ((Real.sqrt 2:ℂ)*f 2) hsq (S.meromorphic 6 ((m:ℂ)+1)).meromorphicAt hquad
  obtain ⟨hJ,hrow⟩ := lift_anchor_for_chosen_chart m hm hf 1 (by simp) hlaw
    (concretePlusChart m f) S.B S.G S.meromorphic S.agreement ((m:ℂ)+1) hx hshift
  intro i
  have h := freeze_simple_pole_anchor (hrow i) (hJ i)
    (S.meromorphic 6 ((m:ℂ)+1)).meromorphicAt horder
  simpa only [concrete_left_profile m f ha hb hc] using h

#print axioms concrete_left_profile
#print axioms original_profile_germs
end QuantitativeArithmeticSmallLevelTwentySevenFourthAnchorProfilePlus
end
end

