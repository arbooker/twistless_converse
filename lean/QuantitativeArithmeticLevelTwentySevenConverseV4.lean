theorem source_action (m : ℕ) (f : ℕ → ℂ) (hf2 : f 2=0) (s : ℂ) :
    QuantitativeArithmeticSmallLevelTwentySevenPlusZeroStages.physicalSource m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 5:ℂ)*f 5)
      ((Real.sqrt 7:ℂ)*f 7) s *ᵥ originalVector m f s=selectedRows selection m f 1 s := by
  funext i
