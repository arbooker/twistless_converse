    Nat.cast_one,Nat.cast_zero,add_zero,sub_add_cancel,
    Ring.choose_one_right,Ring.choose_zero_right,mul_one]
  ring

theorem matrix_first (point : ℕ → ℚ)
    (r : QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.Spec)
    (m : ℕ) (s : ℂ) (v : ℕ → ℂ) :
    QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.shift point r m 0 (s-1) v=
      -Complex.I*(s-((2*m:ℕ):ℂ)) *
        (-(QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.entry r.word 1 0:ℂ)*
          (QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.denominator point r:ℂ)*
          ((primeRate 2 m s/2)^r.e₂*(primeRate 3 m s/3)^r.e₃*
            (primeRate 5 m s/5)^r.e₅*(primeRate 7 m s/7)^r.e₇)*v r.right) := by
  unfold QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.shift
  simp only [zero_add,pow_one,Nat.cast_one,sub_add_cancel,Ring.choose_one_right]
  rw [primeRate_sub_one 2 m (by norm_num),primeRate_sub_one 3 m (by norm_num),
    primeRate_sub_one 5 m (by norm_num),primeRate_sub_one 7 m (by norm_num)]
  norm_num only [Complex.ofReal_ofNat]
