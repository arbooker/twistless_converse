/-! ## TwentyFiveExceptionalBlockEvaluation -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSevenLaurentRows SmallLevelFiniteShift

/- Sparse block evaluation is exactly the coupled normalized Taylor row. -/
compact_certificate theorem exceptionalBlock_eval (c : ℂ) (v : Fin 4 × Fin 1050 → ℂ)
    (n : Fin 4) (r : SourceRow)
    (hs : ∀ t∈exceptionalPoly n.val (rawSourcePoly (-1) r), t.2.1<1050)
    (ht : ∀ a<n.val, ∀ t∈exceptionalShift (-1) n.val a r, t.2.1<1050) :
    eval 1 1 1 1 0 0 c (blockPeriodic v) (exceptionalBlockPoly (-1) n.val r)=
      eval 1 1 1 1 0 0 c (periodicVector (fun j => v (n,j)))
        (exceptionalPoly n.val (rawSourcePoly (-1) r))-
      ∑ a∈Finset.range n.val,
        eval 1 1 1 1 0 0 c (periodicVector (fun j => v (lowerIndex n a,j)))
          (exceptionalShift (-1) n.val a r) := by
  unfold exceptionalBlockPoly
  rw [QuantitativeArithmeticSevenLaurentRows.eval_append,blockMove_eval c v n _ hs,
    eval_flatMap,← List.sum_toFinset _ (List.nodup_range (n:=n.val))]
  simp only [List.toFinset_range]
  rw [sub_eq_add_neg,← Finset.sum_neg_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro a ha
  rw [eval_shift _ _ _ _ _ _ _ _ (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
  have he := blockMove_eval c v (lowerIndex n a) _ (ht a (Finset.mem_range.mp ha))
  change eval _ _ _ _ _ _ _ _ (blockMovePoly (n.val-1-a) _)=_ at he
  rw [he]
  simp [monomial]

#print axioms exceptionalBlock_eval
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
