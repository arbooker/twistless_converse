/-! ## TwentyFiveCuspMinusLowerResidualEvaluation -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticSmallLevelTwentyFiveCuspLift

/- Evaluation of the certified lower-point rows is the actual original
Euler/Fricke leading expression. -/
compact_certificate theorem lower_eval {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε s : ℂ) (hχ : ε*Complex.I^(2*m)= -1) (v : Fin 1050 → ℂ) (i : Fin 117) :
    eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun j => periodicVector v (7*j)) (lowerSource i.val)=
      leading (physicalRows i.val) m f ε (s-1) v := by
  have hp (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he := eval_rawSourcePoly (actual i.val) hf ε (s-1) (-1:ℚ) (by simpa using hχ) v
  rw [← eval_lowerPoly_physical,← eval_normalizedPoly _ _ _ _ _ _ _ _
    (hp 2 (by decide)) (hp 3 (by decide)) (hp 5 (by decide)) (hp 7 (by decide)),
    actual_lower i,eval_liftPoly] at he
  simpa only [actual_physical i,sourceLeading] using he

/- The selected first-shift polynomials retain the exact common weight
factor. In particular this identity remains valid at the weight point. -/
compact_certificate theorem shift_eval (m : ℕ) (f : ℕ → ℂ)
    (ε s : ℂ) (hχ : ε*Complex.I^(2*m)= -1) (v : Fin 1050 → ℂ) (i : Fin 117) :
    shifted (physicalRows i.val) m f ε 0 (s-1) v=
      Complex.I*(s-((2*m:ℕ):ℂ))*eval (primeParameter 2 m s) (primeParameter 3 m s)
        (primeParameter 5 m s) (primeParameter 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
        (fun j => periodicVector v (7*j)) (rawJet i.val) := by
  have hp (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he := eval_rawFirstJetPoly (actual i.val) m f ε s (-1:ℚ) (by simpa using hχ) v
  rw [← eval_normalizedPoly _ _ _ _ _ _ _ _
    (hp 2 (by decide)) (hp 3 (by decide)) (hp 5 (by decide)) (hp 7 (by decide)),
    actual_shift i,eval_liftPoly] at he
  simpa only [actual_physical i,sourceShifted] using he

compact_certificate theorem upper_eval {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε s : ℂ) (hχ : ε*Complex.I^(2*m)= -1) (v : Fin 1050 → ℂ) (i : Fin 117) :
    eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun j => periodicVector v (7*j)) (upperSource i.val)=
      leading (physicalRows i.val) m f ε s v := by
  have hp (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he := eval_rawSourcePoly (actual i.val) hf ε s (-1:ℚ) (by simpa using hχ) v
  rw [← eval_normalizedPoly _ _ _ _ _ _ _ _
    (hp 2 (by decide)) (hp 3 (by decide)) (hp 5 (by decide)) (hp 7 (by decide)),
    actual_upper i,eval_liftPoly] at he
  simpa only [actual_physical i,sourceLeading] using he

#print axioms upper_eval
#print axioms lower_eval
#print axioms shift_eval
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
