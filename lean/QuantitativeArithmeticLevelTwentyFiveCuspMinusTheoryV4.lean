/-! ## TwentyFiveCuspMinusRegularizedBranch -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector

/- An actual regularized top pole, including at the weight, satisfies the four reduced
first-jet constraints. The inputs concern the original solution and its
continued gauge, not a separately postulated algebraic kernel vector. -/
compact_certificate theorem regularized_jet_constraints (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    :
    ∀ j : Fin 4, eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun t => periodicVector v (7*coordinate (t+145))) (jetConstraint j.val)=0 := by
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  exact first_jet_parametrization _ _ _ _ _ _ _ (fun t => periodicVector v (7*t))
    (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide))
    (pole_leading_rows free hm hf ε hε hlaw hχ BG G hG hGF s v
      (hv.of_analytic_factor _ (analyticAt_id.sub analyticAt_const)) hshift)
    (regularized_pole_first_jet free hm hf ε hε hlaw hχ BG G hG hGF s v hv hshift)

/- If the denominator-five free coordinate is nonzero, an actual regularized top pole
lies on Re(s-m)=1. This is a pole-location restriction,
not the subsequent exclusion of that line. -/
compact_certificate theorem regularized_nonzero_cusp_branch (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hu : periodicVector v (7*coordinate (3+145))≠0) :
    (s-(m:ℂ)).re=1 ∧ ‖(primeParameter 2 m s)^2‖=4 := by
  exact physical_nonzero_cusp_branch (s-(m:ℂ)) _ _ _ _ _
    (fun t => periodicVector v (7*coordinate (t+145))) hu
    (regularized_jet_constraints free hm hf ε hε hlaw hχ BG G hG hGF s v hv hshift)

#print axioms regularized_jet_constraints
#print axioms regularized_nonzero_cusp_branch
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
