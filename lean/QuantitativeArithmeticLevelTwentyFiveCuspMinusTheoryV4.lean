/- The six unscaled residual equations imply the nine explicit branch rows. -/
compact_certificate theorem branch_rows (x z σ : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hz : z≠0) (hσ : σ=1 ∨ σ= -1)
    (hu : ∀ i : Fin 6, eval x (σ*(3*x/2)) z 1 (1/x-x/2) (σ*(2/(3*x)-4*x/3)) 0
      (topValues z v) (CuspMinusLowerResidual.upperResidual i.val)=0)
    (hl : ∀ i : Fin 6, eval x (σ*(3*x/2)) z 1 (1/x-x/2) (σ*(2/(3*x)-4*x/3)) 0
      (lowerValues z v) (CuspMinusLowerResidual.lowerResidual i.val)=
      eval x (σ*(3*x/2)) z 1 (1/x-x/2) (σ*(2/(3*x)-4*x/3)) 0
      (topFree z v) (CuspMinusLowerResidual.firstResidual i.val)) :
    ∀ i : Fin 9, eval x 1 z 1 0 0 0 v (CuspMinusBranchMatrix.rows i.val)=0 := by
  intro i
  fin_cases i
  · exact (row_identity_0 x z σ v hx hz hσ).symm.trans (hu ⟨0,by decide⟩)
  · exact (row_identity_1 x z σ v hx hz hσ).symm.trans (sub_eq_zero.mpr (hl ⟨0,by decide⟩))
  · exact (row_identity_2 x z σ v hx hz hσ).symm.trans (hu ⟨1,by decide⟩)
  · exact (row_identity_3 x z σ v hx hz hσ).symm.trans (sub_eq_zero.mpr (hl ⟨1,by decide⟩))
  · exact (row_identity_4 x z σ v hx hz hσ).symm.trans (sub_eq_zero.mpr (hl ⟨2,by decide⟩))
  · exact (row_identity_5 x z σ v hx hz hσ).symm.trans (sub_eq_zero.mpr (hl ⟨3,by decide⟩))
  · exact (row_identity_6 x z σ v hx hz hσ).symm.trans (hu ⟨4,by decide⟩)
  · exact (row_identity_7 x z σ v hx hz hσ).symm.trans (sub_eq_zero.mpr (hl ⟨4,by decide⟩))
  · exact (row_identity_8 x z σ v hx hz hσ).symm.trans (sub_eq_zero.mpr (hl ⟨5,by decide⟩))

compact_certificate theorem topValues_zero (z : ℂ) (v : ℕ → ℂ)
    (h0 : v 0=0) (h1 : v 1=0) (h2 : v 2=0) (h8 : v 8=0) : topValues z v=0 := by
  funext j
  unfold topValues
  split <;> simp [h0,h1,h2,h8]

compact_certificate theorem topFree_zero (z : ℂ) (v : ℕ → ℂ)
    (h0 : v 0=0) (h1 : v 1=0) (h2 : v 2=0) (h8 : v 8=0) : topFree z v=0 := by
  funext j
  unfold topFree
  split <;> simp [h0,h1,h2,h8]

/- Five lower-point unknowns cannot support a homogeneous solution on the
forced circle. This is the algebraic input to bounding lower pole orders. -/
compact_certificate theorem lower_kernel (x z σ : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hz : z≠0) (hσ : σ=1 ∨ σ= -1) (hc : ‖x^2‖=4)
    (h0 : v 0=0) (h1 : v 1=0) (h2 : v 2=0) (h8 : v 8=0)
    (hl : ∀ i : Fin 6, eval x (σ*(3*x/2)) z 1 (1/x-x/2) (σ*(2/(3*x)-4*x/3)) 0
      (lowerValues z v) (CuspMinusLowerResidual.lowerResidual i.val)=0) :
    ∀ j : Fin 8, v j.val=0 := by
  have hu := topValues_zero z v h0 h1 h2 h8
  have ht := topFree_zero z v h0 h1 h2 h8
  have hr := branch_rows x z σ v hx hz hσ
    (by intro i; rw [hu]; simp [eval])
    (by intro i; rw [ht,hl i]; simp [eval])
  apply CuspMinusBranchMatrix.coefficient_kernel x z v hx hz hc
