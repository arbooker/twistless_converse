open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- All three lower leading systems are injective at the exceptional
parameters, so a four-point principal vector retains a nonzero top. -/
compact_certificate theorem exceptional_four_point_upper_nonzero
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (v : Fin 4 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 3 G) ((m:ℂ)+1) v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) ((m:ℂ)+1+n))
    (h2 : (Real.sqrt 2:ℂ)*f 2= -1/2) (h3 : (Real.sqrt 3:ℂ)*f 3= -7/3) :
    (fun j => v (0,j))≠0 := by
  intro hzero
  have hall : ∀ n : ℕ, ∀ hn : n<4, (fun j => v (⟨n,hn⟩,j))=0 := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn
      by_cases hz : n=0
      · subst n; exact hzero
