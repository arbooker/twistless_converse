/-! ## TwentyFiveCuspMinusTwoPointNonzero -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- On the forced first-jet branch, a universal two-point vector has a
nonzero upper projection. The lower pole is allowed to have arbitrary order. -/
compact_certificate theorem upper_nonzero_on_branch
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 2 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 1 G) s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : s≠((2*m:ℕ):ℂ)) (σ : ℂ) (hσ : σ=1 ∨ σ= -1)
    (hy : primeParameter 3 m s=σ*(3*primeParameter 2 m s/2))
    (ha : (Real.sqrt 2:ℂ)*f 2=1/primeParameter 2 m s-primeParameter 2 m s/2)
    (hb : (Real.sqrt 3:ℂ)*f 3=σ*(2/(3*primeParameter 2 m s)-4*primeParameter 2 m s/3))
    (hc : ‖(primeParameter 2 m s)^2‖=4) : (fun j => v (0,j))≠0 := by
  intro hzero
  have hn (p : ℕ) (hp : p≠0) (t : ℂ) : primeParameter p m t≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  let d : ℂ := (Complex.I*(s-((2*m:ℕ):ℂ)))⁻¹
  have hd : d≠0 := inv_ne_zero (mul_ne_zero I_ne_zero (sub_ne_zero.mpr hs))
  let u : ℕ → ℂ := fun j => periodicVector (fun t => v (1,t)) (7*j)
  have hsrc := two_point_source_equations AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hshift hs
  have hsource : ∀ i : Fin 117, eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun j => d*u j) (lowerSource i.val)=0 := by
    intro i
    have h := (hsrc i).2
    rw [hzero] at h
    simpa only [d,u,periodicVector,Pi.zero_apply,mul_zero,List.map_const',List.sum_replicate,
      nsmul_zero,eval] using h
  have hres := lower_homogeneous _ _ _ _ _ _ _ (fun j => d*u j)
    (hn 2 (by decide) s) (hn 3 (by decide) s) (hn 5 (by decide) s) (hn 7 (by decide) s) hsource
  rw [hy,ha,hb] at hres
  have hfree := CuspMinusBranchParameters.lower_free_kernel _ _ σ _ _ (fun j => d*u j)
    (hn 2 (by decide) s) (hn 5 (by decide) s) hσ hc hres
  have hlead := CuspMinusLaurent.lower_leading_rows_of_upper_zero AuxMinusLaurent.freeCoordinate
    hm hf ε hε hlaw hχ BG G hG hGF s v hv hzero hshift
  have hold := CuspMinusLaurent.leading_kernel _ _ _ _ _ _ _ u
    (hn 2 (by decide) (s-1)) (hn 3 (by decide) (s-1))
    (hn 5 (by decide) (s-1)) (hn 7 (by decide) (s-1)) hlead
    (fun j => (mul_eq_zero.mp (hfree _ (coordinate_isFree j))).resolve_left hd)
  have hl := AuxMinusLaurent.lower_zero_of_upper_old_zero hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hshift hzero (by
      intro j
      have h := hold j.val j.isLt
      simpa only [u,periodicVector,Nat.mod_eq_of_lt (show 7*j.val<1050 by omega)] using h)
  apply hv.1
  funext j
  rcases j with ⟨i,j⟩
  fin_cases i
  · exact congrFun hzero j
  · exact congrFun hl j

#print axioms upper_nonzero_on_branch
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
end
end

/-! ## TwentyFiveCuspMinusPoleLeading -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector
open QuantitativeArithmeticSmallLevelTwentyFiveCuspLift

/- The 1198 original physical cusp rows annihilate the restriction of the
same auxiliary principal part. No vanishing is imposed on external old-grid
source terms, which may themselves have poles. -/
compact_certificate theorem pole_leading_rows (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n)) :
    ∀ i<1198, eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun t => periodicVector v (7*t)) (source i)=0 := by
  intro i hi
  let j : Fin 4600 := ⟨auxIndex i, all_aux_index_bound i hi⟩
  let r := physicalPart (AuxMinusLaurent.actual (auxIndex i))
  have hr : AuxMinusLaurent.actual j.val=SourceRow.physical r :=
    cusp_source_physical ⟨i,hi⟩
  have hp := AuxMinusLaurent.all_actual_source j
  have hq := AuxMinusLaurent.all_actual_tail j
  rw [hr] at hp hq
  have hlead := physical_leading_pole AuxMinusLaurent.basis free
    AuxMinusLaurent.basis_periodic r (-1) (AuxMinusLaurent.source j.val)
    (AuxMinusLaurent.tail j.val) hp hq
    (AuxMinusLaurent.all_source_zero j) (AuxMinusLaurent.all_tail_zero j)
    hm hf ε hε hlaw (by simpa using hχ) BG G hG hGF s v hv hshift
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he := eval_rawSourcePoly (.physical r) hf ε s (-1) (by simpa using hχ) v
  rw [← eval_normalizedPoly _ _ _ _ _ _ _ _ (hn 2 (by decide)) (hn 3 (by decide))
    (hn 5 (by decide)) (hn 7 (by decide)), hp] at he
  change eval _ _ _ _ _ _ _ _ (AuxMinusLaurent.source (auxIndex i))=_ at he
  rw [all_aux_source i hi, eval_liftPoly] at he
  exact he.trans hlead

#print axioms pole_leading_rows
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
end

/-! ## TwentyFiveCuspMinusTwoPointResidual -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

compact_certificate def evalAt (m : ℕ) (f : ℕ → ℂ) (s : ℂ) (v : ℕ → ℂ) (p : Poly) : ℂ :=
  eval (primeParameter 2 m s) (primeParameter 3 m s)
    (primeParameter 5 m s) (primeParameter 7 m s)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7) v p

/- The six coupled residual equations hold for an actual two-point principal
vector with nonzero upper projection. Lower pole orders are not prescribed. -/
compact_certificate theorem two_point_residual_equations (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 2 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 1 G) s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : s≠((2*m:ℕ):ℂ)) (h0 : (fun j => v (0,j))≠0) :

    ∀ i : Fin 6,
      evalAt m f s (fun j => periodicVector (fun t => v (0,t)) (7*j)) (upperResidual i.val)=0 ∧
      evalAt m f s
        (fun j => (Complex.I*(s-((2*m:ℕ):ℂ)))⁻¹*periodicVector (fun t => v (1,t)) (7*j))
        (lowerResidual i.val)=
      evalAt m f s
        (fun j => periodicVector (fun t => v (0,t)) (7*CuspMinusLaurent.coordinate (j+145)))
        (firstResidual i.val) := by
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hsrc := two_point_source_equations free hm hf ε hε hlaw hχ BG G hG hGF s v hv hshift hs
  have hv0 := hv.project_zero h0
  have hlead := CuspMinusLaurent.pole_leading_rows free hm hf ε hε hlaw hχ
    BG G hG hGF s (fun j => v (0,j)) hv0 hshift
  have hp := CuspMinusLaurent.leading_parametrization _ _ _ _ _ _ _
    (fun j => periodicVector (fun t => v (0,t)) (7*j))
    (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide)) hlead
  have hu := upper_residuals _ _ _ _ _ _ _ _
    (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide))
    (fun i => (hsrc i).1)
  have hl := lower_residuals _ _ _ _ _ _ _ _ _ _
    (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide))
    (fun i => (hsrc i).2) hp
  exact fun i => ⟨hu i,hl i⟩

#print axioms two_point_residual_equations
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
end
end

