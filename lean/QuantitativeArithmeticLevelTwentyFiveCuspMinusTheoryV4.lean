/-! ## TwentyFiveCuspMinusPoleSquare -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- A nonzero denominator-five top pole away from the weight forces
2^(2(s-m))=4. Both signs and arbitrary lower-point pole orders are included. -/
compact_certificate theorem pole_square_four
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) s<0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : s≠((2*m:ℕ):ℂ)) (hu : periodicVector v (7*coordinate (3+145))≠0) :
    (primeParameter 2 m s)^2=4 := by
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hj := pole_jet_constraints AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ BG G
    hG hGF s v hv hshift hs
  have hb := nonzero_cusp_branch _ _ _ _ _ _ _ _ (hn 2 (by decide)) (hn 3 (by decide)) hu hj
  obtain ⟨σ,hσ,hy,ha,hb'⟩ := branch_signs _ _ _ _ (hn 2 (by decide)) (hn 3 (by decide))
    hb.2.1 hb.2.2.1 hb.2.2.2
  have hc := (pole_nonzero_cusp_branch AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hshift hs hu).2
  have hstack (b : Fin 2 × Fin 1050) : MeromorphicAt (fun z => stackGrid 1 G z b) s :=
    (hG b.2 (s-b.1.val)).meromorphicAt.comp_analyticAt
      (g:=fun z : ℂ => z-(b.1.val:ℂ)) (analyticAt_id.sub analyticAt_const)
  have hpstack : ∃ b : Fin 2 × Fin 1050, meromorphicOrderAt (fun z => stackGrid 1 G z b) s<0 := by
    obtain ⟨i,hi⟩ := hpole
    exact ⟨(0,i),by simpa only [stackGrid,Fin.val_zero,Nat.cast_zero,sub_zero] using hi⟩
  obtain ⟨w,hw⟩ := exists_leading_vector (stackGrid 1 G) s hstack hpstack
  have h0 := CuspMinusLowerResidual.upper_nonzero_on_branch hm hf ε hε hlaw hχ
    BG G hG hGF s w hw hshift hs σ hσ hy ha hb' hc
  have hw0 := hw.project_zero h0
  have huw : periodicVector (fun j => w (0,j)) (7*coordinate (3+145))≠0 := by
    intro hz
    apply hu
    exact (hv.coordinate_zero_iff hw0 (fun j => (hG j s).meromorphicAt) hpole _).mpr hz
  have hjw := pole_jet_constraints AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ BG G
    hG hGF s (fun j => w (0,j)) hw0 hshift hs
  have hr := (nonzero_cusp_branch _ _ _ _ _ _ _ _
    (hn 2 (by decide)) (hn 3 (by decide)) huw hjw).1
  have hres := CuspMinusLowerResidual.two_point_residual_equations AuxMinusLaurent.freeCoordinate
    hm hf ε hε hlaw hχ BG G hG hGF s w hw hshift hs h0
  change ∀ i : Fin 6, _ ∧ _ at hres
  simp only [CuspMinusLowerResidual.evalAt] at hres
  rw [hy,ha,hb'] at hres
  apply CuspMinusBranchParameters.coupled_circle _ _ σ _ _
    (fun j => periodicVector (fun t => w (0,t)) (7*j))
    (fun j => (Complex.I*(s-((2*m:ℕ):ℂ)))⁻¹*periodicVector (fun t => w (1,t)) (7*j))
    (hn 2 (by decide)) (hn 5 (by decide)) hσ hc _ _ hres
  · simpa only [show coordinate (1+145)=60 from rfl, show coordinate (3+145)=120 from rfl] using hr
  · simpa only [show coordinate (3+145)=120 from rfl] using huw

#print axioms pole_square_four
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
end

/-! ## TwentyFiveCuspMinusPoleLocation -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- The surviving denominator-five branch is confined to s=m+1, with
unnormalized Hecke parameters -1/2 and -7/3. In the paper's normalized
Mellin variable, the pole location is s=3/2. -/
compact_certificate theorem pole_exceptional_location
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) s<0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : s≠((2*m:ℕ):ℂ)) (hu : periodicVector v (7*coordinate (3+145))≠0) :
    s=(m:ℂ)+1 ∧ (Real.sqrt 2:ℂ)*f 2= -1/2 ∧ (Real.sqrt 3:ℂ)*f 3= -7/3 := by
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hj := pole_jet_constraints AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ BG G
    hG hGF s v hv hshift hs
  have hb := nonzero_cusp_branch _ _ _ _ _ _ _ _ (hn 2 (by decide)) (hn 3 (by decide)) hu hj
  have h2 := pole_square_four hm hf ε hε hlaw hχ BG G hG hGF s v hv hpole hshift hs hu
  have h3 : (primeParameter 3 m s)^2=9 := by linear_combination (9*h2-hb.2.1)/4
