compact_certificate theorem all_cusp_physical : ∀ i<1198, physicalFlag (AuxMinusLaurent.actual (auxIndex i))=true := by
  let P : ℕ → Prop := fun i => physicalFlag (AuxMinusLaurent.actual (auxIndex i))=true
  have hFin : ∀ i : Fin 1198, P i.val := kernel_range% P 1198 block 32
  have h : ∀ i<1198, P (i+0) := fun i hi => hFin ⟨i,hi⟩
  exact h
#print axioms all_cusp_physical
compact_certificate theorem all_cusp_physical_bound : ∀ i<1198, auxIndex i<4450 := by
  let P : ℕ → Prop := fun i => auxIndex i<4450
  have hFin : ∀ i : Fin 1198, P i.val := kernel_range% P 1198 block 32
  have h : ∀ i<1198, P (i+0) := fun i hi => hFin ⟨i,hi⟩
  exact h
#print axioms all_cusp_physical_bound
compact_certificate theorem cusp_source_physical (i : Fin 1198) : AuxMinusLaurent.actual (auxIndex i.val)=
    .physical (physicalPart (AuxMinusLaurent.actual (auxIndex i.val))) :=
  physicalPart_eq _ (all_cusp_physical i.val i.isLt)
#print axioms cusp_source_physical
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
