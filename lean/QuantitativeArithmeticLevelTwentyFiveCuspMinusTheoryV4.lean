compact_certificate def IsFree (j : ℕ) : Prop := j=42 ∨ j=60 ∨ j=108 ∨ j=120 ∨ j=126
instance (j : ℕ) : Decidable (IsFree j) := inferInstanceAs (Decidable (_ ∨ _ ∨ _ ∨ _ ∨ _))

compact_certificate theorem upper_support : ∀ i : Fin 6, ∀ t∈upperResidual i.val,
    IsFree t.2.1 ∧ t.2.2.2.2.2.1=0 ∧ t.2.2.2.2.2.2.2.2=0 := by decide +kernel

compact_certificate theorem lower_support : ∀ i : Fin 6, ∀ t∈lowerResidual i.val,
    IsFree t.2.1 ∧ t.2.2.2.2.2.1=0 ∧ t.2.2.2.2.2.2.2.2=0 := by decide +kernel

compact_certificate theorem first_support : ∀ i : Fin 6, ∀ t∈firstResidual i.val,
    t.2.1<5 ∧ t.2.2.2.2.2.1=0 ∧ t.2.2.2.2.2.2.2.2=0 := by decide +kernel

/- Parameters at 7 do not occur in these residuals. -/
compact_certificate theorem eval_inert (x y z w a b c : ℂ) (v : ℕ → ℂ) (p : Poly)
    (h : ∀ t∈p, t.2.2.2.2.2.1=0 ∧ t.2.2.2.2.2.2.2.2=0) :
    eval x y z w a b c v p=eval x y z 1 a b 0 v p := by
  unfold eval
  congr 1
  apply List.map_congr_left
  intro t ht
  obtain ⟨hw,hc⟩ := h t ht
  simp only [monomial,hw,hc,zpow_zero,pow_zero]

compact_certificate theorem lower_congr (x y z w a b c : ℂ) (u v : ℕ → ℂ)
    (h : ∀ j, IsFree j → u j=v j) (i : Fin 6) :
    eval x y z w a b c u (lowerResidual i.val)=
      eval x y z 1 a b 0 v (lowerResidual i.val) := by
  rw [eval_inert x y z w a b c u _ (fun t ht => (lower_support i t ht).2)]
  apply eval_congr_support
  intro t ht
  exact h t.2.1 (lower_support i t ht).1

compact_certificate theorem upper_congr (x y z w a b c : ℂ) (u v : ℕ → ℂ)
    (h : ∀ j, IsFree j → u j=v j) (i : Fin 6) :
    eval x y z w a b c u (upperResidual i.val)=
      eval x y z 1 a b 0 v (upperResidual i.val) := by
  rw [eval_inert x y z w a b c u _ (fun t ht => (upper_support i t ht).2)]
  apply eval_congr_support
  intro t ht
  exact h t.2.1 (upper_support i t ht).1

compact_certificate theorem first_congr (x y z w a b c : ℂ) (u v : ℕ → ℂ)
    (h : ∀ j<5, u j=v j) (i : Fin 6) :
    eval x y z w a b c u (firstResidual i.val)=
      eval x y z 1 a b 0 v (firstResidual i.val) := by
  rw [eval_inert x y z w a b c u _ (fun t ht => (first_support i t ht).2)]
  apply eval_congr_support
  intro t ht
  exact h t.2.1 (first_support i t ht).1

