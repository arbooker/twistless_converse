/-! ## TwentyFiveCuspMinusCuspPoleZero -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- Every denominator-five coordinate of a top principal vector vanishes
away from the weight, under the original negative-phase hypotheses. -/
compact_certificate theorem pole_denominator_five_zero
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) s<0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : s≠((2*m:ℕ):ℂ)) :
    periodicVector v (7*30)=0 ∧ periodicVector v (7*60)=0 ∧
      periodicVector v (7*90)=0 ∧ periodicVector v (7*120)=0 := by
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have h120 := pole_cusp_coordinate_zero hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hpole hshift hs
  rw [show coordinate (3+145)=120 from rfl] at h120
  have hj := pole_jet_constraints AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hshift hs
  have hr := (selected_jet_equations _ _ _ _ _ _ _ _
    (hn 2 (by decide)) (hn 3 (by decide)) hj).1
  rw [show coordinate (1+145)=60 from rfl,show coordinate (3+145)=120 from rfl,h120] at hr
  have h60 : periodicVector v (7*60)=0 := by linear_combination hr/2
  have he := denominator_five_relations _ _ _ _ _ _ _ (fun j => periodicVector v (7*j))
    (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide))
    (pole_leading_rows AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ
      BG G hG hGF s v hv hshift)
  exact ⟨he.1.trans (by rw [h120,neg_zero]),h60,he.2.trans (by rw [h60,neg_zero]),h120⟩

#print axioms pole_denominator_five_zero
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
end

/-! ## TwentyFiveCuspMinusTwoPointLowerLeadingAllowed -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector
open QuantitativeArithmeticSmallLevelTwentyFiveCuspLift

compact_certificate theorem lower_leading_rows_of_upper_zero_allowed (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 2 × Fin 1050 → ℂ)
    (hv : IsLeadingVector (SmallLevelFiniteShift.stackGrid 1 G) s v)
    (hzero : (fun j => v (0,j))=0)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ)) :
    ∀ i<1198, eval (primeParameter 2 m (s-1)) (primeParameter 3 m (s-1))
      (primeParameter 5 m (s-1)) (primeParameter 7 m (s-1))
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun t => periodicVector (fun j => v (1,j)) (7*t)) (source i)=0 := by
  intro i hi
  let j : Fin 4600 := ⟨auxIndex i, all_aux_index_bound i hi⟩
  let r := physicalPart (AuxMinusLaurent.actual (auxIndex i))
  have hr : AuxMinusLaurent.actual j.val=SourceRow.physical r :=
    cusp_source_physical ⟨i,hi⟩
  have hp := AuxMinusLaurent.all_actual_source j
  have hq := AuxMinusLaurent.all_actual_tail j
  rw [hr] at hp hq
  have hlead := physical_two_point_rows_allowed AuxMinusLaurent.basis free
    AuxMinusLaurent.basis_periodic r (-1) (AuxMinusLaurent.source j.val)
    (AuxMinusLaurent.tail j.val) hp hq
