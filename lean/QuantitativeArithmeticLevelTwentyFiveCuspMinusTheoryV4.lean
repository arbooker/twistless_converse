open QuantitativeArithmeticSevenLaurentRows

compact_certificate theorem jetRawShift_support : ∀ i : Fin 19, ∀ t∈jetRawShift i.val, t.2.1<150 := by decide +kernel

/- Substitute the checked five-coordinate leading kernel into the actual
four first-jet equations. Only the 150-grid equations are required here;
no vanishing of the external old-grid sources is assumed. -/
compact_certificate theorem first_jet_parametrization (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hs : ∀ j<1198, eval x y z w a b c v (source j)=0)
    (hj : ∀ j : Fin 4, eval x y z w a b c
      (fun i => eval x y z w a b c v (jetRawShift i)) (jetOperation j.val)=0) :
    ∀ j : Fin 4, eval x y z w a b c (fun t => v (coordinate (t+145))) (jetConstraint j.val)=0 := by
  let u : ℕ → ℂ := fun t => v (coordinate (t+145))
  have hparam := leading_parametrization x y z w a b c v hx hy hz hw hs
  have he (i : Fin 19) : eval x y z w a b c v (jetRawShift i.val)=
      eval x y z w a b c u (substitute basis (jetRawShift i.val)) := by
    rw [eval_substitute x y z w a b c u hx hy hz hw]
    apply eval_congr_support
    intro t ht
    exact hparam t.2.1 (jetRawShift_support i t ht)
  have hcert : ∀ j : Fin 4, substitute (fun i => substitute basis (jetRawShift i))
      (jetOperation j.val)=jetConstraint j.val := by
    intro j
    fin_cases j
    · exact jet_shift_constraint_0
    · exact jet_shift_constraint_1
    · exact jet_shift_constraint_2
    · exact jet_shift_constraint_3
  intro j
  have hh : eval x y z w a b c
      (fun i => eval x y z w a b c u (substitute basis (jetRawShift i))) (jetOperation j.val)=0 := by
    refine (eval_congr_support _ _ _ _ _ _ _ _ _ (jetOperation j.val) ?_).trans (hj j)
    intro t ht
    exact (he ⟨t.2.1,jetOperation_support j t ht⟩).symm
  rw [← eval_substitute x y z w a b c u hx hy hz hw,hcert j] at hh
  exact hh

#print axioms jetRawShift_support
#print axioms first_jet_parametrization
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
