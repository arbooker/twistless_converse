/-! ## TwentyFiveCuspMinusRegularizedLeading -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector
open QuantitativeArithmeticSmallLevelTwentyFiveCuspLift

/- If all earlier projections vanish, the 1198 cusp rows annihilate the
current projection, without asserting regularity at the earlier points. -/
compact_certificate theorem regularized_leading_rows_of_prior_zero (free : Fin 68 → Fin 1050)
    {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*1) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*1) f ε)
    (hχ : ε*Complex.I^(2*1)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free 1 f z
      (gridVector 1050 (2*1) f z))
    (v : Fin 4 × Fin 1050 → ℂ)
    (hv : IsLeadingVector (SmallLevelFiniteShift.regularizedStack 3 G 2) 2 v)
    (n : Fin 4) (hprior : ∀ a : Fin 4, a.val<n.val → (fun j => v (a,j))=0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (2+n)) :
    ∀ i<1198, eval (primeParameter 2 1 (2-n.val)) (primeParameter 3 1 (2-n.val))
      (primeParameter 5 1 (2-n.val)) (primeParameter 7 1 (2-n.val))
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun t => periodicVector (fun j => v (n,j)) (7*t)) (source i)=0 := by
  intro i hi
  let j : Fin 4600 := ⟨auxIndex i, all_aux_index_bound i hi⟩
  let r := physicalPart (AuxMinusLaurent.actual (auxIndex i))
  have hr : AuxMinusLaurent.actual j.val=SourceRow.physical r :=
    cusp_source_physical ⟨i,hi⟩
  have hp := AuxMinusLaurent.all_actual_source j
  have hq := AuxMinusLaurent.all_actual_tail j
  rw [hr] at hp hq
  have hlead := physical_regularized_block_rows AuxMinusLaurent.basis free
    AuxMinusLaurent.basis_periodic r (-1) (AuxMinusLaurent.source j.val)
    (AuxMinusLaurent.tail j.val) hp hq
    (AuxMinusLaurent.all_source_zero j) (AuxMinusLaurent.all_tail_zero j)
    hf ε hε hlaw (by simpa using hχ) BG G hG hGF v hv hshift
  have hl : leading r 1 f ε (2-n.val) (fun j => v (n,j))=0 := by
    rw [hlead n]
    by_cases hn : n=0
    · simp [hn]
    rw [ite_eq_right hn]
    have ht : (fun j => v (0,j))=0 :=
      hprior 0 (Fin.pos_iff_ne_zero.mpr hn)
    rw [ht]
    have hqz : regularizedTaylor f (-1) (.physical r) n 2 0=0 := by
      rw [regularizedTaylor_finite]
      simp
    rw [hqz,zero_add]
    apply Finset.sum_eq_zero
    intro a ha
    have ha' := Finset.mem_range.mp ha
    rw [hprior (SmallLevelFiniteShift.lowerIndex n a) (by
      simp only [SmallLevelFiniteShift.lowerIndex]; omega)]
    simpa only [zero_smul,zero_mul] using shifted_smul r 1 f ε a (2-n.val) 0 0
  have hn (p : ℕ) (hp : p≠0) : primeParameter p 1 (2-n.val)≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he := eval_rawSourcePoly (.physical r) hf ε (2-n.val) (-1) (by simpa using hχ) (fun j => v (n,j))
  rw [← eval_normalizedPoly _ _ _ _ _ _ _ _ (hn 2 (by decide)) (hn 3 (by decide))
    (hn 5 (by decide)) (hn 7 (by decide)), hp] at he
  change eval _ _ _ _ _ _ _ _ (AuxMinusLaurent.source (auxIndex i))=_ at he
  rw [all_aux_source i hi, eval_liftPoly] at he
  exact he.trans hl

#print axioms regularized_leading_rows_of_prior_zero
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
