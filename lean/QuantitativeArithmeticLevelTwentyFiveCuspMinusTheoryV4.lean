compact_certificate def packLower (z : ℂ) (u : ℕ → ℂ) : ℕ → ℂ
  | 3 => z^2*u 42
  | 4 => u 60
  | 5 => z^2*u 108
  | 6 => u 120
  | 7 => z^2*u 126
  | _ => 0

compact_certificate theorem lowerValues_packLower (z : ℂ) (u : ℕ → ℂ) (hz : z≠0)
    (j : ℕ) (hj : IsFree j) : lowerValues z (packLower z u) j=u j := by
  rcases hj with rfl | rfl | rfl | rfl | rfl <;>
    simp [lowerValues,packLower,hz]

/- The six homogeneous lower residuals kill every free cusp coordinate,
without prescribing the other 145 coordinates. -/
compact_certificate theorem lower_free_kernel (x z σ w c : ℂ) (u : ℕ → ℂ)
    (hx : x≠0) (hz : z≠0) (hσ : σ=1 ∨ σ= -1) (hc : ‖x^2‖=4)
    (h : ∀ i : Fin 6,
      eval x (σ*(3*x/2)) z w (1/x-x/2) (σ*(2/(3*x)-4*x/3)) c u
        (lowerResidual i.val)=0) : ∀ j, IsFree j → u j=0 := by
  have hh := lower_kernel x z σ (packLower z u) hx hz hσ hc
    (by rfl) (by rfl) (by rfl) (by rfl) (by
      intro i
      rw [← lower_congr x (σ*(3*x/2)) z w (1/x-x/2) (σ*(2/(3*x)-4*x/3)) c
        u (lowerValues z (packLower z u))
        (fun j hj => (lowerValues_packLower z u hz j hj).symm) i]
      exact h i)
  have h3 := hh ⟨3,by decide⟩
  have h4 := hh ⟨4,by decide⟩
  have h5 := hh ⟨5,by decide⟩
  have h6 := hh ⟨6,by decide⟩
  have h7 := hh ⟨7,by decide⟩
  simp only [packLower] at h3 h4 h5 h6 h7
  intro j hj
  rcases hj with rfl | rfl | rfl | rfl | rfl
  · exact (mul_eq_zero.mp h3).resolve_left (pow_ne_zero 2 hz)
  · exact h4
  · exact (mul_eq_zero.mp h5).resolve_left (pow_ne_zero 2 hz)
  · exact h6
  · exact (mul_eq_zero.mp h7).resolve_left (pow_ne_zero 2 hz)

#print axioms lower_free_kernel
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusBranchParameters
end
