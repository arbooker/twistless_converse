@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSevenLaurentRows

compact_certificate def blockPeriodic (v : Fin 4 × Fin 1050 → ℂ) (j : ℕ) : ℂ :=
  v (⟨(j/1050)%4,Nat.mod_lt _ (by decide)⟩,⟨j%1050,Nat.mod_lt _ (by decide)⟩)

compact_certificate def cuspBlockVector (v : Fin 4 × Fin 1050 → ℂ) (j : ℕ) : ℂ :=
  blockPeriodic v (1050*(j/150)+7*(j%150))

compact_certificate theorem blockPeriodic_move (v : Fin 4 × Fin 1050 → ℂ) (n : Fin 4) (j : ℕ) (hj : j<1050) :
    blockPeriodic v (1050*n.val+j)=periodicVector (fun t => v (n,t)) j := by
  have hd : (1050*n.val+j)/1050=n.val := by omega
  have hm : (1050*n.val+j)%1050=j := by omega
  simp only [blockPeriodic,periodicVector,hd,hm,Nat.mod_eq_of_lt n.isLt,Nat.mod_eq_of_lt hj]

compact_certificate theorem blockMove_eval (c : ℂ) (v : Fin 4 × Fin 1050 → ℂ) (n : Fin 4) (p : Poly)
    (h : ∀ t∈p, t.2.1<1050) :
    eval 1 1 1 1 0 0 c (blockPeriodic v) (blockMovePoly n.val p)=
      eval 1 1 1 1 0 0 c (periodicVector (fun t => v (n,t))) p := by
  unfold eval blockMovePoly
  rw [List.map_map]
  congr 1
  apply List.map_congr_left
  intro t ht
  simp only [Function.comp_apply]
  rw [blockPeriodic_move v n t.2.1 (h t ht)]

compact_certificate theorem cuspBlockLift_eval (c : ℂ) (v : Fin 4 × Fin 1050 → ℂ) (p : Poly) :
    eval 1 1 1 1 0 0 c (blockPeriodic v) (cuspBlockLift p)=
      eval 1 1 1 1 0 0 c (cuspBlockVector v) p := by
  simp only [eval,cuspBlockLift,List.map_map,Function.comp_def,cuspBlockVector]

#print axioms blockMove_eval
#print axioms cuspBlockLift_eval
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
