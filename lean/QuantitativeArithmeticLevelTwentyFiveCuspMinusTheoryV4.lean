/-! ## TwentyFiveCuspMinusWeightCandidate -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector

/- A nonzero denominator-five regularized principal part at the weight
forces weight two and the same exceptional good-prime parameters. -/
compact_certificate theorem regularized_weight_candidate (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (v : Fin 1050 → ℂ)
    (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) ((2*m:ℕ):ℂ) v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j,
      0≤ meromorphicOrderAt (fun z => G z j) (((2*m:ℕ):ℂ)+n))
    (hu : periodicVector v (7*coordinate (3+145))≠0) :
    m=1 ∧ (Real.sqrt 2:ℂ)*f 2= -1/2 ∧ (Real.sqrt 3:ℂ)*f 3= -7/3 := by
  have hre := (regularized_nonzero_cusp_branch free hm hf ε hε hlaw hχ BG G hG hGF
    ((2*m:ℕ):ℂ) v hv hshift hu).1
  have hm1 : m=1 := by
    have hr : (m:ℝ)=1 := by
      norm_num at hre
      linear_combination hre
    exact_mod_cast hr
  refine ⟨hm1,?_⟩
  have hj := regularized_jet_constraints free hm hf ε hε hlaw hχ BG G hG hGF
    ((2*m:ℕ):ℂ) v hv hshift
  have hp (p : ℕ) : primeParameter p m ((2*m:ℕ):ℂ)=(p:ℂ) := by
    norm_num [primeParameter,hm1]
  have hb := nonzero_cusp_branch _ _ _ _ _ _ _ _
    (by rw [hp 2]; norm_num) (by rw [hp 3]; norm_num) hu hj
  rw [hp 2,hp 3] at hb
  constructor
  · linear_combination hb.2.2.1/4
  · linear_combination hb.2.2.2/27

#print axioms regularized_weight_candidate
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
