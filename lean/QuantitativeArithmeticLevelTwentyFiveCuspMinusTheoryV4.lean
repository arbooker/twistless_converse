/-! ## TwentyFiveCuspMinusBranch -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows

/- The nonzero denominator-five branch of the checked first-jet system.
This is algebraic necessity; the further lower-point obstruction is separate. -/
compact_certificate theorem nonzero_cusp_branch (x y z w a b c : ℂ) (u : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hu : u 3≠0)
    (h : ∀ i : Fin 4, eval x y z w a b c u (jetConstraint i.val)=0) :
    2*u 1+u 3=0 ∧ 9*x^2=4*y^2 ∧ 2*a*x=2-x^2 ∧ 9*b*y=9-8*y^2 := by
  obtain ⟨hr,h1,h2,h3⟩ := selected_jet_equations x y z w a b c u hx hy h
  have h1' := (mul_eq_zero.mp h1).resolve_right hu
  have h2' := (mul_eq_zero.mp h2).resolve_right hu
  have h3' := (mul_eq_zero.mp h3).resolve_right hu
  refine ⟨hr,?_,?_,?_⟩
  · linear_combination (2*h2'+9*h1')/5
  · linear_combination h1'
  · linear_combination (3*h3'-h2')/2

/- For genuine prime powers the branch lies on Re(h)=1. -/
compact_certificate theorem physical_nonzero_cusp_branch (h z w a b c : ℂ) (u : ℕ → ℂ)
    (hu : u 3≠0)
    (hj : ∀ i : Fin 4, eval ((2:ℂ)^h) ((3:ℂ)^h) z w a b c u (jetConstraint i.val)=0) :
    h.re=1 ∧ ‖((2:ℂ)^h)^2‖=4 := by
  have hx : (2:ℂ)^h≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hy : (3:ℂ)^h≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  exact QuantitativeArithmeticSmallLevelTwentyFiveCuspCircle.physical_circle h
    (nonzero_cusp_branch _ _ z w a b c u hx hy hu hj).2.1

#print axioms nonzero_cusp_branch
#print axioms physical_nonzero_cusp_branch
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
