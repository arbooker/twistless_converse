/-! ## TwentyFiveCuspMinusPoleFirstJet -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex Matrix QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector

/- The four finite first-jet syzygies constrain the SAME universal principal
part of the actual auxiliary quotient. This does not assume any order bound
at the lower point. Only the common weight factor is cancelled. -/
compact_certificate theorem pole_first_jet (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : s≠((2*m:ℕ):ℂ)) (j : Fin 4) :
    eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun i => eval (primeParameter 2 m s) (primeParameter 3 m s)
        (primeParameter 5 m s) (primeParameter 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
        (fun t => periodicVector v (7*t)) (jetRawShift i)) (jetOperation j.val)=0 := by
  classical
  let O := jetOperation j.val
  let ι := Fin O.length
  have bound (t : ι) : (O.get t).2.1<19 :=
    jetOperation_support j (O.get t) (List.get_mem O t)
  let : Nonempty ι := ⟨⟨0,jetOperation_nonempty j⟩⟩
  let rows : ι → Row := fun t => jetRows (O.get t).2.1
  let P : ι → Poly := fun t => AuxMinusLaurent.source (jetAuxIndex (O.get t).2.1)
  let Q : ι → Poly := fun t => AuxMinusLaurent.tail (jetAuxIndex (O.get t).2.1)
  have hP (t : ι) : normalizedPoly (rawSourcePoly (-1) (.physical (rows t)))=P t := by
    have hh := jet_aux_source ⟨(O.get t).2.1,bound t⟩
    rw [jetRows_actual ⟨(O.get t).2.1,bound t⟩] at hh
    exact hh
  have hQ (t : ι) : normalizedPoly (rawTailPoly (.physical (rows t)))=Q t := by
    have hh := jet_aux_tail ⟨(O.get t).2.1,bound t⟩
    rw [jetRows_actual ⟨(O.get t).2.1,bound t⟩] at hh
    exact hh
  have hPzero (t : ι) : substitute AuxMinusLaurent.basis (P t)=[] :=
    AuxMinusLaurent.all_source_zero ⟨jetAuxIndex (O.get t).2.1,
      jetAuxIndex_bound ⟨(O.get t).2.1,bound t⟩⟩
  have hQzero (t : ι) : substitute AuxMinusLaurent.basis (Q t)=[] :=
    AuxMinusLaurent.all_tail_zero ⟨jetAuxIndex (O.get t).2.1,
      jetAuxIndex_bound ⟨(O.get t).2.1,bound t⟩⟩
  let K : ℂ → ι → ℂ := fun z t => ((O.get t).1:ℂ)*monomial
    (primeParameter 2 m (z+1)) (primeParameter 3 m (z+1))
    (primeParameter 5 m (z+1)) (primeParameter 7 m (z+1))
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7) (O.get t).2.2
  have hpa (p : ℕ) (hp : p≠0) (z : ℂ) :
      AnalyticAt ℂ (fun w => primeParameter p m (w+1)) z := by
    unfold primeParameter
    simp_rw [Complex.cpow_def_of_ne_zero (by exact_mod_cast hp : (p:ℂ)≠0)]
    fun_prop
  have hpn (p : ℕ) (hp : p≠0) (z : ℂ) : primeParameter p m (z+1)≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hK (z : ℂ) (t : ι) : AnalyticAt ℂ (fun w => K w t) z := by
    apply AnalyticAt.mul analyticAt_const
    exact monomial_analytic _ _ _ _ _ _ _ _ _
      (hpa 2 (by decide) z) (hpa 3 (by decide) z) (hpa 5 (by decide) z) (hpa 7 (by decide) z)
      (hpn 2 (by decide) z) (hpn 3 (by decide) z) (hpn 5 (by decide) z) (hpn 7 (by decide) z)
  have hKA (z : ℂ) (w : Fin 1050 → ℂ) :
      ∑ t, K z t*leading (rows t) m f ε z w=0 := by
    have hh := jet_leading_syzygy hf ε (z+1) hχ w j
    rw [eval_eq_sum_fin] at hh
    have he : z+1-1=z := by ring
    simp only [he] at hh
    exact hh
  have hh := QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel.selected_first_shift
    AuxMinusLaurent.basis free AuxMinusLaurent.basis_periodic rows (-1) P Q
    hP hQ hPzero hQzero hm hf ε hε hlaw (by simpa using hχ)
    BG G hG hGF s v hv hshift K hK hKA
  apply (mul_eq_zero.mp (show Complex.I*(s-((2*m:ℕ):ℂ))*
    eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun i => eval (primeParameter 2 m s) (primeParameter 3 m s)
        (primeParameter 5 m s) (primeParameter 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
        (fun t => periodicVector v (7*t)) (jetRawShift i)) (jetOperation j.val)=0 from ?_)).resolve_left
      (mul_ne_zero I_ne_zero (sub_ne_zero.mpr hs))
  rw [eval_eq_sum_fin,Finset.mul_sum]
  convert hh using 1
  apply Finset.sum_congr rfl
  intro t _
  change _ = K (s-1) t*shifted (jetRows (O.get t).2.1) m f ε 0 (s-1) v
  rw [jetShift_eval m f ε s hχ v ⟨(O.get t).2.1,bound t⟩]
  simp only [K,sub_add_cancel]
  ring

#print axioms pole_first_jet
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
