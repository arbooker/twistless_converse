      have hp : ∀ a : Fin 4, a.val<n → (fun j => v (a,j))=0 := by
        intro a ha
        exact ih a.val ha a.isLt
      have hs := block_leading_rows_of_prior_zero_allowed AuxMinusLaurent.freeCoordinate
        hm hf ε hε hlaw hχ BG G hG hGF ((m:ℂ)+1) 3 v hv ⟨n,hn⟩ hp hshift hweight
      simp only [primeParameter_exceptional 2 m n (by decide),
        primeParameter_exceptional 3 m n (by decide),primeParameter_exceptional 5 m n (by decide),
        primeParameter_exceptional 7 m n (by decide),h2,h3] at hs
      have hold : ∀ j<150, periodicVector (fun t => v (⟨n,hn⟩,t)) (7*j)=0 := by
        have hn0 : 1≤n := by omega
        interval_cases n
        · exact CuspMinusExceptionalLower.kernel_1 _ _ hs
        · exact CuspMinusExceptionalLower.kernel_2 _ _ hs
        · exact CuspMinusExceptionalLower.kernel_3 _ _ hs
      apply AuxMinusLaurent.point_zero_of_prior_old_zero_allowed hm hf ε hε hlaw hχ BG G hG hGF
