/-! ## TwentyFiveCuspMinusRegularizedNonzero -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- All three lower leading systems are injective at the exceptional
parameters, so a four-point principal vector retains a nonzero top. -/
compact_certificate theorem regularized_four_point_upper_nonzero
    {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*1) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*1) f ε)
    (hχ : ε*Complex.I^(2*1)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate 1 f z (gridVector 1050 (2*1) f z))
    (v : Fin 4 × Fin 1050 → ℂ) (hv : IsLeadingVector (regularizedStack 3 G 2) 2 v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (2+n))
    (h2 : (Real.sqrt 2:ℂ)*f 2= -1/2) (h3 : (Real.sqrt 3:ℂ)*f 3= -7/3) :
    (fun j => v (0,j))≠0 := by
  intro hzero
  have hall : ∀ n : ℕ, ∀ hn : n<4, (fun j => v (⟨n,hn⟩,j))=0 := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn
      by_cases hz : n=0
      · subst n; exact hzero
      have hp : ∀ a : Fin 4, a.val<n → (fun j => v (a,j))=0 := by
        intro a ha
        exact ih a.val ha a.isLt
      have hs := regularized_leading_rows_of_prior_zero AuxMinusLaurent.freeCoordinate
        hf ε hε hlaw hχ BG G hG hGF v hv ⟨n,hn⟩ hp hshift
      have hparam (p : ℕ) (hp : p≠0) : primeParameter p 1 (2-n)=(p:ℂ)/(p:ℂ)^n := by
        have he := primeParameter_exceptional p 1 n hp
        norm_num at he
        exact he
      simp only [hparam 2 (by decide),hparam 3 (by decide),hparam 5 (by decide),
        hparam 7 (by decide),h2,h3] at hs
      have hold : ∀ j<150, periodicVector (fun t => v (⟨n,hn⟩,t)) (7*j)=0 := by
        have hn0 : 1≤n := by omega
        interval_cases n
        · exact CuspMinusExceptionalLower.kernel_1 _ _ hs
        · exact CuspMinusExceptionalLower.kernel_2 _ _ hs
        · exact CuspMinusExceptionalLower.kernel_3 _ _ hs
      apply AuxMinusLaurent.regularized_point_zero_of_prior_old_zero hf ε hε hlaw hχ BG G hG hGF
        v hv hshift ⟨n,hn⟩ hp
      intro j
      have h := hold j.val j.isLt
      simpa only [periodicVector,Nat.mod_eq_of_lt (show 7*j.val<1050 by omega)] using h
  apply hv.1
  funext j
  exact congrFun (hall j.1.val j.1.isLt) j.2

#print axioms regularized_four_point_upper_nonzero
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
end

/-! ## TwentyFiveRegularizedExceptionalEval -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridData SmallLevelFiniteShift
open QuantitativeArithmeticRegularizedJetScale (regularizedJetScale regularizedJetScale_top regularizedJetScale_lower)

compact_certificate theorem higherJetEval_exceptional (f : ℕ → ℂ) (χ : ℚ) (r : SourceRow)
    (n a : ℕ) (v : Fin 1050 → ℂ) :
    higherJetEval 1 f χ r (a+1) (2-n) v=
      ((a+1).factorial:ℂ)*eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
        (periodicVector v) (exceptionalShift χ n a r) := by
  have hp (p : ℕ) (hp : p≠0) : primeParameter p 1 (2-n)≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hs : (2:ℂ)-n-(1:ℕ)=1-(n:ℂ) := by norm_num; ring
  have hf : ((a+1).factorial:ℂ)≠0 := by exact_mod_cast Nat.factorial_ne_zero (a+1)
  cases r with
  | old j => simp [higherJetEval,rawHigherJetPoly,exceptionalShift]
  | physical r =>
    cases r with
    | word r =>
      have hr : r.rate≠0 := by rw [r.powers_eq]; positivity
      have he := rational_four_prime_power r.rate r.powers r.powers_eq ((2:ℂ)-n-(1:ℕ))
      change (r.rate:ℂ)^((2:ℂ)-n-(1:ℕ))=fourPrimeMonomial r.powers
        (primeParameter 2 1 (2-n)) (primeParameter 3 1 (2-n))
        (primeParameter 5 1 (2-n)) (primeParameter 7 1 (2-n)) at he
      rw [hs,Complex.cpow_sub _ _ (by exact_mod_cast hr),Complex.cpow_one,Complex.cpow_natCast] at he
      simp only [higherJetEval,rawHigherJetPoly,exceptionalShift]
      rw [eval_shift _ _ _ _ _ _ _ _ (hp 2 (by decide)) (hp 3 (by decide))
          (hp 5 (by decide)) (hp 7 (by decide)),eval_gridPoly,
        eval_shift _ _ _ _ _ _ _ _ (by norm_num) (by norm_num) (by norm_num) (by norm_num),eval_gridPoly]
      simp only [monomial,primeExponent,pow_zero,zpow_zero,mul_one,
        Rat.cast_div,Rat.cast_mul,Rat.cast_pow,Rat.cast_natCast]
      simp only [fourPrimeMonomial] at he
      rw [← he]
      field_simp
    | taylor r =>
      have hr : r.rate≠0 := by rw [r.powers_eq]; positivity
      have he := rational_four_prime_power r.rate r.powers r.powers_eq ((2:ℂ)-n-(1:ℕ))
      change (r.rate:ℂ)^((2:ℂ)-n-(1:ℕ))=fourPrimeMonomial r.powers
        (primeParameter 2 1 (2-n)) (primeParameter 3 1 (2-n))
        (primeParameter 5 1 (2-n)) (primeParameter 7 1 (2-n)) at he
      rw [hs,Complex.cpow_sub _ _ (by exact_mod_cast hr),Complex.cpow_one,Complex.cpow_natCast] at he
      simp only [higherJetEval,rawHigherJetPoly,exceptionalShift]
      rw [eval_shift _ _ _ _ _ _ _ _ (hp 2 (by decide)) (hp 3 (by decide))
          (hp 5 (by decide)) (hp 7 (by decide)),eval_samplePoly,
        eval_shift _ _ _ _ _ _ _ _ (by norm_num) (by norm_num) (by norm_num) (by norm_num),eval_samplePoly]
      simp only [monomial,primeExponent,pow_zero,zpow_zero,mul_one,
        Rat.cast_div,Rat.cast_mul,Rat.cast_pow,Rat.cast_natCast]
      simp only [fourPrimeMonomial] at he
      rw [← he]
      field_simp
    | entire q hq hd => simp [higherJetEval,rawHigherJetPoly,exceptionalShift]
    | hecke p hp hd j => simp [higherJetEval,rawHigherJetPoly,exceptionalShift]
    | infinity w j hn hd => simp [higherJetEval,rawHigherJetPoly,exceptionalShift]

compact_certificate theorem regularizedTaylor_exceptional (f : ℕ → ℂ) (χ : ℚ) (r : SourceRow)
    (n : Fin 4) (hn : n≠0) (v : Fin 1050 → ℂ) :
    regularizedTaylor f χ r n 2 v=
      regularizedJetScale n*eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
        (periodicVector v) (exceptionalShift χ n.val (n.val-1) r) := by
  have hpos : 0<n.val := Fin.pos_iff_ne_zero.mpr hn
  have hnv : n.val-1+1=n.val := by omega
  have he := higherJetEval_exceptional f χ r n.val (n.val-1) v
  rw [hnv] at he
  rw [regularizedTaylor,regularizedJetScale_top n hn,he]
  have hnfac : (n.val.factorial:ℂ)≠0 := by exact_mod_cast Nat.factorial_ne_zero n.val
  field_simp

compact_certificate theorem regularized_lower_shift_eval (f : ℕ → ℂ) (ε : ℂ) (χ : ℚ)
    (hχ : ε*Complex.I^(2*1)=(χ:ℂ)) (r : SourceRow) (n : Fin 4)
    (a : ℕ) (ha : a<n.val-1) (v : Fin 1050 → ℂ) :
    sourceShifted r 1 f ε a (2-n.val)
        (regularizedJetScale (lowerIndex n a) • v)=
      regularizedJetScale n*eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
        (periodicVector v) (exceptionalShift χ n.val a r) := by
  rw [eval_rawHigherJetPoly r 1 f ε (2-n.val) χ hχ]
  change (Complex.I^(a+1)*Ring.choose (2-(n.val:ℂ)+((a+1:ℕ):ℂ)-((2*1:ℕ):ℂ)) (a+1))*
    higherJetEval 1 f χ r (a+1) (2-n.val) (regularizedJetScale (lowerIndex n a) • v)=_
  rw [higherJetEval_exceptional]
  have he : (2:ℂ)-(n.val:ℂ)+((a+1:ℕ):ℂ)-((2*1:ℕ):ℂ)=
      -(n.val:ℂ)+((a+1:ℕ):ℂ) := by norm_num; ring
  rw [he]
  have hev : periodicVector (regularizedJetScale (lowerIndex n a) • v)=
      fun j => regularizedJetScale (lowerIndex n a)*periodicVector v j := rfl
  rw [hev,eval_smul]
  have hf : ((a+1).factorial:ℂ)≠0 := by exact_mod_cast Nat.factorial_ne_zero (a+1)
  calc
    _ = (Complex.I^(a+1)*Ring.choose (-(n.val:ℂ)+((a+1:ℕ):ℂ)) (a+1)*
          regularizedJetScale (lowerIndex n a))*((a+1).factorial:ℂ)*
          eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7) (periodicVector v)
            (exceptionalShift χ n.val a r) := by ring
    _ = _ := by rw [regularizedJetScale_lower n a ha]; field_simp

#print axioms regularized_lower_shift_eval
#print axioms higherJetEval_exceptional
#print axioms regularizedTaylor_exceptional
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveRegularizedNormalizedRows -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift
open QuantitativeArithmeticRegularizedJetScale (regularizedJetScale regularizedJetScale_ne_zero)

compact_certificate def normalizeRegularized (v : Fin 4 × Fin 1050 → ℂ) (b : Fin 4 × Fin 1050) : ℂ :=
  (regularizedJetScale b.1)⁻¹*v b

compact_certificate theorem normalizeRegularized_cancel (v : Fin 4 × Fin 1050 → ℂ)
    (n : Fin 4) : regularizedJetScale n • (fun j => normalizeRegularized v (n,j))=
      (fun j => v (n,j)) := by
  funext j
  simp only [Pi.smul_apply,smul_eq_mul,normalizeRegularized,← mul_assoc,
    mul_inv_cancel₀ (regularizedJetScale_ne_zero n),one_mul]

/- Regularization at weight two recovers the same rational four-point
equations, with every normalization scalar nonzero. -/
compact_certificate theorem normalized_regularized_physical_block (basis : ℕ → Poly) (free : Fin 68 → Fin 1050)
    (hperiodic : ∀ j, basis (j%1050)=basis j)
    (r : Row) (p q : Poly)
    (hp : normalizedPoly (rawSourcePoly (-1) (.physical r))=p)
    (hq : normalizedPoly (rawTailPoly (.physical r))=q)
    (hpzero : substitute basis p=[]) (hqzero : substitute basis q=[])
    {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*1) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*1) f ε)
    (hχ : ε*Complex.I^(2*1)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis free 1 f z (gridVector 1050 (2*1) f z))
    (v : Fin 4 × Fin 1050 → ℂ) (hv : IsLeadingVector (regularizedStack 3 G 2) 2 v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (2+n))
    (h2 : (Real.sqrt 2:ℂ)*f 2= -1/2) (h3 : (Real.sqrt 3:ℂ)*f 3= -7/3)
    (n : Fin 4) :
    eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
      (periodicVector (fun j => normalizeRegularized v (n,j)))
      (exceptionalPoly n.val (rawSourcePoly (-1) (.physical r)))=
    ∑ a∈Finset.range n.val, eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
      (periodicVector (fun j => normalizeRegularized v (lowerIndex n a,j)))
      (exceptionalShift (-1) n.val a (.physical r)) := by
  have h := physical_regularized_block_rows basis free hperiodic r (-1) p q hp hq hpzero hqzero
    hf ε hε hlaw (by simpa using hχ) BG G hG hGF v hv hshift n
  have hnorm := normalizeRegularized_cancel v
  have he := exceptional_source_eval (.physical r) hf ε (-1) (by simpa using hχ) h2 h3 n.val
    (fun j => normalizeRegularized v (n,j))
  simp only [sourceLeading] at he
  norm_num at he
  rw [← hnorm n,leading_smul,← he] at h
  by_cases hn : n=0
  · subst n
    simpa [regularizedJetScale] using h
  rw [ite_eq_right hn,regularizedTaylor_exceptional f (-1) (.physical r) n hn] at h
  have h0 : (fun j => v (0,j))=(fun j => normalizeRegularized v (0,j)) := by
    funext j
    simp [normalizeRegularized,regularizedJetScale]
  rw [h0] at h
  have hterms : ∀ a∈Finset.range (n.val-1),
      shifted r 1 f ε a (2-n.val) (fun j => v (lowerIndex n a,j))=
      regularizedJetScale n * eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
        (periodicVector (fun j => normalizeRegularized v (lowerIndex n a,j)))
        (exceptionalShift (-1) n.val a (.physical r)) := by
    intro a ha
    rw [← hnorm (lowerIndex n a)]
    exact regularized_lower_shift_eval f ε (-1) (by simpa using hχ) (.physical r)
      n a (Finset.mem_range.mp ha) _
  rw [Finset.sum_congr rfl hterms,← Finset.mul_sum,← mul_add] at h
  have hdiv := mul_left_cancel₀ (regularizedJetScale_ne_zero n) h
  have hnpos : 0<n.val := Fin.pos_iff_ne_zero.mpr hn
  have hnv : n.val=(n.val-1)+1 := by omega
  have hlast : lowerIndex n (n.val-1)=0 := by
    apply Fin.ext
    simp [lowerIndex]
  have hsum := Finset.sum_range_succ
    (fun a => eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
      (periodicVector (fun j => normalizeRegularized v (lowerIndex n a,j)))
      (exceptionalShift (-1) n.val a (.physical r))) (n.val-1)
  rw [← hnv,hlast] at hsum
  rw [hsum]
  exact hdiv.trans (add_comm _ _)

#print axioms normalizeRegularized_cancel
#print axioms normalized_regularized_physical_block
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveCuspMinusRegularizedPole -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- The original negative-phase Taylor equations exclude a nonzero
regularized denominator-five coordinate at the weight point. -/
compact_certificate theorem regularized_weight_cusp_coordinate_zero
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (v : Fin 1050 → ℂ)
    (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) ((2*m:ℕ):ℂ) v)
    (hpole : ∃ j, meromorphicOrderAt (fun z => (z-((2*m:ℕ):ℂ))*G z j) ((2*m:ℕ):ℂ)<0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (((2*m:ℕ):ℂ)+n)) : periodicVector v (7*coordinate (3+145))=0 := by
  by_contra hu
  obtain ⟨hm1,h2,h3⟩ := regularized_weight_candidate AuxMinusLaurent.freeCoordinate
    hm hf ε hε hlaw hχ BG G hG hGF v hv hshift hu
  subst m
  have hreg (j : Fin 1050) : MeromorphicAt (fun z => (z-2)*G z j) 2 :=
    (analyticAt_id.sub analyticAt_const).meromorphicAt.mul (hG j 2).meromorphicAt
  have hstack (b : Fin 4 × Fin 1050) : MeromorphicAt (fun z => regularizedStack 3 G 2 z b) 2 := by
    by_cases hb : b.1=0
    · simpa only [regularizedStack,ite_eq_left hb] using hreg b.2
    · simpa only [regularizedStack,ite_eq_right hb,Function.comp_def] using
        (hG b.2 (2-b.1.val)).meromorphicAt.comp_analyticAt
          (g:=fun z : ℂ => z-(b.1.val:ℂ)) (analyticAt_id.sub analyticAt_const)
  have hpstack : ∃ b : Fin 4 × Fin 1050,
      meromorphicOrderAt (fun z => regularizedStack 3 G 2 z b) 2<0 := by
    obtain ⟨i,hi⟩ := hpole
    exact ⟨(0,i),by simpa [regularizedStack] using hi⟩
  obtain ⟨w,hw⟩ := exists_leading_vector (regularizedStack 3 G 2) 2 hstack hpstack
  have h0 := regularized_four_point_upper_nonzero hf ε hε hlaw hχ BG G hG hGF w hw hshift h2 h3
  have hw0 := hw.project_regularized_top h0
  have huw : periodicVector (fun j => w (0,j)) (7*coordinate (3+145))≠0 := by
    intro hz
    apply hu
    exact (hv.coordinate_zero_iff hw0 hreg hpole _).mpr hz
  have hz := CuspMinusExceptionalBlock.normalized_equations_kill_cusp
    ((Real.sqrt 7:ℂ)*f 7) (normalizeRegularized w) (by
      intro i
      let j : Fin 4600 := ⟨CuspMinusExceptionalBlock.auxiliaryIndex i.val,
        CuspMinusExceptionalBlock.auxiliaryIndex_bound i⟩
      have hp := AuxMinusLaurent.all_actual_source j
      have hq := AuxMinusLaurent.all_actual_tail j
      change normalizedPoly (rawSourcePoly (-1)
        (AuxMinusLaurent.actual (CuspMinusExceptionalBlock.auxiliaryIndex i.val)))=_ at hp
      change normalizedPoly (rawTailPoly
        (AuxMinusLaurent.actual (CuspMinusExceptionalBlock.auxiliaryIndex i.val)))=_ at hq
      rw [← CuspMinusExceptionalBlock.actual_eq i,CuspMinusExceptionalBlock.actual_physical i] at hp hq
      rw [CuspMinusExceptionalBlock.actual_physical i]
      exact normalized_regularized_physical_block AuxMinusLaurent.basis AuxMinusLaurent.freeCoordinate
        AuxMinusLaurent.basis_periodic (CuspMinusExceptionalBlock.physicalRow i.val)
        (AuxMinusLaurent.source j.val) (AuxMinusLaurent.tail j.val) hp hq
        (AuxMinusLaurent.all_source_zero j) (AuxMinusLaurent.all_tail_zero j)
        hf ε hε hlaw hχ BG G hG hGF w hw hshift h2 h3
        (CuspMinusExceptionalBlock.selectedPoint i))
  apply huw
  simpa [normalizeRegularized,QuantitativeArithmeticRegularizedJetScale.regularizedJetScale,periodicVector,
    show coordinate (3+145)=120 from rfl] using hz

#print axioms regularized_weight_cusp_coordinate_zero
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
