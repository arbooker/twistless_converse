  · exact inverse_checked_6
  · exact inverse_checked_7

/- The explicit eight-column system is injective on the forced circle.
Linking these sparse rows to lower-point Taylor germs is a separate step. -/
compact_certificate theorem coefficient_kernel (x z : ℂ) (v : ℕ → ℂ) (hx : x≠0) (hz : z≠0)
    (hcircle : ‖x^2‖=4) (h : ∀ i : Fin 8, eval x 1 z 1 0 0 0 v (coeffRows i.val)=0) :
    ∀ j : Fin 8, v j.val=0 := by
  intro j
  have he := eval_substitute x 1 z 1 0 0 0 v hx (by norm_num) hz (by norm_num) coeffRows (inverse j.val)
  rw [inverse_checked j,scalar_eval] at he
  have he0 : eval x 1 z 1 0 0 0
      (fun i => eval x 1 z 1 0 0 0 v (coeffRows i)) (inverse j.val)=0 := by
    calc
      _ = eval x 1 z 1 0 0 0 (fun _ => 0) (inverse j.val) := by
        apply eval_congr_support
        intro t ht
        exact h ⟨t.2.1,inverse_support j t ht⟩
      _ = 0 := by simp [eval]
  exact (mul_eq_zero.mp (he.trans he0)).resolve_left (minor_ne_zero_on_circle (x^2) hcircle)

/- The selected augmented row forces U=4, using the checked reciprocal
identity, with no root approximation and no division by a spectral factor. -/
compact_certificate theorem augmented_circle (x z : ℂ) (v : ℕ → ℂ) (hx : x≠0) (hz : z≠0)
    (hcircle : ‖x^2‖=4) (hv : v 8≠0)
    (h : ∀ i : Fin 9, eval x 1 z 1 0 0 0 v (rows i.val)=0) : x^2=4 := by
  have he := eval_substitute x 1 z 1 0 0 0 v hx (by norm_num) hz (by norm_num) rows obstructionOperation
  rw [obstruction_checked,obstruction_eval x z v hx hz] at he
  have he0 : eval x 1 z 1 0 0 0
      (fun i => eval x 1 z 1 0 0 0 v (rows i)) obstructionOperation=0 := by
    calc
      _ = eval x 1 z 1 0 0 0 (fun _ => 0) obstructionOperation := by
        apply eval_congr_support
        intro t ht
        exact h ⟨t.2.1,obstruction_support t ht⟩
      _ = 0 := by simp [eval]
  have hp := (mul_eq_zero.mp (he.trans he0)).resolve_right hv
  have hc : (625/(72*x^2*z^2):ℂ)≠0 := by
    exact div_ne_zero (by norm_num) (mul_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero _ hx)) (pow_ne_zero _ hz))
  exact obstruction_zero_on_circle (x^2) hcircle ((mul_eq_zero.mp hp).resolve_left hc)

