    s v hv hpole hshift hweight hs
  rw [show coordinate (3+145)=120 from rfl] at h120
  have hj := pole_jet_constraints_allowed AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hshift hweight hs
  have hr := (selected_jet_equations _ _ _ _ _ _ _ _
    (hn 2 (by decide)) (hn 3 (by decide)) hj).1
  rw [show coordinate (1+145)=60 from rfl,show coordinate (3+145)=120 from rfl,h120] at hr
  have h60 : periodicVector v (7*60)=0 := by linear_combination hr/2
