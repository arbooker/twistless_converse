  intro t ht
  exact h ⟨t.2.1,lowerOperation_support i t ht⟩

compact_certificate theorem coordinate_isFree : ∀ j : Fin 5, IsFree (CuspMinusLaurent.coordinate (j.val+145)) := by
  decide +kernel

