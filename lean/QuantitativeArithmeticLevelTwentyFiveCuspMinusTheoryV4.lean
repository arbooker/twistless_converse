compact_certificate def packCoupled (z : ℂ) (u l : ℕ → ℂ) : ℕ → ℂ
  | 0 => z^2*u 42
  | 1 => z^2*u 108
  | 2 => z^2*u 126
  | 3 => z^2*l 42
  | 4 => l 60
  | 5 => z^2*l 108
  | 6 => l 120
  | 7 => z^2*l 126
  | 8 => u 120
  | _ => 0

compact_certificate theorem coupled_top (z : ℂ) (u l : ℕ → ℂ) (hz : z≠0) (hr : 2*u 60+u 120=0)
    (j : ℕ) (hj : IsFree j) : topValues z (packCoupled z u l) j=u j := by
  rcases hj with rfl | rfl | rfl | rfl | rfl
  all_goals simp only [topValues,packCoupled]
  all_goals try simp [hz]
  linear_combination -hr/2

compact_certificate theorem coupled_lower (z : ℂ) (u l : ℕ → ℂ) (hz : z≠0)
    (j : ℕ) (hj : IsFree j) : lowerValues z (packCoupled z u l) j=l j := by
  rcases hj with rfl | rfl | rfl | rfl | rfl <;> simp [lowerValues,packCoupled,hz]

compact_certificate theorem coupled_free (z : ℂ) (u l : ℕ → ℂ) (hz : z≠0) (hr : 2*u 60+u 120=0)
    (j : ℕ) (hj : j<5) :
    topFree z (packCoupled z u l) j=u (CuspMinusLaurent.coordinate (j+145)) := by
  interval_cases j
  all_goals norm_num [topFree,packCoupled,CuspMinusLaurent.coordinate,CuspMinusLaurent.coordinates]
  all_goals try simp [hz]
  linear_combination -hr/2

/- For arbitrary upper and lower vectors, the coupled residual equations
force x²=4 on the circle, if the denominator-five upper coordinate survives. -/
compact_certificate theorem coupled_circle (x z σ w c : ℂ) (u l : ℕ → ℂ)
    (hx : x≠0) (hz : z≠0) (hσ : σ=1 ∨ σ= -1) (hc : ‖x^2‖=4)
    (hr : 2*u 60+u 120=0) (hu : u 120≠0)
    (h : ∀ i : Fin 6,
      eval x (σ*(3*x/2)) z w (1/x-x/2) (σ*(2/(3*x)-4*x/3)) c u (upperResidual i.val)=0 ∧
      eval x (σ*(3*x/2)) z w (1/x-x/2) (σ*(2/(3*x)-4*x/3)) c l (lowerResidual i.val)=
      eval x (σ*(3*x/2)) z w (1/x-x/2) (σ*(2/(3*x)-4*x/3)) c
        (fun j => u (CuspMinusLaurent.coordinate (j+145))) (firstResidual i.val)) : x^2=4 := by
  let v := packCoupled z u l
  have hrows := branch_rows x z σ v hx hz hσ (by
    intro i
    rw [← upper_congr x (σ*(3*x/2)) z w (1/x-x/2) (σ*(2/(3*x)-4*x/3)) c u
      (topValues z v) (fun j hj => (coupled_top z u l hz hr j hj).symm) i]
    exact (h i).1) (by
    intro i
    rw [← lower_congr x (σ*(3*x/2)) z w (1/x-x/2) (σ*(2/(3*x)-4*x/3)) c l
      (lowerValues z v) (fun j hj => (coupled_lower z u l hz j hj).symm) i,
      ← first_congr x (σ*(3*x/2)) z w (1/x-x/2) (σ*(2/(3*x)-4*x/3)) c
        (fun j => u (CuspMinusLaurent.coordinate (j+145))) (topFree z v)
        (fun j hj => (coupled_free z u l hz hr j hj).symm) i]
    exact (h i).2)
  exact CuspMinusBranchMatrix.augmented_circle x z v hx hz hc hu hrows

#print axioms coupled_circle
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusBranchParameters
end
