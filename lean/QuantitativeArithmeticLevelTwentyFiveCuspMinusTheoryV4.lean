compact_certificate theorem lower_homogeneous (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (h : ∀ i : Fin 117, eval x y z w a b c v (lowerSource i.val)=0) :
    ∀ i : Fin 6, eval x y z w a b c v (lowerResidual i.val)=0 := by
  intro i
  apply eval_of_substitution x y z w a b c v hx hy hz hw lowerSource
