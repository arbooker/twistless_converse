    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) s<0)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hs : s≠((2*m:ℕ):ℂ)) (hu : periodicVector v (7*coordinate (3+145))≠0) :
    (primeParameter 2 m s)^2=4 := by
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hj := pole_jet_constraints_allowed AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ BG G
    hG hGF s v hv hshift hweight hs
  have hb := nonzero_cusp_branch _ _ _ _ _ _ _ _ (hn 2 (by decide)) (hn 3 (by decide)) hu hj
  obtain ⟨σ,hσ,hy,ha,hb'⟩ := branch_signs _ _ _ _ (hn 2 (by decide)) (hn 3 (by decide))
    hb.2.1 hb.2.2.1 hb.2.2.2
  have hc := (pole_nonzero_cusp_branch_allowed AuxMinusLaurent.freeCoordinate hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hshift hweight hs hu).2
  have hstack (b : Fin 2 × Fin 1050) : MeromorphicAt (fun z => stackGrid 1 G z b) s :=
    (hG b.2 (s-b.1.val)).meromorphicAt.comp_analyticAt
      (g:=fun z : ℂ => z-(b.1.val:ℂ)) (analyticAt_id.sub analyticAt_const)
  have hpstack : ∃ b : Fin 2 × Fin 1050, meromorphicOrderAt (fun z => stackGrid 1 G z b) s<0 := by
    obtain ⟨i,hi⟩ := hpole
    exact ⟨(0,i),by simpa only [stackGrid,Fin.val_zero,Nat.cast_zero,sub_zero] using hi⟩
  obtain ⟨w,hw⟩ := exists_leading_vector (stackGrid 1 G) s hstack hpstack
