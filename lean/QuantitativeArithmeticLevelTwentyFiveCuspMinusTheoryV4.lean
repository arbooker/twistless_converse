/-! ## TwentyFiveCuspMinusBranchSigns -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open QuantitativeArithmeticSevenLaurentRows

/- The algebraic first-jet branch has two signs, both retained. -/
compact_certificate theorem branch_signs (x y a b : ℂ) (hx : x≠0) (hy : y≠0)
    (hxy : 9*x^2=4*y^2) (ha : 2*a*x=2-x^2) (hb : 9*b*y=9-8*y^2) :
    ∃ σ : ℂ, (σ=1 ∨ σ= -1) ∧ y=σ*(3*x/2) ∧
      a=1/x-x/2 ∧ b=σ*(2/(3*x)-4*x/3) := by
  have ha0 : a=(2-x^2)/(2*x) := (eq_div_iff (mul_ne_zero (by norm_num) hx)).mpr (by
    linear_combination ha)
  have hb0 : b=(9-8*y^2)/(9*y) := (eq_div_iff (mul_ne_zero (by norm_num) hy)).mpr (by
    linear_combination hb)
  have ha1 : a=1/x-x/2 := by rw [ha0]; field_simp
  have hsq : y^2=(3*x/2)^2 := by linear_combination -hxy/4
  rcases (sq_eq_sq_iff_eq_or_eq_neg).mp hsq with h | h
  · refine ⟨1,Or.inl rfl,by simpa using h,ha1,?_⟩
    rw [hb0,h]
    field_simp
    ring
  · refine ⟨-1,Or.inr rfl,by simpa using h,ha1,?_⟩
    rw [hb0,h]
    field_simp
    ring

#print axioms branch_signs
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
end

