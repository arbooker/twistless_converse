compact_certificate def selectedPoint (i : Fin 59) : Fin 4 := ⟨point i.val,point_bound i⟩

/- The 59 normalized original equations force the upper denominator-five
coordinate to vanish. The kernel-checked identity is used without a CAS axiom. -/
compact_certificate theorem normalized_equations_kill_cusp (c : ℂ) (v : Fin 4 × Fin 1050 → ℂ)
    (h : ∀ i : Fin 59,
      eval 1 1 1 1 0 0 c (periodicVector (fun j => v (selectedPoint i,j)))
        (exceptionalPoly (point i.val) (rawSourcePoly (-1) (actual i.val)))=
      ∑ a∈Finset.range (point i.val),
        eval 1 1 1 1 0 0 c (periodicVector (fun j => v (lowerIndex (selectedPoint i) a,j)))
          (exceptionalShift (-1) (point i.val) a (actual i.val))) : v (0,840)=0 := by
  have hs : ∀ i : Fin 59, eval 1 1 1 1 0 0 c (cuspBlockVector v) (source i.val)=0 := by
    intro i
    rw [← cuspBlockLift_eval c v,← actual_block i,
      eval_normalizedPoly _ _ _ _ _ _ _ _ (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
    have he := exceptionalBlock_eval c v (selectedPoint i) (actual i.val) (leading_support i)
      (fun a ha => shift_support i ⟨a,by have hi:=point_bound i; omega⟩)
    change eval _ _ _ _ _ _ _ _ (exceptionalBlockPoly (-1) (point i.val) (actual i.val))=_ at he
    rw [he]
    exact sub_eq_zero.mpr (h i)
  have hc : ∀ i : Fin 59, eval 1 1 1 1 0 0 0 (cuspBlockVector v) (source i.val)=0 := by
    intro i
    have he : eval 1 1 1 1 0 0 0 (cuspBlockVector v) (source i.val)=
        eval 1 1 1 1 0 0 c (cuspBlockVector v) (source i.val) := by
      unfold eval
      congr 1
      apply List.map_congr_left
      intro t ht
      simp only [monomial,source_inert i t ht,pow_zero]
    exact he.trans (hs i)
  have hz := upper_cusp_zero (cuspBlockVector v) hc
  exact hz

#print axioms normalized_equations_kill_cusp
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusExceptionalBlock
end
