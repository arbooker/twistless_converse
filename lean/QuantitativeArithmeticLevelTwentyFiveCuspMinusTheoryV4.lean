/-! ## TwentyFiveCuspMinusLaurentKernel -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open QuantitativeArithmeticSevenLaurentRows

/- The 1198 checked leading equations leave at most the five displayed
coordinates. No nonzero Hecke eigenvalue is required. -/
compact_certificate theorem leading_kernel (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hs : ∀ j<1198, eval x y z w a b c v (source j)=0)
    (hf : ∀ j : Fin 5, v (coordinate (j.val+145))=0) :
    ∀ j<150, v j=0 := by
  have hn := leading_elimination x y z w a b c v hx hy hz hw hs
  have hnormal : ∀ i<150, eval x y z w a b c v (unitTri i)=0 := by
    intro i hi
    by_cases h : i<145
    · simpa only [unitTri,ite_eq_left h] using hn i h
    · have he : i-145+145=i := by omega
      simpa [unitTri,h,eval,monomial,he] using hf ⟨i-145,by omega⟩
  have ht : ∀ i : Fin 150, v (coordinate i.val)+eval x y z w a b c v (triTail i.val)=0 := by
    intro i
    have hh := hnormal i.val i.isLt
    rw [← all_triangular_checked i.val i.isLt,eval_mergeFuel] at hh
    simpa [eval,monomial] using hh
  have hzall := triangular_kernel x y z w a b c v 150
    (fun i => coordinate i.val) (fun i => triTail i.val) ht (by
      intro i t ht
      obtain ⟨hbound,higher⟩ := all_triangular_prior i.val i.isLt t ht
      refine ⟨⟨position t.2.1,position_bound ⟨t.2.1,hbound⟩⟩,higher,?_⟩
      exact (coordinate_position ⟨t.2.1,hbound⟩).symm)
  intro j hj
  have hh := hzall ⟨position j,position_bound ⟨j,hj⟩⟩
  simpa only [coordinate_position ⟨j,hj⟩] using hh

compact_certificate theorem eval_sub_vectors (x y z w a b c : ℂ) (v u : ℕ → ℂ) (p : Poly) :
    eval x y z w a b c (fun j => v j-u j) p=
      eval x y z w a b c v p-eval x y z w a b c u p := by
  induction p with
  | nil => simp
  | cons t p ih => simp only [eval_cons,ih]; ring

/- Explicit Laurent-polynomial parametrization of the leading kernel. -/
compact_certificate theorem leading_parametrization (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hs : ∀ j<1198, eval x y z w a b c v (source j)=0) :
    ∀ j<150, v j=eval x y z w a b c (fun t => v (coordinate (t+145))) (basis j) := by
  let u : ℕ → ℂ := fun t => v (coordinate (t+145))
  let d : ℕ → ℂ := fun j => v j-eval x y z w a b c u (basis j)
  have hn := leading_elimination x y z w a b c v hx hy hz hw hs
  have hd : ∀ i<145, eval x y z w a b c d (normal i)=0 := by
    intro i hi
    change eval x y z w a b c (fun j => v j-eval x y z w a b c u (basis j)) (normal i)=0
    rw [eval_sub_vectors,hn i hi,
      substitution_zero x y z w a b c u hx hy hz hw basis (normal i) (all_normal_basis_zero i hi),sub_self]
  have hfree : ∀ i : Fin 5, d (coordinate (i.val+145))=0 := by
    intro i
    simp only [d,basis_free_coordinate i]
    simp [eval,monomial,u]
  have hnormal : ∀ i<150, eval x y z w a b c d (unitTri i)=0 := by
    intro i hi
    by_cases h : i<145
    · simpa only [unitTri,ite_eq_left h] using hd i h
    · have he : i-145+145=i := by omega
      simpa [unitTri,h,eval,monomial,he] using hfree ⟨i-145,by omega⟩
  have ht : ∀ i : Fin 150, d (coordinate i.val)+eval x y z w a b c d (triTail i.val)=0 := by
    intro i
    have hh := hnormal i.val i.isLt
    rw [← all_triangular_checked i.val i.isLt,eval_mergeFuel] at hh
    simpa [eval,monomial] using hh
  have hzall := triangular_kernel x y z w a b c d 150
    (fun i => coordinate i.val) (fun i => triTail i.val) ht (by
      intro i t ht
      obtain ⟨hbound,higher⟩ := all_triangular_prior i.val i.isLt t ht
      refine ⟨⟨position t.2.1,position_bound ⟨t.2.1,hbound⟩⟩,higher,?_⟩
      exact (coordinate_position ⟨t.2.1,hbound⟩).symm)
  intro j hj
  have hh := hzall ⟨position j,position_bound ⟨j,hj⟩⟩
  simp only [coordinate_position ⟨j,hj⟩,d] at hh
  exact sub_eq_zero.mp hh

#print axioms leading_kernel
#print axioms leading_parametrization
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
