/-! ## TwentyFiveCuspMinusTwoPointLowerLeading -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector
open QuantitativeArithmeticSmallLevelTwentyFiveCuspLift

/- If the upper projection vanishes, all 1198 cusp rows annihilate the
lower projection. This does not assert regularity at the upper point. -/
compact_certificate theorem lower_leading_rows_of_upper_zero (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 2 × Fin 1050 → ℂ)
    (hv : IsLeadingVector (SmallLevelFiniteShift.stackGrid 1 G) s v)
    (hzero : (fun j => v (0,j))=0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n)) :
    ∀ i<1198, eval (primeParameter 2 m (s-1)) (primeParameter 3 m (s-1))
      (primeParameter 5 m (s-1)) (primeParameter 7 m (s-1))
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun t => periodicVector (fun j => v (1,j)) (7*t)) (source i)=0 := by
  intro i hi
  let j : Fin 4600 := ⟨auxIndex i, all_aux_index_bound i hi⟩
  let r := physicalPart (AuxMinusLaurent.actual (auxIndex i))
  have hr : AuxMinusLaurent.actual j.val=SourceRow.physical r :=
    cusp_source_physical ⟨i,hi⟩
  have hp := AuxMinusLaurent.all_actual_source j
  have hq := AuxMinusLaurent.all_actual_tail j
  rw [hr] at hp hq
  have hlead := physical_two_point_rows AuxMinusLaurent.basis free
    AuxMinusLaurent.basis_periodic r (-1) (AuxMinusLaurent.source j.val)
    (AuxMinusLaurent.tail j.val) hp hq
    (AuxMinusLaurent.all_source_zero j) (AuxMinusLaurent.all_tail_zero j)
    hm hf ε hε hlaw (by simpa using hχ) BG G hG hGF s v hv hshift
  have hl : leading r m f ε (s-1) (fun j => v (1,j))=0 := by
    rw [hlead.2,hzero]
    simpa only [zero_smul,zero_mul] using shifted_smul r m f ε 0 (s-1) 0 0
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m (s-1)≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he := eval_rawSourcePoly (.physical r) hf ε (s-1) (-1) (by simpa using hχ) (fun j => v (1,j))
  rw [← eval_normalizedPoly _ _ _ _ _ _ _ _ (hn 2 (by decide)) (hn 3 (by decide))
    (hn 5 (by decide)) (hn 7 (by decide)), hp] at he
  change eval _ _ _ _ _ _ _ _ (AuxMinusLaurent.source (auxIndex i))=_ at he
  rw [all_aux_source i hi, eval_liftPoly] at he
  exact he.trans hl

#print axioms lower_leading_rows_of_upper_zero
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
end

