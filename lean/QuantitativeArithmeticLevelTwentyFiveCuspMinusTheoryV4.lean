/-! ## TwentyFiveExceptionalEvaluation -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridData
open SmallLevelFiniteShift
open SmallLevelTwentyOneKnownWords (jetScale jetScale_binomial jetScale_ne_zero)

/- Exceptional leading rows are exact evaluations of the original rows. -/
compact_certificate theorem exceptional_source_eval (r : SourceRow) {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (χ : ℚ) (hχ : ε*Complex.I^(2*m)=(χ:ℂ))
    (h2 : (Real.sqrt 2:ℂ)*f 2= -1/2) (h3 : (Real.sqrt 3:ℂ)*f 3= -7/3)
    (n : ℕ) (v : Fin 1050 → ℂ) :
    eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7) (periodicVector v)
      (exceptionalPoly n (rawSourcePoly χ r))=
      sourceLeading r m f ε ((m:ℂ)+1-n) v := by
  rw [exceptionalPoly_eval]
  have he := eval_rawSourcePoly r hf ε ((m:ℂ)+1-n) χ hχ v
  rw [primeParameter_exceptional 2 m n (by decide),primeParameter_exceptional 3 m n (by decide),
    primeParameter_exceptional 5 m n (by decide),primeParameter_exceptional 7 m n (by decide),h2,h3] at he
  exact he

/- The scalar normalization for all three lower shifts, reusing the
previously checked common Taylor normalization. -/
compact_certificate theorem exceptional_scalar (μ r d : ℂ) (hr : r≠0) (m : ℕ)
    (n : Fin 4) (a : ℕ) (ha : a<n.val) :
    μ*r^(((m:ℂ)+1-n.val)-(m:ℂ))*(Complex.I*d)^(a+1)*
      Ring.choose (((m:ℂ)+1-n.val)+((a+1:ℕ):ℂ)-((2*m:ℕ):ℂ)) (a+1)*
      jetScale (1-(m:ℂ)) (lowerIndex n a)=
      jetScale (1-(m:ℂ)) n*(μ*(r/r^n.val)*d^(a+1)/((a+1).factorial:ℂ)) := by
  have hpow : (m:ℂ)+1-n.val-(m:ℂ)=1-(n.val:ℂ) := by ring
  have hchoose : (m:ℂ)+1-n.val+((a+1:ℕ):ℂ)-((2*m:ℕ):ℂ)=
      (1-(m:ℂ))-n.val+((a+1:ℕ):ℂ) := by push_cast; ring
  rw [hpow,hchoose,Complex.cpow_sub _ _ hr,Complex.cpow_one,Complex.cpow_natCast,mul_pow]
  have h := jetScale_binomial (1-(m:ℂ)) n a ha
  calc
    _ = μ*(r/r^n.val)*d^(a+1)*(Complex.I^(a+1)*
        Ring.choose ((1-(m:ℂ))-n.val+((a+1:ℕ):ℂ)) (a+1)*
        jetScale (1-(m:ℂ)) (lowerIndex n a)) := by ring
    _ = _ := by rw [h]; ring

/- Actual Taylor coefficients, after normalization, equal the explicit
rational shift rows. This equality retains the arbitrary parameter at 7. -/
compact_certificate theorem exceptional_shift_eval (r : SourceRow) (m : ℕ) (f : ℕ → ℂ)
    (ε : ℂ) (χ : ℚ) (hχ : ε*Complex.I^(2*m)=(χ:ℂ))
    (n : Fin 4) (a : ℕ) (ha : a<n.val) (v : Fin 1050 → ℂ) :
    sourceShifted r m f ε a ((m:ℂ)+1-n.val)
        (jetScale (1-(m:ℂ)) (lowerIndex n a) • v)=
      jetScale (1-(m:ℂ)) n * eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
        (periodicVector v) (exceptionalShift χ n.val a r) := by
  cases r with
  | old j => simp [sourceShifted,exceptionalShift]
  | physical r =>
    cases r with
    | word r =>
      have hr : r.rate≠0 := by rw [r.powers_eq]; positivity
      have hrc : (r.rate:ℂ)≠0 := by exact_mod_cast hr
      simp only [sourceShifted,shifted,QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid.coefficient,Pi.smul_apply,smul_eq_mul,exceptionalShift]
      rw [eval_shift _ _ _ _ _ _ _ _ (by norm_num) (by norm_num) (by norm_num) (by norm_num),eval_gridPoly]
      simp only [monomial,zpow_zero,pow_zero,mul_one,Rat.cast_div,Rat.cast_mul,Rat.cast_pow,
        Rat.cast_natCast,hχ]
      have h := exceptional_scalar ((χ:ℂ)^r.count) (r.rate:ℂ) (r.slope:ℂ) hrc m n a ha
      linear_combination h*v (gridIndex 1050 (by decide) r.target)
    | taylor r =>
      have hr : r.rate≠0 := by rw [r.powers_eq]; positivity
      have hrc : (r.rate:ℂ)≠0 := by exact_mod_cast hr
      simp only [sourceShifted,shifted,exceptionalShift]
      rw [taylorCoefficient_rational m f ε r.divides,r.rate_eq,r.slope_eq,sampleSum_smul,
        eval_shift _ _ _ _ _ _ _ _ (by norm_num) (by norm_num) (by norm_num) (by norm_num),eval_samplePoly]
      simp only [monomial,zpow_zero,pow_zero,mul_one,Rat.cast_div,Rat.cast_mul,Rat.cast_pow,
        Rat.cast_natCast,QuantitativeArithmeticSmallLevelTwentyFive.GridSystem.phaseRoot,hχ]
      have h := exceptional_scalar (χ:ℂ) (r.rate:ℂ) (r.slope:ℂ) hrc m n a ha
      linear_combination h*sampleSum 1050 (by decide) r.q r.target v
    | entire q hq hd => simp [sourceShifted,shifted,exceptionalShift]
    | hecke p hp hd j => simp [sourceShifted,shifted,exceptionalShift]
    | infinity w j hn hd => simp [sourceShifted,shifted,exceptionalShift]

#print axioms exceptional_source_eval
#print axioms exceptional_scalar
#print axioms exceptional_shift_eval
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveExceptionalNormalizedRows -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift
open SmallLevelTwentyOneKnownWords (jetScale jetScale_ne_zero)

compact_certificate def normalizeExceptional (m : ℕ) (v : Fin 4 × Fin 1050 → ℂ) (b : Fin 4 × Fin 1050) : ℂ :=
  (jetScale (1-(m:ℂ)) b.1)⁻¹*v b

compact_certificate theorem normalizeExceptional_cancel (m : ℕ) (hm : 2≤ m) (v : Fin 4 × Fin 1050 → ℂ)
    (n : Fin 4) : jetScale (1-(m:ℂ)) n • (fun j => normalizeExceptional m v (n,j))=
      (fun j => v (n,j)) := by
  funext j
  simp only [Pi.smul_apply,smul_eq_mul,normalizeExceptional,← mul_assoc,
    mul_inv_cancel₀ (jetScale_ne_zero m hm n),one_mul]

/- Normalizing the universal principal vector yields the rational
four-point equations. The hypothesis m≥2 makes every scale nonzero. -/
compact_certificate theorem normalized_physical_block (basis : ℕ → Poly) (free : Fin 68 → Fin 1050)
    (hperiodic : ∀ j, basis (j%1050)=basis j)
    (r : Row) (p q : Poly)
    (hp : normalizedPoly (rawSourcePoly (-1) (.physical r))=p)
    (hq : normalizedPoly (rawTailPoly (.physical r))=q)
    (hpzero : substitute basis p=[]) (hqzero : substitute basis q=[])
    {m : ℕ} (hm : 2≤ m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis free m f z (gridVector 1050 (2*m) f z))
    (v : Fin 4 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 3 G) ((m:ℂ)+1) v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) ((m:ℂ)+1+n))
    (h2 : (Real.sqrt 2:ℂ)*f 2= -1/2) (h3 : (Real.sqrt 3:ℂ)*f 3= -7/3)
    (n : Fin 4) :
    eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
      (periodicVector (fun j => normalizeExceptional m v (n,j)))
      (exceptionalPoly n.val (rawSourcePoly (-1) (.physical r)))=
    ∑ a∈Finset.range n.val, eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
      (periodicVector (fun j => normalizeExceptional m v (lowerIndex n a,j)))
      (exceptionalShift (-1) n.val a (.physical r)) := by
  have h := physical_block_rows basis free hperiodic r (-1) p q hp hq hpzero hqzero
    (by omega : 0< m) hf ε hε hlaw (by simpa using hχ) BG G hG hGF ((m:ℂ)+1) 3 v hv hshift n
  have hnorm := normalizeExceptional_cancel m hm v
  have he := exceptional_source_eval (.physical r) hf ε (-1) (by simpa using hχ) h2 h3 n.val
    (fun j => normalizeExceptional m v (n,j))
  simp only [sourceLeading] at he
  rw [← hnorm n,leading_smul,← he] at h
  have hterms : ∀ a∈Finset.range n.val,
      shifted r m f ε a ((m:ℂ)+1-n.val) (fun j => v (lowerIndex n a,j))=
      jetScale (1-(m:ℂ)) n * eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
        (periodicVector (fun j => normalizeExceptional m v (lowerIndex n a,j)))
        (exceptionalShift (-1) n.val a (.physical r)) := by
    intro a ha
    rw [← hnorm (lowerIndex n a)]
    exact exceptional_shift_eval (.physical r) m f ε (-1) (by simpa using hχ)
      n a (Finset.mem_range.mp ha) _
  rw [Finset.sum_congr rfl hterms,← Finset.mul_sum] at h
  exact mul_left_cancel₀ (jetScale_ne_zero m hm n) h

#print axioms normalizeExceptional_cancel
#print axioms normalized_physical_block
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveCuspMinusThirdJetPole -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- The original negative-phase Taylor equations exclude a nonzero
highest denominator-five coordinate at a top pole away from the weight.
No simplicity or equality of lower-point pole orders is assumed. -/
compact_certificate theorem pole_cusp_coordinate_zero
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis
      AuxMinusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) s<0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : s≠((2*m:ℕ):ℂ)) : periodicVector v (7*coordinate (3+145))=0 := by
  by_contra hu
  obtain ⟨hs0,h2,h3⟩ := pole_exceptional_location hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hpole hshift hs hu
  subst s
  have hm2 : 2≤ m := by
    by_contra h
    have hm1 : m=1 := by omega
    apply hs
    norm_num [hm1]
  have hstack (b : Fin 4 × Fin 1050) : MeromorphicAt (fun z => stackGrid 3 G z b) ((m:ℂ)+1) :=
    (hG b.2 ((m:ℂ)+1-b.1.val)).meromorphicAt.comp_analyticAt
      (g:=fun z : ℂ => z-(b.1.val:ℂ)) (analyticAt_id.sub analyticAt_const)
  have hpstack : ∃ b : Fin 4 × Fin 1050,
      meromorphicOrderAt (fun z => stackGrid 3 G z b) ((m:ℂ)+1)<0 := by
    obtain ⟨i,hi⟩ := hpole
    exact ⟨(0,i),by simpa only [stackGrid,Fin.val_zero,Nat.cast_zero,sub_zero] using hi⟩
  obtain ⟨w,hw⟩ := exists_leading_vector (stackGrid 3 G) ((m:ℂ)+1) hstack hpstack
  have h0 := exceptional_four_point_upper_nonzero hm hf ε hε hlaw hχ BG G hG hGF w hw hshift h2 h3
  have hw0 := hw.project_top h0
  have huw : periodicVector (fun j => w (0,j)) (7*coordinate (3+145))≠0 := by
    intro hz
    apply hu
    exact (hv.coordinate_zero_iff hw0 (fun j => (hG j _).meromorphicAt) hpole _).mpr hz
  have hz := CuspMinusExceptionalBlock.normalized_equations_kill_cusp
    ((Real.sqrt 7:ℂ)*f 7) (normalizeExceptional m w) (by
      intro i
      let j : Fin 4600 := ⟨CuspMinusExceptionalBlock.auxiliaryIndex i.val,
        CuspMinusExceptionalBlock.auxiliaryIndex_bound i⟩
      have hp := AuxMinusLaurent.all_actual_source j
      have hq := AuxMinusLaurent.all_actual_tail j
      change normalizedPoly (rawSourcePoly (-1)
        (AuxMinusLaurent.actual (CuspMinusExceptionalBlock.auxiliaryIndex i.val)))=_ at hp
      change normalizedPoly (rawTailPoly
        (AuxMinusLaurent.actual (CuspMinusExceptionalBlock.auxiliaryIndex i.val)))=_ at hq
      rw [← CuspMinusExceptionalBlock.actual_eq i,CuspMinusExceptionalBlock.actual_physical i] at hp hq
      rw [CuspMinusExceptionalBlock.actual_physical i]
      exact normalized_physical_block AuxMinusLaurent.basis AuxMinusLaurent.freeCoordinate
        AuxMinusLaurent.basis_periodic (CuspMinusExceptionalBlock.physicalRow i.val)
        (AuxMinusLaurent.source j.val) (AuxMinusLaurent.tail j.val) hp hq
        (AuxMinusLaurent.all_source_zero j) (AuxMinusLaurent.all_tail_zero j)
        hm2 hf ε hε hlaw hχ BG G hG hGF w hw hshift h2 h3
        (CuspMinusExceptionalBlock.selectedPoint i))
  apply huw
  simpa [normalizeExceptional,SmallLevelTwentyOneKnownWords.jetScale,periodicVector,
    show coordinate (3+145)=120 from rfl] using hz

#print axioms pole_cusp_coordinate_zero
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
end

/-! ## TwentyFiveCuspMinusFiveCoordinates -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxSize 2048
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open QuantitativeArithmeticSevenLaurentRows

compact_certificate theorem basis_thirty : basis 30=[(-1,3,(0,0,0,0,0,0,0))] := by decide +kernel
compact_certificate theorem basis_ninety : basis 90=[(-1,1,(0,0,0,0,0,0,0))] := by decide +kernel

/- The other two denominator-five coordinates are determined by the free
ones. This is a consequence of the checked leading system alone. -/
compact_certificate theorem denominator_five_relations (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (h : ∀ i<1198, eval x y z w a b c v (source i)=0) :
    v 30= -v 120 ∧ v 90= -v 60 := by
  have hp := leading_parametrization x y z w a b c v hx hy hz hw h
  have h30 := hp 30 (by decide)
  have h90 := hp 90 (by decide)
  rw [basis_thirty] at h30
  rw [basis_ninety] at h90
  constructor
  · simpa [eval,monomial,show coordinate (3+145)=120 from rfl] using h30
  · simpa [eval,monomial,show coordinate (1+145)=60 from rfl] using h90

#print axioms denominator_five_relations
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
end
