/-! ## TwentyFiveCuspMinusLowerResidualEquations -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
open QuantitativeArithmeticSevenLaurentRows

compact_certificate theorem upper_checked (i : Fin 6) : substitute upperSource (upperOperation i.val)=upperResidual i.val := by
  fin_cases i
  · exact upper_checked_0
  · exact upper_checked_1
  · exact upper_checked_2
  · exact upper_checked_3
  · exact upper_checked_4
  · exact upper_checked_5

compact_certificate theorem lower_checked (i : Fin 6) : substitute lowerSource (lowerOperation i.val)=lowerResidual i.val := by
  fin_cases i
  · exact lower_checked_0
  · exact lower_checked_1
  · exact lower_checked_2
  · exact lower_checked_3
  · exact lower_checked_4
  · exact lower_checked_5

compact_certificate theorem first_checked (i : Fin 6) :
    substitute (fun j => substitute CuspMinusLaurent.basis (rawJet j)) (lowerOperation i.val)=firstResidual i.val := by
  fin_cases i
  · exact first_checked_0
  · exact first_checked_1
  · exact first_checked_2
  · exact first_checked_3
  · exact first_checked_4
  · exact first_checked_5

/- All six upper residual equations follow from the original selected rows. -/
compact_certificate theorem upper_residuals (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (h : ∀ i : Fin 117, eval x y z w a b c v (upperSource i.val)=0) :
    ∀ i : Fin 6, eval x y z w a b c v (upperResidual i.val)=0 := by
  intro i
  apply eval_of_substitution x y z w a b c v hx hy hz hw upperSource
    (upperOperation i.val) (upperResidual i.val) (upper_checked i)
  intro t ht
  exact h ⟨t.2.1,upperOperation_support i t ht⟩

/- Simultaneous lower-point and first-shift elimination, retaining all five
lower unknowns. The shared-order analytic extraction is a separate step. -/
compact_certificate theorem lower_residuals (x y z w a b c : ℂ) (v u t : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (h : ∀ i : Fin 117, eval x y z w a b c v (lowerSource i.val)=
      eval x y z w a b c u (rawJet i.val))
    (hu : ∀ j<150, u j=eval x y z w a b c t (CuspMinusLaurent.basis j)) :
    ∀ i : Fin 6, eval x y z w a b c v (lowerResidual i.val)=
      eval x y z w a b c t (firstResidual i.val) := by
  intro i
  rw [← lower_checked i,eval_substitute x y z w a b c v hx hy hz hw,
    ← first_checked i,eval_substitute x y z w a b c t hx hy hz hw]
  apply eval_congr_support
  intro q hq
  have hbound := lowerOperation_support i q hq
  rw [h ⟨q.2.1,hbound⟩,eval_substitute x y z w a b c t hx hy hz hw]
  apply eval_congr_support
  intro r hr
  exact hu r.2.1 (rawJet_support ⟨q.2.1,hbound⟩ r hr)

#print axioms upper_residuals
#print axioms lower_residuals
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
end
