/-! ## TwentyFiveCuspMinusTwoPointSources -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- The actual 117 original Taylor equations for one two-point principal
vector, with the lower vector normalized by the nonzero first-shift factor.
This does not assume equal pole orders or a nonzero upper projection. -/
compact_certificate theorem two_point_source_equations (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxMinusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 2 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 1 G) s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : s≠((2*m:ℕ):ℂ)) :
    ∀ i : Fin 117,
      eval (primeParameter 2 m s) (primeParameter 3 m s)
        (primeParameter 5 m s) (primeParameter 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
        (fun j => periodicVector (fun t => v (0,t)) (7*j)) (upperSource i.val)=0 ∧
      eval (primeParameter 2 m s) (primeParameter 3 m s)
        (primeParameter 5 m s) (primeParameter 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
        (fun j => (Complex.I*(s-((2*m:ℕ):ℂ)))⁻¹*periodicVector (fun t => v (1,t)) (7*j))
        (lowerSource i.val)=
      eval (primeParameter 2 m s) (primeParameter 3 m s)
        (primeParameter 5 m s) (primeParameter 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
        (fun j => periodicVector (fun t => v (0,t)) (7*j)) (rawJet i.val) := by
  intro i
  let j : Fin 4600 := ⟨auxiliaryIndex i.val,auxiliaryIndex_bound i⟩
  have hp := aux_source i
  have hq := aux_tail i
  rw [actual_physical i] at hp hq
  have h := physical_two_point_rows AuxMinusLaurent.basis free AuxMinusLaurent.basis_periodic
    (physicalRows i.val) (-1) (AuxMinusLaurent.source j.val) (AuxMinusLaurent.tail j.val)
    hp hq (AuxMinusLaurent.all_source_zero j) (AuxMinusLaurent.all_tail_zero j)
    hm hf ε hε hlaw (by simpa using hχ) BG G hG hGF s v hv hshift
  constructor
  · rw [upper_eval hf ε s hχ _ i]
    exact h.1
  · rw [eval_smul,lower_eval hf ε s hχ _ i,h.2,shift_eval m f ε s hχ _ i]
    rw [← mul_assoc,inv_mul_cancel₀ (mul_ne_zero I_ne_zero (sub_ne_zero.mpr hs)),one_mul]

#print axioms two_point_source_equations
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLowerResidual
end
