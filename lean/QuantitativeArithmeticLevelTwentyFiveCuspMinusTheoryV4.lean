    exact exceptional_shift_eval (.physical r) m f ε (-1) (by simpa using hχ)
      n a (Finset.mem_range.mp ha) _
  rw [Finset.sum_congr rfl hterms,← Finset.mul_sum] at h
  exact mul_left_cancel₀ (jetScale_ne_zero m hm n) h

