/-! ## TwentyFiveCuspMinusLaurentSelectedJetConsequences -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
open QuantitativeArithmeticSevenLaurentRows

compact_certificate theorem selected_jet_constraints (x y z w a b c : ℂ) (lower free : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hrows : ∀ i, eval x y z w a b c lower (jetLowerSource i)=
      eval x y z w a b c (fun j => eval x y z w a b c free (basis j)) (jetRawShift i)) :
    ∀ i : Fin 4, eval x y z w a b c free (jetConstraint i.val)=0 := by
  have hlead : ∀ i : Fin 4, substitute jetLowerSource (jetOperation i.val)=[] := by
    intro i; fin_cases i
    · exact jet_leading_zero_0
    · exact jet_leading_zero_1
    · exact jet_leading_zero_2
    · exact jet_leading_zero_3
  have hshift : ∀ i : Fin 4, substitute (fun j => substitute basis (jetRawShift j)) (jetOperation i.val)=jetConstraint i.val := by
    intro i; fin_cases i
    · exact jet_shift_constraint_0
    · exact jet_shift_constraint_1
    · exact jet_shift_constraint_2
    · exact jet_shift_constraint_3
  intro i
  have hh := substitution_zero x y z w a b c lower hx hy hz hw jetLowerSource (jetOperation i.val) (hlead i)
  have he : (fun j => eval x y z w a b c lower (jetLowerSource j))=
      (fun j => eval x y z w a b c free (substitute basis (jetRawShift j))) := by
    funext j
    rw [eval_substitute x y z w a b c free hx hy hz hw]
    exact hrows j
  rw [he,← eval_substitute x y z w a b c free hx hy hz hw,hshift i] at hh
  exact hh

compact_certificate theorem selected_jet_equations (x y z w a b c : ℂ) (u : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0)
    (h : ∀ i : Fin 4, eval x y z w a b c u (jetConstraint i.val)=0) :
    2*u 1+u 3=0 ∧
    (2*a*x+x^2-2)*u 3=0 ∧
    (-9*a*x+18*x^2-10*y^2+9)*u 3=0 ∧
    (-3*a*x+6*b*y+6*x^2+2*y^2-3)*u 3=0 := by
  have h0 := h 0
  have h1 := h 1
  have h2 := h 2
  have h3 := h 3
  norm_num [jetConstraint,eval,monomial,jetExponent0,jetExponent1,jetExponent2,jetExponent3,jetExponent4,jetExponent5,jetExponent6,jetExponent7,jetExponent8,jetExponent9,jetExponent10,jetExponent11,jetCoefficient0,jetCoefficient1,jetCoefficient2,jetCoefficient3,jetCoefficient4,jetCoefficient5,jetCoefficient6,jetCoefficient7,jetCoefficient8,jetCoefficient9,jetCoefficient10,jetCoefficient11,jetCoefficient12,jetCoefficient13,jetCoefficient14,jetCoefficient15,jetCoefficient16,jetCoefficient17,jetCoefficient18,jetCoefficient19,jetCoefficient20,jetCoefficient21,jetCoefficient22,jetCoefficient23,jetCoefficient24,jetCoefficient25,jetCoefficient26,jetCoefficient27,jetCoefficient28,jetCoefficient29,jetCoefficient30,jetCoefficient31,jetCoefficient32,jetCoefficient33,jetCoefficient34,jetCoefficient35,jetCoefficient36,jetCoefficient37,jetCoefficient38,jetCoefficient39,jetCoefficient40] at h0 h1 h2 h3
  have hr : 2*u 1+u 3=0 := by linear_combination h0/5
  field_simp [hx] at h1
  field_simp [hy] at h2 h3
  refine ⟨hr,?_,?_,?_⟩
  · linear_combination h1/5+(2*a*x-2)*hr
  · linear_combination 2*h2/5+(9-9*a*x)*hr
  · linear_combination 2*h3/5+(27+2*y^2-3*a*x)*hr

#print axioms selected_jet_constraints
#print axioms selected_jet_equations
end QuantitativeArithmeticSmallLevelTwentyFive.CuspMinusLaurent
