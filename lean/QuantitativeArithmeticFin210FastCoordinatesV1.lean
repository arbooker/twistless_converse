theorem zero_step {n : ℕ} (v : Fin (n+1) → ℂ) (h : v 0=0)
    (ht : (fun i : Fin n => v i.succ)=0) : v=0 := by
  funext i
  refine Fin.cases h (fun j => ?_) i
  exact congrFun ht j

