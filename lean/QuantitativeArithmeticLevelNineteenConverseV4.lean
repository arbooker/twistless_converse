  have h21zero : residualRows0 x y z a b v 21=0 := congrFun hr 21
  rw [h8zero,mul_zero] at h8
  rw [h21zero,mul_zero] at h21
  apply obstruction_zero (x^2) (y^2) (a*x) (b*y) hY
  · exact neg_eq_zero.mp ((mul_eq_zero.mp h8.symm).resolve_right ht)
  · exact (mul_eq_zero.mp h21.symm).resolve_right ht

