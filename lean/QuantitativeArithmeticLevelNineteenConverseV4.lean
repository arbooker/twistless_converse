theorem inputs_zero (B A Z Y X : ℂ)
    (h1 : poly1 B A Z Y X=0)
    (h2 : poly2 B A Z Y X=0)
    (h3 : poly3 B A Z Y X=0)
    (h4 : poly4 B A Z Y X=0)
    (h6 : poly6 B A Z Y X=0)
    (h9 : poly9 B A Z Y X=0)
    (h10 : poly10 B A Z Y X=0)
    (h15 : poly15 B A Z Y X=0)
    (h18 : poly18 B A Z Y X=0)
    (h19 : poly19 B A Z Y X=0)
    : ∀ i, eval B A Z Y X (inputs i)=0 := by
  intro i
  rcases i with _ | i
  · simp only [inputs,input0_match,h1,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input1_match,h2,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input2_match,h3,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input3_match,h4,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input4_match,h6,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input5_match,h9,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input6_match,h10,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input7_match,h15,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input8_match,h18,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input9_match,h19,mul_zero]
  rfl
theorem target0_eval (B A Z Y X : ℂ) : eval B A Z Y X target0=(denominator0:ℂ)*((X-4)*(Y+1)*(X-1)) := by
  norm_num [target0,denominator0,eval,monomial] <;> ring
theorem denominator0_ne_zero : (denominator0:ℂ)≠0 := by norm_num [denominator0]
theorem target1_eval (B A Z Y X : ℂ) : eval B A Z Y X target1=(denominator1:ℂ)*((Y+1)*(A+X-1)) := by
  norm_num [target1,denominator1,eval,monomial] <;> ring
