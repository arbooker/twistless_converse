theorem symbolicGroup_flip (X Y Z : ℂ) (i : Fin 45) :
    symbolicGroup X Y (-Z) i=symbolicGroup X Y Z i := by
  fin_cases i <;> simp [symbolicGroup,groupPowers,threePrimeMonomial]

theorem symbolicTaylor_flip (χ δ X Y Z : ℂ) (i : Fin 18) :
