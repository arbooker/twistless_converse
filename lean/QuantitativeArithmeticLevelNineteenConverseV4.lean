    evalTerm ((2:ℂ)^n) ((9:ℂ)^(n+l)) ((4:ℂ)^l) t =
      (t.2.2.2:ℂ)*(termAlpha t:ℂ)^n*(termBeta t:ℂ)^l := by
  have hp (a : ℂ) (i j : ℕ) : (a^i)^j=(a^j)^i := by
    rw [← pow_mul,← pow_mul,Nat.mul_comm i j]
