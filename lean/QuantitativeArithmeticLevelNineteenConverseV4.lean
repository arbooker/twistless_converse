/-- Nonzero leading kernel vectors have one free scale on the generic stratum. -/
theorem normalized_leading_vector2 (x y z a b : ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (ha : a≠0)
    (hx4 : x^4≠1) (hY : y^2+1≠0) (hgap : a= -x-1/x ∨ x^2+a*x+1≠0)
    (v : Fin 114→ℂ) (hvn : v≠0)
    (hv : symbolicRows (-1) 1 x y z a b v=0) :
    ∃ t : ℂ, t≠0 ∧ v 18= -(x^4+(a^2-2)*x^2+1)*t ∧
      v 42=x*a*(y^2+1)*t ∧ v 72= -x*a*(y^2+1)*t := by
  obtain ⟨hr,hinj⟩ := actual_symbolic_kernel_reduce2 x y z a b hx hy hz ha v hv
  obtain ⟨h72,hrow⟩ := leading_coordinates_gap2 x y z a b hx hy ha hx4 hgap v hr
  have hK : x*a*(y^2+1)≠0 := mul_ne_zero (mul_ne_zero hx ha) hY
  let t : ℂ := v 42/(x*a*(y^2+1))
  have hu : v 42=x*a*(y^2+1)*t := by dsimp [t]; field_simp
  have hw : v 18= -(x^4+(a^2-2)*x^2+1)*t := by
    apply mul_left_cancel₀ hK
    linear_combination hrow-(x^4+(a^2-2)*x^2+1)*hu
  have hlast : v 72= -x*a*(y^2+1)*t := by rw [h72,hu]; ring
  have ht : t≠0 := by
    intro he
    apply hvn
    apply hinj
    · simpa [he] using hw
    · simpa [he] using hu
    · simpa [he] using hlast
  exact ⟨t,ht,hw,hu,hlast⟩

theorem first_two_zero (x y z a b : ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (ha : a≠0)
    (hx4 : x^4≠1) (hY : y^2+1≠0) (hgap : a= -x-1/x ∨ x^2+a*x+1≠0)
    (v : Fin 114→ℂ) (hvn : v≠0)
    (hv : symbolicRows (-1) 1 x y z a b v=0) :
    poly1 (b*y) (a*x) z (y^2) (x^2)=0 ∧ poly2 (b*y) (a*x) z (y^2) (x^2)=0 := by
  obtain ⟨t,ht,hw,hu,hl⟩ := normalized_leading_vector2 x y z a b hx hy hz ha hx4 hY hgap v hvn hv
  obtain ⟨hr,_⟩ := actual_symbolic_kernel_reduce2 x y z a b hx hy hz ha v hv
  constructor
  · have h := leading_row1 x y z a b t hx hy ha v hw hu hl
    have hh : residualRows2 x y z a b v 8=0 := congrFun hr 8
    rw [hh,mul_zero] at h
    exact (mul_eq_zero.mp ((mul_eq_zero.mp h.symm).resolve_right ht)).resolve_left (by norm_num : (-1:ℂ)≠0)
  · have h := leading_row2 x y z a b t hx hy ha v hw hu hl
    have hh : residualRows2 x y z a b v 21=0 := congrFun hr 21
    rw [hh,mul_zero] at h
    exact (mul_eq_zero.mp ((mul_eq_zero.mp h.symm).resolve_right ht)).resolve_left (by norm_num : (1:ℂ)≠0)
#print axioms normalized_leading_vector2
#print axioms first_two_zero
end QuantitativeArithmeticSmallLevelNineteenOppositeCertificates
