/-! ## NineteenZeroFirstJetAnalytic -/
section
set_option autoImplicit false
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteenZeroFirstJet
open Complex Matrix
open QuantitativeArithmeticSmallLevelNineteenGridSystem (primeParameter phaseRoot badNineteen)
open QuantitativeArithmeticSmallLevelNineteenFullSystem
open QuantitativeArithmeticSmallLevelNineteenGridAnalytic
open QuantitativeArithmeticUniversalPoleVector

/-- Apply the actual continued rows and an analytic annihilator before
extracting the first shifted principal part. No order bound at the lower
point is assumed. -/
theorem negative_square_no_leading_vector1 {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε κ : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (hκ : κ=1 ∨ κ=-1) (hphase : phaseRoot m ε=-κ)
    (hbad : badNineteen f=κ*(-1)) (ha : f 2=0)
    (BG : ℝ) (G : ℂ→Fin 114→ℂ)
    (hG : ∀ i s, MeromorphicNFAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (s : ℂ) (v : Fin 114→ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j,
      0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (X : ℝ) (hX : X<0) (h2 : (primeParameter 2 m s)^2=(X:ℂ)) : False := by
  have hx := parameter_ne_zero (by decide : 2≠0) m s
  have hy := parameter_ne_zero (by decide : 3≠0) m s
  have hz := mul_ne_zero (sign_ne_zero hκ) (parameter_ne_zero (by decide : 19≠0) m s)
  have hlead := leading_vector_kernel hm hf ε hlaw BG G hG hGF s v hv hshift
  rw [leadingMatrix_mulVec,actual_leading_rows,hphase,hbad,ha,mul_zero,
    symbolic_rows_normalize κ (-1) _ _ _ _ _ hκ v] at hlead
  have hjet := leading_vector_first_shift hm hf ε hlaw BG G hG hGF
    (weightedMatrix1 m κ ((Real.sqrt 3:ℂ)*f 3))
    (fun t i j => matrix_analytic1 m κ _ t (sign_ne_zero hκ) i j)
    (fun t => matrix_annihilates1 m f ε κ t hκ hphase hbad ha)
    s v hv hshift
  have he := congrFun hjet (0:Fin 1)
  rw [matrix_first_evaluation1 m f ε κ s hκ hphase hbad v] at he
  have hfactor : I*(s-((2*m:ℕ):ℂ))≠0 :=
    mul_ne_zero Complex.I_ne_zero (sub_ne_zero.mpr
      (negative_parameter_square_away_weight m s X hX h2))
  have hu : upper1 (primeParameter 2 m s) (primeParameter 3 m s)
      (κ*primeParameter 19 m s) 0 ((Real.sqrt 3:ℂ)*f 3) v=0 :=
    (mul_eq_zero.mp he).resolve_left hfactor
  have hl := leading_vanish1 _ _ _ 0 ((Real.sqrt 3:ℂ)*f 3) hx hy hz v hlead
  have hout := upper_identity1 _ _ _ 0 ((Real.sqrt 3:ℂ)*f 3) hx hy hz v
  rw [hu,hl,zero_add] at hout
  exact hv.1 (zero_kernel_with_output1 (s-(m:ℂ)) (κ*primeParameter 19 m s)
    ((Real.sqrt 3:ℂ)*f 3) hz X hX h2 v hlead hout.symm)

#print axioms negative_square_no_leading_vector1

/-- Apply the actual continued rows and an analytic annihilator before
extracting the first shifted principal part. No order bound at the lower
point is assumed. -/
theorem negative_square_no_leading_vector3 {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε κ : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (hκ : κ=1 ∨ κ=-1) (hphase : phaseRoot m ε=-κ)
    (hbad : badNineteen f=κ*1) (ha : f 2=0)
    (BG : ℝ) (G : ℂ→Fin 114→ℂ)
    (hG : ∀ i s, MeromorphicNFAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (s : ℂ) (v : Fin 114→ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j,
      0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (X : ℝ) (hX : X<0) (h2 : (primeParameter 2 m s)^2=(X:ℂ)) : False := by
  have hx := parameter_ne_zero (by decide : 2≠0) m s
  have hy := parameter_ne_zero (by decide : 3≠0) m s
  have hz := mul_ne_zero (sign_ne_zero hκ) (parameter_ne_zero (by decide : 19≠0) m s)
  have hlead := leading_vector_kernel hm hf ε hlaw BG G hG hGF s v hv hshift
  rw [leadingMatrix_mulVec,actual_leading_rows,hphase,hbad,ha,mul_zero,
    symbolic_rows_normalize κ 1 _ _ _ _ _ hκ v] at hlead
  have hjet := leading_vector_first_shift hm hf ε hlaw BG G hG hGF
    (weightedMatrix3 m κ ((Real.sqrt 3:ℂ)*f 3))
    (fun t i j => matrix_analytic3 m κ _ t (sign_ne_zero hκ) i j)
    (fun t => matrix_annihilates3 m f ε κ t hκ hphase hbad ha)
    s v hv hshift
  have he := congrFun hjet (0:Fin 1)
  rw [matrix_first_evaluation3 m f ε κ s hκ hphase hbad v] at he
  have hfactor : I*(s-((2*m:ℕ):ℂ))≠0 :=
    mul_ne_zero Complex.I_ne_zero (sub_ne_zero.mpr
      (negative_parameter_square_away_weight m s X hX h2))
  have hu : upper3 (primeParameter 2 m s) (primeParameter 3 m s)
      (κ*primeParameter 19 m s) 0 ((Real.sqrt 3:ℂ)*f 3) v=0 :=
    (mul_eq_zero.mp he).resolve_left hfactor
  have hl := leading_vanish3 _ _ _ 0 ((Real.sqrt 3:ℂ)*f 3) hx hy hz v hlead
  have hout := upper_identity3 _ _ _ 0 ((Real.sqrt 3:ℂ)*f 3) hx hy hz v
  rw [hu,hl,zero_add] at hout
  exact hv.1 (zero_kernel_with_output3 (s-(m:ℂ)) (κ*primeParameter 19 m s)
    ((Real.sqrt 3:ℂ)*f 3) hz X hX h2 v hlead hout.symm)

#print axioms negative_square_no_leading_vector3
