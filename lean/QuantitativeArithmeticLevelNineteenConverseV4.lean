theorem phaseRoot_sign (m : ℕ) {ε : ℂ} (hε : ε=1 ∨ ε= -1) :
    phaseRoot m ε=1 ∨ phaseRoot m ε= -1 := by
  unfold phaseRoot
  rw [pow_mul,I_sq]
  rcases neg_one_pow_eq_or ℂ m with hm|hm <;>
    rcases hε with rfl|rfl <;> simp [hm]

theorem badNineteen_sign {f : ℕ→ℂ} (hf : FinitenessOriginalInput.EulerData 19 f) :
    badNineteen f=1 ∨ badNineteen f= -1 := by
  have h := FinitenessNormalizedTwistProduct.root_unit hf 19
  rw [root_nineteen] at h
  rcases h with h|h
  · right; linear_combination -h
  · left; linear_combination -h

/-- Every original solution has one of the eight genuine nonsingular
114-row specializations. No nonvanishing hypothesis on a good eigenvalue. -/
theorem original_rank_witness {m : ℕ} {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1) :
    ∃ c : Fin 8, ∃ s : ℂ, (leadingMatrix c m f ε s).det≠0 := by
  have hχ := phaseRoot_sign m hε
  have hδ := badNineteen_sign hf.toEulerData
  by_cases ha : (Real.sqrt 2:ℂ)*f 2=0
  · rcases hχ with hχ|hχ <;> rcases hδ with hδ|hδ
    · exact ⟨7,actual_rank7 m f ε hχ hδ ha⟩
    · exact ⟨5,actual_rank5 m f ε hχ hδ ha⟩
    · exact ⟨3,actual_rank3 m f ε hχ hδ ha⟩
    · exact ⟨1,actual_rank1 m f ε hχ hδ ha⟩
  · rcases hχ with hχ|hχ <;> rcases hδ with hδ|hδ
    · exact ⟨6,actual_rank6 m f ε hχ hδ ha⟩
    · exact ⟨4,actual_rank4 m f ε hχ hδ ha⟩
    · exact ⟨2,actual_rank2 m f ε hχ hδ ha⟩
    · exact ⟨0,actual_rank0 m f ε hχ hδ ha⟩

