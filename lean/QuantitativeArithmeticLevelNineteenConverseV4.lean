  push_cast
  rw [pow_add,mul_pow]
  rw [hp (2:ℂ) n t.1,hp (9:ℂ) n t.2.1,hp (9:ℂ) l t.2.1,hp (4:ℂ) l t.2.2.1]
  simp only [mul_pow]
  ring

theorem exponential_identity (n l : ℕ) :
    obstruction ((4:ℂ)^(n+l)) ((9:ℂ)^(n+l)) (-((2:ℂ)^n)*((4:ℂ)^l+1))=
      exponentialSum n l := by
  have hx : (4:ℂ)^(n+l)=((2:ℂ)^n)^2*(4:ℂ)^l := by
    rw [pow_add]
    congr 1
    rw [← pow_mul, Nat.mul_comm n 2, pow_mul]
    norm_num
  rw [hx,expansion_identity]
  unfold evalExpansion exponentialSum
  congr 1
  apply List.map_congr_left
  intro t ht
  exact term_power_identity n l t

