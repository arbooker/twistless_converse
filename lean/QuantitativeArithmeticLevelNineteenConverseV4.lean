/-! ## NineteenCentralYAnalytic -/
section
set_option autoImplicit false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteenCentralY
open Complex Matrix
open QuantitativeArithmeticSmallLevelNineteen
open QuantitativeArithmeticSmallLevelNineteenGridSystem (primeParameter phaseRoot badNineteen phaseRoot_sign badNineteen_sign)
open QuantitativeArithmeticSmallLevelNineteenFullSystem
open QuantitativeArithmeticSmallLevelNineteenGridAnalytic
open QuantitativeArithmeticSmallLevelNineteenZeroFirstJet
open QuantitativeArithmeticUniversalPoleVector

/-- Exclude the central-three exceptional stratum at any rightmost grid
pole above a right-half-plane denominator zero, for every original sign. -/
theorem central_three_no_pole {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε=-1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (G : ℂ→Fin 114→ℂ)
    (hG : ∀ i s, MeromorphicNFAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (s : ℂ) (n : ℕ) (hs : (m:ℝ)≤s.re) (hd : denominator (2*m) f s=0)
    (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) (s+n)<0)
    (hshift : ∀ r : ℕ, 0<r → ∀ j,
      0≤meromorphicOrderAt (fun z => G z j) (s+n+r))
    (hy2 : (primeParameter 3 m (s+(n:ℂ)))^2= -1) : False := by
  obtain ⟨_hn,hgap⟩ := central_three_gap m n f s hs hd hy2
  obtain ⟨v,hv⟩ := exists_leading_vector G (s+n)
    (fun j => (hG j _).meromorphicAt) hpole
  have hlead := leading_vector_kernel hm hf ε hlaw BG G hG hGF (s+n) v hv hshift
  rw [leadingMatrix_mulVec,actual_leading_rows] at hlead
  have hcase (κ δ : ℂ) (hκ : κ=1 ∨ κ=-1)
      (hphase : phaseRoot m ε=-κ) (hbad : badNineteen f=κ*δ)
      (hδ : δ=-1 ∨ δ=1) : False := by
    have h := hlead
    rw [hphase,hbad,symbolic_rows_normalize κ δ _ _ _ _ _ hκ v] at h
    have hz := mul_ne_zero (sign_ne_zero hκ) (parameter_ne_zero (by decide : 19≠0) m (s+n))
    apply hv.1
    rcases hδ with rfl|rfl
    · exact actual_central_y_kernel0 (s+n-(m:ℂ)) (κ*primeParameter 19 m (s+n))
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) hz hy2 hgap v h
    · exact actual_central_y_kernel2 (s+n-(m:ℂ)) (κ*primeParameter 19 m (s+n))
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) hz hy2 hgap v h
  rcases phaseRoot_sign m hε with hp|hp <;>
    rcases badNineteen_sign hf.toEulerData with hb|hb
  · exact hcase (-1) (-1) (Or.inr rfl) (by simpa using hp) (by simpa using hb) (Or.inl rfl)
  · exact hcase (-1) 1 (Or.inr rfl) (by simpa using hp) (by simpa using hb) (Or.inr rfl)
  · exact hcase 1 1 (Or.inl rfl) (by simpa using hp) (by simpa using hb) (Or.inr rfl)
  · exact hcase 1 (-1) (Or.inl rfl) (by simpa using hp) (by simpa using hb) (Or.inl rfl)

#print axioms central_three_no_pole
end QuantitativeArithmeticSmallLevelNineteenCentralY
end
end

/-! ## NineteenRigidity -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section

namespace QuantitativeArithmeticSmallLevelNineteen

open Matrix UpperHalfPlane SmallLevelNormalized Complex Filter Set
open scoped MatrixGroups ModularForm Manifold Topology

def elliptic : SL(2,ℚ) := ⟨!![1,-1/2;38/5,-14/5], by norm_num [det_fin_two]⟩
def ellipticReal : GL (Fin 2) ℝ := SpecialLinearGroup.mapGL ℝ elliptic

theorem elliptic_factor : ellipticReal =
    SpecialLinearGroup.mapGL ℝ A⁻¹ * translation (-2/5) *
      SpecialLinearGroup.mapGL ℝ B⁻¹ * translation (-1/2) := by
  rw [A_inv, B_inv]
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [ellipticReal, elliptic, SmallLevelNormalized.translation, SmallLevelNormalized.matrix, GeneralLinearGroup.mkOfDetNeZero,
      SpecialLinearGroup.toGL, SpecialLinearGroup.map_apply_coe,
      Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two]

/-- Two paired Ramanujan equations transport the two transformation defects
into each other. The algebra requires no division by any eigenvalue. -/
theorem pair_transport (g : ℍ → ℂ) (k : ℤ) (C D R : GL (Fin 2) ℝ)
    (hp : (g ∣[k] C) + ((g ∣[k] D⁻¹) ∣[k] R) = g + (g ∣[k] R)) :
    (g ∣[k] C) - g = ((g ∣[k] D) - g) ∣[k] (D⁻¹ * R) := by
  simp only [SmallLevelEleven.sub_slash, ← SlashAction.slash_mul,
    ← mul_assoc, mul_inv_cancel, one_mul]
  rw [SlashAction.slash_mul]
  linear_combination hp

theorem defect_elliptic_of_five_pair {k : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 k f)
    (hfive : (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] B) +
      ((SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] A⁻¹) ∣[(k:ℤ)] translation (-2/5)) =
      SmallLevelOriginal.fourierFunction k f +
      (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] translation (-2/5))) :
    ((SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] A) -
      SmallLevelOriginal.fourierFunction k f) ∣[(k:ℤ)] ellipticReal =
    (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] A) -
      SmallLevelOriginal.fourierFunction k f := by
  let g := SmallLevelOriginal.fourierFunction k f
  let a := SpecialLinearGroup.mapGL ℝ A
  let b := SpecialLinearGroup.mapGL ℝ B
  have h3 : (g ∣[(k:ℤ)] a) + ((g ∣[(k:ℤ)] b⁻¹) ∣[(k:ℤ)] translation (-1/2)) =
      g + (g ∣[(k:ℤ)] translation (-1/2)) := by
    rw [show b⁻¹=SpecialLinearGroup.mapGL ℝ B⁻¹ from (map_inv _ _).symm]
    exact original_four_reduced hf
  have h6 : (g ∣[(k:ℤ)] b) + ((g ∣[(k:ℤ)] a⁻¹) ∣[(k:ℤ)] translation (-2/5)) =
      g + (g ∣[(k:ℤ)] translation (-2/5)) := by
    rw [show a⁻¹=SpecialLinearGroup.mapGL ℝ A⁻¹ from (map_inv _ _).symm]
    exact hfive
  have ht3 := pair_transport g k a b (translation (-1/2)) h3
  have ht6 := pair_transport g k b a (translation (-2/5)) h6
  have he : ellipticReal = (a⁻¹ * translation (-2/5)) * (b⁻¹ * translation (-1/2)) := by
    simpa only [a, b, map_inv, mul_assoc] using elliptic_factor
  change ((g ∣[(k:ℤ)] a)-g) ∣[(k:ℤ)] ellipticReal = (g ∣[(k:ℤ)] a)-g
  rw [he, SlashAction.slash_mul, ← ht6, ← ht3]

def fixedPoint : ℂ := ⟨1/4, Real.sqrt 19/76⟩

theorem fixedPoint_positive : 0 < fixedPoint.im := by
  change 0 < Real.sqrt 19/76
  positivity

theorem fixedPoint_denom : (38/5:ℂ)*fixedPoint-14/5 ≠ 0 := by
  intro h
  have hh := congrArg Complex.im h
  simp [fixedPoint] at hh

theorem fixedPoint_fixed : (fixedPoint-1/2)/((38/5)*fixedPoint-14/5) = fixedPoint := by
  apply (div_eq_iff fixedPoint_denom).mpr
  have hs : (Real.sqrt 19)^2=19 := Real.sq_sqrt (by norm_num)
  apply Complex.ext <;> simp [fixedPoint, Complex.mul_re, Complex.mul_im] <;> nlinarith

theorem elliptic_defect_zero {F : ℂ → ℂ} {k : ℕ}
    (hF : AnalyticOnNhd ℂ F {z : ℂ | 0<z.im}) (hk : 0<k)
    (he : ∀ z : ℂ, 0<z.im →
      F ((z-1/2)/((38/5)*z-14/5))=((38/5)*z-14/5)^k*F z) :
    ∀ z : ℂ, 0<z.im → F z=0 := by
  have hnon (m : ℤ) : (-9/5:ℚ)≠m := by
    intro hm
    have hh : (5:ℚ)*m = -9 := by rw [← hm]; norm_num
    have hi : (5:ℤ)*m = -9 := by exact_mod_cast hh
    omega
  have heq : ∀ᶠ z in 𝓝 fixedPoint,
      F ((1*z+(-1/2))/((38/5)*z+(-14/5)))=((38/5)*z+(-14/5))^k*F z := by
    filter_upwards [(isOpen_lt continuous_const Complex.continuous_im).mem_nhds fixedPoint_positive] with z hz
    simpa only [one_mul, sub_eq_add_neg, neg_div] using he z hz
  have hh := SmallLevelAnalyticRigidity.rational_trace_eqOn_zero hF
    (convex_halfSpace_im_gt 0).isPreconnected fixedPoint_positive
    (a:=1) (b:= -1/2) (c:=38/5) (d:= -14/5) (t:=(-9/5:ℚ))
    (by norm_num) (by simpa only [sub_eq_add_neg, neg_div] using fixedPoint_denom)
    (by simpa only [one_mul, sub_eq_add_neg, neg_div] using fixedPoint_fixed) hk
    (by norm_num) hnon heq
  exact fun z hz => hh hz

theorem ellipticReal_det : (GeneralLinearGroup.det ellipticReal:ℝ)=1 := by
  simp [ellipticReal]

theorem ellipticReal_denom (z : ℍ) : denom ellipticReal z = (38/5)*(z:ℂ)-14/5 := by
  norm_num [denom, ellipticReal, elliptic, SpecialLinearGroup.toGL,
    SpecialLinearGroup.map_apply_coe]
  ring

theorem ellipticReal_point (z : ℍ) :
    ((ellipticReal • z : ℍ):ℂ)=((z:ℂ)-1/2)/((38/5)*(z:ℂ)-14/5) := by
  rw [coe_smul_of_det_pos (by rw [ellipticReal_det]; norm_num)]
  norm_num [num, denom, ellipticReal, elliptic, SpecialLinearGroup.toGL,
    SpecialLinearGroup.map_apply_coe]
  ring

theorem invariant_zero {k : ℕ} (hk : 0<k) (H : ℍ → ℂ)
    (hhol : MDiff H) (he : H ∣[(k:ℤ)] ellipticReal=H) : H=0 := by
  let F : ℂ → ℂ := H ∘ ofComplex
  have hr (w : ℍ) : H w=F (w:ℂ) := by simp [F]
  have ha : AnalyticOnNhd ℂ F {z : ℂ | 0<z.im} :=
    (UpperHalfPlane.mdifferentiable_iff.mp hhol).analyticOnNhd isOpen_upperHalfPlaneSet
  have htrans (z : ℂ) (hz : 0<z.im) :
      F ((z-1/2)/((38/5)*z-14/5))=((38/5)*z-14/5)^k*F z := by
    let w : ℍ := ⟨z,hz⟩
    have hh := congrFun he w
    rw [ModularForm.slash_apply] at hh
    have hs : σ ellipticReal=ContinuousAlgEquiv.refl ℝ ℂ := by
      simp only [σ, ellipticReal_det]; norm_num
    rw [hs, ellipticReal_det, ellipticReal_denom] at hh
    norm_num only [ContinuousAlgEquiv.refl_apply, abs_one, Complex.ofReal_one,
      _root_.one_zpow, mul_one, _root_.zpow_neg, zpow_natCast] at hh
    rw [hr, hr, ellipticReal_point] at hh
    change F ((z-1/2)/((38/5)*z-14/5))*(((38/5)*z-14/5)^k)⁻¹=F z at hh
    have hd : ((38/5)*z-14/5:ℂ)≠0 := by
      simpa only [ellipticReal_denom] using denom_ne_zero ellipticReal w
    have hx := congrArg (fun v : ℂ => v*((38/5)*z-14/5)^k) hh
    simp only [mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ hd), mul_one] at hx
    simpa only [mul_comm] using hx
  funext z
  rw [hr]
  exact elliptic_defect_zero ha hk htrans z z.im_pos

/-- A fully proved endgame implication. The separated modulus-five pair
is deliberately an explicit hypothesis: its analytic derivation at level19
remains a separate pole-cancellation obligation. -/
theorem A_of_five_pair {k : ℕ} (hk : 0<k) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 k f)
    (hfive : (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] B) +
      ((SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] A⁻¹) ∣[(k:ℤ)] translation (-2/5)) =
      SmallLevelOriginal.fourierFunction k f +
      (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] translation (-2/5))) :
    SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] A =
      SmallLevelOriginal.fourierFunction k f := by
  have hhol := SmallLevelOriginal.fourierFunction_holomorphic hf
  have hd := (hhol.slash (k:ℤ) (SpecialLinearGroup.mapGL ℝ A)).sub hhol
  exact sub_eq_zero.mp (invariant_zero hk _ hd (defect_elliptic_of_five_pair hf hfive))

#print axioms original_four_reduced
#print axioms defect_elliptic_of_five_pair
#print axioms A_of_five_pair
end QuantitativeArithmeticSmallLevelNineteen
end
end

/-! ## NineteenGenerators -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 100000
set_option maxHeartbeats 12000000
@[expose] public section

namespace QuantitativeArithmeticSmallLevelNineteen
open Matrix ModularGroup SmallLevelGenerators
open scoped MatrixGroups

def letter : Fin 11 → SL(2,ℤ)
  | 0 => T
  | 1 => T⁻¹
  | 2 => lower 19
  | 3 => (lower 19)⁻¹
  | 4 => -1
  | 5 => oddMatrix 19 10 (by decide)
  | 6 => (oddMatrix 19 10 (by decide))⁻¹
  | 7 => A
  | 8 => A⁻¹
  | 9 => B
  | 10 => B⁻¹

def word (w : List (Fin 11)) : SL(2,ℤ) := (w.map letter).prod

theorem word_mem (K : Subgroup SL(2,ℤ))
    (hT : T∈K) (hU : lower 19∈K) (hZ : -1∈K)
    (h2 : oddMatrix 19 10 (by decide)∈K) (h3 : A∈K) (h6 : B∈K)
    (w : List (Fin 11)) : word w∈K := by
  have hl (i : Fin 11) : letter i∈K := by
    fin_cases i
    · exact hT
    · exact K.inv_mem hT
    · exact hU
    · exact K.inv_mem hU
    · exact hZ
    · exact h2
    · exact K.inv_mem h2
    · exact h3
    · exact K.inv_mem h3
    · exact h6
    · exact K.inv_mem h6
  exact K.list_prod_mem (fun x hx => by
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
    exact hl i)

def rowClass (c d : ZMod 19) : ℕ :=
  if c=0 then 19 else (d.val * ([0, 1, 10, 13, 5, 4, 16, 11, 12, 17, 2, 7, 8, 3, 15, 14, 6, 9, 18] : List ℕ).getD c.val 0) % 19

def repRow (c d : ZMod 19) : SL(2,ℤ) :=
  match rowClass c d with
  | 0 => ⟨!![0,-1;1,0], by decide⟩
  | 1 => ⟨!![0,-1;1,1], by decide⟩
  | 2 => ⟨!![0,-1;1,2], by decide⟩
  | 3 => ⟨!![0,-1;1,3], by decide⟩
  | 4 => ⟨!![0,-1;1,4], by decide⟩
  | 5 => ⟨!![-1,1;3,-4], by decide⟩
  | 6 => ⟨!![-1,0;3,-1], by decide⟩
  | 7 => ⟨!![1,1;-3,-2], by decide⟩
  | 8 => ⟨!![-1,1;2,-3], by decide⟩
  | 9 => ⟨!![-1,0;2,-1], by decide⟩
  | 10 => ⟨!![-1,0;-2,-1], by decide⟩
  | 11 => ⟨!![-1,-1;-2,-3], by decide⟩
  | 12 => ⟨!![-1,1;-3,2], by decide⟩
  | 13 => ⟨!![-1,0;-3,-1], by decide⟩
  | 14 => ⟨!![-1,0;4,-1], by decide⟩
  | 15 => ⟨!![0,-1;1,-4], by decide⟩
  | 16 => ⟨!![0,-1;1,-3], by decide⟩
  | 17 => ⟨!![0,-1;1,-2], by decide⟩
  | 18 => ⟨!![0,-1;1,-1], by decide⟩
  | _ => 1

def edgeSRow (c d : ZMod 19) : List (Fin 11) :=
  match rowClass c d with
  | 0 => [4]
  | 1 => [1]
  | 5 => [4, 9]
  | 6 => [4]
  | 7 => [4]
  | 9 => [4]
  | 10 => [4]
  | 12 => [4]
  | 13 => [4]
  | 14 => [4]
  | 15 => [10]
  | 18 => [0, 4]
  | _ => []

def edgeTRow (c d : ZMod 19) : List (Fin 11) :=
  match rowClass c d with
  | 19 => [0]
  | 4 => [4, 7, 10]
  | 6 => [4]
  | 7 => [9, 8, 6, 0]
  | 9 => [1, 4]
  | 11 => [5, 3, 10, 7, 4]
  | 13 => [8]
  | 14 => [9]
  | _ => []

def rep (g : SL(2,ZMod 19)) : SL(2,ℤ) := repRow (g.1 1 0) (g.1 1 1)

theorem row_nonzero (g : SL(2,ZMod 19)) : g.1 1 0≠0 ∨ g.1 1 1≠0 := by
  by_contra h
  push Not at h
  have hd := g.det_coe
  rw [det_fin_two, h.1, h.2] at hd
  norm_num at hd
  exact (by decide : (0:ZMod 19)≠1) hd

theorem edgeSRow_checked : ∀ c d : ZMod 19, c≠0 ∨ d≠0 →
    repRow c d*S*(repRow d (-c))⁻¹=word (edgeSRow c d) := by decide

theorem edgeTRow_checked : ∀ c d : ZMod 19, c≠0 ∨ d≠0 →
    repRow c d*T*(repRow c (c+d))⁻¹=word (edgeTRow c d) := by decide

theorem edgeS_checked (g : SL(2,ZMod 19)) :
    rep g*S*(rep (g*reduction 19 S))⁻¹=word (edgeSRow (g.1 1 0) (g.1 1 1)) := by
  have hs : rep (g*reduction 19 S)=repRow (g.1 1 1) (-(g.1 1 0)) := by
    have hS : reduction 19 S=(⟨!![0,-1;1,0],by decide⟩ : SL(2,ZMod 19)) := by decide
    simp [rep, hS, Matrix.mul_apply, Fin.sum_univ_two]
  rw [hs]
  exact edgeSRow_checked _ _ (row_nonzero g)

theorem edgeT_checked (g : SL(2,ZMod 19)) :
    rep g*T*(rep (g*reduction 19 T))⁻¹=word (edgeTRow (g.1 1 0) (g.1 1 1)) := by
  have ht : rep (g*reduction 19 T)=repRow (g.1 1 0) (g.1 1 0+g.1 1 1) := by
    have hT : reduction 19 T=(⟨!![1,1;0,1],by decide⟩ : SL(2,ZMod 19)) := by decide
    simp [rep, hT, Matrix.mul_apply, Fin.sum_univ_two]
  rw [ht]
  exact edgeTRow_checked _ _ (row_nonzero g)

theorem rep_one : rep 1=1 := by decide

theorem rep_upper (g : SL(2,ZMod 19)) (hg : g.1 1 0=0) : rep g=1 := by
  have h : ∀ d : ZMod 19, repRow 0 d=1 := by decide
  simpa only [rep, hg] using h (g.1 1 1)

theorem gamma0_mem (K : Subgroup SL(2,ℤ))
    (hT : T∈K) (hU : lower 19∈K) (hZ : -1∈K)
    (h2 : oddMatrix 19 10 (by decide)∈K) (h3 : A∈K) (h6 : B∈K)
    (γ : SL(2,ℤ)) (hγ : γ∈CongruenceSubgroup.Gamma0 19) : γ∈K := by
  apply transversal_mem (reduction 19) rep K
  · intro g
    rw [edgeS_checked]
    exact word_mem K hT hU hZ h2 h3 h6 _
  · intro g
    rw [edgeT_checked]
    exact word_mem K hT hU hZ h2 h3 h6 _
  · exact rep_one
  · apply rep_upper
    exact CongruenceSubgroup.Gamma0_mem.mp hγ

#print axioms edgeS_checked
#print axioms edgeT_checked
#print axioms gamma0_mem

end QuantitativeArithmeticSmallLevelNineteen
end
