theorem parameter_ne_zero {p : ℕ} (hp : p≠0) (m : ℕ) (s : ℂ) :
    primeParameter p m s≠0 :=
  Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))

theorem parameter_analytic {p : ℕ} (hp : p≠0) (m : ℕ) (h s : ℂ) :
    AnalyticAt ℂ (fun t => primeParameter p m (t+h)) s := by
  have hpC : (p:ℂ)≠0 := by exact_mod_cast hp
  simp only [primeParameter,Complex.cpow_def_of_ne_zero hpC]
  fun_prop

theorem parameter_add_one_div {p : ℕ} (hp : p≠0) (m : ℕ) (s : ℂ) :
    primeParameter p m (s+1)/(p:ℂ)=primeParameter p m s := by
  simpa only [add_sub_cancel_right] using (primeParameter_shift hp m (s+1)).symm

theorem sign_ne_zero {κ : ℂ} (hκ : κ=1 ∨ κ=-1) : κ≠0 := by
  rcases hκ with rfl | rfl <;> norm_num

theorem symbolic_rows_normalize (κ δ x y z a b : ℂ) (hκ : κ=1 ∨ κ=-1)
    (v : Fin 114→ℂ) :
    symbolicRows (-κ) (κ*δ) x y z a b v=symbolicRows (-1) δ x y (κ*z) a b v := by
  rcases hκ with rfl | rfl
  · simp only [one_mul]
  · simpa only [neg_one_mul,neg_neg] using (symbolic_rows_flip (-1) δ x y (-z) a b v)

theorem first_rows_normalize (κ δ x y z : ℂ) (hκ : κ=1 ∨ κ=-1)
    (v : Fin 114→ℂ) :
    firstRows (-κ) (κ*δ) x y z v=firstRows (-1) δ x y (κ*z) v := by
  rcases hκ with rfl | rfl
  · simp only [one_mul]
  · simpa only [neg_one_mul,neg_neg] using (first_rows_flip (-1) δ x y (-z) v)

