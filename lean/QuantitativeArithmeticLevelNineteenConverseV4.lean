/-! ## NineteenZeroPoleAlgebra -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteenZeroPoleAlgebra
open Complex QuantitativeArithmeticPrimePowerTorsion

/-- The scalar identity in the zero-eigenvalue first-Taylor certificate is
incompatible with a negative real power of two. The identity itself must
still be obtained from the actual Taylor rows before applying this lemma. -/
theorem first_jet_scalar_impossible (u : ℂ) (X : ℝ) (hX : X<0)
    (h2 : (2:ℂ)^u=(X:ℂ))
    (hpoly : 3*((2:ℂ)^u)^3+12*((2:ℂ)^u)^2+
      (2:ℂ)^u*(3:ℂ)^u-18*(2:ℂ)^u-4*(3:ℂ)^u=0) : False := by
  rw [h2] at hpoly
  have he : ((X:ℂ)-4)*(3:ℂ)^u=
      ((-3*X^3-12*X^2+18*X:ℝ):ℂ) := by
    push_cast
    linear_combination hpoly
  have hi := congrArg Complex.im he
  have hpowers (n : ℕ) : ((X:ℂ)^n).im=0 := by
    rw [← Complex.ofReal_pow]
    rfl
  have him : (X-4)*((3:ℂ)^u).im=0 := by
    norm_num [Complex.mul_im,Complex.sub_re,Complex.sub_im,hpowers] at hi
    exact mul_eq_zero.mpr hi
  have hY : ((3:ℂ)^u).im=0 :=
    (mul_eq_zero.mp him).resolve_left (by linarith : X-4≠0)
  exact negative_prime_cpow_excludes_real (by decide : Nat.Prime 2)
    (by decide : Nat.Prime 3) (by decide : 2≠3) u X hX h2 hY

/-- The central negative square cannot coexist with torsion at the other prime. -/
theorem negative_square_excludes_other_torsion (u : ℂ)
    (h2 : ((2:ℂ)^u)^2 = -1) (t : ℕ) (ht : 0<t)
    (h3 : ((3:ℂ)^u)^t=1) : False := by
  have h24 : ((2:ℂ)^u)^4=1 := by
    calc
      ((2:ℂ)^u)^4 = (((2:ℂ)^u)^2)^2 := by ring
      _ = 1 := by rw [h2]; norm_num
  have hu := distinct_primes_cpow_torsion (by decide : Nat.Prime 2)
    (by decide : Nat.Prime 3) (by decide : 2≠3) u 4 t (by decide) ht h24 h3
  rw [hu] at h2
  norm_num at h2

/-- The central scalar polynomial gives torsion and hence a contradiction.
Its derivation from the specialized leading rows is a separate obligation. -/
theorem central_scalar_impossible (u : ℂ) (h2 : ((2:ℂ)^u)^2 = -1)
    (hpoly : (((3:ℂ)^u)^2-1)*((((3:ℂ)^u)^2)^2+1)=0) : False := by
  have h38 : ((3:ℂ)^u)^8=1 := by
    rcases mul_eq_zero.mp hpoly with h | h
    · have h32 : ((3:ℂ)^u)^2=1 := sub_eq_zero.mp h
      calc
        ((3:ℂ)^u)^8 = (((3:ℂ)^u)^2)^4 := by ring
        _ = 1 := by rw [h32]; norm_num
    · have h34 : ((3:ℂ)^u)^4 = -1 := by linear_combination h
      calc
        ((3:ℂ)^u)^8 = (((3:ℂ)^u)^4)^2 := by ring
        _ = 1 := by rw [h34]; norm_num
  exact negative_square_excludes_other_torsion u h2 8 (by decide) h38

#print axioms first_jet_scalar_impossible
#print axioms negative_square_excludes_other_torsion
#print axioms central_scalar_impossible
end QuantitativeArithmeticSmallLevelNineteenZeroPoleAlgebra
end
end

