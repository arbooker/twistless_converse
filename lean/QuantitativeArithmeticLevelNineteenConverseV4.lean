  have hy := parameter_ne_zero (by decide : 3≠0) m (s+n)
  have ha : (Real.sqrt 2:ℂ)*f 2≠0 := mul_ne_zero
    (by exact_mod_cast Real.sqrt_ne_zero'.mpr (by norm_num : (0:ℝ)<2)) hf2
  have hu := unit_of_parameters_ne_zero _ _ _ hx hy ha hx4 hY hGfactor
  obtain ⟨hX,hA⟩ := constraints_force _ _ _ _ _ h1 h2 h3 h4 h5 hu
  apply denominator_gap_excludes_four m n f s hd
  · simpa only [primeParameter,poleCoordinate,Nat.cast_ofNat] using hX
  · rw [poleParameter_sqrt]
    simpa only [primeParameter,poleCoordinate,Nat.cast_ofNat] using hA

#print axioms opposite_sign_generic_no_pole
end QuantitativeArithmeticSmallLevelNineteenOppositeCertificates
