  · apply QuantitativeArithmeticSmallLevelNineteenRealTop.real_top_no_pole hm hf hf2 ε hε hlaw BG G hG hGF s n hs hd hpole hshift
    simpa only [Nat.cast_mul,Nat.cast_ofNat] using htop
  by_cases hg : (primeParameter 2 m (s+n))^2-2*((Real.sqrt 2:ℂ)*f 2*primeParameter 2 m (s+n))+4=0
  · exact QuantitativeArithmeticSmallLevelNineteenGZero.gzero_no_pole hm hf hf2 ε hε hlaw BG G hG hGF s n hs hd hpole hshift hg
  have hcase (κ δ : ℂ) (hκ : κ=1 ∨ κ=-1)
      (hphase : phaseRoot m ε=-κ) (hbad : badNineteen f=κ*δ)
      (hδ : δ=-1 ∨ δ=1) : False := by
    rcases hδ with rfl|rfl
    · exact QuantitativeArithmeticSmallLevelNineteenGenericCertificates.equal_sign_generic_no_pole
        hm hf hf2 ε κ hlaw hκ hphase hbad BG G hG hGF s n hs hd hpole hshift hx4 hY htop
    · exact QuantitativeArithmeticSmallLevelNineteenOppositeCertificates.opposite_sign_generic_no_pole
        hm hf hf2 ε κ hlaw hκ hphase hbad BG G hG hGF s n hs hd hpole hshift hx4 hY hg htop
  rcases phaseRoot_sign m hε with hp|hp <;>
    rcases badNineteen_sign hf.toEulerData with hb|hb
  · exact hcase (-1) (-1) (Or.inr rfl) (by simpa using hp) (by simpa using hb) (Or.inl rfl)
  · exact hcase (-1) 1 (Or.inr rfl) (by simpa using hp) (by simpa using hb) (Or.inr rfl)
  · exact hcase 1 1 (Or.inl rfl) (by simpa using hp) (by simpa using hb) (Or.inr rfl)
  · exact hcase 1 (-1) (Or.inl rfl) (by simpa using hp) (by simpa using hb) (Or.inl rfl)
#print axioms rightmost_nonzero_no_pole
end QuantitativeArithmeticSmallLevelNineteen
