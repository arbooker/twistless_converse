/-- The full734-row system continues as germs of the same grid continuation. -/
theorem original_continued_rows {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (G : ℂ→Fin 114→ℂ)
    (hG : ∀ i s, MeromorphicAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s) :
    ∃ (B : ℝ) (H : ℕ→ℂ→Fin 734→ℂ),
      (∀ (n : ℕ) i s, B-((n:ℝ)+1)<s.re → AnalyticAt ℂ (fun z => H n z i) s) ∧
      ∀ (n : ℕ) i x, B-((n:ℝ)+1)<x.re →
        (fun z => ∑ j, leadingMatrix m f ε z i j*G z j)=ᶠ[𝓝[≠] x]
          (fun z => H n z i+∑ a∈Finset.range n,
            ∑ j, shiftMatrix m f ε a z i j*G (z+((a:ℂ)+1)) j) := by
  obtain ⟨BF,H,_hF,hH,hrow⟩ := original_matrix_system hm hf ε hlaw
  let B := max BF BG
  have hBF : BF≤B := le_max_left _ _
  have hBG : BG≤B := le_max_right _ _
  have hH' : ∀ (n : ℕ) i s, B-((n:ℝ)+1)<s.re →
      AnalyticAt ℂ (fun z => H n z i) s := by
    intro n i s hs
    apply hH n i s
    linarith
  refine ⟨B,H,hH',?_⟩
  intro n i x hx
  exact QuantitativeArithmeticRectangularContinuation.continued_meromorphic_rows B
    (gridVector (2*m) f) G (leadingMatrix m f ε) (shiftMatrix m f ε) H
    hG (fun s hs => hGF s (lt_of_le_of_lt hBG hs))
    (leadingMatrix_analytic m f ε) (shiftMatrix_analytic m f ε)
    (fun n i s hs => (hH' n i s hs).meromorphicAt)
    (fun n s hs => hrow n s (lt_of_le_of_lt hBF hs)) n i x hx

/-- All734 rows constrain the same universal principal-part vector. -/
theorem leading_vector_kernel {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (G : ℂ→Fin 114→ℂ)
    (hG : ∀ i s, MeromorphicNFAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (x : ℂ) (v : Fin 114→ℂ) (hv : IsLeadingVector G x v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j,
      0≤meromorphicOrderAt (fun z => G z j) (x+n)) :
    leadingMatrix m f ε x *ᵥ v=0 := by
  obtain ⟨B,H,hH,hrows⟩ := original_continued_rows hm hf ε hlaw BG G
    (fun i s => (hG i s).meromorphicAt) hGF
  funext i
  change ∑ j, leadingMatrix m f ε x i j*v j=0
  exact hv.taylor hG hshift B
    (fun z j => leadingMatrix m f ε z i j)
    (fun n z j => shiftMatrix m f ε n z i j) (fun n z => H n z i)
    (fun j => leadingMatrix_analytic m f ε x i j)
    (fun n j => shiftMatrix_analytic m f ε n x i j)
    (fun n z hz => hH n i z hz) (fun n hn => hrows n i x hn)

theorem rightmost_pole_common_kernel {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (G : ℂ→Fin 114→ℂ)
    (hG : ∀ i s, MeromorphicNFAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (x : ℂ) (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) x<0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j,
      0≤meromorphicOrderAt (fun z => G z j) (x+n)) :
    ∃ v : Fin 114→ℂ, IsLeadingVector G x v ∧
      leadingMatrix m f ε x *ᵥ v=0 := by
  obtain ⟨v,hv⟩ := exists_leading_vector G x
    (fun i => (hG i x).meromorphicAt) hpole
  exact ⟨v,hv,leading_vector_kernel hm hf ε hlaw BG G hG hGF x v hv hshift⟩

/-- Polynomial row syzygies may be applied before extracting the principal
part at the upper point, without any pole-order assumption at the lower point.
The syzygy identity is a separate exact algebraic certificate. -/
theorem leading_vector_first_shift {ρ : Type*} {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (G : ℂ→Fin 114→ℂ)
    (hG : ∀ i s, MeromorphicNFAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (L : ℂ→Matrix ρ (Fin 734) ℂ)
    (hL : ∀ x r i, AnalyticAt ℂ (fun z => L z r i) x)
    (hLA : ∀ z, L z*leadingMatrix m f ε z=0)
    (x : ℂ) (v : Fin 114→ℂ) (hv : IsLeadingVector G x v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j,
      0≤meromorphicOrderAt (fun z => G z j) (x+n)) :
    (L (x-1)*shiftMatrix m f ε 0 (x-1)) *ᵥ v=0 := by
  obtain ⟨B,H,hH,hrows⟩ := original_continued_rows hm hf ε hlaw BG G
    (fun i s => (hG i s).meromorphicAt) hGF
  exact hv.first_shift B G (leadingMatrix m f ε) (shiftMatrix m f ε) H L
    hG (shiftMatrix_analytic m f ε) hH hL hLA hrows x v hshift

#print axioms original_continued_rows
#print axioms leading_vector_kernel
#print axioms rightmost_pole_common_kernel
#print axioms leading_vector_first_shift
end QuantitativeArithmeticSmallLevelNineteenFullSystem
