theorem contracted_scalar1 (x y z a b c : ℂ) (hx : x≠0) (hy : y≠0)
    (hc : c≠0) (v : Fin 114→ℂ)
    (h18 : v 18=c*(1-x^2)) (h42 : v 42=0) (h84 : v 84=c*(y^2+1))
    (hout : output1 x y z a b v=0) :
    3*x^6+12*x^4+x^2*y^2-18*x^2-4*y^2=0 := by
  have he : output1 x y z a b v =
      (-(361:ℂ)/(6*x^2*y^2))*((3*x^6+12*x^4+x^2*y^2-18*x^2-4*y^2)*c) := by
    unfold output1
    rw [h18,h42,h84]
    field_simp [hx,hy]
    <;> ring1
  have hn : -(361:ℂ)/(6*x^2*y^2)≠0 :=
    div_ne_zero (by norm_num) (mul_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero _ hx)) (pow_ne_zero _ hy))
  exact (mul_eq_zero.mp ((mul_eq_zero.mp (he.symm.trans hout)).resolve_left hn)).resolve_right hc

/-- Once the weighted analytic first-shift relation supplies `hout`, the
noncentral zero-eigenvalue scalar obstruction is impossible. -/
