    (h1 : poly1 B A Z Y X=0)
    (h2 : poly2 B A Z Y X=0)
    (h3 : poly3 B A Z Y X=0)
    (h4 : poly4 B A Z Y X=0)
    (h6 : poly6 B A Z Y X=0)
    (h9 : poly9 B A Z Y X=0)
    (h10 : poly10 B A Z Y X=0)
    (h15 : poly15 B A Z Y X=0)
    (h18 : poly18 B A Z Y X=0)
    (h19 : poly19 B A Z Y X=0)
    (hX : X≠1) (hY : Y+1≠0) : X=4 ∧ A=-3 := by
  have hi := inputs_zero B A Z Y X h1 h2 h3 h4 h6 h9 h10 h15 h18 h19
  have ht0 := of_bounded_certificate B A Z Y X inputs hi certificate0 target0 certificate0_checked
  rw [target0_eval] at ht0
  have he0 := (mul_eq_zero.mp ht0).resolve_left denominator0_ne_zero
  have ht1 := of_bounded_certificate B A Z Y X inputs hi certificate1 target1 certificate1_checked
