/-! ## NineteenModularCriterion -/
section
set_option autoImplicit false
@[expose] public noncomputable section

namespace QuantitativeArithmeticSmallLevelNineteen
open Matrix ModularGroup SmallLevelGenerators SmallLevelOriginal SmallLevelNormalized
open scoped MatrixGroups ModularForm

/-- The separated quadratic-residue pair at modulus five. Establishing this
identity from the original Euler input is the remaining analytic obligation;
this definition is not an assertion of that obligation. -/
def FivePair (k : ℕ) (f : ℕ → ℂ) : Prop :=
  (fourierFunction k f ∣[(k:ℤ)] B) +
    ((fourierFunction k f ∣[(k:ℤ)] A⁻¹) ∣[(k:ℤ)] translation (-2/5)) =
  fourierFunction k f + (fourierFunction k f ∣[(k:ℤ)] translation (-2/5))

theorem B_of_five_pair {k : ℕ} (hk : 0<k) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 k f) (hfive : FivePair k f) :
    fourierFunction k f ∣[(k:ℤ)] B=fourierFunction k f := by
  have ha := A_of_five_pair hk hf hfive
  have hi := congrArg (fun F : UpperHalfPlane → ℂ => F ∣[(k:ℤ)] A⁻¹) ha
  simp only [← SlashAction.slash_mul, mul_inv_cancel, SlashAction.slash_one] at hi
  change (fourierFunction k f ∣[(k:ℤ)] B) +
    ((fourierFunction k f ∣[(k:ℤ)] A⁻¹) ∣[(k:ℤ)] translation (-2/5)) = _ at hfive
  rw [← hi] at hfive
  exact add_right_cancel hfive

theorem gamma_zero_of_five_pair (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (hfive : FivePair (2*m) f)
    (γ : SL(2,ℤ)) (hγ : γ∈CongruenceSubgroup.Gamma0 19) :
    fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] γ=fourierFunction (2*m) f := by
  let K := slashStabilizer ((2*m:ℕ):ℤ) (fourierFunction (2*m) f)
  have ht : T∈K := original_T (2*m) f
  have hu : lower 19∈K := original_lower (by decide) hf
  have hz : -1∈K := SmallLevelThirtySix.slash_neg_one_even _ m
  change γ∈K
  exact gamma0_mem K ht hu hz
    (original_odd (by decide) (by decide : 2*10=19+1) (by decide) hf)
    (A_of_five_pair (by omega) hf hfive) (B_of_five_pair (by omega) hf hfive) γ hγ

/-- Checked level19 endgame, conditional on the explicit separated modulus-five
pair. No assertion is made here that the original input already supplies it. -/
theorem modular_of_five_pair {k : ℕ} (hk : 0<k) (heven : Even k) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 k f) (hfive : FivePair k f) :
    IsModular 19 k f := by
  obtain ⟨m,hm⟩ := heven
  have hkm : k=2*m := by omega
  rw [hkm] at hf hfive ⊢
  exact modular_of_transformations (by decide) hf
    (gamma_zero_of_five_pair m (by omega) hf hfive)

#print axioms B_of_five_pair
#print axioms gamma_zero_of_five_pair
#print axioms modular_of_five_pair
end QuantitativeArithmeticSmallLevelNineteen
end
end

/-! ## NineteenChiFivePairBridge -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteenChiFive
open Complex Matrix UpperHalfPlane SmallLevelNormalized
open QuantitativeArithmeticSmallLevelNineteen
open QuantitativeArithmeticQuadraticFive (quadraticFourier twist_five)
open FinitenessOriginalFourier FinitenessFourierConstruction FinitenessAnalyticReconstruction
open scoped MatrixGroups ModularForm

/-- The original Ramanujan5 law and quadratic5 law separate into the first
actual even-pair Fricke laws, with the same original sign. -/
theorem first_pair_law {k : ℕ} {f : ℕ → ℂ} (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 k f ε)
    (hquad : ∀ z : ℂ, 0<z.im → quadraticFourier k f z=
      (ε*Complex.I^k)/(((Real.sqrt 475:ℂ)*z)^k)*quadraticFourier k f (-1/((475:ℂ)*z))) :
    ∀ z : ℂ, 0<z.im →
      fourier (fullCoefficients f k) (z+1/5)+fourier (fullCoefficients f k) (z-1/5)=
        (ε*Complex.I^k)/(((Real.sqrt 475:ℂ)*z)^k)*
          (fourier (fullCoefficients f k) (-1/((475:ℂ)*z)+1/5)+
            fourier (fullCoefficients f k) (-1/((475:ℂ)*z)-1/5)) := by
  intro z hz
  have hr := hlaw 5 (by decide) z hz
  rw [show Nat.lcm 19 (5^2)=475 by decide,root_five,one_mul,
    twist_five _ (periodic _),twist_five _ (periodic _)] at hr
  have hc := hquad z hz
  norm_num only [quadraticFourier,Complex.ofReal_div,Complex.ofReal_neg,
    Complex.ofReal_ofNat,Complex.ofReal_one] at hc
  norm_num only [Nat.cast_ofNat] at hr
  simp only [sub_eq_add_neg] at hr hc ⊢
  linear_combination (hr+hc)/2

/-- The first separated quadratic relation in normalized slash notation. -/
theorem first_pair_slash {k : ℕ} {f : ℕ → ℂ} (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 k f ε)
    (hquad : ∀ z : ℂ, 0<z.im → quadraticFourier k f z=
      (ε*Complex.I^k)/(((Real.sqrt 475:ℂ)*z)^k)*quadraticFourier k f (-1/((475:ℂ)*z))) :
    (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)]
      ((fricke 19 (by decide))⁻¹*translation (1/5)*fricke 475 (by decide)))+
    (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)]
      ((fricke 19 (by decide))⁻¹*translation (-1/5)*fricke 475 (by decide)))=
    (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] translation (1/5))+
    (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] translation (-1/5)) := by
  have h := pair_of_fricke 19 475 k (by decide) (by decide) (1/5)
    (fourier (fullCoefficients f k)) (ε*Complex.I^k) 1 (Or.inl rfl)
    (by
      intro z hz
      simpa [FinitenessNormalizedTwistProduct.root,twist,Finset.sum_range_succ] using
        hlaw 1 (by decide) z hz)
    (by
      simpa only [one_mul,Complex.ofReal_div,Complex.ofReal_ofNat,Complex.ofReal_one,Nat.cast_ofNat] using
        first_pair_law ε hlaw hquad)
  have hfun : (fun z : ℍ => fourier (fullCoefficients f k) z)=SmallLevelOriginal.fourierFunction k f := by
    funext z
    rfl
  rw [hfun] at h
  simpa only [one_smul,neg_div] using h

theorem sqrt_conductor_five : Real.sqrt 475 = 5 * Real.sqrt 19 := by
  rw [show (475:ℝ)=25*19 by norm_num, Real.sqrt_mul (by norm_num)]
  norm_num

theorem five_positive : fricke 19 (by decide) * SpecialLinearGroup.mapGL ℝ B *
    translation (1/5) = translation (1/5) * fricke 475 (by decide) := by
  have ht : (Real.sqrt 19)^2=19 := Real.sq_sqrt (by norm_num)
  have hn : Real.sqrt 19≠0 := (Real.sqrt_pos.mpr (by norm_num)).ne'
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [fricke, B, translation, matrix, GeneralLinearGroup.mkOfDetNeZero,
      SpecialLinearGroup.toGL, SpecialLinearGroup.map_apply_coe,
      Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two, sqrt_conductor_five] <;>
    field_simp [hn] <;> norm_num [ht]

theorem five_negative : fricke 19 (by decide) * SpecialLinearGroup.mapGL ℝ A⁻¹ *
    translation (-(1/5)) = translation (-(1/5)) * fricke 475 (by decide) := by
  rw [A_inv]
  have ht : (Real.sqrt 19)^2=19 := Real.sq_sqrt (by norm_num)
  have hn : Real.sqrt 19≠0 := (Real.sqrt_pos.mpr (by norm_num)).ne'
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [fricke, translation, matrix, GeneralLinearGroup.mkOfDetNeZero,
      SpecialLinearGroup.toGL, SpecialLinearGroup.map_apply_coe,
      Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two, sqrt_conductor_five] <;>
    field_simp [hn] <;> norm_num [ht]

theorem five_pair_of_quadratic_fricke {k : ℕ} {f : ℕ → ℂ} (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 k f ε)
    (hquad : ∀ z : ℂ, 0<z.im → quadraticFourier k f z=
      (ε*Complex.I^k)/(((Real.sqrt 475:ℂ)*z)^k)*quadraticFourier k f (-1/((475:ℂ)*z))) :
    FivePair k f := by
  have h := first_pair_slash ε hlaw hquad
  have hp : (fricke 19 (by decide))⁻¹ * translation (1/5) * fricke 475 (by decide) =
      SpecialLinearGroup.mapGL ℝ B * translation (1/5) := by
    rw [mul_assoc, ← five_positive]
    group
  have hn : (fricke 19 (by decide))⁻¹ * translation (-(1/5)) * fricke 475 (by decide) =
      SpecialLinearGroup.mapGL ℝ A⁻¹ * translation (-(1/5)) := by
    rw [mul_assoc, ← five_negative]
    group
  simp only [neg_div] at h hn
  rw [hp, hn] at h
  have hh := congrArg (fun F : ℍ → ℂ => F ∣[(k:ℤ)] translation (-(1/5))) h
  simp only [SlashAction.add_slash, ← SlashAction.slash_mul, mul_assoc, translation_mul] at hh
  norm_num only [show (1/5:ℝ)+ -(1/5)=0 by ring,
    show (-(1/5):ℝ)+ -(1/5)= -2/5 by ring] at hh
  have ht : translation 0 = 1 := by
    apply Units.ext
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [translation, matrix, GeneralLinearGroup.mkOfDetNeZero]
  change (SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] SpecialLinearGroup.mapGL ℝ B) +
    ((SmallLevelOriginal.fourierFunction k f ∣[(k:ℤ)] SpecialLinearGroup.mapGL ℝ A⁻¹) ∣[(k:ℤ)] translation (-2/5)) = _
  simpa only [ht, mul_one, SlashAction.slash_one, SlashAction.slash_mul, neg_div] using hh

#print axioms five_pair_of_quadratic_fricke
end QuantitativeArithmeticSmallLevelNineteenChiFive
end
