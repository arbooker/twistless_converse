    have h2 : ((2:ℂ)^s)^2= -1 := eq_neg_of_add_eq_zero_left h
    apply hx4
    calc
      ((2:ℂ)^s)^4 = (((2:ℂ)^s)^2)^2 := by ring
      _ = 1 := by rw [h2]; norm_num
  have hx4p : ((2:ℂ)^s)^4+1≠0 := by
    intro h
    have h4 : ((2:ℂ)^s)^4= -1 := eq_neg_of_add_eq_zero_left h
    apply ht 8 (by decide)
    calc
      ((2:ℂ)^s)^8 = (((2:ℂ)^s)^4)^2 := by ring
      _ = 1 := by rw [h4]; norm_num
  refine ⟨hxp,hx4,hx4p,?_⟩
  intro ha
  have hx : (2:ℂ)^s≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  rw [ha] at hgap
  apply hxp
  linear_combination (norm := (field_simp [hx]; ring1)) ((2:ℂ)^s)*hgap

/-- Actual leading-row exclusion of the central-three stratum. -/
theorem actual_central_y_kernel0 (s z a b : ℂ) (hz : z≠0)
    (hy2 : ((3:ℂ)^s)^2= -1) (hgap : a= -(2:ℂ)^s-1/(2:ℂ)^s)
    (v : Fin 114→ℂ)
    (hv : symbolicRows (-1) (-1) ((2:ℂ)^s) ((3:ℂ)^s) z a b v=0) : v=0 := by
  have hx : (2:ℂ)^s≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hy : (3:ℂ)^s≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  obtain ⟨hxp,hxm,hxplus,ha⟩ := physical_parameters s a hy2 hgap
  obtain ⟨hr,hinj⟩ := actual_symbolic_kernel_reduce0 _ _ z a b hx hy hz ha v hv
  have h0 : residualRows0 ((2:ℂ)^s) ((3:ℂ)^s) z a b v 0=0 := congrFun hr 0
  have h10 : residualRows0 ((2:ℂ)^s) ((3:ℂ)^s) z a b v 10=0 := congrFun hr 10
  have h13 : residualRows0 ((2:ℂ)^s) ((3:ℂ)^s) z a b v 13=0 := congrFun hr 13
  have h19 : residualRows0 ((2:ℂ)^s) ((3:ℂ)^s) z a b v 19=0 := congrFun hr 19
  obtain ⟨h18,h42,h72⟩ := central_y_reduced _ _ z a b hx hy hxp hxm hxplus hgap hy2 v
    h0 h10 h13 h19
  exact hinj h18 h42 h72

#print axioms actual_central_y_kernel0
/-- Actual leading-row exclusion of the central-three stratum. -/
theorem actual_central_y_kernel2 (s z a b : ℂ) (hz : z≠0)
    (hy2 : ((3:ℂ)^s)^2= -1) (hgap : a= -(2:ℂ)^s-1/(2:ℂ)^s)
    (v : Fin 114→ℂ)
    (hv : symbolicRows (-1) 1 ((2:ℂ)^s) ((3:ℂ)^s) z a b v=0) : v=0 := by
  have hx : (2:ℂ)^s≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hy : (3:ℂ)^s≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  obtain ⟨hxp,hxm,hxplus,ha⟩ := physical_parameters s a hy2 hgap
  obtain ⟨hr,hinj⟩ := actual_symbolic_kernel_reduce2 _ _ z a b hx hy hz ha v hv
  have h0 := congrFun hr (0:Fin 27)
  have h10 := congrFun hr (10:Fin 27)
  have h13 := congrFun hr (13:Fin 27)
  have h19 := congrFun hr (19:Fin 27)
  obtain ⟨h18,h42,h72⟩ := central_y_reduced2 _ _ z a b hx hy hxp hxm hxplus hgap hy2 v
    h0 h10 h13 h19
  exact hinj h18 h42 h72

#print axioms actual_central_y_kernel2
end QuantitativeArithmeticSmallLevelNineteenCentralY
end
