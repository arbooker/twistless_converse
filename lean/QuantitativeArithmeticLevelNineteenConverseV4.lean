/-- Distinct exponential bases cannot cancel identically. Only finitely
many integer evaluations are required, and no giant explicit inverse is used. -/
theorem finite_power_witness {n : ℕ} (r c : Fin n → ℂ)
    (hr : Function.Injective r) (j : Fin n) (hc : c j≠0) :
    ∃ m : Fin n, (∑ i : Fin n, c i*r i^(m:ℕ))≠0 := by
  by_contra h
  push Not at h
  have hz := Matrix.eq_zero_of_forall_pow_sum_mul_pow_eq_zero hr h
  exact hc (congrFun hz j)

