theorem prime_at_weight (p m : ℕ) :
    primeParameter p m (2*(m:ℂ))=(p:ℂ)^m := by
  unfold primeParameter
  rw [show 2*(m:ℂ)-(m:ℂ)=(m:ℂ) by ring,Complex.cpow_natCast]

theorem real_top_gap (m n : ℕ) (f : ℕ→ℂ) (s : ℂ)
    (hs : (m:ℝ)≤s.re) (hd : denominator (2*m) f s=0)
    (htop : s+(n:ℂ)=2*(m:ℂ)) :
    n≤m ∧ poleParameter f*primeParameter 2 m (s+(n:ℂ))=
      -((2:ℂ)^n)*((4:ℂ)^(m-n)+1) := by
  have hre := congrArg Complex.re htop
  simp only [add_re,natCast_re,mul_re,natCast_im,mul_zero,sub_zero] at hre
  norm_num at hre
  have hn : n≤m := by
    have h : (n:ℝ)≤(m:ℝ) := by linarith
    exact_mod_cast h
  have hfour : ((2:ℂ)^(m-n))^2=(4:ℂ)^(m-n) := by
    rw [← pow_mul,Nat.mul_comm (m-n) 2,pow_mul]
    norm_num
  have hpow : ((2:ℂ)^m)^2=(2:ℂ)^n*((2:ℂ)^n*(4:ℂ)^(m-n)) := by
    calc
      ((2:ℂ)^m)^2=((2:ℂ)^n*(2:ℂ)^(m-n))^2 := by
        rw [← pow_add,Nat.add_sub_of_le hn]
      _=_ := by rw [mul_pow,hfour]; ring
  have hg := denominator_zero_gap m n f s hd
  change poleParameter f*primeParameter 2 m (s+(n:ℂ))=
    -(primeParameter 2 m (s+(n:ℂ)))^2/(2:ℂ)^n-(2:ℂ)^n at hg
  rw [htop,prime_at_weight] at hg
  refine ⟨hn,?_⟩
  rw [htop,prime_at_weight,hg]
  norm_num only [Nat.cast_ofNat]
  rw [hpow]
  have hn0 : (2:ℂ)^n≠0 := pow_ne_zero _ (by norm_num)
  field_simp [hn0]
  ring

theorem real_top_squares (m n : ℕ) (s : ℂ) (hn : n≤m)
    (htop : s+(n:ℂ)=2*(m:ℂ)) :
    (primeParameter 2 m (s+(n:ℂ)))^2=(4:ℂ)^(n+(m-n)) ∧
    (primeParameter 3 m (s+(n:ℂ)))^2=(9:ℂ)^(n+(m-n)) := by
  rw [htop,prime_at_weight,prime_at_weight,Nat.add_sub_of_le hn]
  constructor
  · rw [← pow_mul,Nat.mul_comm m 2,pow_mul]; norm_num
  · rw [← pow_mul,Nat.mul_comm m 2,pow_mul]; norm_num

theorem real_top_nondegenerate (m n : ℕ) (hm : 0<m) (s : ℂ)
    (htop : s+(n:ℂ)=2*(m:ℂ)) :
    (primeParameter 2 m (s+(n:ℂ)))^4≠1 ∧
    (primeParameter 3 m (s+(n:ℂ)))^2+1≠0 := by
  rw [htop,prime_at_weight,prime_at_weight]
  constructor
  · intro h
    have hr : ((2:ℝ)^m)^4=1 := by exact_mod_cast h
    have htwo : 1<(2:ℝ)^m := one_lt_pow₀ (by norm_num) (Nat.ne_of_gt hm)
    have hfour : 1<((2:ℝ)^m)^4 := one_lt_pow₀ htwo (by decide)
    linarith
  · intro h
    have hr : ((3:ℝ)^m)^2+1=0 := by exact_mod_cast h
    nlinarith [sq_nonneg ((3:ℝ)^m)]

#print axioms real_top_gap
#print axioms real_top_squares
#print axioms real_top_nondegenerate
end QuantitativeArithmeticSmallLevelNineteenRealTop
