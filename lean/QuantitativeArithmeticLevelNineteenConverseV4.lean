    (hG : ∀ i s, MeromorphicNFAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (s : ℂ) (n : ℕ) (hs : (m:ℝ)≤s.re) (hd : denominator (2*m) f s=0)
    (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) (s+n)<0)
    (hshift : ∀ r : ℕ, 0<r → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n+r))
