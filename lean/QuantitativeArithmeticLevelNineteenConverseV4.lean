/-- The cubic obtained from the leading rows has no unit-circle root. -/
theorem cubic_not_unit (Y : ℂ) (hunit : ‖Y‖=1)
    (hp : 4*Y^3+7*Y^2+1=0) : False := by
  have hY : Y≠0 := by intro h; simp [h] at hunit
  have hprod : Y*conj Y=1 := by
    rw [Complex.mul_conj]
    simp [Complex.normSq_eq_norm_sq,hunit]
  have hc : conj Y=1/Y := (eq_div_iff hY).mpr (by simpa only [mul_comm] using hprod)
  have h := congrArg (fun z : ℂ => conj z) hp
  simp only [map_add,map_mul,map_pow,map_ofNat,map_one,map_zero,hc] at h
  have hq : Y^3+7*Y+4=0 := by
    linear_combination (norm := (field_simp [hY]; ring1)) Y^3*h
  have hfalse : (1:ℂ)=0 := by
    linear_combination ((7:ℂ)*Y^2/132-7*Y/264+25/66)*hp+
      (-(7:ℂ)*Y^2/33-35*Y/132+41/264)*hq
  norm_num at hfalse

/-- Five rows suffice; a Groebner or minor computation is unnecessary.
The common sign class enters only through the harmless constant C. -/
theorem five_rows_zero (Y B Z C w u v : ℂ) (hY : Y≠0) (hY1 : Y+1≠0)
    (hunit : ‖Y‖=1)
    (h0 : (2*Y+2)*w-2*u+2*v=0)
    (h4 : (-6*B*Y-4*B-16*Y+4*Z+C)*w+
      (3*B^2+13*B+Y-17)*u+(3*B^2+13*B+5*Y+37)*v=0)
    (h16 : (-6*B*Y-4*B-16*Y+4*Z+C)*w+
      (3*B^2+13*B-Y-17)*u+(3*B^2+13*B+3*Y+37)*v=0)
    (h7 : (2*B*Y+8*Y-2*Z+(2-C)/2)*w+
      (-B^2-7*B+Y+7)*u+(-B^2-7*B-Y-19)*v=0)
    (h8 : (-2*Y^2+2*Y+2)*w+(B*Y-4*B+Y-5)*u+(B*Y-2*B+Y-1)*v=0) :
    w=0 ∧ u=0 ∧ v=0 := by
  have huv : u+v=0 := by
    have h : Y*(u+v)=0 := by linear_combination (h4-h16)/2
    exact (mul_eq_zero.mp h).resolve_left hY
  have hv : v= -u := by linear_combination huv
  have hwu : (Y+1)*w=2*u := by linear_combination h0/2-huv
  by_cases hu : u=0
  · have hw : w=0 := by
      rw [hu,mul_zero] at hwu
      exact (mul_eq_zero.mp hwu).resolve_left hY1
    exact ⟨hw,hu,by simpa [hu] using hv⟩
  have hp4 : (6*B*Y+4*B+2*Y^2+45*Y+27-C-4*Z)*u=0 := by
    linear_combination (Y+1)*h4/(-2)+
      (-6*B*Y-4*B-16*Y+4*Z+C)/2*hwu+
      (Y+1)*(3*B^2+13*B+5*Y+37)/2*huv
  have hp7 : (2*B*Y+Y^2+22*Y+(28-C)/2-2*Z)*u=0 := by
    linear_combination (Y+1)*h7/2-
      (2*B*Y+8*Y-2*Z+(2-C)/2)/2*hwu-
      (Y+1)*(-B^2-7*B-Y-19)/2*huv
  have hp8 : (B*(Y+1)+2*Y^2)*u=0 := by
    linear_combination -(Y+1)*h8/2+
      (-2*Y^2+2*Y+2)/2*hwu+(Y+1)*(B*Y-2*B+Y-1)/2*huv
  have he1 : 2*B*Y+4*B+Y-1=0 := by
    have h : (2*B*Y+4*B+Y-1)*u=0 := by linear_combination hp4-2*hp7
    exact (mul_eq_zero.mp h).resolve_right hu
  have he2 : B*(Y+1)+2*Y^2=0 := (mul_eq_zero.mp hp8).resolve_right hu
  have hc : 4*Y^3+7*Y^2+1=0 := by
    linear_combination 2*(Y+2)*he2-(Y+1)*he1
  exact (cubic_not_unit Y hunit hc).elim

