    (hX : X=4) (hA : A=-3) (hgap : A= -X/(L:ℂ)-(L:ℂ)) : False := by
  rw [hX,hA] at hgap
  have hc : (3:ℂ)=(4:ℂ)/(L:ℂ)+(L:ℂ) := by linear_combination -hgap
  have hr : (3:ℝ)=4/L+L := by exact_mod_cast hc
  field_simp [ne_of_gt hL] at hr
  nlinarith [sq_nonneg (L-2)]

