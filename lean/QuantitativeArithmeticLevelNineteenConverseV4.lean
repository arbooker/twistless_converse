/-- A negative square at two makes the corresponding square at three nonreal. -/
theorem negative_square_three (s : ℂ) (X : ℝ) (hX : X<0)
    (h2 : ((2:ℂ)^s)^2=(X:ℂ)) : ((3:ℂ)^s)^2+1≠0 := by
