/-- The two opposite-sign constraints follow from the original leading equations. -/
theorem original_first_two {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (hf2 : f 2≠0)
    (ε κ : ℂ) (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (hκ : κ=1 ∨ κ=-1) (hphase : phaseRoot m ε=-κ) (hbad : badNineteen f=κ*1)
    (BG : ℝ) (G : ℂ→Fin 114→ℂ)
    (hG : ∀ i s, MeromorphicNFAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (s : ℂ) (n : ℕ) (hs : (m:ℝ)≤s.re) (hd : denominator (2*m) f s=0)
    (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) (s+n)<0)
    (hshift : ∀ r : ℕ, 0<r → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n+r))
    (hx4 : (primeParameter 2 m (s+n))^4≠1)
    (hY : (primeParameter 3 m (s+n))^2+1≠0) :
    poly1 (((Real.sqrt 3:ℂ)*f 3)*primeParameter 3 m (s+n))
      (((Real.sqrt 2:ℂ)*f 2)*primeParameter 2 m (s+n)) (κ*primeParameter 19 m (s+n))
      ((primeParameter 3 m (s+n))^2) ((primeParameter 2 m (s+n))^2)=0 ∧
    poly2 (((Real.sqrt 3:ℂ)*f 3)*primeParameter 3 m (s+n))
      (((Real.sqrt 2:ℂ)*f 2)*primeParameter 2 m (s+n)) (κ*primeParameter 19 m (s+n))
      ((primeParameter 3 m (s+n))^2) ((primeParameter 2 m (s+n))^2)=0 := by
  have hx := parameter_ne_zero (by decide : 2≠0) m (s+n)
  have hy := parameter_ne_zero (by decide : 3≠0) m (s+n)
  have hz := mul_ne_zero (sign_ne_zero hκ) (parameter_ne_zero (by decide : 19≠0) m (s+n))
  have ha : (Real.sqrt 2:ℂ)*f 2≠0 := mul_ne_zero
    (by exact_mod_cast Real.sqrt_ne_zero'.mpr (by norm_num : (0:ℝ)<2)) hf2
  have hdich := QuantitativeArithmeticSmallLevelNineteenPoleLeading.denominator_gap_dichotomy m n f s hs hd
  rw [poleParameter_sqrt] at hdich
  obtain ⟨v,hv⟩ := exists_leading_vector G (s+n) (fun j => (hG j _).meromorphicAt) hpole
  have hlead := leading_vector_kernel hm hf ε hlaw BG G hG hGF (s+n) v hv hshift
  rw [leadingMatrix_mulVec,actual_leading_rows,hphase,hbad,
    symbolic_rows_normalize κ 1 _ _ _ _ _ hκ v] at hlead
  exact first_two_zero _ _ _ _ _ hx hy hz ha hx4 hY hdich v hv.1 hlead

#print axioms original_first_two
