def evalTerm (u v w : ℂ) (t : ℕ×ℕ×ℕ×ℤ) : ℂ :=
  (t.2.2.2:ℂ)*u^t.1*v^t.2.1*w^t.2.2.1

def evalExpansion (u v w : ℂ) : ℂ := (expansionTerms.map (evalTerm u v w)).sum

theorem expansion_identity (u v w : ℂ) :
    obstruction (u^2*w) v (-u*(w+1))=evalExpansion u v w := by
  simp only [obstruction,evalExpansion,expansionTerms,evalTerm,
    List.map_cons,List.map_nil,List.sum_cons,List.sum_nil,
    Int.cast_neg,Int.cast_ofNat,Int.cast_one]
  ring

