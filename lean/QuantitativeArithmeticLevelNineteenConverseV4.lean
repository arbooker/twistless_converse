def termValue (n l : ℕ) (t : ℕ×ℕ×ℤ) : ℝ := (t.2.2:ℝ)*(t.1:ℝ)^n*(t.2.1:ℝ)^l

def realExponentialSum (n l : ℕ) : ℝ :=
  (expansionTerms.map (fun t => (t.2.2.2:ℝ)*(termAlpha t:ℝ)^n*(termBeta t:ℝ)^l)).sum

theorem realExponentialSum_cast (n l : ℕ) :
    (realExponentialSum n l:ℂ)=exponentialSum n l := by
  have h (ts : List (ℕ×ℕ×ℕ×ℤ)) :
      (((ts.map (fun t => (t.2.2.2:ℝ)*(termAlpha t:ℝ)^n*(termBeta t:ℝ)^l)).sum:ℝ):ℂ)=
        (ts.map (fun t => (t.2.2.2:ℂ)*(termAlpha t:ℂ)^n*(termBeta t:ℂ)^l)).sum := by
    induction ts with
    | nil => simp
    | cons t ts ih =>
      simp only [List.map_cons,List.sum_cons,Complex.ofReal_add,ih]
      push_cast
      rfl
  exact h expansionTerms

theorem table_evaluation (n l : ℕ) :
    (tableTriples.map (termValue n l)).sum=weightedTable n l := by
  unfold tableTriples
  rw [sum_filter_zero _ _ _ (by
    intro t ht hz
    have hc : t.2.2=0 := by simpa using hz
    simp [termValue,hc])]
  rw [sum_flatMap_map]
  simp only [List.map_map,Function.comp_def]
  have ha : shiftedRows.length=alphaBases.length := by rw [rows_length]; decide
  rw [sum_zip_range shiftedRows alphaBases ha
    (fun row a => ((row.zip betaBases).map (fun cb => termValue n l (a,cb.2,cb.1))).sum) [] 1]
  unfold weightedTable
  rw [rows_length]
  apply sum_congr rfl
  intro i hi
  have hi' : i<shiftedRows.length := by rw [rows_length]; exact mem_range.mp hi
  have hr : (shiftedRows[i]?.getD []).length=58 := by
    rw [List.getElem?_eq_getElem hi',Option.getD_some]
    exact rows_width _ (List.getElem_mem hi')
  have hb : betaBases.length=58 := by decide
  rw [sum_zip_range _ betaBases (hr.trans hb.symm)
    (fun c b => termValue n l (alphaBases[i]?.getD 1,b,c)) 0 1,hr]
  apply sum_congr rfl
  intro j hj
  rfl

theorem expansion_evaluation (n l : ℕ) :
    (expansionTriples.map (termValue n l)).sum=realExponentialSum (n+2) (l+2) := by
  unfold expansionTriples realExponentialSum
  simp only [List.map_map,Function.comp_def]
  congr 1
  apply List.map_congr_left
  intro t ht
  change (((t.2.2.2*(termAlpha t:ℤ)^2*(termBeta t:ℤ)^2:ℤ):ℝ)*(termAlpha t:ℝ)^n*(termBeta t:ℝ)^l) = _
  push_cast
  simp only [pow_add]
  ring

/-- The entire interior of the exponent lattice is excluded by the
actual polynomial expansion and its checked negative Abel table. -/
theorem interior_exponential_negative (n l : ℕ) : realExponentialSum (n+2) (l+2)<0 := by
  rw [← expansion_evaluation,← table_terms_eq,table_evaluation]
  exact weightedTable_negative n l

theorem interior_exponential_ne_zero (n l : ℕ) : exponentialSum (n+2) (l+2)≠0 := by
  rw [← realExponentialSum_cast]
  exact Complex.ofReal_ne_zero.mpr (ne_of_lt (interior_exponential_negative n l))

#print axioms table_evaluation
#print axioms interior_exponential_ne_zero
end QuantitativeArithmeticSmallLevelNineteenRealTopCertificate
