    (hX : X<0) (h2 : ((2:ℂ)^s)^2=(X:ℂ)) (hc : c≠0)
    (v : Fin 114→ℂ) (h18 : v 18=c*(1-((2:ℂ)^s)^2))
    (h42 : v 42=0) (h84 : v 84=c*(((3:ℂ)^s)^2+1))
    (hout : output1 ((2:ℂ)^s) ((3:ℂ)^s) z a b v=0) : False := by
  have hx : (2:ℂ)^s≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hy : (3:ℂ)^s≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hp := contracted_scalar1 ((2:ℂ)^s) ((3:ℂ)^s) z a b c hx hy hc v h18 h42 h84 hout
