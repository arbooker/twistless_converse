    QuantitativeArithmeticEntireQuotient.nonzero_germ _
      (fun s => (denom0_7_entire a b).analyticAt s) (denom0_7_witness a b) 0
  have h8 : ∀ᶠ s in 𝓝[≠] (0:ℂ), denom0_8 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 :=
    QuantitativeArithmeticEntireQuotient.nonzero_germ _
      (fun s => (denom0_8_entire a b).analyticAt s) (denom0_8_witness a b) 0
  have hh : ∀ᶠ s in 𝓝[≠] (0:ℂ), denom0_0 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 ∧ denom0_1 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 ∧ denom0_2 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 ∧ denom0_3 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 ∧ denom0_4 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 ∧ denom0_5 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 ∧ denom0_6 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 ∧ denom0_7 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 ∧ denom0_8 ((2:ℂ)^s) ((3:ℂ)^s) ((19:ℂ)^s) a b≠0 := by
    filter_upwards [h0,h1,h2,h3,h4,h5,h6,h7,h8] with s hh0 hh1 hh2 hh3 hh4 hh5 hh6 hh7 hh8
    exact ⟨hh0,hh1,hh2,hh3,hh4,hh5,hh6,hh7,hh8⟩
