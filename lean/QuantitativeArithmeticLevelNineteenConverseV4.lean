theorem obstruction_zero (X Y A B : ℂ) (hY : Y+1≠0)
    (hfirst : firstPoly X Y A B=0) (hsecond : secondPoly X Y A B=0) :
    obstruction X Y A=0 := by
  have hres : (lin X Y A)^2*tail X Y A-lin X Y A*constant X Y A*middle X Y A+
      (constant X Y A)^2*quad X Y A=0 := by
    unfold firstPoly at hfirst
    unfold secondPoly at hsecond
    linear_combination (lin X Y A)^2*hsecond -
      (quad X Y A*(lin X Y A*B-constant X Y A)+lin X Y A*middle X Y A)*hfirst
  rw [resultant_identity] at hres
  exact (mul_eq_zero.mp hres).resolve_left (neg_ne_zero.mpr hY)

