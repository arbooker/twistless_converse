/-- Any entire continuation of the quadratic-five combination automatically
has finite order and the reflection law with the given original coherent sign. -/
theorem quadratic_entire_laws {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε=-1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BE : ℝ) (E : ℂ→ℂ) (hE : ∀ s, AnalyticAt ℂ E s)
    (hEF : ∀ s, BE<s.re → E s=quadraticCombination (2*m) f s) :
    ∃ (B : ℝ) (G : ℂ→ℂ), Differentiable ℂ G ∧ FinitenessOriginalInput.FiniteOrder G ∧
      (∀ s, B<s.re → G s=quadraticCombination (2*m) f s) ∧
      ∀ s, G s=ε*(475:ℂ)^((m:ℂ)-s)*G (((2*m:ℕ):ℂ)-s) := by
  obtain ⟨B,G,hG,hGF,_hregular,hgerm⟩ := original_quadratic_continuation m hm hf
  have hent : Differentiable ℂ G := by
    intro s
    apply AnalyticAt.differentiableAt
    exact SmallLevelSimplePoleTaylor.analyticAt_of_model
      (quadraticCombination (2*m) f) G E E B BE (s.re-1) s hG hGF
      (fun z _ => (hE z).meromorphicAt) hEF (by linarith) (hE s) Filter.EventuallyEq.rfl
  have hfinite := uniform_finiteOrder hm hf hent B hGF
  obtain ⟨hc,hr⟩ := coherent_unscaled_reflections m hm hf ε hε hlaw
  have hn := numerator_reflection m f ε hc hr
  have hε0 : ε≠0 := by rcases hε with rfl|rfl <;> norm_num
  have he := QuantitativeArithmeticQuadraticTwistReflection.normal_form_reflection
    (fun s => numerator m f s/denominator (2*m) f s) G
    (reflectionMultiplier (2*m) ε) (((2*m:ℕ):ℂ)) hG
    (fun s => (reflectionMultiplier_entire (2*m) ε).analyticAt s)
    (reflectionMultiplier_ne_zero (2*m) hε0) hgerm
    (raw_quotient_reflection m f ε hn)
  refine ⟨B,G,hent,hfinite,hGF,?_⟩
  simpa only [reflectionMultiplier_even] using he

/-- The general level19 analytic endgame: entireness of the derived
quadratic-five combination suffices for modularity, with no additional growth
or twist functional-equation assumptions. -/
theorem modular_of_quadratic_entire {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f)
    (BE : ℝ) (E : ℂ→ℂ) (hE : ∀ s, AnalyticAt ℂ E s)
    (hEF : ∀ s, BE<s.re → E s=quadraticCombination (2*m) f s) :
    SmallLevelOriginal.IsModular 19 (2*m) f := by
  obtain ⟨ε,hε,hlaw⟩ := QuantitativeArithmeticCoherentTaylor.original_coherent_law
    (by decide : 0<19) hf
  obtain ⟨B,G,hent,hfinite,hGF,hFE⟩ := quadratic_entire_laws hm hf ε hε hlaw BE E hE hEF
  obtain ⟨σ,_hσ,hgrowth⟩ := hf.growth
  have hquad := QuantitativeArithmeticQuadraticTwistInversion.four_translate_fricke
    (N:=475) (k:=2*m) (by decide) hf.zero hgrowth (1/5) (-1/5) (2/5) (-2/5)
    G hent hfinite (B:=B) (by
      intro s hs
      rw [hGF s hs]
      unfold quadraticCombination evenOne evenTwo
      ring) (ε:=ε) (by rcases hε with rfl|rfl <;> norm_num) (by
      have he : ((2*m:ℕ):ℂ)/2=(m:ℂ) := by push_cast; ring
      simpa only [Nat.cast_ofNat,he] using hFE)
  have hquad' : ∀ z : ℂ, 0<z.im → QuantitativeArithmeticQuadraticFive.quadraticFourier (2*m) f z=
      (ε*I^(2*m))/(((Real.sqrt 475:ℂ)*z)^(2*m))*
        QuantitativeArithmeticQuadraticFive.quadraticFourier (2*m) f (-1/((475:ℂ)*z)) := by
    intro z hz
    have h := hquad z hz
    dsimp only at h
    simpa only [QuantitativeArithmeticQuadraticFive.quadraticFourier,sub_sub,Nat.cast_ofNat] using h
  apply modular_of_five_pair (by omega) (even_two_mul m) hf
  exact QuantitativeArithmeticSmallLevelNineteenChiFive.five_pair_of_quadratic_fricke ε hlaw hquad'

