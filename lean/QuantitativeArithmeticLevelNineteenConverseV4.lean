def unit (X Y A : ℂ) : ℂ := X*Y*A*(Y+1)*(X^2-1)*(X-2*A+4)

theorem inputs_zero (B A Z Y X : ℂ)
    (h1 : poly1 B A Z Y X=0) (h2 : poly2 B A Z Y X=0)
    (h3 : poly3 B A Z Y X=0) (h4 : poly4 B A Z Y X=0)
    (h5 : poly5 B A Z Y X=0) : ∀ i, eval B A Z Y X (inputs i)=0 := by
  intro i
  rcases i with _ | i
  · simp only [inputs,input0_match,h1,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input1_match,h2,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input2_match,h3,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input3_match,h4,mul_zero]
  rcases i with _ | i
  · simp only [inputs,input4_match,h5,mul_zero]
  rfl

theorem target0_eval (B A Z Y X : ℂ) :
    eval B A Z Y X target0=(denominator0:ℂ)*((X-4)*unit X Y A) := by
  norm_num [target0,denominator0,
    QuantitativeArithmeticSmallLevelNineteenOppositeFinalCertificateCompute.target0,
    QuantitativeArithmeticSmallLevelNineteenOppositeFinalCertificateCompute.denominator0,eval,monomial,unit] <;> ring

theorem target1_eval (B A Z Y X : ℂ) :
    eval B A Z Y X target1=(denominator1:ℂ)*((A+3)*unit X Y A) := by
  norm_num [target1,denominator1,
    QuantitativeArithmeticSmallLevelNineteenOppositeFinalCertificateCompute.target1,
    QuantitativeArithmeticSmallLevelNineteenOppositeFinalCertificateCompute.denominator1,eval,monomial,unit] <;> ring

theorem denominator0_ne_zero : (denominator0:ℂ)≠0 := by
  norm_num [denominator0, QuantitativeArithmeticSmallLevelNineteenOppositeFinalCertificateCompute.denominator0]
theorem denominator1_ne_zero : (denominator1:ℂ)≠0 := by
  norm_num [denominator1, QuantitativeArithmeticSmallLevelNineteenOppositeFinalCertificateCompute.denominator1]

theorem constraints_force (B A Z Y X : ℂ)
    (h1 : poly1 B A Z Y X=0) (h2 : poly2 B A Z Y X=0)
    (h3 : poly3 B A Z Y X=0) (h4 : poly4 B A Z Y X=0)
    (h5 : poly5 B A Z Y X=0) (hU : unit X Y A≠0) : X=4 ∧ A=-3 := by
  have hi := inputs_zero B A Z Y X h1 h2 h3 h4 h5
  have ht0 := of_bounded_certificate B A Z Y X inputs hi certificate0 target0 certificate0_checked
  rw [target0_eval] at ht0
  have hx := (mul_eq_zero.mp ((mul_eq_zero.mp ht0).resolve_left denominator0_ne_zero)).resolve_right hU
