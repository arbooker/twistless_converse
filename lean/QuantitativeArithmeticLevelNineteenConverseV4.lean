theorem norm_one_of_fourth (x : ℂ) (hx : x^4=1) : ‖x‖=1 := by
  have h : ‖x‖^4=1 := by simpa only [norm_pow, norm_one] using congrArg norm hx
  exact (pow_eq_one_iff_of_nonneg (norm_nonneg x) (by decide : (4:ℕ)≠0)).mp h

theorem central_two_gap (m n : ℕ) (f : ℕ→ℂ) (s : ℂ)
    (hf2 : f 2≠0) (hs : (m:ℝ)≤s.re) (hd : denominator (2*m) f s=0)
    (hx4 : (primeParameter 2 m (s+(n:ℂ)))^4=1) :
    n=0 ∧ (primeParameter 2 m (s+(n:ℂ)))^2=1 ∧
      (Real.sqrt 2:ℂ)*f 2= -2*primeParameter 2 m (s+(n:ℂ)) := by
  have hn := unit_parameter_gap_zero (by decide : 1<2) m n s hs
    (norm_one_of_fourth _ hx4)
  subst n
  simp only [Nat.cast_zero,add_zero] at hx4 ⊢
  have hx : primeParameter 2 m s≠0 := poleCoordinate_ne_zero m s
  have ha : (Real.sqrt 2:ℂ)*f 2≠0 := mul_ne_zero
    (by exact_mod_cast Real.sqrt_ne_zero'.mpr (by norm_num : (0:ℝ)<2)) hf2
  have hq := denominator_zero_quadratic m f s hd
  rw [poleParameter_sqrt] at hq
  change (primeParameter 2 m s)^2+((Real.sqrt 2:ℂ)*f 2)*primeParameter 2 m s+1=0 at hq
  have hprod : ((primeParameter 2 m s)^2-1)*((primeParameter 2 m s)^2+1)=0 := by
    linear_combination hx4
  have hx2 : (primeParameter 2 m s)^2=1 := by
    rcases mul_eq_zero.mp hprod with h|h
    · exact sub_eq_zero.mp h
    · exfalso
      apply (mul_ne_zero ha hx)
      linear_combination hq-h
  refine ⟨trivial,hx2,?_⟩
  apply mul_right_cancel₀ hx
  linear_combination hq+hx2

theorem central_two_three_parameters (s : ℂ) (hx4 : ((2:ℂ)^s)^4=1) :
    ((3:ℂ)^s)^2+1≠0 ∧ ‖((3:ℂ)^s)^2‖=1 := by
  have hnorm := norm_one_of_fourth _ hx4
  have hre : s.re=0 := by
    have hn : ‖(2:ℂ)^s‖=(2:ℝ)^s.re := by
      simpa only [Complex.ofReal_ofNat] using
        Complex.norm_cpow_eq_rpow_re_of_pos (by norm_num : (0:ℝ)<2) s
    rw [hn] at hnorm
    exact (Real.rpow_right_inj (by norm_num : (0:ℝ)<2) (by norm_num : (2:ℝ)≠1)).mp
      (by simpa only [Real.rpow_zero] using hnorm)
  constructor
  · intro h
    have hy2 : ((3:ℂ)^s)^2= -1 := eq_neg_of_add_eq_zero_left h
    have hy4 : ((3:ℂ)^s)^4=1 := by
      calc
        ((3:ℂ)^s)^4=(((3:ℂ)^s)^2)^2 := by ring
        _=1 := by rw [hy2]; norm_num
    have hs := distinct_primes_cpow_torsion (by decide : Nat.Prime 2)
      (by decide : Nat.Prime 3) (by decide : 2≠3) s 4 4 (by decide) (by decide) hx4 hy4
    rw [hs] at hy2
    norm_num at hy2
  · have hn : ‖(3:ℂ)^s‖=(3:ℝ)^s.re := by
      simpa only [Complex.ofReal_ofNat] using
        Complex.norm_cpow_eq_rpow_re_of_pos (by norm_num : (0:ℝ)<3) s
    rw [norm_pow,hn,hre]
    norm_num

