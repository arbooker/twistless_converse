/-! ## NineteenPartnerModels -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteenPartnerModels
open Complex Set Filter MeasureTheory SmallLevelTaylor SmallLevelAdditive QuantitativeArithmeticSmallLevelNineteenGridAnalytic
open FinitenessOriginalFourier FinitenessFourierConstruction

/-- A meromorphic partner grid gives meromorphic half-plane models of the actual additive twist. -/
theorem original_partner_models {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (G : ℂ → Fin 114 → ℂ)
    (hG : ∀ i s, MeromorphicAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (r : ℝ) (hr : r≠0) (t : ℤ) (hpartner : -1/(19*r)=(t:ℝ)/114) :
    ∃ (B : ℝ) (H : ℕ → ℂ → ℂ),
      (∀ (n : ℕ) s, B-(n:ℝ)<s.re → MeromorphicAt (H n) s) ∧
      (∀ (n : ℕ) s, B<s.re → H n s=original (2*m) f r s) ∧
      ∀ (M : ℕ) s, B-(M:ℝ)<s.re →
        (∀ n : ℕ, AnalyticAt ℂ (fun z => G z (gridIndex t)) (s+n)) → AnalyticAt ℂ (H M) s := by
  obtain ⟨τ,_hτ,hgrowth⟩ := hf.growth
  have hF : ∀ z : ℂ, 0<z.im → fourier (fullCoefficients f (2*m)) z=
      (ε*I^(2*m))/(((Real.sqrt 19:ℂ)*z)^(2*m))*
        fourier (fullCoefficients f (2*m)) (-1/((19:ℂ)*z)) := by
    intro z hz
    simpa [FinitenessNormalizedTwistProduct.root,FinitenessAnalyticReconstruction.twist,
      Finset.sum_range_succ] using hlaw 1 (by decide) z hz
  obtain ⟨B,hB⟩ := normalized_taylor_mellin_rows (by norm_num : (0:ℝ)<19) hr
    (2*m) (even_two_mul m) (polynomial_bound hf.zero hgrowth (2*m))
    (fullCoefficients_zero hf.zero (2*m)) (ε*I^(2*m)) hF
  let V : ℕ → ℂ → ℂ := fun M s => ∑ n∈Finset.range M,
    (I*(19:ℂ)*(r:ℂ))^n*Ring.choose (s+(n:ℂ)-((2*m:ℕ):ℂ)) n*G (s+n) (gridIndex t)
  let P : ℂ → ℂ := fun s => (ε*I^(2*m))*(((19*r^2:ℝ):ℂ)^(s-((2*m:ℕ):ℂ)/2))
  have hP (s : ℂ) : AnalyticAt ℂ P s := by
    have hn : ((19*r^2:ℝ):ℂ)≠0 := Complex.ofReal_ne_zero.mpr
      (mul_ne_zero (by norm_num) (pow_ne_zero 2 hr))
    dsimp [P]
    simp_rw [Complex.cpow_def_of_ne_zero hn]
    fun_prop
  have hV (M : ℕ) (s : ℂ) : MeromorphicAt (V M) s := by
    apply MeromorphicAt.fun_sum
    intro n _
    exact (analyticAt_const.mul (binomial_shift_analytic (2*m) n s)).meromorphicAt.mul
      ((hG _ (s+n)).comp_analyticAt (g:=fun z : ℂ => z+n) (analyticAt_id.add analyticAt_const))
  have hVF (M : ℕ) (s : ℂ) (hs : BG<s.re) :
      V M s=normalizedTaylorSum (2*m) (fullCoefficients f (2*m)) 19 r M s := by
    unfold V normalizedTaylorSum
    apply Finset.sum_congr rfl
    intro n _
    have hn : BG<(s+(n:ℂ)).re := by
      simp only [Complex.add_re,Complex.natCast_re]
      linarith [Nat.cast_nonneg (α:=ℝ) n]
    rw [hGF _ hn,gridVector_index]
    unfold grid original
    rw [hpartner]
    norm_num
  refine ⟨max B BG,fun M s =>
    mellin (frickeError (2*m) (fullCoefficients f (2*m)) 19 r (ε*I^(2*m)) M) s+P s*V M s,?_,?_,?_⟩
  · intro M s hs
    have hb : B-(M:ℝ)<s.re := by linarith [le_max_left B BG]
    exact ((hB M).1 s hb).meromorphicAt.add ((hP s).meromorphicAt.mul (hV M s))
  · intro M s hs
    dsimp only
    rw [hVF M s (lt_of_le_of_lt (le_max_right _ _) hs)]
    have he := (hB M).2 s (lt_of_le_of_lt (le_max_left _ _) hs)
    dsimp [P]
    simpa only [original] using (sub_eq_iff_eq_add.mp he).symm
  · intro M s hs hregular
    have hb : B-(M:ℝ)<s.re := by linarith [le_max_left B BG]
    apply ((hB M).1 s hb).add ((hP s).mul ?_)
    apply Finset.analyticAt_fun_sum
    intro n _
    exact (analyticAt_const.mul (binomial_shift_analytic (2*m) n s)).mul
      ((hregular n).comp (f:=fun z : ℂ => z+n) (analyticAt_id.add analyticAt_const))

theorem partner_continuation {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (G : ℂ → Fin 114 → ℂ)
    (hG : ∀ i s, MeromorphicAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (r : ℝ) (hr : r≠0) (t : ℤ) (hpartner : -1/(19*r)=(t:ℝ)/114) :
    ∃ (B : ℝ) (H : ℂ → ℂ), (∀ s, MeromorphicNFAt H s) ∧
      (∀ s, B<s.re → H s=original (2*m) f r s) ∧
      ∀ s, (∀ n : ℕ, AnalyticAt ℂ (fun z => G z (gridIndex t)) (s+n)) → AnalyticAt ℂ H s := by
  obtain ⟨BM,H,hH,hHF,hregular⟩ := original_partner_models hf ε hlaw BG G hG hGF r hr t hpartner
  obtain ⟨BF,hF⟩ := original_common_halfplane hf
  let B : ℝ := max BM BF
  obtain ⟨V,hV,hVEq⟩ := QuantitativeArithmeticMeromorphicModels.glue
    B (original (2*m) f r) H
    (fun s hs => (hF r s (lt_of_le_of_lt (le_max_right _ _) hs)).1)
    (by intro n s hs; apply hH n s; dsimp [B] at hs; linarith [le_max_left BM BF])
    (by intro n s hs; exact hHF n s (lt_of_le_of_lt (le_max_left _ _) hs))
  have hVF : ∀ s, B<s.re → V s=original (2*m) f r s := fun s hs => hVEq hs
  refine ⟨B,V,hV,hVF,?_⟩
  intro s hs
  obtain ⟨M,hM⟩ := exists_nat_gt (BM-s.re)
  have hbs : BM-(M:ℝ)<s.re := by linarith
  exact SmallLevelSimplePoleTaylor.analyticAt_of_model
    (original (2*m) f r) V (H M) (H M) B BM (BM-(M:ℝ)) s hV hVF
    (hH M) (hHF M) hbs (hregular M s hbs hs) Filter.EventuallyEq.rfl

def fifthCenter : Fin 4 → ℝ := ![1/5,-1/5,2/5,-2/5]
def fifthPartner : Fin 4 → ℤ := ![-30,30,-15,15]

/-- Actual individual denominator-five additive continuations, including
the odd parts. No continuation of a twist is added to the original input. -/
theorem original_fifth_continuations {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) :
    ∃ (B : ℝ) (H : Fin 4 → ℂ → ℂ),
      (∀ i s, MeromorphicNFAt (H i) s) ∧
      ∀ i s, B<s.re → H i s=original (2*m) f (fifthCenter i) s := by
  obtain ⟨ε,BG,G,_hε,hlaw,hG,hGF⟩ :=
    QuantitativeArithmeticSmallLevelNineteenGridSystem.original_grid_continuation hm hf
  have hh (i : Fin 4) := partner_continuation hf ε hlaw BG G
    (fun i s => (hG i s).meromorphicAt) hGF (fifthCenter i)
    (by fin_cases i <;> norm_num [fifthCenter]) (fifthPartner i)
    (by fin_cases i <;> norm_num [fifthCenter,fifthPartner])
  choose b H hH hHF _hregular using hh
  let B : ℝ := Finset.univ.sup' Finset.univ_nonempty b
  refine ⟨B,H,hH,?_⟩
  intro i s hs
  exact hHF i s (lt_of_le_of_lt (show b i≤B from Finset.le_sup' b (Finset.mem_univ i)) hs)

#print axioms original_fifth_continuations
end QuantitativeArithmeticSmallLevelNineteenPartnerModels
end
end

/-! ## NineteenPoleTransfer -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteenPartnerModels
open Complex Filter Set SmallLevelAdditive
open QuantitativeArithmeticSmallLevelNineteenGridAnalytic
open QuantitativeArithmeticSmallLevelNineteen
open scoped Topology

/-- Regularity of all nonnegative shifts of the partner grid forces
regularity of the quadratic-five continuation at the base point. -/
theorem quadratic_regular_of_grid {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (V : ℂ → Fin 114 → ℂ)
    (hV : ∀ i s, MeromorphicNFAt (fun z => V z i) s)
    (hVF : ∀ s, BG<s.re → V s=gridVector (2*m) f s)
    (BC : ℝ) (G : ℂ → ℂ) (hG : ∀ s, MeromorphicNFAt G s)
    (hGF : ∀ s, BC<s.re → G s=quadraticCombination (2*m) f s)
    (s : ℂ) (hregular : ∀ (n : ℕ) i, AnalyticAt ℂ (fun z => V z i) (s+n)) :
    AnalyticAt ℂ G s := by
  have hh (i : Fin 4) := partner_continuation hf ε hlaw BG V
    (fun i z => (hV i z).meromorphicAt) hVF (fifthCenter i)
    (by fin_cases i <;> norm_num [fifthCenter]) (fifthPartner i)
    (by fin_cases i <;> norm_num [fifthCenter,fifthPartner])
  choose b H hH hHF hreg using hh
  let B : ℝ := Finset.univ.sup' Finset.univ_nonempty b
  let U : ℂ → ℂ := fun z => (H 0 z+H 1 z)-(H 2 z+H 3 z)
  have hU (z : ℂ) : MeromorphicAt U z :=
    ((hH 0 z).meromorphicAt.add (hH 1 z).meromorphicAt).sub
      ((hH 2 z).meromorphicAt.add (hH 3 z).meromorphicAt)
  have hUF (z : ℂ) (hz : B<z.re) : U z=quadraticCombination (2*m) f z := by
    have hb (i : Fin 4) : b i<z.re :=
      lt_of_le_of_lt (show b i≤B from Finset.le_sup' b (Finset.mem_univ i)) hz
    simp only [U,hHF 0 z (hb 0),hHF 1 z (hb 1),hHF 2 z (hb 2),hHF 3 z (hb 3)]
    norm_num only [fifthCenter,Matrix.cons_val,quadraticCombination,evenOne,evenTwo]
  have hs (i : Fin 4) : AnalyticAt ℂ (H i) s := hreg i s (fun n => hregular n _)
  exact SmallLevelSimplePoleTaylor.analyticAt_of_model
    (quadraticCombination (2*m) f) G U U BC B (s.re-1) s hG hGF
    (fun z _ => hU z) hUF (by linarith)
    (((hs 0).add (hs 1)).sub ((hs 2).add (hs 3))) Filter.EventuallyEq.rfl

theorem quadratic_pole_reaches_grid {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (V : ℂ → Fin 114 → ℂ)
    (hV : ∀ i s, MeromorphicNFAt (fun z => V z i) s)
    (hVF : ∀ s, BG<s.re → V s=gridVector (2*m) f s)
    (BC : ℝ) (G : ℂ → ℂ) (hG : ∀ s, MeromorphicNFAt G s)
    (hGF : ∀ s, BC<s.re → G s=quadraticCombination (2*m) f s)
    (s : ℂ) (hpole : ¬AnalyticAt ℂ G s) :
    ∃ (n : ℕ) (i : Fin 114), meromorphicOrderAt (fun z => V z i) (s+n)<0 := by
  by_contra hn
  push Not at hn
  apply hpole
  apply quadratic_regular_of_grid hf ε hlaw BG V hV hVF BC G hG hGF s
  intro n i
  exact (hV i (s+n)).meromorphicOrderAt_nonneg_iff_analyticAt.mp (hn n i)

/-- The rightmost pole needed by the finite first-Taylor certificates
exists in the same integer-shift class as any quadratic-twist pole. -/
theorem rightmost_grid_pole {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ε : ℂ)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (V : ℂ → Fin 114 → ℂ)
    (hV : ∀ i s, MeromorphicNFAt (fun z => V z i) s)
    (hVF : ∀ s, BG<s.re → V s=gridVector (2*m) f s)
    (BC : ℝ) (G : ℂ → ℂ) (hG : ∀ s, MeromorphicNFAt G s)
    (hGF : ∀ s, BC<s.re → G s=quadraticCombination (2*m) f s)
    (s : ℂ) (hpole : ¬AnalyticAt ℂ G s) :
    ∃ n : ℕ, (∃ i : Fin 114, meromorphicOrderAt (fun z => V z i) (s+n)<0) ∧
      ∀ j : ℕ, 0<j → ∀ i : Fin 114, 0≤meromorphicOrderAt (fun z => V z i) (s+n+j) := by
  obtain ⟨n,i,hi⟩ := quadratic_pole_reaches_grid hf ε hlaw BG V hV hVF BC G hG hGF s hpole
  obtain ⟨BF,hF⟩ := original_common_halfplane hf
  have hright (i : Fin 114) (z : ℂ) (hz : max BG BF<z.re) :
      AnalyticAt ℂ (fun w => V w i) z := by
    have ha : AnalyticAt ℂ (fun w => gridVector (2*m) f w i) z :=
      (hF ((i.val:ℝ)/114) z (lt_of_le_of_lt (le_max_right _ _) hz)).1
    have he : (fun w => V w i)=ᶠ[𝓝 z] (fun w => gridVector (2*m) f w i) := by
      have hn : ∀ᶠ w in 𝓝 z, BG<w.re :=
        (isOpen_lt continuous_const Complex.continuous_re).mem_nhds
          (lt_of_le_of_lt (le_max_left _ _) hz)
      filter_upwards [hn] with w hw
      exact congrFun (hVF w hw) i
    exact (analyticAt_congr he).mpr ha
  obtain ⟨a,ha,hshift⟩ := SmallLevelPoleGrid.rightmost_pole
    (fun i z => V z i) (x:=s+n) ⟨i,hi⟩ (max BG BF) hright
  refine ⟨n+a,?_,?_⟩
  · simpa only [Nat.cast_add,add_assoc] using ha
  · simpa only [Nat.cast_add,add_assoc] using hshift

#print axioms rightmost_grid_pole
#print axioms quadratic_pole_reaches_grid
end QuantitativeArithmeticSmallLevelNineteenPartnerModels
end
end

/-! ## NineteenNonzeroQuadraticEntire -/
section
set_option autoImplicit false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteen
open Complex
open QuantitativeArithmeticSmallLevelNineteenGridSystem
open QuantitativeArithmeticSmallLevelNineteenPartnerModels

theorem original_nonzero_quadratic_entire (m : ℕ) (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ha : f 2≠0) :
    ∃ (B : ℝ) (G : ℂ→ℂ), (∀ s, AnalyticAt ℂ G s) ∧
      ∀ s, B<s.re → G s=quadraticCombination (2*m) f s := by
  obtain ⟨ε,BV,V,hε,hlaw,hV,hVF⟩ := original_grid_continuation hm hf
  obtain ⟨B,G,hG,hGF,hregular,hFE⟩ := original_quadratic_reflected_continuation hm hf ε hε hlaw
  refine ⟨B,G,?_,hGF⟩
  refine QuantitativeArithmeticReflectedAnalyticHalfPlane.analytic_everywhere_of_right_half_plane
    G (reflectionMultiplier (2*m) ε) (((2*m:ℕ):ℂ)) (m:ℝ) ?_
    (fun s => (reflectionMultiplier_entire (2*m) ε).analyticAt s) hFE ?_
  · simp
  · intro s hs
    by_contra hp
    have hd : denominator (2*m) f s=0 := by
      by_contra hn
      exact hp (hregular s hn)
    obtain ⟨n,hpole,hshift⟩ := rightmost_grid_pole hf ε hlaw BV V hV hVF B G hG hGF s hp
    exact rightmost_nonzero_no_pole hm hf ha ε hε hlaw BV V hV hVF s n hs hd hpole hshift

#print axioms original_nonzero_quadratic_entire
end QuantitativeArithmeticSmallLevelNineteen
end
