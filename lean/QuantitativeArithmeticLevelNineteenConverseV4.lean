    simpa only [Complex.cpow_ofNat_mul] using h2
  have h3' : (3:ℂ)^(2*s)= -1 := by
    rw [Complex.cpow_ofNat_mul]
    exact eq_neg_of_add_eq_zero_left h3
  apply negative_prime_cpow_excludes_real (by decide : Nat.Prime 2)
    (by decide : Nat.Prime 3) (by decide : 2≠3) (2*s) X hX h2'
  change ((3:ℂ)^(2*s)).im=0
  rw [h3']
  norm_num

theorem negative_square_central (x : ℂ) (X : ℝ) (hX : X<0)
    (hx2 : x^2=(X:ℂ)) (hx4 : x^4=1) : x^2 = -1 := by
  have he : (X:ℂ)^2=1 := by
