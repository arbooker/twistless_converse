/-! ## NineteenZeroLeadingCoordinates -/
section
set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unreachableTactic false
set_option linter.unusedTactic false
set_option maxHeartbeats 1000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteenPoleLeading

theorem zero_short_relations1 (x y z a b : ℂ) (hx : x≠0)
    (v : Fin 114→ℂ) (hr : residualRows1 x y z a b v=0) :
    (x^4-1)*v 42=0 ∧
    (y^2+1)*v 18 + ((1-x^2)/x^2)*v 42 + (x^2-1)*v 84=0 := by
  constructor
  · have h := congrFun hr (19:Fin 43)
    change ((x^(4:ℕ) + (-1:ℂ))/(x^(4:ℕ)))*v 42=0 at h
    linear_combination (norm := (field_simp [hx]; ring1)) (x^4)*h
  · have h := congrFun hr (5:Fin 43)
    change (y^(2:ℕ) + (1:ℂ))*v 18 + (((-1:ℂ)*x^(2:ℕ) + (1:ℂ))/(x^(2:ℕ)))*v 42 + (x^(2:ℕ) + (-1:ℂ))*v 84=0 at h
    linear_combination (norm := (field_simp [hx]; ring1)) h

theorem zero_short_relations3 (x y z a b : ℂ) (hx : x≠0)
    (v : Fin 114→ℂ) (hr : residualRows3 x y z a b v=0) :
    (x^4-1)*v 42=0 ∧
    (y^2+1)*v 18 + ((1-x^2)/x^2)*v 42 + (x^2-1)*v 84=0 := by
  constructor
  · have h := congrFun hr (19:Fin 43)
    change ((x^(4:ℕ) + (-1:ℂ))/(x^(4:ℕ)))*v 42=0 at h
    linear_combination (norm := (field_simp [hx]; ring1)) (x^4)*h
  · have h := congrFun hr (5:Fin 43)
    change ((-1:ℂ)*y^(2:ℕ) + (-1:ℂ))*v 18 + ((x^(2:ℕ) + (-1:ℂ))/(x^(2:ℕ)))*v 42 + ((-1:ℂ)*x^(2:ℕ) + (1:ℂ))*v 84=0 at h
    linear_combination (norm := (field_simp [hx]; ring1)) -h

/-- Away from the central gap the leading vector has one scalar parameter.
The injectivity hypothesis is supplied by the checked unit-pivot reduction. -/
theorem zero_coordinates (x y : ℂ) (v : Fin 114→ℂ)
    (hx4 : x^4≠1) (hy2 : y^2+1≠0)
    (h2 : (x^4-1)*v 42=0)
    (hF : (y^2+1)*v 18 + ((1-x^2)/x^2)*v 42 + (x^2-1)*v 84=0)
    (hinj : v 18=0 → v 42=0 → v 84=0 → v=0) (hv : v≠0) :
    ∃ c : ℂ, c≠0 ∧ v 18=c*(1-x^2) ∧ v 42=0 ∧ v 84=c*(y^2+1) := by
  have hu : v 42=0 := (mul_eq_zero.mp h2).resolve_left (sub_ne_zero.mpr hx4)
  rw [hu, mul_zero, add_zero] at hF
  refine ⟨v 84/(y^2+1), ?_, ?_, hu, ?_⟩
  · intro hc
    have hv84 : v 84=0 := (div_eq_zero_iff.mp hc).resolve_right hy2
    have hv18 : v 18=0 := by
      rw [hv84, mul_zero, add_zero] at hF
      exact (mul_eq_zero.mp hF).resolve_left hy2
    exact hv (hinj hv18 hu hv84)
  · rw [div_mul_eq_mul_div]
    apply (eq_div_iff hy2).mpr
    linear_combination hF
  · exact (div_mul_cancel₀ (v 84) hy2).symm

theorem zero_central_relation (x y w u v : ℂ) (hx2 : x^2 = -1)
    (hF : (y^2+1)*w + ((1-x^2)/x^2)*u + (x^2-1)*v=0) :
    (y^2+1)*w-2*u-2*v=0 := by
  rw [hx2] at hF
  linear_combination (norm := (norm_num; ring1)) hF

#print axioms zero_short_relations1
#print axioms zero_short_relations3
#print axioms zero_coordinates
#print axioms zero_central_relation
end QuantitativeArithmeticSmallLevelNineteenPoleLeading
end
