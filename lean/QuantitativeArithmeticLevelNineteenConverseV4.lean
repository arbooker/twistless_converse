/-- The auxiliary exceptional factor G=X-2A+4 can vanish on a gap solution
only at X=-2L, and the right-half-plane norm condition forces L≤2. -/
theorem gap_factor_zero {L : ℝ} (hL : 0<L) {X A : ℂ}
    (hgap : A= -X/(L:ℂ)-(L:ℂ)) (hfactor : X-2*A+4=0)
    (hnorm : L^2≤‖X‖) : X= -2*(L:ℂ) ∧ A=2-(L:ℂ) ∧ L≤2 := by
  have hl0 : (L:ℂ)≠0 := Complex.ofReal_ne_zero.mpr hL.ne'
  have hprod : ((L:ℂ)+2)*(X+2*(L:ℂ))=0 := by
    field_simp at hgap
    linear_combination (L:ℂ)*hfactor+2*hgap
  have hL2 : (L:ℂ)+2≠0 := by
    have hr : L+2≠0 := by linarith
    exact_mod_cast hr
  have hx : X= -2*(L:ℂ) := by
    have he := (mul_eq_zero.mp hprod).resolve_left hL2
    linear_combination he
  have ha : A=2-(L:ℂ) := by
    linear_combination (-1/2:ℂ)*hfactor+(1/2:ℂ)*hx
  have hnx : ‖X‖=2*L := by
    rw [hx,norm_mul]
    simp [abs_of_pos hL]
  rw [hnx] at hnorm
  exact ⟨hx,ha,by nlinarith⟩

/-- In the nonzero Hecke-eigenvalue branch, the exceptional gap factor
reduces exactly to the isolated values n=0, X=-2, A=1. -/
theorem denominator_gap_factor_zero (m n : ℕ) (f : ℕ → ℂ) (s : ℂ)
    (hs : (m:ℝ)≤s.re) (h : denominator (2*m) f s=0) (hf : f 2≠0)
    (hg : poleCoordinate m (s+(n:ℂ))^2-
      2*(poleParameter f*poleCoordinate m (s+(n:ℂ)))+4=0) :
    n=0 ∧ poleCoordinate m (s+(n:ℂ))^2= -2 ∧
      poleParameter f*poleCoordinate m (s+(n:ℂ))=1 := by
  have hL : (0:ℝ)<(2:ℝ)^n := pow_pos (by norm_num) _
  have hnorm : ((2:ℝ)^n)^2≤‖poleCoordinate m (s+(n:ℂ))^2‖ := by
    rw [norm_pow]
    have he := poleCoordinate_norm_lower m n s hs
    nlinarith [norm_nonneg (poleCoordinate m (s+(n:ℂ)))]
  have hgap := denominator_zero_gap m n f s h
  have hgap' : poleParameter f*poleCoordinate m (s+(n:ℂ))=
      -poleCoordinate m (s+(n:ℂ))^2/(((2:ℝ)^n:ℝ):ℂ)-(((2:ℝ)^n:ℝ):ℂ) := by
    simpa using hgap
  obtain ⟨hx,ha,hsmall⟩ := gap_factor_zero hL hgap' hg hnorm
  have hn : n≤1 := by
    by_contra hnot
    have hp := pow_le_pow_right₀ (by norm_num : (1:ℝ)≤2) (by omega : 2≤n)
    norm_num at hp
    linarith
  have hn0 : n=0 := by
    by_contra hnot
    have hn1 : n=1 := by omega
    rw [hn1] at ha
    norm_num at ha
    have hp : poleParameter f≠0 := mul_ne_zero
      (Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))) hf
    rcases ha with ha|ha
    · exact hp ha
    · exact poleCoordinate_ne_zero _ _ ha
  refine ⟨hn0,?_,?_⟩
  · simpa [hn0] using hx
  · simpa only [hn0,pow_zero,Complex.ofReal_one,show (2:ℂ)-1=1 by norm_num] using ha

#print axioms gap_factor_zero
#print axioms denominator_gap_factor_zero
end QuantitativeArithmeticSmallLevelNineteen
end
