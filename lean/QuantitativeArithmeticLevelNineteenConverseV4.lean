/-! ## NineteenZeroFirstJetSigns -/
section
set_option autoImplicit false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteenZeroFirstJet
open Complex
open QuantitativeArithmeticSmallLevelNineteenGridSystem
open QuantitativeArithmeticSmallLevelNineteenGridAnalytic
open QuantitativeArithmeticUniversalPoleVector

/-- All four original sign choices are covered by the two checked first-jet
certificates, using the sign change in the nineteen-parameter. -/
theorem negative_square_no_pole {m : ℕ} (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ha : f 2=0)
    (ε : ℂ) (hε : ε=1 ∨ ε=-1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 19 (2*m) f ε)
    (BG : ℝ) (G : ℂ→Fin 114→ℂ)
    (hG : ∀ i s, MeromorphicNFAt (fun z => G z i) s)
    (hGF : ∀ s, BG<s.re → G s=gridVector (2*m) f s)
    (s : ℂ) (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) s<0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j,
      0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (X : ℝ) (hX : X<0) (h2 : (primeParameter 2 m s)^2=(X:ℂ)) : False := by
  obtain ⟨v,hv⟩ := exists_leading_vector G s (fun j => (hG j s).meromorphicAt) hpole
  rcases phaseRoot_sign m hε with hp|hp <;>
    rcases badNineteen_sign hf.toEulerData with hd|hd
  · exact negative_square_no_leading_vector1 hm hf ε (-1) hlaw (Or.inr rfl)
      (by simpa using hp) (by simpa using hd) ha BG G hG hGF s v hv hshift X hX h2
  · exact negative_square_no_leading_vector3 hm hf ε (-1) hlaw (Or.inr rfl)
      (by simpa using hp) (by simpa using hd) ha BG G hG hGF s v hv hshift X hX h2
  · exact negative_square_no_leading_vector3 hm hf ε 1 hlaw (Or.inl rfl)
      (by simpa using hp) (by simpa using hd) ha BG G hG hGF s v hv hshift X hX h2
  · exact negative_square_no_leading_vector1 hm hf ε 1 hlaw (Or.inl rfl)
      (by simpa using hp) (by simpa using hd) ha BG G hG hGF s v hv hshift X hX h2

#print axioms negative_square_no_pole
end QuantitativeArithmeticSmallLevelNineteenZeroFirstJet
end
end

/-! ## NineteenZeroQuadraticEntire -/
section
set_option autoImplicit false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteen
open Complex
open QuantitativeArithmeticSmallLevelNineteenGridSystem
open QuantitativeArithmeticSmallLevelNineteenPartnerModels
open QuantitativeArithmeticSmallLevelNineteenZeroFirstJet

/-- For a zero eigenvalue at two, the quadratic-five twist is entire under
only the original hypotheses. Continuation of auxiliary twists and all pole
exclusions are derived, including every Fricke sign and positive even weight. -/
theorem original_zero_quadratic_entire (m : ℕ) (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 (2*m) f) (ha : f 2=0) :
    ∃ (B : ℝ) (G : ℂ→ℂ), (∀ s, AnalyticAt ℂ G s) ∧
      ∀ s, B<s.re → G s=quadraticCombination (2*m) f s := by
  obtain ⟨ε,BV,V,hε,hlaw,hV,hVF⟩ := original_grid_continuation hm hf
  obtain ⟨B,G,hG,hGF,hregular,_hgerm⟩ := original_quadratic_continuation m hm hf
  refine ⟨B,G,?_,hGF⟩
  intro s
  by_contra hs
  have hd : denominator (2*m) f s=0 := by
    by_contra hn
    exact hs (hregular s hn)
  have hbase : (poleCoordinate m s)^2= -1 := by
    have h := denominator_zero_quadratic m f s hd
    simp only [poleParameter,ha,mul_zero,zero_mul,add_zero] at h
    exact eq_neg_of_add_eq_zero_left h
  obtain ⟨n,hpole,hshift⟩ := rightmost_grid_pole hf ε hlaw BV V hV hVF B G hG hGF s hs
  have hX : -((2:ℝ)^n)^2<0 := by
    have hn : (0:ℝ)<(2:ℝ)^n := pow_pos (by norm_num) n
    nlinarith [sq_pos_of_pos hn]
  have h2 : (primeParameter 2 m (s+(n:ℂ)))^2=((-((2:ℝ)^n)^2:ℝ):ℂ) := by
    change (poleCoordinate m (s+(n:ℂ)))^2= _
    rw [poleCoordinate_shift,mul_pow,hbase]
    push_cast
    ring
  exact negative_square_no_pole hm hf ha ε hε hlaw BV V hV hVF
    (s+n) hpole hshift (-((2:ℝ)^n)^2) hX h2

#print axioms original_zero_quadratic_entire
end QuantitativeArithmeticSmallLevelNineteen
end
end

/-! ## NineteenZeroModular -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteen

/-- Complete modularity for the zero eigenvalue at two, derived from the
original level19 input, in every positive even weight. The nonzero eigenvalue
cases remain separate obligations for the full level19 theorem. -/
theorem modular_of_zero_two {k : ℕ} (hk : 0<k) (heven : Even k) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 k f) (ha : f 2=0) :
    SmallLevelOriginal.IsModular 19 k f := by
  obtain ⟨m,hm⟩ := heven
  have hkm : k=2*m := by omega
  rw [hkm] at hf ⊢
  obtain ⟨B,G,hG,hGF⟩ := original_zero_quadratic_entire m (by omega) hf ha
  exact modular_of_quadratic_entire (by omega) hf B G hG hGF

#print axioms modular_of_zero_two
end QuantitativeArithmeticSmallLevelNineteen
end
end

/-! ## NineteenModular -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelNineteen

theorem original_modular_all {k : ℕ} (hk : 0<k) (heven : Even k) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 19 k f) :
    SmallLevelOriginal.IsModular 19 k f := by
  by_cases ha : f 2=0
  · exact modular_of_zero_two hk heven hf ha
  obtain ⟨m,hm⟩ := heven
  have hkm : k=2*m := by omega
  rw [hkm] at hf ⊢
  obtain ⟨B,G,hG,hGF⟩ := original_nonzero_quadratic_entire m (by omega) hf ha
  exact modular_of_quadratic_entire (by omega) hf B G hG hGF

#print axioms original_modular_all
end QuantitativeArithmeticSmallLevelNineteen
