section
set_option autoImplicit false
@[expose] public noncomputable section

namespace QuantitativeArithmeticCompact25FinalH
open QuantitativeArithmeticSparsePolynomialCertificate

/-- The five actual coordinates in the level-25 positive chart. -/
inductive Coordinate where
  | u | b | a | y | x

def coordinateValue (u B A Y X : ℂ) : Coordinate → ℂ
  | .u => u
  | .b => B
  | .a => A
  | .y => Y
  | .x => X

def coordinateExponent : Coordinate → Exponent
  | .u => (1, 0, 0, 0, 0)
  | .b => (0, 1, 0, 0, 0)
  | .a => (0, 0, 1, 0, 0)
  | .y => (0, 0, 0, 1, 0)
  | .x => (0, 0, 0, 0, 1)

/-- The original numerators use only integer leaves, sums, and right
multiplication by one coordinate. No expanded intermediate polynomial is data. -/
inductive HornerCode where
  | integer : ℤ → HornerCode
  | add : HornerCode → HornerCode → HornerCode
  | mulCoordinate : HornerCode → Coordinate → HornerCode

def hornerValue (u B A Y X : ℂ) : HornerCode → ℂ
  | .integer c => (c : ℂ)
  | .add p q => hornerValue u B A Y X p + hornerValue u B A Y X q
  | .mulCoordinate p v => hornerValue u B A Y X p * coordinateValue u B A Y X v

def hornerPolynomial : HornerCode → Poly
  | .integer c => [(c, (0, 0, 0, 0, 0))]
  | .add p q => merge (hornerPolynomial p) (hornerPolynomial q)
  | .mulCoordinate p v => shift 1 (coordinateExponent v) (hornerPolynomial p)

theorem eval_hornerPolynomial (u B A Y X : ℂ) (p : HornerCode) :
    eval u B A Y X (hornerPolynomial p) = hornerValue u B A Y X p := by
  induction p with
  | integer c => simp [hornerPolynomial, hornerValue, eval_cons, monomial]
  | add p q hp hq =>
      simp only [hornerPolynomial, eval_merge, hp, hq, hornerValue]
  | mulCoordinate p v hp =>
      rw [hornerPolynomial, eval_shift, hp]
      cases v <;> simp [hornerValue, coordinateExponent, coordinateValue, monomial,
        mul_comm]

/-- This unrestricted value is needed for FinalH: its source numerators are
not zero. The zero-only certificate theorem cannot prove this identity. -/
def combinationValue (u B A Y X : ℂ) (inputs : ℕ → ℂ) : Certificate → ℂ
  | .leaf i c e => (c : ℂ) * monomial u B A Y X e * inputs i
  | .add t s => combinationValue u B A Y X inputs t + combinationValue u B A Y X inputs s

theorem eval_combine (u B A Y X : ℂ) (inputs : ℕ → Poly) (t : Certificate) :
    eval u B A Y X (combine inputs t) =
      combinationValue u B A Y X (fun i => eval u B A Y X (inputs i)) t := by
  induction t with
  | leaf i c e => exact eval_shift u B A Y X c e (inputs i)
  | add t s ht hs =>
      simp only [combine, eval_merge, ht, hs, combinationValue]

theorem combination_eq_of_polynomial_eq (u B A Y X : ℂ)
    (inputs : ℕ → Poly) (values : ℕ → ℂ) (t : Certificate) (target : Poly)
    (hinputs : ∀ i, eval u B A Y X (inputs i) = values i)
    (hcheck : combine inputs t = target) :
    combinationValue u B A Y X values t = eval u B A Y X target := by
  have hvalues : (fun i => eval u B A Y X (inputs i)) = values := funext hinputs
  rw [← hvalues, ← eval_combine, hcheck]

#print axioms eval_hornerPolynomial
#print axioms eval_combine
#print axioms combination_eq_of_polynomial_eq
end QuantitativeArithmeticCompact25FinalH
