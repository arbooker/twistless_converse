compact_certificate theorem source_shift_normalized (r : Source) (m i n : ℕ) (ε : ℚ) (s : ℂ) (v : ℕ → ℂ)
    (h : scale (s-((2*m:ℕ):ℂ)) (i+(n+1))≠0) :
    shift r m (ε:ℂ) n (s-((i+(n+1):ℕ):ℂ))
      (fun j => scale (s-((2*m:ℕ):ℂ)) i*v j)/scale (s-((2*m:ℕ):ℂ)) (i+(n+1))=
      formalHigher r ε (primeRate 2 m (s-((i+(n+1):ℕ):ℂ)))
        (primeRate 3 m (s-((i+(n+1):ℕ):ℂ)))
        (primeRate 5 m (s-((i+(n+1):ℕ):ℂ)))
        (primeRate 7 m (s-((i+(n+1):ℕ):ℂ))) (n+1) v := by
  cases r with
  | old t =>
    cases t with
    | matrix j => exact matrix_shift_normalized (QuantitativeArithmeticSmallLevelTwentySevenShiftSource.Matrix.selected j) m i n s v h
    | ramanujan j =>
      exact ramanujan_shift_normalized (QuantitativeArithmeticSmallLevelTwentySevenShiftSource.Ramanujan.selected j)
        (QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.selected_valid _) m i n ε s v h
    | hecke j hj => simp only [shift,QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.kindShift,formalHigher,zero_div]
    | entire j => simp only [shift,QuantitativeArithmeticSmallLevelTwentySevenSourceDispatch.kindShift,formalHigher,zero_div]
  | matrix t ht obs ho => exact matrix_shift_normalized t m i n s v h
  | ramanujan t ht obs ho => exact ramanujan_shift_normalized t ht m i n ε s v h
  | hecke t ht => simp only [shift,formalHigher,zero_div]
  | entire p hp => simp only [shift,formalHigher,zero_div]
#print axioms source_shift_normalized
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
