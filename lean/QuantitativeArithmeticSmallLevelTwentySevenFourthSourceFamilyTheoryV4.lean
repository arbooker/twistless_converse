compact_certificate theorem original_row (r : Source) (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (η : ℂ) (hη : η=1 ∨ η= -1) (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw point m f η) :
    ∃ (B : ℝ) (E : ℕ → ℂ → ℂ), ∀ M : ℕ,
      AnalyticOnNhd ℂ (E M) {s : ℂ | B-((M:ℝ)+1)<s.re} ∧
      ∀ s : ℂ, B<s.re → row r m f η s=E M s+∑ n∈Finset.range M,
        shift r m η n s (fun j => SmallLevelAdditive.original (2*m) f (point j:ℝ) (s+((n+1:ℕ):ℂ))) := by
  cases r with
  | old t =>
    obtain ⟨B,E,_,ha,hr⟩ := QuantitativeArithmeticSmallLevelTwentySevenPoleSource.family_at_sign m hm hf η hη hlaw
    refine ⟨B,E (.old t),?_⟩
    intro M
    refine ⟨fun s hs => ha (.old t) M s hs,?_⟩
    intro s hs
    simpa only [row,shift,QuantitativeArithmeticSmallLevelTwentySevenPoleSource.sourceRow,QuantitativeArithmeticSmallLevelTwentySevenPoleSource.sourceShift,Nat.cast_add,Nat.cast_one] using hr (.old t) M s hs
  | matrix t ht obs ho => exact QuantitativeArithmeticSmallLevelTwentySevenMatrixSource.original_row point t ht m hf
  | ramanujan t ht obs ho => exact hlaw t ht
  | hecke t ht =>
    obtain ⟨B,hB⟩ := QuantitativeArithmeticSmallLevelTwentySevenHeckeSource.original_leading point t ht hm hf
    refine ⟨B,fun _ _ => 0,?_⟩
    intro M
    refine ⟨fun _ _ => analyticAt_const,?_⟩
    intro s hs
    simpa only [row,shift,Finset.sum_const_zero,add_zero] using hB s hs
  | entire p hp =>
    obtain ⟨B,E,ha,hr⟩ := hp m hm hf
    refine ⟨B,fun _ => E,?_⟩
    intro M
    exact ⟨fun s _ => ha.analyticAt s,fun s hs => by
      simpa only [row,shift,Finset.sum_const_zero,add_zero] using hr s hs⟩

compact_certificate
/-- Any finite selection of the checked source types shares one initial
half-plane and one Fricke sign. No individual additive-twist continuation is used. -/
theorem original_family {ι : Type*} [Fintype ι] [Nonempty ι]
    (source : ι → Source) (m : ℕ) (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 27 (2*m) f)
    (η : ℂ) (hη : η=1 ∨ η= -1) (hlaw : QuantitativeArithmeticSmallLevelTwentySevenRamanujanSource.TaylorLaw point m f η) :
    ∃ (B : ℝ) (E : ι → ℕ → ℂ → ℂ), ∀ i : ι, ∀ M : ℕ,
      AnalyticOnNhd ℂ (E i M) {s : ℂ | B-((M:ℝ)+1)<s.re} ∧
      ∀ s : ℂ, B<s.re → row (source i) m f η s=E i M s+∑ n∈Finset.range M,
        ∑ j : Fin 321, coefficient (source i) m η n s j*
          basisValues (fun t => SmallLevelAdditive.original (2*m) f (point t:ℝ) (s+((n+1:ℕ):ℂ))) j := by
  classical
  have hi (i : ι) := original_row (source i) m hm hf η hη hlaw
  choose b E hE using hi
  let B : ℝ := Finset.univ.sup' Finset.univ_nonempty b
  have hbB (i : ι) : b i≤B := Finset.le_sup' b (Finset.mem_univ i)
  refine ⟨B,E,?_⟩
  intro i M
  refine ⟨?_,?_⟩
  · intro s hs
    apply (hE i M).1 s
    change B-((M:ℝ)+1)<s.re at hs
    change b i-((M:ℝ)+1)<s.re
    linarith [hbB i]
  · intro s hs
    simp_rw [shift_action]
    exact (hE i M).2 s (lt_of_le_of_lt (hbB i) hs)
#print axioms original_row
#print axioms original_family
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
end
