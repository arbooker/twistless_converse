compact_certificate theorem denominatorRate_nonzero (x y z w : ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0) (j : ℕ) :
    denominatorRate x y z w j≠0 :=
  mul_ne_zero (mul_ne_zero (mul_ne_zero (pow_ne_zero _ hx) (pow_ne_zero _ hy))
    (pow_ne_zero _ hz)) (pow_ne_zero _ hw)

compact_certificate theorem physical_denominator_analytic (m d j : ℕ) (s : ℂ) :
    AnalyticAt ℂ (fun z => denominatorRate
      (primeRate 2 m (z-(d:ℂ))) (primeRate 3 m (z-(d:ℂ)))
      (primeRate 5 m (z-(d:ℂ))) (primeRate 7 m (z-(d:ℂ))) j) s := by
  have h (p : ℝ) : AnalyticAt ℂ (fun z => primeRate p m (z-(d:ℂ))) s :=
    (primeRate_analytic p m _).comp (f:=fun z : ℂ => z-(d:ℂ))
      (analyticAt_id.sub analyticAt_const)
  exact (((((h 2).pow _).mul ((h 3).pow _)).mul ((h 5).pow _)).mul ((h 7).pow _))

compact_certificate theorem physical_denominator_nonzero (m d j : ℕ) (s : ℂ) :
    denominatorRate (primeRate 2 m (s-(d:ℂ))) (primeRate 3 m (s-(d:ℂ)))
      (primeRate 5 m (s-(d:ℂ))) (primeRate 7 m (s-(d:ℂ))) j≠0 :=
  denominatorRate_nonzero _ _ _ _ (primeRate_nonzero _ _ _) (primeRate_nonzero _ _ _)
    (primeRate_nonzero _ _ _) (primeRate_nonzero _ _ _) j

compact_certificate theorem physical_denominator_shift (m d j : ℕ) (s : ℂ) :
    denominatorRate (primeRate 2 m (s-(d:ℂ))) (primeRate 3 m (s-(d:ℂ)))
      (primeRate 5 m (s-(d:ℂ))) (primeRate 7 m (s-(d:ℂ))) j=
    denominatorRate (primeRate 2 m s/2^d) (primeRate 3 m s/3^d)
      (primeRate 5 m s/5^d) (primeRate 7 m s/7^d) j := by
  simp_rw [primeRate_sub_nat 2 m (by norm_num),primeRate_sub_nat 3 m (by norm_num),
    primeRate_sub_nat 5 m (by norm_num),primeRate_sub_nat 7 m (by norm_num)]
  rfl

compact_certificate
/-- The formal top substitution has precisely the required profile at
resonance, for any choice of coordinate weights. -/
theorem layerVector_top_resonance (profile : ℕ → ℚ) (v : ℕ → ℂ) (j : ℕ) :
    layerVector profile 2 3 5 7 0 v j=(profile j:ℂ)*v 2428 := by
  have hd := denominatorRate_nonzero (2:ℂ) 3 5 7 (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) j
  simp only [layerVector,pow_zero,div_one,ite_true]
  field_simp [hd]

#print axioms physical_denominator_analytic
#print axioms physical_denominator_shift
#print axioms layerVector_top_resonance
