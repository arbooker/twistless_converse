/-- The 2428 lower slots are defined from initial-half-plane functions only.
The final slot is the continued anchor; no continuation of lower slots is claimed. -/
def physicalCoordinates (F : ℕ → ℂ → ℂ) (m : ℕ) (anchor : ℂ → ℂ)
    (s : ℂ) (t : ℕ) : ℂ :=
  if t=2428 then anchor s else
    let d := 4-t/607
    let j := t%607
    (denominatorRate (primeRate 2 m (s-(d:ℂ))) (primeRate 3 m (s-(d:ℂ)))
      (primeRate 5 m (s-(d:ℂ))) (primeRate 7 m (s-(d:ℂ))) j)^2*
        layerValue (F j) (2*m) d s

@[simp] theorem physicalCoordinates_top (F : ℕ → ℂ → ℂ) (m : ℕ)
    (anchor : ℂ → ℂ) (s : ℂ) : physicalCoordinates F m anchor s 2428=anchor s := by
  simp [physicalCoordinates]

compact_certificate theorem physicalCoordinates_lower (F : ℕ → ℂ → ℂ) (m : ℕ)
    (anchor : ℂ → ℂ) (s : ℂ) (d j : ℕ) (hd0 : 0<d) (hd4 : d≤4) (hj : j<607) :
    physicalCoordinates F m anchor s (607*(4-d)+j)=
      (denominatorRate (primeRate 2 m (s-(d:ℂ))) (primeRate 3 m (s-(d:ℂ)))
        (primeRate 5 m (s-(d:ℂ))) (primeRate 7 m (s-(d:ℂ))) j)^2*
          layerValue (F j) (2*m) d s := by
  have ht : 607*(4-d)+j≠2428 := by omega
  have hq : (607*(4-d)+j)/607=4-d := by omega
  have hr : (607*(4-d)+j)%607=j := by omega
  have hd : 4-(4-d)=d := by omega
  simp only [physicalCoordinates,ite_eq_right ht,hq,hr,hd]

compact_certificate theorem layerVector_physical_lower (profile : ℕ → ℚ) (F : ℕ → ℂ → ℂ)
    (m : ℕ) (anchor : ℂ → ℂ) (s : ℂ) (d j : ℕ)
    (hd0 : 0<d) (hd4 : d≤4) (hj : j<607) :
    layerVector profile (primeRate 2 m s) (primeRate 3 m s)
      (primeRate 5 m s) (primeRate 7 m s) d (physicalCoordinates F m anchor s) j=
        layerValue (F j) (2*m) d s := by
  have hd : d≠0 := by omega
  simp only [layerVector,ite_eq_right hd]
  rw [physicalCoordinates_lower F m anchor s d j hd0 hd4 hj,
    ← physical_denominator_shift m d j s]
  have hnon := physical_denominator_nonzero m d j s
  field_simp [hnon]

#print axioms layerVector_physical_lower
end QuantitativeArithmeticSmallLevelTwentySevenFourthSourceFamily
end
