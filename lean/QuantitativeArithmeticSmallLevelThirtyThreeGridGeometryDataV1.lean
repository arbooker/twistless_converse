  den^2/(g.det:ℚ)=groupRate i ∧
  (g 1 0:ℚ)*den/(g.det:ℚ)=groupDerivative i ∧
  0 < groupRate i

instance (i : Fin 588) : Decidable (GroupValid i) := by unfold GroupValid; infer_instance

