    linear_combination (-x^(6:ℕ)*z^(3:ℕ)+2*x^(6:ℕ)*z^(2:ℕ)-x^(6:ℕ)*z+x^(4:ℕ)*z^(3:ℕ)-x^(4:ℕ)*z^(2:ℕ)-2*x^(2:ℕ)*z^(3:ℕ)+3*x^(2:ℕ)*z^(2:ℕ)-x^(2:ℕ)*z+2*z^(2:ℕ)-2*z)*h0-(x^(10:ℕ)*z^(2:ℕ)-2*x^(10:ℕ)*z+x^(10:ℕ)-x^(8:ℕ)*z^(2:ℕ)+x^(8:ℕ)*z+4*x^(6:ℕ)*z^(2:ℕ)-7*x^(6:ℕ)*z+3*x^(6:ℕ)-2*x^(4:ℕ)*z^(2:ℕ)+2*x^(4:ℕ)+4*x^(2:ℕ)*z^(2:ℕ)-6*x^(2:ℕ)*z+2*x^(2:ℕ)-4*z+4)*h13
