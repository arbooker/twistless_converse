    (mul_eq_zero.mp hp0).resolve_left (mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num) hz') hPivot) hw')
  have hp1 : (-2*(z - 1)*(x^(4:ℕ) - x^(2:ℕ) + 2)*(x^(2:ℕ)*z - x^(2:ℕ) - 1))*d0Input1 (x^(2:ℕ)) z=0 := by
