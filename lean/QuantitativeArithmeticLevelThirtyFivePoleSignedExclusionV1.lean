set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
open Complex Filter Set
open QuantitativeArithmeticUniversalPoleVector
open QuantitativeArithmeticSmallLevelThirtyFiveGridAnalytic
open QuantitativeArithmeticSmallLevelThirtyFiveGridRamanujan
open scoped Topology


certificate_batch {
theorem original_signed_negative_a0_normalization {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (u5 u7 : ℂ) (hu5 : u5=1 ∨ u5= -1) (hu7 : u7=1 ∨ u7= -1)
    (hphase : ε*I^(2*m)= -u5*u7) (h5 : badFive f= -u5) (h7 : badSeven f= -u7)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ) (v : Fin 210 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hr : v 192≠0) (hz : (u5*primeParameter 5 m s)≠1)
    (hA : (primeParameter 2 m s)^(4:ℕ)+(primeParameter 3 m s)^(2:ℕ)-1=0) :
    let x := primeParameter 2 m s
    let y := primeParameter 3 m s
    let z := (u5*primeParameter 5 m s)
    let w := (u7*primeParameter 7 m s)
    let a := (Real.sqrt 2:ℂ)*f 2
    let b := (Real.sqrt 3:ℂ)*f 3
    ∃ v', v' 192=1 ∧
      v' 84=w*(z-1)/(2*x^(4:ℕ)-3*x^(2:ℕ)-2)-v' 42 ∧
      negativeRowsAConclusion x y z w a b v' ∧
      negativeRowsBConclusion x y z w a b v' ∧
      a= -x-1/x ∧ b=(x^(4:ℕ)-x^(2:ℕ)-2)/y ∧
      w=x^(2:ℕ)*z-x^(2:ℕ)-1 ∧ 2*x^(4:ℕ)-3*x^(2:ℕ)-2≠0 := by
  have hu5n : u5≠0 := by rcases hu5 with rfl|rfl <;> norm_num
  have hu7n : u7≠0 := by rcases hu7 with rfl|rfl <;> norm_num
  let x := primeParameter 2 m s
  let y := primeParameter 3 m s
  let z := (u5*primeParameter 5 m s)
  let w := (u7*primeParameter 7 m s)
  let a := (Real.sqrt 2:ℂ)*f 2
  let b := (Real.sqrt 3:ℂ)*f 3
  have hx : x≠0 := primeParameter_ne_zero 2 m (by decide) s
  have hy : y≠0 := primeParameter_ne_zero 3 m (by decide) s
  change x^(4:ℕ)+y^(2:ℕ)-1=0 at hA
  obtain ⟨v',hv',h192,hAr,hBr,he⟩ := original_signed_negative_normalized_system
    hm hf ε hε hlaw u5 u7 hu5 hu7 hphase h5 h7 BG G hG hGF s v hv hshift hr
  have hr' : v' 192≠0 := by rw [h192]; norm_num
  obtain ⟨hp,hwrel,hC,_⟩ := original_signed_negative_all_branch
    hm hf ε hε hlaw u5 u7 hu5 hu7 hphase h5 h7 BG G hG hGF s v' hv' hshift hr' hz
  obtain ⟨_,_,hc⟩ := original_signed_negative_branch_parameter
    hm hf ε hε hlaw u5 u7 hu5 hu7 hphase h5 h7 BG G hG hGF s v' hv' hshift hr' hz
  change x^(4:ℕ)-x^(2:ℕ)-y*b-2=0 at hp
  change x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1≠0 at hC
  change (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(v' 84+v' 42)=w*(z-1)*v' 192 at hc
  change 1+x*a+x^(2:ℕ)=0 at he
  have hc0 : 2*x^(4:ℕ)-3*x^(2:ℕ)-2≠0 := by
    intro hh; apply hC; linear_combination hh-hA
  have hcnorm : -2-x^(2:ℕ)*3+x^(4:ℕ)*2≠0 := by
    convert hc0 using 1; ring
  rw [h192,mul_one] at hc
  refine ⟨v',h192,?_,hAr,hBr,?_,?_,hwrel,hc0⟩
  · change v' 84=w*(z-1)/(2*x^(4:ℕ)-3*x^(2:ℕ)-2)-v' 42
    linear_combination (norm := (field_simp [hc0]; ring_nf; field_simp [hcnorm]; ring))
      (1/(2*x^(4:ℕ)-3*x^(2:ℕ)-2))*(hc+(v' 84+v' 42)*hA)
  · change a= -x-1/x
    linear_combination (norm := (field_simp [hx]; ring)) (1/x)*he
  · change b=(x^(4:ℕ)-x^(2:ℕ)-2)/y
    linear_combination (norm := (field_simp [hy]; ring)) -(1/y)*hp

#print axioms original_signed_negative_a0_normalization

}

end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
end

/-! ## ThirtyFiveSignedMixedPivot -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords

certificate_batch {
theorem signed_a0_mixed_pivot (m : ℕ) (s u5 u7 : ℂ) (hu5 : u5=1 ∨ u5= -1) (hu7 : u7=1 ∨ u7= -1) (hs : (m:ℝ)≤s.re)
    (hA : (primeParameter 2 m s)^(4:ℕ)+(primeParameter 3 m s)^(2:ℕ)-1=0)
    (hw : (u7*primeParameter 7 m s)=(primeParameter 2 m s)^(2:ℕ)*(u5*primeParameter 5 m s)-
      (primeParameter 2 m s)^(2:ℕ)-1) :
    (primeParameter 2 m s)^(2:ℕ)*(u5*primeParameter 5 m s)-
      (primeParameter 2 m s)^(2:ℕ)-(u5*primeParameter 5 m s)≠0 := by
  let X := (primeParameter 2 m s)^(2:ℕ)
  let Y := (primeParameter 3 m s)^(2:ℕ)
  let Z := (u5*primeParameter 5 m s)
  let W := (u7*primeParameter 7 m s)
  change W=X*Z-X-1 at hw
  change X*Z-X-Z≠0
  intro hp
  have hzw : Z=X*W := by linear_combination -X*hw-(1+X)*hp
  have hmw : (X-1)*W=1 := by linear_combination (X-1)*hw+X*hp
  have hZle : ‖Z‖≤‖W‖ := by
    dsimp [Z,W]
    rw [sign_mul_norm u5 _ hu5,sign_mul_norm u7 _ hu7,primeParameter_norm 5 m (by decide),primeParameter_norm 7 m (by decide)]
    exact Real.rpow_le_rpow (by norm_num) (by norm_num) (sub_nonneg.mpr hs)
  have hWpos : 0<‖W‖ := by
    dsimp [W]
    rw [sign_mul_norm u7 _ hu7,primeParameter_norm 7 m (by decide)]
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hN := congrArg norm hzw
  rw [norm_mul X W] at hN
  have hXge : 1≤‖X‖ := (physical_parameters m s hs).1
  have hX : ‖X‖=1 := by nlinarith
  have hx := primeParameter_pow_norm 2 m 2 (by decide) s
  change ‖X‖=(((2:ℕ):ℝ)^2)^(s.re-(m:ℝ)) at hx
  rw [hX] at hx
  norm_num only [Nat.cast_ofNat] at hx
  have ha : s.re-(m:ℝ)=0 :=
    (Real.rpow_right_inj (by norm_num : (0:ℝ)<4) (by norm_num : (4:ℝ)≠1)).mp
      (by simpa only [Real.rpow_zero] using hx.symm)
  have hW : ‖W‖=1 := by
    dsimp [W]
    rw [sign_mul_norm u7 _ hu7,primeParameter_norm 7 m (by decide),ha,Real.rpow_zero]
  have hXm : ‖X-1‖=1 := by
    have h := congrArg norm hmw
    simpa only [norm_mul,hW,mul_one,norm_one] using h
  have hY : ‖1-X^(2:ℕ)‖=1 := by
    have he : 1-X^(2:ℕ)=Y := by
      dsimp [X,Y]
      linear_combination -hA
    rw [he]
    dsimp [Y]
    rw [primeParameter_pow_norm 3 m 2 (by decide),ha,Real.rpow_zero]
  exact unit_triangle_square_not_unit X hX hXm hY

#print axioms signed_a0_mixed_pivot
}

end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
end

