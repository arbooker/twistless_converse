module

public import AsymptoticProjectiveIntegralV1
public import AsymptoticCongruenceTransvectionsV1

set_option autoImplicit false
set_option maxHeartbeats 1000000
@[expose] public section

namespace AsymptoticSimpleJoin

open Matrix AsymptoticCongruenceLabels AsymptoticRationalGroup
open AsymptoticRationalBranches AsymptoticRationalFreeness AsymptoticMobiusFold
open scoped MatrixGroups

/-- A unit-determinant element of the group generated by the two old
congruence groups, before passage to projective labels. -/
def witnessGL (M p : ℕ) : GL (Fin 2) ℚ :=
  translation (1/(p:ℚ))*rationalGL (lowerSL M 1)

def scaledMatrix (M p : ℕ) : Matrix (Fin 2) (Fin 2) ℤ :=
  !![(p:ℤ)+M,1; (p:ℤ)*M,p]

theorem witness_det (M p : ℕ) : (witnessGL M p).val.det=1 := by
  change ((translation (1/(p:ℚ))).val*(rationalGL (lowerSL M 1)).val).det=1
  rw [Matrix.det_mul]
  have h : (rationalGL (lowerSL M 1)).val.det=1 := by
    change ((lowerSL M 1).val.map (fun z : ℤ => (z:ℚ))).det=1
    rw [← Int.cast_det,(lowerSL M 1).property,Int.cast_one]
  rw [h,mul_one]
  simp [translation,GeneralLinearGroup.mkOfDetNeZero]

theorem scaled_eq (M p : ℕ) (hp : 0<p) :
    (scaledMatrix M p).map (Int.castRingHom ℚ)=(p:ℚ) • (witnessGL M p).val := by
  have hp' : (p:ℚ)≠0 := by exact_mod_cast hp.ne'
  change (scaledMatrix M p).map (Int.castRingHom ℚ)=
    (p:ℚ) • ((translation (1/(p:ℚ))).val*(lowerSL M 1).val.map (fun z : ℤ => (z:ℚ)))
  ext i j
  simp only [Matrix.map_apply,Matrix.smul_apply,Matrix.mul_apply,Fin.sum_univ_two,
    smul_eq_mul]
  fin_cases i <;> fin_cases j <;>
    norm_num [scaledMatrix,translation,GeneralLinearGroup.mkOfDetNeZero,lowerSL,
      AsymptoticFreshCRT.lower]
  all_goals field_simp

/-- Reduction modulo p keeps the upper-left power equal to M^n.
This detects the unbounded denominator of the rational witness powers. -/
theorem scaled_pow_mod (M p n : ℕ) [Fact p.Prime] :
    (((scaledMatrix M p)^n) 0 0 : ZMod p)=(M:ZMod p)^n ∧
    (((scaledMatrix M p)^n) 1 0 : ZMod p)=0 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ']
    simp only [Matrix.mul_apply,Fin.sum_univ_two]
    change (((((p:ℤ)+M)*((scaledMatrix M p)^n) 0 0+
      1*((scaledMatrix M p)^n) 1 0):ℤ):ZMod p)=(M:ZMod p)^(n+1) ∧
      (((((p:ℤ)*M)*((scaledMatrix M p)^n) 0 0+
      (p:ℤ)*((scaledMatrix M p)^n) 1 0):ℤ):ZMod p)=0
    push_cast
    simp [ih.1,ih.2,pow_succ']

theorem scaled_pow_eq (M p n : ℕ) (hp : 0<p) :
    ((scaledMatrix M p)^n).map (Int.castRingHom ℚ)=
      (p:ℚ)^n • (witnessGL M p).val^n := by
  rw [Matrix.map_pow,scaled_eq M p hp,smul_pow]

/-- No positive power of the rational witness has integral upper-left
entry when p does not divide M. -/
theorem witness_pow_not_integral (M p n : ℕ) [Fact p.Prime]
    (hpM : ¬p∣M) (hn : 0<n) :
    ¬∃ a : ℤ, ((witnessGL M p)^n).val 0 0=(a:ℚ) := by
  rintro ⟨a,ha⟩
  have he := congrArg (fun B : Matrix (Fin 2) (Fin 2) ℚ => B 0 0)
    (scaled_pow_eq M p n (Fact.out : p.Prime).pos)
  change (((scaledMatrix M p)^n) 0 0 : ℚ)=(p:ℚ)^n*((witnessGL M p)^n).val 0 0 at he
  rw [ha] at he
  have he' : ((scaledMatrix M p)^n) 0 0=(p:ℤ)^n*a := by exact_mod_cast he
  have hd : (p:ℤ)∣((scaledMatrix M p)^n) 0 0 := by
    rw [he']
    exact dvd_mul_of_dvd_left (dvd_pow_self (p:ℤ) hn.ne') a
  have hz : (((scaledMatrix M p)^n) 0 0 : ZMod p)=0 := (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr hd
  rw [(scaled_pow_mod M p n).1] at hz
  have hm : (M:ZMod p)≠0 := by
    exact fun h => hpM ((ZMod.natCast_eq_zero_iff M p).mp h)
  exact (pow_ne_zero n hm) hz

