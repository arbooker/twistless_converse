    apply eval_congr_support
    intro t ht
    simp only [mixedInput,ite_eq_left (hL t ht)]
  have hr : eval x y z w a b c
      (fun j => eval x y z w a b c v (mixedInput (j+4518))) R=0 := by
    apply eval_zero_of_support
    intro t ht
