module

public import SmallLevelThirtySixWordsV1
public import Mathlib.Data.ZMod.Basic

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000
@[expose] public section

namespace SmallLevelThirtySix

open Matrix ModularGroup
open scoped MatrixGroups

abbrev ResidueGroup := SL(2, ZMod 6)
def reductionSix : SL(2,ℤ) →* ResidueGroup := SpecialLinearGroup.map (Int.castRingHom (ZMod 6))

def positiveStepS (v : Coefficients) : Coefficients := (v.1,v.2.2,v.2.1)
def positiveStepT (v : Coefficients) : Coefficients := (-v.2.1+v.2.2,v.1+v.2.1,-v.2.2)
def negativeStepS (v : Coefficients) : Coefficients := (-v.1,-v.2.1,0)
def negativeStepT (v : Coefficients) : Coefficients := (-v.2.1,v.1+v.2.1,0)

