theorem residue_one : residueCoefficients 1=((1,0,0),(1,0,0)) := by decide
theorem residue_neg_one : residueCoefficients (-1)=((1,0,0),(1,0,0)) := by decide

theorem residue_S : ∀ A : ResidueGroup,
    residueCoefficients (A*reductionSix S)=
      (positiveStepS (residueCoefficients A).1,negativeStepS (residueCoefficients A).2) := by decide

theorem residue_T : ∀ A : ResidueGroup,
    residueCoefficients (A*reductionSix T)=
      (positiveStepT (residueCoefficients A).1,negativeStepT (residueCoefficients A).2) := by decide

#print axioms residue_one
#print axioms residue_neg_one
#print axioms residue_S
#print axioms residue_T

end SmallLevelThirtySix
