compact_certificate theorem all_normal_basis_zero : ∀ i<146, substitute basis (normal i)=[] := by
  let P : ℕ → Prop := fun i => substitute basis (normal i)=[]
  have h : ∀ i<146, P (i+0) := (finite_range% P 0 [
    8 => (fun i hi => normal_basis_zero_0 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_1 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_2 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_3 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_4 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_5 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_6 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_7 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_8 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_9 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_10 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_11 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_12 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_13 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_14 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_15 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_16 ⟨i,hi⟩),
    8 => (fun i hi => normal_basis_zero_17 ⟨i,hi⟩),
    2 => (fun i hi => normal_basis_zero_18 ⟨i,hi⟩)
  ])
  exact h
#print axioms all_normal_basis_zero
compact_certificate theorem all_triangular_checked : ∀ i<150, mergeFuel 20000 [(1,coordinate i,(0,0,0,0,0,0,0))] (triTail i)=unitTri i := by
  let P : ℕ → Prop := fun i => mergeFuel 20000 [(1,coordinate i,(0,0,0,0,0,0,0))] (triTail i)=unitTri i
  have hFin : ∀ i : Fin 150, P i.val := kernel_range% P 150 block 8
  have h : ∀ i<150, P (i+0) := fun i hi => hFin ⟨i,hi⟩
  exact h
#print axioms all_triangular_checked
compact_certificate theorem all_triangular_prior : ∀ i<150, ∀ t∈triTail i, t.2.1<150 ∧ i<position t.2.1 := by
  let P : ℕ → Prop := fun i => ∀ t∈triTail i, t.2.1<150 ∧ i<position t.2.1
  have hFin : ∀ i : Fin 150, P i.val := kernel_range% P 150 block 8
  have h : ∀ i<150, P (i+0) := fun i hi => hFin ⟨i,hi⟩
  exact h
#print axioms all_triangular_prior
compact_certificate theorem basis_free_coordinate : ∀ i : Fin 4, basis (coordinate (i.val+146))=[(1,i.val,(0,0,0,0,0,0,0))] := by decide +kernel
compact_certificate theorem coordinate_bound : ∀ i : Fin 150, coordinate i.val<150 := by decide +kernel
compact_certificate theorem position_bound : ∀ i : Fin 150, position i.val<150 := by decide +kernel
compact_certificate theorem coordinate_position : ∀ i : Fin 150, coordinate (position i.val)=i.val := by decide +kernel
#print axioms basis_free_coordinate
#print axioms coordinate_bound
#print axioms position_bound
#print axioms coordinate_position
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
end
