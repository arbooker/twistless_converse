compact_certificate def germCombinedOperation (j : ℕ) : Poly := substitute germResidualOperation (germOperation (selectedGerm j))
compact_certificate theorem germCombined_support (j : Fin 2) : Supported 213 (germCombinedOperation j.val) :=
  supported_substitute _ _ (germOperation_support j) (fun i hi => germResidualOperation_support ⟨i,hi⟩)

compact_certificate theorem germ_combined_lower (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0) (j : Fin 2) :
    eval x y z w a b c (fun i => eval x y z w a b c v (germLowerSource i))
      (germCombinedOperation j.val)=0 := by
  unfold germCombinedOperation
  rw [eval_substitute _ _ _ _ _ _ _ _ hx hy hz hw]
  have h : eval x y z w a b c
      (fun i => eval x y z w a b c
        (fun t => eval x y z w a b c v (germLowerSource t)) (germResidualOperation i))
      (germOperation (selectedGerm j.val))=
      eval x y z w a b c (fun i => eval x y z w a b c v (germResidualLower i))
        (germOperation (selectedGerm j.val)) := by
    apply eval_congr_support
    intro t ht
    rw [← eval_substitute _ _ _ _ _ _ _ _ hx hy hz hw,
      germ_selected_residual_lower t.2.1 (germOperation_selected_support j t ht)]
  rw [h]
  exact substitution_zero _ _ _ _ _ _ _ _ hx hy hz hw _ _ (germ_selected_eliminate_lower j)

compact_certificate theorem germ_combined_upper (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0) (j : Fin 2) :
    eval x y z w a b c (fun i => eval x y z w a b c v
      (substitute basis (germRawShift i))) (germCombinedOperation j.val)=
      eval x y z w a b c v (germConstraint (selectedGerm j.val)) := by
  unfold germCombinedOperation
  rw [eval_substitute _ _ _ _ _ _ _ _ hx hy hz hw]
  have h : eval x y z w a b c
      (fun i => eval x y z w a b c
        (fun t => eval x y z w a b c v (substitute basis (germRawShift t))) (germResidualOperation i))
      (germOperation (selectedGerm j.val))=
      eval x y z w a b c (fun i => eval x y z w a b c v (germResidualUpper i))
        (germOperation (selectedGerm j.val)) := by
    apply eval_congr_support
    intro t ht
    rw [← eval_substitute _ _ _ _ _ _ _ _ hx hy hz hw,
      germ_selected_residual_upper t.2.1 (germOperation_selected_support j t ht)]
  rw [h,← eval_substitute _ _ _ _ _ _ _ _ hx hy hz hw,germ_selected_eliminate_upper j]

#print axioms germCombined_support
#print axioms germ_combined_lower
#print axioms germ_combined_upper
