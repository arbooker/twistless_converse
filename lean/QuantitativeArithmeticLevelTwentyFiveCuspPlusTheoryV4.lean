compact_certificate def selectedPoint (i : Fin 450) : Fin 3 := ⟨point i.val,point_bound i⟩

compact_certificate theorem normalized_equations_kill_old_grid (c : ℂ) (v : Fin 3 × Fin 1050 → ℂ)
    (h : ∀ i : Fin 450,
      eval 1 1 1 1 0 0 c (periodicVector (fun j => v (selectedPoint i,j)))
        (plusExceptionalPoly (point i.val) (rawSourcePoly 1 (actual i.val)))=
      ∑ a∈Finset.range (point i.val),
        eval 1 1 1 1 0 0 c (periodicVector (fun j => v (lowerIndex (selectedPoint i) a,j)))
          (plusExceptionalPoly (point i.val) (rawHigherJetPoly 1 (a+1) (actual i.val)))/((a+1).factorial:ℂ)) :
    ∀ j<450,cuspVector v j=0 := by
  have hs : ∀ i : Fin 450,eval 1 1 1 1 0 0 c (cuspVector v) (source i.val)=0 := by
    intro i
    rw [← cuspBlockLift_eval 1 1 1 1 0 0 c v,← actual_block i,
      eval_normalizedPoly _ _ _ _ _ _ _ _ (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
    have he := plusExceptionalBlock_eval c v (selectedPoint i) (actual i.val) (leading_support i)
      (fun a ha => shift_support i ⟨a,by have hi:=point_bound i; omega⟩)
    change eval _ _ _ _ _ _ _ _ (plusExceptionalBlockPoly (point i.val) (actual i.val))=_ at he
    rw [he]
    exact sub_eq_zero.mpr (h i)
  apply kernel_zero
  intro j hj
  have he : eval 1 1 1 1 0 0 0 (cuspVector v) (source j)=
      eval 1 1 1 1 0 0 c (cuspVector v) (source j) := by
    unfold eval
    congr 1
    apply List.map_congr_left
    intro t ht
    simp only [monomial,source_inert ⟨j,hj⟩ t ht,pow_zero]
  exact he.trans (hs ⟨j,hj⟩)

#print axioms normalized_equations_kill_old_grid
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusExceptionalBlock
