compact_certificate theorem basis_thirty : basis 30=[(1,3,(0,0,0,0,0,0,0))] := by decide +kernel
compact_certificate theorem basis_sixty : basis 60=[(-1,3,(0,0,0,0,0,0,0))] := by decide +kernel
compact_certificate theorem basis_ninety : basis 90=[(-1,3,(0,0,0,0,0,0,0))] := by decide +kernel

compact_certificate theorem denominator_five_relations (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (h : ∀ i<1198, eval x y z w a b c v (source i)=0) :
    v 30=v 120 ∧ v 60= -v 120 ∧ v 90= -v 120 := by
  have hp := leading_parametrization x y z w a b c v hx hy hz hw h
  have h30 := hp 30 (by decide)
  have h60 := hp 60 (by decide)
  have h90 := hp 90 (by decide)
  rw [basis_thirty] at h30
  rw [basis_sixty] at h60
  rw [basis_ninety] at h90
  refine ⟨?_,?_,?_⟩
  · simpa [eval,monomial,show coordinate (3+146)=120 from rfl] using h30
  · simpa [eval,monomial,show coordinate (3+146)=120 from rfl] using h60
  · simpa [eval,monomial,show coordinate (3+146)=120 from rfl] using h90
#print axioms denominator_five_relations
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
end
