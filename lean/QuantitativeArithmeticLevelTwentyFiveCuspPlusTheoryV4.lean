/-! ## TwentyFiveCuspPlusRegularizedFirstGerm -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
open Complex Matrix QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector

/- The two sufficient first-jet syzygies constrain the regularized principal vector
also at the weight. The vanishing factor is absorbed into the grid. -/
compact_certificate theorem regularized_pole_first_germ (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= 1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (j : Fin 2) :
    eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun i => eval (primeParameter 2 m s) (primeParameter 3 m s)
        (primeParameter 5 m s) (primeParameter 7 m s)
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
        (fun t => periodicVector v (7*t)) (germRawShift i)) (germCombinedOperation j.val)=0 := by
  classical
  let O := germCombinedOperation j.val
  by_cases hO : O=[]
  · change eval _ _ _ _ _ _ _ _ O=0
    rw [hO,eval_nil]
  let ι := Fin O.length
  have bound (t : ι) : (O.get t).2.1<213 :=
    germCombined_support j (O.get t) (List.get_mem O t)
  let : Nonempty ι := ⟨⟨0,List.length_pos_iff.mpr hO⟩⟩
  let rows : ι → Row := fun t => germRows (O.get t).2.1
  let P : ι → Poly := fun t => AuxPlusLaurent.source (germAuxIndex (O.get t).2.1)
  let Q : ι → Poly := fun t => AuxPlusLaurent.tail (germAuxIndex (O.get t).2.1)
  have hP (t : ι) : normalizedPoly (rawSourcePoly 1 (.physical (rows t)))=P t := by
    have hh := germ_aux_source ⟨(O.get t).2.1,bound t⟩
    rw [germRows_actual ⟨(O.get t).2.1,bound t⟩] at hh
    exact hh
  have hQ (t : ι) : normalizedPoly (rawTailPoly (.physical (rows t)))=Q t := by
    have hh := germ_aux_tail ⟨(O.get t).2.1,bound t⟩
    rw [germRows_actual ⟨(O.get t).2.1,bound t⟩] at hh
    exact hh
  have hPzero (t : ι) : substitute AuxPlusLaurent.basis (P t)=[] :=
    AuxPlusLaurent.all_source_zero ⟨germAuxIndex (O.get t).2.1,
      germAuxIndex_bound ⟨(O.get t).2.1,bound t⟩⟩
  have hQzero (t : ι) : substitute AuxPlusLaurent.basis (Q t)=[] :=
    AuxPlusLaurent.all_tail_zero ⟨germAuxIndex (O.get t).2.1,
      germAuxIndex_bound ⟨(O.get t).2.1,bound t⟩⟩
  let K : ℂ → ι → ℂ := fun z t => ((O.get t).1:ℂ)*monomial
    (primeParameter 2 m (z+1)) (primeParameter 3 m (z+1))
    (primeParameter 5 m (z+1)) (primeParameter 7 m (z+1))
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7) (O.get t).2.2
  have hpa (p : ℕ) (hp : p≠0) (z : ℂ) :
      AnalyticAt ℂ (fun w => primeParameter p m (w+1)) z := by
    unfold primeParameter
    simp_rw [Complex.cpow_def_of_ne_zero (by exact_mod_cast hp : (p:ℂ)≠0)]
    fun_prop
  have hpn (p : ℕ) (hp : p≠0) (z : ℂ) : primeParameter p m (z+1)≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hK (z : ℂ) (t : ι) : AnalyticAt ℂ (fun w => K w t) z := by
    apply AnalyticAt.mul analyticAt_const
    exact monomial_analytic _ _ _ _ _ _ _ _ _
      (hpa 2 (by decide) z) (hpa 3 (by decide) z) (hpa 5 (by decide) z) (hpa 7 (by decide) z)
      (hpn 2 (by decide) z) (hpn 3 (by decide) z) (hpn 5 (by decide) z) (hpn 7 (by decide) z)
  have hKA (z : ℂ) (w : Fin 1050 → ℂ) :
      ∑ t, K z t*leading (rows t) m f ε z w=0 := by
    have hh := germ_leading_syzygy hf ε (z+1) hχ w j
    rw [eval_eq_sum_fin] at hh
