compact_certificate theorem positive_branch_signs (x y b : ℂ) (hxy : 9*x^2=4*y^2)
    (hb : b= -y-3/y) :
    ∃ σ : ℂ, (σ=1 ∨ σ= -1) ∧ y=σ*(3*x/2) ∧ b=σ*(-3*x/2-2/x) := by
  have hsq : y^2=(3*x/2)^2 := by linear_combination -hxy/4
  rcases (sq_eq_sq_iff_eq_or_eq_neg).mp hsq with h | h
  · refine ⟨1,Or.inl rfl,by simpa using h,?_⟩
    rw [hb,h]
    field_simp
  · refine ⟨-1,Or.inr rfl,by simpa using h,?_⟩
    rw [hb,h]
    field_simp
    ring

/- For the positive sign, the surviving denominator-five pole away from
the weight is at normalized Mellin coordinate 3/2. -/
compact_certificate theorem pole_exceptional_location_allowed
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hpole : ∃ j, meromorphicOrderAt (fun z => G z j) s<0)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hs : s≠((2*m:ℕ):ℂ)) (hu : v ⟨840,by decide⟩≠0) :
    s=(m:ℂ)+1 ∧ (Real.sqrt 2:ℂ)*f 2= -3 ∧ (Real.sqrt 3:ℂ)*f 3= -4 := by
  obtain ⟨ha,hb⟩ := pole_hecke_parameters_allowed AuxPlusLaurent.freeCoordinate hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hshift hweight hu
  have hj := pole_germ_constraints_allowed AuxPlusLaurent.freeCoordinate hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hshift hweight hs
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hxy := germ_square_relation _ _ _ _ _ _ _
    (fun t => periodicVector v (7*coordinate (t+146)))
    (hn 2 (by decide)) (hn 3 (by decide)) ha hb
    (by simpa [periodicVector,show coordinate (3+146)=120 from rfl] using hu)
    (hj ⟨0,by decide⟩) (hj ⟨1,by decide⟩)
  obtain ⟨σ,hσ,hy,hb'⟩ := positive_branch_signs _ _ _ hxy hb
  obtain ⟨hre,hcircle⟩ := QuantitativeArithmeticSmallLevelTwentyFiveCuspCircle.physical_circle
    (s-(m:ℂ)) hxy
  have hβ1 : s-((2*m:ℕ):ℂ)-1≠0 := by
    intro h
    have hr := congrArg Complex.re h
    norm_num [Complex.sub_re] at hr hre
    have hm' : (0:ℝ)< m := by exact_mod_cast hm
    linarith
  have hstack (b : Fin 3 × Fin 1050) : MeromorphicAt (fun z => stackGrid 2 G z b) s :=
    (hG b.2 (s-b.1.val)).meromorphicAt.comp_analyticAt
      (g:=fun z : ℂ => z-(b.1.val:ℂ)) (analyticAt_id.sub analyticAt_const)
  have hpstack : ∃ b : Fin 3 × Fin 1050, meromorphicOrderAt (fun z => stackGrid 2 G z b) s<0 := by
    obtain ⟨i,hi⟩ := hpole
    exact ⟨(0,i),by simpa only [stackGrid,Fin.val_zero,Nat.cast_zero,sub_zero] using hi⟩
  obtain ⟨w,hw⟩ := exists_leading_vector (stackGrid 2 G) s hstack hpstack
  have h2 := CuspPlusThreePoint.three_point_circle_exceptional hm hf ε hε hlaw hχ BG G hG hGF
    s w hw hshift hweight (sub_ne_zero.mpr hs) hβ1 σ hσ hy ha hb' hcircle
  have h3 : (primeParameter 3 m s)^2=9 := by linear_combination (9*h2-hxy)/4
  have he := QuantitativeArithmeticSmallLevelTwentyFiveCuspCircle.exceptional_exponent (s-(m:ℂ)) h2 h3
  have hs0 : s=(m:ℂ)+1 := by linear_combination he
  have hp2 : primeParameter 2 m s=2 := by simp only [primeParameter,he,Complex.cpow_one,Nat.cast_ofNat]
  have hp3 : primeParameter 3 m s=3 := by simp only [primeParameter,he,Complex.cpow_one,Nat.cast_ofNat]
  rw [hp2] at ha
  rw [hp3] at hb
  norm_num at ha hb
  exact ⟨hs0,ha,hb⟩

#print axioms positive_branch_signs
#print axioms pole_exceptional_location_allowed
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
end
end

/-! ## TwentyFiveCuspPlusCuspPoleZeroAllowed -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- The positive-sign denominator-five principal coordinate vanishes at a
rightmost pole away from the weight; a simple weight pole above it is allowed. -/
compact_certificate theorem pole_denominator_five_zero_allowed
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hpole : ∃ j,meromorphicOrderAt (fun z => G z j) s<0)
    (hshift : ∀ n : ℕ,0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j,0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j,(-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hs : s≠((2*m:ℕ):ℂ)) : v ⟨840,by decide⟩=0 := by
  by_contra hu
  obtain ⟨hs0,h2,h3⟩ := pole_exceptional_location_allowed hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hpole hshift hweight hs hu
  have hm2 : 2≤ m := by
    by_contra h
    have hm1 : m=1 := by omega
    subst m
    apply hs
    norm_num at hs0 ⊢
    exact hs0
  have hstack (b : Fin 3 × Fin 1050) : MeromorphicAt (fun z => stackGrid 2 G z b) ((m:ℂ)+1) :=
    (hG b.2 ((m:ℂ)+1-b.1.val)).meromorphicAt.comp_analyticAt
      (g:=fun z : ℂ => z-(b.1.val:ℂ)) (analyticAt_id.sub analyticAt_const)
  have hpstack : ∃ b : Fin 3 × Fin 1050,
      meromorphicOrderAt (fun z => stackGrid 2 G z b) ((m:ℂ)+1)<0 := by
    obtain ⟨i,hi⟩ := hpole
    refine ⟨(0,i),?_⟩
    simpa only [stackGrid,Fin.val_zero,Nat.cast_zero,sub_zero,← hs0] using hi
  obtain ⟨w,hw⟩ := exists_leading_vector (stackGrid 2 G) ((m:ℂ)+1) hstack hpstack
  apply CuspPlusExceptionalBlock.exceptional_three_point_impossible hm2 hf ε hε hlaw hχ BG G
    hG hGF w hw _ hweight h2 h3
  simpa only [hs0] using hshift

#print axioms pole_denominator_five_zero_allowed
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
end
end

/-! ## TwentyFiveCuspPlusAllFivePoleZero -/
section
