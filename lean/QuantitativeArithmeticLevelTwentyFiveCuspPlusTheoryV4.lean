/-! ## TwentyFivePlusRegularizedThreePointEval -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid SmallLevelFiniteShift
open QuantitativeArithmeticRegularizedJetScale

compact_certificate def threePointRegularizedScale (n : Fin 3) : ℂ := regularizedJetScale (threePointToFour n)
compact_certificate def normalizeRegularizedThree (v : Fin 3 × Fin 1050 → ℂ) (b : Fin 3 × Fin 1050) : ℂ :=
  (threePointRegularizedScale b.1)⁻¹*v b

compact_certificate theorem threePointRegularizedScale_ne_zero (n : Fin 3) : threePointRegularizedScale n≠0 :=
  regularizedJetScale_ne_zero _

compact_certificate theorem normalizeRegularizedThree_cancel (v : Fin 3 × Fin 1050 → ℂ) (n : Fin 3) :
    threePointRegularizedScale n • (fun j => normalizeRegularizedThree v (n,j))=
      (fun j => v (n,j)) := by
  funext j
  simp only [Pi.smul_apply,smul_eq_mul,normalizeRegularizedThree,← mul_assoc,
    mul_inv_cancel₀ (threePointRegularizedScale_ne_zero n),one_mul]

compact_certificate theorem threePointToFour_lower (n : Fin 3) (a : ℕ) :
    threePointToFour (lowerIndex n a)=lowerIndex (threePointToFour n) a := by
  rfl

compact_certificate theorem plus_higherJetEval_exceptional {f : ℕ → ℂ}
    (h2 : (Real.sqrt 2:ℂ)*f 2= -3) (h3 : (Real.sqrt 3:ℂ)*f 3= -4)
    (r : SourceRow) (n h : ℕ) (v : Fin 1050 → ℂ) :
    higherJetEval 1 f 1 r h (2-n) v=
      eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7) (periodicVector v)
        (plusExceptionalPoly n (rawHigherJetPoly 1 h r)) := by
  have hp (p : ℕ) (hp0 : p≠0) : primeParameter p 1 (2-n)=(p:ℂ)/(p:ℂ)^n := by
    have he := primeParameter_exceptional p 1 n hp0
    norm_num at he
    exact he
  simp only [higherJetEval,hp 2 (by decide),hp 3 (by decide),hp 5 (by decide),
    hp 7 (by decide),h2,h3,plusExceptionalPoly_eval,Nat.cast_ofNat]

compact_certificate theorem plus_regularized_three_top {f : ℕ → ℂ}
    (h2 : (Real.sqrt 2:ℂ)*f 2= -3) (h3 : (Real.sqrt 3:ℂ)*f 3= -4)
    (r : SourceRow) (n : Fin 3) (hn : n≠0) (v : Fin 1050 → ℂ) :
    regularizedTaylor f 1 r (threePointToFour n) 2 v=
      threePointRegularizedScale n*
        (eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7) (periodicVector v)
          (plusExceptionalPoly n.val (rawHigherJetPoly 1 n.val r))/(n.val.factorial:ℂ)) := by
  have hn4 : threePointToFour n≠0 := by
    intro h
    apply hn
    exact Fin.ext (congrArg (fun t : Fin 4 => t.val) h)
  rw [regularizedTaylor,regularizedJetScale_top _ hn4]
  change (threePointRegularizedScale n/(n.val.factorial:ℂ))*
    higherJetEval 1 f 1 r n.val (2-n.val) v=_
  rw [plus_higherJetEval_exceptional h2 h3]
  ring

compact_certificate theorem plus_regularized_three_lower {f : ℕ → ℂ} (ε : ℂ)
    (hχ : ε*Complex.I^(2*1)=1)
    (h2 : (Real.sqrt 2:ℂ)*f 2= -3) (h3 : (Real.sqrt 3:ℂ)*f 3= -4)
    (r : Row) (n : Fin 3) (a : ℕ) (ha : a<n.val-1) (v : Fin 1050 → ℂ) :
    shifted r 1 f ε a (2-n.val) (threePointRegularizedScale (lowerIndex n a) • v)=
      threePointRegularizedScale n*
        (eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7) (periodicVector v)
          (plusExceptionalPoly n.val (rawHigherJetPoly 1 (a+1) (.physical r)))/((a+1).factorial:ℂ)) := by
  rw [shifted_smul]
  have he := eval_rawHigherJetPoly (.physical r) 1 f ε (2-n.val) 1 (by simpa using hχ) a v
  simp only [sourceShifted] at he
  rw [he]
  have harg : (2:ℂ)-(n.val:ℂ)+((a+1:ℕ):ℂ)-((2*1:ℕ):ℂ)=
      -(n.val:ℂ)+((a+1:ℕ):ℂ) := by norm_num; ring
  rw [harg]
  change threePointRegularizedScale (lowerIndex n a)*
    ((Complex.I^(a+1)*Ring.choose (-(n.val:ℂ)+((a+1:ℕ):ℂ)) (a+1))*
      higherJetEval 1 f 1 (.physical r) (a+1) (2-n.val) v)=_
  rw [plus_higherJetEval_exceptional h2 h3]
  have hs := regularizedJetScale_lower (threePointToFour n) a ha
  change Complex.I^(a+1)*Ring.choose (-(n.val:ℂ)+((a+1:ℕ):ℂ)) (a+1)*
    threePointRegularizedScale (lowerIndex n a)=threePointRegularizedScale n/((a+1).factorial:ℂ) at hs
  calc
    _ = (Complex.I^(a+1)*Ring.choose (-(n.val:ℂ)+((a+1:ℕ):ℂ)) (a+1)*
        threePointRegularizedScale (lowerIndex n a))*
      eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7) (periodicVector v)
        (plusExceptionalPoly n.val (rawHigherJetPoly 1 (a+1) (.physical r))) := by ring
    _ = _ := by rw [hs]; ring

#print axioms plus_regularized_three_top
#print axioms plus_regularized_three_lower
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFivePlusRegularizedNormalizedRows -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- The positive weight-two regularized rows give the same three-point rational kernel. -/
compact_certificate theorem plus_normalized_regularized_three_rows (basis : ℕ → Poly) (free : Fin 68 → Fin 1050)
    (hperiodic : ∀ j, basis (j%1050)=basis j)
    (r : Row) (p q : Poly)
    (hp : normalizedPoly (rawSourcePoly 1 (.physical r))=p)
    (hq : normalizedPoly (rawTailPoly (.physical r))=q)
    (hpzero : substitute basis p=[]) (hqzero : substitute basis q=[])
    {f : ℕ → ℂ} (hf : FinitenessOriginalInput.IsSolution 25 (2*1) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*1) f ε)
    (hχ : ε*Complex.I^(2*1)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis free 1 f z (gridVector 1050 (2*1) f z))
    (v : Fin 3 × Fin 1050 → ℂ) (hv : IsLeadingVector (regularizedStack 2 G 2) 2 v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (2+n))
    (h2 : (Real.sqrt 2:ℂ)*f 2= -3) (h3 : (Real.sqrt 3:ℂ)*f 3= -4) (n : Fin 3) :
    eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
      (periodicVector (fun j => normalizeRegularizedThree v (n,j)))
      (plusExceptionalPoly n.val (rawSourcePoly 1 (.physical r)))=
    ∑ a∈Finset.range n.val,
      eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
        (periodicVector (fun j => normalizeRegularizedThree v (lowerIndex n a,j)))
        (plusExceptionalPoly n.val (rawHigherJetPoly 1 (a+1) (.physical r)))/((a+1).factorial:ℂ) := by
  have h := physical_regularized_three_point_rows basis free hperiodic r 1 p q hp hq hpzero hqzero
    hf ε hε hlaw (by simpa using hχ) BG G hG hGF v hv hshift n
  have hnorm := normalizeRegularizedThree_cancel v
  have he := eval_rawSourcePoly (.physical r) hf ε (2-n.val) 1 (by simpa using hχ)
    (fun j => normalizeRegularizedThree v (n,j))
  have hpv (p : ℕ) (hp0 : p≠0) : primeParameter p 1 (2-n.val)=(p:ℂ)/(p:ℂ)^n.val := by
    have he := primeParameter_exceptional p 1 n.val hp0
    norm_num at he
    exact he
  simp only [sourceLeading,hpv 2 (by decide),hpv 3 (by decide),hpv 5 (by decide),
    hpv 7 (by decide),h2,h3,Nat.cast_ofNat] at he
  rw [← plusExceptionalPoly_eval] at he
  rw [← hnorm n,leading_smul,← he] at h
  by_cases hn : n=0
  · subst n
    simpa [threePointRegularizedScale,threePointToFour,
      QuantitativeArithmeticRegularizedJetScale.regularizedJetScale] using h
  rw [ite_eq_right hn,plus_regularized_three_top h2 h3 (.physical r) n hn] at h
  have h0 : (fun j => v (0,j))=(fun j => normalizeRegularizedThree v (0,j)) := by
    funext j
    simp [normalizeRegularizedThree,threePointRegularizedScale,threePointToFour,
      QuantitativeArithmeticRegularizedJetScale.regularizedJetScale]
  rw [h0] at h
  have hterms : ∀ a∈Finset.range (n.val-1),
      shifted r 1 f ε a (2-n.val) (fun j => v (lowerIndex n a,j))=
      threePointRegularizedScale n*
        (eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
          (periodicVector (fun j => normalizeRegularizedThree v (lowerIndex n a,j)))
          (plusExceptionalPoly n.val (rawHigherJetPoly 1 (a+1) (.physical r)))/((a+1).factorial:ℂ)) := by
    intro a ha
    rw [← hnorm (lowerIndex n a)]
    exact plus_regularized_three_lower ε hχ h2 h3 r n a (Finset.mem_range.mp ha) _
  rw [Finset.sum_congr rfl hterms,← Finset.mul_sum,← mul_add] at h
  have hdiv := mul_left_cancel₀ (threePointRegularizedScale_ne_zero n) h
  have hnpos : 0<n.val := Fin.pos_iff_ne_zero.mpr hn
  have hnv : n.val=(n.val-1)+1 := by omega
  have hlast : lowerIndex n (n.val-1)=0 := by
    apply Fin.ext
    simp [lowerIndex]
  have hsum := Finset.sum_range_succ
    (fun a => eval 1 1 1 1 0 0 ((Real.sqrt 7:ℂ)*f 7)
      (periodicVector (fun j => normalizeRegularizedThree v (lowerIndex n a,j)))
      (plusExceptionalPoly n.val (rawHigherJetPoly 1 (a+1) (.physical r)))/((a+1).factorial:ℂ)) (n.val-1)
  rw [← hnv,hlast] at hsum
  rw [hsum]
  exact hdiv.trans (add_comm _ _)

#print axioms plus_normalized_regularized_three_rows
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveCuspPlusRegularizedExceptionalOriginal -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusExceptionalBlock
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift
open QuantitativeArithmeticSmallLevelTwentyFiveThreePointVector

/- At weight two the regularized three-point system has no principal part at the exceptional parameters. -/
compact_certificate theorem regularized_exceptional_three_point_impossible
    {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*1) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*1) f ε)
    (hχ : ε*Complex.I^(2*1)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate 1 f z (gridVector 1050 (2*1) f z))
    (v : Fin 3 × Fin 1050 → ℂ) (hv : IsLeadingVector (regularizedStack 2 G 2) 2 v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (2+n))
    (h2 : (Real.sqrt 2:ℂ)*f 2= -3) (h3 : (Real.sqrt 3:ℂ)*f 3= -4) : False := by
  have hnorm := normalized_equations_kill_old_grid ((Real.sqrt 7:ℂ)*f 7)
    (normalizeRegularizedThree v) (by
      intro i
      let ai : Fin 4600 := ⟨auxiliaryIndex i.val,auxiliaryIndex_bound i⟩
      have hp := AuxPlusLaurent.all_actual_source ai
      have hq := AuxPlusLaurent.all_actual_tail ai
      change normalizedPoly (rawSourcePoly 1 (AuxPlusLaurent.actual (auxiliaryIndex i.val)))=_ at hp
      change normalizedPoly (rawTailPoly (AuxPlusLaurent.actual (auxiliaryIndex i.val)))=_ at hq
      rw [← actual_eq i,actual_physical i] at hp hq
      have h := plus_normalized_regularized_three_rows AuxPlusLaurent.basis AuxPlusLaurent.freeCoordinate
        AuxPlusLaurent.basis_periodic (physicalRow i.val)
        (AuxPlusLaurent.source ai.val) (AuxPlusLaurent.tail ai.val) hp hq
        (AuxPlusLaurent.all_source_zero ai) (AuxPlusLaurent.all_tail_zero ai)
        hf ε hε hlaw hχ BG G hG hGF v hv hshift h2 h3 (selectedPoint i)
      rw [← actual_physical i] at h
      exact h)
  have hold (n : Fin 3) (j : Fin 150) : v (n,⟨7*j.val,by omega⟩)=0 := by
    have hz := hnorm (150*n.val+j.val) (by have := n.isLt;have := j.isLt;omega)
    rw [cuspVector_point _ n j.val j.isLt] at hz
    have hj : 7*j.val<1050 := by omega
    simp only [periodicVector,Nat.mod_eq_of_lt hj] at hz
    have he := congrFun (normalizeRegularizedThree_cancel v n) ⟨7*j.val,hj⟩
    change threePointRegularizedScale n*normalizeRegularizedThree v (n,⟨7*j.val,hj⟩)=v (n,⟨7*j.val,hj⟩) at he
    rw [hz,mul_zero] at he
    exact he.symm
  have hall : ∀ n : ℕ,∀ hn : n<3,(fun j => v (⟨n,hn⟩,j))=0 := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn
      apply AuxPlusLaurent.regularized_three_point_zero_of_prior_old_zero hf ε hε hlaw hχ BG G
        hG hGF v hv hshift ⟨n,hn⟩
      · intro a ha
        exact ih a.val ha a.isLt
      · exact hold ⟨n,hn⟩
  apply hv.1
  funext j
  exact congrFun (hall j.1.val j.1.isLt) j.2

#print axioms regularized_exceptional_three_point_impossible
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusExceptionalBlock
end
end

/-! ## TwentyFiveCuspPlusRegularizedPole -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- The denominator-five principal coordinate cannot carry a higher-order
pole at the weight. Simple poles of the unregularized twists are permitted. -/
compact_certificate theorem regularized_weight_cusp_coordinate_zero
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (v : Fin 1050 → ℂ)
    (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) ((2*m:ℕ):ℂ) v)
    (hpole : ∃ j, meromorphicOrderAt (fun z => (z-((2*m:ℕ):ℂ))*G z j) ((2*m:ℕ):ℂ)<0)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (((2*m:ℕ):ℂ)+n)) :
    v ⟨840,by decide⟩=0 := by
  by_contra hu
  obtain ⟨hm1,h2,h3⟩ := regularized_weight_candidate AuxPlusLaurent.freeCoordinate
    hm hf ε hε hlaw hχ BG G hG hGF v hv hshift hu
  subst m
  have hreg (j : Fin 1050) : MeromorphicAt (fun z => (z-2)*G z j) 2 :=
    (analyticAt_id.sub analyticAt_const).meromorphicAt.mul (hG j 2).meromorphicAt
  have hstack (b : Fin 3 × Fin 1050) : MeromorphicAt (fun z => regularizedStack 2 G 2 z b) 2 := by
    by_cases hb : b.1=0
    · simpa only [regularizedStack,ite_eq_left hb] using hreg b.2
    · simpa only [regularizedStack,ite_eq_right hb,Function.comp_def] using
        (hG b.2 (2-b.1.val)).meromorphicAt.comp_analyticAt
          (g:=fun z : ℂ => z-(b.1.val:ℂ)) (analyticAt_id.sub analyticAt_const)
  have hpstack : ∃ b : Fin 3 × Fin 1050,
      meromorphicOrderAt (fun z => regularizedStack 2 G 2 z b) 2<0 := by
    obtain ⟨i,hi⟩ := hpole
    exact ⟨(0,i),by simpa [regularizedStack] using hi⟩
  obtain ⟨w,hw⟩ := exists_leading_vector (regularizedStack 2 G 2) 2 hstack hpstack
  exact CuspPlusExceptionalBlock.regularized_exceptional_three_point_impossible
    hf ε hε hlaw hχ BG G hG hGF w hw hshift h2 h3

#print axioms regularized_weight_cusp_coordinate_zero
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
end
end

/-! ## TwentyFiveThreePointNormalization -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift
open QuantitativeArithmeticThreePointJetScale

compact_certificate theorem normalized_three_point_shift (r : Row) (m : ℕ) (f : ℕ → ℂ)
    (ε s : ℂ) (χ : ℚ) (hχ : ε*Complex.I^(2*m)=(χ:ℂ)) (n : Fin 3) (a : ℕ) (ha : a<n.val)
    (u : Fin 1050 → ℂ) :
    shifted r m f ε a (s-n.val) (scale (s-((2*m:ℕ):ℂ)) (lowerIndex n a) • u)=
      scale (s-((2*m:ℕ):ℂ)) n*
        (eval (primeParameter 2 m (s-n.val)) (primeParameter 3 m (s-n.val))
          (primeParameter 5 m (s-n.val)) (primeParameter 7 m (s-n.val))
          ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
          (periodicVector u) (rawHigherJetPoly χ (a+1) (.physical r))/((a+1).factorial:ℂ)) := by
  rw [shifted_smul]
  have he := eval_rawHigherJetPoly (.physical r) m f ε (s-n.val) χ hχ a u
  simp only [sourceShifted] at he
  rw [he]
  have harg : s-(n.val:ℂ)+((a+1:ℕ):ℂ)-((2*m:ℕ):ℂ)=
      (s-((2*m:ℕ):ℂ))-(n.val:ℂ)+((a+1:ℕ):ℂ) := by ring
  rw [harg]
  have h := scale_binomial (s-((2*m:ℕ):ℂ)) n a ha
  calc
    _ = (Complex.I^(a+1)*Ring.choose ((s-((2*m:ℕ):ℂ))-(n.val:ℂ)+((a+1:ℕ):ℂ)) (a+1)*
        scale (s-((2*m:ℕ):ℂ)) (lowerIndex n a))*
        eval (primeParameter 2 m (s-n.val)) (primeParameter 3 m (s-n.val))
          (primeParameter 5 m (s-n.val)) (primeParameter 7 m (s-n.val))
          ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
          (periodicVector u) (rawHigherJetPoly χ (a+1) (.physical r)) := by ring
    _ = _ := by rw [h]; ring

compact_certificate theorem normalized_three_point_rows_allowed (basis : ℕ → Poly) (free : Fin 68 → Fin 1050)
    (hperiodic : ∀ j, basis (j%1050)=basis j)
    (r : Row) (χ : ℚ) (p q : Poly)
    (hp : normalizedPoly (rawSourcePoly χ (.physical r))=p)
    (hq : normalizedPoly (rawTailPoly (.physical r))=q)
    (hpzero : substitute basis p=[]) (hqzero : substitute basis q=[])
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=(χ:ℂ)) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis free m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 3 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 2 G) s v)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hβ0 : s-((2*m:ℕ):ℂ)≠0) (hβ1 : s-((2*m:ℕ):ℂ)-1≠0) (n : Fin 3) :
    eval (primeParameter 2 m (s-n.val)) (primeParameter 3 m (s-n.val))
      (primeParameter 5 m (s-n.val)) (primeParameter 7 m (s-n.val))
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (periodicVector (fun j => normalize (s-((2*m:ℕ):ℂ)) v (n,j))) (rawSourcePoly χ (.physical r))=
    ∑ a∈Finset.range n.val,
      eval (primeParameter 2 m (s-n.val)) (primeParameter 3 m (s-n.val))
        (primeParameter 5 m (s-n.val)) (primeParameter 7 m (s-n.val))
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
        (periodicVector (fun j => normalize (s-((2*m:ℕ):ℂ)) v (lowerIndex n a,j)))
        (rawHigherJetPoly χ (a+1) (.physical r))/((a+1).factorial:ℂ) := by
  have h := physical_block_rows_allowed basis free hperiodic r χ p q hp hq hpzero hqzero
    hm hf ε hε hlaw hχ BG G hG hGF s 2 v hv hshift hweight n
  have hnorm := normalize_cancel (s-((2*m:ℕ):ℂ)) hβ0 hβ1 v
  have he := eval_rawSourcePoly (.physical r) hf ε (s-n.val) χ hχ
    (fun j => normalize (s-((2*m:ℕ):ℂ)) v (n,j))
  simp only [sourceLeading] at he
  rw [← hnorm n,leading_smul,← he] at h
  have hterms : ∀ a∈Finset.range n.val,
      shifted r m f ε a (s-n.val) (fun j => v (lowerIndex n a,j))=
      scale (s-((2*m:ℕ):ℂ)) n*
        (eval (primeParameter 2 m (s-n.val)) (primeParameter 3 m (s-n.val))
          (primeParameter 5 m (s-n.val)) (primeParameter 7 m (s-n.val))
          ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
          (periodicVector (fun j => normalize (s-((2*m:ℕ):ℂ)) v (lowerIndex n a,j)))
          (rawHigherJetPoly χ (a+1) (.physical r))/((a+1).factorial:ℂ)) := by
    intro a ha
    rw [← hnorm (lowerIndex n a)]
    exact normalized_three_point_shift r m f ε s χ hχ n a (Finset.mem_range.mp ha) _
  rw [Finset.sum_congr rfl hterms,← Finset.mul_sum] at h
  exact mul_left_cancel₀ (scale_ne_zero _ hβ0 hβ1 n) h

#print axioms normalized_three_point_shift
#print axioms normalized_three_point_rows_allowed
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
