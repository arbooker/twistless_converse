compact_certificate theorem germ_square_relation (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (ha : a= -x-2/x) (hb : b= -y-3/y)
    (hu : v 3≠0)
    (h0 : eval x y z w a b c v (germConstraint 0)=0)
    (h9 : eval x y z w a b c v (germConstraint 9)=0) :
    9*x^2=4*y^2 := by
