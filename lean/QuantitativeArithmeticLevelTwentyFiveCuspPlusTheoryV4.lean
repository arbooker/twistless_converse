compact_certificate def normalizedEquation (n : ℕ) (x y z w a b c : ℂ) (v : ℕ → ℂ) (i : ℕ) : ℂ :=
  eval x y z w a b c (fun j => v (150*n+j)) (selectedSource i)-
  (if n=0 then 0 else eval x y z w a b c (fun j => v (150*(n-1)+j)) (selectedJet1 i))-
  (if n≤1 then 0 else eval x y z w a b c (fun j => v (150*(n-2)+j)) (selectedJet2 i)/2)

compact_certificate theorem original_normalizedEquation (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 3 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 2 G) s v)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hβ0 : s-((2*m:ℕ):ℂ)≠0) (hβ1 : s-((2*m:ℕ):ℂ)-1≠0)
    (n : Fin 3) (i : Fin 22) :
    normalizedEquation n.val
      (primeParameter 2 m (s-n.val)) (primeParameter 3 m (s-n.val))
      (primeParameter 5 m (s-n.val)) (primeParameter 7 m (s-n.val))
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (cuspVector (normalize (s-((2*m:ℕ):ℂ)) v)) i.val=0 := by
  have h := selected_normalized_rows_allowed free hm hf ε hε hlaw hχ BG G hG hGF s v hv
    hshift hweight hβ0 hβ1 n i
  fin_cases n <;>
    simp [normalizedEquation,Finset.sum_range_succ,lowerIndex,selectedJet] at h ⊢ <;>
    linear_combination h

#print axioms original_normalizedEquation
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusThreePoint
