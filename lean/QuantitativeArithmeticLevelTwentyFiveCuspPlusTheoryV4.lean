  have hlead := pole_leading_rows free hm hf ε hε hlaw hχ BG G hG hGF
    ((2*m:ℕ):ℂ) v (hv.of_analytic_factor _ (analyticAt_id.sub analyticAt_const)) hshift
  have hp (p : ℕ) : primeParameter p m ((2*m:ℕ):ℂ)=(p:ℂ) := by
    norm_num [primeParameter,hm1]
  have hn (p : ℕ) (hp0 : p≠0) : primeParameter p m ((2*m:ℕ):ℂ)≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp0))
  have hb := cusp_hecke_parameters _ _ _ _ _ _ _ _
    (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide))
    hlead (by simpa [periodicVector] using hu)
