compact_certificate def fullVector (v : Fin 3 × Fin 1050 → ℂ) (j : ℕ) : ℂ :=
  v (⟨(j/1050)%3,Nat.mod_lt _ (by decide)⟩,⟨j%1050,Nat.mod_lt _ (by decide)⟩)

compact_certificate theorem fullVector_move (v : Fin 3 × Fin 1050 → ℂ) (n : Fin 3) (j : ℕ) (hj : j<1050) :
    fullVector v (1050*n.val+j)=periodicVector (fun t => v (n,t)) j := by
  have hd : (1050*n.val+j)/1050=n.val := by omega
  have hm : (1050*n.val+j)%1050=j := by omega
  simp only [fullVector,periodicVector,hd,hm,Nat.mod_eq_of_lt n.isLt,Nat.mod_eq_of_lt hj]

compact_certificate theorem blockMove_eval (x y z w a b c : ℂ) (v : Fin 3 × Fin 1050 → ℂ)
    (n : Fin 3) (p : Poly) (hp : ∀ t∈p,t.2.1<1050) :
    eval x y z w a b c (fullVector v) (blockMovePoly n.val p)=
      eval x y z w a b c (periodicVector (fun j => v (n,j))) p := by
  unfold eval blockMovePoly
  rw [List.map_map]
  congr 1
  apply List.map_congr_left
  intro t ht
  simp only [Function.comp_apply]
  rw [fullVector_move v n t.2.1 (hp t ht)]

compact_certificate theorem fullVector_lift_coordinate (v : Fin 3 × Fin 1050 → ℂ) (j : ℕ) :
    fullVector v (1050*(j/150)+7*(j%150))=cuspVector v j := by
  have hj : 7*(j%150)<1050 := by have := Nat.mod_lt j (by decide : 0<150); omega
  have hd : (1050*(j/150)+7*(j%150))/1050=j/150 := by omega
  have hm : (1050*(j/150)+7*(j%150))%1050=7*(j%150) := by omega
  simp only [fullVector,cuspVector,hd,hm]

compact_certificate theorem cuspBlockLift_eval (x y z w a b c : ℂ) (v : Fin 3 × Fin 1050 → ℂ) (p : Poly) :
    eval x y z w a b c (fullVector v) (cuspBlockLift p)=
      eval x y z w a b c (cuspVector v) p := by
  unfold eval cuspBlockLift
  rw [List.map_map]
  congr 1
  apply List.map_congr_left
  intro t _
  simp only [Function.comp_apply,fullVector_lift_coordinate]

#print axioms blockMove_eval
#print axioms cuspBlockLift_eval
