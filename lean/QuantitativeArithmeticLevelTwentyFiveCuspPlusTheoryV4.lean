  have hfactor (z : ℂ) (w : Fin 1050 → ℂ) :
      (∑ t, K (z-1) t*shifted (rows t) m f ε 0 (z-1) w)=
      (z-((2*m:ℕ):ℂ))*(∑ l, D z l*w l) := by
    rw [he]
    dsimp only [J]
    rw [eval_substitute _ _ _ _ _ _ _ _
      (hpn0 2 (by decide) z) (hpn0 3 (by decide) z) (hpn0 5 (by decide) z) (hpn0 7 (by decide) z),
      eval_eq_sum_fin,Finset.mul_sum,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro t _
    change K (z-1) t*shifted (germRows (O.get t).2.1) m f ε 0 (z-1) w=_
    rw [germShift_eval m f ε z hχ w ⟨(O.get t).2.1,bound t⟩]
    simp only [K,sub_add_cancel]
    ring
  have hh := QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel.selected_factored_first_shift
    AuxPlusLaurent.basis free AuxPlusLaurent.basis_periodic rows 1
    (fun t => AuxPlusLaurent.source (germAuxIndex (O.get t).2.1)) Q
    hP hQ hPzero hQzero hm hf ε hε hlaw (by simpa using hχ)
    BG G hG hGF s v hv hshift K hK hKA D hD hfactor
  rw [he] at hh
  have hz := (mul_eq_zero.mp hh).resolve_left I_ne_zero
  simpa only [J,eval_substitute _ _ _ _ _ _ _ _
    (hpn0 2 (by decide) s) (hpn0 3 (by decide) s) (hpn0 5 (by decide) s) (hpn0 7 (by decide) s)] using hz

