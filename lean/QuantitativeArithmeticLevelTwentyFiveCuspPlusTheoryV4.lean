/-! ## TwentyFivePlusExceptionalBlockEvaluation -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveThreePointVector
open QuantitativeArithmeticSevenLaurentRows SmallLevelFiniteShift
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel

compact_certificate theorem plusExceptionalBlock_eval (c : ℂ) (v : Fin 3 × Fin 1050 → ℂ)
    (n : Fin 3) (r : SourceRow)
    (hs : ∀ t∈plusExceptionalPoly n.val (rawSourcePoly 1 r),t.2.1<1050)
    (ht : ∀ a<n.val,∀ t∈plusExceptionalPoly n.val (rawHigherJetPoly 1 (a+1) r),t.2.1<1050) :
    eval 1 1 1 1 0 0 c (fullVector v) (plusExceptionalBlockPoly n.val r)=
      eval 1 1 1 1 0 0 c (periodicVector (fun j => v (n,j)))
        (plusExceptionalPoly n.val (rawSourcePoly 1 r))-
      ∑ a∈Finset.range n.val,
        eval 1 1 1 1 0 0 c (periodicVector (fun j => v (lowerIndex n a,j)))
          (plusExceptionalPoly n.val (rawHigherJetPoly 1 (a+1) r))/((a+1).factorial:ℂ) := by
  unfold plusExceptionalBlockPoly
  rw [QuantitativeArithmeticSevenLaurentRows.eval_append,blockMove_eval 1 1 1 1 0 0 c v n _ hs,
    eval_flatMap,← List.sum_toFinset _ (List.nodup_range (n:=n.val))]
  simp only [List.toFinset_range]
  rw [sub_eq_add_neg,← Finset.sum_neg_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro a ha
  rw [eval_shift _ _ _ _ _ _ _ _ (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
  have he := blockMove_eval 1 1 1 1 0 0 c v (lowerIndex n a) _ (ht a (Finset.mem_range.mp ha))
  change eval _ _ _ _ _ _ _ _ (blockMovePoly (n.val-1-a) _)=_ at he
  rw [he]
  push_cast
  simp only [monomial,zpow_zero,pow_zero,mul_one]
  ring

#print axioms plusExceptionalBlock_eval
end QuantitativeArithmeticSmallLevelTwentyFiveThreePointVector
end
