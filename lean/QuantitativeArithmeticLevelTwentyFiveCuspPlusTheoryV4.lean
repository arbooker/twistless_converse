/-! ## TwentyFiveCuspPlusPoleLeadingAllowed -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector
open QuantitativeArithmeticSmallLevelTwentyFiveCuspLift

compact_certificate theorem pole_leading_rows_allowed (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= 1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ)) :
    ∀ i<1198, eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun t => periodicVector v (7*t)) (source i)=0 := by
  intro i hi
  let j : Fin 4600 := ⟨auxIndex i, all_aux_index_bound i hi⟩
  let r := physicalPart (AuxPlusLaurent.actual (auxIndex i))
  have hr : AuxPlusLaurent.actual j.val=SourceRow.physical r :=
    cusp_source_physical ⟨i,hi⟩
  have hp := AuxPlusLaurent.all_actual_source j
  have hq := AuxPlusLaurent.all_actual_tail j
  rw [hr] at hp hq
  have hlead := physical_leading_pole_allowed AuxPlusLaurent.basis free
    AuxPlusLaurent.basis_periodic r 1 (AuxPlusLaurent.source j.val)
    (AuxPlusLaurent.tail j.val) hp hq
    (AuxPlusLaurent.all_source_zero j) (AuxPlusLaurent.all_tail_zero j)
    hm hf ε hε hlaw (by simpa using hχ) BG G hG hGF s v hv hshift hweight
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he := eval_rawSourcePoly (.physical r) hf ε s 1 (by simpa using hχ) v
  rw [← eval_normalizedPoly _ _ _ _ _ _ _ _ (hn 2 (by decide)) (hn 3 (by decide))
    (hn 5 (by decide)) (hn 7 (by decide)), hp] at he
  change eval _ _ _ _ _ _ _ _ (AuxPlusLaurent.source (auxIndex i))=_ at he
  rw [all_aux_source i hi, eval_liftPoly] at he
  exact he.trans hlead

#print axioms pole_leading_rows_allowed
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
end
end

