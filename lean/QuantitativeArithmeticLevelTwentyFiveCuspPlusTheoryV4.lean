/-! ## TwentyFiveCuspPlusHeckeParameters -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxSize 2048
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
open QuantitativeArithmeticSevenLaurentRows

compact_certificate def heckeTwoPoly : Poly := [(-2,3,(-2,0,0,0,0,0,0)),(-1,3,(-1,0,0,0,1,0,0)),(-1,3,(0,0,0,0,0,0,0))]
compact_certificate def heckeThreePoly : Poly := [(-3,3,(0,-2,0,0,0,0,0)),(-1,3,(0,-1,0,0,0,1,0)),(-1,3,(0,0,0,0,0,0,0))]
compact_certificate theorem hecke_two_certificate : substitute basis (source 1058)=heckeTwoPoly := by
  simpa only [heckeTwoPoly] using hecke_two_certificate_compact
compact_certificate theorem hecke_three_certificate : substitute basis (source 1128)=heckeThreePoly := by
  simpa only [heckeThreePoly] using hecke_three_certificate_compact
compact_certificate theorem hecke_support : ∀ i∈[1058,1128], ∀ t∈source i, t.2.1<150 := by
  intro i hi
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with rfl | rfl
  · rw [hecke_lookup_source_1058]
    decide +kernel
  · rw [hecke_lookup_source_1128]
    decide +kernel
#print axioms hecke_support

compact_certificate theorem cusp_hecke_parameters (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (h : ∀ i<1198, eval x y z w a b c v (source i)=0) (hu : v 120≠0) :
    a= -x-2/x ∧ b= -y-3/y := by
  have hp := leading_parametrization x y z w a b c v hx hy hz hw h
  let u : ℕ → ℂ := fun t => v (coordinate (t+146))
  have hs (i : ℕ) (hi : i∈[1058,1128]) :
      eval x y z w a b c u (substitute basis (source i))=0 := by
    rw [eval_substitute _ _ _ _ _ _ _ _ hx hy hz hw]
    have he := eval_congr_support x y z w a b c
      (fun j => eval x y z w a b c u (basis j)) v (source i)
      (fun t ht => (hp t.2.1 (hecke_support i hi t ht)).symm)
    rw [he]
    exact h i (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hi; omega)
  have h2 := hs 1058 (by decide)
  have h3 := hs 1128 (by decide)
  rw [hecke_two_certificate] at h2
  rw [hecke_three_certificate] at h3
  norm_num [heckeTwoPoly,heckeThreePoly,eval,monomial,u,
    show coordinate (3+146)=120 from rfl] at h2 h3
  field_simp [hx] at h2
  field_simp [hy] at h3
  have ha : (a*x+x^2+2)*v 120=0 := by linear_combination -h2
  have hb : (b*y+y^2+3)*v 120=0 := by linear_combination -h3
  have ha0 := (mul_eq_zero.mp ha).resolve_right hu
  have hb0 := (mul_eq_zero.mp hb).resolve_right hu
  constructor
  · field_simp [hx]; linear_combination ha0
  · field_simp [hy]; linear_combination hb0

#print axioms hecke_two_certificate
#print axioms hecke_three_certificate
#print axioms cusp_hecke_parameters
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
end
