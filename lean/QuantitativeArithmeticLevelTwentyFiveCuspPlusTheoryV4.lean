compact_certificate theorem original_three_point_rows (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 3 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 2 G) s v)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hβ0 : s-((2*m:ℕ):ℂ)≠0) (hβ1 : s-((2*m:ℕ):ℂ)-1≠0)
    (σ : ℂ) (hσ : σ=1 ∨ σ= -1)
    (hy : primeParameter 3 m s=σ*(3*primeParameter 2 m s/2))
    (ha : (Real.sqrt 2:ℂ)*f 2= -primeParameter 2 m s-2/primeParameter 2 m s)
    (hb : (Real.sqrt 3:ℂ)*f 3=σ*(-3*primeParameter 2 m s/2-2/primeParameter 2 m s)) :
    ∀ i : Fin 58, eval (primeParameter 2 m s) 1 (primeParameter 5 m s) 1 0 0 0
      (cuspVector (normalize (s-((2*m:ℕ):ℂ)) v)) (rows i.val)=0 := by
  intro i
  let n : Fin 3 := ⟨selectedPoint i.val,selected_point_bound i⟩
  let j : Fin 22 := ⟨selectedSlot i.val,selected_slot_bound i⟩
  have h := original_normalizedEquation free hm hf ε hε hlaw hχ BG G hG hGF
    s v hv hshift hweight hβ0 hβ1 n j
  rw [primeParameter_sub_nat 2 m n.val (by decide),
    primeParameter_sub_nat 3 m n.val (by decide),
    primeParameter_sub_nat 5 m n.val (by decide),hy,ha,hb] at h
  simp only [Nat.cast_ofNat] at h
  have hyy : σ*(3*primeParameter 2 m s/2)/(3:ℂ)^n.val=
      σ*(3*primeParameter 2 m s/(2*(3:ℂ)^n.val)) := by ring
  rw [hyy] at h
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he := selected_restricted_row (primeParameter 2 m s) (primeParameter 5 m s)
    σ (primeParameter 7 m (s-n.val)) ((Real.sqrt 7:ℂ)*f 7)
    (cuspVector (normalize (s-((2*m:ℕ):ℂ)) v))
    (hn 2 (by decide)) hσ i
  exact he.symm.trans h

#print axioms original_three_point_rows
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusThreePoint
