  let index : ℕ → Fin 1050 := fun t => ⟨(7*t)%1050,Nat.mod_lt _ (by decide)⟩
  let D : ℂ → Fin 1050 → ℂ := fun z l => Complex.I*eval
    (primeParameter 2 m z) (primeParameter 3 m z) (primeParameter 5 m z) (primeParameter 7 m z)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
    (fun t => (Pi.single l (1:ℂ) : Fin 1050 → ℂ) (index t)) J
  have hpa0 (p : ℕ) (hp : p≠0) (z : ℂ) : AnalyticAt ℂ (fun w => primeParameter p m w) z := by
    unfold primeParameter
    simp_rw [Complex.cpow_def_of_ne_zero (by exact_mod_cast hp : (p:ℂ)≠0)]
    fun_prop
