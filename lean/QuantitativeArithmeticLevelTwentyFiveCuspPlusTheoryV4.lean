compact_certificate theorem cuspVector_point (v : Fin 3 × Fin 1050 → ℂ) (n : Fin 3)
    (j : ℕ) (hj : j<150) :
    cuspVector v (150*n.val+j)=periodicVector (fun t => v (n,t)) (7*j) := by
  have hd : (150*n.val+j)/150=n.val := by omega
  have hm : (150*n.val+j)%150=j := by omega
  have hj' : 7*j<1050 := by omega
  simp only [cuspVector,periodicVector,hd,hm,Nat.mod_eq_of_lt n.isLt,
    Nat.mod_eq_of_lt hj']

compact_certificate theorem eval_cusp_point (x y z w a b c : ℂ) (v : Fin 3 × Fin 1050 → ℂ)
    (n : Fin 3) (p : Poly) (hp : ∀ t∈p,t.2.1<150) :
    eval x y z w a b c (periodicVector (fun j => v (n,j))) (liftPoly p)=
      eval x y z w a b c (fun j => cuspVector v (150*n.val+j)) p := by
  rw [eval_liftPoly]
  apply eval_congr_support
  intro t ht
  exact (cuspVector_point v n t.2.1 (hp t ht)).symm

compact_certificate theorem cuspVector_top (v : Fin 3 × Fin 1050 → ℂ) : cuspVector v 120=v (0,840) := rfl

#print axioms eval_cusp_point
end QuantitativeArithmeticSmallLevelTwentyFiveThreePointVector
end
