compact_certificate theorem three_point_q5_nonzero_allowed
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= 1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 3 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 2 G) s v)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (σ : ℂ) (hσ : σ=1 ∨ σ= -1)
    (hy : primeParameter 3 m s=σ*(3*primeParameter 2 m s/2))
    (ha : (Real.sqrt 2:ℂ)*f 2= -primeParameter 2 m s-2/primeParameter 2 m s)
    (hb : (Real.sqrt 3:ℂ)*f 3=σ*(-3*primeParameter 2 m s/2-2/primeParameter 2 m s))
    (hc : ‖(primeParameter 2 m s)^2‖=4) (h4 : (primeParameter 2 m s)^2≠4) :
    v (0,⟨840,by decide⟩)≠0 := by
  intro hzero
  have hpn (p : ℕ) (hp : p≠0) (t : ℂ) : primeParameter p m t≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hall : ∀ n : ℕ, ∀ hn : n<3, (fun j => v (⟨n,hn⟩,j))=0 := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn
      have hp : ∀ a : Fin 3, a.val<n → (fun j => v (a,j))=0 := by
        intro a ha
        exact ih a.val ha a.isLt
      have hs := block_leading_rows_of_prior_zero_allowed AuxPlusLaurent.freeCoordinate
        hm hf ε hε hlaw hχ BG G hG hGF s 2 v hv ⟨n,hn⟩ hp hshift hweight
      rw [primeParameter_sub_nat 2 m n (by decide),primeParameter_sub_nat 3 m n (by decide),
        primeParameter_sub_nat 5 m n (by decide),ha,hb,hy] at hs
      have hold : ∀ j<150, periodicVector (fun t => v (⟨n,hn⟩,t)) (7*j)=0 := by
        interval_cases n
        · have hu : periodicVector (fun t => v (0,t)) (7*120)=0 := by
            simpa [periodicVector] using hzero
          apply circle_leading_kernel_0 (primeParameter 2 m s) (primeParameter 5 m s) σ
            (primeParameter 7 m (s-0)) ((Real.sqrt 7:ℂ)*f 7)
            (fun j => periodicVector (fun t => v (⟨0,hn⟩,t)) (7*j)) (hpn 2 (by decide) s) (hpn 5 (by decide) s)
            (hpn 7 (by decide) (s-0)) hσ hc hu
          simpa only [pow_zero,div_one,Nat.cast_zero,sub_zero] using hs
        · have he : σ*(3*primeParameter 2 m s/2)/3=σ*(3*primeParameter 2 m s/6) := by ring
          simp only [pow_one,Nat.cast_ofNat,Nat.cast_one] at hs
          rw [he] at hs
          exact circle_leading_kernel_1 (primeParameter 2 m s) (primeParameter 5 m s) σ
            (primeParameter 7 m (s-1)) ((Real.sqrt 7:ℂ)*f 7)
            (fun j => periodicVector (fun t => v (⟨1,hn⟩,t)) (7*j)) (hpn 2 (by decide) s) (hpn 5 (by decide) s)
            (hpn 7 (by decide) (s-1)) hσ hc h4 hs
        · have he : σ*(3*primeParameter 2 m s/2)/9=σ*(3*primeParameter 2 m s/18) := by ring
          norm_num only [Nat.cast_ofNat,show (2:ℂ)^2=4 from by norm_num,
            show (3:ℂ)^2=9 from by norm_num,show (5:ℂ)^2=25 from by norm_num] at hs
          rw [he] at hs
          exact circle_leading_kernel_2 (primeParameter 2 m s) (primeParameter 5 m s) σ
            (primeParameter 7 m (s-2)) ((Real.sqrt 7:ℂ)*f 7)
            (fun j => periodicVector (fun t => v (⟨2,hn⟩,t)) (7*j)) (hpn 2 (by decide) s) (hpn 5 (by decide) s)
            (hpn 7 (by decide) (s-2)) hσ hc hs
      apply AuxPlusLaurent.point_zero_of_prior_old_zero_allowed hm hf ε hε hlaw hχ BG G hG hGF
        s 2 v hv hshift hweight ⟨n,hn⟩ hp
      intro j
      have h := hold j.val j.isLt
      simpa only [periodicVector,Nat.mod_eq_of_lt (show 7*j.val<1050 by omega)] using h
  apply hv.1
  funext j
  exact congrFun (hall j.1.val j.1.isLt) j.2

#print axioms three_point_q5_nonzero_allowed
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
end
