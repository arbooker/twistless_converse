  have hr := circle_residual_equations (x/4) (σ*(3*x/18)) (z/25) w (-x-2/x) (σ*(-3*x/2-2/x)) c v hx' hy' hz' hw hs
  have hm : ∀ i : Fin 4, eval x 1 z 1 0 0 0 u (CuspPlusCircleMatrix.rows2 i.val)=0 := by
    intro i
    fin_cases i
    · exact (circle_residual_restrict_2_0 x z σ w c u hx hσ).symm.trans (hr ⟨0,by decide⟩)
    · exact (circle_residual_restrict_2_1 x z σ w c u hx hσ).symm.trans (hr ⟨1,by decide⟩)
    · exact (circle_residual_restrict_2_2 x z σ w c u hx hσ).symm.trans (hr ⟨2,by decide⟩)
    · exact (circle_residual_restrict_2_3 x z σ w c u hx hσ).symm.trans (hr ⟨3,by decide⟩)
  have hk := CuspPlusCircleMatrix.coefficient_kernel_2 x z u hx hz hc hm
  exact leading_kernel (x/4) (σ*(3*x/18)) (z/25) w (-x-2/x) (σ*(-3*x/2-2/x)) c v hx' hy' hz' hw hs hk
#print axioms circle_leading_kernel_2
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
