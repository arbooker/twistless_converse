  have hn (p : ℕ) (hp : p≠0) : primeParameter p m ((2*m:ℕ):ℂ)≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he := denominator_five_relations _ _ _ _ _ _ _ (fun j => periodicVector v (7*j))
    (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide)) hlead
  exact ⟨he.1.trans h120,he.2.1.trans (by rw [h120,neg_zero]),
    he.2.2.trans (by rw [h120,neg_zero]),h120⟩

compact_certificate theorem pole_all_denominator_five_zero_allowed
