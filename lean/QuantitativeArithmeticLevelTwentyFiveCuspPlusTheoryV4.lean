    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis
      AuxPlusLaurent.freeCoordinate m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 3 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 2 G) s v)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hβ0 : s-((2*m:ℕ):ℂ)≠0) (hβ1 : s-((2*m:ℕ):ℂ)-1≠0)
    (σ : ℂ) (hσ : σ=1 ∨ σ= -1)
    (hy : primeParameter 3 m s=σ*(3*primeParameter 2 m s/2))
    (ha : (Real.sqrt 2:ℂ)*f 2= -primeParameter 2 m s-2/primeParameter 2 m s)
    (hb : (Real.sqrt 3:ℂ)*f 3=σ*(-3*primeParameter 2 m s/2-2/primeParameter 2 m s))
    (hc : ‖(primeParameter 2 m s)^2‖=4) : (primeParameter 2 m s)^2=4 := by
  by_contra h4
  have hne := CuspPlusLaurent.three_point_q5_nonzero_allowed hm hf ε hε hlaw hχ BG G
    hG hGF s v hv hshift hweight σ hσ hy ha hb hc h4
  have hrows := original_three_point_rows AuxPlusLaurent.freeCoordinate hm hf ε hε hlaw hχ
    BG G hG hGF s v hv hshift hweight hβ0 hβ1 σ hσ hy ha hb
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hz := q5_zero (primeParameter 2 m s) (primeParameter 5 m s)
    (cuspVector (normalize (s-((2*m:ℕ):ℂ)) v))
    (hn 2 (by decide)) (hn 5 (by decide)) hc h4 hrows
  rw [cuspVector_top,normalize_top] at hz
  exact hne hz

