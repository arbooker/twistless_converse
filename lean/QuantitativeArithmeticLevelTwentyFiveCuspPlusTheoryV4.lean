compact_certificate theorem germ_leading_syzygy {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε s : ℂ) (hχ : ε*Complex.I^(2*m)= 1) (v : Fin 1050 → ℂ) (j : Fin 2) :
    eval (primeParameter 2 m s) (primeParameter 3 m s)
      (primeParameter 5 m s) (primeParameter 7 m s)
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun i => leading (germRows i) m f ε (s-1) v) (germCombinedOperation j.val)=0 := by
  have hp (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have hh := germ_combined_lower (primeParameter 2 m s) (primeParameter 3 m s)
    (primeParameter 5 m s) (primeParameter 7 m s)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
    (fun i => periodicVector v (7*i))
    (hp 2 (by decide)) (hp 3 (by decide)) (hp 5 (by decide)) (hp 7 (by decide)) j
  refine (eval_congr_support _ _ _ _ _ _ _ _ _ (germCombinedOperation j.val) ?_).trans hh
  intro t ht
  exact (germLower_eval hf ε s hχ v ⟨t.2.1,germCombined_support j t ht⟩).symm

#print axioms germ_leading_syzygy
