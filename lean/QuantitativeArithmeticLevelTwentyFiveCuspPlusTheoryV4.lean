compact_certificate def selectedJet (a : ℕ) (j : ℕ) : Poly := if a=1 then selectedJet1 j else selectedJet2 j

compact_certificate theorem selected_support : ∀ i : Fin 22,
    (∀ t∈selectedSource i.val,t.2.1<150) ∧
    (∀ t∈selectedJet1 i.val,t.2.1<150) ∧
    (∀ t∈selectedJet2 i.val,t.2.1<150) := by decide +kernel

compact_certificate theorem selected_actual_jet (i : Fin 22) (a : ℕ) (ha : a<2) :
    normalizedPoly (rawHigherJetPoly 1 (a+1) (selectedActual i.val))=
      liftPoly (selectedJet (a+1) i.val) := by
  interval_cases a
  · simpa [selectedJet] using selected_actual_jet1 i
  · simpa [selectedJet] using selected_actual_jet2 i

compact_certificate theorem selected_jet_support (i : Fin 22) (a : ℕ) :
    ∀ t∈selectedJet a i.val,t.2.1<150 := by
  unfold selectedJet
  split
  · exact (selected_support i).2.1
  · exact (selected_support i).2.2

/- The selected normalized rows come from the original functional equations,
with no continuation hypothesis on a separate twist. -/
compact_certificate theorem selected_normalized_rows_allowed (free : Fin 68 → Fin 1050)
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge AuxPlusLaurent.basis free m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 3 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 2 G) s v)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ))
    (hβ0 : s-((2*m:ℕ):ℂ)≠0) (hβ1 : s-((2*m:ℕ):ℂ)-1≠0)
    (n : Fin 3) (i : Fin 22) :
    eval (primeParameter 2 m (s-n.val)) (primeParameter 3 m (s-n.val))
      (primeParameter 5 m (s-n.val)) (primeParameter 7 m (s-n.val))
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (fun j => cuspVector (normalize (s-((2*m:ℕ):ℂ)) v) (150*n.val+j))
      (selectedSource i.val)=
    ∑ a∈Finset.range n.val,
      eval (primeParameter 2 m (s-n.val)) (primeParameter 3 m (s-n.val))
        (primeParameter 5 m (s-n.val)) (primeParameter 7 m (s-n.val))
        ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
        (fun j => cuspVector (normalize (s-((2*m:ℕ):ℂ)) v) (150*(lowerIndex n a).val+j))
        (selectedJet (a+1) i.val)/((a+1).factorial:ℂ) := by
  let ai : Fin 4600 := ⟨selectedAuxIndex i.val,selectedAuxIndex_bound i⟩
  have hp := selected_aux_source i
  have hq := selected_aux_tail i
  rw [selected_physical i] at hp hq
  have h := normalized_three_point_rows_allowed AuxPlusLaurent.basis free
    AuxPlusLaurent.basis_periodic (selectedRow i.val) 1
    (AuxPlusLaurent.source ai.val) (AuxPlusLaurent.tail ai.val) hp hq
    (AuxPlusLaurent.all_source_zero ai) (AuxPlusLaurent.all_tail_zero ai)
    hm hf ε hε hlaw (by simpa using hχ) BG G hG hGF s v hv hshift hweight hβ0 hβ1 n
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m (s-n.val)≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  have he (p : Poly) (u : Fin 1050 → ℂ) :=
    eval_normalizedPoly (primeParameter 2 m (s-n.val)) (primeParameter 3 m (s-n.val))
      (primeParameter 5 m (s-n.val)) (primeParameter 7 m (s-n.val))
      ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
      (periodicVector u) (hn 2 (by decide)) (hn 3 (by decide))
      (hn 5 (by decide)) (hn 7 (by decide)) p
  rw [← selected_physical i,← he,selected_actual_source i,
    eval_cusp_point _ _ _ _ _ _ _ _ n _ (selected_support i).1] at h
  rw [h]
  apply Finset.sum_congr rfl
  intro a ha
  have ha2 : a<2 := by have := Finset.mem_range.mp ha; have := n.isLt; omega
  rw [← he,selected_actual_jet i a ha2,
    eval_cusp_point _ _ _ _ _ _ _ _ (lowerIndex n a) _ (selected_jet_support i (a+1))]

#print axioms selected_normalized_rows_allowed
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusThreePoint
end
