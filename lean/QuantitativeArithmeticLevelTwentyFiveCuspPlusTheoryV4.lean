/- The second Taylor system excludes every nonexceptional point on the pole circle.
The possible weight pole is allowed in upper translates. -/
compact_certificate theorem three_point_circle_exceptional
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
