/- Substitute the checked four-coordinate leading kernel into the actual
two sufficient first-jet equations. Only the 150-grid equations are required here;
no vanishing of the external old-grid sources is assumed. -/
compact_certificate theorem first_germ_parametrization (x y z w a b c : ℂ) (v : ℕ → ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0) (hw : w≠0)
    (hs : ∀ j<1198, eval x y z w a b c v (source j)=0)
    (hj : ∀ j : Fin 2, eval x y z w a b c
      (fun i => eval x y z w a b c v (germRawShift i)) (germCombinedOperation j.val)=0) :
    ∀ j : Fin 2, eval x y z w a b c (fun t => v (coordinate (t+146))) (germConstraint (selectedGerm j.val))=0 := by
  let u : ℕ → ℂ := fun t => v (coordinate (t+146))
  have hparam := leading_parametrization x y z w a b c v hx hy hz hw hs
  have he (i : Fin 213) : eval x y z w a b c v (germRawShift i.val)=
      eval x y z w a b c u (substitute basis (germRawShift i.val)) := by
    rw [eval_substitute x y z w a b c u hx hy hz hw]
    apply eval_congr_support
    intro t ht
    exact hparam t.2.1 (germRawShift_support i t ht)
  intro j
  have hh : eval x y z w a b c
      (fun i => eval x y z w a b c u (substitute basis (germRawShift i))) (germCombinedOperation j.val)=0 := by
    refine (eval_congr_support _ _ _ _ _ _ _ _ _ (germCombinedOperation j.val) ?_).trans (hj j)
    intro t ht
    exact (he ⟨t.2.1,germCombined_support j t ht⟩).symm
  rw [germ_combined_upper x y z w a b c u hx hy hz hw j] at hh
  exact hh

#print axioms first_germ_parametrization
end QuantitativeArithmeticSmallLevelTwentyFive.CuspPlusLaurent
