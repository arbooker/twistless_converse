theorem triangular_split (i : Fin 64) :
    mergeCompute 20000 [(1,coordinate ⟨i,by omega⟩,(0,0,0,0,0,0,0))]
      (tail ⟨i,by omega⟩)=pivotRow i := by
  fin_cases i <;> decide +kernel

theorem triangular_prior (i : Fin 66) : ∀ t∈tail i,
    ∃ j : Fin 66,i<j ∧ t.2.1=coordinate j := by
  fin_cases i <;> decide +kernel

theorem coordinate_cover (j : Fin 66) : ∃ i : Fin 66,coordinate i=j := by
  fin_cases j <;> decide +kernel

/-- The leading source kernel is determined by coordinates18 and42. -/
theorem kernel_free_zero (x y z a : ℂ) (v : ℕ→ℂ)
    (hx : x≠0) (hy : y≠0) (hz : z≠0)
    (hsource : ∀ j,eval x y z 1 a 1 1 v (baseRows (-1) j)=0)
    (h18 : v 18=0) (h42 : v 42=0) : ∀ j<66,v j=0 := by
  have hrows (i : Fin 66) : v (coordinate i)+eval x y z 1 a 1 1 v (tail i)=0 := by
    by_cases hi : i.val<64
    · have hh := pivot_rows_of_sources x y z a v hx hy hz hsource ⟨i,hi⟩
      rw [← triangular_split ⟨i,hi⟩,mergeCompute_eq,eval_mergeFuel] at hh
      simpa only [eval_cons,eval_nil,monomial,zpow_zero,pow_zero,Rat.cast_one,
        mul_one,one_mul,add_zero] using hh
    · have hh : i=64 ∨ i=65 := by
        have hval := i.isLt
        have hv : i.val=64 ∨ i.val=65 := by omega
        rcases hv with hv|hv
        · left; exact Fin.ext hv
        · right; exact Fin.ext hv
      rcases hh with rfl|rfl <;> simpa only [coordinate,tail,eval_nil,add_zero] using (by assumption)
  have hzv := triangular_kernel x y z 1 a 1 1 v 66 coordinate tail hrows triangular_prior
  intro j hj
  obtain ⟨i,hi⟩ := coordinate_cover ⟨j,hj⟩
  simpa only [hi] using hzv i

