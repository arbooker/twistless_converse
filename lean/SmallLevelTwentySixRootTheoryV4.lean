/-! ## SmallLevelTwentySixRootPrimeParametersV1 -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace SmallLevelTwentySixRoot
open Complex SmallLevelPrimeRates

theorem parameter_three_squared (m : ℕ) (s : ℂ) :
    (parameter 3 m s)^2=(9:ℂ)^(s-(m:ℂ)) := by
  have h:=Complex.natCast_mul_natCast_cpow 3 3 (s-(m:ℂ))
  norm_num only [Nat.cast_ofNat,show (3:ℂ)*3=9 by norm_num] at h
  simpa only [parameter,pow_two,Nat.cast_ofNat] using h.symm

/-- The certified disk obstruction applies to both signs of the actual prime2
parameter and to the squared prime3 parameter in the original chart. -/
theorem no_signed_parameter_locus (m : ℕ) (s u : ℂ)
    (hu : u=1 ∨ u= -1)
    (hp : p21.eval (u*parameter 2 m s)=0)
    (hq : q20.eval (u*parameter 2 m s)=(parameter 3 m s)^2) : False := by
  rw [parameter_three_squared] at hq
  rcases hu with rfl|rfl
  · simp only [one_mul,parameter,Nat.cast_ofNat] at hp hq
    exact no_physical_locus (s-(m:ℂ)) hp hq
  · simp only [neg_one_mul,parameter,Nat.cast_ofNat] at hp hq
    exact no_physical_locus_reflected (s-(m:ℂ)) hp hq

#print axioms parameter_three_squared
#print axioms no_signed_parameter_locus
end SmallLevelTwentySixRoot
end
end
