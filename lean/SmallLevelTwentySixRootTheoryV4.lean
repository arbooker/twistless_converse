      exact all_P_value_bounds i
  obtain ⟨i,_hi,h⟩ := QuantitativeArithmeticPolynomialRootCover.monic_root_cover
    Finset.univ (fun j => ratComplex (centerQ j)) (fun _ => (radiusQ:ℝ)) p21
    center_injective.injOn p21_monic (by simpa using p21_degree)
    (fun _ _ => radius_positive) hsmall z hz
  exact ⟨i,h⟩

#print axioms center_injective
#print axioms p21_root_in_disk
end SmallLevelTwentySixRoot
end
