/-! ## ThirtyFiveD0Pivot -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords

theorem quadratic_root_not_unit (X : ℂ) (h : X^2-X+2=0) (hn : ‖X‖=1) : False := by
  have hr := congrArg Complex.re h
  have hi := congrArg Complex.im h
  norm_num [pow_two,Complex.mul_re,Complex.mul_im] at hr hi
  have hs : X.re*X.re+X.im*X.im=1 := by
    simpa [Complex.normSq,hn] using Complex.normSq_eq_norm_sq X
  by_cases him : X.im=0
  · rw [him] at hr
    nlinarith [sq_nonneg (2*X.re-1)]
  · have hmul : (2*X.re-1)*X.im=0 := by nlinarith
    have hlin := (mul_eq_zero.mp hmul).resolve_right him
    nlinarith

/-- The second row-0 pivot cannot vanish on the actual D=0 prime-parameter
locus: it would force the prime-3 modulus to one, hence all moduli to one. -/
theorem d0_second_pivot_ne_zero (m : ℕ) (s : ℂ)
    (hD : (primeParameter 2 m s)^(4:ℕ)-(primeParameter 2 m s)^(2:ℕ)+
      (primeParameter 3 m s)^(2:ℕ)+3=0) :
    (primeParameter 2 m s)^(4:ℕ)-(primeParameter 2 m s)^(2:ℕ)+2≠0 := by
  intro hp
  have hY : (primeParameter 3 m s)^(2:ℕ)= -1 := by
    linear_combination hD-hp
  have hny : ‖(primeParameter 3 m s)^(2:ℕ)‖=1 := by rw [hY]; norm_num
  have hpy := primeParameter_pow_norm 3 m 2 (by decide) s
  norm_num only [Nat.cast_ofNat] at hpy
  rw [hny] at hpy
  have halpha : s.re-(m:ℝ)=0 :=
    (Real.rpow_right_inj (by norm_num : (0:ℝ)<9) (by norm_num : (9:ℝ)≠1)).mp
      (by simpa using hpy.symm)
  have hnx := primeParameter_pow_norm 2 m 2 (by decide) s
  rw [halpha,Real.rpow_zero] at hnx
  apply quadratic_root_not_unit ((primeParameter 2 m s)^(2:ℕ)) _ hnx
  simpa only [← pow_mul] using hp

#print axioms quadratic_root_not_unit
#print axioms d0_second_pivot_ne_zero
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
end

/-! ## ThirtyFiveOriginalD0Reduction -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
open Complex Filter Set
open QuantitativeArithmeticUniversalPoleVector
open QuantitativeArithmeticSmallLevelThirtyFiveGridAnalytic
open QuantitativeArithmeticSmallLevelThirtyFiveGridRamanujan
open scoped Topology

/-- The D=0 residue branch is confined to the exceptional equation x^4=-2.
The other pivot is ruled out by actual prime-parameter moduli. -/
theorem original_negative_d0_reduction {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (hphase : ε*I^(2*m)= -1) (h5 : badFive f= -1) (h7 : badSeven f= -1)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ) (v : Fin 210 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hr : v 192≠0) (hz : primeParameter 5 m s≠1)
    (hA : (primeParameter 2 m s)^(4:ℕ)+(primeParameter 3 m s)^(2:ℕ)-1≠0)
    (hD : (primeParameter 2 m s)^(4:ℕ)- (primeParameter 2 m s)^(2:ℕ)+(primeParameter 3 m s)^(2:ℕ)+3=0) : (primeParameter 2 m s)^(4:ℕ)+2=0 := by
  let x := primeParameter 2 m s
  let y := primeParameter 3 m s
  let z := primeParameter 5 m s
  let w := primeParameter 7 m s
  have hx : x≠0 := primeParameter_ne_zero 2 m (by decide) s
  have hy : y≠0 := primeParameter_ne_zero 3 m (by decide) s
  have hw : w≠0 := primeParameter_ne_zero 7 m (by decide) s
  obtain ⟨v',h84,h42,h192,hAr,hBr,ha,hb,hwrel⟩ :=
    original_negative_generic_normalization hm hf ε hε hlaw hphase h5 h7
      BG G hG hGF s v hv hshift hr hz hA
  have hreg := original_negative_regular_branch hm hf ε hε hlaw hphase h5 h7
    BG G hG hGF s v hv hshift hr hz hA
  have hC : x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1≠0 := hreg.2.2.1
  have hD' : x^(4:ℕ)-x^(2:ℕ)+y^(2:ℕ)+3=0 := hD
  have hX : x^(2:ℕ)-1≠0 := by
    intro h
    apply hC
    linear_combination 2*(x^(2:ℕ)-1)*h-hD'
  have hpivot := d0_second_pivot_ne_zero m s hD
  have hc := d0_polynomial_consequence x y z w ((Real.sqrt 2:ℂ)*f 2)
    ((Real.sqrt 3:ℂ)*f 3) v' hx hy hw hz h84 h42 h192 ha hb hwrel hD' hX hpivot hAr hBr
  exact (mul_eq_zero.mp hc).resolve_left (sub_ne_zero.mpr hz)

#print axioms original_negative_d0_reduction
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
