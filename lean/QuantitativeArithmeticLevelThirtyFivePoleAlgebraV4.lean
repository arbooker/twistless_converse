theorem original_negative_a0_normalization {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (hphase : ε*I^(2*m)= -1) (h5 : badFive f= -1) (h7 : badSeven f= -1)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ) (v : Fin 210 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hr : v 192≠0) (hz : primeParameter 5 m s≠1)
    (hA : (primeParameter 2 m s)^(4:ℕ)+(primeParameter 3 m s)^(2:ℕ)-1=0) :
    let x := primeParameter 2 m s
    let y := primeParameter 3 m s
    let z := primeParameter 5 m s
    let w := primeParameter 7 m s
    let a := (Real.sqrt 2:ℂ)*f 2
    let b := (Real.sqrt 3:ℂ)*f 3
    ∃ v', v' 192=1 ∧
      v' 84=w*(z-1)/(2*x^(4:ℕ)-3*x^(2:ℕ)-2)-v' 42 ∧
      negativeRowsAConclusion x y z w a b v' ∧
      negativeRowsBConclusion x y z w a b v' ∧
      a= -x-1/x ∧ b=(x^(4:ℕ)-x^(2:ℕ)-2)/y ∧
      w=x^(2:ℕ)*z-x^(2:ℕ)-1 ∧ 2*x^(4:ℕ)-3*x^(2:ℕ)-2≠0 := by
  let x := primeParameter 2 m s
  let y := primeParameter 3 m s
  let z := primeParameter 5 m s
  let w := primeParameter 7 m s
  let a := (Real.sqrt 2:ℂ)*f 2
  let b := (Real.sqrt 3:ℂ)*f 3
  have hx : x≠0 := primeParameter_ne_zero 2 m (by decide) s
  have hy : y≠0 := primeParameter_ne_zero 3 m (by decide) s
  change x^(4:ℕ)+y^(2:ℕ)-1=0 at hA
  obtain ⟨v',hv',h192,hAr,hBr,he⟩ := original_negative_normalized_system
    hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v hv hshift hr
  have hr' : v' 192≠0 := by rw [h192]; norm_num
  obtain ⟨hp,hwrel,hC,_⟩ := original_negative_all_branch
    hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v' hv' hshift hr' hz
  obtain ⟨_,_,hc⟩ := original_negative_branch_parameter
    hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v' hv' hshift hr' hz
  change x^(4:ℕ)-x^(2:ℕ)-y*b-2=0 at hp
  change x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1≠0 at hC
  change (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(v' 84+v' 42)=w*(z-1)*v' 192 at hc
  change 1+x*a+x^(2:ℕ)=0 at he
  have hc0 : 2*x^(4:ℕ)-3*x^(2:ℕ)-2≠0 := by
    intro hh; apply hC; linear_combination hh-hA
  have hcnorm : -2-x^(2:ℕ)*3+x^(4:ℕ)*2≠0 := by
    convert hc0 using 1; ring
  rw [h192,mul_one] at hc
  refine ⟨v',h192,?_,hAr,hBr,?_,?_,hwrel,hc0⟩
  · change v' 84=w*(z-1)/(2*x^(4:ℕ)-3*x^(2:ℕ)-2)-v' 42
    linear_combination (norm := (field_simp [hc0]; ring_nf; field_simp [hcnorm]; ring))
      (1/(2*x^(4:ℕ)-3*x^(2:ℕ)-2))*(hc+(v' 84+v' 42)*hA)
  · change a= -x-1/x
