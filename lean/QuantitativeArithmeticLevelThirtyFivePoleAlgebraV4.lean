/-- The denominator is the same quadratic exponential whose zero
multiplicity was already bounded in the level-19 argument. -/
theorem denominator_order_le_two (k : ℕ) (f : ℕ → ℂ) (s : ℂ) :
    analyticOrderAt (denominator k f) s≤2 := by
  have he : denominator k f=QuantitativeArithmeticSmallLevelNineteen.denominator k f := by
    funext z
    unfold denominator QuantitativeArithmeticSmallLevelNineteen.denominator
      QuantitativeArithmeticSmallLevelNineteen.heckeScalar
      QuantitativeArithmeticSmallLevelNineteen.oppositeScalar
    ring
  rw [he]
  exact QuantitativeArithmeticSmallLevelNineteen.denominator_order_le_two k f s

/-- The odd difference in any continued grid agrees with the actual
quadratic quotient as a punctured germ. -/
theorem grid_chi3_quotient_germ {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z) (x : ℂ) :
    (fun z => G z 70-G z 140)=ᶠ[𝓝[≠] x]
      (fun z => numerator m f z/denominator (2*m) f z) := by
  obtain ⟨B,H,hH,hagree,_,hgerm⟩ := original_continuation m hm hf
  have he : (fun z => G z 70-G z 140)=ᶠ[𝓝[≠] x] H := by
    apply SmallLevelContinuation.halfplane_germ_identity (x.re-1) (max BG B) _ _ _ x (by linarith)
    · intro z _
      exact (hG 70 z).meromorphicAt.sub (hG 140 z).meromorphicAt
    · intro z _
      exact (hH z).meromorphicAt
    · intro z hz
      change G z (gridIndex 70)-G z (gridIndex (-70))=H z
      rw [hGF z (lt_of_le_of_lt (le_max_left BG B) hz),
        hagree z (lt_of_le_of_lt (le_max_right BG B) hz),gridVector_index,gridVector_index]
      norm_num [SmallLevelAdditive.grid]
  exact he.trans (hgerm x)

/-- Every actual grid chi3 difference has at most a double pole. -/
theorem grid_chi3_order_ge_neg_two {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z) (s : ℂ) :
    (-2:WithTop ℤ)≤meromorphicOrderAt (fun z => G z 70-G z 140) s := by
  have ha := (original_numerator_entire m hm hf).analyticAt s
  have hd := (denominator_entire (2*m) f).analyticAt s
  have hbound := denominator_order_le_two (2*m) f s
  have hfinite : analyticOrderAt (denominator (2*m) f) s≠⊤ := by
    intro htop
    rw [htop] at hbound
    exact (not_le_of_gt (ENat.natCast_lt_top 2)) hbound
  obtain ⟨n,hn⟩ := ENat.ne_top_iff_exists.mp hfinite
  have hn2 : n≤2 := by exact_mod_cast (hn ▸ hbound)
  rw [meromorphicOrderAt_congr (grid_chi3_quotient_germ hm hf BG G hG hGF s)]
  change (-2:WithTop ℤ)≤meromorphicOrderAt (numerator m f / denominator (2*m) f) s
  rw [meromorphicOrderAt_div ha.meromorphicAt hd.meromorphicAt,hd.meromorphicOrderAt_eq,← hn]
  simp only [ENat.map_natCast]
  have hnonneg := ha.meromorphicOrderAt_nonneg
  cases he : meromorphicOrderAt (numerator m f) s with
  | top => simp
  | coe t =>
    rw [he] at hnonneg
    have ht : (0:ℤ)≤t := by exact_mod_cast hnonneg
    rw [← WithTop.LinearOrderedAddCommGroup.coe_sub]
    change ((-2:ℤ):WithTop ℤ)≤((t-(n:ℤ):ℤ):WithTop ℤ)
    exact_mod_cast (show (-2:ℤ)≤t-(n:ℤ) by omega)

/-- The source coordinate needed for the closed four-coordinate system
has at most a double pole, independently of all other grid pole orders. -/
theorem coordinate192_order_ge_neg_two {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n)) :
    (-2:WithTop ℤ)≤meromorphicOrderAt (fun z => G z 192) s := by
  have hP (p : ℕ) (hp : p≠0) := primeParameter_analytic p m hp s
  have hC : AnalyticAt ℂ (fun z => 2*(ε*I^(2*m))*primeParameter 5 m z*
      primeParameter 7 m z/(primeParameter 3 m z)^2) s :=
    ((analyticAt_const.mul (hP 5 (by decide))).mul (hP 7 (by decide))).div
      ((hP 3 (by decide)).pow 2) (pow_ne_zero _ (primeParameter_ne_zero 3 m (by decide) s))
  have hε0 : ε≠0 := by rcases hε with rfl|rfl <;> norm_num
  have hC0 : 2*(ε*I^(2*m))*primeParameter 5 m s*primeParameter 7 m s/
      (primeParameter 3 m s)^2≠0 := by
    exact div_ne_zero (mul_ne_zero (mul_ne_zero
      (mul_ne_zero (by norm_num) (mul_ne_zero hε0 (pow_ne_zero _ I_ne_zero)))
      (primeParameter_ne_zero 5 m (by decide) s)) (primeParameter_ne_zero 7 m (by decide) s))
      (pow_ne_zero _ (primeParameter_ne_zero 3 m (by decide) s))
  exact order_lower_of_unit_relation ((hG 70 s).meromorphicAt.sub (hG 140 s).meromorphicAt)
    hC hC0 (analytic_chi3_coordinate_relation hm hf ε hε hlaw BG G hG hGF s hshift)
    (by change ((-2:ℤ):WithTop ℤ)≤((0:ℤ):WithTop ℤ); exact WithTop.coe_le_coe.mpr (by omega)) (grid_chi3_order_ge_neg_two hm hf BG G hG hGF s)

#print axioms denominator_order_le_two
#print axioms grid_chi3_quotient_germ
#print axioms grid_chi3_order_ge_neg_two
#print axioms coordinate192_order_ge_neg_two
end QuantitativeArithmeticSmallLevelThirtyFiveChiThree
