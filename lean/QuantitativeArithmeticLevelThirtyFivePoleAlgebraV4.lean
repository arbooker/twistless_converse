  obtain ⟨hP,hQ⟩ := original_negative_generic_elimination hm hf ε hε hlaw hphase h5 h7
    BG G hG hGF s v hv hshift hr hz hA hD
  obtain ⟨hx,hy,hyx⟩ := physical_parameters m s hs
