/-! ## ThirtyFivePhysicalParameters -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords

theorem primeParameter_norm (p m : ℕ) (hp : 0<p) (s : ℂ) :
    ‖primeParameter p m s‖=(p:ℝ)^(s.re-(m:ℝ)) := by
  simp [primeParameter,Complex.norm_natCast_cpow_of_pos hp]

theorem primeParameter_pow_norm (p m n : ℕ) (hp : 0<p) (s : ℂ) :
    ‖primeParameter p m s^n‖=((p:ℝ)^n)^(s.re-(m:ℝ)) := by
  rw [norm_pow,primeParameter_norm p m hp s]
  calc
    ((p:ℝ)^(s.re-(m:ℝ)))^n = (p:ℝ)^((s.re-(m:ℝ))*(n:ℝ)) :=
      (Real.rpow_mul_natCast (Nat.cast_nonneg p) _ n).symm
    _ = (p:ℝ)^((n:ℝ)*(s.re-(m:ℝ))) := by rw [mul_comm]
    _ = ((p:ℝ)^n)^(s.re-(m:ℝ)) := Real.rpow_natCast_mul (Nat.cast_nonneg p) n _

/-- In the half-plane on or to the right of the symmetry center, the
prime-2 and prime-3 variables obey the bounds used by the disk exclusion. -/
theorem physical_parameters (m : ℕ) (s : ℂ) (hs : (m:ℝ)≤s.re) :
    1≤‖primeParameter 2 m s^(2:ℕ)‖ ∧
    1≤‖primeParameter 3 m s^(2:ℕ)‖ ∧
    ‖primeParameter 3 m s^(2:ℕ)‖≤‖primeParameter 2 m s^(2:ℕ)‖^2 := by
  have ha : 0≤s.re-(m:ℝ) := sub_nonneg.mpr hs
  have hx : ‖primeParameter 2 m s^(2:ℕ)‖=(4:ℝ)^(s.re-(m:ℝ)) := by
    have h := primeParameter_pow_norm 2 m 2 (by decide) s
    norm_num only [Nat.cast_ofNat] at h
    exact h
  have hy : ‖primeParameter 3 m s^(2:ℕ)‖=(9:ℝ)^(s.re-(m:ℝ)) := by
    have h := primeParameter_pow_norm 3 m 2 (by decide) s
    norm_num only [Nat.cast_ofNat] at h
    exact h
  rw [hx,hy]
  refine ⟨Real.one_le_rpow (by norm_num) ha,Real.one_le_rpow (by norm_num) ha,?_⟩
  calc
    (9:ℝ)^(s.re-(m:ℝ)) ≤ (16:ℝ)^(s.re-(m:ℝ)) :=
      Real.rpow_le_rpow (by norm_num) (by norm_num) ha
    _ = ((4:ℝ)^(s.re-(m:ℝ)))^2 := by
      have h := Real.mul_rpow (x:=(4:ℝ)) (y:=4) (z:=s.re-(m:ℝ))
        (by norm_num) (by norm_num)
      simpa only [show (4:ℝ)*4=16 by norm_num,pow_two] using h

#print axioms primeParameter_norm
#print axioms primeParameter_pow_norm
#print axioms physical_parameters
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
end

/-! ## ThirtyFiveA0Pivots -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords

theorem a0_first_pivot (m : ℕ) (s : ℂ)
    (hA : (primeParameter 2 m s)^(4:ℕ)+(primeParameter 3 m s)^(2:ℕ)-1=0) :
    (primeParameter 2 m s)^(2:ℕ)-4≠0 := by
  intro h
  have hx : (primeParameter 2 m s)^(2:ℕ)=4 := by linear_combination h
  have hn := primeParameter_pow_norm 2 m 2 (by decide) s
  rw [hx] at hn
  norm_num only [Nat.cast_ofNat,Complex.norm_ofNat] at hn
  have ha : s.re-(m:ℝ)=1 :=
    (Real.rpow_right_inj (by norm_num : (0:ℝ)<4) (by norm_num : (4:ℝ)≠1)).mp
      (by simpa only [Real.rpow_one] using hn.symm)
  have hy : (primeParameter 3 m s)^(2:ℕ)= -15 := by
    linear_combination hA-((primeParameter 2 m s)^(2:ℕ)+4)*h
  have hny := primeParameter_pow_norm 3 m 2 (by decide) s
  rw [hy,ha,Real.rpow_one] at hny
  norm_num at hny

theorem a0_second_pivot (m : ℕ) (s : ℂ)
    (hA : (primeParameter 2 m s)^(4:ℕ)+(primeParameter 3 m s)^(2:ℕ)-1=0) :
    (primeParameter 2 m s)^(4:ℕ)+1≠0 := by
  intro h
  have hx : (primeParameter 2 m s)^(4:ℕ)= -1 := by linear_combination h
  have hn := primeParameter_pow_norm 2 m 4 (by decide) s
  rw [hx] at hn
  norm_num only [Nat.cast_ofNat,norm_neg,norm_one] at hn
  have ha : s.re-(m:ℝ)=0 :=
    (Real.rpow_right_inj (by norm_num : (0:ℝ)<16) (by norm_num : (16:ℝ)≠1)).mp
      (by simpa only [Real.rpow_zero] using hn.symm)
  have hy : (primeParameter 3 m s)^(2:ℕ)=2 := by linear_combination hA-h
  have hny := primeParameter_pow_norm 3 m 2 (by decide) s
  rw [hy,ha,Real.rpow_zero] at hny
  norm_num at hny

theorem unit_triangle_square_not_unit (X : ℂ)
    (hX : ‖X‖=1) (hXm : ‖X-1‖=1) (hY : ‖1-X^(2:ℕ)‖=1) : False := by
  have h1 := Complex.normSq_eq_norm_sq X
  have h2 := Complex.normSq_eq_norm_sq (X-1)
  rw [hX] at h1
  rw [hXm] at h2
  norm_num [Complex.normSq] at h1 h2
  have hr : X.re=1/2 := by nlinarith
  have hi : X.im^2=3/4 := by rw [hr] at h1; nlinarith
  have h3 := Complex.normSq_eq_norm_sq (1-X^(2:ℕ))
  rw [hY] at h3
  norm_num [Complex.normSq,pow_two,Complex.mul_re,Complex.mul_im,hr] at h3
  nlinarith [sq_nonneg (X.im^2-3/4)]

#print axioms a0_first_pivot
#print axioms a0_second_pivot
#print axioms unit_triangle_square_not_unit
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
