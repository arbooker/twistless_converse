/-! ## ThirtyFiveA0ThirdPivot -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
open Complex

/-- The last short-row pivot cannot vanish on the physical A=0 branch.
The borderline norm case uses independence of the primes 2 and 3. -/
theorem a0_third_pivot (m : ℕ) (s : ℂ) (hs : (m:ℝ)≤s.re)
    (hA : (primeParameter 2 m s)^4+(primeParameter 3 m s)^2-1=0) :
    2*(primeParameter 2 m s)^4-3*(primeParameter 2 m s)^2-2≠0 := by
  let x := primeParameter 2 m s
  let y := primeParameter 3 m s
  change x^4+y^2-1=0 at hA
  intro hC
  change 2*x^4-3*x^2-2=0 at hC
  have hprod : (2*x^2+1)*(x^2-2)=0 := by linear_combination hC
  rcases mul_eq_zero.mp hprod with hneg|hpos
  · have hx : x^2= -(1/2:ℂ) := by linear_combination hneg/2
    have hn := (physical_parameters m s hs).1
    change 1≤‖x^2‖ at hn
    rw [hx] at hn
    norm_num at hn
  · have hx : x^2=2 := by linear_combination hpos
    have hy : y^2= -3 := by linear_combination hA-(x^2+2)*hpos
    let t : ℂ := 2*(s-(m:ℂ))-1
    have h2 : (2:ℂ)^t=1 := by
      dsimp [t]
      rw [Complex.cpow_sub _ _ (by norm_num),Complex.cpow_one]
      have hh : (2:ℂ)^(2*(s-(m:ℂ)))=x^2 := by
        simpa only [x,primeParameter,Nat.cast_ofNat] using
          (Complex.cpow_nat_mul (2:ℂ) 2 (s-(m:ℂ)))
      rw [hh,hx]
      norm_num
    have h3 : (3:ℂ)^t= -1 := by
      dsimp [t]
      rw [Complex.cpow_sub _ _ (by norm_num),Complex.cpow_one]
      have hh : (3:ℂ)^(2*(s-(m:ℂ)))=y^2 := by
        simpa only [y,primeParameter,Nat.cast_ofNat] using
          (Complex.cpow_nat_mul (3:ℂ) 2 (s-(m:ℂ)))
      rw [hh,hy]
      norm_num
    have ht := QuantitativeArithmeticPrimePowerTorsion.distinct_primes_cpow_torsion
      (p:=2) (q:=3) (by norm_num) (by norm_num) (by decide) t 1 2 (by decide) (by decide)
      (by norm_num only [Nat.cast_ofNat]; rw [h2]; norm_num)
      (by norm_num only [Nat.cast_ofNat]; rw [h3]; norm_num)
    rw [ht,Complex.cpow_zero] at h3
    norm_num at h3

#print axioms a0_third_pivot
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
