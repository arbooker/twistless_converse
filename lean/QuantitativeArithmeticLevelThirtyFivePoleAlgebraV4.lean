/-! ## ThirtyFiveD0Quartic -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
open QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate

theorem d0_quartic_row104 (x y z t : ℂ)
    (hN : genericRow104 x y z t=0)
    (hD : x^(4:ℕ)-x^(2:ℕ)+y^(2:ℕ)+3=0) (hQ : x^(4:ℕ)+2=0) :
    z^(2:ℕ)-2*(x^(2:ℕ)+1)*z-11*x^(2:ℕ)-1=0 := by
  unfold genericRow104 at hN
  linear_combination -(1/2:ℂ)*hN+
    ((-(z-1)*(x^(2:ℕ)*z-x^(2:ℕ)-1)*t+x^(2:ℕ)+6)/2)*hD-(x^(2:ℕ)+4)*hQ

theorem quartic_prime_five_norm (m : ℕ) (s : ℂ)
    (hQ : (primeParameter 2 m s)^(4:ℕ)+2=0) :
    ‖primeParameter 5 m s‖^(4:ℕ)=5 := by
  have hq : (primeParameter 2 m s)^(4:ℕ)= -2 := by linear_combination hQ
  have hn : ‖(primeParameter 2 m s)^(4:ℕ)‖=2 := by rw [hq]; norm_num
  have hp := primeParameter_pow_norm 2 m 4 (by decide) s
  rw [hn,← Real.rpow_natCast_mul (x:=((2:ℕ):ℝ)) (Nat.cast_nonneg 2) 4] at hp
  norm_num only [Nat.cast_ofNat] at hp
  have he : (4:ℝ)*(s.re-(m:ℝ))=1 :=
    (Real.rpow_right_inj (by norm_num : (0:ℝ)<2) (by norm_num : (2:ℝ)≠1)).mp
      (by simpa only [Real.rpow_one] using hp.symm)
  have hz := primeParameter_pow_norm 5 m 4 (by decide) s
  rw [norm_pow,← Real.rpow_natCast_mul (x:=((5:ℕ):ℝ)) (Nat.cast_nonneg 5) 4] at hz
  norm_num only [Nat.cast_ofNat] at hz
  rw [he,Real.rpow_one] at hz
  exact hz

theorem quartic_norm_contradiction (X Z : ℂ)
    (hX : X^(2:ℕ)+2=0) (hZ : ‖Z‖^(4:ℕ)=5)
    (hT : Z^(2:ℕ)-2*(X+1)*Z-11*X-1=0) : False := by
  have hxq : X^(2:ℕ)= -2 := by linear_combination hX
  have hnx : ‖X‖^(2:ℕ)=2 := by
    have h := congrArg norm hxq
    simpa using h
  have hxL : (1:ℝ)≤‖X‖ :=
    (sq_le_sq₀ (by norm_num) (norm_nonneg _)).mp (by rw [hnx]; norm_num)
  have hxU : ‖X‖≤(3/2:ℝ) :=
    (sq_le_sq₀ (norm_nonneg _) (by norm_num)).mp (by rw [hnx]; norm_num)
  have hzU : ‖Z‖≤(3/2:ℝ) := by
    by_contra h
    have hh : (3/2:ℝ)≤‖Z‖ := (lt_of_not_ge h).le
    have hp := pow_le_pow_left₀ (by norm_num : (0:ℝ)≤3/2) hh 4
    rw [hZ] at hp
    norm_num at hp
  have hplus : ‖X+1‖≤(5/2:ℝ) := by
    have h := norm_add_le X 1
    norm_num at h
    linarith
  have hl : (10:ℝ)≤‖11*X+1‖ := by
    have h : ‖11*X‖≤‖11*X+1‖+1 := by
      simpa only [add_sub_cancel_right,norm_one] using norm_sub_le (11*X+1) 1
    norm_num [norm_mul] at h
    linarith
  have heq : 11*X+1=Z^(2:ℕ)-2*(X+1)*Z := by linear_combination -hT
  have hu : ‖11*X+1‖≤‖Z‖^(2:ℕ)+2*‖X+1‖*‖Z‖ := by
    rw [heq]
    simpa [norm_mul,norm_pow] using norm_sub_le (Z^(2:ℕ)) (2*(X+1)*Z)
  have hprod : 2*‖X+1‖*‖Z‖≤(15/2:ℝ) := by
    calc
      _ ≤ (2*(5/2:ℝ))*(3/2) :=
        mul_le_mul (mul_le_mul_of_nonneg_left hplus (by norm_num)) hzU
          (norm_nonneg _) (by norm_num)
      _ = _ := by norm_num
  have hz2 : ‖Z‖^(2:ℕ)≤(9/4:ℝ) := by
    convert pow_le_pow_left₀ (norm_nonneg _) hzU 2 using 1; norm_num
  linarith

#print axioms d0_quartic_row104
#print axioms quartic_prime_five_norm
#print axioms quartic_norm_contradiction
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
