theorem unit_parameter_C_ne_zero (X Y : ℂ) (hX : ‖X‖=1) (hY : ‖Y‖=1) :
    X^(2:ℕ)-3*X-Y-1≠0 := by
  intro he
  have hx : X≠0 := by intro h; rw [h,norm_zero] at hX; norm_num at hX
  have hdiv : Y/X=X-X⁻¹-3 := by
    linear_combination (norm := (field_simp [hx]; ring)) -(1/X)*he
  have hre : (Y/X).re= -3 := by
    rw [hdiv,Complex.inv_eq_conj hX]
    simp
  have h := Complex.abs_re_le_norm (Y/X)
  rw [hre,norm_div,hY,hX] at h
  norm_num at h

theorem prime_five_one_real_center (m : ℕ) (s : ℂ)
    (hz : primeParameter 5 m s=1) : s.re-(m:ℝ)=0 := by
  have h := primeParameter_norm 5 m (by decide) s
  rw [hz,norm_one] at h
  norm_num only [Nat.cast_ofNat] at h
  exact (Real.rpow_right_inj (by norm_num : (0:ℝ)<5) (by norm_num : (5:ℝ)≠1)).mp
    (by simpa only [Real.rpow_zero] using h.symm)

theorem prime_five_one_C_ne_zero (m : ℕ) (s : ℂ)
    (hz : primeParameter 5 m s=1) :
    (primeParameter 2 m s)^(4:ℕ)-3*(primeParameter 2 m s)^(2:ℕ)-
      (primeParameter 3 m s)^(2:ℕ)-1≠0 := by
  have ha := prime_five_one_real_center m s hz
  have hx := primeParameter_pow_norm 2 m 2 (by decide) s
  have hy := primeParameter_pow_norm 3 m 2 (by decide) s
  rw [ha,Real.rpow_zero] at hx hy
  have h := unit_parameter_C_ne_zero ((primeParameter 2 m s)^(2:ℕ))
    ((primeParameter 3 m s)^(2:ℕ)) hx hy
  simpa only [← pow_mul] using h

theorem prime_five_one_seven_not_neg_one (m : ℕ) (s : ℂ)
    (hz : primeParameter 5 m s=1) : primeParameter 7 m s+1≠0 := by
  intro hw
  have h7 : primeParameter 7 m s= -1 := by linear_combination hw
  have hs := QuantitativeArithmeticPrimePowerTorsion.distinct_primes_cpow_torsion
    (p:=5) (q:=7) (by norm_num) (by norm_num) (by decide) (s-(m:ℂ))
    1 2 (by decide) (by decide)
    (by simpa [primeParameter] using hz)
    (by change (primeParameter 7 m s)^(2:ℕ)=1; rw [h7]; norm_num)
  have hseven : primeParameter 7 m s=1 := by
    dsimp [primeParameter]
    rw [hs,Complex.cpow_zero]
  rw [hseven] at hw
  norm_num at hw

