/-! ## ThirtyFiveNegativeBranchAlgebra -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate

/-- Rows 45, 150 and 159 force the auxiliary eigenvalue onto the explicit
branch P2=0 whenever the quadratic residue survives and z differs from 1.
This also covers A=0; no division by A or by a good Hecke eigenvalue occurs. -/
theorem negative_branch_parameter (x y z w a b u t r : ℂ)
    (hy : y≠0) (hw : w≠0) (hz : z≠1) (hr : r≠0)
    (he : 1+x*a+x^(2:ℕ)=0)
    (h45 : (1-y*b-2*y^(2:ℕ)+3*x*a-2*x^(2:ℕ)-x^(3:ℕ)*a)*u +
      (-y^(2:ℕ)+x*a-2*x^(2:ℕ)+x^(4:ℕ))*t+(w-z*w)*r=0)
    (h150 : ((-2*y*b-2*y^(2:ℕ)+2*x*a)/y^(2:ℕ))*u=0)
    (h159 : ((-2+y^(2:ℕ)-x*a-2*x^(2:ℕ)-x^(3:ℕ)*a)/y^(2:ℕ))*u+
      ((-1-y*b+x*a+x^(4:ℕ))/y^(2:ℕ))*t=0) :
    x^(4:ℕ)-x^(2:ℕ)-y*b-2=0 ∧
    (y*b+x^(2:ℕ)+y^(2:ℕ)+1)*u=0 ∧
    (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(t+u)=w*(z-1)*r := by
  have h1 : (y*b+x^(2:ℕ)+y^(2:ℕ)+1)*u=0 := by
    linear_combination (norm := (field_simp [hy]; ring))
      -(y^(2:ℕ)/2)*h150+u*he
  have h2 : (x^(4:ℕ)-x^(2:ℕ)-y*b-2)*t+(x^(4:ℕ)+y^(2:ℕ)-1)*u=0 := by
    linear_combination (norm := (field_simp [hy]; ring))
      y^(2:ℕ)*h159-(t-(1+x^(2:ℕ))*u)*he
  have hc : (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(t+u)=w*(z-1)*r := by
    linear_combination h45+h1-((3-x^(2:ℕ))*u+t)*he
  have htu : t+u≠0 := by
    intro hzero
    rw [hzero, mul_zero] at hc
    exact (mul_ne_zero (mul_ne_zero hw (sub_ne_zero.mpr hz)) hr) hc.symm
  have hp : (x^(4:ℕ)-x^(2:ℕ)-y*b-2)*(t+u)=0 := by
    linear_combination h2-h1
  exact ⟨(mul_eq_zero.mp hp).resolve_right htu, h1, hc⟩

theorem negative_branch_regular (x y z w b u t r : ℂ)
    (hw : w≠0) (hz : z≠1) (hr : r≠0)
    (hA : x^(4:ℕ)+y^(2:ℕ)-1≠0)
    (hp : x^(4:ℕ)-x^(2:ℕ)-y*b-2=0)
    (h1 : (y*b+x^(2:ℕ)+y^(2:ℕ)+1)*u=0)
    (hc : (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(t+u)=w*(z-1)*r) :
    u=0 ∧ (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*t=w*(z-1)*r ∧
    x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1≠0 ∧ t≠0 := by
  have hu : u=0 := by
    have ha : (x^(4:ℕ)+y^(2:ℕ)-1)*u=0 := by
      linear_combination h1+u*hp
    exact (mul_eq_zero.mp ha).resolve_left hA
  rw [hu, add_zero] at hc
  have hn : (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*t≠0 := by
    rw [hc]
    exact mul_ne_zero (mul_ne_zero hw (sub_ne_zero.mpr hz)) hr
  exact ⟨hu, hc, (mul_ne_zero_iff.mp hn).1, (mul_ne_zero_iff.mp hn).2⟩

#print axioms negative_branch_parameter
#print axioms negative_branch_regular
end QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate
