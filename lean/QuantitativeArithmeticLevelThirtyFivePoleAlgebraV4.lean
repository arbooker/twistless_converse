    mul_ne_zero (mul_ne_zero (sub_ne_zero.mpr hz) (pow_ne_zero 2 hx1)) hD
  refine ⟨(mul_eq_zero.mp (generic_p17_certificate x y z h0 h1 h2)).resolve_left hg,?_⟩
  exact sub_eq_zero.mp ((mul_eq_zero.mp (generic_y_certificate x y z h0 h1 h2)).resolve_left hg)

