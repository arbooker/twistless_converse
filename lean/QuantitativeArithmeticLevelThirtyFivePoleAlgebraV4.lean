/-- The generic polynomial consequences, with all saturation factors removed
by checked identities. Linkage to the normalized actual rows is separate. -/
theorem generic_elimination (x y z : ℂ)
    (h0 : genericInput0 x y z=0) (h1 : genericInput1 x y z=0)
    (h2 : genericInput2 x y z=0) (hz : z≠1) (hD : x^(2:ℕ)-x+y+3≠0) :
    genericP17 x=0 ∧ y=genericQ16 x := by
  have hx3 : x^(3:ℕ)+1≠0 := by
    intro h3
    exact (mul_ne_zero (pow_ne_zero 2 (sub_ne_zero.mpr hz)) hD)
      (generic_root_unity_certificate x y z h0 h1 h2 h3)
