  have hp2' : d0Input2 (x^(2:ℕ)) z=0 :=
    (mul_eq_zero.mp hp2).resolve_left (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num) hxminus) hxplus) hz') hw')
  have hp3 : (-2*(x - 1)*(x + 1)*(z - 1)*(x^(2:ℕ)*z - x^(2:ℕ) - 1))*d0Input3 (x^(2:ℕ)) z=0 := by
    unfold d0Input3
    linear_combination (x^(8:ℕ)*z^(2:ℕ)-2*x^(8:ℕ)*z+x^(8:ℕ)-2*x^(6:ℕ)*z^(2:ℕ)+3*x^(6:ℕ)*z-x^(6:ℕ)+5*x^(4:ℕ)*z^(2:ℕ)-8*x^(4:ℕ)*z+3*x^(4:ℕ)-4*x^(2:ℕ)*z^(2:ℕ)+3*x^(2:ℕ)*z+x^(2:ℕ)+4*z-4)*h0-(x^(10:ℕ)*z^(2:ℕ)-2*x^(10:ℕ)*z+x^(10:ℕ)-x^(8:ℕ)*z^(2:ℕ)+x^(8:ℕ)*z+4*x^(6:ℕ)*z^(2:ℕ)-7*x^(6:ℕ)*z+3*x^(6:ℕ)-2*x^(4:ℕ)*z^(2:ℕ)+2*x^(4:ℕ)+4*x^(2:ℕ)*z^(2:ℕ)-6*x^(2:ℕ)*z+2*x^(2:ℕ)-4*z+4)*h21
