/-- Row53 forces the w relation even on the exceptional A=0 branch. -/
theorem negative_rows_b_all_branch_w (x y z w a b : ℂ) (v : Fin 210 → ℂ)
    (hw : w≠0) (hr : v 192≠0)
    (he : 1+x*a+x^(2:ℕ)=0)
    (hp : x^(4:ℕ)-x^(2:ℕ)-y*b-2=0)
    (h1 : (y*b+x^(2:ℕ)+y^(2:ℕ)+1)*v 42=0)
    (hc : (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(v 84+v 42)=w*(z-1)*v 192)
    (hB : negativeRowsBConclusion x y z w a b v) :
    w=x^(2:ℕ)*z-x^(2:ℕ)-1 := by
  rcases hB with ⟨h16,h19,h21,h26,h45,h53,h104,h150,h159,h163,h164⟩
  have ha : (x^(4:ℕ)+y^(2:ℕ)-1)*v 42=0 := by
    linear_combination h1+(v 42)*hp
  have hprod : (x^(2:ℕ)*(z-1)-1-w)*(w*v 192)=0 := by
    linear_combination (norm := (field_simp [hw]; ring))
      w*h53-x^(2:ℕ)*hc+x^(2:ℕ)*ha-
      ((v 42)*((y*b-y^(2:ℕ)-x^(2:ℕ))*(x*a-1-x^(2:ℕ))+y*b+x^(2:ℕ)*y*b-x^(2:ℕ)*y^(2:ℕ))+
       (v 84)*(3-x*a-2*x^(2:ℕ)+y*b-x^(2:ℕ)*y*b+x^(2:ℕ)*y^(2:ℕ)+x^(4:ℕ)))*he+
      ((x^(2:ℕ)-2)*(v 42)+(2*x^(2:ℕ)-2)*(v 84))*hp
  have h := (mul_eq_zero.mp hprod).resolve_right (mul_ne_zero hw hr)
  linear_combination -h

theorem original_negative_all_branch {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (hphase : ε*I^(2*m)= -1) (h5 : badFive f= -1) (h7 : badSeven f= -1)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ) (v : Fin 210 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hr : v 192≠0) (hz : primeParameter 5 m s≠1) :
    let x := primeParameter 2 m s
    let y := primeParameter 3 m s
    let z := primeParameter 5 m s
    let w := primeParameter 7 m s
    let b := (Real.sqrt 3:ℂ)*f 3
    x^(4:ℕ)-x^(2:ℕ)-y*b-2=0 ∧
    w=x^(2:ℕ)*z-x^(2:ℕ)-1 ∧
    x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1≠0 ∧ v 84+v 42≠0 := by
  let x := primeParameter 2 m s
  let y := primeParameter 3 m s
  let z := primeParameter 5 m s
  let w := primeParameter 7 m s
  let a := (Real.sqrt 2:ℂ)*f 2
  let b := (Real.sqrt 3:ℂ)*f 3
  have hx : x≠0 := primeParameter_ne_zero 2 m (by decide) s
  have hw : w≠0 := primeParameter_ne_zero 7 m (by decide) s
  have hb := original_negative_branch_parameter hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v hv hshift hr hz
  rcases hb with ⟨hp,h1,hc⟩
  have hB := original_negative_rows_b hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v hv hshift
  have he0 := original_negative_row118 hm hf ε hε hlaw hphase BG G hG hGF s v hv hshift
  change ((1+x*a+x^(2:ℕ))/x^(2:ℕ))*v 192=0 at he0
  have he1 : (1+x*a+x^(2:ℕ))*v 192=0 := by
    linear_combination (norm := (field_simp [hx]; ring)) x^(2:ℕ)*he0
  have he := (mul_eq_zero.mp he1).resolve_right hr
  have hwrel := negative_rows_b_all_branch_w x y z w a b v hw hr he hp h1 hc hB
  have hn : (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(v 84+v 42)≠0 := by
    rw [hc]
    exact mul_ne_zero (mul_ne_zero hw (sub_ne_zero.mpr hz)) hr
  exact ⟨hp,hwrel,(mul_ne_zero_iff.mp hn).1,(mul_ne_zero_iff.mp hn).2⟩

/-- Exact central-sign certificate, ready for the separate sign-transport step.
This is a row-system implication; no analytic sign transport is assumed proved. -/
theorem negative_rows_b_signed_central (b : ℂ) (v : Fin 210 → ℂ)
    (hB : negativeRowsBConclusion 1 1 1 (-1) (-2) b v) : v 192=0 := by
  rcases hB with ⟨h16,h19,h21,h26,h45,h53,h104,h150,h159,h163,h164⟩
  linear_combination (-1/8 : ℂ)*(2*(h104-h19+h45)+5*h150)

#print axioms negative_rows_b_all_branch_w
#print axioms original_negative_all_branch
#print axioms negative_rows_b_signed_central
