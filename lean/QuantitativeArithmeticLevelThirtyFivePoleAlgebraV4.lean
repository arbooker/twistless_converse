/-- Actual original-input constraints on a surviving quadratic principal part.
All row assumptions are discharged against the continued 210-grid. -/
theorem original_negative_branch_parameter {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (hphase : ε*I^(2*m)= -1) (h5 : badFive f= -1) (h7 : badSeven f= -1)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ) (v : Fin 210 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hr : v 192≠0) (hz : primeParameter 5 m s≠1) :
    let x := primeParameter 2 m s
    let y := primeParameter 3 m s
    let z := primeParameter 5 m s
    let w := primeParameter 7 m s
    let b := (Real.sqrt 3:ℂ)*f 3
    x^(4:ℕ)-x^(2:ℕ)-y*b-2=0 ∧
    (y*b+x^(2:ℕ)+y^(2:ℕ)+1)*v 42=0 ∧
    (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(v 84+v 42)=w*(z-1)*v 192 := by
  let x := primeParameter 2 m s
  let y := primeParameter 3 m s
  let z := primeParameter 5 m s
  let w := primeParameter 7 m s
  let a := (Real.sqrt 2:ℂ)*f 2
  let b := (Real.sqrt 3:ℂ)*f 3
  have hx : x≠0 := primeParameter_ne_zero 2 m (by decide) s
  have hy : y≠0 := primeParameter_ne_zero 3 m (by decide) s
  have hw : w≠0 := primeParameter_ne_zero 7 m (by decide) s
  have hB := original_negative_rows_b hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v hv hshift
  change negativeRowsBConclusion x y z w a b v at hB
  rcases hB with ⟨h16,h19,h21,h26,h45,h53,h104,h150,h159,h163,h164⟩
  have hp := original_negative_row118 hm hf ε hε hlaw hphase BG G hG hGF s v hv hshift
  change ((1+x*a+x^(2:ℕ))/x^(2:ℕ))*v 192=0 at hp
  have hp' : (1+x*a+x^(2:ℕ))*v 192=0 := by
    linear_combination (norm := (field_simp [hx]; ring)) x^(2:ℕ)*hp
  have he := (mul_eq_zero.mp hp').resolve_right hr
  apply QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate.negative_branch_parameter
    x y z w a b (v 42) (v 84) (v 192) hy hw hz hr he
  · linear_combination h45
  · linear_combination (norm := (field_simp [hy]; ring)) h150
  · linear_combination (norm := (field_simp [hy]; ring)) h159

theorem original_negative_regular_branch {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (hphase : ε*I^(2*m)= -1) (h5 : badFive f= -1) (h7 : badSeven f= -1)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ) (v : Fin 210 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hr : v 192≠0) (hz : primeParameter 5 m s≠1)
    (hA : (primeParameter 2 m s)^(4:ℕ)+(primeParameter 3 m s)^(2:ℕ)-1≠0) :
    let x := primeParameter 2 m s
    let y := primeParameter 3 m s
    let z := primeParameter 5 m s
    let w := primeParameter 7 m s
    v 42=0 ∧ w=x^(2:ℕ)*z-x^(2:ℕ)-1 ∧
    x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1≠0 ∧ v 84≠0 := by
  let x := primeParameter 2 m s
  let y := primeParameter 3 m s
  let z := primeParameter 5 m s
  let w := primeParameter 7 m s
  let a := (Real.sqrt 2:ℂ)*f 2
  let b := (Real.sqrt 3:ℂ)*f 3
  have hx : x≠0 := primeParameter_ne_zero 2 m (by decide) s
  have hw : w≠0 := primeParameter_ne_zero 7 m (by decide) s
  have hb := original_negative_branch_parameter hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v hv hshift hr hz
  rcases hb with ⟨hp,h1,hc⟩
  obtain ⟨hu,hct,hC,ht⟩ :=
    QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate.negative_branch_regular
      x y z w b (v 42) (v 84) (v 192) hw hz hr hA hp h1 hc
  have hB := original_negative_rows_b hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v hv hshift
  change negativeRowsBConclusion x y z w a b v at hB
  rcases hB with ⟨h16,h19,h21,h26,h45,h53,h104,h150,h159,h163,h164⟩
  rw [hu, mul_zero, zero_add] at h53
  have he0 := original_negative_row118 hm hf ε hε hlaw hphase BG G hG hGF s v hv hshift
  change ((1+x*a+x^(2:ℕ))/x^(2:ℕ))*v 192=0 at he0
  have he1 : (1+x*a+x^(2:ℕ))*v 192=0 := by
    linear_combination (norm := (field_simp [hx]; ring)) x^(2:ℕ)*he0
  have he := (mul_eq_zero.mp he1).resolve_right hr
  refine ⟨hu, ?_, hC, ht⟩
  apply QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate.negative_branch_w
    x y z w a b (v 84) (v 192) hw hr he hp hct
  linear_combination (norm := (field_simp [hw]; ring)) h53

#print axioms original_negative_regular_branch

#print axioms original_negative_branch_parameter
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
