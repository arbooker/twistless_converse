/-! ## ThirtyFiveA0MixedPivot -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords

theorem a0_mixed_pivot (m : ℕ) (s : ℂ) (hs : (m:ℝ)≤s.re)
    (hA : (primeParameter 2 m s)^(4:ℕ)+(primeParameter 3 m s)^(2:ℕ)-1=0)
    (hw : primeParameter 7 m s=(primeParameter 2 m s)^(2:ℕ)*primeParameter 5 m s-
      (primeParameter 2 m s)^(2:ℕ)-1) :
    (primeParameter 2 m s)^(2:ℕ)*primeParameter 5 m s-
      (primeParameter 2 m s)^(2:ℕ)-primeParameter 5 m s≠0 := by
  let X := (primeParameter 2 m s)^(2:ℕ)
  let Y := (primeParameter 3 m s)^(2:ℕ)
  let Z := primeParameter 5 m s
  let W := primeParameter 7 m s
  change W=X*Z-X-1 at hw
  change X*Z-X-Z≠0
  intro hp
  have hzw : Z=X*W := by linear_combination -X*hw-(1+X)*hp
  have hmw : (X-1)*W=1 := by linear_combination (X-1)*hw+X*hp
  have hZle : ‖Z‖≤‖W‖ := by
    dsimp [Z,W]
    rw [primeParameter_norm 5 m (by decide),primeParameter_norm 7 m (by decide)]
    exact Real.rpow_le_rpow (by norm_num) (by norm_num) (sub_nonneg.mpr hs)
  have hWpos : 0<‖W‖ := by
    dsimp [W]
    rw [primeParameter_norm 7 m (by decide)]
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hN := congrArg norm hzw
  rw [norm_mul] at hN
  have hXge : 1≤‖X‖ := (physical_parameters m s hs).1
  have hX : ‖X‖=1 := by nlinarith
  have hx := primeParameter_pow_norm 2 m 2 (by decide) s
  change ‖X‖=(((2:ℕ):ℝ)^2)^(s.re-(m:ℝ)) at hx
  rw [hX] at hx
  norm_num only [Nat.cast_ofNat] at hx
  have ha : s.re-(m:ℝ)=0 :=
    (Real.rpow_right_inj (by norm_num : (0:ℝ)<4) (by norm_num : (4:ℝ)≠1)).mp
      (by simpa only [Real.rpow_zero] using hx.symm)
  have hW : ‖W‖=1 := by
    dsimp [W]
    rw [primeParameter_norm 7 m (by decide),ha,Real.rpow_zero]
  have hXm : ‖X-1‖=1 := by
    have h := congrArg norm hmw
    simpa only [norm_mul,hW,mul_one,norm_one] using h
  have hY : ‖1-X^(2:ℕ)‖=1 := by
    have he : 1-X^(2:ℕ)=Y := by
      dsimp [X,Y]
      linear_combination -hA
    rw [he]
    dsimp [Y]
    rw [primeParameter_pow_norm 3 m 2 (by decide),ha,Real.rpow_zero]
  exact unit_triangle_square_not_unit X hX hXm hY

#print axioms a0_mixed_pivot
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
