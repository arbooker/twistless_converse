/-! ## ThirtyFiveRootDiskCover -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveRootDisks
open QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate

/-- Every root is covered by the certified rational disks. This uses only
exact barycentric identities and the general Lagrange interpolation bound. -/
theorem generic_root_in_disk (z : ℂ) (hz : genericP17 z=0) :
    ∃ i : Fin 17, ‖z-center i‖ < (1/1000000000000000000 : ℝ) := by
  have hb : ∀ i : Fin 17,
      |(Lagrange.nodalWeight Finset.univ center i*polePolynomial.eval (center i)).re|+
      |(Lagrange.nodalWeight Finset.univ center i*polePolynomial.eval (center i)).im| ≤
      (1/1000000000000000000000 : ℝ) := by
    intro i
    fin_cases i
    · exact node0_bound
    · exact node1_bound
    · exact node2_bound
    · exact node3_bound
    · exact node4_bound
    · exact node5_bound
    · exact node6_bound
    · exact node7_bound
    · exact node8_bound
    · exact node9_bound
    · exact node10_bound
    · exact node11_bound
    · exact node12_bound
    · exact node13_bound
    · exact node14_bound
    · exact node15_bound
    · exact node16_bound
  have hr : ∀ i ∈ (Finset.univ : Finset (Fin 17)),
      (0:ℝ)<1/1000000000000000000 := by intros; norm_num
  have hsmall : ∑ _i : Fin 17, (1/1000:ℝ)<1 := by norm_num
  have hbound : ∀ i ∈ (Finset.univ : Finset (Fin 17)),
      |(Lagrange.nodalWeight Finset.univ center i*polePolynomial.eval (center i)).re|+
      |(Lagrange.nodalWeight Finset.univ center i*polePolynomial.eval (center i)).im| ≤
      (1/1000:ℝ)*(1/1000000000000000000) := by
    intro i _
    convert hb i using 1; norm_num
  obtain ⟨i,_,hi⟩ := QuantitativeArithmeticPolynomialRootCover.monic_root_cover_of_coordinate_bounds
    Finset.univ center (fun _ => 1/1000000000000000000) (fun _ => 1/1000)
    polePolynomial center_injective.injOn polePolynomial_monic
    (by simpa using polePolynomial_degree) hr hbound hsmall z
    (by simpa only [polePolynomial_eval] using hz)
  exact ⟨i,hi⟩

#print axioms generic_root_in_disk
end QuantitativeArithmeticSmallLevelThirtyFiveRootDisks
end
