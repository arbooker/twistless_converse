/-! ## ThirtyFiveDiskExclusion -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveRootDisks
open QuantitativeArithmeticSmallLevelThirtyFiveJetCertificate

/-- Rational norm bounds at a center and a common variation estimate
exclude the entire disk from the physical modulus constraints. -/
theorem disk_exclusion (z c : ℂ) (U : ℝ)
    (hc : ‖c‖≤U) (hU : U+1/1000000000000000000<4)
    (hclose : ‖z-c‖<(1/1000000000000000000:ℝ))
    (halt : U+1/1000000000000000000<1 ∨
      ‖genericQ16 c‖+1/10000<1 ∨
      (U+1/1000000000000000000)^2+1/10000<‖genericQ16 c‖)
    (hx : 1≤‖z‖) (hy : 1≤‖genericQ16 z‖)
    (hyx : ‖genericQ16 z‖≤‖z‖^2) : False := by
  have htri : ‖z‖≤‖z-c‖+‖c‖ := by
    simpa only [sub_add_cancel] using norm_add_le (z-c) c
  have hzu : ‖z‖<U+1/1000000000000000000 := by linarith
  have hz4 : ‖z‖≤4 := (hzu.trans hU).le
  have hc4 : ‖c‖≤4 := by linarith
  have hv := q_variation z c hz4 hc4
  have hdiff : ‖genericQ16 z-genericQ16 c‖<(1/10000:ℝ) := by nlinarith
  rcases halt with hsmall | hsmall | hlarge
  · linarith
  · have ht : ‖genericQ16 z‖≤‖genericQ16 z-genericQ16 c‖+‖genericQ16 c‖ := by
      simpa only [sub_add_cancel] using
        norm_add_le (genericQ16 z-genericQ16 c) (genericQ16 c)
    linarith
  · have ht : ‖genericQ16 c‖≤‖genericQ16 z-genericQ16 c‖+‖genericQ16 z‖ := by
      calc
        ‖genericQ16 c‖ = ‖(genericQ16 c-genericQ16 z)+genericQ16 z‖ := by rw [sub_add_cancel]
        _ ≤ ‖genericQ16 c-genericQ16 z‖+‖genericQ16 z‖ := norm_add_le _ _
        _ = ‖genericQ16 z-genericQ16 c‖+‖genericQ16 z‖ := by rw [norm_sub_rev]
    have hs : ‖z‖^2≤(U+1/1000000000000000000)^2 :=
      pow_le_pow_left₀ (norm_nonneg _) hzu.le 2
    linarith

#print axioms disk_exclusion
end QuantitativeArithmeticSmallLevelThirtyFiveRootDisks
end
end

