/-- Three rows suffice at z=1 once the unit-circle C factor is nonzero.
There is no need to divide by A or to split according to P1. -/
theorem negative_z_one_rows (x y w a b : ℂ) (v : Fin 210 → ℂ)
    (hx : x≠0) (hy : y≠0) (hw : w≠0) (hw1 : w+1≠0)
    (hC : x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1≠0)
    (he : 1+x*a+x^(2:ℕ)=0)
    (hB : negativeRowsBConclusion x y 1 w a b v) : v 192=0 := by
  rcases hB with ⟨h16,h19,h21,h26,h45,h53,h104,h150,h159,h163,h164⟩
  have h1 : (y*b+x^(2:ℕ)+y^(2:ℕ)+1)*v 42=0 := by
    linear_combination (norm := (field_simp [hy]; ring))
      -(y^(2:ℕ)/2)*h150+(v 42)*he
  have hc : (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(v 84+v 42)=0 := by
    linear_combination h45+h1-((3-x^(2:ℕ))*(v 42)+v 84)*he
  have ht : v 84+v 42=0 := (mul_eq_zero.mp hc).resolve_left hC
  have ha : a= -x-1/x := by
    linear_combination (norm := (field_simp [hx]; ring)) (1/x)*he
  rw [ha] at h53
  have hprod : (w+1)*v 192=0 := by
    linear_combination (norm := (field_simp [hx,hw]; ring))
      -h53-(x^(2:ℕ)/w)*h1+
      ((2*b*x^(2:ℕ)*y-2*b*y-x^(6:ℕ)+x^(4:ℕ)-x^(2:ℕ)*y^(2:ℕ)+x^(2:ℕ)-4)/w)*ht
  exact (mul_eq_zero.mp hprod).resolve_left hw1

#print axioms negative_z_one_rows
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
