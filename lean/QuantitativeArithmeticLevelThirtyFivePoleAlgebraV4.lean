    intro h
    apply hX
    linear_combination (x+1)*h
  have hxplus : x+1≠0 := by
    intro h
    apply hX
    linear_combination (x-1)*h
  have h0 := d0_normalized_row0 x y z w a b v hx hy hw hz h84 h42 h192 ha hb hwrel hD hAr
  unfold d0Row0 at h0
  have h13 := d0_normalized_row13 x y z w a b v hx hy hw hz h84 h42 h192 ha hb hwrel hD hAr
  unfold d0Row13 at h13
  have h14 := d0_normalized_row14 x y z w a b v hx hy hw hz h84 h42 h192 ha hb hwrel hD hAr
  unfold d0Row14 at h14
  have h19 := d0_normalized_row19 x y z w a b v hx hy hw hz h84 h42 h192 ha hb hwrel hD hBr
  unfold d0Row19 at h19
  have h21 := d0_normalized_row21 x y z w a b v hx hy hw hz h84 h42 h192 ha hb hwrel hD hBr
  unfold d0Row21 at h21
  have h163 := d0_normalized_row163 x y z w a b v hx hy hw hz h84 h42 h192 ha hb hwrel hD hBr
