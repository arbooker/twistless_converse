/-! ## ThirtyFiveSimplePivot -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
open Complex QuantitativeArithmeticComplexOuterNonzero

/-- The two row pivots whose zeros control the remaining Laurent orders. -/
def shortPivotK (m : ℕ) (a b : ℂ) (s : ℂ) : ℂ :=
  a*primeParameter 2 m s-(primeParameter 3 m s)^2-b*primeParameter 3 m s

def shortPivotL (m : ℕ) (a b : ℂ) (s : ℂ) : ℂ :=
  (primeParameter 2 m s)^4+a*primeParameter 2 m s-b*primeParameter 3 m s-1

theorem primeParameter_hasDerivAt (p m : ℕ) (hp : p≠0) (s : ℂ) :
    HasDerivAt (primeParameter p m) (primeParameter p m s*Complex.log (p:ℂ)) s := by
  have h := ((hasDerivAt_id s).sub_const (m:ℂ)).const_cpow
    (c:=(p:ℂ)) (Or.inl (by exact_mod_cast hp))
  change HasDerivAt (fun z : ℂ => (p:ℂ)^(z-(m:ℂ)))
    ((p:ℂ)^(s-(m:ℂ))*Complex.log (p:ℂ)) s
  simpa only [id_eq,mul_one] using h

theorem shortPivotK_analytic (m : ℕ) (a b s : ℂ) :
    AnalyticAt ℂ (shortPivotK m a b) s :=
  ((analyticAt_const.mul (primeParameter_analytic 2 m (by decide) s)).sub
    ((primeParameter_analytic 3 m (by decide) s).pow 2)).sub
      (analyticAt_const.mul (primeParameter_analytic 3 m (by decide) s))

theorem shortPivotL_analytic (m : ℕ) (a b s : ℂ) :
    AnalyticAt ℂ (shortPivotL m a b) s :=
  ((((primeParameter_analytic 2 m (by decide) s).pow 4).add
    (analyticAt_const.mul (primeParameter_analytic 2 m (by decide) s))).sub
      (analyticAt_const.mul (primeParameter_analytic 3 m (by decide) s))).sub analyticAt_const

theorem shortPivotK_deriv (m : ℕ) (a b s : ℂ) :
    deriv (shortPivotK m a b) s=
      a*primeParameter 2 m s*Complex.log 2-2*(primeParameter 3 m s)^2*Complex.log 3-
        b*primeParameter 3 m s*Complex.log 3 := by
  have h2 := primeParameter_hasDerivAt 2 m (by decide) s
  have h3 := primeParameter_hasDerivAt 3 m (by decide) s
  have hh := (((h2.const_mul a).sub (h3.pow 2)).sub (h3.const_mul b)).deriv
  change deriv (shortPivotK m a b) s=_ at hh
  rw [hh]
  norm_num
  ring

theorem shortPivotL_deriv (m : ℕ) (a b s : ℂ) :
    deriv (shortPivotL m a b) s=
      4*(primeParameter 2 m s)^4*Complex.log 2+a*primeParameter 2 m s*Complex.log 2-
        b*primeParameter 3 m s*Complex.log 3 := by
  have h2 := primeParameter_hasDerivAt 2 m (by decide) s
  have h3 := primeParameter_hasDerivAt 3 m (by decide) s
  have hh := ((((h2.pow 4).add (h2.const_mul a)).sub (h3.const_mul b)).sub_const 1).deriv
  change deriv (shortPivotL m a b) s=_ at hh
  rw [hh]
  norm_num
  ring

/-- Elementary logarithm comparisons, with rational integer comparisons
instead of numerical approximations. -/
theorem short_pivot_log_bounds :
    0<Real.log 3-Real.log 2 ∧ 2*(Real.log 3-Real.log 2)<Real.log 3 ∧
    Real.log 3-Real.log 2<2*Real.log 3-Real.log 2 ∧
    2*Real.log 3-Real.log 2<4*Real.log 2-Real.log 3 := by
  have h23 : Real.log 2<Real.log 3 := Real.log_lt_log (by norm_num) (by norm_num)
  have h3 : 0<Real.log 3 := Real.log_pos (by norm_num)
  have h34 : Real.log 3<Real.log ((2:ℝ)^2) := Real.log_lt_log (by norm_num) (by norm_num)
  have h2732 : Real.log ((3:ℝ)^3)<Real.log ((2:ℝ)^5) :=
    Real.log_lt_log (by norm_num) (by norm_num)
  rw [Real.log_pow] at h34
  rw [Real.log_pow,Real.log_pow] at h2732
  norm_num at h34 h2732
  exact ⟨by linarith,by linarith,by linarith,by linarith⟩

theorem short_pivot_norms (m : ℕ) (s : ℂ) (hs : (m:ℝ)≤s.re) :
    1≤‖(primeParameter 2 m s)^2‖ ∧
      ‖(primeParameter 2 m s)^2‖≤‖(primeParameter 3 m s)^2‖ := by
  refine ⟨(physical_parameters m s hs).1,?_⟩
  rw [primeParameter_pow_norm 2 m 2 (by decide),primeParameter_pow_norm 3 m 2 (by decide)]
  apply Real.rpow_le_rpow (by positivity) (by norm_num) (sub_nonneg.mpr hs)

theorem shortPivotK_deriv_ne_zero (m : ℕ) (a b s : ℂ)
    (hs : (m:ℝ)≤s.re)
    (hP : 1+a*primeParameter 2 m s+(primeParameter 2 m s)^2=0)
    (hK : shortPivotK m a b s=0) : deriv (shortPivotK m a b) s≠0 := by
  have hn := short_pivot_norms m s hs
  have hl := short_pivot_log_bounds
  have he : deriv (shortPivotK m a b) s=
      ((primeParameter 2 m s)^2+1)*((Real.log 3-Real.log 2:ℝ):ℂ)-
        (primeParameter 3 m s)^2*(Real.log 3:ℂ) := by
    rw [shortPivotK_deriv]
    have h2 : Complex.log (2:ℂ)=(Real.log 2:ℂ) := by
      simpa only [Complex.ofReal_ofNat] using (Complex.ofReal_log (by norm_num : (0:ℝ)≤2)).symm
    have h3 : Complex.log (3:ℂ)=(Real.log 3:ℂ) := by
      simpa only [Complex.ofReal_ofNat] using (Complex.ofReal_log (by norm_num : (0:ℝ)≤3)).symm
    rw [h2,h3]
    unfold shortPivotK at hK
    push_cast
    linear_combination ((Real.log 2:ℂ)-(Real.log 3:ℂ))*hP+(Real.log 3:ℂ)*hK
  rw [he]
  exact linear_nonzero _ _ _ _ hn.1 hn.2 hl.1 hl.2.1

theorem shortPivotL_deriv_ne_zero (m : ℕ) (a b s : ℂ)
    (hs : (m:ℝ)≤s.re)
    (hP : 1+a*primeParameter 2 m s+(primeParameter 2 m s)^2=0)
    (hL : shortPivotL m a b s=0) : deriv (shortPivotL m a b) s≠0 := by
  have hn := short_pivot_norms m s hs
  have hl := short_pivot_log_bounds
  have he : deriv (shortPivotL m a b) s=
      ((4*Real.log 2-Real.log 3:ℝ):ℂ)*((primeParameter 2 m s)^2)^2+
        ((Real.log 3-Real.log 2:ℝ):ℂ)*(primeParameter 2 m s)^2+
        ((2*Real.log 3-Real.log 2:ℝ):ℂ) := by
    rw [shortPivotL_deriv]
    have h2 : Complex.log (2:ℂ)=(Real.log 2:ℂ) := by
      simpa only [Complex.ofReal_ofNat] using (Complex.ofReal_log (by norm_num : (0:ℝ)≤2)).symm
    have h3 : Complex.log (3:ℂ)=(Real.log 3:ℂ) := by
      simpa only [Complex.ofReal_ofNat] using (Complex.ofReal_log (by norm_num : (0:ℝ)≤3)).symm
    rw [h2,h3]
    unfold shortPivotL at hL
    push_cast
    linear_combination ((Real.log 2:ℂ)-(Real.log 3:ℂ))*hP+(Real.log 3:ℂ)*hL
  rw [he]
  exact quadratic_nonzero _ _ _ _ hn.1 hl.1 hl.2.2.1 hl.2.2.2

theorem shortPivotK_order_le_one (m : ℕ) (a b s : ℂ) (hs : (m:ℝ)≤s.re)
    (hP : 1+a*primeParameter 2 m s+(primeParameter 2 m s)^2=0) :
    analyticOrderAt (shortPivotK m a b) s≤1 := by
  have ha := shortPivotK_analytic m a b s
  by_cases hK : shortPivotK m a b s=0
  · rw [ha.analyticOrderAt_eq_one_of_zero_deriv_ne_zero hK (shortPivotK_deriv_ne_zero m a b s hs hP hK)]
  · rw [ha.analyticOrderAt_eq_zero.mpr hK]
    exact zero_le

theorem shortPivotL_order_le_one (m : ℕ) (a b s : ℂ) (hs : (m:ℝ)≤s.re)
    (hP : 1+a*primeParameter 2 m s+(primeParameter 2 m s)^2=0) :
    analyticOrderAt (shortPivotL m a b) s≤1 := by
  have ha := shortPivotL_analytic m a b s
  by_cases hL : shortPivotL m a b s=0
  · rw [ha.analyticOrderAt_eq_one_of_zero_deriv_ne_zero hL (shortPivotL_deriv_ne_zero m a b s hs hP hL)]
  · rw [ha.analyticOrderAt_eq_zero.mpr hL]
    exact zero_le

#print axioms shortPivotK_deriv_ne_zero
#print axioms shortPivotL_deriv_ne_zero
#print axioms shortPivotK_order_le_one
#print axioms shortPivotL_order_le_one
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
