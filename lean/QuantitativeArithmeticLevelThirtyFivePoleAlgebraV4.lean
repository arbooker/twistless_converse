      shortPivotL m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) t*G t 84) s := by
  have hh := analytic_signed_negative_row159 hm hf ε hε hlaw u5 u7 hu5 hu7 hphase h5 h7 BG G hG hGF s hshift
  have hc := (primeParameter_analytic 3 m (by decide) s).fun_pow 2
  apply (hh.mul_analytic hc).congr
