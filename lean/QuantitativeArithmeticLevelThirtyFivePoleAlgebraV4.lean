open QuantitativeArithmeticSmallLevelThirtyFiveGridRamanujan
open scoped Topology

/-- All sixteen reduced equations hold on a normalized actual principal vector.
The normalization retains every original analytic identity, not only this finite
selection. No hypothesis about a common numerical lower Laurent vector is used. -/
theorem original_negative_normalized_system {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (hphase : ε*I^(2*m)= -1) (h5 : badFive f= -1) (h7 : badSeven f= -1)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ) (v : Fin 210 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hr : v 192≠0) :
    let x := primeParameter 2 m s
    let y := primeParameter 3 m s
    let z := primeParameter 5 m s
    let w := primeParameter 7 m s
    let a := (Real.sqrt 2:ℂ)*f 2
    let b := (Real.sqrt 3:ℂ)*f 3
    ∃ v', IsLeadingVector G s v' ∧ v' 192=1 ∧
      negativeRowsAConclusion x y z w a b v' ∧
      negativeRowsBConclusion x y z w a b v' ∧ 1+x*a+x^(2:ℕ)=0 := by
  obtain ⟨v',hv',h192,hformula⟩ := hv.normalize (192:Fin 210) hr
  have hA := original_negative_rows_a hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v' hv' hshift
  have hB := original_negative_rows_b hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v' hv' hshift
  have hp := original_negative_row118 hm hf ε hε hlaw hphase BG G hG hGF s v' hv' hshift
  have hx := primeParameter_ne_zero 2 m (by decide) s
  refine ⟨v',hv',h192,hA,hB,?_⟩
  rw [h192,mul_one] at hp
  linear_combination (norm := (field_simp [hx]; ring)) (primeParameter 2 m s)^(2:ℕ)*hp

#print axioms original_negative_normalized_system
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
