/-! ## ThirtyFiveGenericNormalization -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
open Complex Filter Set
open QuantitativeArithmeticUniversalPoleVector
open QuantitativeArithmeticSmallLevelThirtyFiveGridAnalytic
open QuantitativeArithmeticSmallLevelThirtyFiveGridRamanujan
open scoped Topology

/-- Actual-input normalization used in the generic ideal certificate: the
84th coordinate is one, the 42nd is zero, and the 192nd is the prescribed
rational expression. Both good Hecke parameters are eliminated explicitly. -/
theorem original_negative_generic_normalization {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (hphase : ε*I^(2*m)= -1) (h5 : badFive f= -1) (h7 : badSeven f= -1)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ) (v : Fin 210 → ℂ) (hv : IsLeadingVector G s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hr : v 192≠0) (hz : primeParameter 5 m s≠1)
    (hA : (primeParameter 2 m s)^(4:ℕ)+(primeParameter 3 m s)^(2:ℕ)-1≠0) :
    let x := primeParameter 2 m s
    let y := primeParameter 3 m s
    let z := primeParameter 5 m s
    let w := primeParameter 7 m s
    let a := (Real.sqrt 2:ℂ)*f 2
    let b := (Real.sqrt 3:ℂ)*f 3
    ∃ v', v' 84=1 ∧ v' 42=0 ∧
      v' 192=(x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)/(w*(z-1)) ∧
      negativeRowsAConclusion x y z w a b v' ∧
      negativeRowsBConclusion x y z w a b v' ∧
      a= -x-1/x ∧ b=(x^(4:ℕ)-x^(2:ℕ)-2)/y ∧
      w=x^(2:ℕ)*z-x^(2:ℕ)-1 := by
  let x := primeParameter 2 m s
  let y := primeParameter 3 m s
  let z := primeParameter 5 m s
  let w := primeParameter 7 m s
  let a := (Real.sqrt 2:ℂ)*f 2
  let b := (Real.sqrt 3:ℂ)*f 3
  have hx : x≠0 := primeParameter_ne_zero 2 m (by decide) s
  have hy : y≠0 := primeParameter_ne_zero 3 m (by decide) s
  have hw : w≠0 := primeParameter_ne_zero 7 m (by decide) s
  have hz' : z-1≠0 := sub_ne_zero.mpr hz
  obtain ⟨hu,hwrel,hC,ht⟩ := original_negative_regular_branch hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v hv hshift hr hz hA
  obtain ⟨v',hv',h84,hformula⟩ := hv.normalize (84:Fin 210) ht
  have hr' : v' 192≠0 := by
    rw [hformula]
    exact div_ne_zero hr ht
  have hAr := original_negative_rows_a hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v' hv' hshift
  have hBr := original_negative_rows_b hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v' hv' hshift
  have h42 : v' 42=0 := by rw [hformula,hu,zero_div]
  obtain ⟨hp,h1,hc⟩ := original_negative_branch_parameter hm hf ε hε hlaw hphase h5 h7 BG G hG hGF s v' hv' hshift hr' hz
  change x^(4:ℕ)-x^(2:ℕ)-y*b-2=0 at hp
  change (x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)*(v' 84+v' 42)=w*(z-1)*v' 192 at hc
  rw [h42,h84,add_zero,mul_one] at hc
  have h192 : v' 192=(x^(4:ℕ)-3*x^(2:ℕ)-y^(2:ℕ)-1)/(w*(z-1)) := by
    linear_combination (norm := (field_simp [hw,hz']; ring)) -(1/(w*(z-1)))*hc
  have he0 := original_negative_row118 hm hf ε hε hlaw hphase BG G hG hGF s v' hv' hshift
  change ((1+x*a+x^(2:ℕ))/x^(2:ℕ))*v' 192=0 at he0
  have he1 : (1+x*a+x^(2:ℕ))*v' 192=0 := by
    linear_combination (norm := (field_simp [hx]; ring)) x^(2:ℕ)*he0
  have he := (mul_eq_zero.mp he1).resolve_right hr'
  refine ⟨v',h84,h42,h192,hAr,hBr,?_,?_,hwrel⟩
  · change a= -x-1/x
    linear_combination (norm := (field_simp [hx]; ring)) (1/x)*he
  · change b=(x^(4:ℕ)-x^(2:ℕ)-2)/y
    linear_combination (norm := (field_simp [hy]; ring)) -(1/y)*hp

#print axioms original_negative_generic_normalization
end QuantitativeArithmeticSmallLevelThirtyFiveKnownWords
end
