theorem negative_coordinate84_order_ge_neg_one_of_pivot {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (u5 u7 : ℂ) (hu5 : u5=1 ∨ u5= -1) (hu7 : u7=1 ∨ u7= -1)
    (hphase : ε*I^(2*m)= -u5*u7) (h5 : badFive f= -u5) (h7 : badSeven f= -u7)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : (m:ℝ)≤s.re)
    (hP : 1+((Real.sqrt 2:ℂ)*f 2)*primeParameter 2 m s+(primeParameter 2 m s)^2=0)
    (hpivot : shortPivotK m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) s≠0 ∨
      shortPivotL m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) s≠0) :
    (-1:WithTop ℤ)≤meromorphicOrderAt (fun t => G t 84) s := by
  have hrow := analytic_L_coordinate_row hm hf ε hε hlaw u5 u7 hu5 hu7 hphase h5 h7 BG G hG hGF s hshift
  have ha := shortPivotA_analytic m ((Real.sqrt 2:ℂ)*f 2) s
  have hL := shortPivotL_analytic m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) s
  rcases hpivot with hK0|hL0
  · have hK := shortPivotK_analytic m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) s
    have hKrow := analytic_K_times_coordinate42 hm hf ε hε hlaw u5 u7 hu5 hu7 hphase h5 h7 BG G hG hGF s hshift
    have h42 : 0≤meromorphicOrderAt (fun t => G t 42) s := by
      have h := order_lower_of_analytic_factor 0 0 hK (hG 42 s).meromorphicAt
        (by rw [hK.analyticOrderAt_eq_zero.mpr hK0]; exact zero_le) hKrow.order_nonneg
      simpa using h
    have hprod := two_row_order_lower ha (hG 42 s).meromorphicAt hrow le_rfl h42
    have h := order_lower_of_analytic_factor 0 1 hL (hG 84 s).meromorphicAt
      (shortPivotL_order_le_one m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) s hs hP) hprod
    simpa using h
  · have h42 := negative_coordinate42_order_ge_neg_one hm hf ε hε hlaw u5 u7 hu5 hu7 hphase h5 h7 BG G hG hGF s hshift hs hP
    have hb0 : (-1:WithTop ℤ)≤0 := by
      change ((-1:ℤ):WithTop ℤ)≤((0:ℤ):WithTop ℤ)
      exact WithTop.coe_le_coe.mpr (by omega)
    have hprod := two_row_order_lower ha (hG 42 s).meromorphicAt hrow hb0 h42
    have h := order_lower_of_analytic_factor (-1) 0 hL (hG 84 s).meromorphicAt
      (by rw [hL.analyticOrderAt_eq_zero.mpr hL0]; exact zero_le) hprod
    simpa using h

theorem negative_coordinate84_double_pole_candidate {m : ℕ} (hm : 0<m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 35 (2*m) f) (ε : ℂ)
    (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 35 (2*m) f ε)
    (u5 u7 : ℂ) (hu5 : u5=1 ∨ u5= -1) (hu7 : u7=1 ∨ u7= -1)
    (hphase : ε*I^(2*m)= -u5*u7) (h5 : badFive f= -u5) (h7 : badSeven f= -u7)
    (BG : ℝ) (G : ℂ → Fin 210 → ℂ)
    (hG : ∀ i z, MeromorphicNFAt (fun s => G s i) z)
    (hGF : ∀ z, BG<z.re → G z=gridVector (2*m) f z)
    (s : ℂ)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤meromorphicOrderAt (fun z => G z j) (s+n))
    (hs : (m:ℝ)≤s.re)
    (hP : 1+((Real.sqrt 2:ℂ)*f 2)*primeParameter 2 m s+(primeParameter 2 m s)^2=0)
    (hpole : meromorphicOrderAt (fun t => G t 84) s<(-1:WithTop ℤ)) :
    shortPivotK m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) s=0 ∧
      shortPivotL m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) s=0 := by
  by_contra h
  push Not at h
  have hne : shortPivotK m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) s≠0 ∨
      shortPivotL m ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) s≠0 := by tauto
  exact (not_le_of_gt hpole) (negative_coordinate84_order_ge_neg_one_of_pivot hm hf ε hε hlaw u5 u7 hu5 hu7 hphase h5 h7 BG G hG hGF s hshift hs hP hne)

