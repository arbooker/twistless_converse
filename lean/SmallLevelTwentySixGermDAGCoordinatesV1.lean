theorem baseCoordinate_support : ∀ j : Fin 320,
    baseCoordinate (support j)<320 ∧ decodeBase (baseCoordinate (support j))=support j := by
  decide +kernel

def encodeIndex (n b : ℕ) : ℕ := if b<2 then 2*n+b else 6+318*n+(b-2)
def decodeLayer (i : ℕ) : ℕ := if i<6 then i/2 else (i-6)/318
def decodeIndex (i : ℕ) : ℕ := if i<6 then i%2 else 2+(i-6)%318

theorem decode_encode (n b : ℕ) (hn : n<3) (hb : b<320) :
    decodeLayer (encodeIndex n b)=n ∧ decodeIndex (encodeIndex n b)=b := by
  simp only [encodeIndex,decodeLayer,decodeIndex]
  split_ifs <;> omega

def encodedVector (v : ℕ→Fin 780→ℂ) (i : ℕ) : ℂ :=
  v (decodeLayer i) (decodeBase (decodeIndex i))

theorem encodedVector_support (v : ℕ→Fin 780→ℂ) (n : ℕ) (hn : n<3) (j : Fin 320) :
    encodedVector v (sourceCoordinate n (support j))=v n (support j) := by
  have hb := baseCoordinate_support j
  have hd := decode_encode n (baseCoordinate (support j)) hn hb.1
  change v (decodeLayer (encodeIndex n (baseCoordinate (support j))))
    (decodeBase (decodeIndex (encodeIndex n (baseCoordinate (support j)))))=_
  rw [hd.1,hd.2,hb.2]

#print axioms baseCoordinate_support
#print axioms decode_encode
#print axioms encodedVector_support
end SmallLevelTwentySixGermDAG
