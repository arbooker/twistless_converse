/- Generate ordinary interpretation theorems from a single proof template.
The polynomial data, original expressions and theorem names remain explicit. -/
elab "certify_laurent_interpretations " dataPrefix:ident originalPrefix:ident
    proofPrefix:ident " count " rowCount:num " dimension " vectorSize:num : command => do
  for i in [:rowCount.getNat] do
    let dataName := s!"{dataPrefix.getId.toString}{i}"
    let originalName := s!"{originalPrefix.getId.toString}{i}"
    let proofName := s!"{proofPrefix.getId.toString}{i}"
    let declaration := s!"theorem {proofName} (X Y Z W a b : ℂ) (hX : X≠0) (hY : Y≠0) (hZ : Z≠0) (hW : W≠0) (v : Fin {vectorSize.getNat} → ℂ) :
    eval X Y Z W a b 1 (QuantitativeArithmeticRationalRows.extend v) {dataName} = {originalName} X Y Z W a b v := by
  norm_num [{originalName}, {dataName}, eval, monomial, QuantitativeArithmeticRationalRows.extend,
    zpow_neg, div_eq_mul_inv, mul_inv_rev, ← inv_pow]
  all_goals
    first
    | solve | ring_nf <;> simp
    | solve | field_simp [hX,hY,hZ,hW] <;> ring_nf <;> simp"
    for source in [declaration, s!"#print axioms {proofName}"] do
      match Parser.runParserCategory (← getEnv) `command source with
      | .error message => throwError "Laurent interpretation certificate: {message}"
      | .ok declaration =>
        withScope (fun scope => { scope with opts := scope.opts.setBool `Elab.async false }) <|
          withEnableInfoTree false <| elabCommand declaration

end

