noncomputable def mulShort (p q : Poly) : Poly :=
  if p.length <= q.length then spmul p q else spmul q p
theorem eval_mulShort (v : ℕ→ℂ) (p q : Poly) :
    eval v (mulShort p q)=eval v p*eval v q := by
  unfold mulShort
  split <;> simp only [eval_mul, mul_comm]
