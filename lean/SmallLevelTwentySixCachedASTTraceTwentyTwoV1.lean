compact_certificate_declaration theorem coefficient_0 (y z w a b u : ℂ) :
    (certificate y z w a b u)[0]?=some 0 := by
  change some (((((c0_0 y z w a b u)*(c1_0 y z w a b u))+0)+(((c2_0 y z w a b u)*(c3_0 y z w a b u))+0))+(-1*(c4_0 y z w a b u)))=some (0:ℂ)
  apply congrArg some
  have h := eval_of_checkZero (vars y z w a b u) e0 checked_0
  simp only [e0, eval_add, eval_mul, eval_scale, eval_pow, product_0_value, product_1_value, product_2_value, n_c0_0_value y z w a b u, n_c1_0_value y z w a b u, n_c2_0_value y z w a b u, n_c3_0_value y z w a b u, n_c4_0_value y z w a b u] at h
