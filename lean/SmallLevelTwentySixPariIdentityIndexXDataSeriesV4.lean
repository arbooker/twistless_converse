    (multiply (coefficients2 y z w a b u) (coefficients3 y z w a b u)))
    (add (scale (-1) (coefficients4 y z w a b u))
      (scale (-1) (multiply (coefficients5 y z w a b u) (coefficients6 y z w a b u))))

theorem certificate_length (y z w a b u : ℂ) : (certificate y z w a b u).length=165 := by
  simp only [certificate,length_add,length_multiply,length_scale]
  norm_num [coefficients0,coefficients1,coefficients2,coefficients3,coefficients4,coefficients5,coefficients6]

