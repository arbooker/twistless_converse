/-! ## SmallLevelThirtyFourUnitMMMContinuationV1 -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 5000000
set_option maxRecDepth 8192
@[expose] public noncomputable section
namespace SmallLevelThirtyFourUnitMMM
open Complex Matrix SmallLevelThirtyFourGrid SmallLevelPrimeRates SmallLevelFiniteGridSupport

def actualGrid (m : ℕ) (f : ℕ→ℂ) (s : ℂ) : Fin 414→ℂ :=
  fun i => gridVector (2*m) f s (supportIndex i)

def leadingMatrix (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) : Matrix (Fin 546) (Fin 414) ℂ :=
  restrictedLeadingMatrix selectedSource supportIndex m f ε s

compact_elimination_proof theorem leadingMatrix_actual (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ)
    (hη : ε*I^(2*m)= -1)
    (h2 : (Real.sqrt 2:ℂ)*f 2= -1) (h17 : (Real.sqrt 17:ℂ)*f 17= -1)
    (v : Fin 510→ℂ) (i : Fin 546) :
    (leadingMatrix m f ε s *ᵥ (fun j => v (supportIndex j))) i=
      gridLeadingRows m f ε s v (selectedSource i) := by
  rw [leadingMatrix,restrictedLeadingMatrix_mulVec]
  have h:=congrFun (sourceRows_restrict (parameter 2 m s) (parameter 3 m s)
    (parameter 17 m s) (parameter 5 m s) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 5:ℂ)*f 5) v) i
  rw [original_leading_binding m f ε s _ hη h2 h17 i,
    original_leading_binding m f ε s v hη h2 h17 i] at h
  exact h

compact_elimination_proof theorem leadingMatrix_kernel_exists (m : ℕ) (f : ℕ→ℂ) (ε : ℂ)
    (hη : ε*I^(2*m)= -1)
    (h2 : (Real.sqrt 2:ℂ)*f 2= -1) (h17 : (Real.sqrt 17:ℂ)*f 17= -1) :
    ∃ s : ℂ,∀ v : Fin 414→ℂ,leadingMatrix m f ε s *ᵥ v=0 → v=0 := by
  obtain ⟨s,hs⟩:=SmallLevelThirtyFourContinuationMinorMMM.minor_nonzero_on_curve
    ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 5:ℂ)*f 5) m
  refine ⟨s,?_⟩
  apply matrix_kernel_of_support supportIndex support_injective
    (selectedLeadingLinearMap selectedSource m f ε s)
  intro v hv
  apply source_kernel_zero (parameter 2 m s) (parameter 3 m s)
    (parameter 17 m s) (parameter 5 m s) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 5:ℂ)*f 5)
    (parameter_ne_zero 2 m (by decide) s) (parameter_ne_zero 3 m (by decide) s)
    (parameter_ne_zero 17 m (by decide) s) (parameter_ne_zero 5 m (by decide) s) v _ hs
  intro i
  rw [original_leading_binding m f ε s v hη h2 h17 i]
  exact congrFun hv i

compact_elimination_proof
/-- Meromorphic continuation on the actual414-coordinate closed support in the
MMM sign case. The eigenvalues at3 and5 are arbitrary, including zero.
This does not assert pole removal or the full level34 theorem. -/
theorem original_grid_continuation_of_mmm (m : ℕ) (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 34 (2*m) f)
    {ε : ℂ} (hε : ε=1 ∨ ε= -1) (hlaw : GridFrickeLaws (2*m) f ε)
    (hη : ε*I^(2*m)= -1)
    (h2 : (Real.sqrt 2:ℂ)*f 2= -1) (h17 : (Real.sqrt 17:ℂ)*f 17= -1) :
    ∃ B : ℝ,∃ G : ℂ→Fin 414→ℂ,
      (∀ i x,MeromorphicNFAt (fun z => G z i) x) ∧
      ∀ z,B<z.re → G z=actualGrid m f z := by
  obtain ⟨B,E,hF,hE,hrow⟩:=initial_system_of_laws m hm hf hε hlaw
  refine ⟨B,?_⟩
  apply QuantitativeArithmeticRectangularContinuation.meromorphic_continuation
    B (actualGrid m f) (leadingMatrix m f ε)
    (restrictedShiftMatrix selectedSource supportIndex m f ε)
    (fun n s i => E (selectedSource i) n s)
    (fun i z hz => hF (supportIndex i) z hz)
    (fun x i j => restrictedLeadingMatrix_analytic selectedSource supportIndex m f ε i j x)
    (leadingMatrix_kernel_exists m f ε hη h2 h17)
    (fun n x i j => restrictedShiftMatrix_analytic selectedSource supportIndex m f ε n i j x)
    (fun n i z hz => (hE n (selectedSource i) z hz).meromorphicAt)
  intro n s hs
  funext i
  simp only [Pi.add_apply,Finset.sum_apply]
  change (leadingMatrix m f ε s *ᵥ (fun j => gridVector (2*m) f s (supportIndex j))) i =
    E (selectedSource i) n s + ∑ c ∈ Finset.range n,
      (restrictedShiftMatrix selectedSource supportIndex m f ε c s *ᵥ
        (fun j => gridVector (2*m) f (s+((c:ℂ)+1)) (supportIndex j))) i
  rw [leadingMatrix_actual m f ε s hη h2 h17]
  simp_rw [restrictedShiftMatrix_mulVec,shiftRows_restrict]
  exact hrow n s hs (selectedSource i)

#print axioms leadingMatrix_actual
#print axioms leadingMatrix_kernel_exists
#print axioms original_grid_continuation_of_mmm
end SmallLevelThirtyFourUnitMMM
end
end

