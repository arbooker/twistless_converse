compact_elimination_proof theorem free_zero (X Y Z W a b : ℂ) (hX : X≠0) (hY : Y≠0) (hZ : Z≠0) (hW : W≠0)
    (v : Fin 510→ℂ) (hv : ∀ i,sourceRows X Y Z W a b v i=0)
    (hm : minor X Y Z W a b≠0) : v 370=0 ∧ v 390=0 ∧ v 435=0 := by
  have hd : (residualMatrix X Y Z W a b).det≠0 := by
    intro h
    apply hm
    rw [minor_determinant X Y Z W a b hX hY hZ hW,h,mul_zero]
  have hl : residualMatrix X Y Z W a b *ᵥ ![v 370,v 390,v 435]=0 := by
    ext i
    fin_cases i
    · convert residual_0 X Y Z W a b hX hY hZ hW v hv using 1 <;>
        norm_num [residualMatrix,Matrix.mulVec,dotProduct,Fin.sum_univ_succ] <;> ring
    · convert residual_2 X Y Z W a b hX hY hZ hW v hv using 1 <;>
        norm_num [residualMatrix,Matrix.mulVec,dotProduct,Fin.sum_univ_succ] <;> ring
    · convert residual_3 X Y Z W a b hX hY hZ hW v hv using 1 <;>
        norm_num [residualMatrix,Matrix.mulVec,dotProduct,Fin.sum_univ_succ] <;> ring
  have hu : IsUnit (residualMatrix X Y Z W a b) :=
    (Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hd)
  have hz : (![v 370,v 390,v 435]:Fin 3→ℂ)=0 :=
    (Matrix.mulVec_injective_of_isUnit hu) (by simpa using hl)
  exact ⟨by simpa using congrFun hz 0,by simpa using congrFun hz 1,by simpa using congrFun hz 2⟩

