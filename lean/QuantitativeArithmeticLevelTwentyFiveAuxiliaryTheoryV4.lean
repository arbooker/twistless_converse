    factor3 ((2:ℂ)^n) ((3:ℂ)^n) a b =
      ∑ i : Fin 5, factorCoefficients3 a b i * (factorBases3 i:ℂ)^n := by
  have hb (u v : ℕ) : (((2^u*3^v:ℕ):ℂ))^n=((2:ℂ)^n)^u*((3:ℂ)^n)^v := by
