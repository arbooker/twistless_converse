/-! ## TwentyFiveContinuationPositivePhysicalWitness -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.ContinuationPositive

compact_certificate theorem parameter_ne_zero {p : ℕ} (hp : p≠0) (m : ℕ) (s : ℂ) :
    parameter p m s≠0 := by
  exact Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))

/- A nonsingular point on the actual exponential parameter curve for the
positive-sign generic 150-row system. This is the algebraic witness; linking
the rows to the original additive twists is a separate theorem. -/
compact_certificate theorem source_rows_witness (m : ℕ) (a b : ℂ) (ha : a≠0) :
    ∃ s : ℂ, ∀ w : Fin 150 → ℂ,
      (∀ i, sourceRows (parameter 2 m s) (parameter 3 m s)
        (parameter 5 m s) a b w i=0) → w=0 := by
  obtain ⟨s,hs⟩ := common_factor_witness m a b ha
  refine ⟨s,fun w hw => ?_⟩
  apply source_rows_kernel (parameter 2 m s) (parameter 3 m s)
    (parameter 5 m s) a b
    (parameter_ne_zero (by decide) m s)
    (parameter_ne_zero (by decide) m s)
    (parameter_ne_zero (by decide) m s) ha
    ?_ ?_ ?_ ?_ w hw
  · exact hs 0
  · exact hs 1
  · exact hs 2
  · exact hs 3

#print axioms parameter_ne_zero
#print axioms source_rows_witness
end QuantitativeArithmeticSmallLevelTwentyFive.ContinuationPositive
