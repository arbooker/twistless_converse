  have h1 : (2:ℂ)^n=((2:ℂ)^n)^1*((3:ℂ)^n)^0 := by
    convert hb 1 0 using 1
  have h2 : (4:ℂ)^n=((2:ℂ)^n)^2*((3:ℂ)^n)^0 := by
    convert hb 2 0 using 1
  simp only [Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  change factor2 ((2:ℂ)^n) ((3:ℂ)^n) a b = (2:ℂ)*((1:ℕ):ℂ)^n + (a*(2:ℂ)^n + ((1:ℂ)*(4:ℂ)^n))
  rw [Nat.cast_one,h0,h1,h2]
  unfold factor2
  ring
compact_certificate theorem factor2_finite_witness (a b : ℂ) (ha : a≠0) :
    ∃ n : ℕ, factor2 ((2:ℂ)^n) ((3:ℂ)^n) a b≠0 := by
