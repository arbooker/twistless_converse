open QuantitativeArithmeticUniversalPoleVector
open scoped Topology

/- Factored first-shift syzygies for the regularized auxiliary quotient.
The factor may vanish at the pole; it is absorbed into the grid. -/
compact_certificate theorem selected_factored_first_shift {ι : Type*} [Fintype ι] [Nonempty ι]
    (basis : ℕ → Poly) (free : Fin 68 → Fin 1050)
    (hperiodic : ∀ j, basis (j%1050)=basis j)
    (rows : ι → Row) (χ : ℚ) (p q : ι → Poly)
    (hp : ∀ i, normalizedPoly (rawSourcePoly χ (.physical (rows i)))=p i)
    (hq : ∀ i, normalizedPoly (rawTailPoly (.physical (rows i)))=q i)
    (hpzero : ∀ i, substitute basis (p i)=[]) (hqzero : ∀ i, substitute basis (q i)=[])
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=(χ:ℂ)) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis free m f z (gridVector 1050 (2*m) f z))
    (x : ℂ) (v : Fin 1050 → ℂ) (hv : IsLeadingVector (fun z j => (z-((2*m:ℕ):ℂ))*G z j) x v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (x+n))
    (K : ℂ → ι → ℂ)
    (hK : ∀ z i, AnalyticAt ℂ (fun w => K w i) z)
    (hKA : ∀ z (w : Fin 1050 → ℂ), ∑ i, K z i*leading (rows i) m f ε z w=0)
    (D : ℂ → Fin 1050 → ℂ) (hD : ∀ j, AnalyticAt ℂ (fun z => D z j) x)
    (hfactor : ∀ z (w : Fin 1050 → ℂ),
      (∑ i, K (z-1) i*shifted (rows i) m f ε 0 (z-1) w)=
      (z-((2*m:ℕ):ℂ))*(∑ j, D z j*w j)) :
    ∑ j, D x j*v j=0 := by
  classical
  obtain ⟨B,H,hH,hrow⟩ := selected_physical_germs basis free hperiodic rows χ p q
    hp hq hpzero hqzero hm hf ε hε hlaw hχ BG G (fun i z => (hG i z).meromorphicAt) hGF
  let frees : Empty → Fin 1050 := Empty.elim
  let sources : ι → SourceRow := fun i => .physical (rows i)
  let A : ℂ → Matrix ι (Fin 1050) ℂ := fun z i => augmentedMatrix sources frees m f ε z (Sum.inl i)
  let C : ℕ → ℂ → Matrix ι (Fin 1050) ℂ := fun n z i =>
    augmentedShiftMatrix (κ := Empty) sources m f ε n z (Sum.inl i)
  let L : ℂ → Matrix Unit ι ℂ := fun z _ i => K z i
  have ha (z : ℂ) (w : Fin 1050 → ℂ) (i : ι) :
      (∑ j, A z i j*w j)=leading (rows i) m f ε z w := by
    exact congrFun (augmentedMatrix_mulVec sources frees m f ε z w) (Sum.inl i)
  have hc (n : ℕ) (z : ℂ) (w : Fin 1050 → ℂ) (i : ι) :
      (∑ j, C n z i j*w j)=shifted (rows i) m f ε n z w := by
    exact congrFun (augmentedShiftMatrix_mulVec (κ := Empty) sources m f ε n z w) (Sum.inl i)
  have hLA (z : ℂ) : L z*A z=0 := by
    ext r j
    have hh := hKA z (Pi.single j 1)
    simp_rw [← ha z (Pi.single j 1)] at hh
    simpa [Matrix.mul_apply,L,Pi.single_apply] using hh
  have hfactors (z : ℂ) (r : Unit) (j : Fin 1050) :
      (L (z-1)*C 0 (z-1)) r j=(z-((2*m:ℕ):ℂ))*D z j := by
    have hh := hfactor z (Pi.single j 1)
    simp_rw [← hc] at hh
    simpa [Matrix.mul_apply,L,Pi.single_apply] using hh
  have h := IsLeadingVector.factored_first_shift B G A C H L hG
    (fun n z i j => augmentedShiftMatrix_analytic (κ := Empty) sources m f ε n z (Sum.inl i) j)
    hH (fun z _ i => hK z i) hLA (by
      intro n i z hz
      simpa only [ha,hc] using hrow n i z hz) x hshift
    (fun z => z-((2*m:ℕ):ℂ)) (fun z (_ : Unit) j => D z j)
    (fun _ j => hD j) hfactors v hv
  exact congrFun h ()

#print axioms selected_factored_first_shift
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveAuxMinusBlockKernel -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.AuxMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- Vanishing of earlier projections and old coordinates at the current
point forces the current auxiliary projection to vanish. -/
compact_certificate theorem point_zero_of_prior_old_zero
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis freeCoordinate m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (d : ℕ) (v : Fin (d+1) × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid d G) s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (n : Fin (d+1)) (hprior : ∀ a : Fin (d+1), a.val<n.val → (fun j => v (a,j))=0)
    (hold : ∀ j : Fin 150, v (n,⟨7*j.val,by omega⟩)=0) :
    (fun j => v (n,j))=0 := by
  have hgauge := continued_free_zero basis freeCoordinate (fun j => basis_free_coordinate j)
    m f BG G hG hGF
  have hfree := stack_free_zero freeCoordinate G hgauge d s v hv
  apply actual_augmented_kernel hf ε (s-n.val) hχ (fun j => v (n,j)) _ (hfree n)
  intro i
  cases hr : actual i.val with
  | old j => simpa only [hr,sourceLeading] using hold j
  | physical r =>
    have hp := all_actual_source i
    have hq := all_actual_tail i
    rw [hr] at hp hq
    have h := physical_block_rows basis freeCoordinate basis_periodic r (-1)
      (source i.val) (tail i.val) hp hq (all_source_zero i) (all_tail_zero i)
      hm hf ε hε hlaw (by simpa using hχ) BG G hG hGF s d v hv hshift
    have hz : leading r m f ε (s-n.val) (fun j => v (n,j))=0 := by
      rw [h n]
      apply Finset.sum_eq_zero
      intro a ha
      have ha' := Finset.mem_range.mp ha
      rw [hprior (lowerIndex n a) (by simp only [lowerIndex]; omega)]
      simpa only [zero_smul,zero_mul] using shifted_smul r m f ε a (s-n.val) 0 (0 : Fin 1050 → ℂ)
    simpa only [hr,sourceLeading] using hz

#print axioms point_zero_of_prior_old_zero
end QuantitativeArithmeticSmallLevelTwentyFive.AuxMinusLaurent
end
end

