namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticRegularizedJetScale (weightOneChooseQuot weightOneChoose_factor)

/- Taylor row without the common scalar; linear in the grid values. -/
compact_certificate def higherJetEval (m : ℕ) (f : ℕ → ℂ) (χ : ℚ) (r : SourceRow)
    (n : ℕ) (z : ℂ) (v : Fin 1050 → ℂ) : ℂ :=
  eval (primeParameter 2 m z) (primeParameter 3 m z)
    (primeParameter 5 m z) (primeParameter 7 m z)
    ((Real.sqrt 2:ℂ)*f 2) ((Real.sqrt 3:ℂ)*f 3) ((Real.sqrt 7:ℂ)*f 7)
    (periodicVector v) (rawHigherJetPoly χ n r)

compact_certificate theorem higherJetEval_finite (m : ℕ) (f : ℕ → ℂ) (χ : ℚ) (r : SourceRow)
    (n : ℕ) (z : ℂ) (v : Fin 1050 → ℂ) :
    higherJetEval m f χ r n z v=
      ∑ j, higherJetEval m f χ r n z (Pi.single j 1)*v j := by
  exact eval_finite_coordinates (fun j => ⟨j%1050,Nat.mod_lt _ (by decide)⟩)
    _ _ _ _ _ _ _ v (rawHigherJetPoly χ n r)

compact_certificate theorem higherJetEval_analytic (m : ℕ) (f : ℕ → ℂ) (χ : ℚ) (r : SourceRow)
    (n : ℕ) (s : ℂ) (v : Fin 1050 → ℂ) :
    AnalyticAt ℂ (fun z => higherJetEval m f χ r n z v) s := by
  have hp (p : ℕ) (hp : p≠0) : AnalyticAt ℂ (fun z => primeParameter p m z) s := by
    unfold primeParameter
    simp_rw [Complex.cpow_def_of_ne_zero (by exact_mod_cast hp : (p:ℂ)≠0)]
    fun_prop
  have hn (p : ℕ) (hp : p≠0) : primeParameter p m s≠0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by exact_mod_cast hp))
  exact eval_analytic _ _ _ _ _ _ _ _ _ (rawHigherJetPoly χ n r)
    (hp 2 (by decide)) (hp 3 (by decide)) (hp 5 (by decide)) (hp 7 (by decide))
    (hn 2 (by decide)) (hn 3 (by decide)) (hn 5 (by decide)) (hn 7 (by decide))
    (fun _ => analyticAt_const)

/- The weight-two top Taylor coefficient after removing z-2. -/
compact_certificate def regularizedTaylor (f : ℕ → ℂ) (χ : ℚ) (r : SourceRow)
    (n : Fin 4) (z : ℂ) (v : Fin 1050 → ℂ) : ℂ :=
  (Complex.I^n.val*weightOneChooseQuot n z)*higherJetEval 1 f χ r n.val (z-n.val) v

compact_certificate theorem regularizedTaylor_analytic (f : ℕ → ℂ) (χ : ℚ) (r : SourceRow)
    (n : Fin 4) (s : ℂ) (v : Fin 1050 → ℂ) :
    AnalyticAt ℂ (fun z => regularizedTaylor f χ r n z v) s := by
  have hq : AnalyticAt ℂ (fun z => weightOneChooseQuot n z) s := by
    fin_cases n
    · exact analyticAt_const
    · exact analyticAt_const
    · exact (analyticAt_id.sub analyticAt_const).div_const
    · exact ((analyticAt_id.sub analyticAt_const).mul
        (analyticAt_id.sub analyticAt_const)).div_const
  exact (analyticAt_const.mul hq).mul
    ((higherJetEval_analytic 1 f χ r n.val (s-n.val) v).comp
      (f:=fun z : ℂ => z-(n.val:ℂ)) (analyticAt_id.sub analyticAt_const))

compact_certificate theorem regularizedTaylor_finite (f : ℕ → ℂ) (χ : ℚ) (r : SourceRow)
    (n : Fin 4) (z : ℂ) (v : Fin 1050 → ℂ) :
    regularizedTaylor f χ r n z v=
      ∑ j, regularizedTaylor f χ r n z (Pi.single j 1)*v j := by
  simp only [regularizedTaylor,mul_assoc,← Finset.mul_sum]
  rw [← higherJetEval_finite]

compact_certificate theorem regularizedTaylor_factor (f : ℕ → ℂ) (ε : ℂ) (χ : ℚ)
    (hχ : ε*Complex.I^(2*1)=(χ:ℂ)) (r : SourceRow) (n : Fin 4) (hn : n≠0)
    (z : ℂ) (v : Fin 1050 → ℂ) :
    sourceShifted r 1 f ε (n.val-1) (z-n.val) v=
      (z-2)*regularizedTaylor f χ r n z v := by
  have hnpos : 0<n.val := Fin.pos_iff_ne_zero.mpr hn
  have hnv : n.val-1+1=n.val := by omega
  rw [eval_rawHigherJetPoly r 1 f ε (z-n.val) χ hχ,hnv]
  have he : z-(n.val:ℂ)+(n.val:ℂ)-((2*1:ℕ):ℂ)=z-2 := by norm_num
  rw [he,weightOneChoose_factor n hn]
  change _=(z-2)*((Complex.I^n.val*weightOneChooseQuot n z)*
    higherJetEval 1 f χ r n.val (z-n.val) v)
  dsimp only [higherJetEval]
  ring

#print axioms higherJetEval_analytic
#print axioms regularizedTaylor_factor
#print axioms regularizedTaylor_analytic
#print axioms regularizedTaylor_finite
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveAuxRegularizedBlockPole -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex Matrix Filter Set QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift
open scoped Topology

/- Actual original rows acting on the weight-two regularized four-point stack. -/
compact_certificate theorem physical_regularized_block_rows (basis : ℕ → Poly) (free : Fin 68 → Fin 1050)
    (hperiodic : ∀ j, basis (j%1050)=basis j)
    (r : Row) (χ : ℚ) (p q : Poly)
    (hp : normalizedPoly (rawSourcePoly χ (.physical r))=p)
    (hq : normalizedPoly (rawTailPoly (.physical r))=q)
    (hpzero : substitute basis p=[]) (hqzero : substitute basis q=[])
    {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*1) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*1) f ε)
    (hχ : ε*Complex.I^(2*1)=(χ:ℂ)) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis free 1 f z (gridVector 1050 (2*1) f z))
    (v : Fin 4 × Fin 1050 → ℂ)
    (hv : IsLeadingVector (regularizedStack 3 G 2) 2 v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (2+n)) :
    ∀ n : Fin 4, leading r 1 f ε (2-n.val) (fun j => v (n,j))=
      if n=0 then 0 else
        regularizedTaylor f χ (.physical r) n 2 (fun j => v (0,j))+
          ∑ a∈Finset.range (n.val-1), shifted r 1 f ε a (2-n.val)
            (fun j => v (lowerIndex n a,j)) := by
  obtain ⟨B,H,hH,hrow⟩ := physical_row_continues basis free hperiodic r χ p q
    hp hq hpzero hqzero (by decide : 0<1) hf ε hε hlaw hχ BG G (fun j z => (hG j z).meromorphicAt) hGF
  let rows : Unit → SourceRow := fun _ => .physical r
  let frees : Empty → Fin 1050 := Empty.elim
  let A : ℂ → Matrix Unit (Fin 1050) ℂ := fun z _ => augmentedMatrix rows frees 1 f ε z (Sum.inl ())
  let C : ℕ → ℂ → Matrix Unit (Fin 1050) ℂ := fun n z _ =>
    augmentedShiftMatrix (κ := Empty) rows 1 f ε n z (Sum.inl ())
  have ha (z : ℂ) (w : Fin 1050 → ℂ) : (∑ j, A z () j*w j)=leading r 1 f ε z w :=
    congrFun (augmentedMatrix_mulVec rows frees 1 f ε z w) (Sum.inl ())
  have hc (n : ℕ) (z : ℂ) (w : Fin 1050 → ℂ) : (∑ j, C n z () j*w j)=shifted r 1 f ε n z w :=
    congrFun (augmentedShiftMatrix_mulVec (κ := Empty) rows 1 f ε n z w) (Sum.inl ())
  let Q : Fin 4 → ℂ → Matrix Unit (Fin 1050) ℂ := fun n z _ j =>
    regularizedTaylor f χ (.physical r) n z (Pi.single j 1)
  have hqsum (n : Fin 4) (z : ℂ) (w : Fin 1050 → ℂ) :
      (∑ j, Q n z () j*w j)=regularizedTaylor f χ (.physical r) n z w :=
    (regularizedTaylor_finite f χ (.physical r) n z w).symm
  have hfactor (n : Fin 4) (hn : n≠0) (z : ℂ) (i : Unit) (j : Fin 1050) :
      C (n.val-1) (z-n.val) i j=(z-2)*Q n z i j := by
    change sourceShifted (.physical r) 1 f ε (n.val-1) (z-n.val) (Pi.single j 1)=_
    exact regularizedTaylor_factor f ε χ hχ (.physical r) n hn z (Pi.single j 1)
  have hh := IsLeadingVector.regularized_block_rows B G A C (fun n z _ => H n z) 2 3 Q
    hG (fun z _ j => augmentedMatrix_analytic rows frees 1 f ε z (Sum.inl ()) j)
    (fun n z _ j => augmentedShiftMatrix_analytic (κ := Empty) rows 1 f ε n z (Sum.inl ()) j)
    (fun n _ j => regularizedTaylor_analytic f χ (.physical r) n 2 (Pi.single j 1))
    hfactor (fun n _ z hz => hH n z hz) hshift (by
      intro n i z hz
      cases i
      simpa only [ha,hc] using hrow n z hz) v hv
  intro n
  have h := hh (n,())
  rw [regularizedBlock_apply] at h
  by_cases hn : n=0
  · subst n
    simpa [ha] using h
  · simp only [ite_eq_right hn,ha,hc,hqsum] at h ⊢
    linear_combination h

#print axioms physical_regularized_block_rows
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveAuxRegularizedGaugePole -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex Filter Set QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift
open scoped Topology

/- Every principal vector of a finite stack retains all the gauge zeros. -/
compact_certificate theorem regularized_stack_free_zero (free : Fin 68 → Fin 1050) (G : ℂ → Fin 1050 → ℂ)
    (hfree : ∀ z j, G z (free j)=0) (d : ℕ) (s : ℂ)
    (v : Fin (d+1) × Fin 1050 → ℂ) (hv : IsLeadingVector (regularizedStack d G s) s v) :
    ∀ n j, v (n,free j)=0 := by
  classical
  intro n j
  have h := hv.2 (fun _ b => if b=(n,free j) then 1 else 0) (fun _ => 0)
    (fun _ => analyticAt_const) analyticAt_const (by
      filter_upwards [] with z
      simp only [ite_mul,one_mul,zero_mul,Finset.sum_ite_eq',Finset.mem_univ,ite_true]
      simp [regularizedStack,hfree])
  simpa using h

#print axioms regularized_stack_free_zero
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveAuxMinusRegularizedKernel -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.AuxMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- Vanishing of earlier projections and old coordinates at the current
point forces the current auxiliary projection to vanish. -/
compact_certificate theorem regularized_point_zero_of_prior_old_zero
    {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*1) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*1) f ε)
    (hχ : ε*Complex.I^(2*1)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis freeCoordinate 1 f z
      (gridVector 1050 (2*1) f z))
    (v : Fin 4 × Fin 1050 → ℂ) (hv : IsLeadingVector (regularizedStack 3 G 2) 2 v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (2+n))
    (n : Fin 4) (hprior : ∀ a : Fin 4, a.val<n.val → (fun j => v (a,j))=0)
    (hold : ∀ j : Fin 150, v (n,⟨7*j.val,by omega⟩)=0) :
    (fun j => v (n,j))=0 := by
  have hgauge := continued_free_zero basis freeCoordinate (fun j => basis_free_coordinate j)
    1 f BG G hG hGF
  have hfree := regularized_stack_free_zero freeCoordinate G hgauge 3 2 v hv
  apply actual_augmented_kernel hf ε (2-n.val) hχ (fun j => v (n,j)) _ (hfree n)
  intro i
  cases hr : actual i.val with
  | old j => simpa only [hr,sourceLeading] using hold j
  | physical r =>
    have hp := all_actual_source i
    have hq := all_actual_tail i
    rw [hr] at hp hq
    have h := physical_regularized_block_rows basis freeCoordinate basis_periodic r (-1)
      (source i.val) (tail i.val) hp hq (all_source_zero i) (all_tail_zero i)
      hf ε hε hlaw (by simpa using hχ) BG G hG hGF v hv hshift
    have hz : leading r 1 f ε (2-n.val) (fun j => v (n,j))=0 := by
      rw [h n]
      by_cases hn : n=0
      · simp [hn]
      rw [ite_eq_right hn]
      have ht : (fun j => v (0,j))=0 :=
        hprior 0 (Fin.pos_iff_ne_zero.mpr hn)
      rw [ht]
      have hqz : regularizedTaylor f (-1) (.physical r) n 2 0=0 := by
        rw [regularizedTaylor_finite]
        simp
      rw [hqz,zero_add]
      apply Finset.sum_eq_zero
      intro a ha
      have ha' := Finset.mem_range.mp ha
      rw [hprior (lowerIndex n a) (by simp only [lowerIndex]; omega)]
      simpa only [zero_smul,zero_mul] using shifted_smul r 1 f ε a (2-n.val) 0 (0 : Fin 1050 → ℂ)
    simpa only [hr,sourceLeading] using hz

#print axioms regularized_point_zero_of_prior_old_zero
end QuantitativeArithmeticSmallLevelTwentyFive.AuxMinusLaurent
end
end

/-! ## TwentyFiveAuxTwoPointPole -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex Matrix Filter Set QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift
open scoped Topology

/- A physical Taylor row applied to one universal principal vector of two
points gives both the upper homogeneous row and the lower inhomogeneous row.
No comparison of the two pole orders is required. -/
compact_certificate theorem physical_two_point_rows (basis : ℕ → Poly) (free : Fin 68 → Fin 1050)
    (hperiodic : ∀ j, basis (j%1050)=basis j)
    (r : Row) (χ : ℚ) (p q : Poly)
    (hp : normalizedPoly (rawSourcePoly χ (.physical r))=p)
    (hq : normalizedPoly (rawTailPoly (.physical r))=q)
    (hpzero : substitute basis p=[]) (hqzero : substitute basis q=[])
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=(χ:ℂ)) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis free m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 2 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 1 G) s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n)) :
    leading r m f ε s (fun j => v (0,j))=0 ∧
      leading r m f ε (s-1) (fun j => v (1,j))=
        shifted r m f ε 0 (s-1) (fun j => v (0,j)) := by
  obtain ⟨B,H,hH,hrow⟩ := physical_row_continues basis free hperiodic r χ p q
    hp hq hpzero hqzero hm hf ε hε hlaw hχ BG G (fun j z => (hG j z).meromorphicAt) hGF
  let rows : Unit → SourceRow := fun _ => .physical r
  let frees : Empty → Fin 1050 := Empty.elim
  let A : ℂ → Matrix Unit (Fin 1050) ℂ := fun z _ => augmentedMatrix rows frees m f ε z (Sum.inl ())
  let C : ℕ → ℂ → Matrix Unit (Fin 1050) ℂ := fun n z _ =>
    augmentedShiftMatrix (κ := Empty) rows m f ε n z (Sum.inl ())
  have ha (z : ℂ) (w : Fin 1050 → ℂ) : (∑ j, A z () j*w j)=leading r m f ε z w :=
    congrFun (augmentedMatrix_mulVec rows frees m f ε z w) (Sum.inl ())
  have hc (n : ℕ) (z : ℂ) (w : Fin 1050 → ℂ) : (∑ j, C n z () j*w j)=shifted r m f ε n z w :=
    congrFun (augmentedShiftMatrix_mulVec (κ := Empty) rows m f ε n z w) (Sum.inl ())
  have hh := hv.block_rows B G A C (fun n z _ => H n z) s 1 v
    hG (fun z _ j => augmentedMatrix_analytic rows frees m f ε z (Sum.inl ()) j)
    (fun n z _ j => augmentedShiftMatrix_analytic (κ := Empty) rows m f ε n z (Sum.inl ()) j)
    (fun n _ z hz => hH n z hz) hshift (by
      intro n i z hz
      cases i
      simpa only [ha,hc] using hrow n z hz)
  constructor
  · have h := hh (0,())
    rw [blockLeading_apply] at h
    simpa only [Fin.val_zero,Nat.cast_zero,sub_zero,Finset.range_zero,Finset.sum_empty,ha] using h
  · have h := hh (1,())
    rw [blockLeading_apply] at h
    have hi : lowerIndex (1:Fin 2) 0=0 := rfl
    simpa only [Fin.val_one,Nat.cast_one,Finset.sum_range_one,hi,ha,hc] using sub_eq_zero.mp h

#print axioms physical_two_point_rows
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
end
end

/-! ## TwentyFiveAuxMinusTwoPointKernel -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.AuxMinusLaurent
open Complex QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift

/- If the upper projection and the 150 old lower coordinates vanish, the
entire lower auxiliary vector vanishes. External old sources are zero here
only because their coordinates have explicitly been shown to vanish. -/
compact_certificate theorem lower_zero_of_upper_old_zero
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)= -1) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis freeCoordinate m f z
      (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 2 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 1 G) s v)
    (hshift : ∀ n : ℕ, 0<n → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hupper : (fun j => v (0,j))=0)
    (hold : ∀ j : Fin 150, v (1,⟨7*j.val,by omega⟩)=0) :
    (fun j => v (1,j))=0 := by
  have hgauge := continued_free_zero basis freeCoordinate (fun j => basis_free_coordinate j)
    m f BG G hG hGF
  have hfree := stack_free_zero freeCoordinate G hgauge 1 s v hv
  apply actual_augmented_kernel hf ε (s-1) hχ (fun j => v (1,j)) _ (hfree 1)
  intro i
  cases hr : actual i.val with
  | old j => simpa only [hr,sourceLeading] using hold j
  | physical r =>
    have hp := all_actual_source i
    have hq := all_actual_tail i
    rw [hr] at hp hq
    have h := physical_two_point_rows basis freeCoordinate basis_periodic r (-1)
      (source i.val) (tail i.val) hp hq (all_source_zero i) (all_tail_zero i)
      hm hf ε hε hlaw (by simpa using hχ) BG G hG hGF s v hv hshift
    have hz : shifted r m f ε 0 (s-1) (0 : Fin 1050 → ℂ)=0 := by
      simpa only [zero_smul,zero_mul] using shifted_smul r m f ε 0 (s-1) 0 (0 : Fin 1050 → ℂ)
    rw [hupper,hz] at h
    simpa only [hr,sourceLeading] using h.2

#print axioms lower_zero_of_upper_old_zero
end QuantitativeArithmeticSmallLevelTwentyFive.AuxMinusLaurent
end
end

/-! ## TwentyFiveAuxTwoPointPoleAllowed -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
open Complex Matrix Filter Set QuantitativeArithmeticSevenLaurentRows
open QuantitativeArithmeticSmallLevelTwentyFiveFiniteGrid
open QuantitativeArithmeticUniversalPoleVector SmallLevelFiniteShift
open scoped Topology

compact_certificate theorem physical_two_point_rows_allowed (basis : ℕ → Poly) (free : Fin 68 → Fin 1050)
    (hperiodic : ∀ j, basis (j%1050)=basis j)
    (r : Row) (χ : ℚ) (p q : Poly)
    (hp : normalizedPoly (rawSourcePoly χ (.physical r))=p)
    (hq : normalizedPoly (rawTailPoly (.physical r))=q)
    (hpzero : substitute basis p=[]) (hqzero : substitute basis q=[])
    {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (ε : ℂ) (hε : ε=1 ∨ ε= -1)
    (hlaw : QuantitativeArithmeticCoherentTaylor.CoherentLaw 25 (2*m) f ε)
    (hχ : ε*Complex.I^(2*m)=(χ:ℂ)) (BG : ℝ) (G : ℂ → Fin 1050 → ℂ)
    (hG : ∀ j z, MeromorphicNFAt (fun w => G w j) z)
    (hGF : ∀ z, BG<z.re → G z=physicalGauge basis free m f z (gridVector 1050 (2*m) f z))
    (s : ℂ) (v : Fin 2 × Fin 1050 → ℂ) (hv : IsLeadingVector (stackGrid 1 G) s v)
    (hshift : ∀ n : ℕ, 0<n → (s+n)≠((2*m:ℕ):ℂ) → ∀ j, 0≤ meromorphicOrderAt (fun z => G z j) (s+n))
    (hweight : ∀ j, (-1:WithTop ℤ)≤ meromorphicOrderAt (fun z => G z j) ((2*m:ℕ):ℂ)) :
    leading r m f ε s (fun j => v (0,j))=0 ∧
      leading r m f ε (s-1) (fun j => v (1,j))=
        shifted r m f ε 0 (s-1) (fun j => v (0,j)) := by
  obtain ⟨B,H,hH,hrow⟩ := physical_row_continues basis free hperiodic r χ p q
    hp hq hpzero hqzero hm hf ε hε hlaw hχ BG G (fun j z => (hG j z).meromorphicAt) hGF
  let rows : Unit → SourceRow := fun _ => .physical r
  let frees : Empty → Fin 1050 := Empty.elim
  let A : ℂ → Matrix Unit (Fin 1050) ℂ := fun z _ => augmentedMatrix rows frees m f ε z (Sum.inl ())
  let C : ℕ → ℂ → Matrix Unit (Fin 1050) ℂ := fun n z _ =>
    augmentedShiftMatrix (κ := Empty) rows m f ε n z (Sum.inl ())
  have ha (z : ℂ) (w : Fin 1050 → ℂ) : (∑ j, A z () j*w j)=leading r m f ε z w :=
    congrFun (augmentedMatrix_mulVec rows frees m f ε z w) (Sum.inl ())
  have hc (n : ℕ) (z : ℂ) (w : Fin 1050 → ℂ) : (∑ j, C n z () j*w j)=shifted r m f ε n z w :=
    congrFun (augmentedShiftMatrix_mulVec (κ := Empty) rows m f ε n z w) (Sum.inl ())
  have hh := hv.regular_block_rows B G A C (fun n z _ => H n z) s 1 v
    (fun z _ j => augmentedMatrix_analytic rows frees m f ε z (Sum.inl ()) j)
    (fun n z _ j => augmentedShiftMatrix_analytic (κ := Empty) rows m f ε n z (Sum.inl ()) j)
    (fun n _ z hz => hH n z hz)
    (fun n a ha _ j => augmented_allowed_tail (κ := Empty) rows m f ε χ hχ
      G hG s n.val hshift hweight a ha (Sum.inl ()) j) (by
      intro n i z hz
      cases i
      simpa only [ha,hc] using hrow n z hz)
  constructor
  · have h := hh (0,())
    rw [blockLeading_apply] at h
    simpa only [Fin.val_zero,Nat.cast_zero,sub_zero,Finset.range_zero,Finset.sum_empty,ha] using h
  · have h := hh (1,())
    rw [blockLeading_apply] at h
    have hi : lowerIndex (1:Fin 2) 0=0 := rfl
    simpa only [Fin.val_one,Nat.cast_one,Finset.sum_range_one,hi,ha,hc] using sub_eq_zero.mp h

#print axioms physical_two_point_rows_allowed
end QuantitativeArithmeticSmallLevelTwentyFiveAuxGridModel
