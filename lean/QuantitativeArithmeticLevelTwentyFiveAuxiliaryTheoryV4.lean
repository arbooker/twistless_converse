compact_certificate theorem negative3_fricke_conjugate :
    SpecialLinearGroup.mapGL ℝ negative3*fricke 25 (by decide)=
    fricke 25 (by decide)*SpecialLinearGroup.mapGL ℝ positive3⁻¹ := by
  rw [show positive3⁻¹= (⟨!![-8,-1;25,3],by decide⟩:SL(2,ℤ)) by decide +kernel]
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [negative3,fricke,matrix,GeneralLinearGroup.mkOfDetNeZero,
      SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe,Matrix.mul_apply,Fin.sum_univ_two,
      show Real.sqrt 25=5 by norm_num]

compact_certificate theorem positive3_of_constant_defect {m : ℕ} (hm : 0< m) {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f) (C : ℂ)
    (hC : (fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive3)-fourierFunction (2*m) f=fun _ => C) :
    fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive3=fourierFunction (2*m) f := by
  let F := fourierFunction (2*m) f
  let k : ℤ := ((2*m:ℕ):ℤ)
  let c : ℍ → ℂ := fun _ => C
  let W := fricke 25 (by decide)
  let A := SpecialLinearGroup.mapGL ℝ positive3
  obtain ⟨χ,hχ,hW⟩ := original_fricke_sign (by decide : 0<25) m hf
  change F ∣[k] W=χ • F at hW
  have hpos : F ∣[k] A=F+c := by
    change (F ∣[k] A)-F=c at hC
    exact (sub_eq_iff_eq_add.mp hC).trans (add_comm _ _)
  have hneg : F ∣[k] negative3=F-c := by
    have hn := original_negative3_defect hf
    rw [hC] at hn
    have ht : c ∣[k] translation (-2/3)=c := by
      funext z
      rw [translation_slash]
    change (F ∣[k] negative3)-F= -(c ∣[k] translation (-2/3)) at hn
    rw [ht] at hn
    exact (sub_eq_iff_eq_add.mp hn).trans (by abel)
  have hi : F ∣[k] A⁻¹=F-(c ∣[k] A⁻¹) := by
    have hh := congrArg (fun H : ℍ → ℂ => H ∣[k] A⁻¹) hpos
    rw [← SlashAction.slash_mul,mul_inv_cancel,SlashAction.slash_one,SlashAction.add_slash] at hh
    exact eq_sub_iff_add_eq.mpr hh.symm
  have hrel : (c ∣[k] W) ∣[k] A=χ • c := by
    have hh := congrArg (fun H : ℍ → ℂ => H ∣[k] W) hneg
    change (F ∣[k] SpecialLinearGroup.mapGL ℝ negative3) ∣[k] W=(F-c) ∣[k] W at hh
    rw [← SlashAction.slash_mul,negative3_fricke_conjugate,SlashAction.slash_mul,
      SmallLevelEleven.sub_slash,hW] at hh
    simp only [map_inv] at hh
    change (χ • F) ∣[k] A⁻¹=χ • F-(c ∣[k] W) at hh
    rw [det_one_smul A⁻¹ (det_one_inv _ (by simp [A])),hi,smul_sub] at hh
    have hc : c ∣[k] W=χ • (c ∣[k] A⁻¹) := by
      exact (sub_right_inj).mp hh.symm
    rw [hc,det_one_smul A (by simp [A]),← SlashAction.slash_mul,
      inv_mul_cancel,SlashAction.slash_one]
  have hz : C=0 := by
    by_contra hC0
    have hh := congrFun hrel UpperHalfPlane.I
    have hdet : (GeneralLinearGroup.det (W*A):ℝ)=1 := by
      rw [map_mul,Units.val_mul]
      rw [show (GeneralLinearGroup.det W:ℝ)=1 from fricke_det 25 (by decide)]
      simp [A]
    rw [← SlashAction.slash_mul,det_one_slash (W*A) hdet] at hh
    have hd : denom (W*A) UpperHalfPlane.I=(5:ℂ)+15*Complex.I := by
      norm_num [W,A,fricke,matrix,GeneralLinearGroup.mkOfDetNeZero,
        positive3,SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe,
        Matrix.mul_apply,Fin.sum_univ_two,denom,show Real.sqrt 25=5 by norm_num]
      ring
    change C*denom (W*A) UpperHalfPlane.I^(-k)=χ*C at hh
