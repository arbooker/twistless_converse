/-! ## TwentyFiveCuspCircle -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveCuspCircle
open Complex

/- The two denominator-five minor constraints eliminate the same factor
without dividing by either minor or a Hecke eigenvalue. -/
compact_certificate theorem circle_relation (x y : ℂ)
    (h1 : 25*(9*x^2-4*y^2)*(x^2-4)=0)
    (h2 : 25*(9*x^2-4*y^2)*(y^2-9)=0) : 9*x^2=4*y^2 := by
  have h : (9*x^2-4*y^2)^2=0 := by
    linear_combination (9*h1-4*h2)/25
  exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero h)

/- On the physical exponential curve, this relation confines the exponent
to Re(h)=1, and therefore confines x² to the circle of radius four. -/
compact_certificate theorem physical_circle (h : ℂ)
    (he : 9*((2:ℂ)^h)^2=4*((3:ℂ)^h)^2) :
    h.re=1 ∧ ‖((2:ℂ)^h)^2‖=4 := by
  have h2 := Complex.norm_natCast_cpow_of_pos (by decide : 0<2) h
  have h3 := Complex.norm_natCast_cpow_of_pos (by decide : 0<3) h
  norm_num only [Nat.cast_ofNat] at h2 h3
  have hn := congrArg norm he
  rw [norm_mul,norm_mul,norm_pow,norm_pow,h2,h3] at hn
  norm_num only [norm_ofNat] at hn
  have hx : 0<(2:ℝ)^h.re := Real.rpow_pos_of_pos (by norm_num) _
  have hy : 0<(3:ℝ)^h.re := Real.rpow_pos_of_pos (by norm_num) _
  have hp : 3*(2:ℝ)^h.re=2*(3:ℝ)^h.re := by nlinarith
  have hr : ((3/2:ℝ)^h.re)=(3/2:ℝ)^(1:ℝ) := by
    rw [Real.div_rpow (by norm_num : (0:ℝ)≤3) (by norm_num : (0:ℝ)≤2),Real.rpow_one]
    apply (div_eq_iff hx.ne').mpr
    linarith
  have hre : h.re=1 := (Real.rpow_right_inj (by norm_num : (0:ℝ)<3/2)
    (by norm_num : (3/2:ℝ)≠1)).mp hr
  refine ⟨hre,?_⟩
  rw [norm_pow,h2,hre,Real.rpow_one]
  norm_num

/- The exceptional intersection of the two prime circles is the actual
real exponent, by multiplicative independence of 2 and 3. -/
compact_certificate theorem exceptional_exponent (h : ℂ)
    (h2 : ((2:ℂ)^h)^2=4) (h3 : ((3:ℂ)^h)^2=9) : h=1 := by
  have hp2 : ((2:ℂ)^(h-1))^(2:ℕ)=1 := by
    rw [Complex.cpow_sub _ _ (by norm_num : (2:ℂ)≠0),Complex.cpow_one,div_pow,h2]
    norm_num
  have hp3 : ((3:ℂ)^(h-1))^(2:ℕ)=1 := by
    rw [Complex.cpow_sub _ _ (by norm_num : (3:ℂ)≠0),Complex.cpow_one,div_pow,h3]
    norm_num
  exact sub_eq_zero.mp (QuantitativeArithmeticPrimePowerTorsion.distinct_primes_cpow_torsion
    (by decide : Nat.Prime 2) (by decide : Nat.Prime 3) (by decide : (2:ℕ)≠3)
    (h-1) 2 2 (by decide) (by decide) hp2 hp3)

/- The second lower-point residual cannot vanish on the forced circle. -/
compact_certificate theorem second_obstruction_ne_zero (x : ℂ) (hx : ‖x^2‖=4) :
    -125*(9*x^2-104)/(4*x^2)≠0 := by
  have hx0 : x^2≠0 := by
    intro h
    rw [h,norm_zero] at hx
    norm_num at hx
  have hnum : 9*x^2-104≠0 := by
    intro h
    have hn := congrArg norm (sub_eq_zero.mp h)
    rw [norm_mul,hx] at hn
    norm_num at hn
  exact div_ne_zero (mul_ne_zero (by norm_num) hnum) (mul_ne_zero (by norm_num) hx0)

#print axioms second_obstruction_ne_zero
#print axioms circle_relation
#print axioms physical_circle
#print axioms exceptional_exponent
end QuantitativeArithmeticSmallLevelTwentyFiveCuspCircle
end
end

