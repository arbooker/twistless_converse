compact_certificate theorem factor2_power_expansion (a b : ℂ) (n : ℕ) :
    factor2 ((2:ℂ)^n) ((3:ℂ)^n) a b =
      ∑ i : Fin 3, factorCoefficients2 a b i * (factorBases2 i:ℂ)^n := by
  have hb (u v : ℕ) : (((2^u*3^v:ℕ):ℂ))^n=((2:ℂ)^n)^u*((3:ℂ)^n)^v := by
    push_cast
