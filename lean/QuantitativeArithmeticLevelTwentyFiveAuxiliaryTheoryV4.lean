compact_certificate theorem hecke_finite_logPoint (t : ℝ) :
    translation (-2/3) • (heckeFinite 1 • logPoint (-1/3) t)=logPoint (-1/3) (t-Real.log 2) := by
  apply UpperHalfPlane.ext
