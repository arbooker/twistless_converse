    (hP3 : (1 + ((-1) * (y^4)) + ((-2) * (x^2)) + ((a^2) * (x^6)) + ((a^2) * (y^2)) + ((-2) * a * (x^5)) + ((-2) * (x^2) * (y^2)) + (2 * a * (x^3)) + (a * (x^5) * (y^2)) + ((a^2) * (x^2) * (y^2)) + ((a^3) * (x^3) * (y^2)) + ((-1) * a * x * (y^2)) + ((-1) * a * (x^3) * (y^2)))≠0)
