/-! ## TwentyFivePairs -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFivePairs
open Matrix UpperHalfPlane SmallLevelNormalized SmallLevelOriginal
open scoped MatrixGroups ModularForm

/- Reducing a coherent two-branch Fricke equation to two defects. -/
compact_certificate theorem pair_reduction (F : ℍ → ℂ) (k : ℤ) (W V C D : GL (Fin 2) ℝ) (r : ℝ)
    (hp : W*C*translation (-r)=translation r*V)
    (hn : W*D*translation r=translation (-r)*V)
    (h : (F ∣[k] (W⁻¹*translation r*V))+(F ∣[k] (W⁻¹*translation (-r)*V))=
      (F ∣[k] translation r)+(F ∣[k] translation (-r))) :
    (F ∣[k] C)+((F ∣[k] D) ∣[k] translation (2*r))=F+(F ∣[k] translation (2*r)) := by
  have hp' : W⁻¹*translation r*V=C*translation (-r) := by
    rw [mul_assoc,← hp]
    group
  have hn' : W⁻¹*translation (-r)*V=D*translation r := by
    rw [mul_assoc,← hn]
    group
  rw [hp',hn'] at h
  have hh := congrArg (fun G : ℍ → ℂ => G ∣[k] translation r) h
  have hz : translation 0=1 := by
    apply Units.ext
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [translation,matrix,GeneralLinearGroup.mkOfDetNeZero]
  simp only [SlashAction.add_slash,← SlashAction.slash_mul,mul_assoc,translation_mul] at hh
  rw [show -r+r=0 by ring,show r+r=2*r by ring,hz,mul_one,SlashAction.slash_one] at hh
  simpa only [SlashAction.slash_mul,add_comm] using hh

compact_certificate def positive3 : SL(2,ℤ) := ⟨!![3,1;-25,-8],by decide⟩
compact_certificate def negative3 : SL(2,ℤ) := ⟨!![3,-1;25,-8],by decide⟩

compact_certificate theorem root3 (f : ℕ → ℂ) : FinitenessNormalizedTwistProduct.root 25 f 3=1 := by
  simp [FinitenessNormalizedTwistProduct.root,Nat.prime_three.primeFactors,FinitenessNormalizedTwistLocal.sign]

compact_certificate theorem original_pair3 {k : ℕ} {f : ℕ → ℂ} (hf : FinitenessOriginalInput.IsSolution 25 k f) :
    (fourierFunction k f ∣[(k:ℤ)] ((fricke 25 (by decide))⁻¹*translation (1/3)*fricke 225 (by decide)))+
    (fourierFunction k f ∣[(k:ℤ)] ((fricke 25 (by decide))⁻¹*translation (-(1/3))*fricke 225 (by decide)))=
    FinitenessNormalizedTwistProduct.root 25 f 3 •
      ((fourierFunction k f ∣[(k:ℤ)] translation (1/3))+
      (fourierFunction k f ∣[(k:ℤ)] translation (-(1/3)))) := by
  obtain ⟨ε,_,hlaw⟩ := FinitenessOriginalTwistedContinuations.coherent_solution_laws (by decide : 0<25) hf
  apply pair_of_fricke 25 225 k (by decide) (by decide) (1/3)
    (FinitenessFourierConstruction.fourier (FinitenessOriginalFourier.fullCoefficients f k))
    (ε*Complex.I^k) _ (FinitenessNormalizedTwistProduct.root_unit hf.toEulerData 3)
  · intro z hz
    simpa [FinitenessNormalizedTwistProduct.root,FinitenessAnalyticReconstruction.twist,
      Finset.sum_range_succ] using hlaw 1 (by decide) z hz
  · intro z hz
    have h := hlaw 3 (by decide) z hz
    rw [show Nat.lcm 25 (3^2)=225 by decide,
      SmallLevelThree.twist_three _ (FinitenessFourierConstruction.periodic _),
      SmallLevelThree.twist_three _ (FinitenessFourierConstruction.periodic _)] at h
    simpa only [Complex.ofReal_div,Complex.ofReal_one,Complex.ofReal_ofNat,mul_assoc] using h

compact_certificate theorem positive_factor3 : fricke 25 (by decide)*SpecialLinearGroup.mapGL ℝ positive3*
    translation (-(1/3))=translation (1/3)*fricke 225 (by decide) := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [fricke,positive3,translation,matrix,GeneralLinearGroup.mkOfDetNeZero,
      SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe,Matrix.mul_apply,Matrix.vecMul,dotProduct,Fin.sum_univ_two]

compact_certificate theorem negative_factor3 : fricke 25 (by decide)*SpecialLinearGroup.mapGL ℝ negative3*
    translation (1/3)=translation (-(1/3))*fricke 225 (by decide) := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [fricke,negative3,translation,matrix,GeneralLinearGroup.mkOfDetNeZero,
      SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe,Matrix.mul_apply,Matrix.vecMul,dotProduct,Fin.sum_univ_two]

compact_certificate theorem original_reduced3 {k : ℕ} {f : ℕ → ℂ} (hf : FinitenessOriginalInput.IsSolution 25 k f) :
    (fourierFunction k f ∣[(k:ℤ)] positive3)+
      ((fourierFunction k f ∣[(k:ℤ)] negative3) ∣[(k:ℤ)] translation (2/3))=
      fourierFunction k f+(fourierFunction k f ∣[(k:ℤ)] translation (2/3)) := by
  simp only [ModularForm.SL_slash]
  simpa only [show (2:ℝ)*(1/3)=2/3 by ring,SpecialLinearGroup.mapGL,MonoidHom.comp_apply,algebraMap_int_eq] using
    pair_reduction (fourierFunction k f) k (fricke 25 (by decide)) (fricke 225 (by decide))
      (SpecialLinearGroup.mapGL ℝ positive3) (SpecialLinearGroup.mapGL ℝ negative3) (1/3)
      positive_factor3 negative_factor3 (by simpa only [root3,one_smul] using original_pair3 hf)

#print axioms original_reduced3
compact_certificate def positive4 : SL(2,ℤ) := ⟨!![4,1;-25,-6],by decide⟩
compact_certificate def negative4 : SL(2,ℤ) := ⟨!![4,-1;25,-6],by decide⟩

compact_certificate theorem root4 (f : ℕ → ℂ) : FinitenessNormalizedTwistProduct.root 25 f 4=1 := by
  have hp : Nat.primeFactors 4={2} := by
    rw [show (4:ℕ)=2*2 by norm_num,Nat.primeFactors_mul (by decide) (by decide)]
    norm_num
  simp [FinitenessNormalizedTwistProduct.root,hp,FinitenessNormalizedTwistLocal.sign]

compact_certificate theorem original_pair4 {k : ℕ} {f : ℕ → ℂ} (hf : FinitenessOriginalInput.IsSolution 25 k f) :
    (fourierFunction k f ∣[(k:ℤ)] ((fricke 25 (by decide))⁻¹*translation (1/4)*fricke 400 (by decide)))+
    (fourierFunction k f ∣[(k:ℤ)] ((fricke 25 (by decide))⁻¹*translation (-(1/4))*fricke 400 (by decide)))=
    FinitenessNormalizedTwistProduct.root 25 f 4 •
      ((fourierFunction k f ∣[(k:ℤ)] translation (1/4))+
      (fourierFunction k f ∣[(k:ℤ)] translation (-(1/4)))) := by
  obtain ⟨ε,_,hlaw⟩ := FinitenessOriginalTwistedContinuations.coherent_solution_laws (by decide : 0<25) hf
  apply pair_of_fricke 25 400 k (by decide) (by decide) (1/4)
    (FinitenessFourierConstruction.fourier (FinitenessOriginalFourier.fullCoefficients f k))
    (ε*Complex.I^k) _ (FinitenessNormalizedTwistProduct.root_unit hf.toEulerData 4)
  · intro z hz
