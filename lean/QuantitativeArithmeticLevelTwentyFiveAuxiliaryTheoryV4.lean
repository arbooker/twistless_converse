  have h2 : (36:ℂ)^n=((2:ℂ)^n)^2*((3:ℂ)^n)^2 := by
    convert hb 2 2 using 1
  have h3 : (8:ℂ)^n=((2:ℂ)^n)^3*((3:ℂ)^n)^0 := by
    convert hb 3 0 using 1
  have h4 : (32:ℂ)^n=((2:ℂ)^n)^5*((3:ℂ)^n)^0 := by
    convert hb 5 0 using 1
  simp only [Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  change factor3 ((2:ℂ)^n) ((3:ℂ)^n) a b = (1:ℂ)*(9:ℂ)^n + ((1:ℂ)*(4:ℂ)^n + ((1:ℂ)*(36:ℂ)^n + (a*(8:ℂ)^n + (a*(32:ℂ)^n))))
  rw [h0,h1,h2,h3,h4]
  unfold factor3
  ring
compact_certificate theorem factor3_finite_witness (a b : ℂ) (ha : a≠0) :
    ∃ n : ℕ, factor3 ((2:ℂ)^n) ((3:ℂ)^n) a b≠0 := by
