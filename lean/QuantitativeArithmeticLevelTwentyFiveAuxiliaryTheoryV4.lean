    intro i l h
    apply factorBases0_injective
    change (factorBases0 i:ℂ)=(factorBases0 l:ℂ) at h
    exact_mod_cast h
  have hc : factorCoefficients0 a b (0:Fin 18)≠0 := by
    change (1:ℂ)≠0
    norm_num
  obtain ⟨i,hi⟩ := QuantitativeArithmeticSmallLevelNineteenGrid.finite_power_witness
    (fun i : Fin 18 => (factorBases0 i:ℂ)) (factorCoefficients0 a b) hr (0:Fin 18) hc
  refine ⟨i.val,?_⟩
  rw [factor0_power_expansion]
  exact hi
#print axioms factor0_finite_witness

compact_certificate def factor1 (x y a b : ℂ) : ℂ := ((a * (y^2)) + ((a^2) * (x^3)) + ((a^3) * (x^6)) + ((-1) * a * (x^2)) + ((-1) * (a^2) * (x^5)) + (b * y * (x^3)) + (b * (x^3) * (y^3)) + ((a^2) * (x^3) * (y^2)) + ((-1) * a * (x^2) * (y^2)) + (a * b * y * (x^6)))
compact_certificate def factorBases1 : Fin 10→ℕ := ![9,4,36,8,24,72,216,32,64,192]
compact_certificate def factorCoefficients1 (a b : ℂ) : Fin 10→ℂ := ![a,((-1:ℂ) * a),((-1:ℂ) * a),(a^2),b,(a^2),b,((-1:ℂ) * (a^2)),(a^3),(a * b)]
compact_certificate theorem factorBases1_injective : Function.Injective factorBases1 := by decide +kernel
compact_certificate theorem factor1_power_expansion (a b : ℂ) (n : ℕ) :
    factor1 ((2:ℂ)^n) ((3:ℂ)^n) a b =
      ∑ i : Fin 10, factorCoefficients1 a b i * (factorBases1 i:ℂ)^n := by
  have hb (u v : ℕ) : (((2^u*3^v:ℕ):ℂ))^n=((2:ℂ)^n)^u*((3:ℂ)^n)^v := by
    push_cast
    rw [mul_pow]
    simp only [pow_right_comm]
  have h0 : (9:ℂ)^n=((2:ℂ)^n)^0*((3:ℂ)^n)^2 := by
    convert hb 0 2 using 1
  have h1 : (4:ℂ)^n=((2:ℂ)^n)^2*((3:ℂ)^n)^0 := by
    convert hb 2 0 using 1
  have h2 : (36:ℂ)^n=((2:ℂ)^n)^2*((3:ℂ)^n)^2 := by
    convert hb 2 2 using 1
  have h3 : (8:ℂ)^n=((2:ℂ)^n)^3*((3:ℂ)^n)^0 := by
    convert hb 3 0 using 1
  have h4 : (24:ℂ)^n=((2:ℂ)^n)^3*((3:ℂ)^n)^1 := by
    convert hb 3 1 using 1
  have h5 : (72:ℂ)^n=((2:ℂ)^n)^3*((3:ℂ)^n)^2 := by
    convert hb 3 2 using 1
  have h6 : (216:ℂ)^n=((2:ℂ)^n)^3*((3:ℂ)^n)^3 := by
    convert hb 3 3 using 1
  have h7 : (32:ℂ)^n=((2:ℂ)^n)^5*((3:ℂ)^n)^0 := by
    convert hb 5 0 using 1
  have h8 : (64:ℂ)^n=((2:ℂ)^n)^6*((3:ℂ)^n)^0 := by
    convert hb 6 0 using 1
  have h9 : (192:ℂ)^n=((2:ℂ)^n)^6*((3:ℂ)^n)^1 := by
    convert hb 6 1 using 1
  simp only [Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  change factor1 ((2:ℂ)^n) ((3:ℂ)^n) a b = a*(9:ℂ)^n + (((-1:ℂ) * a)*(4:ℂ)^n + (((-1:ℂ) * a)*(36:ℂ)^n + ((a^2)*(8:ℂ)^n + (b*(24:ℂ)^n + ((a^2)*(72:ℂ)^n + (b*(216:ℂ)^n + (((-1:ℂ) * (a^2))*(32:ℂ)^n + ((a^3)*(64:ℂ)^n + ((a * b)*(192:ℂ)^n)))))))))
  rw [h0,h1,h2,h3,h4,h5,h6,h7,h8,h9]
  unfold factor1
  ring
compact_certificate theorem factor1_finite_witness (a b : ℂ) (ha : a≠0) :
    ∃ n : ℕ, factor1 ((2:ℂ)^n) ((3:ℂ)^n) a b≠0 := by
  have hr : Function.Injective (fun i : Fin 10 => (factorBases1 i:ℂ)) := by
    intro i l h
    apply factorBases1_injective
    change (factorBases1 i:ℂ)=(factorBases1 l:ℂ) at h
    exact_mod_cast h
  have hc : factorCoefficients1 a b (0:Fin 10)≠0 := by
    change a≠0
    exact ha
  obtain ⟨i,hi⟩ := QuantitativeArithmeticSmallLevelNineteenGrid.finite_power_witness
    (fun i : Fin 10 => (factorBases1 i:ℂ)) (factorCoefficients1 a b) hr (0:Fin 10) hc
  refine ⟨i.val,?_⟩
  rw [factor1_power_expansion]
  exact hi
#print axioms factor1_finite_witness

compact_certificate def factor2 (x y a b : ℂ) : ℂ := (2 + (x^2) + (a * x))
compact_certificate def factorBases2 : Fin 3→ℕ := ![1,2,4]
compact_certificate def factorCoefficients2 (a b : ℂ) : Fin 3→ℂ := ![(2:ℂ),a,(1:ℂ)]
