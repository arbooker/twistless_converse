/-! ## TwentyFiveCuspReciprocalCircle -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFiveCuspReciprocal
open Complex
open scoped ComplexConjugate

compact_certificate theorem circle_conjugate (u : ℂ) (hu : ‖u‖=4) : conj u=16/u := by
  have hu0 : u≠0 := by intro h; simp [h] at hu
  apply (eq_div_iff hu0).mpr
  rw [mul_comm,Complex.mul_conj]
  norm_num [Complex.normSq_eq_norm_sq,hu]

compact_certificate theorem minor_conjugate (u : ℂ) : minor (conj u)=conj (minor u) := by
  simp [minor,map_ofNat]

compact_certificate theorem obstruction_conjugate (u : ℂ) : obstruction (conj u)=conj (obstruction u) := by
  simp [obstruction,map_ofNat]

/- The coefficient-minor factor recorded in the lower-point computation
has no zeros on the forced circle. The matrix-minor identity is separate. -/
compact_certificate theorem minor_ne_zero_on_circle (u : ℂ) (hu : ‖u‖=4) : minor u≠0 := by
  have hu0 : u≠0 := by intro h; simp [h] at hu
  intro h
  have hc : minor (16/u)=0 := by
    rw [← circle_conjugate u hu,minor_conjugate,h,map_zero]
  have hr : minorReciprocal u=0 := by rw [minor_reciprocal u hu0,hc,mul_zero]
  have hb := minor_bezout u
  simp only [h,hr,mul_zero,zero_add,mul_one] at hb
  exact minor_scale_ne_zero hb.symm

/- The augmented-minor obstruction can vanish on the circle only at U=4. -/
compact_certificate theorem obstruction_zero_on_circle (u : ℂ) (hu : ‖u‖=4) (h : obstruction u=0) : u=4 := by
  have hu0 : u≠0 := by intro h; simp [h] at hu
  have hc : obstruction (16/u)=0 := by
    rw [← circle_conjugate u hu,obstruction_conjugate,h,map_zero]
  have hr : obstructionReciprocal u=0 := by rw [obstruction_reciprocal u hu0,hc,mul_zero]
  have hb := obstruction_bezout u
  simp only [h,hr,mul_zero,zero_add] at hb
  have hh := (mul_eq_zero.mp hb.symm).resolve_left obstruction_scale_ne_zero
  linear_combination hh

#print axioms circle_conjugate
#print axioms minor_ne_zero_on_circle
#print axioms obstruction_zero_on_circle
end QuantitativeArithmeticSmallLevelTwentyFiveCuspReciprocal
