compact_certificate theorem hecke_infinity_logPoint (t : ℝ) :
    translation (1/3) • (heckeInfinity • logPoint (-1/3) t)=logPoint (-1/3) (t+Real.log 2) := by
  apply UpperHalfPlane.ext
  rw [translation_point,infinity_branch_point,logPoint_coe,logPoint_coe,Real.exp_add,
    Real.exp_log (by norm_num : (0:ℝ)<2)]
  push_cast
  ring

compact_certificate theorem positive3_defect_constant_of_data {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (h4 : fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4=fourierFunction (2*m) f)
    (data : Data (fun t => ((fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive3)-
      fourierFunction (2*m) f) (logPoint (-1/3) t))) :
    ∃ C : ℂ,(fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive3)-fourierFunction (2*m) f=fun _ => C := by
  let F := fourierFunction (2*m) f
  let u := (F ∣[((2*m:ℕ):ℤ)] positive3)-F
  let H : ℝ → ℂ := fun t => u (logPoint (-1/3) t)
  let lam := FinitenessAllLevelHeckePower.scale 2 m*f 2
  let a : ℕ → ℂ := fun j => if j=0 then 1 else if j=1 then lam else (2:ℂ)^(2*m)
  have hrec (t : ℝ) : ∑ j∈Finset.range (2+1),a j*H (t+(j:ℝ)*Real.log 2)=0 := by
    have hh := congrFun (original_hecke_defect hf h4) (logPoint (-1/3) (t+Real.log 2))
    change lam/2*H (t+Real.log 2)+
      ((u ∣[((2*m:ℕ):ℤ)] translation (-2/3)) ∣[((2*m:ℕ):ℤ)] heckeFinite 1) (logPoint (-1/3) (t+Real.log 2))+
      ((u ∣[((2*m:ℕ):ℤ)] translation (1/3)) ∣[((2*m:ℕ):ℤ)] heckeInfinity) (logPoint (-1/3) (t+Real.log 2))=0 at hh
    rw [finite_branch_slash,infinity_branch_slash,translation_slash,translation_slash,
      hecke_finite_logPoint,hecke_infinity_logPoint] at hh
    have hm0 : t+Real.log 2-Real.log 2=t := by ring
    have hm2 : t+Real.log 2+Real.log 2=t+2*Real.log 2 := by ring
    rw [hm0,hm2] at hh
    norm_num [a,Finset.sum_range_succ]
    change H t+lam*H (t+Real.log 2)+(2:ℂ)^(2*m)*H (t+2*Real.log 2)=0
    linear_combination 2*hh
  have hF : MDiff F := fourierFunction_holomorphic hf
  have hu : MDiff u := (hF.slash ((2*m:ℕ):ℤ) positive3).sub hF
  obtain ⟨C,hC,_⟩ := data.constant (hu.continuous.comp (logPoint_continuous _))
    (Real.log 2) (Real.log_pos (by norm_num)) 2 a (by simp [a])
    (by simp [a]) hrec
  exact ⟨C,constant_of_logarithmic_line hu (-1/3) C hC⟩
#print axioms positive3_defect_constant_of_data
end QuantitativeArithmeticSmallLevelTwentyFivePairs
