    norm_num
  obtain ⟨i,hi⟩ := QuantitativeArithmeticSmallLevelNineteenGrid.finite_power_witness
    (fun i : Fin 3 => (factorBases2 i:ℂ)) (factorCoefficients2 a b) hr (0:Fin 3) hc
  refine ⟨i.val,?_⟩
  rw [factor2_power_expansion]
  exact hi
#print axioms factor2_finite_witness

compact_certificate def factor3 (x y a b : ℂ) : ℂ := ((x^2) + (y^2) + (a * (x^3)) + (a * (x^5)) + ((x^2) * (y^2)))
compact_certificate def factorBases3 : Fin 5→ℕ := ![9,4,36,8,32]
