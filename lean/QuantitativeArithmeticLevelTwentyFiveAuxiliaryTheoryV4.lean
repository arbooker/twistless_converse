compact_certificate theorem pair_translation_zero : translation 0=1 := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [translation,matrix,GeneralLinearGroup.mkOfDetNeZero]

compact_certificate theorem pair_translation_T : SpecialLinearGroup.mapGL ℝ ModularGroup.T=translation 1 := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [translation,matrix,GeneralLinearGroup.mkOfDetNeZero,
      SpecialLinearGroup.toGL,SpecialLinearGroup.map_apply_coe,ModularGroup.T]

compact_certificate theorem original_negative3_defect {k : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 k f) :
    (fourierFunction k f ∣[(k:ℤ)] negative3)-fourierFunction k f=
    -(((fourierFunction k f ∣[(k:ℤ)] positive3)-fourierFunction k f) ∣[(k:ℤ)] translation (-2/3)) := by
  let F := fourierFunction k f
  have hp := original_reduced3 hf
  have hd : ((F ∣[(k:ℤ)] negative3)-F) ∣[(k:ℤ)] translation (2/3)=
      -((F ∣[(k:ℤ)] positive3)-F) := by
    rw [SmallLevelEleven.sub_slash]
    funext z
    have hz := congrFun hp z
    simp only [Pi.add_apply,Pi.sub_apply,Pi.neg_apply] at hz ⊢
    linear_combination hz
  have ht := congrArg (fun G : ℍ → ℂ => G ∣[(k:ℤ)] translation (-2/3)) hd
  simpa only [← SlashAction.slash_mul,translation_mul,show (2/3:ℝ)+ -2/3=0 by ring,
    pair_translation_zero,SlashAction.slash_one,SlashAction.neg_slash] using ht

compact_certificate theorem original_hecke_defect {m : ℕ} {f : ℕ → ℂ}
    (hf : FinitenessOriginalInput.IsSolution 25 (2*m) f)
    (h4 : fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive4=fourierFunction (2*m) f) :
    let u := (fourierFunction (2*m) f ∣[((2*m:ℕ):ℤ)] positive3)-fourierFunction (2*m) f
    (FinitenessAllLevelHeckePower.scale 2 m*f 2/2) • u+
      ((u ∣[((2*m:ℕ):ℤ)] translation (-2/3)) ∣[((2*m:ℕ):ℤ)] heckeFinite 1)+
      ((u ∣[((2*m:ℕ):ℤ)] translation (1/3)) ∣[((2*m:ℕ):ℤ)] heckeInfinity)=0 := by
  let F := fourierFunction (2*m) f
  let k : ℤ := ((2*m:ℕ):ℤ)
  let K := slashStabilizer k F
  let u := (F ∣[k] positive3)-F
  let lam := FinitenessAllLevelHeckePower.scale 2 m*f 2/2
  have h6 : F ∣[k] positive6=F := by
    rw [show positive6=(-1:SL(2,ℤ))*positive4⁻¹ by decide +kernel]
    exact K.mul_mem (SmallLevelThirtySix.slash_neg_one_even F m) (K.inv_mem h4)
  have hleft1 : F ∣[k] heckeLeft1=F := by
    rw [heckeLeft1_word]
    exact K.inv_mem (original_lower (by decide : 0<25) hf)
  have hleft2 : F ∣[k] heckeLeft2=F := by
    rw [heckeLeft2_word]
    exact K.mul_mem (original_odd (by decide) (by decide : 2*13=25+1) (by decide) hf)
      (K.inv_mem (original_lower (by decide : 0<25) hf))
  have hT : F ∣[k] translation 1=F := by
    rw [← pair_translation_T]
    simpa only [ModularForm.SL_slash,SpecialLinearGroup.mapGL,MonoidHom.comp_apply,algebraMap_int_eq] using original_T (2*m) f
  have hn : F ∣[k] negative3=F-(u ∣[k] translation (-2/3)) := by
    have hh := original_negative3_defect hf
    change (F ∣[k] negative3)-F= -(u ∣[k] translation (-2/3)) at hh
    exact sub_eq_iff_eq_add.mp hh |>.trans (by abel)
  have he := SmallLevelGoodHeckeTwo.original_hecke_two (by decide : ¬2∣25) hf.toEulerData m
  change heckeTwo k F=lam • F at he
  have hh := congrArg (fun G : ℍ → ℂ => G ∣[k] SpecialLinearGroup.mapGL ℝ positive3) he
  simp only [heckeTwo,SlashAction.add_slash,det_one_smul (SpecialLinearGroup.mapGL ℝ positive3) (by simp [SpecialLinearGroup.det_mapGL]),← SlashAction.slash_mul] at hh
  rw [positive3_hecke_infinity,positive3_hecke_zero,positive3_hecke_one] at hh
  simp only [SlashAction.slash_mul] at hh
  change (F ∣[k] positive6) ∣[k] heckeFinite 0+
    (((F ∣[k] heckeLeft1) ∣[k] negative3) ∣[k] heckeFinite 1)+
    ((((F ∣[k] heckeLeft2) ∣[k] negative3) ∣[k] translation 1) ∣[k] heckeInfinity)=
      lam • (F ∣[k] positive3) at hh
  rw [h6,hleft1,hleft2,hn] at hh
  have htneg : (F-(u ∣[k] translation (-2/3))) ∣[k] translation 1=
      F-(u ∣[k] translation (1/3)) := by
    rw [SmallLevelEleven.sub_slash F (u ∣[k] translation (-2/3)),hT,
      ← SlashAction.slash_mul,translation_mul,show (-2/3:ℝ)+1=1/3 by ring]
  rw [htneg,SmallLevelEleven.sub_slash F (u ∣[k] translation (-2/3)) k (heckeFinite 1),
    SmallLevelEleven.sub_slash F (u ∣[k] translation (1/3)) k heckeInfinity] at hh
  change lam • u+((u ∣[k] translation (-2/3)) ∣[k] heckeFinite 1)+
    ((u ∣[k] translation (1/3)) ∣[k] heckeInfinity)=0
  funext z
  have hhz := congrFun hh z
  have hez := congrFun he z
  simp only [heckeTwo,Pi.add_apply,Pi.sub_apply,Pi.smul_apply,smul_eq_mul,u,Pi.zero_apply] at hhz hez ⊢
  linear_combination hez-hhz
#print axioms original_hecke_defect
end QuantitativeArithmeticSmallLevelTwentyFivePairs
