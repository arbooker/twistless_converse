@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.ContinuationPositive

compact_certificate def parameter (p m : ℕ) (s : ℂ) : ℂ := (p:ℂ)^(s-(m:ℂ))

compact_certificate theorem parameter_analytic {p : ℕ} (hp : p≠0) (m : ℕ) (s : ℂ) :
    AnalyticAt ℂ (parameter p m) s := by
  have hp0 : (p:ℂ)≠0 := by exact_mod_cast hp
  unfold parameter
  simp_rw [Complex.cpow_def_of_ne_zero hp0]
  fun_prop

compact_certificate theorem parameter_nat (p m n : ℕ) :
    parameter p m ((m+n:ℕ):ℂ)=(p:ℂ)^n := by
  unfold parameter
  rw [show ((m+n:ℕ):ℂ)-(m:ℂ)=(n:ℂ) by push_cast; ring]
  exact Complex.cpow_natCast _ _

compact_certificate def factors (m : ℕ) (a b : ℂ) (i : Fin 4) (s : ℂ) : ℂ :=
  ![factor0 (parameter 2 m s) (parameter 3 m s) a b,
    factor1 (parameter 2 m s) (parameter 3 m s) a b,
    factor2 (parameter 2 m s) (parameter 3 m s) a b,
    factor3 (parameter 2 m s) (parameter 3 m s) a b] i

compact_certificate theorem factors_analytic (m : ℕ) (a b : ℂ) (i : Fin 4) (s : ℂ) :
    AnalyticAt ℂ (factors m a b i) s := by
  have h2 := parameter_analytic (by decide : 2≠0) m s
  have h3 := parameter_analytic (by decide : 3≠0) m s
  fin_cases i
  · change AnalyticAt ℂ (fun t => factor0 (parameter 2 m t) (parameter 3 m t) a b) s
    unfold factor0
    fun_prop
  · change AnalyticAt ℂ (fun t => factor1 (parameter 2 m t) (parameter 3 m t) a b) s
    unfold factor1
    fun_prop
  · change AnalyticAt ℂ (fun t => factor2 (parameter 2 m t) (parameter 3 m t) a b) s
    unfold factor2
    fun_prop
  · change AnalyticAt ℂ (fun t => factor3 (parameter 2 m t) (parameter 3 m t) a b) s
    unfold factor3
    fun_prop

compact_certificate theorem factors_nontrivial (m : ℕ) (a b : ℂ) (ha : a≠0) (i : Fin 4) :
    ∃ s, factors m a b i s≠0 := by
  fin_cases i
  · obtain ⟨n,hn⟩ := factor0_finite_witness a b ha
    refine ⟨((m+n:ℕ):ℂ),?_⟩
    change factor0 (parameter 2 m ((m+n:ℕ):ℂ)) (parameter 3 m ((m+n:ℕ):ℂ)) a b≠0
    simpa only [parameter_nat, Nat.cast_ofNat] using hn
  · obtain ⟨n,hn⟩ := factor1_finite_witness a b ha
    refine ⟨((m+n:ℕ):ℂ),?_⟩
    change factor1 (parameter 2 m ((m+n:ℕ):ℂ)) (parameter 3 m ((m+n:ℕ):ℂ)) a b≠0
    simpa only [parameter_nat, Nat.cast_ofNat] using hn
  · obtain ⟨n,hn⟩ := factor2_finite_witness a b ha
    refine ⟨((m+n:ℕ):ℂ),?_⟩
    change factor2 (parameter 2 m ((m+n:ℕ):ℂ)) (parameter 3 m ((m+n:ℕ):ℂ)) a b≠0
    simpa only [parameter_nat, Nat.cast_ofNat] using hn
  · obtain ⟨n,hn⟩ := factor3_finite_witness a b ha
    refine ⟨((m+n:ℕ):ℂ),?_⟩
    change factor3 (parameter 2 m ((m+n:ℕ):ℂ)) (parameter 3 m ((m+n:ℕ):ℂ)) a b≠0
    simpa only [parameter_nat, Nat.cast_ofNat] using hn

compact_certificate theorem common_factor_witness (m : ℕ) (a b : ℂ) (ha : a≠0) :
    ∃ s, ∀ i : Fin 4, factors m a b i s≠0 := by
  exact QuantitativeArithmeticFiniteAnalyticWitness.common_nonzero
    (factors m a b) (factors_analytic m a b) (factors_nontrivial m a b ha)

#print axioms parameter_nat
#print axioms factors_nontrivial
#print axioms common_factor_witness
end QuantitativeArithmeticSmallLevelTwentyFive.ContinuationPositive
end
