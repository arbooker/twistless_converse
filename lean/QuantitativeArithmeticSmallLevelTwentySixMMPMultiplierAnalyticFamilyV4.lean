    AnalyticAt ℂ (fun t => p0 (X t) (Y t) (Z t) (W t) (A t) (B t)) s := by
  simp only [p0,coefficients0,evaluate,c0_0,c0_1,c0_2,c0_3,c0_4,c0_5,c0_6,c0_7,c0_8]
