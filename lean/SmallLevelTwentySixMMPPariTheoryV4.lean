theorem second_columns_no_common_zero (x y z w a b : ℂ)
    (h0 : c01 x y z w a b=0) (h1 : c11 x y z w a b=0)
    (h2 : c21 x y z w a b=0) (h3 : c31 x y z w a b=0)
    (h4 : c41 x y z w a b=0) : False := by
  simp only [c01,c11,c21,c31,c41] at *
  have hp : (x-2)^2*(x+5)=0 := by
    linear_combination (660/13:ℂ)*((-7/66*x+7/33)*h0+(x/2-1)*h1)
  rcases mul_eq_zero.mp hp with hx|hx
  · have hx : x=2 := by
      have := (pow_eq_zero_iff (by decide : 2≠0)).mp hx
      linear_combination this
    subst x
    have ha : a=1-y/4 := by linear_combination (-1/4:ℂ)*h2
    rw [ha] at h3 h4
    have hq : (3/16:ℂ)*y^2+2*y+4=0 := by linear_combination h3
    have hr : (1/4:ℂ)*y^2+(9/2:ℂ)*y+28=0 := by linear_combination h4
    have bad : (5:ℂ)=0 := by
      linear_combination ((11/128:ℂ)*y+31/64)*hq+((-33/512:ℂ)*y+7/64)*hr
    norm_num at bad
  · have hx : x= -5 := by linear_combination hx
    subst x
    have ha : a= -8 := by linear_combination (-2/7:ℂ)*h0
    rw [ha] at h2 h3
    have bad : (-24/5:ℂ)=0 := by
      linear_combination (4/5:ℂ)*h2+3*h3
    norm_num at bad

