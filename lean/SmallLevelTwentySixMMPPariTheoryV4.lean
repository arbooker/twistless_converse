theorem normalize_equation (a b v0 v1 : ℂ) (hv : v0≠0)
    (h : a*v0+b*v1=0) : a+b*(v1/v0)=0 := by
  have he : (a+b*(v1/v0))*v0=0 := by
    rw [add_mul,mul_assoc,div_mul_cancel₀ _ hv]
    exact h
  exact (mul_eq_zero.mp he).resolve_right hv

