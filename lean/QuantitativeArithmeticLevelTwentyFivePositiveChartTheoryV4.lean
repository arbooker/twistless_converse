/-! ## TwentyFivePositiveChartPhysicalExclusion -/
section
set_option autoImplicit false
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.PositiveChart
/- The first positive chart has no physical point. This starts from the fifteen
selected chart equations; their original Taylor provenance is a separate theorem. -/
compact_certificate theorem no_physical_fifteen_rows (h A u B : ℂ) (hA : A≠0)
    (hrows : ∀ i<15, QuantitativeArithmeticSevenLaurentRows.eval 0 A
      ((4:ℂ)^h) ((9:ℂ)^h) u B 0 (fun _ => 1) (cubicInput i)=0) : False := by
  have hX : (4:ℂ)^h≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hY : (9:ℂ)^h≠0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hs := StageNine.from_chart_rows u B A ((9:ℂ)^h) ((4:ℂ)^h) hA hY hX hrows
  exact physical_exclusion_of_recurrence h A u B
    (Recurrence.reduced u B A ((9:ℂ)^h) ((4:ℂ)^h)) hrows
    (Recurrence.reduced_zero ..) (Recurrence.all_steps _ _ _ _ _ hs)
    (Recurrence.finalP_sum ..) (Recurrence.finalH_sum ..)
#print axioms no_physical_fifteen_rows
end QuantitativeArithmeticSmallLevelTwentyFive.PositiveChart
end
