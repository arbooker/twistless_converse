compact_certificate theorem cubic_from_fifteen_rows_at_four (t A X Y u B : ℂ) (hx : X=4)
    (hs : ∀ i<15, eval t A X Y u B 0 (fun _ => 1) (cubicInput i)=0) :
    213*Y^3+4585*Y^2+500*Y+12096=0 := by
  have he := cubic_ring_identity t A X Y u B
  rw [input_ring_match0, input_ring_match1, input_ring_match2, input_ring_match3, input_ring_match4, input_ring_match5, input_ring_match6, input_ring_match7, input_ring_match8, input_ring_match9, input_ring_match10, input_ring_match11, input_ring_match12, input_ring_match13, input_ring_match14] at he
  have h16 : inputRing16 t A X Y u B = 0 := by simp [inputRing16, hx]
  have hz : ringScale*(213*Y^3+4585*Y^2+500*Y+12096)=0 := by
    simpa only [hs 0 (by decide), hs 1 (by decide), hs 2 (by decide), hs 3 (by decide), hs 4 (by decide), hs 5 (by decide), hs 6 (by decide), hs 7 (by decide), hs 8 (by decide), hs 9 (by decide), hs 10 (by decide), hs 11 (by decide), hs 12 (by decide), hs 13 (by decide), hs 14 (by decide), h16, multiplierRing15, mul_zero, zero_mul, add_zero] using he.symm
  exact (mul_eq_zero.mp hz).resolve_left (by norm_num [ringScale])

