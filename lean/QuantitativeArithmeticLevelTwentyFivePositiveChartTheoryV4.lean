/-! ## TwentyFivePositiveChartRecurrenceBridge -/
section
set_option autoImplicit false
set_option maxHeartbeats 1000000
@[expose] public noncomputable section
namespace QuantitativeArithmeticSmallLevelTwentyFive.PositiveChart
open QuantitativeArithmeticComplexHornerBounds
open QuantitativeArithmeticSevenLaurentRows
open PositiveRoot

compact_certificate theorem reduced_powers_eq (x : ℂ) (r : ℕ → ℂ) (n : ℕ)
    (h0 : r 0=1) (hs : ∀ j<n, r (j+1)=x*r j) :
    ∀ j≤n, r j=x^j := by
  intro j hj
  induction j with
  | zero => simpa using h0
  | succ j ih =>
    rw [hs j (by omega), ih (by omega), pow_succ']

compact_certificate theorem horner_value_sum (a : ℕ → ℂ) (x : ℂ) (n j : ℕ) :
    hornerValue a x n j=∑ i∈Finset.range n, a (j+i)*x^i := by
  induction n generalizing j with
  | zero => simp [hornerValue]
  | succ n ih =>
    rw [hornerValue, ih, Finset.sum_range_succ']
    simp only [Nat.add_zero, pow_zero, mul_one]
    rw [Finset.mul_sum]
    have he : (∑ i∈Finset.range n, x*(a (j+1+i)*x^i)) =
        ∑ i∈Finset.range n, a (j+(i+1))*x^(i+1) := by
      apply Finset.sum_congr rfl
      intro i _hi
      rw [show j+1+i=j+(i+1) by omega, pow_succ']
      ring
    rw [he, add_comm]

compact_certificate theorem shifted_power_sum (a : ℕ → ℂ) (x c : ℂ) (r : ℕ → ℂ) (n : ℕ)
    (h0 : r 0=1) (hs : ∀ j<n, r (j+1)=x*r j) :
    (∑ i∈Finset.range n, a i*(r (i+1)-c*r i)) =
      (x-c)*(hornerPolynomial a n 0).eval x := by
  have hp := reduced_powers_eq x r n h0 hs
  rw [eval_hornerPolynomial, horner_value_sum]
  simp only [Nat.zero_add]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have hin : i<n := Finset.mem_range.mp hi
  rw [hp (i+1) (by omega), hp i (by omega), pow_succ']
  ring

/- The exact identities supplied by the finite algebraic certificate suffice
to connect its reduced powers to the already checked physical root exclusion. -/
compact_certificate theorem physical_exclusion_of_recurrence (h A u B : ℂ) (r : ℕ → ℂ)
    (hrows : ∀ i<15, eval 0 A ((4:ℂ)^h) ((9:ℂ)^h) u B 0
      (fun _ => 1) (cubicInput i)=0)
    (h0 : r 0=1)
    (hstep : ∀ j<68, r (j+1)=(4:ℂ)^h*r j)
    (hP : (∑ i∈Finset.range 68, (pCoefficient i:ℂ)*(r (i+1)-4*r i))=0)
    (hH : (((4:ℂ)^h-4)*(9:ℂ)^h)-
      (∑ i∈Finset.range 67, (hCoefficient i:ℂ)*(r (i+1)-4*r i))=0) : False := by
  have hx : (4:ℂ)^h≠4 := by
    intro he
    exact no_fifteen_row_physical_point_at_four h 0 A u B he hrows
  have hx0 : (4:ℂ)^h-4≠0 := sub_ne_zero.mpr hx
  rw [shifted_power_sum _ _ _ _ _ h0 hstep] at hP
  have hp : p67.eval ((4:ℂ)^h)=0 :=
    (mul_eq_zero.mp hP).resolve_left hx0
  rw [shifted_power_sum _ _ _ _ _ h0 (fun j hj => hstep j (by omega))] at hH
  have hh : h66.eval ((4:ℂ)^h)=(9:ℂ)^h := by
    have hm : (((4:ℂ)^h-4)*((9:ℂ)^h-h66.eval ((4:ℂ)^h)))=0 := by
      simpa only [mul_sub, h66] using hH
    exact (sub_eq_zero.mp ((mul_eq_zero.mp hm).resolve_left hx0)).symm
  exact no_physical_root h hp hh

#print axioms physical_exclusion_of_recurrence
end QuantitativeArithmeticSmallLevelTwentyFive.PositiveChart
end
