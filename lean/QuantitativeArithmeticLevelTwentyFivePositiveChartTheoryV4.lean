compact_certificate theorem cubic_nonzero_on_circle (y : ℂ) (hy : ‖y‖=9) :
    213*y^3+4585*y^2+500*y+12096≠0 := by
  intro hp
  have he : 4585*y^2= -(213*y^3+500*y+12096) := by linear_combination hp
  have hn : ‖4585*y^2‖≤‖213*y^3‖+‖500*y‖+‖(12096:ℂ)‖ := by
    rw [he,norm_neg]
    exact (norm_add_le _ _).trans (add_le_add (norm_add_le _ _) (le_refl _))
  norm_num [norm_mul,norm_pow,hy] at hn

compact_certificate theorem four_cpow_eq_four_realpart (h : ℂ) (hx : (4:ℂ)^h=4) : h.re=1 := by
  have hn := congrArg norm hx
  have hc := Complex.norm_cpow_eq_rpow_re_of_pos (by norm_num : (0:ℝ)<4) h
  have hr : Real.exp (Real.log 4*h.re)=Real.exp (Real.log 4) := by
    rw [Real.exp_log (by norm_num : (0:ℝ)<4)]
    simpa [Real.rpow_def_of_pos (by norm_num : (0:ℝ)<4)] using hc.symm.trans hn
  have hh := Real.exp_injective hr
  have hl : 0<Real.log 4 := Real.log_pos (by norm_num)
  nlinarith

compact_certificate theorem no_physical_cubic_at_four (h : ℂ) (hx : (4:ℂ)^h=4) :
    213*((9:ℂ)^h)^3+4585*((9:ℂ)^h)^2+500*(9:ℂ)^h+12096≠0 := by
  apply cubic_nonzero_on_circle
  have hr := four_cpow_eq_four_realpart h hx
  have hn := Complex.norm_cpow_eq_rpow_re_of_pos (by norm_num : (0:ℝ)<9) h
  simpa [hr] using hn
#print axioms no_physical_cubic_at_four
end QuantitativeArithmeticSmallLevelTwentyFive.PositiveRoot
