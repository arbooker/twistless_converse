    (hx : (4:ℂ)^h=4)
    (hs : ∀ i<15, eval t A ((4:ℂ)^h) ((9:ℂ)^h) u B 0
      (fun _ => 1) (cubicInput i)=0) : False := by
  exact QuantitativeArithmeticSmallLevelTwentyFive.PositiveRoot.no_physical_cubic_at_four h hx
