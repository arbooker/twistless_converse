compact_certificate theorem all_disk_comparisons : ∀ i : Fin 67,
    0≤diskXLo i ∧ 0≤diskYLo i ∧
      IntervalExcluded (diskXLo i) (diskXHi i) (diskYLo i) (diskYHi i) := by
  unfold IntervalExcluded
  decide +kernel

/- The concrete degree-67 polynomial branch has no physical exponential point.
The deduction of these polynomial equations from the Taylor system is separate. -/
compact_certificate theorem no_physical_root (h : ℂ)
    (hP : p67.eval ((4:ℂ)^h)=0)
    (hH : h66.eval ((4:ℂ)^h)=(9:ℂ)^h) : False := by
  obtain ⟨i,hi⟩ := p67_root_in_disk ((4:ℂ)^h) hP
  obtain ⟨hx,hy⟩ := all_disk_enclosures i ((4:ℂ)^h) hi.le
  rw [hH] at hy
  obtain ⟨hxl,hyl,hcomp⟩ := all_disk_comparisons i
  exact excluded_interval h (diskXLo i) (diskXHi i) (diskYLo i) (diskYHi i)
    hxl hyl hcomp hx hy
#print axioms all_disk_comparisons
#print axioms no_physical_root
end QuantitativeArithmeticSmallLevelTwentyFive.PositiveRoot
end
