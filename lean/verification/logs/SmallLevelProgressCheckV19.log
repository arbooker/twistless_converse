'SmallLevelTwentyOne.taylorSpecs_valid' depends on axioms: [propext]
SmallLevelTwentyOne.original_taylor_system {k : ℕ} (hk : Even k) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution 21 k f) :
  ∃ ε,
    (ε = 1 ∨ ε = -1) ∧
      ∃ B,
        ∀ (i : Fin 28) (M : ℕ),
          AnalyticOnNhd ℂ (SmallLevelTwentyOne.rowError k f ε i M) {s | B - (↑M + 1) < s.re} ∧
            ∀ (s : ℂ),
              B < s.re →
                SmallLevelTaylor.gridSum k f 42 (SmallLevelTwentyOne.rowQ i) (SmallLevelTwentyOne.rowT i) s -
                    SmallLevelTwentyOne.rowCoefficient k f ε i 0 s *
                      SmallLevelTaylor.gridSum k f 42 (SmallLevelTwentyOne.rowQ i) (SmallLevelTwentyOne.rowPartner i)
                        s =
                  SmallLevelTwentyOne.rowError k f ε i M s +
                    ∑ n ∈ Finset.range M,
                      SmallLevelTwentyOne.rowCoefficient k f ε i (n + 1) s *
                        SmallLevelTaylor.gridSum k f 42 (SmallLevelTwentyOne.rowQ i) (SmallLevelTwentyOne.rowPartner i)
                          (s + (↑n + 1))
