SmallLevelTaylor.taylorCoeff_additive_mellin (k : ℕ) {a : ℕ → ℂ} (ha : FinitenessPolynomialSeries.PolynomialBound a)
  (ha0 : a 0 = 0) {c : ℝ} (hc : 0 < c) :
  ∃ B,
    ∀ (β : ℝ) (s : ℂ),
      B < s.re →
        ∀ (n : ℕ),
          mellin (fun y => SmallLevelTaylor.taylorCoeff k a β c y n) s =
            Ring.choose (s - ↑k) n * ↑c ^ s * SmallLevelAdditive.transform a β s
