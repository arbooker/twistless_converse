'SmallLevelTaylor.taylorTerm_convergent' depends on axioms: [propext, Classical.choice, Quot.sound]
'SmallLevelTaylor.taylorTerm_additive_mellin' depends on axioms: [propext, Classical.choice, Quot.sound]
SmallLevelTaylor.all_taylor_mellin_rows {L r : ℝ} (hL : 0 < L) (hr : r ≠ 0) (k : ℕ) {a : ℕ → ℂ}
  (ha : FinitenessPolynomialSeries.PolynomialBound a) (ha0 : a 0 = 0) (χ : ℂ)
  (hF :
    ∀ (z : ℂ),
      0 < z.im →
        FinitenessFourierConstruction.fourier a z =
          χ / (↑√L * z) ^ k * FinitenessFourierConstruction.fourier a (-1 / (↑L * z))) :
  ∃ B,
    ∀ (M : ℕ),
      AnalyticOnNhd ℂ (mellin (SmallLevelTaylor.frickeError k a L r χ M)) {s | B - ↑M < s.re} ∧
        ∀ (s : ℂ),
          B < s.re →
            SmallLevelAdditive.transform a r s -
                χ / (↑√L * ↑r) ^ k *
                  ∑ n ∈ Finset.range M, SmallLevelTaylor.mellinTaylorTerm k a (-1 / (L * r)) (L * r ^ 2) r n s =
              mellin (SmallLevelTaylor.frickeError k a L r χ M) s
'SmallLevelTaylor.all_taylor_mellin_rows' depends on axioms: [propext, Classical.choice, Quot.sound]
'SmallLevelTaylor.normalized_taylor_mellin_rows' depends on axioms: [propext, Classical.choice, Quot.sound]
SmallLevelTaylor.original_finite_sum_taylor_rows {N k : ℕ} (hN : 0 < N) (hk : Even k) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution N k f) :
  ∃ ε,
    (ε = 1 ∨ ε = -1) ∧
      ∀ (q : ℕ),
        0 < q →
          ∀ (r : ℝ),
            r ≠ 0 →
              ∃ B,
                ∀ (M : ℕ),
                  AnalyticOnNhd ℂ
                      (mellin
                        (SmallLevelTaylor.frickeError k
                          (FinitenessOriginalFourier.fullCoefficients (FinitenessRamanujanFourier.twisted f q) k)
                          (↑(N.lcm (q ^ 2))) r (FinitenessNormalizedTwistProduct.root N f q * ε * Complex.I ^ k) M))
                      {s | B - ↑M < s.re} ∧
                    ∀ (s : ℂ),
                      B < s.re →
                        SmallLevelTaylor.ramanujanAdditive k f q r s -
                            FinitenessNormalizedTwistProduct.root N f q * ε * Complex.I ^ k *
                                ↑(↑(N.lcm (q ^ 2)) * r ^ 2) ^ (s - ↑k / 2) *
                              SmallLevelTaylor.ramanujanTaylorSum k f q (↑(N.lcm (q ^ 2))) r M s =
                          mellin
                            (SmallLevelTaylor.frickeError k
                              (FinitenessOriginalFourier.fullCoefficients (FinitenessRamanujanFourier.twisted f q) k)
                              (↑(N.lcm (q ^ 2))) r (FinitenessNormalizedTwistProduct.root N f q * ε * Complex.I ^ k) M)
                            s
'SmallLevelTaylor.original_finite_sum_taylor_rows' depends on axioms: [propext, Classical.choice, Quot.sound]
'SmallLevelTaylor.taylorRowScalar_analytic' depends on axioms: [propext, Classical.choice, Quot.sound]
'SmallLevelAdditive.grid_mod' depends on axioms: [propext, Classical.choice, Quot.sound]
'SmallLevelAdditive.fricke_grid_partner' depends on axioms: [propext, Classical.choice, Quot.sound]
SmallLevelTaylor.original_closed_grid_taylor_rows {N k : ℕ} (hN : 0 < N) (hk : Even k) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution N k f) :
  ∃ ε,
    (ε = 1 ∨ ε = -1) ∧
      ∀ (Q q : ℕ),
        0 < Q →
          0 < q →
            q ∣ Q →
              ∀ (t d : ℤ),
                t ≠ 0 →
                  ↑(N.lcm (q ^ 2)) * d = ↑Q ^ 2 →
                    t ∣ d →
                      ∃ B,
                        ∀ (M : ℕ),
                          AnalyticOnNhd ℂ
                              (mellin
                                (SmallLevelTaylor.frickeError k
                                  (FinitenessOriginalFourier.fullCoefficients (FinitenessRamanujanFourier.twisted f q)
                                    k)
                                  (↑(N.lcm (q ^ 2))) (↑t / ↑Q)
                                  (FinitenessNormalizedTwistProduct.root N f q * ε * Complex.I ^ k) (M + 1)))
                              {s | B - (↑M + 1) < s.re} ∧
                            ∀ (s : ℂ),
                              B < s.re →
                                SmallLevelTaylor.gridSum k f Q q t s -
                                    SmallLevelTaylor.taylorRowScalar k (↑(N.lcm (q ^ 2))) (↑t / ↑Q)
                                        (FinitenessNormalizedTwistProduct.root N f q * ε * Complex.I ^ k) 0 s *
                                      SmallLevelTaylor.gridSum k f Q q (-(d / t)) s =
                                  mellin
                                      (SmallLevelTaylor.frickeError k
                                        (FinitenessOriginalFourier.fullCoefficients
                                          (FinitenessRamanujanFourier.twisted f q) k)
                                        (↑(N.lcm (q ^ 2))) (↑t / ↑Q)
                                        (FinitenessNormalizedTwistProduct.root N f q * ε * Complex.I ^ k) (M + 1))
                                      s +
                                    ∑ n ∈ Finset.range M,
                                      SmallLevelTaylor.taylorRowScalar k (↑(N.lcm (q ^ 2))) (↑t / ↑Q)
                                          (FinitenessNormalizedTwistProduct.root N f q * ε * Complex.I ^ k) (n + 1) s *
                                        SmallLevelTaylor.gridSum k f Q q (-(d / t)) (s + (↑n + 1))
'SmallLevelTaylor.original_closed_grid_taylor_rows' depends on axioms: [propext, Classical.choice, Quot.sound]
