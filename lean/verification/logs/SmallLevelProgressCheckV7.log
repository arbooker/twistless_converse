SmallLevelOriginal.SmallLevelsTheorem : Prop
SmallLevelThree.original_pair {N k : ℕ} (hN : 0 < N) (hgood : ¬3 ∣ N) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution N k f) (z : UpperHalfPlane) :
  FinitenessFourierConstruction.fourier (FinitenessOriginalFourier.fullCoefficients f k) ((↑z + 1) / 3) +
      FinitenessFourierConstruction.fourier (FinitenessOriginalFourier.fullCoefficients f k) ((↑z - 1) / 3) =
    3 ^ k *
        (FinitenessFourierConstruction.fourier (FinitenessOriginalFourier.fullCoefficients f k)
            ↑(SmallLevelThree.lowerBranch N 1 • z) /
          (↑N * ↑z + 1) ^ k) +
      3 ^ k *
        (FinitenessFourierConstruction.fourier (FinitenessOriginalFourier.fullCoefficients f k)
            ↑(SmallLevelThree.lowerBranch N (-1) • z) /
          (-↑N * ↑z + 1) ^ k)
SmallLevelThree.original_pair_slash {N k : ℕ} (hN : 0 < N) (hgood : ¬3 ∣ N) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution N k f) :
  SlashAction.map (↑k) (SmallLevelThree.upperBranch 1) (SmallLevelOriginal.fourierFunction k f) +
      SlashAction.map (↑k) (SmallLevelThree.upperBranch (-1)) (SmallLevelOriginal.fourierFunction k f) =
    SlashAction.map (↑k) (SmallLevelThree.lowerBranch N 1) (SmallLevelOriginal.fourierFunction k f) +
      SlashAction.map (↑k) (SmallLevelThree.lowerBranch N (-1)) (SmallLevelOriginal.fourierFunction k f)
SmallLevelEleven.elliptic_defect_zero {F : ℂ → ℂ} {k : ℕ} (hF : AnalyticOnNhd ℂ F {z | 0 < z.im}) (hk : 0 < k)
  (he : ∀ (z : ℂ), 0 < z.im → F ((4 * z + 5 / 3) / (-11 * z - 13 / 3)) = (-11 * z - 13 / 3) ^ k * F z) (z : ℂ) :
  0 < z.im → F z = 0
