    SmallLevelOriginal.fourierFunction (2 * m) f
SmallLevelThirtySix.original_cusp_antiperiod {f : ℕ → ℂ} (m : ℕ) (hm : 0 < m)
  (hf : FinitenessOriginalInput.IsSolution 36 (2 * m) f) (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) :
