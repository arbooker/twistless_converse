SmallLevelTwentyOne.original_leadingMatrix_nonsingular {m : ℕ} {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution 21 (2 * m) f) (ε : ℂ) (hε : ε = 1 ∨ ε = -1) :
