SmallLevelTwentyOne.original_pole_normalization {m : ℕ} (hm : 0 < m) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution 21 (2 * m) f) :
  ∃ ε,
    (ε = 1 ∨ ε = -1) ∧
      ∃ B G,
        (∀ (i : Fin 42) (x : ℂ), MeromorphicNFAt (fun z => G z i) x) ∧
          (∀ (z : ℂ), B < z.re → G z = SmallLevelTwentyOne.gridVector (2 * m) f z) ∧
            ∀ (x : ℂ),
              (∃ i, meromorphicOrderAt (fun z => G z i) x < 0) →
                ∃ n,
                  (∃ i, meromorphicOrderAt (fun z => G z i) (x + ↑n) < 0) ∧
                    (∀ (j : ℕ), 0 < j → ∀ (i : Fin 42), 0 ≤ meromorphicOrderAt (fun z => G z i) (x + ↑n + ↑j)) ∧
                      SmallLevelTwentyOne.originalDeterminantFactor m f ε (x + ↑n) = 0 ∧
                        ∃! w, (SmallLevelTwentyOne.leadingMatrix m f ε (x + ↑n)).mulVec w = 0 ∧ w 28 = 1
