SmallLevelTwentyOne.original_continued_system {m : ℕ} (hm : 0 < m) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution 21 (2 * m) f) :
  ∃ ε,
    (ε = 1 ∨ ε = -1) ∧
      ∃ B G,
        (∀ (i : Fin 42) (x : ℂ), MeromorphicNFAt (fun z => G z i) x) ∧
          (∀ (z : ℂ), B < z.re → G z = SmallLevelTwentyOne.gridVector (2 * m) f z) ∧
            (∀ (i : Fin 42) (z : ℂ), B < z.re → AnalyticAt ℂ (fun w => G w i) z) ∧
              (∀ (n : ℕ) (i : Fin 42) (z : ℂ),
                  B - (↑n + 1) < z.re → AnalyticAt ℂ (fun w => SmallLevelTwentyOne.errorVector m f ε n w i) z) ∧
                ∀ (n : ℕ) (i : Fin 42) (x : ℂ),
                  B - (↑n + 1) < x.re →
                    (fun z => ∑ j, SmallLevelTwentyOne.leadingMatrix m f ε z i j * G z j) =ᶠ[nhdsWithin x {x}ᶜ] fun z =>
                      SmallLevelTwentyOne.errorVector m f ε n z i +
                        ∑ a ∈ Finset.range n, ∑ j, SmallLevelTwentyOne.shiftMatrix m f ε a z i j * G (z + (↑a + 1)) j
'SmallLevelTwentyOne.original_continued_system' depends on axioms: [propext, Classical.choice, Quot.sound]
