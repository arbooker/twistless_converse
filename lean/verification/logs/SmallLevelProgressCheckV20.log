SmallLevelTwentyOne.original_matrix_system {m : ℕ} (hm : 0 < m) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution 21 (2 * m) f) :
  ∃ ε,
    (ε = 1 ∨ ε = -1) ∧
      ∃ B,
        (∀ (i : Fin 42) (s : ℂ), B < s.re → AnalyticAt ℂ (fun z => SmallLevelTwentyOne.gridVector (2 * m) f z i) s) ∧
          (∀ (M : ℕ) (i : Fin 42) (s : ℂ),
              B - (↑M + 1) < s.re → AnalyticAt ℂ (fun z => SmallLevelTwentyOne.errorVector m f ε M z i) s) ∧
            ∀ (M : ℕ) (s : ℂ),
              B < s.re →
                (SmallLevelTwentyOne.leadingMatrix m f ε s).mulVec (SmallLevelTwentyOne.gridVector (2 * m) f s) =
                  SmallLevelTwentyOne.errorVector m f ε M s +
                    ∑ n ∈ Finset.range M,
                      (SmallLevelTwentyOne.shiftMatrix m f ε n s).mulVec
                        (SmallLevelTwentyOne.gridVector (2 * m) f (s + (↑n + 1)))
'SmallLevelTwentyOne.original_matrix_system' depends on axioms: [propext, Classical.choice, Quot.sound]
SmallLevelTwentyOne.original_grid_continuation {m : ℕ} (hm : 0 < m) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution 21 (2 * m) f) :
  ∃ B G,
    (∀ (i : Fin 42) (x : ℂ), MeromorphicNFAt (fun z => G z i) x) ∧
      ∀ (z : ℂ), B < z.re → G z = SmallLevelTwentyOne.gridVector (2 * m) f z
'SmallLevelTwentyOne.original_grid_continuation' depends on axioms: [propext, Classical.choice, Quot.sound]
