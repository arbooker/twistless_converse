SmallLevelOriginal.SmallLevelsTheorem : Prop
SmallLevelThirtyB.original_A (m : ℕ) (hm : 0 < m) {f : ℕ → ℂ} (hf : FinitenessOriginalInput.IsSolution 30 (2 * m) f) :
  ∃ δ,
    (δ = 1 ∨ δ = -1) ∧
      SlashAction.map (↑(2 * m)) SmallLevelThirtyB.A (SmallLevelOriginal.fourierFunction (2 * m) f) =
        δ • SmallLevelOriginal.fourierFunction (2 * m) f
SmallLevelThirtyC.original_C (m : ℕ) (hm : 0 < m) {f : ℕ → ℂ} (hf : FinitenessOriginalInput.IsSolution 30 (2 * m) f) :
  SlashAction.map (↑(2 * m)) SmallLevelThirtyC.C (SmallLevelOriginal.fourierFunction (2 * m) f) =
    FinitenessNormalizedTwistProduct.root 30 f 4 • SmallLevelOriginal.fourierFunction (2 * m) f
SmallLevelThirty.original_C_two (m : ℕ) (hm : 0 < m) {f : ℕ → ℂ}
  (hf : FinitenessOriginalInput.IsSolution 30 (2 * m) f) :
  SlashAction.map (↑(2 * m)) SmallLevelThirtyC.C (SmallLevelOriginal.fourierFunction (2 * m) f) =
    FinitenessNormalizedTwistProduct.root 30 f 2 • SmallLevelOriginal.fourierFunction (2 * m) f
