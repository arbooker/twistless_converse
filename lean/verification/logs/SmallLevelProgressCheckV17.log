SmallLevelContinuation.closed_system_continuation.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι] (B : ℝ)
  (F : ℂ → ι → ℂ) (A : ℂ → Matrix ι ι ℂ) (C : ℕ → ℂ → Matrix ι ι ℂ) (H : ℕ → ℂ → ι → ℂ)
  (hF : ∀ (i : ι) (z : ℂ), B < z.re → AnalyticAt ℂ (fun w => F w i) z)
  (hA : ∀ (x : ℂ) (i j : ι), AnalyticAt ℂ (fun z => A z i j) x) (hd : ∃ y, (A y).det ≠ 0)
  (hC : ∀ (m : ℕ) (x : ℂ) (i j : ι), AnalyticAt ℂ (fun z => C m z i j) x)
  (hH : ∀ (n : ℕ) (i : ι) (z : ℂ), B - (↑n + 1) < z.re → AnalyticAt ℂ (fun w => H n w i) z)
  (hrow :
    ∀ (n : ℕ) (z : ℂ),
      B < z.re →
        ∀ (i : ι), ∑ j, A z i j * F z j = H n z i + ∑ m ∈ Finset.range n, ∑ j, C m z i j * F (z + (↑m + 1)) j) :
  ∃ G, (∀ (i : ι) (x : ℂ), MeromorphicNFAt (fun z => G z i) x) ∧ ∀ (z : ℂ), B < z.re → G z = F z
