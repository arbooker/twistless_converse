SmallLevelOriginal.SmallLevelsTheorem : Prop
SmallLevelAdditive.original_common_halfplane {N k : ℕ} {f : ℕ → ℂ} (hf : FinitenessOriginalInput.IsSolution N k f) :
  ∃ B,
    ∀ (r : ℝ) (s : ℂ),
      B < s.re →
        AnalyticAt ℂ (SmallLevelAdditive.original k f r) s ∧
          mellin
              (fun t =>
                FinitenessFourierConstruction.fourier (FinitenessOriginalFourier.fullCoefficients f k)
                  (↑r + ↑t * Complex.I))
              s =
            SmallLevelAdditive.original k f r s
