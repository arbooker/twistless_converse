  let j : Fin 16 := ⟨i.val%16,Nat.mod_lt _ (by decide)⟩
  match i.val/16 with
  | 0 => gridHeckeSpecsPart0 j
  | 1 => gridHeckeSpecsPart1 j
  | 2 => gridHeckeSpecsPart2 j
  | 3 => gridHeckeSpecsPart3 j
