namespace SmallLevelThirtyFourGrid
open Complex SmallLevelPrimeRates SmallLevelFourPrimeRates FinitenessNormalizedTwistProduct

/-- Four physical prime parameters; the last branch is used only at p=5. -/
def primeParameter (p : ℕ) (X Y Z W : ℂ) : ℂ :=
  if p=2 then X else if p=3 then Y else if p=17 then Z else W

def primeEigenvalue (p : ℕ) (σ₂ σ₁₇ a b : ℂ) : ℂ :=
  if p=2 then σ₂ else if p=3 then a else if p=17 then σ₁₇ else b

def laurentHecke (X Y Z W σ₂ σ₁₇ a b : ℂ) (v : Fin 510→ℂ) (i : Fin 287) : ℂ :=
  (∑ j∈Finset.range (gridHeckeP i),v (gridIndex (gridHeckeT i+(j:ℤ)*(510/gridHeckeP i:ℕ))))-
    primeEigenvalue (gridHeckeP i) σ₂ σ₁₇ a b*(primeParameter (gridHeckeP i) X Y Z W)⁻¹*
      v (gridIndex ((gridHeckeP i:ℤ)*gridHeckeT i))+
    (if gridHeckeP i∣34 then 0 else ((primeParameter (gridHeckeP i) X Y Z W)⁻¹)^2*
      v (gridIndex ((gridHeckeP i:ℤ)^2*gridHeckeT i)))

def laurentRows (X Y Z W η σ₂ σ₁₇ a b : ℂ) (v : Fin 510→ℂ) : GridSource→ℂ
  | .word i => v (gridGroupIndex i)-gridWordSign (-σ₂) η (sourceWord (gridGroupSource i))*
      monomial (groupPowers i) X Y Z W*v (gridGroupTarget i)
  | .taylor i => gridSample (gridTaylorQ i) (gridTaylorT i) v-
      ((if 2∣gridTaylorQ i then -σ₂ else 1)*(if 17∣gridTaylorQ i then -σ₁₇ else 1))*η*
        monomial (taylorPowers i) X Y Z W*gridSample (gridTaylorQ i) (gridTaylorPartner i) v
  | .entire i => gridSample (gridEntireQ i) 0 v
  | .hecke i => laurentHecke X Y Z W σ₂ σ₁₇ a b v i
  | .infinity i => v (gridInfinityIndex i)

theorem primeParameter_actual (m : ℕ) (s : ℂ) (i : Fin 287) :
    primeParameter (gridHeckeP i) (parameter 2 m s) (parameter 3 m s)
      (parameter 17 m s) (parameter 5 m s)=parameter (gridHeckeP i) m s := by
  fin_cases i <;> rfl

theorem primeEigenvalue_actual (f : ℕ→ℂ) (i : Fin 287) :
    primeEigenvalue (gridHeckeP i) (badParameter f 2) (badParameter f 17)
      (badParameter f 3) (badParameter f 5)=(Real.sqrt (gridHeckeP i):ℂ)*f (gridHeckeP i) := by
  fin_cases i <;> rfl

/-- The formal Laurent source system is exactly the original leading system
on the physical exponential curve, for arbitrary original coefficients. -/
theorem leadingRows_laurent (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (v : Fin 510→ℂ) (i : GridSource) :
    gridLeadingRows m f ε s v i=
      laurentRows (parameter 2 m s) (parameter 3 m s) (parameter 17 m s) (parameter 5 m s)
        (phase m ε) (badParameter f 2) (badParameter f 17) (badParameter f 3) (badParameter f 5) v i := by
  cases i with
  | word i =>
    simp only [gridLeadingRows,gridGroupLeading,laurentRows,matrixScalar_leading,phase,root_two]
  | taylor i =>
    simp only [gridLeadingRows,gridRamanujanLeading,laurentRows,taylorScalar_leading,grid_ramanujan_root,phase]
  | entire i => rfl
  | infinity i => rfl
  | hecke i =>
    simp only [gridLeadingRows,laurentRows,laurentHecke,gridHeckeLeading,
      primeParameter_actual,primeEigenvalue_actual]

#print axioms leadingRows_laurent
end SmallLevelThirtyFourGrid
end
end

/-! ## SmallLevelThirtyFourGridTaylorFactorV1 -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
@[expose] public noncomputable section
namespace SmallLevelThirtyFourGrid
open Complex SmallLevelTaylor

def taylorSlope (i : Fin 60) : ℂ :=
  ((gridTaylorL i:ℝ):ℂ)*(((gridTaylorT i:ℝ)/510:ℝ):ℂ)

theorem matrixScalar_factor (m : ℕ) (f : ℕ→ℂ) (η s : ℂ) (i : Fin 186) (n : ℕ) :
    gridMatrixScalar m f η i n s = gridMatrixScalar m f η i 0 s *
      I^n*(gridGroupDerivative i:ℂ)^n*Ring.choose (s+(n:ℂ)-((2*m:ℕ):ℂ)) n := by
  simp only [gridMatrixScalar,Nat.cast_zero,add_zero,pow_zero,Ring.choose_zero_right,mul_one,mul_pow]
  ring

theorem taylorScalar_factor (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (i : Fin 60) (n : ℕ) :
    gridTaylorCoefficient m f ε i n s = gridTaylorCoefficient m f ε i 0 s *
      I^n*taylorSlope i^n*Ring.choose (s+(n:ℂ)-((2*m:ℕ):ℂ)) n := by
  simp only [gridTaylorCoefficient,taylorRowScalar,taylorSlope,Nat.cast_zero,add_zero,
    pow_zero,Ring.choose_zero_right,mul_one,mul_pow]
  ring

def slopeRows (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ) (s : ℂ)
    (v : Fin 510→ℂ) : GridSource→ℂ
  | .word i => gridMatrixScalar m f (ε*I^(2*m)) i 0 s *
      (gridGroupDerivative i:ℂ)^n*v (gridGroupTarget i)
  | .taylor i => gridTaylorCoefficient m f ε i 0 s *
      taylorSlope i^n*gridSample (gridTaylorQ i) (gridTaylorPartner i) v
  | .entire _ => 0
  | .hecke _ => 0
  | .infinity _ => 0

theorem shiftRows_factor (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ) (s : ℂ)
    (v : Fin 510→ℂ) (i : GridSource) :
    gridShiftRows m f ε n s v i =
      I^(n+1)*Ring.choose (s+((n+1:ℕ):ℂ)-((2*m:ℕ):ℂ)) (n+1)*
        slopeRows m f ε (n+1) s v i := by
  cases i with
  | word i =>
    simp only [gridShiftRows,slopeRows]
    rw [matrixScalar_factor m f (ε*I^(2*m)) s i (n+1)]
    ring
  | taylor i =>
    simp only [gridShiftRows,slopeRows]
    rw [taylorScalar_factor m f ε s i (n+1)]
    ring
  | entire i => simp [gridShiftRows,slopeRows]
  | hecke i => simp [gridShiftRows,slopeRows]
  | infinity i => simp [gridShiftRows,slopeRows]

/-- Exact first-order factorization, also valid at s=2m. No division by the
weight factor is used, so the exceptional simple-pole endpoint is retained. -/
theorem firstShift_factor (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ)
    (v : Fin 510→ℂ) (i : GridSource) :
    gridShiftRows m f ε 0 (s-1) v i =
      I*(s-((2*m:ℕ):ℂ))*slopeRows m f ε 1 (s-1) v i := by
  simpa only [Nat.zero_add,Nat.cast_one,sub_add_cancel,Ring.choose_one_right,pow_one]
    using shiftRows_factor m f ε 0 (s-1) v i

#print axioms matrixScalar_factor
#print axioms taylorScalar_factor
#print axioms shiftRows_factor
#print axioms firstShift_factor
end SmallLevelThirtyFourGrid
end
end

/-! ## SmallLevelThirtyFourGridSlopeMatrixV1 -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
namespace SmallLevelThirtyFourGrid
open Complex Matrix SmallLevelFiniteGridSupport

/-- The first Taylor matrix with its universal weight factor removed
algebraically, without division at the weight. -/
def restrictedSlopeMatrix {r d : ℕ} (J : Fin r→GridSource) (u : Fin d→Fin 510)
    (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) : Matrix (Fin r) (Fin d) ℂ :=
  fun i j => slopeRows m f ε 1 s (extension u (Pi.single j 1)) (J i)

theorem slopeRows_analytic (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ)
    (v : Fin 510→ℂ) (i : GridSource) (z : ℂ) :
    AnalyticAt ℂ (fun s => slopeRows m f ε n s v i) z := by
  cases i with
  | word i => exact ((gridMatrixScalar_analytic m f _ i 0 z).mul analyticAt_const).mul analyticAt_const
  | taylor i => exact ((gridTaylorCoefficient_analytic m f ε i 0 z).mul analyticAt_const).mul analyticAt_const
  | entire i => exact analyticAt_const
  | hecke i => exact analyticAt_const
  | infinity i => exact analyticAt_const

theorem restrictedSlopeMatrix_analytic {r d : ℕ} (J : Fin r→GridSource) (u : Fin d→Fin 510)
    (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (i : Fin r) (j : Fin d) (z : ℂ) :
    AnalyticAt ℂ (fun s => restrictedSlopeMatrix J u m f ε s i j) z :=
  slopeRows_analytic m f ε 1 (extension u (Pi.single j 1)) (J i) z

theorem restrictedShiftMatrix_first_factor {r d : ℕ} (J : Fin r→GridSource) (u : Fin d→Fin 510)
    (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (i : Fin r) (j : Fin d) :
    restrictedShiftMatrix J u m f ε 0 (s-1) i j=
      I*(s-((2*m:ℕ):ℂ))*restrictedSlopeMatrix J u m f ε (s-1) i j := by
  simp only [restrictedShiftMatrix,LinearMap.toMatrix'_apply,LinearMap.comp_apply]
  exact firstShift_factor m f ε s (extension u (Pi.single j 1)) (J i)

/-- Absorb the weight factor into the meromorphic vector. This identity
also holds at the weight and hence keeps higher poles visible. -/
theorem first_source_weighted {r d : ℕ} (J : Fin r→GridSource) (u : Fin d→Fin 510)
    (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (v : Fin d→ℂ) (i : Fin r) :
    (∑ j,restrictedShiftMatrix J u m f ε 0 (s-1) i j*v j)=
      I*(∑ j,restrictedSlopeMatrix J u m f ε (s-1) i j*((s-((2*m:ℕ):ℂ))*v j)) := by
  simp_rw [restrictedShiftMatrix_first_factor]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  ring

#print axioms restrictedSlopeMatrix_analytic
#print axioms restrictedShiftMatrix_first_factor
#print axioms first_source_weighted
end SmallLevelThirtyFourGrid
end
end

