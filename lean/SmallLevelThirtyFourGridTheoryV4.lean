/-! ## SmallLevelThirtyFourGridAssemblyV1 -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2500000
@[expose] public noncomputable section
namespace SmallLevelThirtyFourGrid
open Complex Set SmallLevelAdditive SmallLevelTaylor FinitenessRamanujanSum SmallLevelPrimeRates

inductive GridSource where
  | word : Fin 186→GridSource
  | taylor : Fin 60→GridSource
  | entire : Fin 10→GridSource
  | hecke : Fin 287→GridSource
  | infinity : Fin 3→GridSource
  deriving DecidableEq, Fintype

def gridIndex (t : ℤ) : Fin 510 :=
  ⟨(t%510).toNat,by have h:=Int.emod_lt_of_pos t (by decide : (0:ℤ)<510); omega⟩

def gridSample (q : ℕ) (t : ℤ) (w : Fin 510→ℂ) : ℂ :=
  ∑ j∈residues q,w (gridIndex (t+(j:ℤ)*(510/q:ℕ)))

def gridVector (k : ℕ) (f : ℕ→ℂ) (s : ℂ) : Fin 510→ℂ :=
  fun j => grid k f 510 (j:ℕ) s

theorem gridVector_index (k : ℕ) (f : ℕ→ℂ) (s : ℂ) (t : ℤ) :
    gridVector k f s (gridIndex t)=grid k f 510 t s := by
  unfold gridVector
  have he : ((gridIndex t).val:ℤ)=t%510:=Int.toNat_of_nonneg (Int.emod_nonneg _ (by decide))
  rw [he]
  simpa only [Nat.cast_ofNat] using grid_mod k f (by decide : 0<510) t s

theorem gridSample_grid (k : ℕ) (f : ℕ→ℂ) (q : ℕ) (t : ℤ) (s : ℂ) :
    gridSample q t (gridVector k f s)=gridSum k f 510 q t s := by
  unfold gridSample gridSum
  simp_rw [gridVector_index]

theorem gridSample_add (q : ℕ) (t : ℤ) (w v : Fin 510→ℂ) :
    gridSample q t (w+v)=gridSample q t w+gridSample q t v := by
  simp [gridSample,Finset.sum_add_distrib]

theorem gridSample_smul (q : ℕ) (t : ℤ) (c : ℂ) (w : Fin 510→ℂ) :
    gridSample q t (c • w)=c*gridSample q t w := by
  simp [gridSample,Finset.mul_sum]


def gridGroupLeading (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (v : Fin 510→ℂ) (i : Fin 186) : ℂ :=
  v (gridGroupIndex i)-gridMatrixScalar m f (ε*I^(2*m)) i 0 s*v (gridGroupTarget i)

def gridRamanujanLeading (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (v : Fin 510→ℂ) (i : Fin 60) : ℂ :=
  gridSample (gridTaylorQ i) (gridTaylorT i) v-
    gridTaylorCoefficient m f ε i 0 s*gridSample (gridTaylorQ i) (gridTaylorPartner i) v

def gridHeckeLeading (m : ℕ) (f : ℕ→ℂ) (s : ℂ) (v : Fin 510→ℂ) (i : Fin 287) : ℂ :=
  (∑ j∈Finset.range (gridHeckeP i),v (gridIndex (gridHeckeT i+(j:ℤ)*(510/gridHeckeP i:ℕ))))-
    ((Real.sqrt (gridHeckeP i):ℂ)*f (gridHeckeP i))*(parameter (gridHeckeP i) m s)⁻¹*
      v (gridIndex ((gridHeckeP i:ℤ)*gridHeckeT i))+
    (if gridHeckeP i∣34 then 0 else ((parameter (gridHeckeP i) m s)⁻¹)^2*
      v (gridIndex ((gridHeckeP i:ℤ)^2*gridHeckeT i)))

def gridLeadingRows (m : ℕ) (f : ℕ→ℂ) (ε s : ℂ) (v : Fin 510→ℂ) : GridSource→ℂ
  | .word i => gridGroupLeading m f ε s v i
  | .taylor i => gridRamanujanLeading m f ε s v i
  | .entire i => gridSample (gridEntireQ i) 0 v
  | .hecke i => gridHeckeLeading m f s v i
  | .infinity i => v (gridInfinityIndex i)

def gridShiftRows (m : ℕ) (f : ℕ→ℂ) (ε : ℂ) (n : ℕ) (s : ℂ)
    (v : Fin 510→ℂ) : GridSource→ℂ
  | .word i => gridMatrixScalar m f (ε*I^(2*m)) i (n+1) s*v (gridGroupTarget i)
  | .taylor i => gridTaylorCoefficient m f ε i (n+1) s*gridSample (gridTaylorQ i) (gridTaylorPartner i) v
  | .entire _ => 0
  | .hecke _ => 0
  | .infinity _ => 0

theorem gridHeckeLeading_grid (m : ℕ) (f : ℕ→ℂ) (s : ℂ) (i : Fin 287) :
    gridHeckeLeading m f s (gridVector (2*m) f s) i=gridHeckeRow m f i s := by
  simp only [gridHeckeLeading,gridHeckeRow,gridVector_index]

#print axioms gridVector_index
#print axioms gridSample_grid
#print axioms gridHeckeLeading_grid
end SmallLevelThirtyFourGrid
end
end

/-! ## SmallLevelThirtyFourGridParametersV1 -/
section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
set_option linter.unnecessarySeqFocus false
@[expose] public noncomputable section
namespace SmallLevelThirtyFourGrid
open Complex FinitenessNormalizedTwistProduct SmallLevelPrimeRates

def badParameter (f : ℕ→ℂ) (p : ℕ) : ℂ := (Real.sqrt p:ℂ)*f p
def phase (m : ℕ) (ε : ℂ) : ℂ := ε*I^(2*m)

theorem root_two (f : ℕ→ℂ) : root 34 f 2= -badParameter f 2 := by
  norm_num [root,FinitenessNormalizedTwistLocal.sign,badParameter]
  ring

theorem root_seventeen (f : ℕ→ℂ) : root 34 f 17= -badParameter f 17 := by
  norm_num [root,FinitenessNormalizedTwistLocal.sign,badParameter]
  ring

theorem badParameter_two_sign {f : ℕ→ℂ} (hf : FinitenessOriginalInput.EulerData 34 f) :
    badParameter f 2=1 ∨ badParameter f 2= -1 := by
  have h:=root_unit hf 2
  rw [root_two] at h
  rcases h with h|h
  · right; linear_combination -h
  · left; linear_combination -h

theorem badParameter_seventeen_sign {f : ℕ→ℂ} (hf : FinitenessOriginalInput.EulerData 34 f) :
    badParameter f 17=1 ∨ badParameter f 17= -1 := by
  have h:=root_unit hf 17
  rw [root_seventeen] at h
  rcases h with h|h
  · right; linear_combination -h
  · left; linear_combination -h

theorem grid_ramanujan_root (f : ℕ→ℂ) (i : Fin 60) :
    root 34 f (gridTaylorQ i)=
      (if 2∣gridTaylorQ i then -badParameter f 2 else 1)*
      (if 17∣gridTaylorQ i then -badParameter f 17 else 1) := by
  have hp10 : Nat.primeFactors 10=({2,5}:Finset ℕ) := by
    rw [show (10:ℕ)=2*5 by decide,Nat.primeFactors_mul (by decide) (by decide)]
    norm_num
  have hp34 : Nat.primeFactors 34=({2,17}:Finset ℕ) := by
    rw [show (34:ℕ)=2*17 by decide,Nat.primeFactors_mul (by decide) (by decide)]
    norm_num
  have hp51 : Nat.primeFactors 51=({3,17}:Finset ℕ) := by
    rw [show (51:ℕ)=3*17 by decide,Nat.primeFactors_mul (by decide) (by decide)]
    norm_num
  have hp85 : Nat.primeFactors 85=({5,17}:Finset ℕ) := by
    rw [show (85:ℕ)=5*17 by decide,Nat.primeFactors_mul (by decide) (by decide)]
    norm_num
  have hp170 : Nat.primeFactors 170=({2,5,17}:Finset ℕ) := by
    rw [show (170:ℕ)=2*85 by decide,Nat.primeFactors_mul (by decide) (by decide)]
    norm_num [hp85]
    all_goals decide
  fin_cases i <;>
    norm_num [gridTaylorQ,gridTaylorSpecs,root,FinitenessNormalizedTwistLocal.sign,badParameter,
      Nat.factorization_eq_zero_iff,hp10,hp34,hp51,hp85,hp170] <;> ring

#print axioms root_two
#print axioms root_seventeen
#print axioms badParameter_two_sign
#print axioms badParameter_seventeen_sign
#print axioms grid_ramanujan_root
end SmallLevelThirtyFourGrid
end
