def gridHeckeP (i : Fin 287) : ℕ := (gridHeckeSpecs i).1
def gridHeckeT (i : Fin 287) : ℤ := (gridHeckeSpecs i).2

theorem gridHeckeSpecs_valid (i : Fin 287) :
    (gridHeckeP i).Prime ∧ gridHeckeP i∣510 := by
  fin_cases i <;> decide

def gridHeckeRow (m : ℕ) (f : ℕ→ℂ) (i : Fin 287) (s : ℂ) : ℂ :=
  (∑ j∈Finset.range (gridHeckeP i),grid (2*m) f 510
    (gridHeckeT i+(j:ℤ)*(510/gridHeckeP i:ℕ)) s)-
    ((Real.sqrt (gridHeckeP i):ℂ)*f (gridHeckeP i))*(parameter (gridHeckeP i) m s)⁻¹*
      grid (2*m) f 510 ((gridHeckeP i:ℤ)*gridHeckeT i) s+
    (if gridHeckeP i∣34 then 0 else ((parameter (gridHeckeP i) m s)⁻¹)^2*
      grid (2*m) f 510 ((gridHeckeP i:ℤ)^2*gridHeckeT i) s)

/-- All 287 prime equations, including both ramified and both good primes. -/
theorem original_grid_hecke_row (m : ℕ) (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 34 (2*m) f) (i : Fin 287) :
    ∃ B : ℝ,∀ s : ℂ,B<s.re → gridHeckeRow m f i s=0 := by
  have hv:=gridHeckeSpecs_valid i
  by_cases hb : gridHeckeP i∣34
  · obtain ⟨B,hB⟩:=SmallLevelPrimeGrid.original_ramified_rows hf hm hv.1 hb
      (by decide : 0<510) hv.2
    exact ⟨B,fun s hs => by simpa only [gridHeckeRow,ite_eq_left hb,add_zero] using hB (gridHeckeT i) s hs⟩
  · obtain ⟨B,hB⟩:=SmallLevelPrimeGrid.original_good_rows hf hv.1 hb
      (by decide : 0<510) hv.2
    exact ⟨B,fun s hs => by simpa only [gridHeckeRow,ite_eq_right hb] using hB (gridHeckeT i) s hs⟩

theorem original_grid_hecke_system (m : ℕ) (hm : 0<m) {f : ℕ→ℂ}
    (hf : FinitenessOriginalInput.IsSolution 34 (2*m) f) :
    ∃ B : ℝ,∀ i : Fin 287,∀ s : ℂ,B<s.re → gridHeckeRow m f i s=0 := by
  choose b hb using original_grid_hecke_row m hm hf
  let B : ℝ:=Finset.univ.sup' Finset.univ_nonempty b
  have hbB (i : Fin 287) : b i≤B:=Finset.le_sup' b (Finset.mem_univ i)
  exact ⟨B,fun i s hs => hb i s (lt_of_le_of_lt (hbB i) hs)⟩

