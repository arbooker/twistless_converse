  norm_num [sourceRows,sourceRowsPart0,gridWordSign,gridBaseSign,SmallLevelFourPrimeRates.monomial] <;>
    field_simp [parameter_ne_zero 2 m (by decide) s,parameter_ne_zero 3 m (by decide) s,
